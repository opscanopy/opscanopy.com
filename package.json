{
  "name": "my-project",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/gen-tool-meta.mjs && node scripts/gen-lastmod.mjs",
    "build": "astro build",
    "postbuild": "pagefind --site dist && node scripts/check-trailing-slash.mjs && node scripts/inject-cm-modulepreload.mjs && node scripts/gen-sw.mjs && node scripts/inject-csp-hashes.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "gen:og": "node scripts/gen-og-images.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:ui": "playwright test --ui",
    "predeploy": "node scripts/check-no-placeholder.mjs",
    "deploy": "wrangler deploy",
    "versions:upload": "wrangler versions upload",
    "cf-preview": "npm run build && wrangler dev",
    "bing:submit": "node scripts/bing-submit.mjs",
    "seo:report": "node scripts/seo-report.mjs",
    "seo:crawlers": "node scripts/check-crawlers.mjs",
    "devto:sync": "node scripts/devto-sync.mjs",
    "seo:check-auth": "node scripts/check-google-auth.mjs",
    "syndicate": "node scripts/syndicate.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.4",
    "codemirror": "^6.0.2",
    "jq-wasm": "3.0.0-jq-1.8.2",
    "js-yaml": "^4.2.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.60.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8",
    "wrangler": "^4.100.0"
  }
}
