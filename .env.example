# Syndication credentials. Copy to .env and fill in — .env is gitignored.
#
# Kept here rather than in the agent's temp scratchpad, which Windows purges
# between sessions (the keys vanished on 2026-08-09 for exactly that reason).
# Real environment variables always take precedence, so CI is unaffected.

# dev.to -> Settings -> Extensions -> DEV Community API Keys
DEVTO_API_KEY=

# bsky.app -> Settings -> Privacy and Security -> App Passwords
BLUESKY_HANDLE=opscanopy.bsky.social
BLUESKY_APP_PASSWORD=

# Ahrefs free Domain Rating API (Account settings -> API keys). Free key, free
# endpoint. Read by scripts/seo-report.mjs to record DR in the weekly report;
# omit it and the DR row is simply left out.
AHREFS_API_KEY=
