# Cloudflare Static Assets headers (copied verbatim into dist/ by Astro).
#
# /_astro/* filenames are content-hashed by the build, so they are immutable —
# without this rule Cloudflare serves them with max-age=0,must-revalidate and
# every repeat navigation revalidates every asset.
#
# CSP notes:
#  - script-src carries a hash-list marker (see MARKER in the script below),
#    replaced at postbuild by
#    scripts/inject-csp-hashes.mjs with a sha256 for each executable inline
#    script the build emitted (11 today: theme no-flash, the gtag shim, SW
#    registration, nav, lang-switcher, the command-palette opener, and five
#    page-specific islands). Playground boot code is NOT inline — it bundles to
#    external /_astro/* files, covered by 'self'. There is deliberately no
#    'unsafe-inline': with it, script-src stops mitigating injection at all,
#    which matters here because tool input lives in localStorage on this origin.
#    A deploy that skipped postbuild ships the literal marker, which is invalid
#    CSP syntax — inline scripts break visibly rather than silently un-hardening.
#  - 'wasm-unsafe-eval': Pagefind (/search) and /jq-playground load WebAssembly.
#    (It used to name /alertlint-wasm-demo, a route that no longer exists — the
#    directive is still required, but for jq-wasm now, not the old Go PoC.)
#  - googletagmanager/google-analytics: GA4 (Consent Mode v2, default-denied —
#    see Layout.astro). connect-src is otherwise 'self', which enforces the
#    "your input never leaves the browser" guarantee at the platform level.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind: the loader (pagefind.js), entry manifest, language metas and wasm
# are NOT content-hashed and are regenerated on every deploy — they must revalidate,
# or a cached entry would reference index/fragment hashes a redeploy deleted
# (breaking /search for up to the TTL). The index/fragment chunks ARE
# content-hashed, so they get the same immutable treatment as /_astro/*.
/pagefind/*
  Cache-Control: public, max-age=0, must-revalidate

/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker script itself must never be cached by the CDN/browser —
# the browser's own SW update check needs to see a byte-for-byte-changed
# file on every deploy (scripts/gen-sw.mjs stamps a new BUILD_ID each time),
# or a stale sw.js could keep serving an old precache indefinitely.
/sw.js
  Cache-Control: no-cache

# HSTS: the `preload` token is ADVERTISED but opscanopy.com is not currently in
# the browser preload list (hstspreload.org reports "unknown"), so it has no
# effect yet. Submitting is deliberately left to the domain owner: preload is
# effectively irreversible on a human timescale — removal takes months to reach
# users — and it commits every present and future subdomain to HTTPS-only.
# Either submit at hstspreload.org, or drop the token; leaving it is only
# acceptable as a stated intent, which is what this comment records.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), serial=(), display-capture=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # static.cloudflareinsights.com is Cloudflare Web Analytics. Cloudflare injects
  # its beacon at the edge automatically for this zone — that was already enabled,
  # but the script was being REFUSED by this policy, which is why the Web Analytics
  # dashboard read 0 visits while the site was serving traffic. Verified in a
  # browser: the request fired and failed with reason "csp".
  #
  # cloudflareinsights.com (no subdomain) is where the beacon POSTs its payload,
  # so it needs connect-src as well as script-src.
  Content-Security-Policy: default-src 'self'; script-src 'self' {{SCRIPT_HASHES}} 'wasm-unsafe-eval' https://www.googletagmanager.com https://static.cloudflareinsights.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://cloudflareinsights.com; img-src 'self' data: https://*.google-analytics.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
