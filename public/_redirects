# Cloudflare Static Assets redirects. Copied verbatim into dist/ at build time,
# exactly like public/_headers.
#
# Only conventional-path aliases belong here. Trailing-slash normalisation is
# NOT in this file: Cloudflare's own html_handling already performs it (as a
# 307), and expressing a catch-all slash rule here risks a redirect loop for no
# SEO gain — Google follows 307s and consolidates signals across them fine.

# robots.txt advertises /sitemap-index.xml, but /sitemap.xml is the path humans
# and third-party tools guess first, and it returned a 404.
/sitemap.xml  /sitemap-index.xml  301

# Cloudflare Static Assets are case-sensitive, so the natural BCP-47 spelling of
# the Brazilian Portuguese tree (/pt-BR/) 404s while the built path is /pt-br/.
# Nothing on the site links it, but hreflang codes and hand-typed URLs use it.
/pt-BR/*  /pt-br/:splat  301

# /learn, /mission-90, /tests and /changelog are English-only by design
# (ENGLISH_ONLY_SECTIONS in src/i18n/paths.ts), so localizeNavHref links them
# unprefixed from every locale and no /de/learn/ page is ever built. A visitor
# who hand-prefixes one — or an external link that does — hit a 404; send them
# to the English original instead.
/de/learn/*         /learn/:splat         301
/de/mission-90/*    /mission-90/:splat    301
/de/tests/*         /tests/:splat         301
/de/changelog/*     /changelog/:splat     301
/es/learn/*         /learn/:splat         301
/es/mission-90/*    /mission-90/:splat    301
/es/tests/*         /tests/:splat         301
/es/changelog/*     /changelog/:splat     301
/fr/learn/*         /learn/:splat         301
/fr/mission-90/*    /mission-90/:splat    301
/fr/tests/*         /tests/:splat         301
/fr/changelog/*     /changelog/:splat     301
/pt-br/learn/*      /learn/:splat         301
/pt-br/mission-90/* /mission-90/:splat    301
/pt-br/tests/*      /tests/:splat         301
/pt-br/changelog/*  /changelog/:splat     301
