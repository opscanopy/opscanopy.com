{
  "batch": "aif-guide-notes",
  "expires": "2026-10-17",
  "rules": [
    {
      "field": "description",
      "pages": "^/learn/guides/aws-ai-practitioner-study-guide/$",
      "to": "three free 65-question mocks",
      "reason": "the guide's meta description counts the third AIF mock"
    },
    {
      "field": "og:description",
      "pages": "^/learn/guides/aws-ai-practitioner-study-guide/$",
      "to": "three free 65-question mocks",
      "reason": "og:description mirrors the meta description"
    },
    {
      "field": "ld:TechArticle",
      "pages": "^/learn/guides/aws-ai-practitioner-study-guide/$",
      "to": "three free 65-question mocks",
      "reason": "the article description in JSON-LD repeats the frontmatter description (two -> three mocks)"
    },
    {
      "field": "ld:ItemList",
      "pages": "^/learn/guides/$",
      "to": "three free 65-question mocks",
      "reason": "the guides hub ItemList carries the guide description (two -> three mocks)"
    }
  ]
}
