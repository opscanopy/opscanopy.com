{
  "batch": "variant-prune",
  "expires": "2026-10-21",
  "rules": [
    {
      "field": "robots",
      "pages": "^/(?:(?:de|es|fr|pt-br)/)?(?:chmod-calculator|cron-expression-tester|llm-vram-calculator)/[^/]+/$",
      "to": "noindex,follow",
      "reason": "Near-duplicate variants outside src/data/variants/indexable.json go noindex,follow (GSC: crawled, not indexed)"
    },
    {
      "field": "sitemap",
      "pages": "^/(?:(?:de|es|fr|pt-br)/)?(?:chmod-calculator|cron-expression-tester|llm-vram-calculator)/[^/]+/$",
      "reason": "noindex variants leave the sitemap"
    },
    {
      "field": "pagefind",
      "pages": "^/(?:(?:de|es|fr|pt-br)/)?(?:chmod-calculator|cron-expression-tester|llm-vram-calculator)/[^/]+/$",
      "reason": "noindex pages opt out of site search (Shell searchIndex = !noindex)"
    },
    {
      "field": "hreflang",
      "pages": "^/(?:(?:de|es|fr|pt-br)/)?chmod-calculator/[^/]+/$",
      "reason": "English chmod variants stop listing the now-noindex locale copies; locale copies are noAlternates"
    },
    {
      "field": "x-default",
      "pages": "^/(?:de|es|fr|pt-br)/chmod-calculator/[^/]+/$",
      "reason": "locale chmod copies are noAlternates"
    },
    {
      "field": "ld:Organization",
      "pages": "^/(?:(?:de|es|fr|pt-br)/)?(?:chmod-calculator|cron-expression-tester|llm-vram-calculator)/[^/]+/$",
      "reason": "SEO.astro:88 skips site-identity LD on noindex pages (existing behaviour)"
    },
    {
      "field": "ld:WebSite",
      "pages": "^/(?:(?:de|es|fr|pt-br)/)?(?:chmod-calculator|cron-expression-tester|llm-vram-calculator)/[^/]+/$",
      "reason": "SEO.astro:88 skips site-identity LD on noindex pages (existing behaviour)"
    },
    {
      "field": "inbound:/*chmod-calculator/*",
      "maxDropAbs": 4,
      "reason": "hreflang alternates between EN and locale chmod variants removed (locale copies now noindex)"
    }
  ]
}
