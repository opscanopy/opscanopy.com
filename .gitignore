# build output
dist/

# NOTE: .github/ used to be ignored here. GitHub Actions can only run workflows
# that are committed, so ignoring it silently prevented every workflow in this
# repo from existing on GitHub (claude.yml only survived because it predates the
# rule). The directory holds nothing but CI config — no secrets, which live in
# repository settings — so it is tracked.

# generated types
.astro/

# Playwright E2E output (reporter html + traces/screenshots), see playwright.config.ts
test-results/
playwright-report/

# git-derived per-tool "Updated" dates (scripts/gen-tool-meta.mjs, prebuild)
src/data/tool-meta.generated.json
src/data/lastmod.generated.json

graphify-out/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
.indexnow-state.json
.indexnow-changed.json
.wrangler/
.syndicate-state.json
