---
/**
 * JqPlayground — the interactive jq Playground island.
 *
 * TWO CodeMirror editors: the jq program (no language package — none exists for
 * jq) and the JSON input (`@codemirror/lang-json`), as two hosts inside ONE
 * editor slab (the kit's EditorPane: one figure cap, the -r / -s / -n / -c
 * flags and the version badge in its actions slot). The badge is read from the
 * WASM binary itself rather than typed here — that badge IS the tool's
 * ground-truth claim, so it must never become a literal.
 *
 * Layout, top to bottom (plan "Batch C", Wave 3): example chips on paper; the
 * editor slab; the run hint, glossary captions and snapshot bar on paper; the
 * result as the L2 ResultPanel — two slabs in all, as the subnet reference.
 *
 * WASM lifecycle: the shell, both editors and the seeded state render
 * immediately; the jq binary (928,824 bytes = 907 KiB uncompressed; MEASURED
 * 336 KiB gzip -6, 242 KiB brotli q11) is fetched at idle via
 * `requestIdleCallback`. When the editors hold the seeded first example the
 * server-rendered answer stays on screen while it loads; otherwise a one-time
 * "Loading jq" status shows. If instantiation fails the `#jq-error` slot keeps a
 * persistent card with a Retry button — `getJq()` clears its memo on rejection
 * precisely so Retry can work.
 *
 * Errors write into the `#jq-error` slot ABOVE the output cards and dim them;
 * they never replace them, so the last good answer stays readable while a
 * filter is being fixed.
 *
 * UX contract (CLAUDE.md): ONE ~220ms debounce, a ~600ms calm-error hold
 * before anything goes red, per-row copy + `data-copy-all` + `data-copy-link`,
 * a results container that is NOT `aria-live`, glossary captions instead of
 * tooltips, and `escapeHtml()` on every injected value.
 *
 * The hash is written ONLY on a valid, user-initiated evaluation — never on the
 * boot seed, never on an error, never past the 2000-char cap.
 *
 * Runtime contract (all lazy-imported inside the boot closure so neither
 * CodeMirror nor the WASM glue touches the page-shell path):
 *   ../lib/jq-playground/engine     → configureJq, getJq, runJq, unboundedRiskHint
 *   ../lib/jq-playground/hash       → encodeState, decodeState
 *   ../lib/jq-playground/examples   → examples: JqExample[]
 *   ../lib/playground-kit/cm-theme  → plate
 *   jq-wasm/jq.wasm?url             → the hashed same-origin WASM asset
 */
import { examples } from '../lib/jq-playground/examples';
import { okHtml, okSummary, LOADING_HTML } from '../lib/jq-playground/render';
import type { JqOk } from '../lib/jq-playground/types';
import seedFixture from '../lib/jq-playground/fixtures/example-1.out.json';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The build cannot run the jq WebAssembly binary, so
 * the first example's REAL jq 1.8.2 output is checked in as
 * `fixtures/example-1.out.json` — and `fixture.test.ts` runs the real binary
 * in node and fails if the fixture and jq ever disagree. A no-JS visitor, and
 * every AI crawler, sees jq's actual answer instead of a loading message.
 *
 * Guarded: the fixture seeds only while it still describes `examples[0]`
 * (program, input and flags); a stale fixture falls back to the loading card
 * rather than showing an answer to a different question. Never seeds the
 * timing (`okSummary(…, false)`) or the version badge (the binary reports
 * that itself, at runtime).
 */
const seedExample = examples[0];
const fx = seedFixture as unknown as {
  example: { id: string; program: string; input: string; flags: Record<string, boolean> };
  result: Omit<JqOk, 'elapsedMs'>;
};
const fixtureMatches = Boolean(
  seedExample &&
    fx.example.id === seedExample.id &&
    fx.example.program === seedExample.program &&
    fx.example.input === seedExample.input &&
    JSON.stringify(fx.example.flags) === JSON.stringify(seedExample.flags) &&
    fx.result.ok,
);
const seedOk: JqOk | null = fixtureMatches ? ({ ...fx.result, elapsedMs: 0 } as JqOk) : null;
const seedHtml = seedOk ? okHtml(seedOk) : LOADING_HTML;
const seedSummary = seedOk ? okSummary(seedOk, false) : '';
const seedFlags = seedExample?.flags ?? { rawOutput: false, slurp: false, nullInput: false, compact: false };
const chipItems = examples.map((ex) => ({ label: ex.label }));
const FLAGS = [
  { key: 'rawOutput', label: '-r' },
  { key: 'slurp', label: '-s' },
  { key: 'nullInput', label: '-n' },
  { key: 'compact', label: '-c' },
] as const;
---

<section class="jqp-pg" aria-label="jq expression playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Example chips ────────────────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow shrink-0">Examples</span>
      <ExampleChips prefix="jq" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
    </div>

    {/* ── The editor slab: program + JSON input, one figure cap; the flags
        and the version badge ride the cap's actions slot. ─────────────── */}
    <EditorPane prefix="jq" label="filter.jq" id="jq-editors">
      <Fragment slot="actions">
        <span id="jq-flag-group" class="jqp-flags" role="group" aria-label="jq flags">
          {
            FLAGS.map((f) => (
              <button
                type="button"
                class="chip jqp-flag code-mono"
                data-flag={f.key}
                aria-pressed={seedFlags[f.key] ? 'true' : 'false'}
              >
                {f.label}
              </button>
            ))
          }
        </span>
        <span class="jqp-badge-wrap">
          <span id="jq-version" class="jqp-badge code-mono" hidden></span>
        </span>
      </Fragment>
      <div id="jq-program" class="jqp-host jqp-host--program">
        <pre class="jqp-fallback jqp-fallback--program editor-pane__fallback code-mono" data-cm-fallback>{seedExample?.program}</pre>
      </div>
      <div class="jqp-sep code-mono">input.json · stdin</div>
      <div id="jq-input" class="jqp-host jqp-host--input">
        <pre class="jqp-fallback jqp-fallback--input editor-pane__fallback code-mono" data-cm-fallback>{seedExample?.input}</pre>
      </div>
    </EditorPane>

    {/* ── Hints, glossary, risk note + snapshots (on paper) ───────────── */}
    <div class="border-b border-hairline px-4 pt-3 pb-4 sm:px-5">
      <RunHint variant="cm" id="jq-run-hint" />
      <p id="jq-risk" class="jqp-risk caption" hidden></p>
      <p class="jqp-gloss caption text-mute">
        <span class="code-mono">-r</span> prints string results without JSON quotes ·
        <span class="code-mono">-s</span> slurps the whole input stream into one array ·
        <span class="code-mono">-n</span> runs the filter once with <span class="code-mono">null</span>
        as input (read the stream with <span class="code-mono">inputs</span>) ·
        <span class="code-mono">-c</span> prints one line per result instead of pretty-printing.
      </p>
      <p id="jq-version-note" class="jqp-gloss caption text-mute">
        The version above is read out of the WebAssembly binary at runtime, not written into this
        page — it is real jq, not a JavaScript re-implementation.
      </p>
      <p class="jqp-gloss caption text-mute">
        A jq <strong class="font-medium text-body">filter</strong> produces a
        <strong class="font-medium text-body">stream</strong> of results, not one value: each card
        below is one output, exactly as jq would print it on its own line. Input is capped at 2 MB,
        and a filter that never terminates (an unguarded <span class="code-mono">repeat</span>) will
        freeze this tab until you reload it.
      </p>
      <SnapshotBar prefix="jq" />
    </div>

    {/* ── Result — the L2 instrument; the live summary reads out in the
        figure cap's actions slot. Errors write into #jq-error above the
        cards (and dim them), never over them. ─────────────────────────── */}
    <ResultPanel slug="jq-playground" prefix="jq" summary={seedSummary} split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="jq-share" />
        <CopyButton kind="all" id="jq-copy-all" />
      </Fragment>
      <div id="jq-error" class="jqp-error-slot"></div>
      {/* Seeded at build time from the checked-in real jq output (see the
          frontmatter); the client repaints it with the same markup once the
          WASM binary has run the example. */}
      <div id="jq-results" class="jqp-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* ── Flags + badge, in the editor slab's figure cap ──────────────────── */
  .jqp-flags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  /* The kit chip (slab variant via .instrument-flush .chip) in mono: a flag
     is a toggle whose pressed state IS aria-pressed. */
  .jqp-flag {
    justify-content: center;
    min-width: 36px;
    padding-inline: 8px;
    font-size: 12px;
    line-height: 18px;
  }
  /* The badge un-hides once the WASM lands; the wrap holds its measured box
     (80×22 for "jq-1.8.2") from first paint, so the cap does not grow or
     re-wrap after hydration (layout shift). */
  .jqp-badge-wrap {
    display: inline-flex;
    justify-content: flex-end;
    min-width: 80px;
    min-height: var(--control-h-sm);
  }
  .jqp-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    background: #8fc97a1f;
    box-shadow: inset 0 0 0 1px #8fc97a4d;
    color: var(--color-inverse-brand);
    font-size: 12px;
    line-height: 18px;
    white-space: nowrap;
  }

  /* ── The two hosts inside the one slab ───────────────────────────────── */
  .jqp-host {
    position: relative;
    min-width: 0;
  }
  .jqp-sep {
    padding: 6px 14px;
    border-block: 1px solid var(--color-inverse-hairline);
    font-size: 12px;
    line-height: 16px;
    color: var(--color-inverse-mute);
  }
  /* The build-time stand-ins (global .editor-pane__fallback matches the
     CodeMirror metrics), held to each editor's scroller box and wrapped like
     its lineWrapping so the swap does not jump. */
  .jqp-fallback {
    overflow: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .jqp-fallback--program {
    min-height: 64px;
    max-height: 240px;
  }
  .jqp-fallback--input {
    min-height: 200px;
    max-height: 400px;
  }
  /* Invalid input: a hairline slab-red rule down the editor that owns the
     problem, never a flash. */
  .jqp-host[data-invalid] :global(.cm-editor) {
    box-shadow: inset 2px 0 0 0 var(--color-inverse-error);
  }

  /* ── Paper captions ──────────────────────────────────────────────────── */
  .jqp-gloss {
    margin-top: 6px;
    font-size: 12px;
    line-height: 17px;
    text-wrap: pretty;
  }
  .jqp-gloss .code-mono {
    font-size: 12px;
  }
  .jqp-risk {
    margin-top: 8px;
    padding: 7px 10px;
    border-radius: var(--radius-sm);
    background: var(--color-warning-soft);
    color: var(--color-warning-deep);
    font-size: 12px;
    line-height: 17px;
    text-wrap: pretty;
  }

  /* ── Result panel ────────────────────────────────────────────────────── */
  .jqp-results {
    min-width: 0;
    min-height: 120px;
    transition: opacity var(--dur-base) var(--ease-brand);
  }
  /* An error is showing in #jq-error: the last cards stay, dimmed. */
  .jqp-results[data-stale] {
    opacity: 0.5;
  }
  .jqp-error-slot {
    min-width: 0;
  }
  .jqp-error-slot:empty {
    display: none;
  }
  .jqp-error-slot:not(:empty) {
    margin-bottom: 12px;
  }
  .jqp-pg :global(.result-panel__summary.text-inverse-error) {
    color: var(--color-inverse-error);
  }

  /* ── Runtime-injected markup (render.ts) — on the slab, so slab inks only.
     Anchored on this component's own containers (the panel wrapper is
     ResultPanel's and carries no scope attribute); the error slot holds
     cards too (partial outputs). ──────────────────────────────────────── */
  .jqp-results :global(.jqp-out),
  .jqp-error-slot :global(.jqp-out) {
    min-width: 0;
    border-radius: var(--radius-md);
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    overflow: hidden;
    animation: jqp-rise var(--dur-base) var(--ease-brand) both;
  }
  .jqp-results :global(.jqp-out + .jqp-out),
  .jqp-error-slot :global(.jqp-out + .jqp-out) {
    margin-top: 10px;
  }
  .jqp-results :global(.jqp-out--dim),
  .jqp-error-slot :global(.jqp-out--dim) {
    opacity: 0.72;
  }
  .jqp-results :global(.jqp-out__bar),
  .jqp-error-slot :global(.jqp-out__bar) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px 6px 14px;
    border-bottom: 1px solid var(--color-inverse-hairline);
  }
  /* "output 1": the row-key role (label-field), in slab mute. */
  .jqp-results :global(.jqp-out__name),
  .jqp-error-slot :global(.jqp-out__name) {
    @apply label-field;
    color: var(--color-inverse-mute);
  }
  .jqp-results :global(.jqp-out__meta),
  .jqp-error-slot :global(.jqp-out__meta) {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-inverse-mute);
    white-space: nowrap;
  }
  /* One output, exactly as jq prints it: never wrapped mid-string — a long
     line scrolls inside its own card (keyboard-reachable via tabindex). */
  .jqp-results :global(.jqp-out__pre),
  .jqp-error-slot :global(.jqp-out__pre) {
    margin: 0;
    padding: 12px 16px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-inverse-fg);
    white-space: pre;
    tab-size: 2;
  }

  .jqp-results :global(.jqp-block),
  .jqp-error-slot :global(.jqp-block) {
    margin-top: 12px;
    border-radius: var(--radius-md);
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    overflow: hidden;
    animation: jqp-rise var(--dur-base) var(--ease-brand) both;
  }
  .jqp-results :global(.jqp-block:first-child) {
    margin-top: 0;
  }
  /* Group-heading role (a sans heading over its rows, not one more label). */
  .jqp-results :global(.jqp-block__head),
  .jqp-error-slot :global(.jqp-block__head) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--color-inverse-hairline);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    color: var(--color-inverse-fg);
  }
  .jqp-results :global(.jqp-block__meta),
  .jqp-error-slot :global(.jqp-block__meta) {
    margin-left: auto;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--color-inverse-mute);
    white-space: nowrap;
  }
  .jqp-results :global(.jqp-block__sub),
  .jqp-error-slot :global(.jqp-block__sub) {
    margin: 0;
    padding: 8px 14px;
    border-bottom: 1px solid #ffffff12;
    font-size: 12px;
    line-height: 18px;
    color: var(--color-inverse-mute);
    text-wrap: pretty;
  }
  .jqp-results :global(.jqp-note),
  .jqp-error-slot :global(.jqp-note) {
    margin: 0;
    padding: 9px 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-inverse-fg);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  .jqp-results :global(.jqp-note + .jqp-note),
  .jqp-error-slot :global(.jqp-note + .jqp-note) {
    border-top: 1px solid #ffffff12;
  }
  .jqp-results :global(.jqp-cap),
  .jqp-error-slot :global(.jqp-cap) {
    margin: 10px 0 0;
    font-size: 12px;
    line-height: 18px;
    color: var(--color-inverse-mute);
    text-wrap: pretty;
  }

  .jqp-error-slot :global(.jqp-error),
  .jqp-results :global(.jqp-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .jqp-error-slot :global(.jqp-error__icon),
  .jqp-results :global(.jqp-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  .jqp-error-slot :global(.jqp-error__body),
  .jqp-results :global(.jqp-error__body) {
    min-width: 0;
  }
  .jqp-error-slot :global(.jqp-error__title),
  .jqp-results :global(.jqp-error__title) {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  .jqp-error-slot :global(.jqp-error__detail),
  .jqp-results :global(.jqp-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 19px;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .jqp-error-slot :global(.jqp-error__where) {
    display: inline-block;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    opacity: 0.9;
  }
  .jqp-error-slot :global(.jqp-error__excerpt) {
    margin: 8px 0 0;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    background: #0000003d;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 17px;
    color: var(--color-inverse-fg);
    white-space: pre;
  }
  .jqp-error-slot :global(.jqp-retry) {
    margin-top: 10px;
    min-height: var(--control-h-md);
    padding: 0 12px;
    border: none;
    border-radius: var(--radius-sm);
    background: #ffffff14;
    box-shadow: inset 0 0 0 1px var(--color-inverse-control-edge);
    color: var(--color-inverse-fg);
    font-size: 13px;
    cursor: pointer;
  }
  .jqp-results :global(.jqp-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 96px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }

  /* Per-row copy (render.ts emits the button; playground-kit/copy.ts drives
     it, and marks success with [data-copied]). */
  .jqp-results :global(.jqp-copy),
  .jqp-error-slot :global(.jqp-copy) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-inverse-mute);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      color var(--dur-fast) var(--ease-brand),
      background-color var(--dur-fast) var(--ease-brand);
  }
  .jqp-results :global(.jqp-copy:hover),
  .jqp-error-slot :global(.jqp-copy:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .jqp-results :global(.jqp-copy[data-copied]),
  .jqp-error-slot :global(.jqp-copy[data-copied]) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
  .jqp-results :global(.jqp-copy:focus-visible),
  .jqp-results :global(.jqp-out__pre:focus-visible),
  .jqp-error-slot :global(.jqp-copy:focus-visible),
  .jqp-error-slot :global(.jqp-out__pre:focus-visible),
  .jqp-error-slot :global(.jqp-retry:focus-visible) {
    outline: 2px solid var(--color-inverse-brand);
    outline-offset: 1px;
  }
  @media (pointer: coarse) {
    .jqp-results :global(.jqp-copy),
    .jqp-error-slot :global(.jqp-copy) {
      width: var(--control-h-lg);
      height: var(--control-h-lg);
    }
  }

  @keyframes jqp-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .jqp-results :global(.jqp-out),
    .jqp-results :global(.jqp-block),
    .jqp-error-slot :global(.jqp-out),
    .jqp-error-slot :global(.jqp-block) {
      animation: none;
    }
  }
</style>

<script>
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import type { EditorView } from '@codemirror/view';
  // The HTML builders are shared with the frontmatter's build-time seed — one
  // implementation, so the no-JS markup and the live markup never drift.
  import {
    CODE_LOAD_FAILED_HTML,
    LOADING_HTML,
    emptyHtml,
    errHtml,
    group,
    okHtml,
    okSummary,
  } from '../lib/jq-playground/render';
  // `import type` is erased at build time: the engine itself stays lazy.
  import type { JqErr, JqFlags, JqRunResult, JqShareState } from '../lib/jq-playground/types';

  type Flags = JqFlags;
  type Err = JqErr;
  type RunResult = JqRunResult;
  type ShareState = JqShareState;
  type Example = { id: string; label: string; program: string; input: string; flags: Flags };
  type EngineModule = {
    configureJq: (init: { wasmURL?: string }) => void;
    getJq: (init?: { wasmURL?: string }) => Promise<{ readonly version: string }>;
    runJq: (program: string, input: string, options?: Partial<Flags>) => Promise<RunResult>;
    unboundedRiskHint: (program: string) => string | null;
  };
  type HashModule = {
    encodeState: (state: ShareState) => string;
    decodeState: (hash?: string) => ShareState | null;
  };

  const ROOT_SEL = '.jqp-pg';
  const SLUG = 'jq-playground';
  /* One debounce, at the top of the contract's 130–220ms band: jq is fast but
     it is also synchronous, so re-running on every keystroke is not free. */
  const DEBOUNCE_MS = 220;
  /* Nothing goes red until the typing has been idle this long. */
  const ERROR_HOLD_MS = 600;
  /* Past ~2000 chars a fragment stops being a dependable URL (browser, proxy and
     chat-client limits), so we neither write it nor offer the share link — the
     playground itself keeps working on inputs of any size. */
  const MAX_HASH_LEN = 2000;
  /* The program editor's accessible name, and the flag that tells the shared
     editor factory which of the two editors it is building. */
  const PROGRAM_LABEL = 'jq program';

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.jqWired === 'true') return;
      root.dataset.jqWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function normaliseFlags(raw: unknown): Flags {
    const o = (raw ?? {}) as Record<string, unknown>;
    return {
      rawOutput: o.rawOutput === true,
      slurp: o.slurp === true,
      nullInput: o.nullInput === true,
      compact: o.compact === true,
    };
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          program: typeof o.program === 'string' ? o.program : '',
          input: typeof o.input === 'string' ? o.input : '',
          flags: normaliseFlags(o.flags),
        } satisfies Example;
      })
      .filter((e) => e.program.length > 0 && e.input.length > 0);
  }

  /* ---- Instance init ----------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const programHost = el<HTMLElement>(root, '#jq-program');
    const inputHost = el<HTMLElement>(root, '#jq-input');
    const resultsBox = el<HTMLElement>(root, '#jq-results');
    const errorSlot = el<HTMLElement>(root, '#jq-error');
    const summaryEl = el<HTMLElement>(root, '#jq-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#jq-share');
    const copyAllBtn = el<HTMLButtonElement>(root, '#jq-copy-all');
    const copyStatus = el<HTMLElement>(root, '#jq-copy-status');
    const versionBadge = el<HTMLElement>(root, '#jq-version');
    const riskEl = el<HTMLElement>(root, '#jq-risk');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#jq-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#jq-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#jq-snap-delete');
    const chipsWrap = el<HTMLElement>(root, '#jq-chips');
    const chips = Array.from(chipsWrap?.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR) ?? []);
    const flagBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('#jq-flag-group [data-flag]'));

    if (
      !programHost ||
      !inputHost ||
      !resultsBox ||
      !errorSlot ||
      !summaryEl ||
      !shareBtn ||
      !copyAllBtn ||
      !copyStatus ||
      !versionBadge ||
      !riskEl ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    /* ---- Copy plumbing (output rows, Copy link, Copy all) — the kit helper:
       one delegated listener; outcomes announced in #jq-copy-status. ------- */

    wireCopyButtons(root, { status: copyStatus });

    root.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-jq-retry]')) void loadEngine(true);
    });

    /* ---- Lazy engine + examples + CodeMirror ----------------------------- */

    let engine: EngineModule;
    let hashApi: HashModule;
    let examples: Example[] = [];
    let wasmURL = '';
    let EditorState: typeof import('@codemirror/state').EditorState;
    let EditorViewCtor: typeof import('@codemirror/view').EditorView;
    let keymap: typeof import('@codemirror/view').keymap;
    let lineNumbers: typeof import('@codemirror/view').lineNumbers;
    let highlightActiveLine: typeof import('@codemirror/view').highlightActiveLine;
    let defaultKeymap: typeof import('@codemirror/commands').defaultKeymap;
    // Named `cmHistory`, not `history`: a bare `history` would shadow
    // `window.history`, which `writeHash` needs for replaceState.
    let cmHistory: typeof import('@codemirror/commands').history;
    let historyKeymap: typeof import('@codemirror/commands').historyKeymap;
    let indentWithTab: typeof import('@codemirror/commands').indentWithTab;
    let jsonLang: typeof import('@codemirror/lang-json').json;
    let plate: typeof import('../lib/playground-kit/cm-theme').plate;

    try {
      const [
        engineMod,
        hashMod,
        examplesMod,
        wasmMod,
        stateMod,
        viewMod,
        commandsMod,
        jsonMod,
        themeMod,
      ] = await Promise.all([
        import('../lib/jq-playground/engine'),
        import('../lib/jq-playground/hash'),
        import('../lib/jq-playground/examples'),
        // The `?url` form is the ONLY supported way to get this asset: Vite
        // hashes it into /_astro/ and serves it same-origin, which the CSP
        // (connect-src 'self') requires. Never hand-copy it into public/.
        import('jq-wasm/jq.wasm?url'),
        import('@codemirror/state'),
        import('@codemirror/view'),
        import('@codemirror/commands'),
        import('@codemirror/lang-json'),
        // The plate theme + highlight (the ONE code palette), in the same
        // closure as the language — a static import would pull
        // @codemirror/view into the page shell.
        import('../lib/playground-kit/cm-theme'),
      ]);
      engine = engineMod as unknown as EngineModule;
      hashApi = hashMod as unknown as HashModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
      wasmURL = String((wasmMod as { default?: unknown }).default ?? '');
      ({ EditorState } = stateMod);
      ({ EditorView: EditorViewCtor, keymap, lineNumbers, highlightActiveLine } = viewMod);
      ({ history: cmHistory, defaultKeymap, historyKeymap, indentWithTab } = commandsMod);
      ({ json: jsonLang } = jsonMod);
      ({ plate } = themeMod);
    } catch (err) {
      summaryEl.textContent = '';
      errorSlot.innerHTML = CODE_LOAD_FAILED_HTML;
      resultsBox.setAttribute('data-stale', '');
      console.error('[JqPlayground] engine/CodeMirror import failed:', err);
      return;
    }

    /* ---- State ----------------------------------------------------------- */

    type EvalSource = 'type' | 'commit' | 'seed';
    type UiState = 'empty' | 'valid' | 'pending' | 'invalid' | 'loading' | 'failed';

    let flags: Flags = { rawOutput: false, slurp: false, nullInput: false, compact: false };
    let uiState: UiState = 'loading';
    let evalTimer: number | undefined;
    let errTimer: number | undefined;
    let lastWrittenHash: string | null = null;
    let liveReady = false;
    let engineReady = false;
    /** Monotonic run id: an async result that is not the newest is discarded. */
    let runSeq = 0;

    function clearTimers(): void {
      window.clearTimeout(evalTimer);
      window.clearTimeout(errTimer);
    }

    /* ---- Editors --------------------------------------------------------- */

    function makeEditor(
      host: HTMLElement,
      doc: string,
      label: string,
      language: readonly unknown[],
      size: { min: string; max: string },
    ): EditorView {
      const view: EditorView = new EditorViewCtor({
        state: EditorState.create({
          doc,
          extensions: [
            lineNumbers(),
            cmHistory(),
            highlightActiveLine(),
            ...(language as never[]),
            plate,
            // This editor's size only; colours, gutter and focus ring are the
            // kit's (cm-theme.ts + global.css .editor-pane__host).
            EditorViewCtor.theme({
              '&': { fontSize: '13px' },
              '.cm-scroller': { minHeight: size.min, maxHeight: size.max, scrollbarWidth: 'thin' },
            }),
            EditorViewCtor.lineWrapping,
            // CodeMirror puts role="textbox" on the content DOM; without a name
            // that is an unlabelled input field for a screen reader (and an axe
            // violation). aria-describedby points at the run hint line.
            EditorViewCtor.contentAttributes.of({
              'aria-label': label,
              'aria-describedby': 'jq-run-hint',
            }),
            keymap.of([
              // Ours FIRST, so they win over defaultKeymap's Enter/Escape.
              {
                key: 'Mod-Enter',
                run: () => {
                  clearTimers();
                  evaluate('commit');
                  view.contentDOM.blur();
                  return true;
                },
              },
              {
                // Plain Enter must still insert the newline (jq programs are
                // often multi-line), so this returns false and lets
                // insertNewlineAndIndent run — the eval is flushed on the next
                // tick, once the doc includes the newline.
                key: 'Enter',
                run: () => {
                  window.setTimeout(() => {
                    clearTimers();
                    evaluate('commit');
                  }, 0);
                  return false;
                },
              },
              {
                // The Tab-trap escape hatch: indentWithTab means Tab indents,
                // so Escape is the documented way out of the editor.
                key: 'Escape',
                run: (v) => {
                  v.contentDOM.blur();
                  return true;
                },
              },
              ...defaultKeymap,
              ...historyKeymap,
              indentWithTab,
            ]),
            EditorViewCtor.updateListener.of((u) => {
              if (!u.docChanged || !liveReady) return;
              setActiveChip(null);
              clearTimers();
              // The unbounded-risk warning has to be painted on the DOC CHANGE,
              // not inside evaluate(): jq runs synchronously and `await getJq()`
              // is already resolved by then, so evaluate() blocks the main thread
              // on the same microtask checkpoint that wrote the warning — the
              // browser never gets a frame, and for a filter that never returns
              // the warning is never seen at all. Painting it here gives it the
              // whole debounce window.
              if (label === PROGRAM_LABEL) applyRiskHint(u.state.doc.toString());
              evalTimer = window.setTimeout(() => evaluate('type'), DEBOUNCE_MS);
            }),
          ],
        }),
        parent: host,
      });
      return view;
    }

    function setEditorDoc(view: EditorView, doc: string): void {
      view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: doc } });
      view.requestMeasure();
    }

    /* ---- Chrome ---------------------------------------------------------- */

    function setSummary(text: string, isError: boolean): void {
      summaryEl!.textContent = text;
      summaryEl!.classList.toggle('text-inverse-error', isError);
      summaryEl!.classList.toggle('text-inverse-mute', !isError);
    }

    /**
     * Flag the editor that actually owns the problem: a compile or runtime error
     * is fixed in the program, a parse error in the JSON. Pointing at the wrong
     * one would be a small confident lie.
     */
    function setErrorState(target: 'program' | 'input' | null): void {
      const pairs: [HTMLElement, EditorView, 'program' | 'input'][] = [
        [programHost!, programView, 'program'],
        [inputHost!, inputView, 'input'],
      ];
      for (const [host, view, which] of pairs) {
        const on = target === which;
        host.toggleAttribute('data-invalid', on);
        if (on) {
          view.contentDOM.setAttribute('aria-invalid', 'true');
          view.contentDOM.setAttribute('aria-describedby', 'jq-run-hint jq-error-detail');
        } else {
          view.contentDOM.removeAttribute('aria-invalid');
          view.contentDOM.setAttribute('aria-describedby', 'jq-run-hint');
        }
      }
    }

    function hideActions(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
      copyAllBtn!.hidden = true;
      copyAllBtn!.dataset.copy = '';
    }

    function setActiveChip(idx: number | null): void {
      syncChipsByIndex(chipsWrap, idx);
    }

    function applyFlagChrome(): void {
      flagBtns.forEach((btn) => {
        const key = btn.dataset.flag as keyof Flags | undefined;
        btn.setAttribute('aria-pressed', key && flags[key] ? 'true' : 'false');
      });
    }

    // `programText` is passed in from the editor's updateListener, where
    // `programView` is not yet assigned (its own initialiser is still running).
    function applyRiskHint(programText?: string): void {
      let hint: string | null = null;
      try {
        hint = engine.unboundedRiskHint(programText ?? programView.state.doc.toString());
      } catch {
        hint = null;
      }
      riskEl!.textContent = hint ?? '';
      riskEl!.hidden = hint === null;
    }

    /* ---- Deep link / share ---------------------------------------------- */

    function currentFragment(): string {
      try {
        return hashApi.encodeState({
          program: programView.state.doc.toString(),
          input: inputView.state.doc.toString(),
          flags,
        });
      } catch {
        return '';
      }
    }

    function writeHash(fragment: string | null): void {
      const target = fragment ?? '';
      if (target === lastWrittenHash) return;
      // Safari throttles replaceState (~100 per 30s) and throws — never let
      // that break typing.
      try {
        if (fragment) {
          window.history.replaceState(null, '', fragment);
        } else {
          window.history.replaceState(null, '', location.pathname + location.search);
        }
        lastWrittenHash = target;
      } catch {
        /* ignore */
      }
    }

    /* ---- Render ---------------------------------------------------------- */

    /** Clear the error slot and un-dim the cards (any non-error state). */
    function clearError(): void {
      errorSlot!.innerHTML = '';
      resultsBox!.removeAttribute('data-stale');
    }

    /** Bind per-row copy payloads on the live `[data-jq-row]` buttons under `box`. */
    function bindRows(box: HTMLElement, rows: string[]): void {
      box.querySelectorAll<HTMLButtonElement>('[data-jq-row]').forEach((btn) => {
        const row = rows[Number(btn.dataset.jqRow)];
        if (typeof row === 'string') btn.dataset.copy = row;
      });
    }

    function renderLoading(): void {
      uiState = 'loading';
      hideActions();
      clearError();
      setSummary('loading jq…', false);
      resultsBox!.innerHTML = LOADING_HTML;
    }

    function renderEmpty(message: string): void {
      uiState = 'empty';
      setErrorState(null);
      hideActions();
      clearError();
      setSummary('', false);
      resultsBox!.innerHTML = emptyHtml(message);
    }

    /**
     * Errors go ABOVE the cards, into #jq-error, and the cards stay — dimmed —
     * so the last good answer is still readable while the filter is fixed.
     * Partial outputs from the failed run travel with the error report.
     */
    function renderErr(result: Err, isAlert: boolean): void {
      const withRetry = result.errorKind === 'engine' && !engineReady;
      errorSlot!.innerHTML = errHtml(result, isAlert, withRetry);
      bindRows(errorSlot!, result.partialOutputs);
      resultsBox!.setAttribute('data-stale', '');
    }

    function showError(result: Err, source: EvalSource): void {
      uiState = 'invalid';
      clearTimers();
      setErrorState(
        result.errorKind === 'input' ? 'input' : result.errorKind === 'engine' ? null : 'program',
      );
      hideActions();
      const label =
        result.errorKind === 'compile'
          ? 'compile error'
          : result.errorKind === 'input'
            ? 'input parse error'
            : result.errorKind === 'runtime'
              ? `runtime error · exit ${group(result.exitCode)}`
              : // An `engine` error with jq already loaded is an Emscripten
                // abort — this run ran out of WASM heap. jq itself is still
                // there (the badge still reads its version and the next run
                // works), so "jq unavailable" would overstate it.
                engineReady
                ? 'run aborted'
                : 'jq unavailable';
      setSummary(label, true);
      renderErr(result, source === 'commit');
      if (source !== 'seed') writeHash(null);
    }

    /* ---- Evaluate -------------------------------------------------------- */

    function evaluate(source: EvalSource): void {
      clearTimers();
      applyRiskHint();
      if (!engineReady) return;

      const program = programView.state.doc.toString();
      const input = inputView.state.doc.toString();
      if (program.trim().length === 0) {
        renderEmpty(
          'Write a jq filter above — "." is the identity filter and prints the input unchanged.',
        );
        if (source !== 'seed') writeHash(null);
        return;
      }
      if (input.trim().length === 0 && !flags.nullInput) {
        renderEmpty(
          'Paste some JSON below — or turn on -n to run the filter once with null as its input.',
        );
        if (source !== 'seed') writeHash(null);
        return;
      }

      const seq = ++runSeq;
      void engine
        .runJq(program, input, flags)
        .then((result) => {
          if (seq !== runSeq) return; // a newer run superseded this one
          if (result.ok) {
            uiState = 'valid';
            setErrorState(null);
            clearError();
            resultsBox!.innerHTML = okHtml(result);
            // Newlines round-trip badly through HTML attributes, so per-row
            // payloads are set on the live elements instead.
            bindRows(resultsBox!, result.outputs);
            setSummary(okSummary(result), false);
            copyAllBtn!.hidden = false;
            copyAllBtn!.dataset.copy = result.outputText;
            const fragment = currentFragment();
            if (fragment.length > 0 && fragment.length <= MAX_HASH_LEN) {
              shareBtn!.hidden = false;
              shareBtn!.dataset.copy =
                location.origin + location.pathname + location.search + fragment;
              if (source !== 'seed') {
                writeHash(fragment);
                recordToolLastInput(SLUG, fragment);
              }
            } else {
              // Too long to be a dependable link: keep running, drop the share.
              shareBtn!.hidden = true;
              shareBtn!.dataset.copy = '';
              if (source !== 'seed') writeHash(null);
            }
            return;
          }

          if (source !== 'type') {
            showError(result, source);
            return;
          }
          // Mid-typing: hold the previous card, nothing goes red yet. The error
          // only surfaces once the typing has been idle for ERROR_HOLD_MS.
          uiState = 'pending';
          setErrorState(null);
          hideActions();
          setSummary('', false);
          errTimer = window.setTimeout(() => {
            if (seq !== runSeq) return;
            showError(result, 'type');
          }, ERROR_HOLD_MS);
        })
        .catch((err: unknown) => {
          // runJq is documented never to reject; this is belt and braces.
          console.error('[JqPlayground] runJq rejected:', err);
        });
    }

    /* ---- Seed (before any listener fires, so nothing writes the hash) ---- */

    const firstExample = examples[0];
    let seedProgram = firstExample?.program ?? '.';
    let seedInput = firstExample?.input ?? '';
    let seedChip: number | null = firstExample ? 0 : null;
    if (firstExample) flags = { ...firstExample.flags };

    function applyShareState(state: ShareState): void {
      seedProgram = state.program;
      // A hand-written `#q=.items[].name` carries no input. Seeding the first
      // example's input is the honest reading: the fragment asked for a
      // program, and a program with nothing to run against shows nothing.
      seedInput = state.input === null ? (firstExample?.input ?? '') : state.input;
      flags = { ...state.flags };
      seedChip = null;
    }

    let fromHash = false;
    try {
      const shared = hashApi.decodeState(window.location.hash);
      if (shared && shared.program.trim().length > 0) {
        applyShareState(shared);
        fromHash = true;
      }
    } catch {
      /* malformed fragment — fall through to the restore/example tiers */
    }

    if (!fromHash) {
      const restored = getRestoredLastInput(SLUG);
      if (restored) {
        try {
          const state = hashApi.decodeState(restored);
          if (state && state.program.trim().length > 0) applyShareState(state);
        } catch {
          /* malformed stored value — keep the example seed */
        }
      }
    }

    const programView = makeEditor(programHost, seedProgram, PROGRAM_LABEL, [], { min: '64px', max: '240px' });
    const inputView = makeEditor(inputHost, seedInput, 'JSON input', [jsonLang()], { min: '200px', max: '400px' });
    // The build-time stand-ins have done their job (no-JS visitors and
    // crawlers); CodeMirror appended its editors beside them, so drop them —
    // only now, once the hash and restore tiers above have chosen the docs.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());
    applyFlagChrome();
    setActiveChip(seedChip);
    applyRiskHint();

    // Still showing exactly the seeded first example (no deep link, no
    // restored session): the server-rendered answer IS that example's real jq
    // output (fixture.test.ts proves it), so it stays on screen while the
    // binary loads, with its row payloads bound from the rendered text. Any
    // other document gets the loading card — never a stale answer to a
    // different question.
    const showingSeed =
      seedChip === 0 &&
      resultsBox.querySelector('.jqp-out') !== null &&
      !!firstExample &&
      programView.state.doc.toString() === firstExample.program &&
      inputView.state.doc.toString() === firstExample.input;
    if (showingSeed) {
      uiState = 'loading';
      resultsBox.querySelectorAll<HTMLButtonElement>('[data-jq-row]').forEach((btn) => {
        const code = btn.closest('.jqp-out')?.querySelector('code');
        if (code) btn.dataset.copy = code.textContent ?? '';
      });
    } else {
      renderLoading();
    }

    /* ---- Events ---------------------------------------------------------- */

    flagBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.flag as keyof Flags | undefined;
        if (!key) return;
        flags = { ...flags, [key]: !flags[key] };
        applyFlagChrome();
        // The active example no longer describes what is on screen.
        setActiveChip(null);
        clearTimers();
        evaluate('commit');
      });
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        const ex = examples[idx];
        flags = { ...ex.flags };
        applyFlagChrome();
        liveReady = false;
        setEditorDoc(programView, ex.program);
        setEditorDoc(inputView, ex.input);
        liveReady = true;
        setActiveChip(idx);
        clearTimers();
        evaluate('commit');
      });
    });

    // Committing on blur means a half-typed filter that the user tabbed away
    // from still explains itself, instead of sitting silently in `pending`.
    [programView, inputView].forEach((view) => {
      view.contentDOM.addEventListener('blur', () => {
        if (uiState === 'pending') {
          clearTimers();
          evaluate('commit');
        }
      });
    });

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      // The snapshot payload is the same `#q=` fragment the share link uses, so
      // the program, the input AND the four flags all come back together.
      getValue: () => currentFragment(),
      setValue: (value) => {
        let state: ShareState | null = null;
        try {
          state = hashApi.decodeState(value);
        } catch {
          return;
        }
        if (!state) return;
        flags = { ...state.flags };
        applyFlagChrome();
        liveReady = false;
        setEditorDoc(programView, state.program);
        if (state.input !== null) setEditorDoc(inputView, state.input);
        liveReady = true;
        setActiveChip(null);
        clearTimers();
        evaluate('commit');
      },
    });

    /* ---- WASM: fetched at idle, never on the critical path --------------- */

    async function loadEngine(userInitiated: boolean): Promise<void> {
      if (engineReady) return;
      if (userInitiated) renderLoading();
      try {
        engine.configureJq({ wasmURL });
        const handle = await engine.getJq({ wasmURL });
        engineReady = true;
        versionBadge!.textContent = handle.version;
        versionBadge!.hidden = false;
        // The seed evaluation — deliberately `'seed'`, so it writes no hash and
        // records no last-input even though it happens after boot.
        evaluate('seed');
      } catch (err) {
        uiState = 'failed';
        hideActions();
        setSummary('jq unavailable', true);
        renderErr(
          {
            ok: false,
            errorKind: 'engine',
            error:
              'The jq WebAssembly module could not be loaded: ' +
              (err instanceof Error ? err.message : 'unknown error') +
              '. It is served from this site, so an offline tab, a blocked request or a corrupted ' +
              'cache entry are the usual causes.',
            errorScope: null,
            partialOutputs: [],
            partialTruncated: false,
            totalPartialOutputs: 0,
            elapsedMs: 0,
            flags: [],
            version: '',
            exitCode: 0,
            stderr: '',
            notices: [],
            noticesTruncated: false,
            totalNotices: 0,
          },
          true,
        );
        console.error('[JqPlayground] jq WASM load failed:', err);
      }
    }

    liveReady = true;
    requestAnimationFrame(() => {
      programView.requestMeasure();
      inputView.requestMeasure();
    });

    const idle = (window as unknown as { requestIdleCallback?: (cb: () => void) => number })
      .requestIdleCallback;
    if (typeof idle === 'function') idle(() => void loadEngine(false));
    else window.setTimeout(() => void loadEngine(false), 60);
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
