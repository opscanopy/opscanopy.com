---
/**
 * CaseConverterPlayground — the interactive Case Converter island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>.
 * One text input; every case style (camelCase, snake_case, kebab-case, …) is
 * rendered as a labeled, copyable row. Example chips render server-side and run
 * on tap. Evaluation is synchronous and debounced while typing (Enter commits
 * immediately). Per-row copy, Copy all, a shareable #q= deep link and saved
 * snapshots of the raw input.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar, ResultPanel (figure cap, live summary, copy status)
 * and CopyButton. The results container stays here, seeded with
 * `set:html` + `data-results`; its slab overrides anchor on `.cc-results`.
 *
 * Runtime contract (engine lazy-imported for code-splitting):
 *   ../lib/case-converter/engine → convertCases(input: string): CaseResult
 *   ../lib/case-converter/types  → CaseResult { valid; error?; rows[] }
 * Example chips are imported statically in the frontmatter so they render SSR.
 */
import { examples } from '../lib/case-converter/examples';
import { convertCases } from '../lib/case-converter/engine';
import { resultHtml, summaryText, EMPTY_HTML } from '../lib/case-converter/render';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-computes the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees a real worked answer
 * instead of an empty "type something here" panel.
 *
 * `convertCases` is pure and synchronous, so it runs at build time unchanged.
 */
const seedExample = examples[0];
const seedResult = seedExample ? convertCases(seedExample.input) : null;
const seedHtml = seedResult && seedResult.valid ? resultHtml(seedResult) : EMPTY_HTML;
const seedSummary = seedResult && seedResult.valid ? summaryText(seedResult) : '';
const chipItems = examples.map((ex) => ({ label: ex.label, input: ex.input, ariaLabel: ex.label }));
const seedIdx = seedExample ? examples.findIndex((ex) => ex.input === seedExample.input) : -1;
---

<section class="cc-pg" aria-label="Case Converter playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: example chips ───────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow">Examples</span>
      <ExampleChips prefix="cc" items={chipItems} active={seedIdx >= 0 ? seedIdx : null} ariaLabel="Examples" />
    </div>

    {/* ── Text input ───────────────────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <label class="eyebrow mb-2 block" for="cc-input">Text to convert</label>
      <textarea
        id="cc-input"
        class="cc-input code-mono"
        rows="3"
        spellcheck="false"
        autocapitalize="off"
        autocorrect="off"
        autocomplete="off"
        placeholder="userProfileID"
        aria-describedby="cc-input-hint cc-input-live">{seedExample?.input}</textarea>
      <p id="cc-input-hint" class="cc-hint caption text-mute">
        Word boundaries are detected from spaces, hyphens, underscores and camelCase humps —
        <span class="code-mono">getHTTPResponse</span> splits into
        <span class="code-mono">get / http / response</span>.
      </p>
      <RunHint id="cc-input-live" />
      <SnapshotBar prefix="cc" />
    </div>

    {/* ── Results panel — the L2 instrument (dark in both themes) under its
        figure cap; the live summary reads out in the cap's actions slot. ── */}
    <ResultPanel slug="case-converter" prefix="cc" summary={seedSummary} split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="cc-share" />
        <CopyButton kind="all" id="cc-copy-all" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the answer is in the
          static HTML; the client replaces it with the same markup on boot. */}
      <div id="cc-results" class="cc-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .cc-input {
    width: 100%;
    min-height: 84px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 14px;
    line-height: 22px;
    resize: vertical;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .cc-input::placeholder {
    color: var(--color-mute);
  }
  .cc-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .cc-input:focus {
    outline: none;
  }
  .cc-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }

  .cc-hint {
    margin-top: 8px;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .cc-hint .code-mono {
    font-size: 12px;
    color: var(--color-body);
  }
  .cc-results {
    min-height: 120px;
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.cc-results` container (the panel
     wrapper is ResultPanel's and carries no scope attribute). */
  :global(.cc-card) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: cc-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.cc-row) {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 12px;
    padding: 9px 14px;
    align-items: baseline;
  }
  @media (max-width: 479px) {
    :global(.cc-row) {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
  :global(.cc-row + .cc-row) {
    border-top: 1px solid var(--color-hairline);
  }
  /* Row-key role (label-field): mono 11/16 uppercase, the only label. */
  :global(.cc-row__k) {
    @apply label-field;
  }
  :global(.cc-row__v-wrap) {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    margin: 0;
  }
  :global(.cc-row__v) {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-all;
  }

  /* ── Per-row copy buttons (render.ts; copy.ts drives them) ──────────── */
  :global(.cc-copy-btn) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-brand),
      background var(--dur-fast) var(--ease-brand);
    padding: 0;
  }
  :global(.cc-copy-btn:hover) {
    color: var(--color-brand-strong);
    background: var(--color-hairline);
  }
  :global(.cc-copy-btn:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  :global(.cc-copy-btn[data-copied]) {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
  }
  @media (pointer: coarse) {
    :global(.cc-copy-btn) {
      width: var(--control-h-lg);
      height: var(--control-h-lg);
    }
  }

  @keyframes cc-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.cc-card) {
      animation: none;
    }
  }

  :global(.cc-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.cc-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.cc-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.cc-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.cc-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below it uses the slab ink tier; the light rules
     above remain the documented defaults. ──────────────────────────────── */
  .cc-results :global(.cc-empty) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .cc-results :global(.cc-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .cc-results :global(.cc-card) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .cc-results :global(.cc-row + .cc-row) {
    border-top-color: #ffffff12;
  }
  .cc-results :global(.cc-row__k) {
    color: var(--color-inverse-mute);
  }
  .cc-results :global(.cc-row__v) {
    color: var(--color-inverse-fg);
  }
  /* Values right-align like every instrument readout; the stacked <480px
     layout returns to the left edge. */
  .cc-results :global(.cc-row__v-wrap) {
    justify-content: flex-end;
  }
  .cc-results :global(.cc-row__v) {
    text-align: right;
  }
  @media (max-width: 479px) {
    .cc-results :global(.cc-row__v-wrap) {
      justify-content: flex-start;
    }
    .cc-results :global(.cc-row__v) {
      text-align: left;
    }
  }
  .cc-results :global(.cc-copy-btn) {
    color: var(--color-inverse-mute);
  }
  .cc-results :global(.cc-copy-btn:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .cc-results :global(.cc-copy-btn[data-copied]) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
</style>

<script>
  import {
    EMPTY_HTML,
    errorHtml,
    resultHtml,
    buildCopyAll,
    summaryText,
  } from '../lib/case-converter/render';
  import { wireRunKeys } from '../lib/run-keys';
  import { createHashState } from '../lib/hash-state';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByInput, clearChips, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { wireSnapshotUI } from '../lib/tool-state/wire';
  import type { CaseResult as Result } from '../lib/case-converter/types';

  type EngineModule = { convertCases: (input: string) => Result };

  const ROOT_SEL = '.cc-pg';
  const DEBOUNCE_MS = 140;
  const ERROR_HOLD_MS = 600;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.ccWired === 'true') return;
      root.dataset.ccWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = EMPTY_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    setSummary(summary, 'No output', true);
    container.innerHTML = errorHtml(message);
  }

  function renderResult(container: HTMLElement, result: Result): void {
    container.innerHTML = resultHtml(result);
  }

  async function init(root: HTMLElement): Promise<void> {
    const input = el<HTMLTextAreaElement>(root, '#cc-input');
    const resultsBox = el<HTMLElement>(root, '#cc-results');
    const summaryEl = el<HTMLElement>(root, '#cc-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#cc-share');
    const copyAllBtn = el<HTMLButtonElement>(root, '#cc-copy-all');
    const copyStatus = el<HTMLElement>(root, '#cc-copy-status');
    const chipsWrap = el<HTMLElement>(root, '#cc-chips');
    const chips = Array.from(chipsWrap?.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR) ?? []);
    const snapSaveBtn = el<HTMLButtonElement>(root, '#cc-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#cc-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#cc-snap-delete');
    if (
      !input ||
      !resultsBox ||
      !summaryEl ||
      !shareBtn ||
      !copyAllBtn ||
      !copyStatus ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    )
      return;

    /* ------------------------------------------------------------------ */
    /* Copy plumbing (row buttons, Copy link, Copy all) — the kit helper:  */
    /* one delegated listener; outcomes announced in #cc-copy-status.      */
    /* ------------------------------------------------------------------ */

    wireCopyButtons(root, { status: copyStatus });

    /* ------------------------------------------------------------------ */
    /* Engine (dynamic import → code-splits away from the page shell)      */
    /* ------------------------------------------------------------------ */

    let engine: EngineModule;
    try {
      engine = (await import('../lib/case-converter/engine')) as unknown as EngineModule;
    } catch (err) {
      renderError(
        resultsBox,
        summaryEl,
        'The converter engine failed to load. Reload the page to try again.'
      );
      console.error('[CaseConverter] engine import failed:', err);
      return;
    }

    /* ------------------------------------------------------------------ */
    /* State machine: EMPTY | VALID | PENDING                              */
    /* ------------------------------------------------------------------ */

    let evalTimer: number | undefined;
    let errTimer: number | undefined;
    const hashState = createHashState('q');

    function clearTimers(): void {
      window.clearTimeout(evalTimer);
      window.clearTimeout(errTimer);
    }

    function hideActions(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
      copyAllBtn!.hidden = true;
      copyAllBtn!.dataset.copy = '';
    }

    function toEmpty(): void {
      clearTimers();
      hideActions();
      renderEmpty(resultsBox!, summaryEl!);
      clearChips(chipsWrap);
      hashState.write(null);
    }

    function showError(message: string): void {
      clearTimers();
      hideActions();
      renderError(resultsBox!, summaryEl!, message);
      clearChips(chipsWrap);
      hashState.write(null);
    }

    function evaluate(source: 'type' | 'commit' | 'seed'): void {
      clearTimers();
      const value = input!.value;
      if (value.trim().length === 0) {
        toEmpty();
        return;
      }

      let result: Result | null = null;
      try {
        result = engine.convertCases(value);
      } catch {
        result = null;
      }

      if (result && result.valid !== false) {
        renderResult(resultsBox!, result);
        setSummary(summaryEl!, summaryText(result), false);
        shareBtn!.hidden = false;
        shareBtn!.dataset.copy =
          location.origin + location.pathname + location.search + hashState.build(value);
        copyAllBtn!.hidden = false;
        copyAllBtn!.dataset.copy = buildCopyAll(result);
        syncChipsByInput(chipsWrap, value);
        if (source !== 'seed') hashState.write(value);
        return;
      }

      const message = result?.error ?? 'Enter some text to convert.';
      if (source !== 'type') {
        showError(message);
        return;
      }

      // Mid-typing: hold the last card briefly, no error yet.
      hideActions();
      setSummary(summaryEl!, '', false);
      errTimer = window.setTimeout(() => showError(message), ERROR_HOLD_MS);
    }

    /* ------------------------------------------------------------------ */
    /* Events                                                              */
    /* ------------------------------------------------------------------ */

    input.addEventListener('input', () => {
      clearTimers();
      if (input.value.trim().length === 0) {
        toEmpty();
        return;
      }
      evalTimer = window.setTimeout(() => evaluate('type'), DEBOUNCE_MS);
    });

    // Enter commits here rather than inserting (Shift+Enter is the newline) —
    // the helper preserves that, and adds the Ctrl/Cmd+Enter every other tool has.
    wireRunKeys(input, () => evaluate('commit'));

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        input.value = chip.dataset.input ?? '';
        evaluate('commit');
      });
    });

    // Snapshots store the raw input text (the same value #q= carries).
    wireSnapshotUI({
      slug: 'case-converter',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => input!.value,
      setValue: (value) => {
        input!.value = value;
        evaluate('commit');
      },
    });

    /* ------------------------------------------------------------------ */
    /* First load: #q= deep link → seeded first chip. Seeding never writes  */
    /* the hash — only user actions do.                                     */
    /* ------------------------------------------------------------------ */

    function readQueryHash(): string | null {
      const m = window.location.hash.match(/[#&]q=([^&]*)/);
      if (!m) return null;
      try {
        return decodeURIComponent(m[1]);
      } catch {
        return m[1];
      }
    }

    const hashValue = readQueryHash();
    const seed = chips[0]?.dataset.input ?? '';

    if (hashValue) {
      input.value = hashValue;
      evaluate('seed');
    } else if (seed) {
      input.value = seed;
      evaluate('seed');
    } else {
      renderEmpty(resultsBox, summaryEl);
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
