---
/**
 * CveConverterPlayground — the interactive CVE-Ignore Converter island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>
 * that lazily boots a CodeMirror 6 input editor and a read-only output editor,
 * wires "From"/"To" format pickers and the example chips. Conversion is live
 * and debounced; "Run now" and ⌘/Ctrl + Enter convert immediately.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * EditorPane (source + converted policy, side by side from 768px), RunHint,
 * SnapshotBar, ResultPanel (figure cap, live summary, copy status) and
 * CopyButton. The notes container stays here, seeded with `set:html` +
 * `data-results`; its slab overrides anchor on `.cv-messages`.
 *
 * Runtime contract (imported lazily in the script):
 *   ../lib/cve-ignore/engine →
 *     convert(from: Format, to: Format, text: string) =>
 *       { output: string; warnings: string[]; error?: string }
 *     encodeState(src: Format, dst: Format, text: string) => string  // hash fragment
 *     decodeState() => { src: Format; dst: Format; text: string } | null
 *   ../lib/cve-ignore/types →
 *     FORMATS: { value: Format; label: string; filename: string }[]
 *   ../lib/cve-ignore/examples →
 *     examples: { id: string; label: string; from: Format; to: Format; text: string }[]
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used to server-render the example chips (ExampleChips), so the static HTML
// carries real example names for crawlers and no-JS visitors. The script
// re-reads the examples module at hydration and addresses each chip by its
// `data-example-idx`, so this adds nothing to the client bundle.
// The From/To pickers stay <select>s — they are format pickers, not examples.
import { examples as prerenderedExamples } from '../lib/cve-ignore/examples';
import { convert } from '../lib/cve-ignore/engine';
import { FORMATS } from '../lib/cve-ignore/types';
import {
  EMPTY_HTML,
  errorHtml,
  filenameFor,
  outputText,
  warningsHtml,
  warningsSummaryText,
} from '../lib/cve-ignore/render';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-converts the same example on boot, so
 * this is pure progressive enhancement — but it means a no-JS visitor, and
 * every AI crawler (they do not execute JS), sees the real converted Snyk
 * policy and all three lossy-conversion notes instead of two empty editors.
 *
 * `convert` is pure and synchronous — no clock, no random, no network — so it
 * runs unchanged at build time. Both documents go into
 * `<pre data-cm-fallback>` elements inside the CodeMirror hosts; CM appends its
 * editor to the host, so the script removes every fallback once mounted.
 *
 * NOT seeded, because it is not knowable at build time: the `#s=` share URL
 * (built from `window.location`), so the copy actions stay hidden until the
 * client converts.
 */
const seedExample = prerenderedExamples[0];
const seedResult = seedExample ? convert(seedExample.from, seedExample.to, seedExample.text) : null;
const seedInput = seedExample ? seedExample.text : '';
const seedOutput = seedResult ? outputText(seedResult) : '';
const seedWarnings = seedResult && !seedResult.error ? seedResult.warnings : [];
const seedMessagesHtml = !seedResult
  ? EMPTY_HTML
  : seedResult.error
    ? errorHtml(seedResult.error)
    : warningsHtml(seedWarnings);
const seedSummary = !seedResult
  ? ''
  : seedResult.error
    ? 'Error'
    : warningsSummaryText(seedWarnings);
const seedFrom = seedExample ? seedExample.from : FORMATS[0].value;
const seedTo = seedExample ? seedExample.to : FORMATS[1].value;
const seedInputName = filenameFor(FORMATS, seedFrom);
const seedOutputName = filenameFor(FORMATS, seedTo);
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="cv-pg" aria-label="CVE-Ignore Converter playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: formats, examples, Run now ──────────────────────────── */}
    <div
      class="flex flex-col gap-3 border-b border-hairline px-4 py-3 lg:flex-row lg:items-end lg:justify-between lg:px-5"
    >
      <div class="flex min-w-0 flex-wrap items-end gap-3">
        <div class="flex min-w-0 flex-col gap-1">
          <label class="eyebrow" for="cv-from">From</label>
          <div class="cv-select-wrap relative min-w-0">
            <select id="cv-from" class="cv-select code-mono" autocomplete="off">
              {/* Server-rendered from `FORMATS` (the script refills the same
                  list on boot) so the static HTML names the real ecosystems. */}
              {
                FORMATS.map((f) => (
                  <option value={f.value} selected={f.value === seedFrom}>
                    {f.label}
                  </option>
                ))
              }
            </select>
            <svg
              class="cv-select-caret pointer-events-none absolute top-1/2 right-3 h-4 w-4 -translate-y-1/2 text-mute"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 6l4 4 4-4"></path>
            </svg>
          </div>
        </div>

        <span class="cv-arrow hidden shrink-0 pb-1.5 text-mute sm:inline-flex" aria-hidden="true">
          <svg
            class="h-4 w-4"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 8h10M9 4l4 4-4 4"></path>
          </svg>
        </span>

        <div class="flex min-w-0 flex-col gap-1">
          <label class="eyebrow" for="cv-to">To</label>
          <div class="cv-select-wrap relative min-w-0">
            <select id="cv-to" class="cv-select code-mono" autocomplete="off">
              {
                FORMATS.map((f) => (
                  <option value={f.value} selected={f.value === seedTo}>
                    {f.label}
                  </option>
                ))
              }
            </select>
            <svg
              class="cv-select-caret pointer-events-none absolute top-1/2 right-3 h-4 w-4 -translate-y-1/2 text-mute"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 6l4 4 4-4"></path>
            </svg>
          </div>
        </div>

        <div class="flex min-w-0 flex-col gap-1">
          <span class="eyebrow">Examples</span>
          <ExampleChips prefix="cv" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
        </div>
      </div>

      <button
        id="cv-convert"
        type="button"
        class="btn-tool cv-tap"
        title="Run now (⌘/Ctrl + Enter)"
        aria-keyshortcuts="Meta+Enter Control+Enter"
      >
        Run now
      </button>
    </div>

    {/* ── Editors: source policy | converted policy (side by side ≥768px) ─ */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <div class="cv-grid">
        <EditorPane prefix="cv" id="cv-editor-input" label={seedInputName}>
          <pre class="editor-pane__fallback code-mono" data-cm-fallback>{seedInput}</pre>
        </EditorPane>
        <EditorPane prefix="cv" id="cv-editor-output" label={seedOutputName}>
          <Fragment slot="actions">
            <CopyButton kind="all" id="cv-copy" label="Copy output" />
          </Fragment>
          <pre class="editor-pane__fallback code-mono" data-cm-fallback>{seedOutput}</pre>
        </EditorPane>
      </div>
      <RunHint variant="cm" class="mt-2" />
      <SnapshotBar prefix="cv" />
    </div>

    {/* ── Result: lossy-conversion notes on the L2 instrument ──────────── */}
    <ResultPanel slug="cve-ignore-converter" prefix="cv" summary={seedSummary} label="Notes" summaryClass="whitespace-nowrap" split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="cv-share" />
        <CopyButton kind="value" id="cv-share-md" label="Copy as Markdown" icon="markdown" />
      </Fragment>
      {/* Seeded at build time (see `seedMessagesHtml` above) so the lossy-
          conversion notes are in the static HTML; the client replaces it with
          the same markup on boot. */}
      <div id="cv-messages" class="cv-messages" set:html={seedMessagesHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* Tap targets opt into fast-tap + no double-tap-zoom on touch. */
  .cv-tap {
    touch-action: manipulation;
  }

  /* The From/To format pickers: in-app form controls. */
  .cv-select {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    height: var(--control-h-md);
    min-width: 0;
    max-width: 280px;
    padding: 0 32px 0 12px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 13px;
    line-height: 20px;
    cursor: pointer;
    text-overflow: ellipsis;
    touch-action: manipulation;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  @media (min-width: 640px) {
    .cv-select {
      width: auto;
      min-width: 168px;
    }
  }
  .cv-select:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .cv-select:disabled {
    cursor: not-allowed;
    color: var(--color-mute);
    opacity: 0.7;
  }
  .cv-select-caret {
    transition: color var(--dur-fast) var(--ease-brand);
  }
  .cv-select-wrap:hover .cv-select-caret {
    color: var(--color-body);
  }

  /* Source | converted, side by side from 768px. */
  .cv-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  @media (min-width: 768px) {
    .cv-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Messages list (warnings / success / empty). */
  .cv-messages {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.cv-messages` container. */
  :global(.cv-warn) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-warning-soft);
    box-shadow: inset 0 0 0 1px var(--color-warning);
    color: var(--color-warning-deep);
    animation: cv-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.cv-warn__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    color: var(--color-warning-deep);
  }
  :global(.cv-warn__body) {
    min-width: 0;
    flex: 1 1 auto;
  }
  :global(.cv-warn__title) {
    font-size: 13px;
    font-weight: 500;
    line-height: 18px;
  }
  :global(.cv-warn__list) {
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  :global(.cv-warn__item) {
    position: relative;
    padding-left: 16px;
    font-size: 13px;
    line-height: 18px;
    word-break: break-word;
  }
  :global(.cv-warn__item::before) {
    content: '';
    position: absolute;
    left: 4px;
    top: 7px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.7;
  }

  /* Success note (no warnings, conversion clean). */
  :global(.cv-ok) {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    animation: cv-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.cv-ok__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    color: var(--color-success);
  }
  :global(.cv-ok__text) {
    font-size: 13px;
    line-height: 18px;
  }

  /* Parse / conversion error banner. */
  :global(.cv-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
    animation: cv-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.cv-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.cv-error__body) {
    min-width: 0;
  }
  :global(.cv-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.cv-error__detail) {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  @keyframes cv-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.cv-warn),
    :global(.cv-ok),
    :global(.cv-error) {
      animation: none;
    }
  }

  /* Empty state — generous, centered frame. */
  :global(.cv-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* ── Instrument re-skin — the notes sit on the L2 result slab (dark in
     BOTH themes), so everything render.ts emits uses the slab ink tier. ── */
  .cv-messages :global(.cv-warn) {
    background: #e0a45814;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-accent);
  }
  .cv-messages :global(.cv-warn__icon) {
    color: var(--color-inverse-accent);
  }
  .cv-messages :global(.cv-warn__item) {
    color: var(--color-inverse-fg);
  }
  .cv-messages :global(.cv-ok),
  .cv-messages :global(.cv-empty) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-fg);
  }
  .cv-messages :global(.cv-ok__icon) {
    color: var(--color-inverse-brand);
  }
  .cv-messages :global(.cv-empty) {
    color: var(--color-inverse-mute);
  }
  .cv-messages :global(.cv-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }

  .is-busy {
    opacity: 0.65;
    pointer-events: none;
    cursor: progress;
  }
</style>

<script>
  import { buildMarkdownBlock } from '../lib/share-md';
  import type { EditorView } from '@codemirror/view';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, clearChips, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  // The same pure builders the frontmatter used for the SSR seed — one
  // implementation, so the seeded panel and every later conversion agree.
  import {
    EMPTY_HTML,
    errorHtml,
    filenameFor,
    warningsHtml,
    warningsSummaryText,
  } from '../lib/cve-ignore/render';

  /* ---- Types mirrored from the engine contract (structural, not imported). -- */
  type Format = string;
  type FormatDescriptor = { value: Format; label: string; filename: string };
  type ConvertResult = { output: string; warnings?: string[]; error?: string };
  type ShareState = { src: Format; dst: Format; text: string };
  type EngineModule = {
    convert: (from: Format, to: Format, text: string) => ConvertResult | Promise<ConvertResult>;
    encodeState: (src: Format, dst: Format, text: string) => string;
    decodeState: () => ShareState | null;
  };
  type TypesModule = { FORMATS?: unknown };
  type Example = { id: string; label: string; from: Format; to: Format; text: string };
  /** `seed` = boot / deep link / restore (never written or recorded); `type` = debounced edit; `run` = explicit. */
  type Source = 'seed' | 'type' | 'run';

  const ROOT_SEL = '.cv-pg';
  const SLUG = 'cve-ignore-converter';
  const DEBOUNCE_MS = 180;
  const ERROR_HOLD_MS = 600;

  /** Boot every (so far un-hydrated) playground instance on the page. */
  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.cvWired === 'true') return;
      root.dataset.cvWired = 'true';
      void init(root);
    });
  }

  /* ---- Small helpers -------------------------------------------------------- */

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function isCoarsePointer(): boolean {
    return window.matchMedia?.('(pointer: coarse)').matches ?? false;
  }

  /**
   * Rename an EditorPane's figure cap (the file name follows the format
   * pickers). EditorPane renders a static label; the cap's label span is the
   * only text in it, so this rewrites that span and its title.
   */
  function setPaneLabel(host: HTMLElement, text: string): void {
    const label = host.closest('[data-editor-pane]')?.querySelector<HTMLElement>('.figcap__label');
    if (!label) return;
    label.textContent = text;
    label.title = text;
  }

  /** Normalise the sibling FORMATS list into a stable descriptor array. */
  function normaliseFormats(raw: unknown): FormatDescriptor[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item) => {
        const o = (item ?? {}) as Record<string, unknown>;
        const value = typeof o.value === 'string' ? o.value : '';
        if (!value) return null;
        const label = typeof o.label === 'string' && o.label ? o.label : value;
        const filename = typeof o.filename === 'string' && o.filename ? o.filename : '';
        return { value, label, filename } satisfies FormatDescriptor;
      })
      .filter((f): f is FormatDescriptor => f !== null);
  }

  /** Normalise the sibling examples list defensively. */
  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        const text = typeof o.text === 'string' ? o.text : '';
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          from: typeof o.from === 'string' ? o.from : '',
          to: typeof o.to === 'string' ? o.to : '',
          text,
        } satisfies Example;
      })
      .filter((e) => e.text.length > 0 || e.from || e.to);
  }

  /* ---- Summary + message rendering (slab inks) ------------------------------
     The HTML itself is built by ../lib/cve-ignore/render, which the Astro
     frontmatter also calls for the SSR seed. Only the DOM writes and the
     summary's tone classes live here. */

  type Tone = 'mute' | 'accent' | 'error';
  function setSummary(summary: HTMLElement, text: string, tone: Tone): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-mute', tone === 'mute');
    summary.classList.toggle('text-inverse-accent', tone === 'accent');
    summary.classList.toggle('text-inverse-error', tone === 'error');
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', 'mute');
    container.innerHTML = EMPTY_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    setSummary(summary, 'Error', 'error');
    container.innerHTML = errorHtml(message);
  }

  function renderWarnings(container: HTMLElement, summary: HTMLElement, warnings: string[]): void {
    setSummary(summary, warningsSummaryText(warnings), warnings.length === 0 ? 'mute' : 'accent');
    container.innerHTML = warningsHtml(warnings);
  }

  /* ---- Instance init -------------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const inputHost = el<HTMLElement>(root, '#cv-editor-input');
    const outputHost = el<HTMLElement>(root, '#cv-editor-output');
    const fromSel = el<HTMLSelectElement>(root, '#cv-from');
    const toSel = el<HTMLSelectElement>(root, '#cv-to');
    const chipsWrap = el<HTMLElement>(root, '#cv-chips');
    const convertBtn = el<HTMLButtonElement>(root, '#cv-convert');
    const copyBtn = el<HTMLButtonElement>(root, '#cv-copy');
    const shareBtn = el<HTMLButtonElement>(root, '#cv-share');
    const shareMdBtn = el<HTMLButtonElement>(root, '#cv-share-md');
    const copyStatus = el<HTMLElement>(root, '#cv-copy-status');
    const messagesBox = el<HTMLElement>(root, '#cv-messages');
    const summaryEl = el<HTMLElement>(root, '#cv-summary');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#cv-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#cv-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#cv-snap-delete');

    if (
      !inputHost ||
      !outputHost ||
      !fromSel ||
      !toSel ||
      !chipsWrap ||
      !convertBtn ||
      !copyBtn ||
      !shareBtn ||
      !shareMdBtn ||
      !copyStatus ||
      !messagesBox ||
      !summaryEl ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    // Copy plumbing (Copy output, Copy link, Copy as Markdown) — the kit
    // helper: one delegated listener; outcomes announced in #cv-copy-status.
    wireCopyButtons(root, { status: copyStatus });

    // Live conversion hook, called by the input editor's update listener; a
    // no-op until convertNow exists below.
    let onInputEdit: () => void = () => {};

    // Lazily load the sibling engine, types, examples, CodeMirror and the
    // kit's plate theme together (off the initial path so CM code-splits into
    // its own chunk).
    let engine: EngineModule;
    let formats: FormatDescriptor[] = [];
    let examples: Example[] = [];
    let EditorState: typeof import('@codemirror/state').EditorState;
    let EditorViewCtor: typeof import('@codemirror/view').EditorView;
    let keymap: typeof import('@codemirror/view').keymap;
    let lineNumbers: typeof import('@codemirror/view').lineNumbers;
    let highlightActiveLine: typeof import('@codemirror/view').highlightActiveLine;
    let defaultKeymap: typeof import('@codemirror/commands').defaultKeymap;
    let history: typeof import('@codemirror/commands').history;
    let historyKeymap: typeof import('@codemirror/commands').historyKeymap;
    let indentWithTab: typeof import('@codemirror/commands').indentWithTab;
    let yaml: typeof import('@codemirror/lang-yaml').yaml;
    let plate: typeof import('../lib/playground-kit/cm-theme').plate;
    try {
      const [engineMod, typesMod, examplesMod, stateMod, viewMod, commandsMod, yamlMod, themeMod] =
        await Promise.all([
          import('../lib/cve-ignore/engine'),
          import('../lib/cve-ignore/types'),
          import('../lib/cve-ignore/examples'),
          import('@codemirror/state'),
          import('@codemirror/view'),
          import('@codemirror/commands'),
          import('@codemirror/lang-yaml'),
          import('../lib/playground-kit/cm-theme'),
        ]);
      engine = engineMod as unknown as EngineModule;
      formats = normaliseFormats((typesMod as TypesModule).FORMATS);
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
      ({ EditorState } = stateMod);
      ({ EditorView: EditorViewCtor, keymap, lineNumbers, highlightActiveLine } = viewMod);
      ({ defaultKeymap, history, historyKeymap, indentWithTab } = commandsMod);
      ({ yaml } = yamlMod);
      ({ plate } = themeMod);
    } catch (err) {
      renderError(
        messagesBox,
        summaryEl,
        'The converter engine failed to load. Reload the page to try again.'
      );
      // eslint-disable-next-line no-console
      console.error('[CveConverter] engine/types/examples import failed:', err);
      return;
    }

    if (formats.length === 0) {
      renderError(messagesBox, summaryEl, 'No formats are available to convert between.');
      [fromSel, toSel].forEach((s) => {
        s.innerHTML = '<option value="">Unavailable</option>';
        s.disabled = true;
      });
      chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR).forEach((chip) => {
        chip.disabled = true;
      });
      clearChips(chipsWrap);
      convertBtn.disabled = true;
      return;
    }

    /** Populate a format <select> with the descriptor list. */
    function fillFormatSelect(sel: HTMLSelectElement, selected: Format): void {
      sel.innerHTML = '';
      formats.forEach((f) => {
        const opt = document.createElement('option');
        opt.value = f.value;
        opt.textContent = f.label;
        sel.appendChild(opt);
      });
      if (formats.some((f) => f.value === selected)) sel.value = selected;
    }

    // Seed priority: a shared `#s=` link > a restored last-input > the first
    // example > sensible format defaults. No seed path writes the hash or
    // records the last input — only user-initiated conversions do.
    const seed = examples[0];
    let shared: ShareState | null = null;
    try {
      shared = engine.decodeState();
    } catch {
      /* malformed hash — fall back to the example seed */
    }
    const fromShare = shared !== null;

    // Restored last-input tier — only consulted when there's no `#s=` deep
    // link. Validates `src`/`dst` against the known formats the same way
    // engine.decodeState() does, and never throws on malformed JSON.
    let restored: ShareState | null = null;
    if (!fromShare) {
      const raw = getRestoredLastInput(SLUG);
      if (raw) {
        try {
          const parsed = JSON.parse(raw) as Partial<ShareState>;
          if (
            parsed &&
            typeof parsed.text === 'string' &&
            formats.some((f) => f.value === parsed.src) &&
            formats.some((f) => f.value === parsed.dst)
          ) {
            restored = { src: parsed.src as string, dst: parsed.dst as string, text: parsed.text };
          }
        } catch {
          /* malformed stored value — ignore, fall back to the example seed */
        }
      }
    }
    const fromRestored = restored !== null;

    const defaultFrom = fromShare && shared && formats.some((f) => f.value === shared!.src)
      ? shared.src
      : fromRestored && restored
        ? restored.src
        : seed?.from && formats.some((f) => f.value === seed.from)
          ? seed.from
          : formats[0].value;
    const defaultTo = fromShare && shared && formats.some((f) => f.value === shared!.dst)
      ? shared.dst
      : fromRestored && restored
        ? restored.dst
        : seed?.to && formats.some((f) => f.value === seed.to)
          ? seed.to
          : (formats.find((f) => f.value !== defaultFrom)?.value ?? formats[0].value);

    fillFormatSelect(fromSel, defaultFrom);
    fillFormatSelect(toSel, defaultTo);

    // The example chips are server-rendered (ExampleChips); wire them by
    // index. A shared or restored input matches no example: no chip pressed.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));
    syncChipsByIndex(chipsWrap, fromShare || fromRestored || !examples.length ? null : 0);
    if (!examples.length) {
      chips.forEach((chip) => {
        chip.disabled = true;
      });
    }

    /* ---- Editors (CM symbols now in async scope) ----------------------------- */

    // Sizing only — colours, gutters and the focus ring come from the plate
    // theme and the EditorPane rule in global.css.
    const sizing = EditorViewCtor.theme({
      '&': { fontSize: '13px', maxHeight: '420px' },
      '.cm-scroller': { overflow: 'auto' },
    });

    function makeInputEditor(host: HTMLElement, doc: string): EditorView {
      const state = EditorState.create({
        doc,
        extensions: [
          lineNumbers(),
          history(),
          highlightActiveLine(),
          yaml(),
          plate,
          sizing,
          EditorViewCtor.lineWrapping,
          EditorViewCtor.contentAttributes.of({ 'aria-label': 'Source suppression policy' }),
          keymap.of([
            // Ours FIRST, so it wins over defaultKeymap's Enter.
            {
              key: 'Mod-Enter',
              run: (view) => {
                void convertNow('run');
                if (isCoarsePointer()) view.contentDOM.blur();
                return true;
              },
            },
            { key: 'Escape', run: (view) => { view.contentDOM.blur(); return true; } },
            ...defaultKeymap,
            ...historyKeymap,
            indentWithTab,
          ]),
          EditorViewCtor.updateListener.of((u) => {
            if (u.docChanged) onInputEdit();
          }),
        ],
      });
      return new EditorViewCtor({ state, parent: host });
    }

    function makeOutputEditor(host: HTMLElement, doc: string): EditorView {
      const state = EditorState.create({
        doc,
        extensions: [
          lineNumbers(),
          yaml(),
          plate,
          sizing,
          EditorViewCtor.lineWrapping,
          EditorViewCtor.editable.of(false),
          EditorState.readOnly.of(true),
          EditorViewCtor.contentAttributes.of({ 'aria-label': 'Converted suppression policy (read-only)' }),
        ],
      });
      return new EditorViewCtor({ state, parent: host });
    }

    function setEditorDoc(view: EditorView, doc: string): void {
      view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: doc } });
    }

    const seedText = fromShare && shared
      ? shared.text
      : fromRestored && restored
        ? restored.text
        : seed?.text ?? '';
    const inputView = makeInputEditor(inputHost, seedText);
    const outputView = makeOutputEditor(outputHost, '');
    // The build-time text stand-ins have done their job (no-JS visitors and
    // crawlers); CodeMirror appended its editors beside them, so drop them —
    // a fallback left behind renders the document twice. The share/restore
    // tiers above already chose the document.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());

    function hideActions(): void {
      for (const btn of [shareBtn!, shareMdBtn!, copyBtn!]) {
        btn.hidden = true;
        btn.dataset.copy = '';
      }
    }

    /** Clear the `#s=` fragment without leaving a new history entry. */
    function clearHash(): void {
      try {
        window.history.replaceState(null, '', window.location.pathname + window.location.search);
      } catch {
        /* Safari's replaceState throttle must never break input */
      }
    }

    /** Sync the editor caps' file names to the chosen formats. */
    function syncNames(): void {
      // Guaranteed present by the early return above; restated because TypeScript
      // discards that narrowing inside a hoisted function declaration.
      if (!fromSel || !toSel || !inputHost || !outputHost) return;
      setPaneLabel(inputHost, filenameFor(formats, fromSel.value));
      setPaneLabel(outputHost, filenameFor(formats, toSel.value));
    }
    syncNames();

    /** A pasteable summary of the current formats + converted output. */
    function markdownFor(output: string, warnings: string[]): string {
      const fromDesc = formats.find((f) => f.value === fromSel!.value);
      const toDesc = formats.find((f) => f.value === toSel!.value);
      const fromLabel = fromDesc
        ? fromDesc.filename
          ? `${fromDesc.label} (${fromDesc.filename})`
          : fromDesc.label
        : fromSel!.value;
      const toLabel = toDesc
        ? toDesc.filename
          ? `${toDesc.label} (${toDesc.filename})`
          : toDesc.label
        : toSel!.value;
      return buildMarkdownBlock('CVE-Ignore Converter', [
        { label: 'Source format', value: fromLabel },
        { label: 'Destination format', value: toLabel },
        { label: 'Converted output', value: output },
        { label: 'Lossy-conversion notes', value: warnings.join('; ') },
      ]);
    }

    // ── Conversion ───────────────────────────────────────────────────────────
    let timer: number | undefined;
    let running = false;
    let queued: Source | null = null;

    // Calm errors (playground UX contract): mid-typing, keep the last good
    // output and hold the diagnostic until ERROR_HOLD_MS of idle, a blur,
    // Ctrl/Cmd+Enter, Run now, a format change or a chip, so a half-written
    // policy never flashes red.
    let errTimer: number | undefined;
    let heldError: string | null = null;

    function showError(message: string): void {
      window.clearTimeout(errTimer);
      heldError = null;
      setEditorDoc(outputView, '');
      renderError(messagesBox!, summaryEl!, message);
    }

    function fail(source: Source, message: string): void {
      hideActions();
      if (source !== 'seed') clearHash();
      if (source !== 'type') {
        showError(message);
        return;
      }
      heldError = message;
      setSummary(summaryEl!, '', 'mute');
      window.clearTimeout(errTimer);
      errTimer = window.setTimeout(() => showError(message), ERROR_HOLD_MS);
    }

    inputView.contentDOM.addEventListener('blur', () => {
      if (heldError !== null) showError(heldError);
    });

    async function convertNow(source: Source): Promise<void> {
      window.clearTimeout(timer);
      window.clearTimeout(errTimer);
      heldError = null;
      // Guaranteed present by the early return above; restated because
      // TypeScript discards that narrowing inside a hoisted function declaration.
      if (!convertBtn) return;
      if (running) {
        queued = source;
        return;
      }
      running = true;
      const userInitiated = source !== 'seed';
      if (source === 'run') {
        convertBtn.classList.add('is-busy');
        convertBtn.setAttribute('aria-busy', 'true');
        // Yield so the busy state paints before the work runs.
        await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
      }

      try {
        const text = inputView.state.doc.toString();
        if (text.trim().length === 0) {
          setEditorDoc(outputView, '');
          hideActions();
          renderEmpty(messagesBox!, summaryEl!);
          if (userInitiated) clearHash();
          return;
        }
        const result = await Promise.resolve(engine.convert(fromSel!.value, toSel!.value, text));

        if (!result || result.error) {
          fail(source, result?.error ?? 'Unknown error while converting.');
          return;
        }

        const output = typeof result.output === 'string' ? result.output : '';
        setEditorDoc(outputView, output);
        const warnings = Array.isArray(result.warnings)
          ? result.warnings.filter((w): w is string => typeof w === 'string' && w.length > 0)
          : [];
        renderWarnings(messagesBox!, summaryEl!, warnings);

        if (output.length === 0) {
          hideActions();
          if (userInitiated) clearHash();
          return;
        }

        // A valid, non-empty result — surface the copy actions.
        copyBtn!.dataset.copy = output;
        copyBtn!.hidden = false;
        shareMdBtn!.dataset.copy = markdownFor(output, warnings);
        shareMdBtn!.hidden = false;
        let shareUrl = window.location.href.split('#')[0];
        try {
          const hash = engine.encodeState(fromSel!.value, toSel!.value, text);
          if (typeof hash === 'string') {
            const frag = hash.startsWith('#') ? hash : `#${hash}`;
            shareUrl = `${shareUrl}${frag}`;
            // Only a user-initiated conversion rewrites the address bar — the
            // seed (example, share link or restored input) never does.
            if (userInitiated) window.history.replaceState(null, '', frag);
          }
        } catch {
          /* non-fatal: sharing just won't reflect the latest state */
        }
        shareBtn!.dataset.copy = shareUrl;
        shareBtn!.hidden = false;
        if (userInitiated) {
          recordToolLastInput(SLUG, JSON.stringify({ src: fromSel!.value, dst: toSel!.value, text }));
        }
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Unexpected error while converting.';
        fail(source, msg);
      } finally {
        running = false;
        convertBtn.classList.remove('is-busy');
        convertBtn.removeAttribute('aria-busy');
        if (queued) {
          const next = queued;
          queued = null;
          void convertNow(next);
        }
      }
    }

    function schedule(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => void convertNow('type'), DEBOUNCE_MS);
    }

    // Typing in the source editor: no example is on screen any more; convert live.
    onInputEdit = () => {
      clearChips(chipsWrap);
      schedule();
    };

    // Choosing an example swaps the input + both formats and converts at once.
    // The doc write fires the update listener (which releases every chip), so
    // the chip is pressed again after it.
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        const ex = examples[idx];
        if (ex.from && formats.some((f) => f.value === ex.from)) fromSel.value = ex.from;
        if (ex.to && formats.some((f) => f.value === ex.to)) toSel.value = ex.to;
        syncNames();
        setEditorDoc(inputView, ex.text);
        syncChipsByIndex(chipsWrap, idx);
        void convertNow('run');
      });
    });

    // A format change is a new conversion of the same text: no example is
    // selected any more, and the output re-converts at once.
    for (const sel of [fromSel, toSel]) {
      sel.addEventListener('change', () => {
        clearChips(chipsWrap);
        syncNames();
        void convertNow('run');
      });
    }

    convertBtn.addEventListener('click', () => void convertNow('run'));

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () =>
        JSON.stringify({
          src: fromSel!.value,
          dst: toSel!.value,
          text: inputView.state.doc.toString(),
        }),
      setValue: (value) => {
        let parsed: Partial<ShareState> | null = null;
        try {
          parsed = JSON.parse(value) as Partial<ShareState>;
        } catch {
          return;
        }
        if (
          !parsed ||
          typeof parsed.text !== 'string' ||
          !formats.some((f) => f.value === parsed!.src) ||
          !formats.some((f) => f.value === parsed!.dst)
        ) {
          return;
        }
        fromSel!.value = parsed.src as string;
        toSel!.value = parsed.dst as string;
        syncNames();
        setEditorDoc(inputView, parsed.text);
        clearChips(chipsWrap);
        void convertNow('run');
      },
    });

    // Convert whatever the editor ended up holding — a #s= share link, a
    // restored last input, or the seeded example — so the panel is never empty
    // on arrival. The seed run never rewrites the hash or records the input.
    void convertNow('seed');
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
