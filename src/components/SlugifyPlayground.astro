---
/**
 * SlugifyPlayground — the interactive Slugify island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>.
 * A textarea takes any title; a separator selector, max-length number and a
 * lowercase toggle shape the output; the slug renders live below with per-row
 * copy, a Copy slug button and a shareable #q=… deep link.
 *
 * Evaluation is debounced (~140ms) while typing; Enter runs immediately. The
 * results container is NOT a live region — a single role="status" summary line
 * plus an sr-only copy-status span carry announcements.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar, ResultPanel (figure cap, live summary, copy status)
 * and CopyButton. The results container stays here, seeded with
 * `set:html` + `data-results`; its slab overrides anchor on `.slug-results`.
 *
 * Runtime contract (engine lazy-imported for code-splitting):
 *   ../lib/slugify/engine → slugify(input, opts): SlugifyResult
 *
 * examples are imported in frontmatter and rendered server-side as kit
 * chips; the engine is imported dynamically inside the boot closure.
 */
import { examples } from '../lib/slugify/examples';
import { slugify } from '../lib/slugify/engine';
import { resultHtml, summaryText, EMPTY_HTML } from '../lib/slugify/render';
import type { SlugifyOptions } from '../lib/slugify/types';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-computes the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees a real worked answer
 * instead of an empty "type something here" panel.
 *
 * SEED_OPTS mirrors the option controls' markup defaults below (sep "-",
 * max 60, lowercase on) — what `currentOptions()` reads on first boot.
 * `slugify` is pure and synchronous, so it runs at build time unchanged.
 */
const SEED_OPTS: SlugifyOptions = { separator: '-', maxLength: 60, lowercase: true };
const seedExample = examples[0];
const seedResult = seedExample ? slugify(seedExample.input, SEED_OPTS) : null;
const seedHtml = seedResult && seedResult.valid ? resultHtml(seedResult, SEED_OPTS) : EMPTY_HTML;
const seedSummary = seedResult && seedResult.valid ? summaryText(seedResult, SEED_OPTS) : '';
const seedHasSlug = !!(seedResult && seedResult.valid && seedResult.slug.length > 0);
const chipItems = examples.map((ex) => ({ label: ex.label, input: ex.input, ariaLabel: `${ex.label} — ${ex.input}` }));
---

<section class="slug-pg" aria-label="Slugify playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Example chips ────────────────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow">Examples</span>
      <ExampleChips prefix="slug" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
    </div>

    {/* ── Text input ───────────────────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <label class="eyebrow mb-2 block" for="slug-input">Text to slugify</label>
      <textarea
        id="slug-input"
        class="slug-textarea code-mono"
        rows="2"
        spellcheck="false"
        autocapitalize="off"
        autocorrect="off"
        autocomplete="off"
        enterkeyhint="done"
        placeholder="Hello, World! — A Café Guide (2026)"
        aria-describedby="slug-input-hint slug-input-live">{seedExample?.input}</textarea>
      <p id="slug-input-hint" class="slug-hint caption text-mute">
        Accented characters are transliterated (<span class="code-mono">café → cafe</span>);
        punctuation is dropped and runs of separators are collapsed.
      </p>
      <RunHint id="slug-input-live" />
      <SnapshotBar prefix="slug" />
    </div>

    {/* ── Options ──────────────────────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <span class="eyebrow mb-2 block">Options</span>
      <div class="slug-controls">
        <div class="slug-controls-group">
          <span class="slug-field-label" id="slug-sep-label">Separator</span>
          <div class="slug-seg" role="group" aria-labelledby="slug-sep-label" id="slug-separator">
            <button type="button" class="slug-seg__btn" data-sep="-" aria-pressed="true">-</button>
            <button type="button" class="slug-seg__btn" data-sep="_" aria-pressed="false">_</button>
            <button type="button" class="slug-seg__btn" data-sep="." aria-pressed="false">.</button>
          </div>
        </div>
        <div class="slug-controls-group">
          <label class="slug-field-label" for="slug-max">Max length</label>
          <input
            id="slug-max"
            class="slug-num-input"
            type="number"
            min="1"
            max="200"
            value="60"
            inputmode="numeric"
            aria-label="Maximum slug length in characters"
          />
        </div>
        <label class="slug-check" for="slug-lower">
          <input id="slug-lower" type="checkbox" class="slug-check__box" checked />
          <span class="slug-check__label">Lowercase</span>
        </label>
      </div>
    </div>

    {/* ── Results panel — the L2 instrument (dark in both themes) under its
        figure cap; the live summary reads out in the cap's actions slot. ── */}
    <ResultPanel slug="slugify" prefix="slug" summary={seedSummary} label="Slug" split>
      <Fragment slot="actions">
        <CopyButton kind="all" id="slug-copy" label="Copy slug" hidden={!seedHasSlug} />
        <CopyButton kind="link" id="slug-share" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the slug is in the
          static HTML; the script re-renders it into this same node. */}
      <div id="slug-results" class="slug-results" set:html={seedHtml} data-results></div>
      <noscript>
        <p class="slug-hint caption text-inverse-mute">
          This tool runs entirely in your browser — enable JavaScript to use it.
        </p>
      </noscript>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* ── Input ──────────────────────────────────────────────────────────── */
  .slug-textarea {
    width: 100%;
    min-height: 72px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 14px;
    line-height: 22px;
    resize: vertical;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .slug-textarea::placeholder {
    color: var(--color-mute);
  }
  .slug-textarea:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .slug-textarea:focus {
    outline: none;
  }
  .slug-textarea:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .slug-hint {
    margin-top: 8px;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .slug-hint .code-mono {
    font-size: 12px;
    color: var(--color-body);
  }

  /* ── Options ────────────────────────────────────────────────────────── */
  .slug-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 18px;
  }
  .slug-controls-group {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .slug-field-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-body);
  }
  /* Segmented separator control: the pressed state IS aria-pressed, as on
     the kit chips; hover is a different look from selected. */
  .slug-seg {
    display: inline-flex;
    padding: 2px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }
  .slug-seg__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: var(--control-h-sm);
    padding: 0 12px;
    border: none;
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 20px;
    color: var(--color-mute);
    background: transparent;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-brand),
      background-color var(--dur-fast) var(--ease-brand);
  }
  .slug-seg__btn:hover:not([aria-pressed='true']) {
    color: var(--color-body);
    background: var(--color-canvas-soft-2);
  }
  .slug-seg__btn[aria-pressed='true'] {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
  }
  .slug-seg__btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  @media (pointer: coarse) {
    .slug-seg__btn {
      min-height: var(--control-h-lg);
    }
  }
  .slug-num-input {
    width: 88px;
    height: var(--control-h-md);
    padding: 0 10px;
    border: none;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .slug-num-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .slug-num-input:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--color-link);
  }
  @media (pointer: coarse) {
    .slug-num-input {
      min-height: var(--control-h-lg);
    }
  }
  .slug-check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    user-select: none;
  }
  .slug-check__box {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    accent-color: var(--color-brand);
    cursor: pointer;
  }
  .slug-check__box:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .slug-check__label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-body);
  }

  /* ── Result container ───────────────────────────────────────────────── */
  .slug-results {
    min-height: 96px;
    display: grid;
    align-content: center;
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.slug-results` container (the panel
     wrapper is ResultPanel's and carries no scope attribute). */
  :global(.slug-card) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: slug-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.slug-slug-row) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    padding: 12px 14px;
    align-items: center;
  }
  /* The slug is the hero answer: mono, the result-panel hero size. */
  :global(.slug-slug-row__v) {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 24px;
    color: var(--color-ink);
    word-break: break-all;
  }
  :global(.slug-note) {
    padding: 9px 14px;
    border-top: 1px solid var(--color-hairline);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-accent-ink);
    text-wrap: pretty;
  }
  /* Per-row copy (render.ts; copy.ts drives it through [data-copy]). */
  :global(.slug-copy-icon-btn) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-brand),
      background-color var(--dur-fast) var(--ease-brand);
    padding: 0;
  }
  :global(.slug-copy-icon-btn:hover) {
    color: var(--color-brand-strong);
    background: var(--color-hairline);
  }
  :global(.slug-copy-icon-btn:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  :global(.slug-copy-icon-btn[data-copied]) {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
  }
  @media (pointer: coarse) {
    :global(.slug-copy-icon-btn) {
      width: var(--control-h-lg);
      height: var(--control-h-lg);
    }
  }

  :global(.slug-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.slug-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.slug-error__detail) {
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.slug-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  @keyframes slug-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.slug-card) {
      animation: none;
    }
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below it uses the slab ink tier; the light rules
     above remain the documented defaults. ──────────────────────────────── */
  .slug-results :global(.slug-empty),
  .slug-results :global(.slug-card) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .slug-results :global(.slug-empty) {
    color: var(--color-inverse-mute);
  }
  .slug-results :global(.slug-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .slug-results :global(.slug-slug-row__v) {
    color: var(--color-inverse-fg);
  }
  .slug-results :global(.slug-note) {
    border-top-color: var(--color-inverse-hairline);
    color: var(--color-inverse-accent);
  }
  .slug-results :global(.slug-copy-icon-btn) {
    color: var(--color-inverse-mute);
  }
  .slug-results :global(.slug-copy-icon-btn:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .slug-results :global(.slug-copy-icon-btn[data-copied]) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
</style>

<script>
  import { resultHtml, errorHtml, summaryText, EMPTY_HTML } from '../lib/slugify/render';
  import type { SlugifyOptions, SlugifyResult } from '../lib/slugify/types';
  import { wireRunKeys } from '../lib/run-keys';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByInput, clearChips, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { wireSnapshotUI } from '../lib/tool-state/wire';

  type Sep = '-' | '_' | '.';
  type Result = SlugifyResult;
  type Options = SlugifyOptions;
  type EngineModule = { slugify: (input: string, opts: Options) => Result };
  type HashState = { q: string; sep: Sep; max: number | null; lc: boolean | null };

  const ROOT_SEL = '.slug-pg';
  const DEBOUNCE_MS = 140;
  const ALLOWED_SEPS: readonly Sep[] = ['-', '_', '.'];

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.slugWired === 'true') return;
      root.dataset.slugWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function asSep(value: string | null | undefined): Sep {
    return (ALLOWED_SEPS as readonly string[]).includes(value ?? '') ? (value as Sep) : '-';
  }

  /** Parse a `q=…&sep=…&max=…&lc=…` state string (the deep-link hash and the snapshot value). */
  function parseState(raw: string): HashState | null {
    const s = raw.replace(/^#/, '');
    if (!s) return null;
    const params = new URLSearchParams(s);
    const q = params.get('q');
    if (q === null) return null;
    const maxRaw = params.get('max');
    const maxNum = maxRaw === null ? null : Number.parseInt(maxRaw, 10);
    const lcRaw = params.get('lc');
    return {
      q,
      sep: asSep(params.get('sep')),
      max: maxNum !== null && Number.isFinite(maxNum) ? maxNum : null,
      lc: lcRaw === null ? null : lcRaw === '1',
    };
  }

  async function init(root: HTMLElement): Promise<void> {
    const input = el<HTMLTextAreaElement>(root, '#slug-input');
    const chipsWrap = el<HTMLElement>(root, '#slug-chips');
    const sepGroup = el<HTMLElement>(root, '#slug-separator');
    const maxInput = el<HTMLInputElement>(root, '#slug-max');
    const lowerToggle = el<HTMLInputElement>(root, '#slug-lower');
    const resultsBox = el<HTMLElement>(root, '#slug-results');
    const summaryEl = el<HTMLElement>(root, '#slug-summary');
    const copyBtn = el<HTMLButtonElement>(root, '#slug-copy');
    const shareBtn = el<HTMLButtonElement>(root, '#slug-share');
    const copyStatus = el<HTMLElement>(root, '#slug-copy-status');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#slug-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#slug-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#slug-snap-delete');
    if (
      !input ||
      !chipsWrap ||
      !sepGroup ||
      !maxInput ||
      !lowerToggle ||
      !resultsBox ||
      !summaryEl ||
      !copyBtn ||
      !shareBtn ||
      !copyStatus ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    /* --- Copy plumbing (row button, Copy slug, Copy link) — the kit helper:
       one delegated listener; outcomes announced in #slug-copy-status. --- */
    wireCopyButtons(root, { status: copyStatus });

    let engine: EngineModule;
    try {
      engine = (await import('../lib/slugify/engine')) as unknown as EngineModule;
    } catch (err) {
      renderError(
        resultsBox,
        summaryEl,
        'The slugify engine failed to load. Reload the page to try again.',
        true
      );
      console.error('[Slugify] engine import failed:', err);
      return;
    }

    const sepBtns = Array.from(sepGroup.querySelectorAll<HTMLButtonElement>('button[data-sep]'));
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));

    /* --- Options helpers ------------------------------------------------ */

    function currentSeparator(): Sep {
      const active = sepBtns.find((b) => b.getAttribute('aria-pressed') === 'true');
      return asSep(active?.dataset.sep);
    }

    function currentMaxLength(): number {
      const n = Number.parseInt(maxInput!.value, 10);
      return Number.isFinite(n) && n > 0 ? n : 0;
    }

    function currentOptions(): Options {
      return {
        separator: currentSeparator(),
        maxLength: currentMaxLength(),
        lowercase: lowerToggle!.checked,
      };
    }

    function setSeparator(sep: Sep): void {
      sepBtns.forEach((b) => {
        b.setAttribute('aria-pressed', b.dataset.sep === sep ? 'true' : 'false');
      });
    }

    /* --- Rendering ------------------------------------------------------ */

    function setSummary(text: string, isError: boolean): void {
      summaryEl!.textContent = text;
      summaryEl!.classList.toggle('text-inverse-error', isError);
      summaryEl!.classList.toggle('text-inverse-mute', !isError);
    }

    function renderEmpty(): void {
      setSummary('', false);
      resultsBox!.innerHTML = EMPTY_HTML;
    }

    function hideActions(): void {
      copyBtn!.hidden = true;
      copyBtn!.dataset.copy = '';
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
    }

    function renderResultCard(result: Result, opts: Options): void {
      setSummary(summaryText(result, opts), false);
      resultsBox!.innerHTML = resultHtml(result, opts);
      // Valid input but nothing slug-worthy survived (e.g. only symbols).
      if (result.slug.length === 0) hideActions();
    }

    function renderError(
      container: HTMLElement,
      summary: HTMLElement,
      message: string,
      isAlert = false
    ): void {
      summary.textContent = 'Invalid input';
      summary.classList.add('text-inverse-error');
      summary.classList.remove('text-inverse-mute');
      container.innerHTML = errorHtml(message, isAlert);
    }

    /* --- Deep-link hash ------------------------------------------------- */

    function localePath(p: string): string {
      const m = window.location.pathname.match(/^\/(de|es|fr|pt-br)\//);
      return m ? `/${m[1]}${p}` : p;
    }

    function buildHash(rawInput: string, opts: Options): string {
      const parts = [
        `q=${encodeURIComponent(rawInput)}`,
        `sep=${encodeURIComponent(opts.separator)}`,
        `max=${opts.maxLength}`,
        `lc=${opts.lowercase ? 1 : 0}`,
      ];
      return `#${parts.join('&')}`;
    }

    let lastWrittenHash: string | null = null;

    function writeHash(rawInput: string | null, opts: Options): void {
      const target = rawInput ? buildHash(rawInput, opts) : '';
      if (target === lastWrittenHash) return;
      // Safari throttles replaceState (~100/30s) and throws — never let that break input.
      try {
        if (rawInput) {
          history.replaceState(null, '', target);
        } else {
          history.replaceState(null, '', location.pathname + location.search);
        }
        lastWrittenHash = target;
      } catch {
        /* ignore */
      }
    }

    /** Load a parsed state into the controls (deep link or snapshot). */
    function applyState(state: HashState): void {
      input!.value = state.q;
      setSeparator(state.sep);
      if (state.max !== null) maxInput!.value = state.max > 0 ? String(state.max) : '';
      if (state.lc !== null) lowerToggle!.checked = state.lc;
      syncChipsByInput(chipsWrap, state.q);
    }

    /* --- Evaluation ----------------------------------------------------- */

    function evaluate(userInitiated: boolean): void {
      const raw = input!.value;
      const opts = currentOptions();
      if (raw.trim().length === 0) {
        hideActions();
        renderEmpty();
        if (userInitiated) writeHash(null, opts);
        return;
      }
      let result: Result | null = null;
      try {
        result = engine.slugify(raw, opts);
      } catch {
        renderError(resultsBox!, summaryEl!, 'Unexpected error while slugifying.');
        hideActions();
        return;
      }
      if (!result || result.valid === false) {
        renderError(resultsBox!, summaryEl!, result?.error ?? 'Could not slugify that title.');
        hideActions();
        if (userInitiated) writeHash(null, opts);
        return;
      }
      renderResultCard(result, opts);
      if (result.slug.length > 0) {
        copyBtn!.hidden = false;
        copyBtn!.dataset.copy = result.slug;
        shareBtn!.hidden = false;
        shareBtn!.dataset.copy =
          location.origin + localePath('/slugify/') + buildHash(raw, opts);
      } else {
        hideActions();
      }
      if (userInitiated) writeHash(raw, opts);
    }

    /* --- Events --------------------------------------------------------- */

    let timer: number | undefined;

    function scheduleEval(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => evaluate(true), DEBOUNCE_MS);
    }

    function runNow(): void {
      window.clearTimeout(timer);
      evaluate(true);
    }

    input.addEventListener('input', () => {
      clearChips(chipsWrap);
      scheduleEval();
    });
    // A slug is one line: plain Enter runs (no newline), Shift+Enter is the
    // newline, ⌘/Ctrl+Enter runs and releases a touch keyboard.
    wireRunKeys(input, runNow, { enter: 'run' });

    sepBtns.forEach((b) => {
      b.addEventListener('click', () => {
        setSeparator(asSep(b.dataset.sep));
        runNow();
      });
    });
    maxInput.addEventListener('input', scheduleEval);
    maxInput.addEventListener('change', runNow);
    lowerToggle.addEventListener('change', runNow);

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        input.value = chip.dataset.input ?? '';
        syncChipsByInput(chipsWrap, input.value);
        runNow();
      });
    });

    // Snapshots store the same serializer the deep link uses (text + options).
    wireSnapshotUI({
      slug: 'slugify',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => (input!.value.trim() ? buildHash(input!.value, currentOptions()).slice(1) : ''),
      setValue: (value) => {
        const state = parseState(value);
        if (!state) return;
        applyState(state);
        runNow();
      },
    });

    /* --- First load: hash deep link > seeded example ------------------- */

    const hash = parseState(window.location.hash);
    if (hash) {
      applyState(hash);
      evaluate(false);
    } else if (chips[0]?.dataset.input) {
      input.value = chips[0].dataset.input;
      syncChipsByInput(chipsWrap, input.value);
      evaluate(false);
    } else {
      renderEmpty();
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
