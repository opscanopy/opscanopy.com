---
/**
 * SubnetSplitterPlayground — the interactive Subnet Splitter island.
 *
 * Given a parent CIDR, an optional "split into /N" prefix, and a list of
 * already-allocated CIDRs (one per line), it reports the minimal FREE blocks
 * left inside the parent, an equal-size split of the parent flagged
 * free/used/partial, and a parsed breakdown of each allocation. Updates live
 * (debounced), fully client-side.
 *
 * Runtime contract (lazy-imported):
 *   ../lib/subnet-splitter/engine   → split(parent, allocated, newPrefix) → SplitResult
 *   ../lib/subnet-splitter/examples → examples: { id; label; parent; allocated; newPrefix }[]
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. The script only
// wires click handlers onto these already-rendered buttons — it never rebuilds
// them — so this adds nothing to the client bundle and cannot drift.
import { examples as prerenderedExamples } from '../lib/subnet-splitter/examples';
import { split } from '../lib/subnet-splitter/engine';
import { resultHtml, summaryText, EMPTY_HTML } from '../lib/subnet-splitter/render';

/**
 * Server-rendered seed. The client re-computes the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees a real worked answer
 * instead of an empty "type something here" panel.
 *
 * `split` is pure and synchronous, so it runs at build time unchanged.
 */
const seedExample = prerenderedExamples[0];
const seedResult = seedExample
  ? split(seedExample.parent, seedExample.allocated, seedExample.newPrefix)
  : null;
const seedHtml = seedResult && seedResult.valid ? resultHtml(seedResult) : EMPTY_HTML;
const seedSummary = seedResult && seedResult.valid ? summaryText(seedResult) : '';
const seedPrefix =
  seedExample && seedExample.newPrefix !== null ? String(seedExample.newPrefix) : undefined;
---

<section class="spl-pg" aria-label="Subnet Splitter playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      {/* The chip group carries its own accessible name; there is no <label
          for=…> because a group of buttons is not a labelable control. */}
      <span class="eyebrow shrink-0">Example</span>
      <div id="spl-chips" class="spl-chips" role="group" aria-label="Examples">
        {prerenderedExamples.map((ex, i) => (
          <button
            type="button"
            class:list={['spl-chip', { 'is-active': i === 0 }]}
            data-example-idx={i}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {ex.label}
          </button>
        ))}
      </div>
    </div>

    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <div class="spl-fields">
        <div class="spl-field spl-field--parent">
          <label class="eyebrow mb-2 block" for="spl-parent">Parent CIDR</label>
          <input
            id="spl-parent"
            class="spl-text code-mono"
            type="text"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            autocomplete="off"
            placeholder="10.0.0.0/24"
            value={seedExample?.parent}
            aria-describedby="spl-input-hint"
          />
        </div>
        <div class="spl-field spl-field--prefix">
          <label class="eyebrow mb-2 block" for="spl-prefix">Split into /</label>
          <input
            id="spl-prefix"
            class="spl-num code-mono"
            type="number"
            inputmode="numeric"
            min="1"
            max="128"
            step="1"
            autocomplete="off"
            placeholder="optional"
            value={seedPrefix}
          />
        </div>
      </div>

      <label class="eyebrow mt-4 mb-2 block" for="spl-allocated"
        >Already allocated — one CIDR per line</label
      >
      <textarea
        id="spl-allocated"
        class="spl-input code-mono"
        spellcheck="false"
        autocapitalize="off"
        autocorrect="off"
        autocomplete="off"
        rows="5"
        placeholder="10.0.0.0/26&#10;10.0.0.128/26"
        aria-describedby="spl-input-hint">{seedExample?.allocated}</textarea>
      <p id="spl-input-hint" class="spl-hint caption text-mute">
        Enter a parent block, then list the CIDRs already in use. Blank lines and
        <span class="code-mono">#</span> comments are ignored. Add a "split into /N" to see every
        equal-size subnet.
      </p>
      <div class="spl-snap-row mt-3 flex flex-wrap items-center gap-2">
        <button id="spl-snap-save" type="button" class="spl-snap-btn">Save snapshot</button>
        <select id="spl-snap-select" class="spl-snap-select" aria-label="Load a saved snapshot" disabled>
          <option value="">No snapshots yet</option>
        </select>
        <button id="spl-snap-delete" type="button" class="spl-snap-delete" aria-label="Delete this snapshot" hidden>&times;</button>
      </div>
    </div>

    <div class="bg-canvas-soft px-4 py-4 sm:px-5">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
        <span class="flex items-center gap-2">
          <span class="eyebrow">Result</span>
          <button
            id="spl-share"
            type="button"
            class="spl-copy--labeled"
            data-copy=""
            data-copy-label="Copy link"
            hidden
          >
            <svg
              class="spl-copy-icon"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6.75 9.25l2.5-2.5"></path>
              <path d="M8.75 4.25l1.5-1.5a2.47 2.47 0 0 1 3.5 3.5l-1.5 1.5"></path>
              <path d="M7.25 11.75l-1.5 1.5a2.47 2.47 0 0 1-3.5-3.5l1.5-1.5"></path>
            </svg>
            <svg
              class="spl-check-icon hidden"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 8.5l3.5 3.5L13 4.5"></path>
            </svg>
            <span class="spl-copy-label">Copy link</span>
          </button>
        </span>
        <span id="spl-summary" class="spl-summary code-mono text-mute" role="status" aria-live="polite">{seedSummary}</span>
      </div>
      {/* Seeded at build time (see `seedHtml` above) so the answer is in the
          static HTML; the client replaces it with the same markup on boot. */}
      <div id="spl-results" class="spl-results" set:html={seedHtml}></div>
    </div>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* ── Example chips (server-rendered buttons) ─────────────────────────── */
  .spl-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .spl-chip {
    display: inline-flex;
    align-items: center;
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline-muted);
    background: var(--color-canvas);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.01em;
    color: var(--color-brand-strong);
    cursor: pointer;
    touch-action: manipulation;
    text-align: left;
    transition: background 0.12s ease, border-color 0.12s ease, color 0.12s ease;
  }
  .spl-chip:hover {
    border-color: var(--color-hairline-strong);
    background: var(--color-canvas-hover);
  }
  .spl-chip.is-active,
  .spl-chip[aria-pressed='true'] {
    background: var(--color-brand-soft);
    border-color: var(--color-brand-strong);
    color: var(--color-brand-strong);
  }
  .spl-chip:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  @media (pointer: coarse) {
    .spl-chip {
      min-height: 44px;
    }
  }

  .spl-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .spl-field--parent {
    flex: 1 1 220px;
    min-width: 0;
  }
  .spl-field--prefix {
    flex: 0 0 auto;
    width: 120px;
  }

  .spl-text,
  .spl-num {
    width: 100%;
    height: 40px;
    padding: 0 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 14px;
    line-height: 22px;
    transition: box-shadow 0.15s ease;
  }
  .spl-text::placeholder,
  .spl-num::placeholder {
    color: var(--color-mute);
  }
  .spl-text:hover,
  .spl-num:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .spl-text:focus,
  .spl-num:focus {
    outline: none;
  }
  .spl-text:focus-visible,
  .spl-num:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }

  .spl-input {
    width: 100%;
    min-height: 116px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 14px;
    line-height: 22px;
    resize: vertical;
    transition: box-shadow 0.15s ease;
  }
  .spl-input::placeholder {
    color: var(--color-mute);
  }
  .spl-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .spl-input:focus {
    outline: none;
  }
  .spl-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .spl-hint {
    margin-top: 8px;
    text-wrap: pretty;
  }
  .spl-snap-btn {
    flex: 0 0 auto;
    height: 30px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    border: none;
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-size: 13px;
    cursor: pointer;
    transition: background 0.12s ease, box-shadow 0.12s ease;
  }
  .spl-snap-btn:hover {
    background: var(--color-canvas-soft);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .spl-snap-select {
    height: 30px;
    max-width: 220px;
    padding: 0 8px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-size: 13px;
  }
  .spl-snap-select:disabled {
    color: var(--color-mute);
    cursor: not-allowed;
  }
  .spl-snap-delete {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .spl-snap-delete:hover {
    background: var(--color-error-soft);
    color: var(--color-error-deep);
  }
  .spl-summary {
    white-space: nowrap;
  }

  /* Copy-link button — same shape as the cidr-checker's, which is the
     playground reference implementation for share affordances. */
  .spl-copy--labeled {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 26px;
    padding: 0 10px;
    border: none;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.12s ease, background 0.12s ease;
  }
  .spl-copy--labeled:hover {
    color: var(--color-brand-strong);
    background: var(--color-hairline);
  }
  .spl-copy--labeled:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  .spl-copy--copied {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
  }
  @media (pointer: coarse) {
    .spl-copy--labeled {
      min-height: 44px;
    }
  }

  .spl-results {
    min-height: 44px;
  }

  /* ── Runtime-injected markup ─────────────────────────────────────────── */
  :global(.spl-block) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: spl-rise 0.18s ease both;
  }
  :global(.spl-block + .spl-block) {
    margin-top: 12px;
  }
  :global(.spl-block__head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  :global(.spl-block__note) {
    padding: 8px 14px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-mute);
  }
  :global(.spl-line) {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 8px 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-word;
  }
  :global(.spl-line + .spl-line) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.spl-dot) {
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    margin-top: 7px;
    border-radius: 9999px;
    background: var(--color-brand);
  }
  :global(.spl-dot--ok) {
    background: var(--color-success);
  }
  :global(.spl-dot--bad) {
    background: var(--color-error);
  }
  :global(.spl-dot--free) {
    background: var(--color-success);
  }
  :global(.spl-dot--used) {
    background: var(--color-error);
  }
  :global(.spl-dot--partial) {
    background: var(--color-warning);
  }
  :global(.spl-line__meta) {
    margin-left: auto;
    font-size: 11px;
    color: var(--color-mute);
    text-transform: none;
    letter-spacing: 0;
    white-space: nowrap;
  }
  :global(.spl-line--bad) {
    color: var(--color-error-deep);
  }
  :global(.spl-none) {
    padding: 10px 14px;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-mute);
  }

  @keyframes spl-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.spl-block) {
      animation: none;
    }
  }

  :global(.spl-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.spl-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.spl-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.spl-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.spl-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }
</style>

<script>
  import { EMPTY_HTML, errorHtml, resultHtml, summaryText } from '../lib/subnet-splitter/render';
  import { wireRunKeys } from '../lib/run-keys';
  import { buildIpHash, readIpHash } from '../lib/ip-hash';
  import { copyTextToClipboard } from '../lib/clipboard';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';

  // Type-only import: erased at build, so the engine is still lazily imported inside
  // boot() and does not join this page's initial chunk. These were previously
  // hand-mirrored here and drifted — the local SplitSection had lost `total`, which
  // the render code reads, so the checker contradicted working runtime code.
  import type { SplitResult as Result, SplitExample as Example } from '../lib/subnet-splitter/types';
  type EngineModule = { split: (parent: string, allocated: string, newPrefix: number | null) => Result };

  const ROOT_SEL = '.spl-pg';
  const DEBOUNCE_MS = 220;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.splWired === 'true') return;
      root.dataset.splWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        const np = o.newPrefix;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          parent: typeof o.parent === 'string' ? o.parent : '',
          allocated: typeof o.allocated === 'string' ? o.allocated : '',
          newPrefix: typeof np === 'number' && Number.isInteger(np) ? np : null,
        } satisfies Example;
      })
      .filter((e) => e.parent.length > 0);
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    summary.textContent = '';
    container.innerHTML = EMPTY_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    summary.textContent = '';
    container.innerHTML = errorHtml(message);
  }

  function renderResult(container: HTMLElement, summary: HTMLElement, result: Result): void {
    summary.textContent = summaryText(result);
    container.innerHTML = resultHtml(result);
  }

  async function init(root: HTMLElement): Promise<void> {
    const parentInput = el<HTMLInputElement>(root, '#spl-parent');
    const prefixInput = el<HTMLInputElement>(root, '#spl-prefix');
    const allocatedInput = el<HTMLTextAreaElement>(root, '#spl-allocated');
    const chipsWrap = el<HTMLElement>(root, '#spl-chips');
    const resultsBox = el<HTMLElement>(root, '#spl-results');
    const summaryEl = el<HTMLElement>(root, '#spl-summary');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#spl-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#spl-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#spl-snap-delete');
    if (
      !parentInput ||
      !prefixInput ||
      !allocatedInput ||
      !chipsWrap ||
      !resultsBox ||
      !summaryEl ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    let engine: EngineModule;
    let examples: Example[] = [];
    try {
      const [engineMod, examplesMod] = await Promise.all([
        import('../lib/subnet-splitter/engine'),
        import('../lib/subnet-splitter/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
    } catch (err) {
      renderError(resultsBox, summaryEl, 'The splitter engine failed to load. Reload the page to try again.');
      console.error('[SubnetSplitter] engine import failed:', err);
      return;
    }

    // The chips are already in the static HTML (server-rendered from the same
    // `examples` module); the script only wires them. `chips` is captured as a
    // plain array so the helpers below never lose the null-narrowing on
    // `chipsWrap` inside a hoisted function declaration.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>('.spl-chip'));

    /** Mark one chip active, or none at all (custom / shared / restored input). */
    function setActiveChip(idx: number | null): void {
      chips.forEach((chip) => {
        const active = idx !== null && chip.dataset.exampleIdx === String(idx);
        chip.classList.toggle('is-active', active);
        chip.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    function clearFieldErrors(): void {
      parentInput!.classList.remove('ring-2', 'ring-red-500');
      prefixInput!.classList.remove('ring-2', 'ring-red-500');
      allocatedInput!.classList.remove('ring-2', 'ring-red-500');
    }

    function markFieldError(field: HTMLElement): void {
      clearFieldErrors();
      field.classList.add('ring-2', 'ring-red-500');
    }

    /* ---- Share link / #ip= deep link ---------------------------------- */
    /* The splitter already READ #ip= (the subnet calculator's "Split this
       subnet" chip writes one) but never wrote one back, so a split you typed
       here could not be linked to. Only the PARENT block goes in the hash —
       the same scope the boot sequence restores. Only user-initiated
       evaluations write: a boot seed must not rewrite the URL. */
    const shareBtn = root.querySelector<HTMLButtonElement>('#spl-share');
    let lastWrittenHash: string | null = null;

    function writeHash(value: string | null): void {
      const target = value ? buildIpHash(value) : '';
      if (target === lastWrittenHash) return;
      // Safari throttles replaceState (~100/30s) and throws — never let that
      // break typing.
      try {
        if (value) {
          history.replaceState(null, '', target);
        } else {
          history.replaceState(null, '', location.pathname + location.search);
        }
        lastWrittenHash = target;
      } catch {
        /* ignore */
      }
    }

    function hideShare(): void {
      if (!shareBtn) return;
      shareBtn.hidden = true;
      shareBtn.dataset.copy = '';
    }

    function showShare(value: string): void {
      if (!shareBtn) return;
      shareBtn.hidden = false;
      shareBtn.dataset.copy =
        location.origin + location.pathname + location.search + buildIpHash(value);
    }

    if (shareBtn) {
      const shareLabel = shareBtn.querySelector<HTMLElement>('.spl-copy-label');
      const copyIcon = shareBtn.querySelector<HTMLElement>('.spl-copy-icon');
      const checkIcon = shareBtn.querySelector<HTMLElement>('.spl-check-icon');
      shareBtn.addEventListener('click', () => {
        const url = shareBtn.dataset.copy ?? '';
        if (!url) return;
        void copyTextToClipboard(url).then((ok) => {
          if (!ok) return;
          shareBtn.classList.add('spl-copy--copied');
          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          if (shareLabel) shareLabel.textContent = 'Copied';
          window.setTimeout(() => {
            shareBtn.classList.remove('spl-copy--copied');
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
            if (shareLabel) shareLabel.textContent = 'Copy link';
          }, 1500);
        });
      });
    }

    function evaluate(userInitiated = false): void {
      clearFieldErrors();
      const parent = parentInput!.value;
      if (parent.trim().length === 0) {
        renderEmpty(resultsBox!, summaryEl!);
        hideShare();
        if (userInitiated) writeHash(null);
        return;
      }
      const prefixRaw = prefixInput!.value.trim();
      const newPrefix = prefixRaw === '' ? null : Number(prefixRaw);

      // CHANGE 1 — Validate new prefix against parent prefix before calling engine
      if (newPrefix !== null) {
        const parentMatch = parent.trim().match(/\/(\d+)$/);
        if (parentMatch) {
          const parentPrefix = Number(parentMatch[1]);
          if (newPrefix <= parentPrefix) {
            const suggested = parentPrefix + 1;
            markFieldError(prefixInput!);
            renderError(
              resultsBox!,
              summaryEl!,
              `The new prefix (/${newPrefix}) must be larger than the parent prefix (/${parentPrefix}). For a /${parentPrefix} parent, try /${suggested} or smaller.`,
            );
            hideShare();
            if (userInitiated) writeHash(null);
            return;
          }
        }
      }

      let result: Result | null = null;
      try {
        result = engine.split(parent, allocatedInput!.value, newPrefix);
      } catch {
        renderError(resultsBox!, summaryEl!, 'Unexpected error while splitting the parent block.');
        hideShare();
        if (userInitiated) writeHash(null);
        return;
      }
      if (!result || result.valid === false) {
        // CHANGE 3 — highlight the field most likely responsible for the error
        if (result?.error && /prefix|split/i.test(result.error)) {
          markFieldError(prefixInput!);
        } else {
          markFieldError(parentInput!);
        }
        renderError(resultsBox!, summaryEl!, result?.error ?? 'Enter a valid parent CIDR.');
        hideShare();
        if (userInitiated) writeHash(null);
        return;
      }
      renderResult(resultsBox!, summaryEl!, result);
      showShare(parent.trim());
      if (userInitiated) writeHash(parent.trim());
      recordToolLastInput('subnet-splitter', parent.trim());
    }

    let timer: number | undefined;
    function scheduleEvaluate(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => evaluate(true), DEBOUNCE_MS);
    }

    function onUserInput(): void {
      setActiveChip(null);
      scheduleEvaluate();
    }

    parentInput.addEventListener('input', onUserInput);
    prefixInput.addEventListener('input', onUserInput);
    allocatedInput.addEventListener('input', onUserInput);

    const runNow = (): void => {
      window.clearTimeout(timer);
      evaluate(true);
    };
    wireRunKeys(parentInput, runNow);
    wireRunKeys(prefixInput, runNow);
    // The allocated-blocks field is one CIDR per line, so Enter must insert.
    wireRunKeys(allocatedInput, runNow, { enter: 'insert-then-run' });
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        const ex = examples[idx];
        parentInput.value = ex.parent;
        prefixInput.value = ex.newPrefix === null ? '' : String(ex.newPrefix);
        allocatedInput.value = ex.allocated;
        setActiveChip(idx);
        window.clearTimeout(timer);
        evaluate(true);
      });
    });

    wireSnapshotUI({
      slug: 'subnet-splitter',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => parentInput!.value.trim(),
      setValue: (value) => {
        parentInput!.value = value;
        prefixInput!.value = '';
        allocatedInput!.value = '';
        setActiveChip(null);
        window.clearTimeout(timer);
        evaluate(true);
      },
    });

    // Seed priority: #ip=<cidr> deep link (written by the Subnet Calculator's
    // "Split this subnet" chip) > restored last input > seeded example. Only
    // the parent block is restored/recorded, matching the existing #ip= deep
    // link's scope — prefix and allocated lines are cleared just like the
    // deep-link path already does.
    const shared = readIpHash();
    const restored = getRestoredLastInput('subnet-splitter');
    const seed = examples[0];
    if (shared) {
      parentInput.value = shared;
      prefixInput.value = '';
      allocatedInput.value = '';
      // Shared/restored state is not one of the bundled examples — no chip is active.
      setActiveChip(null);
      evaluate();
    } else if (restored) {
      parentInput.value = restored;
      prefixInput.value = '';
      allocatedInput.value = '';
      setActiveChip(null);
      evaluate();
    } else if (seed) {
      parentInput.value = seed.parent;
      prefixInput.value = seed.newPrefix === null ? '' : String(seed.newPrefix);
      allocatedInput.value = seed.allocated;
      setActiveChip(0);
      evaluate();
    } else {
      setActiveChip(null);
      renderEmpty(resultsBox, summaryEl);
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
