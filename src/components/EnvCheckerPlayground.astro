---
/**
 * EnvCheckerPlayground — the interactive Env Example Checker island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>
 * that lazily boots two CodeMirror 6 editors ("Your code" + ".env.example"),
 * wires the example chips, live re-checking (with its toggle) and a "Run now"
 * control, then renders a drift report.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * two EditorPanes (each a FigureCap over its CodeMirror host, seeded with a
 * `<pre data-cm-fallback>`), RunHint and SnapshotBar on paper, and
 * ResultPanel (figure cap, live summary, copy status). The report container
 * stays here, seeded with `set:html` + `data-results`; its slab overrides
 * anchor on `.ec-report`. There is deliberately no share link and no
 * last-input restore: the inputs may be secrets.
 *
 * Runtime contract (imported lazily in the script):
 *   ../lib/env-checker/types →
 *     type EnvResult = {
 *       error?: string
 *       usedVars: string[]
 *       exampleVars: string[]
 *       missingInExample: string[]   // used in code, absent from .env.example
 *       unusedInExample: string[]    // present in .env.example, never read
 *     }
 *   ../lib/env-checker/engine →
 *     check(code: string, envExample: string) => EnvResult
 *   ../lib/env-checker/examples →
 *     examples: { id: string; label: string; code: string; envExample: string }[]
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. The chips are
// final markup — hydration only attaches click handlers and moves the pressed
// state — so this adds nothing to the client bundle and cannot drift.
import { examples as prerenderedExamples } from '../lib/env-checker/examples';
import { check } from '../lib/env-checker/engine';
import { reportHtml, reportSummary, EMPTY_HTML } from '../lib/env-checker/render';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';

/**
 * Server-rendered seed. The client re-checks the same example on boot, so this
 * is pure progressive enhancement — but it means a visitor with no JS, and
 * every AI crawler (they do not execute JS), sees the real "missing / unused"
 * verdict instead of an empty "load an example" panel.
 *
 * `check` is pure and synchronous, reads no clock and returns sorted arrays,
 * so it runs at build time unchanged. The two editor bodies go into
 * `<pre data-cm-fallback>` elements inside the CodeMirror hosts — CM appends
 * its editor to the host, so the script removes every fallback once mounted.
 */
const seedExample = prerenderedExamples[0];
const seedResult = seedExample ? check(seedExample.code, seedExample.envExample) : null;
const seedOk = seedResult && !seedResult.error ? seedResult : null;
const seedHtml = seedOk ? reportHtml(seedOk) : EMPTY_HTML;
const seedSummaryInfo = seedOk ? reportSummary(seedOk) : null;
const seedSummary = seedSummaryInfo ? seedSummaryInfo.text : '';
const seedSummaryTone =
  seedSummaryInfo?.tone === 'success' ? 'text-inverse-brand' : seedSummaryInfo?.tone === 'error' ? 'text-inverse-error' : '';
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="ec-pg" aria-label="Env Example Checker playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: example chips + live toggle, Clear, Run now (paper) ─── */}
    <div
      class="flex flex-col gap-3 border-b border-hairline px-4 py-3 sm:flex-row sm:items-end sm:justify-between sm:px-5"
    >
      <div class="flex min-w-0 flex-col gap-2">
        <span class="eyebrow shrink-0">Example</span>
        <ExampleChips prefix="ec" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
      </div>

      <div class="flex shrink-0 flex-wrap items-center gap-2">
        <label class="ec-live inline-flex cursor-pointer select-none items-center gap-2">
          <input id="ec-live" type="checkbox" class="ec-live-input" checked />
          <span class="ec-live-track" aria-hidden="true"><span class="ec-live-thumb"></span></span>
          <span class="caption text-body">Live check</span>
        </label>
        <button id="ec-clear" type="button" class="btn-tool ec-tap" title="Clear both editors">
          <span>Clear</span>
        </button>
        <button
          id="ec-check"
          type="button"
          class="btn-tool ec-tap"
          title="Run now (⌘/Ctrl + Enter)"
          aria-keyshortcuts="Meta+Enter Control+Enter"
        >
          <svg
            class="ec-check-icon h-4 w-4 shrink-0"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 8.5l3.5 3.5L13 4.5"></path>
          </svg>
          <span class="ec-check-label">Run now</span>
        </button>
      </div>
    </div>

    {/* ── Mobile tab switch (single-pane on small screens) ─────────────── */}
    <div class="ec-tabs flex gap-1 border-b border-hairline px-4 py-2 sm:hidden" role="tablist" aria-label="Editor panes">
      <button
        id="ec-tab-code"
        type="button"
        class="ec-tab ec-tap"
        role="tab"
        aria-selected="true"
        aria-controls="ec-pane-code"
        data-pane="code"
        tabindex="0"
      >
        Your Code
      </button>
      <button
        id="ec-tab-env"
        type="button"
        class="ec-tab ec-tap"
        role="tab"
        aria-selected="false"
        aria-controls="ec-pane-env"
        data-pane="env"
        tabindex="-1"
      >
        .env.example
      </button>
    </div>

    {/* ── Editor split on the plate (side by side on desktop, tabbed on
        mobile) ── */}
    <div class="ec-grid grid grid-cols-1 sm:grid-cols-2">
      <div id="ec-pane-code" class="ec-pane ec-pane--active" role="tabpanel" aria-labelledby="ec-tab-code">
        <EditorPane prefix="ec" id="ec-editor-code" label="your-code">
          <pre class="editor-pane__fallback code-mono ec-fallback" data-cm-fallback>{seedExample?.code}</pre>
        </EditorPane>
      </div>
      <div id="ec-pane-env" class="ec-pane" role="tabpanel" aria-labelledby="ec-tab-env">
        <EditorPane prefix="ec" id="ec-editor-env" label=".env.example">
          <pre class="editor-pane__fallback code-mono ec-fallback" data-cm-fallback>{seedExample?.envExample}</pre>
        </EditorPane>
      </div>
    </div>

    {/* ── Run hint, the no-share note + snapshots, on paper ─────────────── */}
    <div class="border-b border-hairline px-4 py-3 sm:px-5">
      <RunHint variant="cm" />
      <p class="caption text-mute mt-1">No share links on this tool — inputs may be secrets.</p>
      <SnapshotBar prefix="ec" />
    </div>

    {/* ── Drift report — the L2 instrument under its figure cap ────────── */}
    <ResultPanel
      slug="env-example-checker"
      prefix="ec"
      label="Drift Report"
      summary={seedSummary}
      summaryClass={`whitespace-nowrap ${seedSummaryTone}`.trim()}
      split
    >
      {/* Seeded at build time (see `seedHtml` above) so the drift report is in
          the static HTML; the client replaces it with the same markup on boot. */}
      <div id="ec-report" class="ec-report" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* Tap targets opt into fast-tap + no double-tap-zoom on touch. */
  .ec-tap {
    touch-action: manipulation;
  }

  /* The seeded documents a crawler reads (global .editor-pane__fallback sets
     the metrics), boxed to the editors' own min/max height (the script's
     size theme) so the swap on hydration does not move the page. */
  .ec-fallback {
    min-height: 288px;
    max-height: 420px;
    overflow: auto;
  }

  /* The divider between the two plates on desktop. */
  @media (min-width: 640px) {
    .ec-pane + .ec-pane {
      border-left: 1px solid var(--color-inverse-hairline);
    }
  }

  /* Live-check toggle — a compact squared switch from the contract tokens. */
  .ec-live {
    touch-action: manipulation;
  }
  .ec-live-input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .ec-live-track {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: 32px;
    height: 18px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-soft-2);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      box-shadow var(--dur-fast) var(--ease-brand);
  }
  .ec-live-thumb {
    position: absolute;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: var(--radius-xs);
    background: var(--color-canvas);
    box-shadow: var(--shadow-subtle);
    transition: transform var(--dur-fast) var(--ease-brand);
  }
  .ec-live-input:checked + .ec-live-track {
    background: var(--color-brand-strong);
    box-shadow: none;
  }
  .ec-live-input:checked + .ec-live-track .ec-live-thumb {
    transform: translateX(14px);
  }
  .ec-live-input:focus-visible + .ec-live-track {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  /* Mobile tabs (square in-app scale). The selected state IS aria-selected. */
  .ec-tab {
    @apply label-field;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 0;
    min-height: var(--control-h-lg);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      color var(--dur-fast) var(--ease-brand);
  }
  .ec-tab:hover:not([aria-selected='true']) {
    color: var(--color-body);
    background: var(--color-canvas-soft-2);
  }
  .ec-tab[aria-selected='true'] {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
    box-shadow: inset 0 0 0 1px var(--color-brand);
  }
  .ec-tab:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }

  /* Visibility is driven by the .ec-pane--active class, NOT the [hidden]
     attribute. Tailwind v4's layered `[hidden]{display:none!important}` (in
     @layer base) beats any unlayered !important override, which would otherwise
     leave the .env.example pane invisible on desktop. */
  @media (max-width: 639px) {
    .ec-pane {
      display: none;
    }
    .ec-pane.ec-pane--active {
      display: block;
    }
  }

  /* The summary is ResultPanel's span (no scope attribute here). A seeded
     verdict tone must beat the panel's own text-inverse-mute utility. */
  .ec-pg :global(.result-panel__summary.text-inverse-error) {
    color: var(--color-inverse-error);
  }
  .ec-pg :global(.result-panel__summary.text-inverse-brand) {
    color: var(--color-inverse-brand);
  }

  /* Report layout. All children below are injected at runtime via innerHTML, so
     every selector is :global — Astro's scoped hash never reaches them. Light
     rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.ec-report` container. */
  .ec-report {
    min-height: var(--control-h-lg);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* A grouped report section (Missing / Unused). */
  :global(.ec-group) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: ec-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.ec-group--miss) {
    box-shadow: inset 0 0 0 1px var(--color-error-soft);
  }
  :global(.ec-group__head) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-hairline);
  }
  :global(.ec-group--miss .ec-group__head) {
    background: var(--color-error-soft);
    border-bottom-color: transparent;
  }
  :global(.ec-group__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
  }
  :global(.ec-group--miss .ec-group__icon) {
    color: var(--color-error);
  }
  :global(.ec-group--unused .ec-group__icon) {
    color: var(--color-mute);
  }
  :global(.ec-group__title) {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--color-ink);
  }
  :global(.ec-group--miss .ec-group__title) {
    color: var(--color-error-deep);
  }
  :global(.ec-group__count) {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
  }
  :global(.ec-group--miss .ec-group__count) {
    color: var(--color-error-deep);
    box-shadow: inset 0 0 0 1px var(--color-error-soft);
  }
  :global(.ec-group__hint) {
    padding: 8px 14px 0;
    font-size: 12px;
    line-height: 16px;
    color: var(--color-mute);
    text-wrap: pretty;
  }
  :global(.ec-list) {
    margin: 0;
    padding: 8px;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* A single variable row. Missing rows are copyable KEY= lines. */
  :global(.ec-item) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-soft);
  }
  :global(.ec-item--unused) {
    background: transparent;
  }
  :global(.ec-item__key) {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-ink);
    word-break: break-all;
  }
  :global(.ec-item--unused .ec-item__key) {
    color: var(--color-mute);
  }
  :global(.ec-item__eq) {
    color: var(--color-mute);
  }

  /* Per-row copy (render.ts) and the group's "Copy all": the kit's
     wireCopyButtons drives both through their data-copy / data-copy-all
     hooks; `data-copied` is the transient success state. */
  :global(.ec-copy),
  :global(.ec-copyall) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: var(--control-h-sm);
    border: none;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    line-height: 1;
    cursor: pointer;
    touch-action: manipulation;
    transition:
      box-shadow var(--dur-fast) var(--ease-brand),
      color var(--dur-fast) var(--ease-brand);
  }
  :global(.ec-copy) {
    @apply label-field;
    padding: 0 9px;
    color: var(--color-body);
  }
  :global(.ec-copyall) {
    padding: 0 10px;
    font-size: 12px;
  }
  :global(.ec-copy:hover),
  :global(.ec-copyall:hover) {
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  :global(.ec-copy:focus-visible),
  :global(.ec-copyall:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
  :global(.ec-copy__icon),
  :global(.ec-copyall__icon) {
    width: 13px;
    height: 13px;
    flex: 0 0 auto;
  }
  :global(.ec-copy[data-copied]),
  :global(.ec-copyall[data-copied]) {
    color: var(--color-success);
  }
  @media (pointer: coarse) {
    :global(.ec-copy),
    :global(.ec-copyall) {
      height: auto;
      min-height: var(--control-h-lg);
    }
  }

  /* Clean all-good state. */
  :global(.ec-ok) {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    animation: ec-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.ec-ok__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    color: var(--color-success);
  }
  :global(.ec-ok__text) {
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }

  /* Parse / engine error banner. */
  :global(.ec-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
    animation: ec-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.ec-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.ec-error__body) {
    min-width: 0;
  }
  :global(.ec-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.ec-error__detail) {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  @keyframes ec-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.ec-group),
    :global(.ec-ok),
    :global(.ec-error) {
      animation: none;
    }
  }

  /* Empty state — generous, centered frame. */
  :global(.ec-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* Loading dots — animate opacity only. */
  :global(.ec-loading) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-body);
  }
  :global(.ec-loading__dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-mute);
    animation: ec-pulse calc(var(--dur-base) * 6) ease-in-out infinite;
  }
  :global(.ec-loading__dot:nth-child(2)) {
    animation-delay: var(--dur-base);
  }
  :global(.ec-loading__dot:nth-child(3)) {
    animation-delay: calc(var(--dur-base) * 2);
  }
  @keyframes ec-pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.ec-loading__dot) {
      animation: none;
      opacity: 0.6;
    }
  }

  .is-busy {
    opacity: 0.65;
    pointer-events: none;
    cursor: progress;
  }
  .is-busy .ec-check-icon {
    display: none;
  }

  /* ── Instrument re-skin — the drift report is the L2 slab (dark in BOTH
     themes). Everything below uses the slab ink tier. ─────────────────── */
  .ec-report :global(.ec-empty) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .ec-report :global(.ec-loading) {
    color: var(--color-inverse-mute);
  }
  .ec-report :global(.ec-loading__dot) {
    background: var(--color-inverse-mute);
  }
  .ec-report :global(.ec-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .ec-report :global(.ec-group),
  .ec-report :global(.ec-ok) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .ec-report :global(.ec-group--miss) {
    box-shadow: inset 0 0 0 1px #ff9d9559;
  }
  .ec-report :global(.ec-group__head) {
    border-bottom-color: var(--color-inverse-hairline);
  }
  .ec-report :global(.ec-group--miss .ec-group__head) {
    background: #ff9d9514;
    border-bottom-color: transparent;
  }
  .ec-report :global(.ec-group__title),
  .ec-report :global(.ec-item__key) {
    color: var(--color-inverse-fg);
  }
  .ec-report :global(.ec-group--miss .ec-group__title),
  .ec-report :global(.ec-group--miss .ec-group__icon) {
    color: var(--color-inverse-error);
  }
  .ec-report :global(.ec-group--unused .ec-group__icon),
  .ec-report :global(.ec-group__hint),
  .ec-report :global(.ec-item__eq),
  .ec-report :global(.ec-item--unused .ec-item__key),
  .ec-report :global(.ec-ok) {
    color: var(--color-inverse-mute);
  }
  .ec-report :global(.ec-ok__icon) {
    color: var(--color-inverse-brand);
  }
  .ec-report :global(.ec-group__count) {
    background: #ffffff14;
    box-shadow: none;
    color: var(--color-inverse-mute);
  }
  .ec-report :global(.ec-group--miss .ec-group__count) {
    background: #ff9d951f;
    color: var(--color-inverse-error);
  }
  .ec-report :global(.ec-item) {
    background: #ffffff08;
  }
  .ec-report :global(.ec-item--unused) {
    background: transparent;
  }
  .ec-report :global(.ec-copy),
  .ec-report :global(.ec-copyall) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .ec-report :global(.ec-copy:hover),
  .ec-report :global(.ec-copyall:hover) {
    background: #ffffff14;
    box-shadow: inset 0 0 0 1px var(--color-inverse-control-edge);
    color: var(--color-inverse-fg);
  }
  .ec-report :global(.ec-copy[data-copied]),
  .ec-report :global(.ec-copyall[data-copied]) {
    background: #8fc97a1f;
    color: var(--color-inverse-brand);
  }
</style>

<script>
  import type { EditorView } from '@codemirror/view';
  import { wireSnapshotUI } from '../lib/tool-state/wire';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  // The HTML builders are shared with the frontmatter's build-time seed —
  // one implementation, so the no-JS markup and the live markup never drift.
  import {
    reportHtml,
    reportSummary,
    errorHtml,
    strList,
    EMPTY_HTML,
    LOADING_HTML,
    type SummaryTone,
  } from '../lib/env-checker/render';
  import type { EnvResult } from '../lib/env-checker/types';

  // CodeMirror (and the kit's plate theme, which imports @codemirror/view) is
  // loaded via dynamic import inside init() so its runtime code-splits into
  // its own chunk instead of shipping in the page's initial JS.

  type EngineModule = {
    check: (code: string, envExample: string) => EnvResult | Promise<EnvResult>;
  };
  type Example = { id: string; label: string; code: string; envExample: string };

  const ROOT_SEL = '.ec-pg';
  const LIVE_DEBOUNCE_MS = 220;

  /** Boot every (so far un-hydrated) playground instance on the page. */
  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.ecWired === 'true') return;
      root.dataset.ecWired = 'true';
      void init(root);
    });
  }

  /* ---- Small helpers -------------------------------------------------------- */

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function pick(o: Record<string, unknown>, keys: string[]): string {
    for (const k of keys) {
      const v = o[k];
      if (typeof v === 'string' && v.length > 0) return v;
    }
    return '';
  }

  /** Normalise the sibling `examples` array defensively. */
  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw.map((item, i) => {
      const o = (item ?? {}) as Record<string, unknown>;
      return {
        id: pick(o, ['id']) || `example-${i + 1}`,
        label: pick(o, ['label', 'name', 'title']) || `Example ${i + 1}`,
        code: typeof o.code === 'string' ? o.code : '',
        envExample: pick(o, ['envExample', 'env', 'example']),
      };
    });
  }

  /* ---- Report rendering (DOM writes over the shared pure builders) --------- */

  /** Summary ink on the slab: inverse tier only (never paper text-*). */
  function setSummary(summary: HTMLElement, text: string, tone: SummaryTone): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-brand', tone === 'success');
    summary.classList.toggle('text-inverse-error', tone === 'error');
    summary.classList.toggle('text-inverse-mute', tone === 'mute');
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', 'mute');
    container.innerHTML = EMPTY_HTML;
  }

  function renderLoading(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', 'mute');
    container.innerHTML = LOADING_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    setSummary(summary, 'Error', 'error');
    container.innerHTML = errorHtml(message);
  }

  function renderResult(container: HTMLElement, summary: HTMLElement, result: EnvResult): void {
    if (!result || result.error) {
      renderError(container, summary, result?.error ?? 'Unknown error while checking.');
      return;
    }
    const { text, tone } = reportSummary(result);
    setSummary(summary, text, tone);
    container.innerHTML = reportHtml(result);
  }

  /* ---- Instance init -------------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const codeHost = el<HTMLElement>(root, '#ec-editor-code');
    const envHost = el<HTMLElement>(root, '#ec-editor-env');
    const chipsWrap = el<HTMLElement>(root, '#ec-chips');
    const checkBtn = el<HTMLButtonElement>(root, '#ec-check');
    const clearBtn = el<HTMLButtonElement>(root, '#ec-clear');
    const liveInput = el<HTMLInputElement>(root, '#ec-live');
    const reportBox = el<HTMLElement>(root, '#ec-report');
    const summaryEl = el<HTMLElement>(root, '#ec-summary');
    const copyStatus = el<HTMLElement>(root, '#ec-copy-status');
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.ec-tab'));
    const snapSaveBtn = el<HTMLButtonElement>(root, '#ec-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#ec-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#ec-snap-delete');

    if (!codeHost || !envHost || !chipsWrap || !checkBtn || !reportBox || !summaryEl || !snapSaveBtn || !snapSelect || !snapDeleteBtn) {
      return;
    }

    // The report's per-row Copy and the group's Copy all (render.ts markup)
    // run through the kit's one delegated listener; outcomes are announced in
    // ResultPanel's #ec-copy-status. Copy all carries no payload in the
    // markup, so this listener — on the report, below the root, so it runs
    // first — fills it from the last check's missing keys.
    let lastMissing: string[] = [];
    reportBox.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const all = target?.closest<HTMLElement>('[data-copy-all]');
      if (all) all.dataset.copy = lastMissing.map((k) => `${k}=`).join('\n');
    });
    wireCopyButtons(root, { status: copyStatus });

    // Lazily load CodeMirror + the plate theme + the engine + examples (kept
    // out of the initial path so the CM runtime code-splits into its own chunk).
    let engine: EngineModule;
    let examples: Example[] = [];
    let makeEditor: (host: HTMLElement, doc: string, label: string, onChange: () => void) => EditorView;
    let setEditorDoc: (view: EditorView, doc: string) => void;
    try {
      const [
        { EditorState },
        { EditorView, keymap, lineNumbers, highlightActiveLine },
        { defaultKeymap, history, historyKeymap, indentWithTab },
        { plate },
        engineMod,
        examplesMod,
      ] = await Promise.all([
        import('@codemirror/state'),
        import('@codemirror/view'),
        import('@codemirror/commands'),
        import('../lib/playground-kit/cm-theme'),
        import('../lib/env-checker/engine'),
        import('../lib/env-checker/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);

      // Size only (the plate theme owns colour; global.css owns the focus
      // ring): 13px like the seeded fallback, scrolling inside 288–420px.
      const sizeTheme = EditorView.theme({
        '&': { fontSize: '13px', maxHeight: '420px' },
        '.cm-scroller': { overflow: 'auto' },
        '.cm-content, .cm-gutter': { minHeight: '288px' },
      });

      makeEditor = (host: HTMLElement, doc: string, label: string, onChange: () => void): EditorView => {
        const state = EditorState.create({
          doc,
          extensions: [
            lineNumbers(),
            history(),
            highlightActiveLine(),
            plate,
            sizeTheme,
            EditorView.lineWrapping,
            EditorView.contentAttributes.of({ 'aria-label': label }),
            keymap.of([
              // ⌘/Ctrl+Enter runs now — placed BEFORE defaultKeymap, whose
              // Mod-Enter would otherwise insert a blank line.
              {
                key: 'Mod-Enter',
                run: (v) => {
                  forceRun();
                  if (window.matchMedia?.('(pointer: coarse)').matches) v.contentDOM.blur();
                  return true;
                },
              },
              ...defaultKeymap,
              ...historyKeymap,
              indentWithTab,
              {
                key: 'Escape',
                run: (v) => {
                  v.contentDOM.blur();
                  return true;
                },
              },
            ]),
            EditorView.updateListener.of((u) => {
              if (u.docChanged) onChange();
            }),
          ],
        });
        return new EditorView({ state, parent: host });
      };

      setEditorDoc = (view: EditorView, doc: string): void => {
        view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: doc } });
      };
    } catch (err) {
      renderError(reportBox, summaryEl, 'The Env Example Checker engine failed to load. Reload the page to try again.');
      // eslint-disable-next-line no-console
      console.error('[EnvChecker] engine/examples import failed:', err);
      return;
    }

    // Seed from the first example (per the playground contract).
    const seed = examples[0] ?? { id: 'blank', label: 'Example', code: '', envExample: '' };

    // Live-check scheduling (debounced; only runs when the toggle is on, and
    // never for the seed/example dispatches — `liveReady` gates those).
    let liveReady = false;
    let debounceTimer: number | undefined;
    function scheduleLive(): void {
      if (!liveReady || !liveInput?.checked) return;
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(() => void run({ live: true }), LIVE_DEBOUNCE_MS);
    }

    /** Deliberate run (Run now, ⌘/Ctrl+Enter, a chip): cancel the debounce, go now. */
    function forceRun(): void {
      window.clearTimeout(debounceTimer);
      void run();
    }

    const codeView = makeEditor(codeHost, seed.code, 'Your application code', scheduleLive);
    const envView = makeEditor(envHost, seed.envExample, 'Your .env.example file', scheduleLive);
    // The build-time text stand-ins have done their job (no-JS visitors and
    // crawlers); CodeMirror appended its editors beside them, so drop them.
    // This tool is hard-excluded from restore-last-input and has no share link,
    // so the seeded example is always what the editors hold on boot.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());

    // Example chips are server-rendered from the same `examples` module, in the
    // same order, so `data-example-idx` indexes this array directly.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));

    // Swap both editors when a different example is chosen, then re-check.
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        const ex = examples[idx];
        syncChipsByIndex(chipsWrap, idx);
        setEditorDoc(codeView, ex.code);
        setEditorDoc(envView, ex.envExample);
        forceRun();
      });
    });

    // Mobile tab switching (panes are always visible on desktop via CSS).
    const codePane = el<HTMLElement>(root, '#ec-pane-code');
    const envPane = el<HTMLElement>(root, '#ec-pane-env');

    const activateTab = (tab: HTMLButtonElement, focusTab: boolean): void => {
      const showCode = tab.dataset.pane === 'code';
      tabs.forEach((t) => {
        const active = t === tab;
        t.setAttribute('aria-selected', active ? 'true' : 'false');
        // Roving tabindex: only the selected tab is in the tab order.
        t.tabIndex = active ? 0 : -1;
      });
      codePane?.classList.toggle('ec-pane--active', showCode);
      envPane?.classList.toggle('ec-pane--active', !showCode);
      if (focusTab) tab.focus();
      // Refresh CM measurement once the pane is visible (next frame, post-layout).
      requestAnimationFrame(() => (showCode ? codeView : envView).requestMeasure());
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activateTab(tab, false));
      // Roving focus with Left/Right/Home/End per the tablist a11y pattern.
      tab.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        activateTab(tabs[next], true);
      });
    });

    // Check — non-blocking. A deliberate run shows the loading state and a
    // spinner in Run now; a live (debounced) or seed run is quiet.
    type RunOpts = { live?: boolean; seed?: boolean };
    let running = false;
    let rerun: RunOpts | null = null;
    const checkLabel = checkBtn.querySelector<HTMLElement>('.ec-check-label');
    let spinner: HTMLElement | null = null;

    async function run(opts: RunOpts = {}): Promise<void> {
      const quiet = opts.live === true || opts.seed === true;
      if (running) {
        rerun = opts;
        return;
      }
      running = true;
      if (!quiet) {
        checkBtn!.classList.add('is-busy');
        checkBtn!.setAttribute('aria-disabled', 'true');
        checkBtn!.setAttribute('aria-busy', 'true');
        if (!spinner) {
          spinner = document.createElement('span');
          spinner.setAttribute('aria-hidden', 'true');
          // Inline the visual so it never depends on Astro's scoped CSS — this span
          // is created at runtime and would not receive the component's scope hash.
          spinner.style.cssText =
            'display:inline-block;width:14px;height:14px;flex:0 0 auto;border-radius:50%;' +
            'border:2px solid currentColor;border-top-color:transparent;';
          if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            spinner.animate([{ transform: 'rotate(0deg)' }, { transform: 'rotate(360deg)' }], {
              duration: 700,
              iterations: Infinity,
            });
          }
          checkBtn!.insertBefore(spinner, checkBtn!.firstChild);
        }
        if (checkLabel) checkLabel.textContent = 'Checking…';
        renderLoading(reportBox!, summaryEl!);

        // Yield so the loading state paints before (potentially heavy) work runs.
        await new Promise<void>((resolve) => {
          if ('requestAnimationFrame' in window) requestAnimationFrame(() => resolve());
          else setTimeout(resolve, 0);
        });
      }

      try {
        const code = codeView.state.doc.toString();
        const envDoc = envView.state.doc.toString();
        const result = await Promise.resolve(engine.check(code, envDoc));
        lastMissing = strList(result?.missingInExample);
        renderResult(reportBox!, summaryEl!, result);
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Unexpected error while checking.';
        renderError(reportBox!, summaryEl!, msg);
      } finally {
        running = false;
        checkBtn!.classList.remove('is-busy');
        checkBtn!.removeAttribute('aria-disabled');
        checkBtn!.removeAttribute('aria-busy');
        if (spinner) {
          spinner.remove();
          spinner = null;
        }
        if (checkLabel) checkLabel.textContent = 'Run now';
        if (rerun) {
          const next = rerun;
          rerun = null;
          void run(next);
        }
      }
    }

    checkBtn.addEventListener('click', () => forceRun());

    // Clear button — resets both editors to empty and clears the report. With
    // both editors empty no example is loaded, so no chip stays pressed.
    clearBtn?.addEventListener('click', () => {
      syncChipsByIndex(chipsWrap, null);
      setEditorDoc(codeView, '');
      setEditorDoc(envView, '');
      // The two dispatches scheduled a live check; the cleared state wins.
      window.clearTimeout(debounceTimer);
      lastMissing = [];
      renderEmpty(reportBox!, summaryEl!);
    });

    // ⌘/Ctrl+Enter anywhere else in the playground (a chip, the toggle, Run
    // now); inside an editor the Mod-Enter binding has already handled it.
    root.addEventListener('keydown', (e) => {
      if (e.defaultPrevented) return;
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        forceRun();
      }
    });

    // Toggling live on triggers an immediate check; off cancels pending work.
    liveInput?.addEventListener('change', () => {
      if (liveInput.checked) void run({ live: true });
      else window.clearTimeout(debounceTimer);
    });

    // Save-snapshot only — this tool is hard-excluded from auto-restore-last-input
    // (its input may be a secret), so there is no getRestoredLastInput() seed here.
    wireSnapshotUI({
      slug: 'env-example-checker',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () =>
        JSON.stringify({
          code: codeView.state.doc.toString(),
          envExample: envView.state.doc.toString(),
        }),
      setValue: (value) => {
        let parsed: { code?: unknown; envExample?: unknown };
        try {
          parsed = JSON.parse(value) as { code?: unknown; envExample?: unknown };
        } catch {
          return;
        }
        const code = typeof parsed.code === 'string' ? parsed.code : '';
        const envExample = typeof parsed.envExample === 'string' ? parsed.envExample : '';
        // Restored state is the visitor's own, not one of the examples — so no
        // chip is the active one any more.
        syncChipsByIndex(chipsWrap, null);
        setEditorDoc(codeView, code);
        setEditorDoc(envView, envExample);
        forceRun();
      },
    });

    // Initial pass over the seed: quiet, so the server-rendered report is
    // repainted in place (and `lastMissing` filled for Copy all).
    void run({ seed: true });
    liveReady = true;
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
