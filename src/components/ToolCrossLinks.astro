---
/**
 * ToolCrossLinks — the shared cross-link footer that closes every tool page.
 *
 * A centered block: heading, an intro sentence (`lead` slot), the canonical
 * "Browse All Tools" / "Back to OpsCanopy" CTA pair, a cross-link sentence
 * (`links` slot, holding inline <a class="link-inline"> references) and an
 * optional trademark/affiliation disclaimer (`disclaimer` slot) that only
 * renders when the slot is provided.
 *
 * When the current tool's category maps to a learning track (Networking,
 * Kubernetes, Docker) a small "New to X? Read the Y guide →" line surfaces
 * above the CTA pair to link readers into /learn.
 */
import Button from './Button.astro';
import { liveTools, categoryAccent, getTool } from '../data/tools';
import { getTrack } from '../data/learn';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { localizeKey, stripLocale, useTranslations } from '../i18n/utils';
import type { UiKey } from '../i18n/ui/en';
import { getPostsByTool } from '../i18n/blog';
import { getGuideForTool, getGuidesForLocale } from '../lib/learn/guides';

interface Props {
  heading?: string;
  /**
   * Optional current-tool slug. When provided, a "More in {category}" strip of
   * 2–3 sibling LIVE tools (same category, excluding the current slug) renders
   * above the CTA pair. With fewer than 2 siblings the strip is omitted.
   *
   * Omitting it is safe — the slug is recovered from the URL (see below).
   */
  slug?: string;
  /** Locale of the page rendering this footer — localizes every href below. */
  lang?: Locale;
}

const { heading = 'More free, private DevOps tools.', slug, lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);

/**
 * Recover the slug from the path when the page didn't pass one. 89 of the 116
 * localized tool pages omit the prop (the English copies all pass it), so
 * without this every strip below silently vanished on those pages — the exact
 * pages that most need internal links. Same fallback ToolHero already applies.
 */
const resolvedSlug = slug ?? stripLocale(Astro.url.pathname).split('/').filter(Boolean)[0];

// Resolve sibling LIVE tools sharing the current tool's category.
const current = resolvedSlug ? getTool(resolvedSlug) : undefined;
const sameCategory = current
  ? liveTools.filter((t) => t.category === current.category && t.slug !== current.slug)
  : [];

/**
 * Top up from the registry's hand-picked `related` when the category cannot supply
 * two siblings.
 *
 * The strip only renders at `>= 2` siblings, so the 1- and 2-tool categories got NO
 * strip at all — 8 tool pages (env-example-checker, terraform-plan-summarizer,
 * regex-log-tester, jq-playground, both kubernetes-* tools, docker-run-to-compose,
 * dockerfile-linter) lost their only in-body tool links, which is the opposite of
 * what a small category needs.
 *
 * Deliberately curated rather than scored. Ranking by shared `keywords` was tried
 * first and produced good pairs for some tools (jq-playground → json-yaml-converter)
 * and nonsense for others (env-example-checker → subnet-splitter,
 * terraform-plan-summarizer → jwt-decoder), because the keywords are full search
 * phrases that rarely share exact tokens. An irrelevant internal link is worse than
 * no link, so the eight get an explicit list instead of a guess.
 */
const siblings = (() => {
  if (!current) return [];
  if (sameCategory.length >= 2) return sameCategory.slice(0, 3);
  const chosen = new Set([current.slug, ...sameCategory.map((t) => t.slug)]);
  const topUp = (current.related ?? [])
    .filter((s) => !chosen.has(s))
    .map((s) => getTool(s))
    .filter((t): t is NonNullable<typeof t> => Boolean(t) && t!.status === 'live');
  return [...sameCategory, ...topUp].slice(0, 3);
})();
const showSiblings = siblings.length >= 2;
/** True when the strip contains tools from outside this category — changes the label. */
const toppedUp = siblings.some((t) => t.category !== current?.category);
const categoryDot = current ? categoryAccent[current.category] : undefined;

/**
 * Posts written about THIS tool, in THIS locale. Inverted from each post's
 * `relatedTool` frontmatter — the blog linked to tools but nothing linked back,
 * leaving all 100 posts reachable only from inside /blog/.
 */
const relatedPosts = current ? ((await getPostsByTool(lang)).get(current.slug) ?? []).slice(0, 3) : [];

/**
 * Entry-point guide for this tool, inverted from each guide's `relatedTools`.
 * Guides are English-only by design (ENGLISH_ONLY_SECTIONS), so the lookup and
 * the href both stay on the default locale on every page.
 */
const guide = current
  ? getGuideForTool(current.slug, await getGuidesForLocale(DEFAULT_LOCALE), current.category)
  : undefined;
const guideTrack = guide ? getTrack(guide.entry.data.track) : undefined;
const guideTrackName = guideTrack?.name ?? guide?.entry.data.track;
---

<section class="border-t border-hairline bg-canvas-soft py-16 sm:py-20">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center flex flex-col items-center gap-5">
      <h2 class="display-md text-ink">{heading}</h2>
      <p class="body-lg text-pretty text-body"><slot name="lead" /></p>
      {
        showSiblings && (
          <div class="w-full">
            <p class="eyebrow mb-3">
              {
                /* "More in {category}" becomes a false claim once the list is topped
                   up from `related`, because those tools are by definition NOT in
                   this category. Switch the label, not the links. */
                toppedUp
                  ? t('crosslinks.relatedTools')
                  : t('crosslinks.moreIn', {
                      category: t(`category.${current!.category}` as UiKey),
                    })
              }
            </p>
            <ul class="grid gap-3 text-left sm:grid-cols-2 lg:grid-cols-3">
              {siblings.map((tool) => (
                <li>
                  <a
                    href={localizeKey(`/${tool.slug}`, lang)}
                    class="card-soft flex h-full flex-col gap-1 p-4 transition-colors hover:border-brand"
                  >
                    <span class="flex items-center gap-2">
                      <span
                        class="inline-block size-2 shrink-0 rounded-full"
                        style={`background-color: ${categoryDot}`}
                        aria-hidden="true"
                      />
                      <span class="body-sm font-medium text-ink">{tool.name}</span>
                    </span>
                    <span class="caption text-pretty text-mute">{tool.tagline}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        relatedPosts.length > 0 && (
          <div class="w-full">
            <p class="eyebrow mb-3">{t('crosslinks.postsHeading')}</p>
            <ul class="grid gap-3 text-left sm:grid-cols-2 lg:grid-cols-3">
              {relatedPosts.map((post) => (
                <li>
                  <a
                    href={localizeKey(`/blog/${post.slug}`, lang)}
                    class="card-soft flex h-full flex-col gap-1 p-4 transition-colors hover:border-brand"
                  >
                    <span class="body-sm font-medium text-ink">{post.entry.data.title}</span>
                    <span class="caption text-pretty text-mute">
                      {post.entry.data.description}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        guide && guideTrackName && (
          <p class="body-sm text-body">
            {t('crosslinks.learnNewTo', { track: guideTrackName })}&nbsp;
            <a href={`/learn/guides/${guide.slug}/`} class="link-inline font-medium">
              {t('crosslinks.learnCta', { track: guideTrackName })} &rarr;
            </a>
          </p>
        )
      }
      <div class="flex flex-wrap items-center justify-center gap-3">
        <Button href={localizeKey('/tools', lang)}>Browse All Tools</Button>
        <Button href={localizeKey('/', lang)} variant="secondary">Back to OpsCanopy</Button>
      </div>
      {/* Brand-recall band — coordination (persona-audit plan): tenant order
          is this hook caption → command-palette hint (WS-R R4) → install CTA
          (WS-R R8). Keep new tenants below the hook line. */}
      <p class="caption max-w-xl text-pretty text-mute">
        {t('crosslinks.hook', { count: liveTools.length })}
      </p>
      <button
        type="button"
        class="crosslinks-palette-hint caption max-w-xl text-pretty text-mute"
        data-cmdk-open
      >
        {t('crosslinks.paletteHint', { count: liveTools.length })}
      </button>
      <p class="body-sm text-body"><slot name="links" /></p>
      {
        Astro.slots.has('disclaimer') && (
          <p class="caption mt-2 max-w-3xl text-pretty text-mute">
            <slot name="disclaimer" />
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .crosslinks-palette-hint {
    border: none;
    background: none;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.12s ease, color 0.12s ease;
  }
  .crosslinks-palette-hint:hover {
    color: var(--color-body);
    text-decoration-color: currentColor;
  }
  .crosslinks-palette-hint:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-cmdk-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('opencommandpalette'));
    });
  });
</script>
