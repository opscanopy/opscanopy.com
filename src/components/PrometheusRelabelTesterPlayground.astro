---
/**
 * PrometheusRelabelTesterPlayground — the interactive Prometheus Relabel Tester.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>
 * that lazily boots TWO CodeMirror 6 editors (relabel_configs YAML | sample
 * label sets), wires the example chips, live evaluation with a "Run now"
 * control, Copy (both documents) and Copy link. It is fully usable offline
 * once loaded.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * two EditorPanes (each a FigureCap over its CodeMirror host, seeded with a
 * `<pre data-cm-fallback>`), RunHint and SnapshotBar on paper, and
 * ResultPanel (figure cap, live summary, copy status) with CopyButton. The
 * results container stays here, seeded with `set:html` + `data-results`; its
 * slab overrides anchor on `.prt-results`.
 *
 * Runtime contract (imported lazily in the script):
 *   ../lib/prometheus-relabel-tester/engine →
 *     applyRelabel(configsYaml: string, labelSetsInput: string) => RelabelResult
 *       RelabelResult = {
 *         ok: boolean
 *         error?: string
 *         results?: Array<{
 *           index: number
 *           input: Array<{ name: string; value: string }>
 *           dropped: boolean
 *           droppedByRule?: number
 *           droppedByAction?: string
 *           output: Array<{ name: string; value: string }>
 *           changes: Array<{ name: string; kind: 'added'|'changed'|'removed';
 *                            before?: string; after?: string }>
 *         }>
 *         warnings: string[]
 *       }
 *   ../lib/prometheus-relabel-tester/examples →
 *     examples: Array<{ id: string; label: string; configs: string; labels: string }>
 *
 * All runtime-injected result markup is styled via :global(...) because
 * Astro scoped styles do not reach innerHTML-injected nodes.
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. Only the labels
// are read here; the chips are never rebuilt at hydration — the script wires
// clicks and reads `data-example-idx` into the lazily-imported `examples`, so
// the YAML payloads stay out of HTML attributes and off the shell path.
import { examples as prerenderedExamples } from '../lib/prometheus-relabel-tester/examples';
import { applyRelabel } from '../lib/prometheus-relabel-tester/engine';
import { resultsHtml, summaryText, allDropped, EMPTY_HTML } from '../lib/prometheus-relabel-tester/render';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-runs the same example on boot, so this
 * is pure progressive enhancement — but it means a visitor with no JS, and
 * every AI crawler (they do not execute JS), sees which label sets are kept,
 * changed or dropped instead of an empty "load an example" panel.
 *
 * `applyRelabel` is pure and synchronous (hashmod is a deterministic MD5), so
 * it runs at build time unchanged. The two editor bodies go into
 * `<pre data-cm-fallback>` elements inside the CodeMirror hosts — CM appends
 * its editor to the host, so the script removes every fallback once mounted.
 */
const seedExample = prerenderedExamples[0];
const seedResult = seedExample ? applyRelabel(seedExample.configs, seedExample.labels) : null;
const seedOk = seedResult && seedResult.ok && seedResult.results?.length ? seedResult : null;
const seedHtml = seedOk ? resultsHtml(seedOk) : EMPTY_HTML;
const seedSummary = seedOk ? summaryText(seedOk.results ?? []) : '';
const seedAllDropped = Boolean(seedOk && allDropped(seedOk.results ?? []));
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="prt" aria-label="Prometheus Relabel Tester playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: example chips + Run now (paper) ─────────────────────── */}
    <div
      class="flex flex-col gap-3 border-b border-hairline px-4 py-3 sm:flex-row sm:items-end sm:justify-between sm:px-5"
    >
      <div class="flex min-w-0 flex-col gap-2">
        <span class="eyebrow shrink-0">Example</span>
        <ExampleChips prefix="prt" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
      </div>
      <button
        id="prt-run"
        type="button"
        class="btn-tool prt-tap self-start sm:self-auto"
        title="Run now (⌘/Ctrl + Enter)"
        aria-keyshortcuts="Meta+Enter Control+Enter"
      >
        <svg
          class="prt-run-icon h-4 w-4 shrink-0"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 2.5l9 5.5-9 5.5z"></path>
        </svg>
        <span class="prt-run-label">Run now</span>
      </button>
    </div>

    {/* ── Editors on the plate (side by side on wide screens) ──────────── */}
    <div class="prt-grid grid md:grid-cols-2">
      <EditorPane prefix="prt" id="prt-configs" label="relabel_configs" class="prt-pane">
        <Fragment slot="actions">
          <CopyButton kind="value" id="prt-copy" label="Copy" hidden={false} ariaLabel="Copy rules and label sets" />
        </Fragment>
        <pre class="editor-pane__fallback code-mono prt-fallback" data-cm-fallback>{seedExample?.configs}</pre>
      </EditorPane>
      <EditorPane prefix="prt" id="prt-labels" label="label sets" class="prt-pane">
        <pre class="editor-pane__fallback code-mono prt-fallback" data-cm-fallback>{seedExample?.labels}</pre>
      </EditorPane>
    </div>

    {/* ── Input note, run hint + snapshots, on paper (never in the slab) ── */}
    <div class="border-b border-hairline px-4 py-3 sm:px-5">
      <p class="caption text-mute">One label set per block; separate sets with a blank line.</p>
      <RunHint variant="cm" />
      <SnapshotBar prefix="prt" />
    </div>

    {/* ── Results — the L2 instrument under its figure cap ─────────────── */}
    <ResultPanel
      slug="prometheus-relabel-tester"
      prefix="prt"
      label="Results"
      summary={seedSummary}
      summaryClass={seedAllDropped ? 'whitespace-nowrap text-inverse-error' : 'whitespace-nowrap'}
      split
    >
      <Fragment slot="actions">
        <CopyButton kind="link" id="prt-share" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the result cards are in
          the static HTML; the client replaces them with the same markup on boot. */}
      <div id="prt-results" class="prt-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .prt-tap {
    touch-action: manipulation;
  }

  /* The seeded documents a crawler reads (global .editor-pane__fallback sets
     the metrics), boxed to the editors' own min/max height (the script's
     size theme) so the swap on hydration does not move the page. */
  .prt-fallback {
    min-height: 288px;
    max-height: 460px;
    overflow: auto;
  }

  /* The divider between the two plates: a rule above the label sets when
     stacked, beside them from md. */
  .prt-grid :global(.prt-pane + .prt-pane) {
    border-top: 1px solid var(--color-inverse-hairline);
  }
  @media (min-width: 768px) {
    .prt-grid :global(.prt-pane + .prt-pane) {
      border-top: none;
      border-left: 1px solid var(--color-inverse-hairline);
    }
  }

  /* The summary is ResultPanel's span (no scope attribute here). A seeded
     all-dropped tone must beat the panel's own text-inverse-mute utility. */
  .prt :global(.result-panel__summary.text-inverse-error) {
    color: var(--color-inverse-error);
  }

  /* ── Results container (runtime-injected → :global). Light rules first as
     the documented defaults; the slab re-skin follows, anchored on this
     component's own `.prt-results` container. ─────────────────────────── */
  .prt-results {
    min-height: var(--control-h-lg);
  }
  :global(.prt-card + .prt-card) {
    margin-top: 14px;
  }
  :global(.prt-card) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: prt-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.prt-card--dropped) {
    box-shadow: inset 0 0 0 1px var(--color-warning-soft);
  }
  @keyframes prt-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.prt-card),
    :global(.prt-banner) {
      animation: none;
    }
  }

  :global(.prt-card__head) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-hairline);
    background: var(--color-canvas-soft);
  }
  /* "Label set N" — the card's heading (sans 12/16 600), not a caps label. */
  :global(.prt-card__title) {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    color: var(--color-ink);
  }

  /* Status pill — the row-key role (label-field). */
  :global(.prt-pill) {
    @apply label-field;
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-hairline);
  }
  :global(.prt-pill--kept) {
    /* Green wash derived from the success token (no --color-success-soft token
       exists in the design system, so mix one from --color-success). */
    background: color-mix(in srgb, var(--color-success) 14%, var(--color-canvas));
    color: var(--color-success);
  }
  :global(.prt-pill--dropped) {
    background: var(--color-warning-soft);
    color: var(--color-warning-deep);
  }

  :global(.prt-card__body) {
    padding: 12px 14px;
  }

  /* Label list rows. */
  :global(.prt-labels) {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  :global(.prt-label) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 18px;
    word-break: break-word;
  }
  :global(.prt-label__name) {
    color: var(--color-ink);
  }
  :global(.prt-label__eq) {
    color: var(--color-mute);
  }
  :global(.prt-label__value) {
    color: var(--color-body);
  }
  :global(.prt-tag) {
    @apply label-field;
    display: inline-flex;
    align-items: center;
    margin-left: 4px;
    padding: 0 6px;
    border-radius: var(--radius-sm);
  }
  :global(.prt-tag--added) {
    background: color-mix(in srgb, var(--color-success) 14%, var(--color-canvas));
    color: var(--color-success);
  }
  :global(.prt-tag--changed) {
    background: var(--color-canvas-soft-2);
    color: var(--color-body);
  }

  /* Input / Result / Removed / Output — the row-key role (label-field). */
  :global(.prt-section-label) {
    @apply label-field;
    margin-bottom: 6px;
  }
  :global(.prt-section + .prt-section) {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px dashed var(--color-hairline);
  }
  :global(.prt-drop-note) {
    font-size: 13px;
    line-height: 19px;
    color: var(--color-body);
  }
  :global(.prt-removed) {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-warning-deep);
    text-decoration: line-through;
    text-decoration-color: var(--color-warning-soft);
  }
  :global(.prt-empty-labels) {
    font-size: 13px;
    color: var(--color-mute);
    font-style: italic;
  }

  /* Warnings list. */
  :global(.prt-warnings) {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  :global(.prt-warning) {
    display: flex;
    gap: 8px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: inset 0 0 0 1px var(--color-warning-soft);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
  }
  :global(.prt-warning__icon) {
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    margin-top: 2px;
    color: var(--color-warning-deep);
  }

  /* Parse-error banner. */
  :global(.prt-banner) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
    animation: prt-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.prt-banner__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.prt-banner__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.prt-banner__detail) {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* Empty state. */
  :global(.prt-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* Loading dots. */
  :global(.prt-loading) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-body);
  }
  :global(.prt-loading__dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-mute);
    animation: prt-pulse calc(var(--dur-base) * 6) ease-in-out infinite;
  }
  :global(.prt-loading__dot:nth-child(2)) {
    animation-delay: var(--dur-base);
  }
  :global(.prt-loading__dot:nth-child(3)) {
    animation-delay: calc(var(--dur-base) * 2);
  }
  @keyframes prt-pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.prt-loading__dot) {
      animation: none;
      opacity: 0.6;
    }
  }

  .is-busy {
    opacity: 0.65;
    pointer-events: none;
    cursor: progress;
  }
  .is-busy .prt-run-icon {
    display: none;
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below uses the slab ink tier. ─────────────────── */
  .prt-results :global(.prt-empty) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .prt-results :global(.prt-loading) {
    color: var(--color-inverse-mute);
  }
  .prt-results :global(.prt-loading__dot) {
    background: var(--color-inverse-mute);
  }
  .prt-results :global(.prt-banner) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .prt-results :global(.prt-card) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .prt-results :global(.prt-card--dropped) {
    box-shadow: inset 0 0 0 1px #e0a45859;
  }
  .prt-results :global(.prt-card__head) {
    background: #ffffff08;
    border-bottom-color: var(--color-inverse-hairline);
  }
  .prt-results :global(.prt-card__title),
  .prt-results :global(.prt-label__name) {
    color: var(--color-inverse-fg);
  }
  .prt-results :global(.prt-label__eq),
  .prt-results :global(.prt-section-label),
  .prt-results :global(.prt-drop-note),
  .prt-results :global(.prt-empty-labels) {
    color: var(--color-inverse-mute);
  }
  .prt-results :global(.prt-label__value) {
    color: var(--color-inverse-fg);
  }
  .prt-results :global(.prt-section + .prt-section) {
    border-top-color: var(--color-inverse-hairline);
  }
  .prt-results :global(.prt-pill) {
    box-shadow: none;
  }
  .prt-results :global(.prt-pill--kept),
  .prt-results :global(.prt-tag--added) {
    background: #8fc97a1f;
    color: var(--color-inverse-brand);
  }
  .prt-results :global(.prt-pill--dropped) {
    background: #e0a4581f;
    color: var(--color-inverse-accent);
  }
  .prt-results :global(.prt-tag--changed) {
    background: #ffffff14;
    color: var(--color-inverse-mute);
  }
  .prt-results :global(.prt-removed) {
    color: var(--color-inverse-accent);
    text-decoration-color: #e0a45880;
  }
  .prt-results :global(.prt-warning) {
    background: #e0a45814;
    box-shadow: inset 0 0 0 1px #e0a45859;
    color: var(--color-inverse-fg);
  }
  .prt-results :global(.prt-warning__icon) {
    color: var(--color-inverse-accent);
  }
</style>

<script>
  import type { EditorView } from '@codemirror/view';
  import { base64UrlEncode, base64UrlDecode } from '../lib/codec';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  // The HTML builders are shared with the frontmatter's build-time seed —
  // one implementation, so the no-JS markup and the live markup never drift.
  import { resultsHtml, summaryText, allDropped, errorHtml, LOADING_HTML } from '../lib/prometheus-relabel-tester/render';
  import type { RelabelResult } from '../lib/prometheus-relabel-tester/types';

  // CodeMirror (and the kit's plate theme, which imports @codemirror/view) is
  // loaded via dynamic import inside init() so its runtime code-splits into
  // its own chunk instead of shipping in the page's initial JS.

  type EngineModule = {
    applyRelabel: (configsYaml: string, labelSetsInput: string) => RelabelResult | Promise<RelabelResult>;
  };
  type ExampleRaw = Record<string, unknown>;
  type Example = { id: string; label: string; configs: string; labels: string };

  const ROOT_SEL = '.prt';
  const SHARE_KEY = 'prt';
  const SLUG = 'prometheus-relabel-tester';

  /** Boot every (so far un-hydrated) playground instance on the page. */
  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.prtWired === 'true') return;
      root.dataset.prtWired = 'true';
      void init(root);
    });
  }

  /* ---- Small helpers -------------------------------------------------------- */

  function pick(obj: ExampleRaw, keys: string[]): string {
    for (const k of keys) {
      const v = obj[k];
      if (typeof v === 'string' && v.length > 0) return v;
    }
    return '';
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw.map((item, i) => {
      const o = (item ?? {}) as ExampleRaw;
      return {
        id: pick(o, ['id', 'slug', 'key']) || `example-${i + 1}`,
        label: pick(o, ['label', 'name', 'title']) || `Example ${i + 1}`,
        configs: pick(o, ['configs', 'config', 'rules', 'yaml']),
        labels: pick(o, ['labels', 'labelSets', 'sets', 'input']),
      };
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  /* ---- Result rendering (DOM writes over the shared pure builders) --------- */

  /** Summary ink on the slab: inverse tier only (never paper text-mute). */
  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderLoading(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = LOADING_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    setSummary(summary, 'Error', true);
    container.innerHTML = errorHtml(message);
  }

  /** Paint one result; returns false when it was an error state. */
  function renderResults(container: HTMLElement, summary: HTMLElement, result: RelabelResult): boolean {
    if (!result || result.ok === false || result.error) {
      renderError(container, summary, result?.error ?? 'Unknown error while applying relabel rules.');
      return false;
    }
    const results = Array.isArray(result.results) ? result.results : [];
    if (results.length === 0) {
      renderError(container, summary, 'No label sets were produced from the input.');
      return false;
    }
    setSummary(summary, summaryText(results), allDropped(results));
    container.innerHTML = resultsHtml(result);
    return true;
  }

  /* ---- Share-state codec (encodes BOTH editors) ----------------------------- */

  function b64decode(b64raw: string): string | null {
    try {
      return base64UrlDecode(b64raw);
    } catch {
      return null;
    }
  }

  function encodeShare(configs: string, labels: string): string {
    // Two payloads share one hash key, joined by "~" (not in base64url alphabet).
    return `#${SHARE_KEY}=${base64UrlEncode(configs)}~${base64UrlEncode(labels)}`;
  }

  function decodeShare(): { configs: string; labels: string } | null {
    const hash = window.location.hash.replace(/^#/, '');
    if (!hash) return null;
    const param = hash
      .split('&')
      .map((p) => p.split('='))
      .find(([k]) => k === SHARE_KEY);
    if (!param || !param[1]) return null;
    const [cfg, lbl] = param[1].split('~');
    const configs = b64decode(cfg ?? '');
    const labels = b64decode(lbl ?? '');
    if (configs === null || labels === null) return null;
    return { configs, labels };
  }

  /* ---- Instance init -------------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const configsHost = el<HTMLElement>(root, '#prt-configs');
    const labelsHost = el<HTMLElement>(root, '#prt-labels');
    const chipsWrap = el<HTMLElement>(root, '#prt-chips');
    const runBtn = el<HTMLButtonElement>(root, '#prt-run');
    const copyBtn = el<HTMLButtonElement>(root, '#prt-copy');
    const shareBtn = el<HTMLButtonElement>(root, '#prt-share');
    const resultsBox = el<HTMLElement>(root, '#prt-results');
    const summaryEl = el<HTMLElement>(root, '#prt-summary');
    const copyStatus = el<HTMLElement>(root, '#prt-copy-status');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#prt-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#prt-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#prt-snap-delete');

    if (
      !configsHost ||
      !labelsHost ||
      !chipsWrap ||
      !runBtn ||
      !copyBtn ||
      !shareBtn ||
      !resultsBox ||
      !summaryEl ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    // Copy (both documents) and Copy link: the kit's one delegated listener;
    // outcomes are announced in ResultPanel's #prt-copy-status.
    wireCopyButtons(root, { status: copyStatus });
    shareBtn.title = 'This link encodes your rules and label sets — review before sharing';

    // Lazily load CodeMirror + the plate theme + the engine + examples (kept
    // out of the initial path so the CM runtime code-splits into its own chunk).
    let engine: EngineModule;
    let examples: Example[] = [];
    let makeEditor: (host: HTMLElement, doc: string, label: string) => EditorView;
    let setEditorDoc: (view: EditorView, doc: string) => void;
    try {
      const [
        engineMod,
        examplesMod,
        { EditorState },
        { EditorView, keymap, lineNumbers, highlightActiveLine },
        { defaultKeymap, history, historyKeymap, indentWithTab },
        { yaml },
        { plate },
      ] = await Promise.all([
        import('../lib/prometheus-relabel-tester/engine'),
        import('../lib/prometheus-relabel-tester/examples'),
        import('@codemirror/state'),
        import('@codemirror/view'),
        import('@codemirror/commands'),
        import('@codemirror/lang-yaml'),
        import('../lib/playground-kit/cm-theme'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);

      // Size only (the plate theme owns colour; global.css owns the focus
      // ring): 13px like the seeded fallback, scrolling inside 288–460px.
      const sizeTheme = EditorView.theme({
        '&': { fontSize: '13px', maxHeight: '460px' },
        '.cm-scroller': { overflow: 'auto' },
        '.cm-content, .cm-gutter': { minHeight: '288px' },
      });

      makeEditor = (host: HTMLElement, doc: string, label: string): EditorView => {
        const state = EditorState.create({
          doc,
          extensions: [
            lineNumbers(),
            history(),
            highlightActiveLine(),
            yaml(),
            plate,
            sizeTheme,
            EditorView.lineWrapping,
            EditorView.contentAttributes.of({ 'aria-label': label }),
            keymap.of([
              // ⌘/Ctrl+Enter runs now — placed BEFORE defaultKeymap, whose
              // Mod-Enter would otherwise insert a blank line.
              {
                key: 'Mod-Enter',
                run: (v) => {
                  forceRun();
                  if (window.matchMedia?.('(pointer: coarse)').matches) v.contentDOM.blur();
                  return true;
                },
              },
              ...defaultKeymap,
              ...historyKeymap,
              indentWithTab,
              {
                key: 'Escape',
                run: (v) => {
                  v.contentDOM.blur();
                  return true;
                },
              },
            ]),
            // Live eval: re-apply the rules once the documents settle.
            EditorView.updateListener.of((u) => {
              if (u.docChanged) scheduleLive();
            }),
          ],
        });
        return new EditorView({ state, parent: host });
      };

      setEditorDoc = (view: EditorView, doc: string): void => {
        view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: doc } });
      };
    } catch (err) {
      renderError(resultsBox, summaryEl, 'The relabel engine failed to load. Reload the page to try again.');
      // eslint-disable-next-line no-console
      console.error('[PrometheusRelabelTester] engine/examples import failed:', err);
      return;
    }

    // Seed priority: a shared `#prt=` deep link > the last remembered input
    // for this tool > the first example.
    const seed = examples[0] ?? { id: 'example', label: 'Example', configs: '', labels: '' };
    let seedConfigs = seed.configs;
    let seedLabels = seed.labels;
    let fromShare = false;
    let fromRestored = false;
    const shared = decodeShare();
    if (shared) {
      seedConfigs = shared.configs;
      seedLabels = shared.labels;
      fromShare = true;
    } else {
      const restored = getRestoredLastInput(SLUG);
      if (restored) {
        try {
          const parsed = JSON.parse(restored) as { configs?: unknown; labels?: unknown };
          if (typeof parsed.configs === 'string' && typeof parsed.labels === 'string') {
            seedConfigs = parsed.configs;
            seedLabels = parsed.labels;
            fromRestored = true;
          }
        } catch {
          /* malformed restore — keep the example seed */
        }
      }
    }

    /* ---- Live evaluation ---------------------------------------------------
     * ~220ms after either document settles the rules are re-applied quietly
     * (no spinner, no loading flash, no hash write). Calm errors: a live run
     * that fails to parse holds the previous panel and reveals the error only
     * after ~600ms of idle in total.                                        */
    const LIVE_DEBOUNCE_MS = 220;
    const ERROR_HOLD_MS = 380;
    let liveReady = false;
    let liveTimer: number | undefined;
    let errorHoldTimer: number | undefined;

    function scheduleLive(): void {
      if (!liveReady) return;
      window.clearTimeout(liveTimer);
      window.clearTimeout(errorHoldTimer);
      liveTimer = window.setTimeout(() => void run({ live: true }), LIVE_DEBOUNCE_MS);
    }

    /** Deliberate run (Run now, ⌘/Ctrl+Enter, a chip): cancel the debounce, go now. */
    function forceRun(): void {
      window.clearTimeout(liveTimer);
      window.clearTimeout(errorHoldTimer);
      void run();
    }

    const configsView = makeEditor(configsHost, seedConfigs, 'relabel_configs (YAML)');
    const labelsView = makeEditor(labelsHost, seedLabels, 'Sample label sets');
    // The build-time text stand-ins have done their job (no-JS visitors and
    // crawlers); CodeMirror appended its editors beside them, so drop them.
    // The share-link and restore tiers above already won over the example
    // seed where they applied, so nothing the fallback held is lost.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());

    // The example chips are already in the static HTML (server-rendered from
    // the same `examples` module); hydration only wires them.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));
    if (examples.length === 0)
      chips.forEach((chip) => {
        chip.disabled = true;
      });

    // The first chip is server-rendered pressed; release it when the editors
    // were seeded from a share link or a restore instead of from an example.
    syncChipsByIndex(chipsWrap, fromShare || fromRestored || examples.length === 0 ? null : 0);

    // Swap both editors when a different example is chosen, then run it.
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        syncChipsByIndex(chipsWrap, idx);
        setEditorDoc(configsView, examples[idx].configs);
        setEditorDoc(labelsView, examples[idx].labels);
        forceRun();
      });
    });

    // Copy fills its payload at click time — the rules + label sets as one
    // text block. This target-phase listener runs before the kit's delegated
    // one on the root.
    copyBtn.addEventListener('click', () => {
      copyBtn.dataset.copy = `# relabel_configs\n${configsView.state.doc.toString()}\n\n# label sets\n${labelsView.state.doc.toString()}`;
    });

    /** Copy link appears once a result exists, carrying both documents. */
    function setShare(configs: string | null, labels = ''): void {
      if (!shareBtn) return;
      shareBtn.hidden = configs === null;
      shareBtn.dataset.copy = configs === null ? '' : `${window.location.href.split('#')[0]}${encodeShare(configs, labels)}`;
    }

    // Run — non-blocking. A deliberate run shows the loading state and a
    // spinner in Run now; a live (debounced) or seed run is quiet. Only a
    // deliberate run rewrites the address bar; the seed never records a last
    // input (it is not something the visitor typed).
    type RunOpts = { live?: boolean; showErrors?: boolean; seed?: boolean };
    let running = false;
    let rerun: RunOpts | null = null;
    const runLabel = runBtn.querySelector<HTMLElement>('.prt-run-label');
    let spinner: HTMLElement | null = null;
    async function run(opts: RunOpts = {}): Promise<void> {
      // Guaranteed present by the early return in init(); restated because TypeScript
      // discards that narrowing inside a hoisted function declaration.
      if (!runBtn) return;
      const live = opts.live === true;
      const seeded = opts.seed === true;
      const quiet = live || seeded;
      if (running) {
        rerun = opts;
        return;
      }
      running = true;
      if (!quiet) {
        runBtn.classList.add('is-busy');
        runBtn.setAttribute('aria-disabled', 'true');
        runBtn.setAttribute('aria-busy', 'true');
        if (!spinner) {
          spinner = document.createElement('span');
          spinner.setAttribute('aria-hidden', 'true');
          spinner.style.cssText =
            'display:inline-block;width:14px;height:14px;flex:0 0 auto;border-radius:50%;' +
            'border:2px solid currentColor;border-top-color:transparent;';
          if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            spinner.animate([{ transform: 'rotate(0deg)' }, { transform: 'rotate(360deg)' }], {
              duration: 700,
              iterations: Infinity,
            });
          }
          runBtn.insertBefore(spinner, runBtn.firstChild);
        }
        if (runLabel) runLabel.textContent = 'Running…';
        renderLoading(resultsBox!, summaryEl!);

        await new Promise<void>((resolve) => {
          if ('requestAnimationFrame' in window) {
            requestAnimationFrame(() => resolve());
          } else {
            setTimeout(resolve, 0);
          }
        });
      }

      try {
        const configs = configsView.state.doc.toString();
        const labels = labelsView.state.doc.toString();
        const result = await Promise.resolve(engine.applyRelabel(configs, labels));
        const failed = !result || result.ok === false || Boolean(result.error) || !result.results?.length;
        if (live && failed && opts.showErrors !== true) {
          // Hold the last good panel; reveal the error only after a longer idle.
          window.clearTimeout(errorHoldTimer);
          errorHoldTimer = window.setTimeout(() => void run({ live: true, showErrors: true }), ERROR_HOLD_MS);
        } else {
          const ok = renderResults(resultsBox!, summaryEl!, result);
          setShare(ok ? configs : null, labels);
          if (!quiet && ok) {
            try {
              window.history.replaceState(null, '', encodeShare(configs, labels));
            } catch {
              /* non-fatal */
            }
          }
        }
        if (!seeded) recordToolLastInput(SLUG, JSON.stringify({ configs, labels }));
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Unexpected error while applying rules.';
        renderError(resultsBox!, summaryEl!, msg);
        setShare(null);
      } finally {
        running = false;
        runBtn.classList.remove('is-busy');
        runBtn.removeAttribute('aria-disabled');
        runBtn.removeAttribute('aria-busy');
        if (spinner) {
          spinner.remove();
          spinner = null;
        }
        if (runLabel) runLabel.textContent = 'Run now';
        if (rerun) {
          const next = rerun;
          rerun = null;
          void run(next);
        }
      }
    }

    runBtn.addEventListener('click', () => forceRun());

    // ⌘/Ctrl+Enter anywhere else in the playground (a chip, Run now); inside
    // an editor the Mod-Enter binding has already handled it.
    root.addEventListener('keydown', (e) => {
      if (e.defaultPrevented) return;
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        forceRun();
      }
    });

    // Snapshot save/restore — stores BOTH editors as one JSON blob (this tool
    // has two input fields, not one), parsed back defensively on restore.
    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () =>
        JSON.stringify({
          configs: configsView.state.doc.toString(),
          labels: labelsView.state.doc.toString(),
        }),
      setValue: (value) => {
        try {
          const parsed = JSON.parse(value) as { configs?: unknown; labels?: unknown };
          if (typeof parsed.configs === 'string') setEditorDoc(configsView, parsed.configs);
          if (typeof parsed.labels === 'string') setEditorDoc(labelsView, parsed.labels);
        } catch {
          /* malformed snapshot — ignore, leave current editors as-is */
          return;
        }
        // A snapshot is not an example: no chip should claim to be selected.
        syncChipsByIndex(chipsWrap, null);
        forceRun();
      },
    });

    // Run once over whatever the editors ended up holding — a shared link, a
    // restored input, or the seeded example (whose result is already in the
    // static HTML; this pass repaints identical markup and binds the client
    // state). Quiet and not user-initiated: no hash write, no last-input record.
    void run({ seed: true });
    // Only now may keystrokes drive the panel (seed dispatches must not).
    liveReady = true;
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
