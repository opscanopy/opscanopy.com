---
/**
 * CronToSystemdPlayground — the interactive Cron → systemd Converter island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>
 * that lazily boots a CodeMirror 6 input editor (the crontab line) plus two
 * read-only output editors (.timer + .service units). Conversion is live and
 * debounced; "Run now" and ⌘/Ctrl + Enter convert immediately.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * EditorPane (the crontab slab), RunHint, SnapshotBar, ResultPanel (figure
 * cap, live summary, copy status) and CopyButton. The notes container stays
 * here, seeded with `set:html` + `data-results`; its slab overrides anchor on
 * `.cs-notes`, and the two unit files sit on the same result slab.
 *
 * Runtime contract (imported lazily in the script):
 *   ../lib/cron-systemd/types →
 *     type SystemdResult = {
 *       valid: boolean
 *       error?: string
 *       onCalendar: string
 *       timerUnit: string
 *       serviceUnit: string
 *       notes: string[]
 *     }
 *   ../lib/cron-systemd/engine →
 *     convert(cronLine: string, opts?: { unitName?: string }) => SystemdResult
 *   ../lib/cron-systemd/examples →
 *     examples: { id: string; label: string; cron: string }[]
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used to server-render the example chips (ExampleChips) so the static HTML
// carries real example names for crawlers and no-JS visitors. The script
// re-reads the examples module at hydration and addresses each chip by its
// `data-example-idx`, so this adds nothing to the client bundle.
import { examples as prerenderedExamples } from '../lib/cron-systemd/examples';
import { convert } from '../lib/cron-systemd/engine';
import { notesHtml, notesSummaryText, onCalendarText, EMPTY_HTML } from '../lib/cron-systemd/render';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-converts the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees the real `OnCalendar=`
 * expression, both unit files and the migration notes instead of empty panes.
 *
 * `convert` is pure and synchronous and emits a calendar EXPRESSION, never a
 * next-run time, so it runs at build time unchanged. The unit name is the
 * script's default for an empty "Unit name" field. The crontab line and the
 * two unit bodies go into `<pre data-cm-fallback>` elements inside the
 * CodeMirror hosts — CM appends its editor to the host, so the script removes
 * every fallback once mounted.
 */
const seedExample = prerenderedExamples[0];
const seedResult = seedExample ? convert(seedExample.cron, { unitName: 'cron-job' }) : null;
const seedOk = seedResult && seedResult.valid ? seedResult : null;
const seedOnCalendar = seedResult ? onCalendarText(seedResult) : '—';
const seedTimerUnit = seedOk ? seedOk.timerUnit : '';
const seedServiceUnit = seedOk ? seedOk.serviceUnit : '';
const seedNotesHtml = seedOk ? notesHtml(seedOk.notes) : EMPTY_HTML;
const seedSummary = seedOk ? notesSummaryText(seedOk.notes) : '';
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label, ariaLabel: `${ex.label} — ${ex.cron}` }));
---

<section class="cs-pg" aria-label="Cron to systemd converter playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: examples, unit name, Run now ────────────────────────── */}
    <div
      class="flex flex-col gap-3 border-b border-hairline px-4 py-3 lg:flex-row lg:items-end lg:justify-between lg:px-5"
    >
      <div class="flex min-w-0 flex-wrap items-end gap-3">
        <div class="flex min-w-0 flex-col gap-2">
          <span class="eyebrow">Examples</span>
          <ExampleChips prefix="cs" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
        </div>

        <div class="flex min-w-0 flex-col gap-1">
          <label class="eyebrow" for="cs-unit">Unit name</label>
          <input
            id="cs-unit"
            class="cs-text code-mono input-focus"
            type="text"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            placeholder="backup"
            aria-describedby="cs-unit-hint"
          />
          <span id="cs-unit-hint" class="sr-only">
            Base name for the generated .timer and .service units. Optional.
          </span>
        </div>
      </div>

      <button
        id="cs-convert"
        type="button"
        class="btn-tool cs-tap"
        title="Run now (⌘/Ctrl + Enter)"
        aria-keyshortcuts="Meta+Enter Control+Enter"
      >
        Run now
      </button>
    </div>

    {/* ── Input: the single crontab line on its editor slab ────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <EditorPane prefix="cs" id="cs-editor-input" label="crontab">
        <pre class="editor-pane__fallback code-mono" data-cm-fallback>{seedExample?.cron}</pre>
      </EditorPane>
      <RunHint variant="cm" class="mt-2" />
      <SnapshotBar prefix="cs" />
    </div>

    {/* ── Result: OnCalendar, notes, and the two generated unit files ──── */}
    <ResultPanel slug="cron-to-systemd" prefix="cs" summary={seedSummary} summaryClass="whitespace-nowrap" split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="cs-share" />
        <CopyButton kind="all" id="cs-copy-all" label="Copy both units" />
      </Fragment>

      <div class="cs-oncal">
        <span class="cs-oncal__k">OnCalendar</span>
        <code id="cs-oncalendar" class="cs-oncalendar code-mono">{seedOnCalendar}</code>
      </div>

      {/* Seeded at build time (see `seedNotesHtml` above) so the notes are in
          the static HTML; the client replaces it with the same markup on boot. */}
      <div id="cs-notes" class="cs-notes" set:html={seedNotesHtml} data-results></div>

      <div class="cs-units">
        <div class="cs-file">
          <div class="cs-file__bar">
            <span id="cs-timer-name" class="cs-file__name code-mono">cron-job.timer</span>
            <CopyButton kind="value" id="cs-copy-timer" ariaLabel="Copy timer unit" />
          </div>
          <div
            id="cs-editor-timer"
            class="cs-file__host editor-pane__host"
            role="region"
            aria-label="Generated systemd timer unit (read-only)"
          >
            <pre class="editor-pane__fallback code-mono" data-cm-fallback>{seedTimerUnit}</pre>
          </div>
        </div>

        <div class="cs-file">
          <div class="cs-file__bar">
            <span id="cs-service-name" class="cs-file__name code-mono">cron-job.service</span>
            <CopyButton kind="value" id="cs-copy-service" ariaLabel="Copy service unit" />
          </div>
          <div
            id="cs-editor-service"
            class="cs-file__host editor-pane__host"
            role="region"
            aria-label="Generated systemd service unit (read-only)"
          >
            <pre class="editor-pane__fallback code-mono" data-cm-fallback>{seedServiceUnit}</pre>
          </div>
        </div>
      </div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* Tap targets opt into fast-tap + no double-tap-zoom on touch. */
  .cs-tap {
    touch-action: manipulation;
  }

  /* Unit-name text input (the in-app form scale). */
  .cs-text {
    width: 100%;
    height: var(--control-h-md);
    min-width: 0;
    max-width: 200px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    color: var(--color-ink);
    font-size: 13px;
    line-height: 20px;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  /* Unlayered scoped CSS always beats a layered Tailwind @utility for the same
     property (CSS Cascade Layers) — excluding :focus-visible here lets the
     shared .input-focus utility's ring actually take over during focus. */
  .cs-text:not(:focus-visible) {
    box-shadow: var(--shadow-hairline);
  }
  @media (min-width: 640px) {
    .cs-text {
      min-width: 160px;
    }
  }
  .cs-text::placeholder {
    color: var(--color-mute);
  }
  .cs-text:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }

  /* ── Result slab layout ────────────────────────────────────────────── */
  .cs-oncal {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin-bottom: 12px;
  }
  .cs-oncal__k {
    @apply label-field;
    color: var(--color-inverse-mute);
  }
  .cs-oncalendar {
    min-width: 0;
    color: var(--color-inverse-brand);
    font-size: 13px;
    line-height: 20px;
    overflow-wrap: anywhere;
  }
  .cs-units {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    margin-top: 12px;
  }
  @media (min-width: 768px) {
    .cs-units {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .cs-file {
    min-width: 0;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    overflow: hidden;
  }
  .cs-file__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 8px 6px 12px;
    border-bottom: 1px solid var(--color-inverse-hairline);
  }
  .cs-file__name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12px;
    line-height: 16px;
    color: var(--color-inverse-mute);
  }
  .cs-file__host {
    min-width: 0;
  }

  /* Notes list (migration notes / success / empty). */
  .cs-notes {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.cs-notes` container. */
  :global(.cs-note) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-warning-soft);
    box-shadow: inset 0 0 0 1px var(--color-warning);
    color: var(--color-warning-deep);
    animation: cs-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.cs-note__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    color: var(--color-warning-deep);
  }
  :global(.cs-note__body) {
    min-width: 0;
    flex: 1 1 auto;
  }
  :global(.cs-note__title) {
    font-size: 13px;
    font-weight: 500;
    line-height: 18px;
  }
  :global(.cs-note__list) {
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  :global(.cs-note__item) {
    position: relative;
    padding-left: 16px;
    font-size: 13px;
    line-height: 18px;
    word-break: break-word;
  }
  :global(.cs-note__item::before) {
    content: '';
    position: absolute;
    left: 4px;
    top: 7px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.7;
  }

  /* Success note (converted, no migration caveats). */
  :global(.cs-ok) {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    animation: cs-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.cs-ok__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    color: var(--color-success);
  }
  :global(.cs-ok__text) {
    font-size: 13px;
    line-height: 18px;
  }

  /* Parse / conversion error banner. */
  :global(.cs-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
    animation: cs-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.cs-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.cs-error__body) {
    min-width: 0;
  }
  :global(.cs-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.cs-error__detail) {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  @keyframes cs-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.cs-note),
    :global(.cs-ok),
    :global(.cs-error) {
      animation: none;
    }
  }

  /* Empty state — generous, centered frame. */
  :global(.cs-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }
  :global(.cs-empty code) {
    color: var(--color-body);
  }

  /* ── Instrument re-skin — the notes sit on the L2 result slab (dark in
     BOTH themes), so everything render.ts emits uses the slab ink tier. ── */
  .cs-notes :global(.cs-note) {
    background: #e0a45814;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-accent);
  }
  .cs-notes :global(.cs-note__icon) {
    color: var(--color-inverse-accent);
  }
  .cs-notes :global(.cs-note__item) {
    color: var(--color-inverse-fg);
  }
  .cs-notes :global(.cs-ok),
  .cs-notes :global(.cs-empty) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-fg);
  }
  .cs-notes :global(.cs-ok__icon) {
    color: var(--color-inverse-brand);
  }
  .cs-notes :global(.cs-empty),
  .cs-notes :global(.cs-empty code) {
    color: var(--color-inverse-mute);
  }
  .cs-notes :global(.cs-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }

  .is-busy {
    opacity: 0.65;
    pointer-events: none;
    cursor: progress;
  }
</style>

<script>
  import type { EditorView } from '@codemirror/view';
  import { buildHashValue, createHashState } from '../lib/hash-state';
  import { wireRunKeys } from '../lib/run-keys';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, clearChips, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  // The HTML builders are shared with the frontmatter's build-time seed —
  // one implementation, so the no-JS markup and the live markup never drift.
  import {
    notesHtml,
    notesSummaryText,
    onCalendarText,
    errorHtml,
    EMPTY_HTML,
  } from '../lib/cron-systemd/render';
  import type { SystemdResult } from '../lib/cron-systemd/types';

  // CodeMirror is loaded via dynamic import inside init() so its ~200KB runtime
  // code-splits into its own chunk instead of shipping in the page's initial JS.
  // The `EditorView` type above is erased at build time and ships no runtime code.

  type EngineModule = {
    convert: (cronLine: string, opts?: { unitName?: string }) => SystemdResult | Promise<SystemdResult>;
  };
  type Example = { id: string; label: string; cron: string };
  /** `seed` = boot / deep link / restore (never recorded); `type` = debounced edit; `run` = explicit. */
  type Source = 'seed' | 'type' | 'run';

  const ROOT_SEL = '.cs-pg';
  const SLUG = 'cron-to-systemd';
  const DEBOUNCE_MS = 180;

  /** Boot every (so far un-hydrated) playground instance on the page. */
  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.csWired === 'true') return;
      root.dataset.csWired = 'true';
      void init(root);
    });
  }

  /* ---- Small helpers -------------------------------------------------------- */

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  /** Normalise the sibling examples list defensively. */
  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          cron: typeof o.cron === 'string' ? o.cron : '',
        } satisfies Example;
      })
      .filter((e) => e.cron.length > 0);
  }

  /** Sanitise a unit base name to systemd-safe characters; '' if none given. */
  function sanitiseUnitName(raw: string): string {
    return raw
      .trim()
      .replace(/\.(timer|service)$/i, '')
      .replace(/[^A-Za-z0-9:_.@-]/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  function isCoarsePointer(): boolean {
    return window.matchMedia?.('(pointer: coarse)').matches ?? false;
  }

  /* ---- Summary + notes rendering (slab inks) -------------------------------- */

  type Tone = 'mute' | 'accent' | 'error';
  function setSummary(summary: HTMLElement, text: string, tone: Tone): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-mute', tone === 'mute');
    summary.classList.toggle('text-inverse-accent', tone === 'accent');
    summary.classList.toggle('text-inverse-error', tone === 'error');
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', 'mute');
    container.innerHTML = EMPTY_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    setSummary(summary, 'Error', 'error');
    container.innerHTML = errorHtml(message);
  }

  function renderNotes(container: HTMLElement, summary: HTMLElement, notes: string[]): void {
    setSummary(summary, notesSummaryText(notes), notes.length === 0 ? 'mute' : 'accent');
    container.innerHTML = notesHtml(notes);
  }

  /* ---- Instance init -------------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const inputHost = el<HTMLElement>(root, '#cs-editor-input');
    const timerHost = el<HTMLElement>(root, '#cs-editor-timer');
    const serviceHost = el<HTMLElement>(root, '#cs-editor-service');
    const chipsWrap = el<HTMLElement>(root, '#cs-chips');
    const unitInput = el<HTMLInputElement>(root, '#cs-unit');
    const convertBtn = el<HTMLButtonElement>(root, '#cs-convert');
    const copyTimerBtn = el<HTMLButtonElement>(root, '#cs-copy-timer');
    const copyServiceBtn = el<HTMLButtonElement>(root, '#cs-copy-service');
    const shareBtn = el<HTMLButtonElement>(root, '#cs-share');
    const copyAllBtn = el<HTMLButtonElement>(root, '#cs-copy-all');
    const copyStatus = el<HTMLElement>(root, '#cs-copy-status');
    const onCalendarEl = el<HTMLElement>(root, '#cs-oncalendar');
    const notesBox = el<HTMLElement>(root, '#cs-notes');
    const summaryEl = el<HTMLElement>(root, '#cs-summary');
    const timerNameEl = el<HTMLElement>(root, '#cs-timer-name');
    const serviceNameEl = el<HTMLElement>(root, '#cs-service-name');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#cs-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#cs-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#cs-snap-delete');

    if (
      !inputHost ||
      !timerHost ||
      !serviceHost ||
      !chipsWrap ||
      !unitInput ||
      !convertBtn ||
      !copyTimerBtn ||
      !copyServiceBtn ||
      !shareBtn ||
      !copyAllBtn ||
      !copyStatus ||
      !onCalendarEl ||
      !notesBox ||
      !summaryEl ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    // Copy plumbing (per-unit copy, Copy all, Copy link) — the kit helper: one
    // delegated listener; outcomes announced in #cs-copy-status.
    wireCopyButtons(root, { status: copyStatus });

    const hashState = createHashState('cron');

    // Live conversion: the input editor's update listener calls this hook,
    // which stays a no-op until convertNow exists below.
    let onInputEdit: () => void = () => {};

    // Lazily load CodeMirror + the plate theme + the sibling engine + examples
    // (off the initial path so the ~200KB CM runtime code-splits into its own
    // chunk; the kit's cm-theme must load in this same closure).
    let engine: EngineModule;
    let examples: Example[] = [];
    let makeInputEditor: (host: HTMLElement, doc: string) => EditorView;
    let makeOutputEditor: (host: HTMLElement, doc: string, label: string) => EditorView;
    let setEditorDoc: (view: EditorView, doc: string) => void;
    try {
      const [
        { EditorState },
        { EditorView, keymap, lineNumbers, highlightActiveLine },
        { defaultKeymap, history, historyKeymap, indentWithTab },
        { plate },
        engineMod,
        examplesMod,
      ] = await Promise.all([
        import('@codemirror/state'),
        import('@codemirror/view'),
        import('@codemirror/commands'),
        import('../lib/playground-kit/cm-theme'),
        import('../lib/cron-systemd/engine'),
        import('../lib/cron-systemd/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);

      // Sizing only — colours, gutters and the focus ring come from the plate
      // theme and the EditorPane rule in global.css.
      const sizing = EditorView.theme({
        '&': { fontSize: '13px', maxHeight: '360px' },
        '.cm-scroller': { overflow: 'auto' },
      });

      makeInputEditor = (host: HTMLElement, doc: string): EditorView => {
        const state = EditorState.create({
          doc,
          extensions: [
            lineNumbers(),
            history(),
            highlightActiveLine(),
            plate,
            sizing,
            EditorView.lineWrapping,
            EditorView.contentAttributes.of({ 'aria-label': 'Crontab line' }),
            keymap.of([
              // Ours FIRST, so it wins over defaultKeymap's Enter.
              {
                key: 'Mod-Enter',
                run: (view) => {
                  void convertNow('run');
                  if (isCoarsePointer()) view.contentDOM.blur();
                  return true;
                },
              },
              { key: 'Escape', run: (view) => { view.contentDOM.blur(); return true; } },
              ...defaultKeymap,
              ...historyKeymap,
              indentWithTab,
            ]),
            EditorView.updateListener.of((u) => {
              if (u.docChanged) onInputEdit();
            }),
          ],
        });
        return new EditorView({ state, parent: host });
      };

      makeOutputEditor = (host: HTMLElement, doc: string, label: string): EditorView => {
        const state = EditorState.create({
          doc,
          extensions: [
            lineNumbers(),
            plate,
            sizing,
            EditorView.lineWrapping,
            EditorView.editable.of(false),
            EditorState.readOnly.of(true),
            EditorView.contentAttributes.of({ 'aria-label': label }),
          ],
        });
        return new EditorView({ state, parent: host });
      };

      setEditorDoc = (view: EditorView, doc: string): void => {
        view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: doc } });
      };
    } catch (err) {
      renderError(
        notesBox,
        summaryEl,
        'The converter engine failed to load. Reload the page to try again.'
      );
      // eslint-disable-next-line no-console
      console.error('[CronToSystemd] engine/examples import failed:', err);
      return;
    }

    // Seed priority: #cron= deep link (shared with cron-expression-tester —
    // same key, free interop) > restored last input > first example.
    const hashValue = hashState.read();
    const restored = getRestoredLastInput(SLUG);
    const seed = examples[0];
    const inputView = makeInputEditor(inputHost, hashValue ?? restored ?? seed?.cron ?? '');
    const timerView = makeOutputEditor(timerHost, '', 'Generated systemd timer unit');
    const serviceView = makeOutputEditor(serviceHost, '', 'Generated systemd service unit');
    // The build-time text stand-ins have done their job (no-JS visitors and
    // crawlers); CodeMirror appended its editors beside them, so drop them.
    // The hash/restore tiers above already chose the document.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());

    // The example chips are server-rendered (ExampleChips); wire them by index.
    // A deep-linked or restored input matches no example: no chip pressed.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));
    syncChipsByIndex(chipsWrap, hashValue || restored || !examples.length ? null : 0);
    if (!examples.length) {
      chips.forEach((chip) => {
        chip.disabled = true;
      });
    }

    /** Current sanitised unit base name, defaulting to "cron-job". */
    function unitBase(): string {
      return sanitiseUnitName(unitInput!.value) || 'cron-job';
    }

    /** Sync the unit-file names to the chosen unit name. */
    function syncNames(): void {
      const base = unitBase();
      if (timerNameEl) timerNameEl.textContent = `${base}.timer`;
      if (serviceNameEl) serviceNameEl.textContent = `${base}.service`;
    }
    syncNames();

    function hideActions(): void {
      for (const btn of [shareBtn!, copyAllBtn!, copyTimerBtn!, copyServiceBtn!]) {
        btn.hidden = true;
        btn.dataset.copy = '';
      }
    }

    /** Clear the outputs after a failed conversion. */
    function clearOutput(): void {
      setEditorDoc(timerView, '');
      setEditorDoc(serviceView, '');
      hideActions();
      onCalendarEl!.textContent = '—';
    }

    // ── Conversion ───────────────────────────────────────────────────────────
    let timer: number | undefined;
    let running = false;
    let queued: Source | null = null;

    async function convertNow(source: Source): Promise<void> {
      window.clearTimeout(timer);
      // Guaranteed present by the early return above; restated because
      // TypeScript discards that narrowing inside a hoisted function declaration.
      if (!convertBtn) return;
      if (running) {
        queued = source;
        return;
      }
      running = true;
      const explicit = source === 'run';
      if (explicit) {
        convertBtn.classList.add('is-busy');
        convertBtn.setAttribute('aria-busy', 'true');
        // Yield so the busy state paints before the work runs.
        await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
      }

      try {
        const cronLine = inputView.state.doc.toString();
        if (cronLine.trim().length === 0) {
          clearOutput();
          renderEmpty(notesBox!, summaryEl!);
          return;
        }
        const result = await Promise.resolve(engine.convert(cronLine, { unitName: unitBase() }));

        if (!result || result.valid === false || result.error) {
          clearOutput();
          renderError(notesBox!, summaryEl!, result?.error ?? 'This crontab line could not be parsed.');
          return;
        }

        const timerUnit = typeof result.timerUnit === 'string' ? result.timerUnit : '';
        const serviceUnit = typeof result.serviceUnit === 'string' ? result.serviceUnit : '';
        setEditorDoc(timerView, timerUnit);
        setEditorDoc(serviceView, serviceUnit);
        onCalendarEl!.textContent = onCalendarText(result);
        const notes = Array.isArray(result.notes)
          ? result.notes.filter((note): note is string => typeof note === 'string' && note.length > 0)
          : [];
        renderNotes(notesBox!, summaryEl!, notes);

        const base = unitBase();
        copyTimerBtn!.dataset.copy = timerUnit;
        copyTimerBtn!.hidden = timerUnit.length === 0;
        copyServiceBtn!.dataset.copy = serviceUnit;
        copyServiceBtn!.hidden = serviceUnit.length === 0;
        copyAllBtn!.dataset.copy = `# ${base}.timer\n${timerUnit}\n\n# ${base}.service\n${serviceUnit}`;
        copyAllBtn!.hidden = false;
        shareBtn!.dataset.copy =
          location.origin + location.pathname + location.search + buildHashValue('cron', cronLine.trim());
        shareBtn!.hidden = false;

        if (source !== 'seed') recordToolLastInput(SLUG, cronLine);
        // Re-measure the now-populated read-only editors next frame.
        requestAnimationFrame(() => {
          timerView.requestMeasure();
          serviceView.requestMeasure();
        });
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Unexpected error while converting.';
        clearOutput();
        renderError(notesBox!, summaryEl!, msg);
      } finally {
        running = false;
        convertBtn.classList.remove('is-busy');
        convertBtn.removeAttribute('aria-busy');
        if (queued) {
          const next = queued;
          queued = null;
          void convertNow(next);
        }
      }
    }

    function schedule(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => void convertNow('type'), DEBOUNCE_MS);
    }

    // Typing in the editor: no example is on screen any more; convert live.
    onInputEdit = () => {
      clearChips(chipsWrap);
      schedule();
    };

    // Choosing an example swaps the input and converts it at once. The doc
    // write fires the update listener (which releases every chip), so the
    // chip is pressed again after it.
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        setEditorDoc(inputView, examples[idx].cron);
        syncChipsByIndex(chipsWrap, idx);
        void convertNow('run');
      });
    });

    // The unit bodies embed the unit name, so renaming re-converts (live).
    unitInput.addEventListener('input', () => {
      syncNames();
      schedule();
    });
    wireRunKeys(unitInput, () => void convertNow('run'));

    convertBtn.addEventListener('click', () => void convertNow('run'));

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => inputView.state.doc.toString(),
      setValue: (value) => {
        setEditorDoc(inputView, value);
        clearChips(chipsWrap);
        void convertNow('run');
      },
    });

    // Convert whatever the editor ended up holding — a #cron= deep link (from
    // cron-expression-tester's share link), a restored last input, or the
    // seeded example — so the panel is never empty on arrival. A seed run
    // never records the last input.
    void convertNow('seed');
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
