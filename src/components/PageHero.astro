---
/**
 * PageHero — the one page masthead for hubs and (from batch D) tool pages.
 *
 * One left-aligned stack ON THE RAIL: every child hangs from the
 * `container-page` left edge; a block may set a measure (`measure-prose`,
 * `measure-wide`) but never centres itself (no `mx-auto`, no `text-center`),
 * so the hero, the sections under it and the footer share one edge.
 *
 *   breadcrumb   optional slot `breadcrumb` (a tool page's crumb trail + LD
 *                stays in its owner; this only places it)
 *   eyebrow      optional prop, the L1 label role
 *   H1           the default slot, `display-lg` — the text is passed through
 *                untouched, so adopting this component never changes an H1
 *   lede         optional slot `lede`, `body-md` on `measure-prose`
 *   meta         optional slot `meta`: the trust line, a `<time>` caption,
 *                a count
 *   after        optional slot `after`: what the hero hands off to (a CTA,
 *                a tag row, a transcript), still on the rail
 *   backdrop     optional slot `backdrop`: decorative layers drawn behind the
 *                container (absolutely positioned by the caller); pass
 *                `class="relative isolate overflow-hidden"` with it
 *
 * `variant="hub"` takes section-scale padding; `variant="tool"` keeps the tight
 * tool masthead (the instrument directly under it must stay in the first
 * viewport). Created 2026-10-02 (batch A); batch B4 moved the hubs onto it
 * (/learn, /tests, /mission-90, /blog, /blog/tag/*, InfoPage), batch D renders
 * ToolHero through it.
 *
 * Usage:
 *   <PageHero variant="hub" eyebrow="Learn">
 *     Learn DevOps: free roadmaps and hands-on guides.
 *     <Fragment slot="lede">Start with…</Fragment>
 *   </PageHero>
 */
export interface Props {
  variant?: 'hub' | 'tool';
  /** L1 eyebrow above the H1. */
  eyebrow?: string;
  /** Extra classes for the outer <section> (background, borders). */
  class?: string;
}

const { variant = 'hub', eyebrow, class: className } = Astro.props;
const hasBreadcrumb = Astro.slots.has('breadcrumb');
const hasLede = Astro.slots.has('lede');
const hasMeta = Astro.slots.has('meta');
const hasAfter = Astro.slots.has('after');
---

<section
  class:list={[
    'page-hero',
    // A caller that passes a section-pad* utility owns the vertical rhythm;
    // stacking both would leave the winner to CSS source order.
    /\bsection-pad/.test(className ?? '') ? null : variant === 'tool' ? 'py-4 sm:py-10' : 'py-12 sm:py-16',
    className,
  ]}
  data-page-hero={variant}
>
  <slot name="backdrop" />
  <div class="container-page relative">
    {
      hasBreadcrumb && (
        <div class="mb-4 text-sm text-mute">
          <slot name="breadcrumb" />
        </div>
      )
    }
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class:list={['display-lg measure-wide text-balance text-ink', eyebrow && 'mt-3']}>
      <slot />
    </h1>
    {
      hasLede && (
        <p class="body-md measure-prose mt-3 text-pretty text-body">
          <slot name="lede" />
        </p>
      )
    }
    {
      hasMeta && (
        <div class="caption mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-mute">
          <slot name="meta" />
        </div>
      )
    }
    {hasAfter && <slot name="after" />}
  </div>
</section>
