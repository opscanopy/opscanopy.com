---
/**
 * CopyButton — the labelled copy control of the result toolbar (Copy link,
 * Copy all, Copy as …). Plan "Batch C".
 *
 * Hooks, which src/lib/playground-kit/copy.ts and Layout.astro's
 * `result_copied` analytics listener key on:
 *   - `data-copy`       the payload (set by the island on the live element —
 *                       multi-line and quote-bearing payloads round-trip badly
 *                       through server-rendered attributes);
 *   - `data-copy-link`  on the share button (kind="link");
 *   - `data-copy-all`   on the whole-result button (kind="all");
 *   - `data-copy-icon` / `data-check-icon` / `data-copy-text` inside, swapped
 *     by copy.ts on success; `data-copy-label` is the resting label text.
 *
 * Rendered `hidden` by default: the island unhides it once a valid result
 * exists, so a Copy link never points at nothing.
 *
 * Markup only: no <script> (the gate's kit-purity rule).
 */
export interface Props {
  /** `link` → data-copy-link, `all` → data-copy-all, `value` → plain data-copy. */
  kind: 'link' | 'all' | 'value';
  id?: string;
  /** Visible label; defaults per kind. */
  label?: string;
  icon?: 'link' | 'copy' | 'markdown';
  /** Start hidden (default true). */
  hidden?: boolean;
  ariaLabel?: string;
  class?: string;
}

const DEFAULT_LABEL = { link: 'Copy link', all: 'Copy all', value: 'Copy' } as const;
const DEFAULT_ICON = { link: 'link', all: 'copy', value: 'copy' } as const;

const { kind, id, label = DEFAULT_LABEL[kind], icon = DEFAULT_ICON[kind], hidden = true, ariaLabel, class: className } = Astro.props;
---

<button
  id={id}
  type="button"
  class:list={['copy-btn copy-btn--labeled', className]}
  data-copy=""
  data-copy-link={kind === 'link' ? '' : undefined}
  data-copy-all={kind === 'all' ? '' : undefined}
  data-copy-label={label}
  aria-label={ariaLabel}
  hidden={hidden}
>
  <svg class="copy-btn__icon" data-copy-icon width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {
      icon === 'link' ? (
        <>
          <path d="M6.75 9.25l2.5-2.5" />
          <path d="M8.75 4.25l1.5-1.5a2.47 2.47 0 0 1 3.5 3.5l-1.5 1.5" />
          <path d="M7.25 11.75l-1.5 1.5a2.47 2.47 0 0 1-3.5-3.5l1.5-1.5" />
        </>
      ) : icon === 'markdown' ? (
        <>
          <path d="M2.5 4.5h11v7h-11z" />
          <path d="M4.5 10V6l1.75 2L8 6v4" />
          <path d="M9.75 6.5v3.25M9.75 9.75l1.25-1.25M9.75 9.75l-1.25-1.25" />
        </>
      ) : (
        <>
          <rect x="5" y="5" width="9" height="9" rx="1.5" />
          <path d="M3 11H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v1" />
        </>
      )
    }
  </svg>
  <svg class="copy-btn__icon hidden" data-check-icon width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 8.5l3.5 3.5L13 4.5" />
  </svg>
  <span class="copy-btn__label" data-copy-text>{label}</span>
</button>
