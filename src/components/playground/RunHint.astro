---
/**
 * RunHint — the one sentence that tells a visitor how the playground runs.
 * Plan "Batch C"; the wording is the UX contract's (CLAUDE.md).
 *
 *   variant="live"  single-line / textarea tools (wireRunKeys):
 *                   "Results update as you type — press Enter to run now."
 *   variant="cm"    CodeMirror tools: ⌘/Ctrl + Enter runs (a plain Enter is a
 *                   newline in an editor), Esc releases the editor's Tab trap.
 *
 * Always on paper, under the input — never inside the result slab. The key
 * caps are the global `.kbd` (the header search hint uses the same one).
 *
 * Markup only: no <script> (the gate's kit-purity rule).
 */
export interface Props {
  variant?: 'live' | 'cm';
  id?: string;
  class?: string;
}

const { variant = 'live', id, class: className } = Astro.props;
---

<p id={id} class:list={['run-hint caption text-mute', className]} data-run-hint={variant}>
  {
    variant === 'cm' ? (
      <>
        Results update as you type — press <kbd class="kbd">⌘/Ctrl</kbd> + <kbd class="kbd">Enter</kbd> to run now. Press{' '}
        <kbd class="kbd">Esc</kbd> to release the editor.
      </>
    ) : (
      'Results update as you type — press Enter to run now.'
    )
  }
</p>
