---
/**
 * SnapshotBar — Save snapshot / load / delete, on paper (never inside a slab).
 * Plan "Batch C".
 *
 * The ids keep the `#<prefix>-snap-save|select|delete` convention, so the
 * islands' `wireSnapshotUI` calls (src/lib/tool-state/wire.ts) need no
 * selector churn. The picker is server-rendered `hidden` and stays hidden
 * until a snapshot exists — wire.ts sets `select.hidden = snaps.length === 0`
 * on every render — so a first visit shows one quiet button, not a disabled
 * "No snapshots yet" menu.
 *
 * Markup only: no <script> (the gate's kit-purity rule).
 */
export interface Props {
  prefix: string;
  class?: string;
}

const { prefix, class: className } = Astro.props;
---

<div class:list={['snapshot-bar', className]} data-snapshot-bar>
  <button id={`${prefix}-snap-save`} type="button" class="btn-tool">Save snapshot</button>
  <select id={`${prefix}-snap-select`} class="snapshot-bar__select" aria-label="Load a saved snapshot" disabled hidden>
    <option value="">No snapshots yet</option>
  </select>
  <button id={`${prefix}-snap-delete`} type="button" class="snapshot-bar__delete" aria-label="Delete this snapshot" hidden>&times;</button>
</div>
