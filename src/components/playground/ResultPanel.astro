---
/**
 * ResultPanel — the L2 instrument every tool's answer sits on (plan "Batch C").
 *
 *   <ResultPanel slug="subnet-calculator" prefix="snc" summary={seedSummary} split>
 *     <Fragment slot="actions"><CopyButton kind="link" id="snc-share" /></Fragment>
 *     <div id="snc-results" class="snc-results" set:html={seedHtml} data-results></div>
 *   </ResultPanel>
 *
 * Renders, dark in both themes:
 *   - a FigureCap `fig. NN — <slug> · <category>` (tone="traffic"). NN is the
 *     tool's registry index, computed HERE from `getTool(slug)` +
 *     `tools.indexOf`, so no island imports tools.ts; an unknown slug THROWS
 *     at build — a wrong slug would otherwise ship a silent "fig. 00".
 *     `split` wraps the ` · category` tail in `.figcap__sub` (hidden < 480px);
 *   - in the cap's actions slot, the ONE live region: `#<prefix>-summary`,
 *     `role="status"`, `data-status`, seeded with `summary`;
 *   - a toolbar row: the `Result` eyebrow in slab leaf + the `actions` slot
 *     (CopyButtons);
 *   - the default slot: the playground's own results container. It stays in
 *     the playground (`set:html={seedHtml} data-results`) so the SSR source
 *     and the seeded HTML are untouched, and it is NOT a live region;
 *   - `#<prefix>-copy-status`, the sr-only copy announcer copy.ts writes.
 *
 * Styling: `.result-panel*` in global.css (@layer components). A child
 * component's root does not inherit the parent's `data-astro-cid`, so a
 * playground's slab overrides anchor on `.<prefix>-results :global(...)`
 * (its own container), never on this wrapper.
 *
 * Markup only: no <script> (the gate's kit-purity rule).
 */
import FigureCap from '../FigureCap.astro';
import { getTool, tools } from '../../data/tools';

export interface Props {
  /** Registry slug (src/data/tools.ts). Unknown slugs fail the build. */
  slug: string;
  /** Tool prefix: ids are `<prefix>-summary` and `<prefix>-copy-status`. */
  prefix: string;
  /** Server-rendered summary text (the seeded example's one-line verdict). */
  summary?: string;
  /** Eyebrow over the result. */
  label?: string;
  /** Split the figure label's ` · category` tail (hidden < 480px). */
  split?: boolean;
  /** Extra classes on the summary span (e.g. a tool's nowrap). */
  summaryClass?: string;
  class?: string;
}

const { slug, prefix, summary = '', label = 'Result', split = false, summaryClass, class: className } = Astro.props;

const tool = getTool(slug);
if (!tool) throw new Error(`ResultPanel: no tool "${slug}" in src/data/tools.ts — the figure number would be wrong`);
const figNo = String(tools.indexOf(tool) + 1).padStart(2, '0');
const figLabel = `${tool.slug} · ${tool.category.toLowerCase()}`;
---

<div class:list={['result-panel instrument-flush', className]} data-result-panel>
  <FigureCap fig={figNo} label={figLabel} tone="traffic" split={split}>
    <span
      id={`${prefix}-summary`}
      class:list={['result-panel__summary code-mono text-inverse-mute', summaryClass]}
      role="status"
      aria-live="polite"
      data-status
    >{summary}</span>
  </FigureCap>
  <div class="result-panel__body">
    <div class="result-panel__bar">
      <span class="eyebrow !text-inverse-brand">{label}</span>
      {Astro.slots.has('actions') && (
        <span class="result-panel__actions">
          <slot name="actions" />
        </span>
      )}
    </div>
    <slot />
    <span id={`${prefix}-copy-status`} class="result-panel__copy-status sr-only" role="status" aria-live="polite"></span>
  </div>
</div>
