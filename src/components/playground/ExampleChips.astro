---
/**
 * ExampleChips — the example picker every playground shares (plan "Batch C").
 *
 * Renders `[data-chips]` holding one `button.chip` per example, server-side,
 * so the row works without JS and the island adopts it rather than building
 * it. The selected state IS `aria-pressed` (global.css draws
 * `.chip[aria-pressed='true']`; src/lib/playground-kit/chips.ts keeps it in
 * step); hover is deliberately a different look, so a hovered chip never
 * reads as the selected one.
 *
 * Each chip carries `data-example-idx` (its index) and, when the example has
 * one, `data-input` (the value it loads) — the two keys the islands already
 * use, so no selector churn. An item's `data` map adds further `data-*`
 * attributes (`{ mode: 'decode' }` → `data-mode="decode"`) for tools whose
 * examples carry more than one value; keys are written as given, so use the
 * attribute spelling (`'example-kind'`, not `exampleKind`).
 *
 * Usage:
 *   <ExampleChips prefix="snc" items={examples.map((e) => ({ label: e.label, input: e.input, ariaLabel: `${e.label} — ${e.input}` }))} active={0} ariaLabel="Examples" />
 *
 * Markup only: no <script> (the gate's kit-purity rule).
 */
export interface ChipItem {
  label: string;
  /** Value the chip loads; emitted as `data-input` when present. */
  input?: string;
  /** Accessible name when the visible label alone is ambiguous. */
  ariaLabel?: string;
  /** Extra `data-*` attributes: `{ mode: 'decode' }` renders `data-mode="decode"`. */
  data?: Record<string, string>;
}

export interface Props {
  /** Tool prefix; the row's id is `<prefix>-chips`. */
  prefix: string;
  items: ChipItem[];
  /** Index of the initially pressed chip (the seeded example); null for none. */
  active?: number | null;
  /** Group name, unless `labelledby` points at a visible label. */
  ariaLabel?: string;
  labelledby?: string;
  /** Override the row id (defaults to `<prefix>-chips`). */
  id?: string;
  class?: string;
}

const { prefix, items, active = 0, ariaLabel, labelledby, id, class: className } = Astro.props;

/** `{ mode: 'x' }` → `{ 'data-mode': 'x' }`; the two reserved keys stay the props' own. */
const dataAttrs = (data: Record<string, string> | undefined) =>
  Object.fromEntries(
    Object.entries(data ?? {})
      .filter(([k]) => k !== 'input' && k !== 'example-idx')
      .map(([k, v]) => [`data-${k}`, v]),
  );
---

<div
  id={id ?? `${prefix}-chips`}
  class:list={['chips', className]}
  role="group"
  aria-label={labelledby ? undefined : (ariaLabel ?? 'Examples')}
  aria-labelledby={labelledby}
  data-chips
>
  {
    items.map((item, i) => (
      <button
        type="button"
        class="chip"
        data-example-idx={String(i)}
        data-input={item.input}
        aria-label={item.ariaLabel}
        aria-pressed={i === active ? 'true' : 'false'}
        {...dataAttrs(item.data)}
      >
        {item.label}
      </button>
    ))
  }
</div>
