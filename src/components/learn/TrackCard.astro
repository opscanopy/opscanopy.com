---
/**
 * TrackCard — one learning track on /learn (a stretched-link card).
 *
 * Flat Field Manual header (batch B4): a `canvas-soft-2` band over a hairline,
 * the track's line icon in brand-strong ink and the card's figure numeral
 * (`01`, `02` … its position on the page) in amber mono — figure numbers are
 * one of amber's four legal jobs. No accent gradients, no off-palette hexes:
 * the level dot reads leaf / amber / violet from the theme tokens.
 *
 * `index` turns on the hub rules: the figure numeral and "counts only when
 * >= 2" (a lone "1 guide" says nothing). The homepage renders TrackCard
 * WITHOUT `index` — its markup is frozen during the 2026-09-30 H1 experiment
 * read, so it keeps a numeral-free header and its "1 guide" text; batch E
 * passes `index` there and the two converge.
 *
 * The <h3><a> is the only link; its text is the track name and never changes.
 * The "View roadmap" / "Read guide" line is a `.link-cta` label (the arrow is
 * the class's ::after), not a second link.
 */
import Badge from '../Badge.astro';
import Card from '../Card.astro';
import type { Track } from '../../data/learn';
import { trackIcon } from '../../data/track-icons';

interface Props { track: Track; index?: number; guideCount: number; difficulty?: string; minutes?: number; }
const { track, index, guideCount, difficulty, minutes } = Astro.props;
const href = track.roadmapSlug
  ? `/learn/roadmaps/${track.roadmapSlug}/`
  : (track.guideSlugs[0] ? `/learn/guides/${track.guideSlugs[0]}/` : '/learn/');

const icon = trackIcon(track.slug);
const figNo = index === undefined ? null : String(index + 1).padStart(2, '0');
const showCount = index === undefined || guideCount >= 2;

const levelColor: Record<string, string> = {
  beginner: 'var(--color-brand)',
  intermediate: 'var(--color-accent-ink)',
  advanced: 'var(--color-violet)',
};
const timeLabel = minutes ? (minutes >= 60 ? `~${Math.round(minutes / 60)}h` : `~${minutes}m`) : null;
---
<li class="h-full" id={track.slug} data-track={track.slug}>
  <Card class="card-interactive group relative flex h-full flex-col overflow-hidden">
    <div
      class="relative -mx-6 -mt-6 mb-5 flex h-24 items-center justify-center border-b border-hairline bg-canvas-soft-2 text-brand-strong"
      aria-hidden="true"
    >
      {figNo && <span class="code-mono absolute left-4 top-3 text-[12px] font-medium text-accent-ink">{figNo}</span>}
      <svg
        width="48" height="48" viewBox="0 0 48 48" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        class="transition-transform duration-200 ease-out group-hover:scale-105 motion-reduce:transform-none"
      ><Fragment set:html={icon} /></svg>
    </div>
    <div class="flex items-start justify-between gap-3">
      <h3 class="display-sm text-ink">
        <a href={href} class="rounded-sm outline-none after:absolute after:inset-0 after:content-['']">{track.name}</a>
      </h3>
      {track.startHere && <Badge variant="new" class="shrink-0">Start here</Badge>}
    </div>
    <p class="body-sm mt-2 text-pretty text-body">{track.tagline}</p>
    <div class="mt-3 flex flex-wrap items-center gap-1.5">
      {difficulty && (
        <span class="badge normal-case">
          <span class="size-1.5 rounded-full" style={`background:${levelColor[difficulty] ?? 'var(--color-mute)'}`} aria-hidden="true"></span>
          {difficulty}
        </span>
      )}
      {timeLabel && <span class="badge normal-case">{timeLabel}</span>}
      {showCount && <span class="badge normal-case">{guideCount} guide{guideCount === 1 ? '' : 's'}</span>}
    </div>
    <div class="mt-auto pt-5">
      <span class="link-cta body-sm">{track.roadmapSlug ? 'View roadmap' : 'Read guide'}</span>
    </div>
  </Card>
</li>
