---
/**
 * OpsCanopy logo MARK — the canopy glyph alone, without the wordmark.
 *
 * Three nested sheltering arcs over a slender trunk, drawn in `currentColor`
 * so the consumer picks the ink (`text-brand` on paper in Logo.astro,
 * `text-inverse-brand` on the colophon slab). Decorative: always aria-hidden,
 * because every consumer names the brand elsewhere (Logo's aria-label, the
 * colophon's figure cap).
 *
 * Logo.astro composes this, so the lockup and the bare mark can never drift.
 * The markup below is exactly what Logo rendered inline until 2026-09-27 —
 * keep it byte-stable (the class is the only thing a consumer varies).
 */
interface Props {
  /** Classes for the <svg> itself (sizing + colour), e.g. "h-6 w-auto text-brand". */
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
    class={className}
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <!-- Three nested sheltering arcs read as a canopy, drawn at one weight and
         one opacity (the CanopyField texture is where the arcs graduate).
         Centred on x=16 and optically balanced in the 32 box. -->
    <g
      stroke="currentColor"
      stroke-width="2.75"
      stroke-linecap="square"
      stroke-linejoin="miter"
    >
      <path d="M4 15.5C6.4 10.3 10.8 7 16 7s9.6 3.3 12 8.5" />
      <path d="M6.5 19.5C8.6 15.2 11.9 12.7 16 12.7s7.4 2.5 9.5 6.8" />
      <path d="M9 23C10.6 19.9 13.1 18.2 16 18.2s5.4 1.7 7 4.8" />
    </g>
    <!-- Slender trunk grounding the canopy, centred on the same axis. -->
    <path
      d="M16 23v3.6"
      stroke="currentColor"
      stroke-width="2.75"
      stroke-linecap="square"
    />
  </svg>
