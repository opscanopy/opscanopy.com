---
/**
 * Base64Playground — the interactive Base64 Encoder / Decoder island.
 *
 * A bespoke input -> output converter (not a rows table): type or paste text /
 * base64, flip the Encode|Decode toggle and the URL-safe switch, and the result
 * renders live (debounced). The body is a single input textarea above the
 * result instrument, which carries the encoded / decoded text and its Copy
 * button.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar, ResultPanel (figure cap, live summary, copy status)
 * and CopyButton. The results container stays here, seeded with
 * `set:html` + `data-results`; its slab overrides anchor on `.b64-output`
 * (the container's own class, kept so the seeded markup is unchanged).
 *
 * Runtime contract (lazy-imported):
 *   ../lib/base64-codec/engine →
 *     convert(input: string, mode: 'encode' | 'decode', urlSafe: boolean)
 *       => { valid: boolean; error?: string; output: string; bytes?: number; note?: string }
 *   ../lib/base64-codec/examples →
 *     examples: { id; label; input; mode: 'encode' | 'decode'; urlSafe: boolean }[]
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. The script never
// rebuilds them — it only reads each chip's `data-example-idx` into the lazily
// imported array — so this adds nothing to the client bundle and cannot drift.
import { examples as prerenderedExamples } from '../lib/base64-codec/examples';
import { convert } from '../lib/base64-codec/engine';
import { resultHtml, summaryText, EMPTY_HTML } from '../lib/base64-codec/render';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-computes the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees a real worked answer
 * instead of an empty "type something here" panel. The mode segment, the
 * URL-safe switch and the input/output labels are set exactly as the client's
 * `applyMode(seed.mode)` would set them.
 *
 * `convert` is pure and synchronous, so it runs at build time unchanged.
 */
const seedExample = prerenderedExamples[0];
const seedResult = seedExample
  ? convert(seedExample.input, seedExample.mode, seedExample.urlSafe)
  : null;
const seedValid = !!(seedResult && seedResult.valid);
const seedHtml = seedValid && seedResult ? resultHtml(seedResult, seedExample.input) : EMPTY_HTML;
const seedSummary = seedValid && seedResult ? summaryText(seedResult) : '';
const seedEncoding = (seedExample?.mode ?? 'encode') === 'encode';
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="b64-pg" aria-label="Base64 encoder and decoder playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: example chips + mode toggle + url-safe switch ───────── */}
    <div
      class="flex flex-col gap-3 border-b border-hairline px-4 py-3 sm:flex-row sm:items-end sm:justify-between sm:px-5"
    >
      <div class="flex min-w-0 flex-col gap-2">
        <span class="eyebrow shrink-0">Example</span>
        {/* Server-rendered so the examples are in the static HTML; the
            hydration script only wires clicks onto these buttons. */}
        <ExampleChips prefix="b64" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
      </div>

      <div class="flex shrink-0 flex-wrap items-center gap-4">
        <div
          id="b64-mode"
          class="b64-seg"
          role="group"
          aria-label="Direction"
        >
          <button
            type="button"
            class="b64-seg__btn"
            aria-pressed={seedEncoding ? 'true' : 'false'}
            data-mode="encode"
          >
            Encode
          </button>
          <button
            type="button"
            class="b64-seg__btn"
            aria-pressed={seedEncoding ? 'false' : 'true'}
            data-mode="decode"
          >
            Decode
          </button>
        </div>

        <label class="b64-check" for="b64-urlsafe">
          <input
            id="b64-urlsafe"
            type="checkbox"
            class="b64-check__box"
            autocomplete="off"
            checked={seedExample?.urlSafe === true}
          />
          <span class="b64-check__label">URL-safe</span>
        </label>
      </div>
    </div>

    {/* ── Input ────────────────────────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <div class="mb-2 flex items-center justify-between gap-3">
        <label id="b64-input-label" class="eyebrow" for="b64-input"
          >{seedEncoding ? 'Text to encode' : 'Base64 to decode'}</label
        >
        <button
          id="b64-clear"
          type="button"
          class="btn-tool"
          aria-label="Clear input"
        >Clear</button>
      </div>
      <textarea
        id="b64-input"
        class="b64-input code-mono"
        spellcheck="false"
        autocapitalize="off"
        autocorrect="off"
        autocomplete="off"
        rows="4"
        placeholder={seedEncoding ? 'hello world' : 'aGVsbG8gd29ybGQ='}
        aria-describedby="b64-input-hint b64-run-hint">{seedExample?.input}</textarea>
      <p id="b64-input-hint" class="b64-hint caption text-mute">
        UTF-8 safe both ways. Decoding accepts standard <span class="code-mono">+/</span> or url-safe
        <span class="code-mono">-_</span> alphabets, with or without <span class="code-mono">=</span>
        padding; whitespace is ignored.
      </p>
      <RunHint id="b64-run-hint" />
      <SnapshotBar prefix="b64" />
    </div>

    {/* ── Output — the L2 instrument (dark in both themes) under its figure
        cap; the byte count reads out in the cap's actions slot. ───────── */}
    <ResultPanel
      slug="base64-encoder-decoder"
      prefix="b64"
      summary={seedSummary}
      label={seedEncoding ? 'Base64' : 'Decoded text'}
      summaryClass="whitespace-nowrap"
      split
    >
      <Fragment slot="actions">
        <CopyButton
          kind="all"
          id="b64-copy"
          label="Copy"
          ariaLabel={seedEncoding ? 'Copy base64' : 'Copy decoded text'}
        />
      </Fragment>
      <p class="caption text-inverse-mute mb-3">No share links on this tool — inputs may be secrets.</p>
      {/* Seeded at build time (see `seedHtml` above) so the encoded answer is
          in the static HTML; the script re-renders it into this same node. */}
      <div id="b64-output" class="b64-output" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* Segmented Encode | Decode toggle — the pressed state IS aria-pressed. */
  .b64-seg {
    display: inline-flex;
    padding: 2px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }
  .b64-seg__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 76px;
    height: var(--control-h-sm);
    padding: 0 14px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-mute);
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
    transition:
      color var(--dur-fast) var(--ease-brand),
      background-color var(--dur-fast) var(--ease-brand),
      box-shadow var(--dur-fast) var(--ease-brand);
  }
  .b64-seg__btn:hover:not([aria-pressed='true']) {
    color: var(--color-body);
  }
  .b64-seg__btn[aria-pressed='true'] {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
  }
  .b64-seg__btn:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
  @media (pointer: coarse) {
    .b64-seg__btn {
      min-height: var(--control-h-lg);
    }
  }

  /* URL-safe checkbox. */
  .b64-check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    user-select: none;
  }
  .b64-check__box {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    accent-color: var(--color-brand);
    cursor: pointer;
  }
  .b64-check__box:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
  .b64-check__label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-body);
  }

  /* Input textarea. */
  .b64-input {
    width: 100%;
    min-height: 108px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 14px;
    line-height: 22px;
    resize: vertical;
    word-break: break-word;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .b64-input::placeholder {
    color: var(--color-mute);
  }
  .b64-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .b64-input:focus {
    outline: none;
  }
  .b64-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .b64-input.b64-input--error {
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  .b64-input.b64-input--error:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-error);
  }
  .b64-hint {
    margin-top: 8px;
    text-wrap: pretty;
  }

  .b64-output {
    min-height: 64px;
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.b64-output` container (the panel
     wrapper is ResultPanel's and carries no scope attribute). */
  :global(.b64-result) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: b64-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.b64-result__body) {
    margin: 0;
    padding: 12px 14px;
    max-height: 320px;
    overflow: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink);
    white-space: pre-wrap;
    word-break: break-all;
    overflow-wrap: anywhere;
  }
  :global(.b64-result__body.is-empty-text) {
    color: var(--color-mute);
    font-style: italic;
    word-break: normal;
  }
  :global(.b64-result__meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    padding: 8px 14px;
    border-top: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    color: var(--color-mute);
  }
  :global(.b64-result__note) {
    color: var(--color-brand-strong);
  }

  @keyframes b64-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.b64-result) {
      animation: none;
    }
  }

  :global(.b64-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.b64-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.b64-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.b64-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.b64-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* Hand-off buttons ("Decode as JWT →", "Hash this text →") under the
     result. render.ts emits them as `<button data-handoff-to>` in a
     `-chips` row; global.css lays the row out and draws the LINK form
     (`a[class$='-chip']`), so the button form takes the same slab chip
     recipe here, keyed on its hook rather than its render.ts class. */
  .b64-output :global(button[data-handoff-to]) {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h-sm);
    padding: 4px 12px;
    border: none;
    border-radius: var(--radius-pill);
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-inverse-brand);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      box-shadow var(--dur-fast) var(--ease-brand);
  }
  .b64-output :global(button[data-handoff-to]:hover) {
    background: #ffffff14;
    box-shadow: inset 0 0 0 1px var(--color-inverse-control-edge);
  }
  .b64-output :global(button[data-handoff-to]:focus-visible) {
    outline: 2px solid var(--color-inverse-brand);
    outline-offset: 1px;
  }
  @media (pointer: coarse) {
    .b64-output :global(button[data-handoff-to]) {
      min-height: var(--control-h-lg);
    }
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below it uses the slab ink tier; the light rules
     above remain the documented defaults. ──────────────────────────────── */
  .b64-output :global(.b64-empty) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .b64-output :global(.b64-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .b64-output :global(.b64-result) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .b64-output :global(.b64-result__body) {
    color: var(--color-inverse-fg);
  }
  .b64-output :global(.b64-result__body.is-empty-text) {
    color: var(--color-inverse-mute);
  }
  .b64-output :global(.b64-result__meta) {
    border-top-color: var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .b64-output :global(.b64-result__note) {
    color: var(--color-inverse-brand);
  }
</style>

<script>
  import { resultHtml, errorHtml, summaryText, EMPTY_HTML } from '../lib/base64-codec/render';
  import { wireRunKeys } from '../lib/run-keys';
  import { writeHandoff, readHandoffOnce } from '../lib/tool-state/handoff';
  import { wireSnapshotUI } from '../lib/tool-state/wire';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import type { Base64Result } from '../lib/base64-codec/types';

  type Mode = 'encode' | 'decode';
  type Result = Base64Result;
  type Example = { id: string; label: string; input: string; mode: Mode; urlSafe: boolean };
  type EngineModule = { convert: (input: string, mode: Mode, urlSafe: boolean) => Result };

  const ROOT_SEL = '.b64-pg';
  const DEBOUNCE_MS = 140;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.b64Wired === 'true') return;
      root.dataset.b64Wired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          input: typeof o.input === 'string' ? o.input : '',
          mode: o.mode === 'decode' ? 'decode' : 'encode',
          urlSafe: o.urlSafe === true,
        } satisfies Example;
      })
      .filter((e) => e.input.length > 0);
  }

  /** The hand-off chips carry bare paths (see render.ts); localize on click. */
  function localePath(p: string): string {
    const m = window.location.pathname.match(/^\/(de|es|fr|pt-br)\//);
    return m ? `/${m[1]}${p}` : p;
  }

  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  async function init(root: HTMLElement): Promise<void> {
    const input = el<HTMLTextAreaElement>(root, '#b64-input');
    const inputLabel = el<HTMLElement>(root, '#b64-input-label');
    const outputLabel = el<HTMLElement>(root, '[data-result-panel] .result-panel__bar > .eyebrow');
    const chipsWrap = el<HTMLElement>(root, '#b64-chips');
    const modeGroup = el<HTMLElement>(root, '#b64-mode');
    const urlSafeBox = el<HTMLInputElement>(root, '#b64-urlsafe');
    const outputBox = el<HTMLElement>(root, '#b64-output');
    const summaryEl = el<HTMLElement>(root, '#b64-summary');
    const copyBtn = el<HTMLButtonElement>(root, '#b64-copy');
    const copyStatus = el<HTMLElement>(root, '#b64-copy-status');
    const clearBtn = el<HTMLButtonElement>(root, '#b64-clear');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#b64-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#b64-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#b64-snap-delete');
    if (
      !input ||
      !inputLabel ||
      !chipsWrap ||
      !modeGroup ||
      !urlSafeBox ||
      !outputBox ||
      !summaryEl ||
      !copyBtn ||
      !copyStatus ||
      !clearBtn ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    const modeBtns = Array.from(modeGroup.querySelectorAll<HTMLButtonElement>('[data-mode]'));

    // Copy (the one result button): the kit's delegated listener, outcomes
    // announced in #b64-copy-status.
    wireCopyButtons(root, { status: copyStatus });

    function setCopyPayload(text: string): void {
      copyBtn!.dataset.copy = text;
      copyBtn!.hidden = text.length === 0;
    }

    function renderError(message: string): void {
      setSummary(summaryEl!, 'Invalid', true);
      outputBox!.innerHTML = errorHtml(message);
      setCopyPayload('');
    }

    let engine: EngineModule;
    let examples: Example[] = [];
    try {
      const [engineMod, examplesMod] = await Promise.all([
        import('../lib/base64-codec/engine'),
        import('../lib/base64-codec/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
    } catch (err) {
      renderError('The converter engine failed to load. Reload the page to try again.');
      // eslint-disable-next-line no-console
      console.error('[Base64] engine import failed:', err);
      return;
    }

    // ── State ───────────────────────────────────────────────────────────────
    let mode: Mode = 'encode';

    function getMode(): Mode {
      return mode;
    }

    /** Sync the toggle's pressed button and the input/output labels. */
    function applyMode(next: Mode): void {
      mode = next === 'decode' ? 'decode' : 'encode';
      modeBtns.forEach((b) => {
        b.setAttribute('aria-pressed', b.dataset.mode === mode ? 'true' : 'false');
      });
      const encoding = mode === 'encode';
      inputLabel!.textContent = encoding ? 'Text to encode' : 'Base64 to decode';
      if (outputLabel) outputLabel.textContent = encoding ? 'Base64' : 'Decoded text';
      input!.setAttribute(
        'placeholder',
        encoding ? 'hello world' : 'aGVsbG8gd29ybGQ='
      );
      copyBtn!.setAttribute('aria-label', encoding ? 'Copy base64' : 'Copy decoded text');
    }

    function renderEmpty(): void {
      setSummary(summaryEl!, '', false);
      outputBox!.innerHTML = EMPTY_HTML;
      setCopyPayload('');
    }

    function renderResult(result: Result, rawInput: string): void {
      const out = typeof result.output === 'string' ? result.output : '';
      setSummary(summaryEl!, summaryText(result), false);
      outputBox!.innerHTML = resultHtml(result, rawInput);
      setCopyPayload(out);
    }

    function evaluate(): void {
      const value = input!.value;
      if (value.length === 0) {
        input!.classList.remove('b64-input--error');
        renderEmpty();
        return;
      }
      const urlSafe = urlSafeBox!.checked;
      let result: Result | null = null;
      try {
        result = engine.convert(value, getMode(), urlSafe);
      } catch {
        input!.classList.add('b64-input--error');
        renderError('Unexpected error while converting.');
        return;
      }
      if (!result || result.valid === false) {
        input!.classList.add('b64-input--error');
        renderError(result?.error ?? 'That input could not be converted.');
        return;
      }
      input!.classList.remove('b64-input--error');
      renderResult(result, value);
    }

    outputBox.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-handoff-to]');
      if (!btn) return;
      const to = btn.dataset.handoffTo;
      if (!to) return;
      writeHandoff(input!.value.trim());
      window.location.href = localePath(to);
    });

    // ── Example picker ────────────────────────────────────────────────────────
    // The chips are server-rendered from the same `examples` module, so a chip's
    // data-example-idx indexes straight into the array loaded above.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));

    /** Press one chip, or none once the input diverges from every preset. */
    const setActiveChip = (idx: number | null): void => {
      syncChipsByIndex(chipsWrap, idx);
    };

    // ── Live evaluation (debounced) ───────────────────────────────────────────
    let timer: number | undefined;
    function scheduleEvaluate(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(evaluate, DEBOUNCE_MS);
    }
    /** Drop the chip selection — the input is no longer one of the presets. */
    function markCustom(): void {
      setActiveChip(null);
    }

    input.addEventListener('input', () => {
      markCustom();
      scheduleEvaluate();
    });

    // A textarea, so plain Enter keeps inserting the newline and flushes after
    // it lands; Ctrl/Cmd+Enter always runs now.
    wireRunKeys(
      input,
      () => {
        window.clearTimeout(timer);
        evaluate();
      },
      { enter: 'insert-then-run' },
    );

    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.mode === 'decode' ? 'decode' : 'encode';
        if (next === mode) return;
        applyMode(next);
        markCustom();
        window.clearTimeout(timer);
        evaluate();
      });
    });

    urlSafeBox.addEventListener('change', () => {
      markCustom();
      window.clearTimeout(timer);
      evaluate();
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        const ex = examples[idx];
        applyMode(ex.mode);
        urlSafeBox.checked = ex.urlSafe;
        input.value = ex.input;
        setActiveChip(idx);
        window.clearTimeout(timer);
        evaluate();
      });
    });

    // ── Clear ─────────────────────────────────────────────────────────────────
    clearBtn.addEventListener('click', () => {
      input.value = '';
      setActiveChip(null);
      window.clearTimeout(timer);
      input.classList.remove('b64-input--error');
      renderEmpty();
      input.focus();
    });

    // Save-snapshot only — this tool is hard-excluded from auto-restore-last-input
    // (its input may be a secret), so there is no getRestoredLastInput() seed here.
    // Mode/urlSafe are not part of the snapshot — only the raw input text.
    wireSnapshotUI({
      slug: 'base64-encoder-decoder',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => input!.value,
      setValue: (value) => {
        input!.value = value;
        markCustom();
        window.clearTimeout(timer);
        evaluate();
      },
    });

    // ── Seed priority: a secret-safe handoff (e.g. from "Hash this text" on
    // another tool) > the first example. A handoff is a one-time read — it
    // never lingers for a later visit.
    const handoff = readHandoffOnce();
    if (handoff) {
      // The only incoming handoff today is raw text from Hash Generator's
      // "View as Base64" chip — encode it, not decode.
      applyMode('encode');
      input.value = handoff;
      // Handed-off text matches no example — leave every chip unpressed.
      setActiveChip(null);
      evaluate();
    } else {
      const seed = examples[0];
      if (seed) {
        applyMode(seed.mode);
        urlSafeBox.checked = seed.urlSafe;
        input.value = seed.input;
        // The pressed chip is the cue that the first example is pre-filled.
        setActiveChip(0);
        evaluate();
      } else {
        applyMode('encode');
        renderEmpty();
      }
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
