---
/**
 * Base64Playground — the interactive Base64 Encoder / Decoder island.
 *
 * A bespoke input -> output converter (not a rows table): type or paste text /
 * base64, flip the Encode|Decode toggle and the URL-safe switch, and the result
 * renders live (debounced). Card chrome is modeled on IpConverterPlayground —
 * light surface, scoped CSS, :global runtime markup — but the body is a single
 * input textarea above a read-only output area with a Copy button. Fully
 * client-side: no upload, no network.
 *
 * Runtime contract (lazy-imported):
 *   ../lib/base64-codec/engine →
 *     convert(input: string, mode: 'encode' | 'decode', urlSafe: boolean)
 *       => { valid: boolean; error?: string; output: string; bytes?: number; note?: string }
 *   ../lib/base64-codec/examples →
 *     examples: { id; label; input; mode: 'encode' | 'decode'; urlSafe: boolean }[]
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. The script never
// rebuilds them — it only reads each chip's `data-example-idx` into the lazily
// imported array — so this adds nothing to the client bundle and cannot drift.
import { examples as prerenderedExamples } from '../lib/base64-codec/examples';

---

<section class="b64-pg" aria-label="Base64 encoder and decoder playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: example picker + mode toggle + url-safe switch ───────── */}
    <div
      class="flex flex-col gap-3 border-b border-hairline px-4 py-3 sm:flex-row sm:items-end sm:justify-between sm:px-5"
    >
      <div class="flex min-w-0 flex-col gap-2">
        {/* A chip group is not a form control, so the visible caption is a
            plain span and the group carries its own aria-label. The `b64-ex-`
            prefix keeps these clear of the runtime `.b64-chip` hand-off row
            rendered under the result. */}
        <span class="eyebrow shrink-0">Example</span>
        <div id="b64-ex-chips" class="b64-ex-chips" role="group" aria-label="Examples">
          {/* Server-rendered so the examples are in the static HTML; the
              hydration script only wires clicks onto these buttons. */}
          {prerenderedExamples.map((ex, i) => (
            <button
              type="button"
              class={i === 0 ? 'b64-ex-chip is-active' : 'b64-ex-chip'}
              data-example-idx={i}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {ex.label}
            </button>
          ))}
        </div>
      </div>

      <div class="flex shrink-0 flex-wrap items-center gap-4">
        <div
          id="b64-mode"
          class="b64-seg"
          role="group"
          aria-label="Direction"
        >
          <button
            type="button"
            class="b64-seg__btn is-active"
            aria-pressed="true"
            data-mode="encode"
          >
            Encode
          </button>
          <button
            type="button"
            class="b64-seg__btn"
            aria-pressed="false"
            data-mode="decode"
          >
            Decode
          </button>
        </div>

        <label class="b64-check" for="b64-urlsafe">
          <input id="b64-urlsafe" type="checkbox" class="b64-check__box" autocomplete="off" />
          <span class="b64-check__label">URL-safe</span>
        </label>
      </div>
    </div>

    {/* ── Input ────────────────────────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <div class="mb-2 flex items-center justify-between gap-3">
        <label id="b64-input-label" class="eyebrow" for="b64-input">Text to encode</label>
        <button
          id="b64-clear"
          type="button"
          class="b64-clear"
          aria-label="Clear input"
        >Clear</button>
      </div>
      <textarea
        id="b64-input"
        class="b64-input code-mono"
        spellcheck="false"
        autocapitalize="off"
        autocorrect="off"
        autocomplete="off"
        rows="4"
        placeholder="hello world"
        aria-describedby="b64-input-hint"></textarea>
      <p id="b64-input-hint" class="b64-hint caption text-mute">
        UTF-8 safe both ways. Decoding accepts standard <span class="code-mono">+/</span> or url-safe
        <span class="code-mono">-_</span> alphabets, with or without <span class="code-mono">=</span>
        padding; whitespace is ignored.
      </p>
      <div class="b64-snap-row mt-3 flex flex-wrap items-center gap-2">
        <button id="b64-snap-save" type="button" class="b64-snap-btn">Save snapshot</button>
        <select id="b64-snap-select" class="b64-snap-select" aria-label="Load a saved snapshot" disabled>
          <option value="">No snapshots yet</option>
        </select>
        <button id="b64-snap-delete" type="button" class="b64-snap-delete" aria-label="Delete this snapshot" hidden>&times;</button>
      </div>
    </div>

    {/* ── Output ───────────────────────────────────────────────────────── */}
    <div class="bg-canvas-soft px-4 py-4 sm:px-5">
      <div class="mb-3 flex items-center justify-between gap-3">
        <span id="b64-output-label" class="eyebrow">Base64</span>
        <div class="flex shrink-0 items-center gap-3">
          <span id="b64-summary" class="b64-summary code-mono text-mute" role="status" aria-live="polite"></span>
          <button
            id="b64-copy"
            type="button"
            class="b64-copy"
            data-default-label="Copy"
            aria-label="Copy result"
            disabled
          >
            <svg
              class="h-3.5 w-3.5 shrink-0"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
              <path d="M3.5 10.5h-.5a1 1 0 01-1-1v-6a1 1 0 011-1h6a1 1 0 011 1v.5"></path>
            </svg>
            <span class="b64-copy-label">Copy</span>
          </button>
        </div>
      </div>
      <p class="caption text-mute mb-3">No share links on this tool — inputs may be secrets.</p>
      <div id="b64-output" class="b64-output">
        <p class="b64-empty body-sm text-mute">
          Type or paste on the left, then flip Encode / Decode — the result appears here, ready to
          copy.
        </p>
      </div>
    </div>
  </div>

  {/* Polite announcer for clipboard feedback. */}
  <span id="b64-announce" class="sr-only" role="status" aria-live="polite"></span>
</section>

<style>
  @reference "../styles/global.css";

  /* Example picker — squared mono chips (playground UX contract). Distinct from
     the `.b64-chip` hand-off links rendered into the result panel at runtime. */
  .b64-ex-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .b64-ex-chip {
    display: inline-flex;
    align-items: center;
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline-muted);
    background: var(--color-canvas);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.01em;
    color: var(--color-brand-strong);
    cursor: pointer;
    touch-action: manipulation;
    transition: background 0.12s ease, border-color 0.12s ease, color 0.12s ease;
  }
  .b64-ex-chip:hover {
    border-color: var(--color-hairline-strong);
    background: var(--color-canvas-hover);
  }
  .b64-ex-chip.is-active {
    background: var(--color-brand-soft);
    border-color: var(--color-brand-strong);
    color: var(--color-brand-strong);
  }
  .b64-ex-chip:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  @media (pointer: coarse) {
    .b64-ex-chip {
      min-height: 44px;
    }
  }

  /* Segmented Encode | Decode toggle. */
  .b64-seg {
    display: inline-flex;
    padding: 2px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }
  .b64-seg__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 76px;
    height: 28px;
    padding: 0 14px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--color-mute);
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
    transition: color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }
  .b64-seg__btn:hover:not(.is-active) {
    color: var(--color-body);
  }
  .b64-seg__btn.is-active {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
  }
  .b64-seg__btn:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  /* URL-safe checkbox. */
  .b64-check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    user-select: none;
  }
  .b64-check__box {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    accent-color: var(--color-brand);
    cursor: pointer;
  }
  .b64-check__box:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
  .b64-check__label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--color-body);
  }

  /* Input textarea. */
  .b64-input {
    width: 100%;
    min-height: 108px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 14px;
    line-height: 22px;
    resize: vertical;
    word-break: break-word;
    transition: box-shadow 0.15s ease;
  }
  .b64-input::placeholder {
    color: var(--color-mute);
  }
  .b64-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .b64-input:focus {
    outline: none;
  }
  .b64-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .b64-input.b64-input--error {
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  .b64-input.b64-input--error:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-error);
  }
  .b64-hint {
    margin-top: 8px;
    text-wrap: pretty;
  }
  .b64-snap-btn {
    flex: 0 0 auto;
    height: 30px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    border: none;
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-size: 12.5px;
    cursor: pointer;
    transition: background 0.12s ease, box-shadow 0.12s ease;
  }
  .b64-snap-btn:hover {
    background: var(--color-canvas-soft);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .b64-snap-select {
    height: 30px;
    max-width: 220px;
    padding: 0 8px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-size: 12.5px;
  }
  .b64-snap-select:disabled {
    color: var(--color-mute);
    cursor: not-allowed;
  }
  .b64-snap-delete {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .b64-snap-delete:hover {
    background: var(--color-error-soft);
    color: var(--color-error-deep);
  }

  .b64-summary {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum';
  }

  /* Copy button — compact ghost control on the light surface. */
  .b64-copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 10px;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-hairline);
    background: var(--color-canvas);
    color: var(--color-body);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    cursor: pointer;
    touch-action: manipulation;
    transition: box-shadow 0.15s ease, color 0.15s ease;
  }
  .b64-copy:hover:not(:disabled) {
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .b64-copy:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
  .b64-copy:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* Clear button — compact ghost control mirroring .b64-copy but on the input side. */
  .b64-clear {
    display: inline-flex;
    align-items: center;
    height: 26px;
    padding: 0 10px;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-hairline);
    background: var(--color-canvas);
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    cursor: pointer;
    touch-action: manipulation;
    transition: box-shadow 0.15s ease, color 0.15s ease;
  }
  .b64-clear:hover {
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .b64-clear:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  .b64-output {
    min-height: 64px;
  }

  /* ── Runtime-injected markup ─────────────────────────────────────────── */
  :global(.b64-result) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: b64-rise 0.18s ease both;
  }
  :global(.b64-result__body) {
    margin: 0;
    padding: 12px 14px;
    max-height: 320px;
    overflow: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink);
    white-space: pre-wrap;
    word-break: break-all;
    overflow-wrap: anywhere;
  }
  :global(.b64-result__body.is-empty-text) {
    color: var(--color-mute);
    font-style: italic;
    word-break: normal;
  }
  :global(.b64-result__meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    padding: 8px 14px;
    border-top: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    color: var(--color-mute);
  }
  :global(.b64-result__note) {
    color: var(--color-brand-strong);
  }

  @keyframes b64-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.b64-result) {
      animation: none;
    }
  }

  :global(.b64-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.b64-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.b64-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.b64-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.b64-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  :global(.b64-chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  :global(.b64-chip) {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    border: none;
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-brand-strong);
    cursor: pointer;
    transition: background 0.12s ease, box-shadow 0.12s ease;
  }
  :global(.b64-chip:hover) {
    background: var(--color-brand-soft);
    box-shadow: inset 0 0 0 1px var(--color-brand);
  }
</style>

<script>
  import { copyTextToClipboard as copyText } from '../lib/clipboard';
  import { escapeHtml } from '../lib/escape-html';
  import { writeHandoff, readHandoffOnce } from '../lib/tool-state/handoff';
  import { wireSnapshotUI } from '../lib/tool-state/wire';

  type Mode = 'encode' | 'decode';
  type Result = { valid: boolean; error?: string; output: string; bytes?: number; note?: string };
  type Example = { id: string; label: string; input: string; mode: Mode; urlSafe: boolean };
  type EngineModule = { convert: (input: string, mode: Mode, urlSafe: boolean) => Result };

  const ROOT_SEL = '.b64-pg';
  const DEBOUNCE_MS = 140;
  const COPIED_RESET_MS = 1800;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.b64Wired === 'true') return;
      root.dataset.b64Wired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          input: typeof o.input === 'string' ? o.input : '',
          mode: o.mode === 'decode' ? 'decode' : 'encode',
          urlSafe: o.urlSafe === true,
        } satisfies Example;
      })
      .filter((e) => e.input.length > 0);
  }

  const ALERT_SVG =
    '<svg class="b64-error__icon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2.5L18.5 17H1.5z"></path><path d="M10 8v4"></path><path d="M10 14.6v.01"></path></svg>';

  const EMPTY_HTML =
    '<p class="b64-empty body-sm text-mute">Type or paste on the left, then flip Encode / Decode — the result appears here, ready to copy.</p>';

  /**
   * Secret-safe handoff chains (never a #-fragment — a JWT or arbitrary text
   * here may be a secret, which is exactly why this tool is excluded from
   * URL-hash sharing; see src/lib/tool-state/handoff.ts).
   */
  const JWT_SHAPE = /^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]*$/;

  function localePath(p: string): string {
    const m = window.location.pathname.match(/^\/(de|es|fr|pt-br)\//);
    return m ? `/${m[1]}${p}` : p;
  }

  function chainsHtml(rawInput: string): string {
    const trimmed = rawInput.trim();
    const chips: string[] = [];
    if (JWT_SHAPE.test(trimmed)) {
      chips.push('<button type="button" class="b64-chip" data-handoff-to="/jwt-decoder/">Decode as JWT &rarr;</button>');
    }
    if (trimmed.length > 0) {
      chips.push('<button type="button" class="b64-chip" data-handoff-to="/hash-generator/">Hash this text &rarr;</button>');
    }
    return chips.length > 0 ? `<div class="b64-chips">${chips.join('')}</div>` : '';
  }

  async function init(root: HTMLElement): Promise<void> {
    const input = el<HTMLTextAreaElement>(root, '#b64-input');
    const inputLabel = el<HTMLElement>(root, '#b64-input-label');
    const outputLabel = el<HTMLElement>(root, '#b64-output-label');
    const chipsWrap = el<HTMLElement>(root, '#b64-ex-chips');
    const modeGroup = el<HTMLElement>(root, '#b64-mode');
    const urlSafeBox = el<HTMLInputElement>(root, '#b64-urlsafe');
    const outputBox = el<HTMLElement>(root, '#b64-output');
    const summaryEl = el<HTMLElement>(root, '#b64-summary');
    const copyBtn = el<HTMLButtonElement>(root, '#b64-copy');
    const clearBtn = el<HTMLButtonElement>(root, '#b64-clear');
    const announce = el<HTMLElement>(root, '#b64-announce');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#b64-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#b64-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#b64-snap-delete');
    if (
      !input ||
      !inputLabel ||
      !outputLabel ||
      !chipsWrap ||
      !modeGroup ||
      !urlSafeBox ||
      !outputBox ||
      !summaryEl ||
      !copyBtn ||
      !clearBtn ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    const modeBtns = Array.from(modeGroup.querySelectorAll<HTMLButtonElement>('.b64-seg__btn'));

    let engine: EngineModule;
    let examples: Example[] = [];
    try {
      const [engineMod, examplesMod] = await Promise.all([
        import('../lib/base64-codec/engine'),
        import('../lib/base64-codec/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
    } catch (err) {
      renderError(outputBox, summaryEl, copyBtn, 'The converter engine failed to load. Reload the page to try again.');
      // eslint-disable-next-line no-console
      console.error('[Base64] engine import failed:', err);
      return;
    }

    // ── State ───────────────────────────────────────────────────────────────
    let mode: Mode = 'encode';
    let lastOutput = '';

    function getMode(): Mode {
      return mode;
    }

    /** Sync the toggle's active button + a11y state and the input/output labels. */
    function applyMode(next: Mode): void {
      mode = next === 'decode' ? 'decode' : 'encode';
      modeBtns.forEach((b) => {
        const active = b.dataset.mode === mode;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      const encoding = mode === 'encode';
      inputLabel!.textContent = encoding ? 'Text to encode' : 'Base64 to decode';
      outputLabel!.textContent = encoding ? 'Base64' : 'Decoded text';
      input!.setAttribute(
        'placeholder',
        encoding ? 'hello world' : 'aGVsbG8gd29ybGQ='
      );
      copyBtn!.setAttribute('aria-label', encoding ? 'Copy base64' : 'Copy decoded text');
    }

    function setOutputEnabled(enabled: boolean): void {
      copyBtn!.disabled = !enabled;
    }

    function renderEmpty(): void {
      summaryEl!.textContent = '';
      summaryEl!.classList.remove('text-error');
      summaryEl!.classList.add('text-mute');
      outputBox!.innerHTML = EMPTY_HTML;
      lastOutput = '';
      setOutputEnabled(false);
    }

    function renderResult(result: Result, rawInput: string): void {
      const out = typeof result.output === 'string' ? result.output : '';
      lastOutput = out;
      const bytes = typeof result.bytes === 'number' ? result.bytes : null;
      const noun = bytes === 1 ? 'byte' : 'bytes';
      summaryEl!.textContent = bytes === null ? '' : `${bytes} ${noun}`;
      summaryEl!.classList.remove('text-error');
      summaryEl!.classList.add('text-mute');

      const isEmptyText = out.length === 0;
      const bodyCls = isEmptyText ? 'b64-result__body is-empty-text' : 'b64-result__body';
      const bodyText = isEmptyText ? '(empty result)' : out;

      const metaBits: string[] = [];
      if (bytes !== null) metaBits.push(`<span>${bytes} ${noun}</span>`);
      if (result.note) metaBits.push(`<span class="b64-result__note">${escapeHtml(result.note)}</span>`);
      const meta = metaBits.length
        ? `<div class="b64-result__meta">${metaBits.join('')}</div>`
        : '';

      outputBox!.innerHTML =
        '<div class="b64-result">' +
        `<pre class="${bodyCls}"><code>${escapeHtml(bodyText)}</code></pre>` +
        meta +
        '</div>' +
        chainsHtml(rawInput);
      setOutputEnabled(out.length > 0);
    }

    function evaluate(): void {
      const value = input!.value;
      if (value.length === 0) {
        input!.classList.remove('b64-input--error');
        renderEmpty();
        return;
      }
      const urlSafe = urlSafeBox!.checked;
      let result: Result | null = null;
      try {
        result = engine.convert(value, getMode(), urlSafe);
      } catch {
        input!.classList.add('b64-input--error');
        renderError(outputBox!, summaryEl!, copyBtn!, 'Unexpected error while converting.');
        return;
      }
      if (!result || result.valid === false) {
        input!.classList.add('b64-input--error');
        renderError(
          outputBox!,
          summaryEl!,
          copyBtn!,
          result?.error ?? 'That input could not be converted.'
        );
        return;
      }
      input!.classList.remove('b64-input--error');
      renderResult(result, value);
    }

    outputBox.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-handoff-to]');
      if (!btn) return;
      const to = btn.dataset.handoffTo;
      if (!to) return;
      writeHandoff(input!.value.trim());
      window.location.href = localePath(to);
    });

    // ── Example picker ────────────────────────────────────────────────────────
    // The chips are server-rendered from the same `examples` module, so a chip's
    // data-example-idx indexes straight into the array loaded above.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>('.b64-ex-chip'));

    /** Mark one chip active, or none once the input diverges from every preset. */
    const setActiveChip = (idx: number | null): void => {
      chips.forEach((chip) => {
        const active = idx !== null && chip.dataset.exampleIdx === String(idx);
        chip.classList.toggle('is-active', active);
        chip.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    };

    // ── Live evaluation (debounced) ───────────────────────────────────────────
    let timer: number | undefined;
    function scheduleEvaluate(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(evaluate, DEBOUNCE_MS);
    }
    /** Drop the chip selection — the input is no longer one of the presets. */
    function markCustom(): void {
      setActiveChip(null);
    }

    input.addEventListener('input', () => {
      markCustom();
      scheduleEvaluate();
    });

    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.mode === 'decode' ? 'decode' : 'encode';
        if (next === mode) return;
        applyMode(next);
        markCustom();
        window.clearTimeout(timer);
        evaluate();
      });
    });

    urlSafeBox.addEventListener('change', () => {
      markCustom();
      window.clearTimeout(timer);
      evaluate();
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        const ex = examples[idx];
        applyMode(ex.mode);
        urlSafeBox.checked = ex.urlSafe;
        input.value = ex.input;
        setActiveChip(idx);
        window.clearTimeout(timer);
        evaluate();
      });
    });

    // ── Clear ─────────────────────────────────────────────────────────────────
    clearBtn.addEventListener('click', () => {
      input.value = '';
      setActiveChip(null);
      window.clearTimeout(timer);
      input.classList.remove('b64-input--error');
      renderEmpty();
      input.focus();
    });

    // Save-snapshot only — this tool is hard-excluded from auto-restore-last-input
    // (its input may be a secret), so there is no getRestoredLastInput() seed here.
    // Mode/urlSafe are not part of the snapshot — only the raw input text.
    wireSnapshotUI({
      slug: 'base64-encoder-decoder',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => input!.value,
      setValue: (value) => {
        input!.value = value;
        markCustom();
        window.clearTimeout(timer);
        evaluate();
      },
    });

    // ── Copy ──────────────────────────────────────────────────────────────────
    const copyLabel = copyBtn.querySelector<HTMLElement>('.b64-copy-label');
    let copyTimer: number | undefined;
    copyBtn.addEventListener('click', async () => {
      if (!lastOutput) return;
      const ok = await copyText(lastOutput);
      if (copyLabel) copyLabel.textContent = ok ? 'Copied' : 'Failed';
      if (announce) {
        announce.textContent = ok
          ? 'Result copied to your clipboard.'
          : 'Could not copy. Select the text and copy it manually.';
      }
      window.clearTimeout(copyTimer);
      copyTimer = window.setTimeout(() => {
        if (copyLabel) copyLabel.textContent = copyBtn.dataset.defaultLabel ?? 'Copy';
      }, COPIED_RESET_MS);
    });

    // ── Seed priority: a secret-safe handoff (e.g. from "Hash this text" on
    // another tool) > the first example. A handoff is a one-time read — it
    // never lingers for a later visit.
    const handoff = readHandoffOnce();
    if (handoff) {
      // The only incoming handoff today is raw text from Hash Generator's
      // "View as Base64" chip — encode it, not decode.
      applyMode('encode');
      input.value = handoff;
      // Handed-off text matches no example — leave every chip unpressed.
      setActiveChip(null);
      evaluate();
    } else {
      const seed = examples[0];
      if (seed) {
        applyMode(seed.mode);
        urlSafeBox.checked = seed.urlSafe;
        input.value = seed.input;
        // The pressed chip is the cue that the first example is pre-filled.
        setActiveChip(0);
        evaluate();
      } else {
        applyMode('encode');
        renderEmpty();
      }
    }
  }

  function renderError(
    container: HTMLElement,
    summary: HTMLElement,
    copyBtn: HTMLButtonElement,
    message: string
  ): void {
    summary.textContent = 'Invalid';
    summary.classList.remove('text-mute');
    summary.classList.add('text-error');
    container.innerHTML =
      '<div class="b64-error" role="alert">' +
      ALERT_SVG +
      '<div><p class="b64-error__title">Could not convert that input</p>' +
      `<p class="b64-error__detail">${escapeHtml(message)}</p></div></div>`;
    copyBtn.disabled = true;
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
