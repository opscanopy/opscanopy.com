---
/**
 * AlertmanagerRouteTesterPlayground — the interactive Alertmanager Route Tester
 * island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>
 * that lazily boots TWO CodeMirror 6 editors (the route config YAML and the
 * alert labels), wires the example chips, live evaluation with a "Run now"
 * control, Copy (the route config) and Copy link. It is fully usable offline
 * once loaded.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * two EditorPanes (each a FigureCap over its CodeMirror host, seeded with a
 * `<pre data-cm-fallback>`), RunHint and SnapshotBar on paper, and
 * ResultPanel (figure cap, live summary, copy status) with CopyButton. The
 * results container stays here, seeded with `set:html` + `data-results`; its
 * slab overrides anchor on `.amr-results`.
 *
 * Runtime contract (imported lazily in the script):
 *   ../lib/alertmanager-route-tester/engine →
 *     matchRoute(configYaml: string, alertLabelsInput: string) => MatchRouteResult
 *       MatchRouteResult = {
 *         ok: boolean
 *         error?: string
 *         matches?: Array<{
 *           receiver: string
 *           path: string[]
 *           grouping: { group_by?: string[]; group_wait?: string; … }
 *           viaContinue: boolean
 *           matchers: Array<{ name: string; op: string; value: string }>
 *         }>
 *         warnings: string[]
 *       }
 *   ../lib/alertmanager-route-tester/examples →
 *     examples: Array<{ id: string; label: string; config: string; labels: string }>
 *
 * All runtime-injected markup is styled via :global(...) because Astro scoped
 * styles do not reach innerHTML nodes, and every user string is escaped with
 * escapeHtml before injection.
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. The script never
// rebuilds them — it only reads each chip's `data-example-idx` into the lazily
// imported array — so this adds nothing to the client bundle and cannot drift.
import { examples as prerenderedExamples } from '../lib/alertmanager-route-tester/examples';
import { matchRoute } from '../lib/alertmanager-route-tester/engine';
import { resultHtml, resultSummaryText, EMPTY_HTML } from '../lib/alertmanager-route-tester/render';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. `matchRoute` is pure and synchronous, so the walk of
 * the first example's route tree runs at build time and lands in the static
 * HTML — which is all an AI crawler (no JS) ever sees. The client re-runs the
 * same example on boot and repaints the identical markup.
 *
 * The two documents go into `<pre data-cm-fallback>` elements inside the
 * CodeMirror hosts; CM appends its editor to the host, so `init` removes them
 * once mounted.
 */
const seedExample = prerenderedExamples[0];
const seedResult = seedExample ? matchRoute(seedExample.config, seedExample.labels) : null;
const seedOk = seedResult && seedResult.ok !== false && !seedResult.error ? seedResult : null;
const seedHtml = seedOk ? resultHtml(seedOk) : EMPTY_HTML;
const seedSummary = seedOk ? resultSummaryText(seedOk) : '';
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="amr" aria-label="Alertmanager Route Tester playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: example chips + Run now (paper) ─────────────────────── */}
    <div
      class="flex flex-col gap-3 border-b border-hairline px-4 py-3 sm:flex-row sm:items-end sm:justify-between sm:px-5"
    >
      <div class="flex min-w-0 flex-col gap-2">
        <span class="eyebrow shrink-0">Example</span>
        <ExampleChips prefix="amr" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
      </div>
      <button
        id="amr-run"
        type="button"
        class="btn-tool amr-tap self-start sm:self-auto"
        title="Run now (⌘/Ctrl + Enter)"
        aria-keyshortcuts="Meta+Enter Control+Enter"
      >
        <svg
          class="amr-run-icon h-4 w-4 shrink-0"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 3l9 5-9 5z"></path>
        </svg>
        <span class="amr-run-label">Run now</span>
      </button>
    </div>

    {/* ── Editors on the plate: route config (wide) + alert labels ─────── */}
    <div class="amr-grid grid grid-cols-1 lg:grid-cols-[1.4fr_1fr]">
      <EditorPane prefix="amr" id="amr-config" label="alertmanager.yml · route" class="amr-pane">
        <Fragment slot="actions">
          <CopyButton kind="value" id="amr-copy" label="Copy" hidden={false} ariaLabel="Copy route configuration" />
        </Fragment>
        <pre class="editor-pane__fallback code-mono amr-fallback" data-cm-fallback>{seedExample?.config}</pre>
      </EditorPane>
      <EditorPane prefix="amr" id="amr-labels" label="alert labels · key=value" class="amr-pane">
        <pre class="editor-pane__fallback code-mono amr-fallback" data-cm-fallback>{seedExample?.labels}</pre>
      </EditorPane>
    </div>

    {/* ── Input notes, run hint + snapshots, on paper (never in the slab) ── */}
    <div class="border-b border-hairline px-4 py-3 sm:px-5">
      <p class="caption text-mute">
        Paste a route tree or full config. One label per line, e.g. <span class="code-mono">severity=critical</span>.
      </p>
      <RunHint variant="cm" />
      <SnapshotBar prefix="amr" />
    </div>

    {/* ── Results — the L2 instrument under its figure cap ─────────────── */}
    <ResultPanel
      slug="alertmanager-route-tester"
      prefix="amr"
      label="Matched receivers"
      summary={seedSummary}
      summaryClass="whitespace-nowrap"
      split
    >
      <Fragment slot="actions">
        <CopyButton kind="link" id="amr-share" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the matched receivers are
          in the static HTML; the script repaints this same node on every run. */}
      <div id="amr-results" class="amr-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .amr-tap {
    touch-action: manipulation;
  }

  /* The seeded documents a crawler reads (global .editor-pane__fallback sets
     the metrics), boxed to the editors' own min/max height (the script's
     size theme) so the swap on hydration does not move the page. */
  .amr-fallback {
    min-height: 288px;
    max-height: 460px;
    overflow: auto;
  }

  /* The divider between the two plates: a rule above the labels when
     stacked, beside them from lg. */
  .amr-grid :global(.amr-pane + .amr-pane) {
    border-top: 1px solid var(--color-inverse-hairline);
  }
  @media (min-width: 1024px) {
    .amr-grid :global(.amr-pane + .amr-pane) {
      border-top: none;
      border-left: 1px solid var(--color-inverse-hairline);
    }
  }

  /* ── Results (runtime-injected → :global). Light rules first as the
     documented defaults; the slab re-skin follows, anchored on this
     component's own `.amr-results` container. ────────────────────────── */
  .amr-results {
    min-height: var(--control-h-lg);
  }

  :global(.amr-match + .amr-match) {
    margin-top: 10px;
  }
  :global(.amr-match) {
    padding: 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow:
      inset 0 0 0 1px var(--color-brand-soft),
      var(--shadow-hairline);
    animation: amr-rise var(--dur-base) var(--ease-brand) both;
  }
  @keyframes amr-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.amr-match),
    :global(.amr-error),
    :global(.amr-warn) {
      animation: none;
    }
  }

  :global(.amr-match__head) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  :global(.amr-match__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    color: var(--color-success);
  }
  :global(.amr-match__rx) {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-word;
  }
  /* Ordinal / "via continue" tags — the row-key role (label-field). */
  :global(.amr-pill) {
    @apply label-field;
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-hairline);
    background: var(--color-canvas-soft-2);
    color: var(--color-body);
  }
  :global(.amr-pill--continue) {
    background: var(--color-warning-soft);
    color: var(--color-warning-deep);
  }

  /* Breadcrumb of the matched path. */
  :global(.amr-path) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    margin-top: 10px;
  }
  :global(.amr-crumb) {
    display: inline-flex;
    align-items: center;
    padding: 1px 8px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-soft-2);
    color: var(--color-body);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    word-break: break-word;
  }
  :global(.amr-crumb--last) {
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
  }
  :global(.amr-sep) {
    color: var(--color-mute);
    font-size: 12px;
  }

  /* Effective grouping line. */
  :global(.amr-group) {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
  }
  :global(.amr-group__item) {
    font-size: 12px;
    line-height: 18px;
    color: var(--color-body);
  }
  :global(.amr-group__k) {
    font-family: var(--font-mono);
    color: var(--color-mute);
  }
  :global(.amr-group__v) {
    font-family: var(--font-mono);
    color: var(--color-ink);
  }

  /* Warnings list. */
  :global(.amr-warns) {
    margin-top: 14px;
  }
  :global(.amr-warn) {
    display: flex;
    gap: 8px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    background: var(--color-warning-soft);
    color: var(--color-warning-deep);
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.amr-warn + .amr-warn) {
    margin-top: 6px;
  }
  :global(.amr-warn__icon) {
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    margin-top: 2px;
  }

  /* Parse-error banner. */
  :global(.amr-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
    animation: amr-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.amr-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.amr-error__body) {
    min-width: 0;
  }
  :global(.amr-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.amr-error__detail) {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  :global(.amr-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  :global(.amr-loading) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-body);
  }
  :global(.amr-loading__dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-mute);
    animation: amr-pulse calc(var(--dur-base) * 6) ease-in-out infinite;
  }
  :global(.amr-loading__dot:nth-child(2)) {
    animation-delay: var(--dur-base);
  }
  :global(.amr-loading__dot:nth-child(3)) {
    animation-delay: calc(var(--dur-base) * 2);
  }
  @keyframes amr-pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.amr-loading__dot) {
      animation: none;
      opacity: 0.6;
    }
  }

  .is-busy {
    opacity: 0.65;
    pointer-events: none;
    cursor: progress;
  }
  .is-busy .amr-run-icon {
    display: none;
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below uses the slab ink tier. ─────────────────── */
  .amr-results :global(.amr-empty) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .amr-results :global(.amr-loading) {
    color: var(--color-inverse-mute);
  }
  .amr-results :global(.amr-loading__dot) {
    background: var(--color-inverse-mute);
  }
  .amr-results :global(.amr-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .amr-results :global(.amr-match) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px #8fc97a40;
  }
  .amr-results :global(.amr-match__icon) {
    color: var(--color-inverse-brand);
  }
  .amr-results :global(.amr-match__rx),
  .amr-results :global(.amr-group__v) {
    color: var(--color-inverse-fg);
  }
  .amr-results :global(.amr-group__item),
  .amr-results :global(.amr-group__k),
  .amr-results :global(.amr-sep) {
    color: var(--color-inverse-mute);
  }
  .amr-results :global(.amr-pill) {
    box-shadow: none;
    background: #ffffff14;
    color: var(--color-inverse-mute);
  }
  .amr-results :global(.amr-pill--continue) {
    background: #e0a4581f;
    color: var(--color-inverse-accent);
  }
  .amr-results :global(.amr-crumb) {
    background: #ffffff14;
    color: var(--color-inverse-mute);
  }
  .amr-results :global(.amr-crumb--last) {
    background: #8fc97a1f;
    color: var(--color-inverse-brand);
  }
  .amr-results :global(.amr-warn) {
    background: #e0a45814;
    color: var(--color-inverse-accent);
  }
</style>

<script>
  import type { EditorView } from '@codemirror/view';
  import { base64UrlEncode, base64UrlDecode } from '../lib/codec';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { LOADING_HTML, errorHtml, resultHtml, resultSummaryText } from '../lib/alertmanager-route-tester/render';

  /* ---- Engine contract ------------------------------------------------------
     Imported, never hand-mirrored: a copied shape drifts silently when the
     engine gains a field the render code reads (`import type` is erased at
     build time, so it does not affect code-splitting). */
  import type { MatchRouteResult } from '../lib/alertmanager-route-tester/types';

  // CodeMirror (and the kit's plate theme, which imports @codemirror/view) is
  // loaded via dynamic import inside init() so its runtime code-splits into
  // its own chunk instead of shipping in the page's initial JS.

  type EngineModule = {
    matchRoute: (configYaml: string, alertLabelsInput: string) => MatchRouteResult | Promise<MatchRouteResult>;
  };
  type ExampleRaw = Record<string, unknown>;
  type Example = { id: string; label: string; config: string; labels: string };

  const ROOT_SEL = '.amr';
  const SLUG = 'alertmanager-route-tester';
  const SHARE_KEY_CFG = 'amrc';
  const SHARE_KEY_LBL = 'amrl';

  /** Boot every (so far un-hydrated) playground instance on the page. */
  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.amrWired === 'true') return;
      root.dataset.amrWired = 'true';
      void init(root);
    });
  }

  /* ---- Small helpers -------------------------------------------------------- */

  function pick(obj: ExampleRaw, keys: string[]): string {
    for (const k of keys) {
      const v = obj[k];
      if (typeof v === 'string' && v.length > 0) return v;
    }
    return '';
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw.map((item, i) => {
      const o = (item ?? {}) as ExampleRaw;
      return {
        id: pick(o, ['id', 'slug', 'key']) || `example-${i + 1}`,
        label: pick(o, ['label', 'name', 'title']) || `Example ${i + 1}`,
        config: pick(o, ['config', 'route', 'yaml', 'tree', 'content']),
        labels: pick(o, ['labels', 'alert', 'alertLabels']),
      };
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  /* ---- Result rendering --------------------------------------------------
     The pure HTML builders live in `../lib/alertmanager-route-tester/render`,
     imported above and ALSO used by this component's frontmatter, so the
     server-rendered seed and every client repaint come from one
     implementation. Only the DOM writes stay here. */

  /** Summary ink on the slab: inverse tier only (never paper text-mute). */
  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderLoading(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = LOADING_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    setSummary(summary, 'Error', true);
    container.innerHTML = errorHtml(message);
  }

  function renderResults(container: HTMLElement, summary: HTMLElement, result: MatchRouteResult): void {
    const failed = !result || result.ok === false || Boolean(result.error);
    setSummary(summary, resultSummaryText(result), failed);
    container.innerHTML = resultHtml(result);
  }

  /* ---- Share-state codec (self-contained; no engine dependency) ------------- */

  function b64decode(b64In: string): string | null {
    try {
      return base64UrlDecode(b64In);
    } catch {
      return null;
    }
  }

  function encodeShare(config: string, labels: string): string {
    return `#${SHARE_KEY_CFG}=${base64UrlEncode(config)}&${SHARE_KEY_LBL}=${base64UrlEncode(labels)}`;
  }

  function decodeShare(): { config: string; labels: string } | null {
    const hash = window.location.hash.replace(/^#/, '');
    if (!hash) return null;
    const params = new Map<string, string>();
    for (const part of hash.split('&')) {
      const [k, v] = part.split('=');
      if (k && v) params.set(k, v);
    }
    const cfgRaw = params.get(SHARE_KEY_CFG);
    if (!cfgRaw) return null;
    const config = b64decode(cfgRaw);
    if (config === null) return null;
    const lblRaw = params.get(SHARE_KEY_LBL);
    const labels = lblRaw ? (b64decode(lblRaw) ?? '') : '';
    return { config, labels };
  }

  /* ---- Instance init -------------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const configHost = el<HTMLElement>(root, '#amr-config');
    const labelsHost = el<HTMLElement>(root, '#amr-labels');
    const chipsWrap = el<HTMLElement>(root, '#amr-chips');
    const runBtn = el<HTMLButtonElement>(root, '#amr-run');
    const copyBtn = el<HTMLButtonElement>(root, '#amr-copy');
    const shareBtn = el<HTMLButtonElement>(root, '#amr-share');
    const resultsBox = el<HTMLElement>(root, '#amr-results');
    const summaryEl = el<HTMLElement>(root, '#amr-summary');
    const copyStatus = el<HTMLElement>(root, '#amr-copy-status');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#amr-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#amr-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#amr-snap-delete');

    if (
      !configHost ||
      !labelsHost ||
      !chipsWrap ||
      !runBtn ||
      !copyBtn ||
      !shareBtn ||
      !resultsBox ||
      !summaryEl ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    // Copy (the route config) and Copy link: the kit's one delegated
    // listener; outcomes are announced in ResultPanel's #amr-copy-status.
    wireCopyButtons(root, { status: copyStatus });
    shareBtn.title = 'This link encodes your route config and labels — review before sharing';

    // Lazily load CodeMirror + the plate theme + the engine + examples (kept
    // out of the initial path so the CM runtime code-splits into its own chunk).
    let engine: EngineModule;
    let examples: Example[] = [];
    let makeEditor: (host: HTMLElement, doc: string, label: string) => EditorView;
    let setEditorDoc: (view: EditorView, doc: string) => void;
    try {
      const [
        engineMod,
        examplesMod,
        { EditorState },
        { EditorView, keymap, lineNumbers, highlightActiveLine },
        { defaultKeymap, history, historyKeymap, indentWithTab },
        { yaml },
        { plate },
      ] = await Promise.all([
        import('../lib/alertmanager-route-tester/engine'),
        import('../lib/alertmanager-route-tester/examples'),
        import('@codemirror/state'),
        import('@codemirror/view'),
        import('@codemirror/commands'),
        import('@codemirror/lang-yaml'),
        import('../lib/playground-kit/cm-theme'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);

      // Size only (the plate theme owns colour; global.css owns the focus
      // ring): 13px like the seeded fallback, scrolling inside 288–460px.
      const sizeTheme = EditorView.theme({
        '&': { fontSize: '13px', maxHeight: '460px' },
        '.cm-scroller': { overflow: 'auto' },
        '.cm-content, .cm-gutter': { minHeight: '288px' },
      });

      makeEditor = (host: HTMLElement, doc: string, label: string): EditorView => {
        const state = EditorState.create({
          doc,
          extensions: [
            lineNumbers(),
            history(),
            highlightActiveLine(),
            yaml(),
            plate,
            sizeTheme,
            EditorView.lineWrapping,
            EditorView.contentAttributes.of({ 'aria-label': label }),
            keymap.of([
              // ⌘/Ctrl+Enter runs now — placed BEFORE defaultKeymap, whose
              // Mod-Enter would otherwise insert a blank line.
              {
                key: 'Mod-Enter',
                run: (v) => {
                  forceRun();
                  if (window.matchMedia?.('(pointer: coarse)').matches) v.contentDOM.blur();
                  return true;
                },
              },
              ...defaultKeymap,
              ...historyKeymap,
              indentWithTab,
              {
                key: 'Escape',
                run: (v) => {
                  v.contentDOM.blur();
                  return true;
                },
              },
            ]),
            // Live eval: re-walk the route tree once the documents settle.
            EditorView.updateListener.of((u) => {
              if (u.docChanged) scheduleLive();
            }),
          ],
        });
        return new EditorView({ state, parent: host });
      };

      setEditorDoc = (view: EditorView, doc: string): void => {
        view.dispatch({
          changes: { from: 0, to: view.state.doc.length, insert: doc },
        });
      };
    } catch (err) {
      renderError(resultsBox, summaryEl, 'The route-tester engine failed to load. Reload the page to try again.');
      // eslint-disable-next-line no-console
      console.error('[AlertmanagerRouteTester] engine/examples import failed:', err);
      return;
    }

    // Seed priority: a shared-state URL > restored last input > the first example.
    // Neither path counts as a user-initiated evaluation — only a deliberate
    // run writes the hash, and only the visitor's own edits record a last input.
    const seedExample = examples[0] ?? { id: 'example', label: 'Example', config: '', labels: '' };
    let seedConfig = seedExample.config;
    let seedLabels = seedExample.labels;
    let fromShare = false;
    let fromRestore = false;
    const shared = decodeShare();
    if (shared) {
      seedConfig = shared.config;
      seedLabels = shared.labels;
      fromShare = true;
    } else {
      const restored = getRestoredLastInput(SLUG);
      if (restored) {
        try {
          const parsed = JSON.parse(restored) as { config?: unknown; labels?: unknown };
          if (typeof parsed.config === 'string') seedConfig = parsed.config;
          if (typeof parsed.labels === 'string') seedLabels = parsed.labels;
          fromRestore = true;
        } catch {
          /* malformed restored value — fall back to the seeded example */
        }
      }
    }

    /* ---- Live evaluation ---------------------------------------------------
     * ~220ms after either document settles the route tree is re-walked
     * quietly (no spinner, no loading flash, no hash write). Calm errors: a
     * live run that fails to parse holds the previous panel and reveals the
     * error only after ~600ms of idle in total.                             */
    const LIVE_DEBOUNCE_MS = 220;
    const ERROR_HOLD_MS = 380;
    let liveReady = false;
    let liveTimer: number | undefined;
    let errorHoldTimer: number | undefined;

    function scheduleLive(): void {
      if (!liveReady) return;
      window.clearTimeout(liveTimer);
      window.clearTimeout(errorHoldTimer);
      liveTimer = window.setTimeout(() => void run({ live: true }), LIVE_DEBOUNCE_MS);
    }

    /** Deliberate run (Run now, ⌘/Ctrl+Enter, a chip): cancel the debounce, go now. */
    function forceRun(): void {
      window.clearTimeout(liveTimer);
      window.clearTimeout(errorHoldTimer);
      void run();
    }

    const configView = makeEditor(configHost, seedConfig, 'Alertmanager route configuration (YAML)');
    const labelsView = makeEditor(labelsHost, seedLabels, 'Alert labels (key=value per line)');

    // The build-time text stand-ins have done their job (no-JS visitors and
    // crawlers); CodeMirror appended its editors beside them, so drop them.
    // The share/restore tiers above already chose the documents.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());

    // The example chips are server-rendered from the same `examples` module,
    // so a chip's data-example-idx indexes straight into the array above.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));

    // A shared scenario or a restored session matches no example — leave every
    // chip unpressed rather than implying one of them is loaded.
    syncChipsByIndex(chipsWrap, fromShare || fromRestore || examples.length === 0 ? null : 0);

    // Swap both editors when a different example is chosen, then run it.
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        setEditorDoc(configView, examples[idx].config);
        setEditorDoc(labelsView, examples[idx].labels);
        syncChipsByIndex(chipsWrap, idx);
        forceRun();
      });
    });

    // Copy fills its payload at click time: this target-phase listener runs
    // before the kit's delegated one on the root.
    copyBtn.addEventListener('click', () => {
      copyBtn.dataset.copy = configView.state.doc.toString();
    });

    /** Copy link appears once a result exists, carrying both documents. */
    function setShare(cfg: string | null, lbl = ''): void {
      if (!shareBtn) return;
      shareBtn.hidden = cfg === null;
      shareBtn.dataset.copy = cfg === null ? '' : `${window.location.href.split('#')[0]}${encodeShare(cfg, lbl)}`;
    }

    // Run — non-blocking. A deliberate run shows the loading state and a
    // spinner in Run now; a live (debounced) or seed run is quiet. Only a
    // deliberate run rewrites the address bar; the seed never records a last
    // input (it is not something the visitor typed).
    type RunOpts = { live?: boolean; showErrors?: boolean; seed?: boolean };
    let running = false;
    let rerun: RunOpts | null = null;
    const runLabel = runBtn.querySelector<HTMLElement>('.amr-run-label');
    let spinner: HTMLElement | null = null;
    async function run(opts: RunOpts = {}): Promise<void> {
      // Guaranteed present by the early return in init(); restated because TypeScript
      // discards that narrowing inside a hoisted function declaration.
      if (!runBtn) return;
      const live = opts.live === true;
      const seeded = opts.seed === true;
      const quiet = live || seeded;
      if (running) {
        rerun = opts;
        return;
      }
      running = true;
      if (!quiet) {
        runBtn.classList.add('is-busy');
        runBtn.setAttribute('aria-disabled', 'true');
        runBtn.setAttribute('aria-busy', 'true');
        if (!spinner) {
          spinner = document.createElement('span');
          spinner.setAttribute('aria-hidden', 'true');
          spinner.style.cssText =
            'display:inline-block;width:14px;height:14px;flex:0 0 auto;border-radius:50%;' +
            'border:2px solid currentColor;border-top-color:transparent;';
          if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            spinner.animate([{ transform: 'rotate(0deg)' }, { transform: 'rotate(360deg)' }], {
              duration: 700,
              iterations: Infinity,
            });
          }
          runBtn.insertBefore(spinner, runBtn.firstChild);
        }
        if (runLabel) runLabel.textContent = 'Running…';
        renderLoading(resultsBox!, summaryEl!);

        await new Promise<void>((resolve) => {
          if ('requestAnimationFrame' in window) {
            requestAnimationFrame(() => resolve());
          } else {
            setTimeout(resolve, 0);
          }
        });
      }

      try {
        const cfg = configView.state.doc.toString();
        const lbl = labelsView.state.doc.toString();
        const result = await Promise.resolve(engine.matchRoute(cfg, lbl));
        const failed = !result || result.ok === false || Boolean(result.error);
        if (live && failed && opts.showErrors !== true) {
          // Hold the last good panel; reveal the error only after a longer idle.
          window.clearTimeout(errorHoldTimer);
          errorHoldTimer = window.setTimeout(() => void run({ live: true, showErrors: true }), ERROR_HOLD_MS);
        } else {
          renderResults(resultsBox!, summaryEl!, result);
          setShare(failed ? null : cfg, lbl);
          if (!quiet) {
            try {
              window.history.replaceState(null, '', encodeShare(cfg, lbl));
            } catch {
              /* non-fatal: sharing just won't update */
            }
          }
        }
        if (!seeded && !failed) recordToolLastInput(SLUG, JSON.stringify({ config: cfg, labels: lbl }));
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Unexpected error while evaluating.';
        renderError(resultsBox!, summaryEl!, msg);
        setShare(null);
      } finally {
        running = false;
        runBtn.classList.remove('is-busy');
        runBtn.removeAttribute('aria-disabled');
        runBtn.removeAttribute('aria-busy');
        if (spinner) {
          spinner.remove();
          spinner = null;
        }
        if (runLabel) runLabel.textContent = 'Run now';
        if (rerun) {
          const next = rerun;
          rerun = null;
          void run(next);
        }
      }
    }

    runBtn.addEventListener('click', () => forceRun());

    // ⌘/Ctrl+Enter anywhere else in the playground (a chip, Run now); inside
    // an editor the Mod-Enter binding has already handled it.
    root.addEventListener('keydown', (e) => {
      if (e.defaultPrevented) return;
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        forceRun();
      }
    });

    // Save-snapshot + auto-restore-last-input — a normal tool (unlike the 4
    // secret-input tools), so both halves of tool-state/wire are wired here.
    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () =>
        JSON.stringify({
          config: configView.state.doc.toString(),
          labels: labelsView.state.doc.toString(),
        }),
      setValue: (value) => {
        let parsed: { config?: unknown; labels?: unknown };
        try {
          parsed = JSON.parse(value) as { config?: unknown; labels?: unknown };
        } catch {
          return;
        }
        const config = typeof parsed.config === 'string' ? parsed.config : '';
        const labels = typeof parsed.labels === 'string' ? parsed.labels : '';
        syncChipsByIndex(chipsWrap, null);
        setEditorDoc(configView, config);
        setEditorDoc(labelsView, labels);
        forceRun();
      },
    });

    // The panel is already server-rendered from `examples[0]`: re-run over
    // whatever the editors hold (that seed, a deep link or a restored input)
    // quietly, so client state matches the markup without a loading flash.
    void run({ seed: true });
    // Only now may keystrokes drive the panel (seed dispatches must not).
    liveReady = true;
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
