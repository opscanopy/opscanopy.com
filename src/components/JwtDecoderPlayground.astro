---
/**
 * JwtDecoderPlayground — the interactive JWT Decoder & Encoder island.
 *
 * Three modes behind a segmented control, all fully client-side:
 *  - Decode & verify: paste a compact JWS and see header/payload as pretty
 *    JSON, registered claims with plain-English captions, security lint
 *    warnings, and an async signature verification (HS/RS/PS/ES/EdDSA against
 *    a secret, SPKI PEM, JWK, or JWKS).
 *  - Encode & sign: edit header + payload JSON, pick an algorithm, paste a
 *    secret or private key, and get a signed token live.
 *  - Generate keys: mint an HMAC secret or an RSA/EC/Ed25519 key pair and
 *    export it as PEM + JWK.
 *
 * Runtime contract (lazy-imported):
 *   ../lib/jwt-decoder/engine
 *     → decode(token, nowMs?): JwtResult
 *     → verify(token, keyInput, opts?): Promise<VerifyResult>
 *     → sign(headerJson, payloadJson, keyInput, opts): Promise<SignResult>
 *     → generateKeys(req): Promise<KeygenResult>
 *     → SIGNING_ALGS, edDsaSupported()
 *   ../lib/jwt-decoder/examples → examples: { id; label; token; key? }[]
 *
 * No share links and no auto-restore anywhere in this tool — inputs may be
 * secrets. Snapshots stay opt-in (decode mode only).
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar, and one ResultPanel per mode (prefixes `jwt`,
 * `jwt-enc`, `jwt-keys` — each with its own live summary and copy status, so
 * a copy in a visible mode is never announced into a hidden one). The
 * decode results container stays here, seeded with `set:html` +
 * `data-results`; slab overrides anchor on `.jwt-results` (all three).
 */
import { examples } from '../lib/jwt-decoder/examples';
import { decode } from '../lib/jwt-decoder/engine';
import { resultHtml, summaryText, verifyBlock, EMPTY_HTML } from '../lib/jwt-decoder/render';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';

/**
 * Server-rendered seed — the canonical HS256 sample, decoded at build time so
 * a no-JS visitor and every AI crawler (they do not execute JS) see a real
 * decoded header, payload and claims table rather than an empty panel.
 *
 * `decode()` needs no WebCrypto; signature VERIFICATION does, and is async and
 * key-dependent, so the server always renders the 'no-key' trust state and the
 * client upgrades it to pending → valid after boot. `nowMs` is pinned: this
 * example carries no exp/nbf, so the only clock-dependent string is the "(N
 * years ago)" suffix on iat, and a fixed instant keeps builds reproducible.
 */
const FIXED_NOW = Date.UTC(2026, 0, 1);
const seedExample = examples[0];
const seedResult = seedExample ? decode(seedExample.token, FIXED_NOW) : null;
const seedHtml =
  seedResult && seedResult.valid
    ? resultHtml(seedResult, verifyBlock('no-key', 'Add a key or secret to verify this signature.'), 'no-key')
    : EMPTY_HTML;
const seedSummary = seedResult && seedResult.valid ? summaryText(seedResult) : '';
const chipItems = examples.map((ex) => ({ label: ex.chip, ariaLabel: ex.label }));
---

<section class="jwt-pg" aria-label="JWT Decoder & Encoder playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    <div
      class="flex flex-wrap items-center gap-2 border-b border-hairline px-4 py-3 sm:px-5"
      role="group"
      aria-label="Playground mode"
    >
      <button id="jwt-mode-decode" type="button" class="jwt-mode-btn" aria-pressed="true" data-mode="decode">
        Decode &amp; verify
      </button>
      <button id="jwt-mode-encode" type="button" class="jwt-mode-btn" aria-pressed="false" data-mode="encode">
        Encode &amp; sign
      </button>
      <button id="jwt-mode-keys" type="button" class="jwt-mode-btn" aria-pressed="false" data-mode="keys">
        Generate keys
      </button>
    </div>

    <!-- ── Decode & verify ─────────────────────────────────────────────── -->
    <div id="jwt-panel-decode" class="jwt-panel" data-panel="decode">
      <div class="jwt-cols">
      <div class="jwt-cols__inputs">
      <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
        <span class="eyebrow">Examples</span>
        {/* Server-rendered so they work without JS; the script adopts them. */}
        <ExampleChips prefix="jwt" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Example tokens" />
      </div>

      <div class="border-b border-hairline px-4 py-4 sm:px-5">
        <label class="eyebrow mb-2 block" for="jwt-input">JWT</label>
        <textarea
          id="jwt-input"
          class="jwt-input code-mono"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          rows="5"
          placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
          aria-describedby="jwt-input-hint jwt-input-live">{seedExample?.token}</textarea>
        <RunHint id="jwt-input-live" />

        <label class="eyebrow mt-4 mb-2 block" for="jwt-secret"
          >Secret / public key / JWK / JWKS (optional)</label
        >
        <textarea
          id="jwt-secret"
          class="jwt-input code-mono jwt-key-input"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          rows="2"
          placeholder={'your-256-bit-secret   ·or·   -----BEGIN PUBLIC KEY-----…   ·or·   {"kty":"EC",…}   ·or·   {"keys":[…]}'}
          aria-describedby="jwt-input-hint">{seedExample?.key}</textarea>
        <label class="jwt-check mt-2">
          <input id="jwt-secret-b64u" type="checkbox" />
          <span>Secret is base64url-encoded <span class="text-mute">(HS256/384/512 only)</span></span>
        </label>
        <p class="jwt-hint caption text-mute">
          Treat pasted keys and secrets as live credentials — clipboard history and screenshots can
          leak them.
        </p>
        <p id="jwt-input-hint" class="jwt-hint caption text-mute">
          Verifies HS/RS/PS/ES 256–512
          and EdDSA against a shared secret, a PEM <span class="code-mono">BEGIN PUBLIC KEY</span>, a
          JWK, or a full JWKS (matched by <span class="code-mono">kid</span>).
        </p>
        <SnapshotBar prefix="jwt" />
        <p class="jwt-hint caption text-mute">
          Snapshots save only the token (never keys) to this browser's localStorage.
        </p>
      </div>
      </div>

      {/* ── Results panel — the L2 instrument (dark in both themes) under
          its figure cap; the live summary reads out in the cap's actions
          slot. The "Example" tag rides in the toolbar's actions slot. ── */}
      <ResultPanel slug="jwt-decoder" prefix="jwt" summary={seedSummary} class="jwt-cols__results" split>
        <Fragment slot="actions">
          <span id="jwt-example-tag-slot">{seedExample && <span class="jwt-example-tag">Example</span>}</span>
        </Fragment>
        <p class="jwt-noshare caption text-inverse-mute">No share links on this tool — inputs may be secrets.</p>
        {/* Seeded at build time (see `seedHtml` above) so the decoded token is
            in the static HTML; the client re-renders and then verifies. */}
        <div id="jwt-results" class="jwt-results" set:html={seedHtml} data-results></div>
      </ResultPanel>
      </div>
    </div>

    <!-- ── Encode & sign ───────────────────────────────────────────────── -->
    <div id="jwt-panel-encode" class="jwt-panel" data-panel="encode" hidden>
      <div class="jwt-cols">
      <div class="jwt-cols__inputs">
      <div class="border-b border-hairline px-4 py-4 sm:px-5">
        <label class="eyebrow mb-2 block" for="jwt-enc-alg">Algorithm</label>
        <div class="jwt-select-wrap relative min-w-0">
          <select id="jwt-enc-alg" class="jwt-select code-mono" autocomplete="off">
            <optgroup label="HMAC (shared secret)">
              <option value="HS256" selected>HS256</option>
              <option value="HS384">HS384</option>
              <option value="HS512">HS512</option>
            </optgroup>
            <optgroup label="RSA (RSASSA-PKCS1-v1_5)">
              <option value="RS256">RS256</option>
              <option value="RS384">RS384</option>
              <option value="RS512">RS512</option>
            </optgroup>
            <optgroup label="RSA-PSS">
              <option value="PS256">PS256</option>
              <option value="PS384">PS384</option>
              <option value="PS512">PS512</option>
            </optgroup>
            <optgroup label="ECDSA">
              <option value="ES256">ES256</option>
              <option value="ES384">ES384</option>
              <option value="ES512">ES512</option>
            </optgroup>
            <optgroup label="EdDSA">
              <option value="EdDSA">EdDSA (Ed25519)</option>
            </optgroup>
          </select>
          <svg
            class="jwt-select-caret pointer-events-none absolute top-1/2 right-3 h-4 w-4 -translate-y-1/2 text-mute"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 6l4 4 4-4"></path>
          </svg>
        </div>

        <label class="eyebrow mt-4 mb-2 block" for="jwt-enc-header">Header (JSON)</label>
        <textarea
          id="jwt-enc-header"
          class="jwt-input code-mono"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          rows="4"></textarea>

        <label class="eyebrow mt-4 mb-2 block" for="jwt-enc-payload">Payload (JSON)</label>
        <textarea
          id="jwt-enc-payload"
          class="jwt-input code-mono"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          rows="6"></textarea>

        <label class="eyebrow mt-4 mb-2 block" for="jwt-enc-key" id="jwt-enc-key-label">Secret</label>
        <textarea
          id="jwt-enc-key"
          class="jwt-input code-mono jwt-key-input"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          rows="2"></textarea>
        <label class="jwt-check mt-2" id="jwt-enc-b64u-row">
          <input id="jwt-enc-b64u" type="checkbox" />
          <span>Secret is base64url-encoded</span>
        </label>
        <p class="jwt-hint caption text-mute">
          Treat pasted keys and secrets as live credentials — clipboard history and screenshots can
          leak them.
        </p>
        <p class="jwt-hint caption text-mute">
          Signing uses the Web Crypto API. The token is built from minified JSON, so whitespace in
          the editors never changes the signature. Need a key? Use the <strong>Generate keys</strong>
          tab.
        </p>
      </div>

      </div>

      <ResultPanel slug="jwt-decoder" prefix="jwt-enc" label="Signed token" class="jwt-cols__results" split>
        <div id="jwt-enc-results" class="jwt-results">
          <p class="jwt-empty body-sm text-inverse-mute">
            Fill in the header, payload, and key to see the signed token here.
          </p>
        </div>
      </ResultPanel>
      </div>
    </div>

    <!-- ── Generate keys ───────────────────────────────────────────────── -->
    <div id="jwt-panel-keys" class="jwt-panel" data-panel="keys" hidden>
      <div class="border-b border-hairline px-4 py-4 sm:px-5">
        <div class="flex flex-wrap items-end gap-3">
          <div class="min-w-0">
            <label class="eyebrow mb-2 block" for="jwt-keys-kind">Key type</label>
            <div class="jwt-select-wrap relative min-w-0">
              <select id="jwt-keys-kind" class="jwt-select code-mono" autocomplete="off">
                <option value="hmac" selected>HMAC secret (HS256/384/512)</option>
                <option value="rsa">RSA key pair (RS*/PS*)</option>
                <option value="ec">EC key pair (ES256/384/512)</option>
                <option value="ed25519">Ed25519 key pair (EdDSA)</option>
              </select>
              <svg
                class="jwt-select-caret pointer-events-none absolute top-1/2 right-3 h-4 w-4 -translate-y-1/2 text-mute"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 6l4 4 4-4"></path>
              </svg>
            </div>
          </div>
          <div class="min-w-0" id="jwt-keys-param-wrap">
            <label class="eyebrow mb-2 block" for="jwt-keys-param">Size</label>
            <div class="jwt-select-wrap relative min-w-0">
              <select id="jwt-keys-param" class="jwt-select code-mono" autocomplete="off"></select>
              <svg
                class="jwt-select-caret pointer-events-none absolute top-1/2 right-3 h-4 w-4 -translate-y-1/2 text-mute"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 6l4 4 4-4"></path>
              </svg>
            </div>
          </div>
          <button id="jwt-keys-generate" type="button" class="jwt-generate-btn">Generate</button>
        </div>
        <p class="jwt-hint caption text-mute">
          Generated with the Web Crypto API. Great for tests and local development; production keys
          belong in your platform's KMS or secret manager.
        </p>
      </div>

      <ResultPanel slug="jwt-decoder" prefix="jwt-keys" label="Key material" split>
        <div id="jwt-keys-results" class="jwt-results">
          <p class="jwt-empty body-sm text-inverse-mute">
            Pick a key type and press Generate — the key appears here as PEM and JWK, with copy
            buttons.
          </p>
        </div>
      </ResultPanel>
    </div>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* REQ-2: inputs-left / live-results-right at desktop; natural stack below.
     minmax(0,…) is load-bearing — long tokens must wrap inside the column,
     never widen it (no horizontal scrollbar at any breakpoint). */
  @media (min-width: 1024px) {
    .jwt-cols {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: stretch;
    }
    /* The results column is ResultPanel's root (no scope attribute). */
    .jwt-cols > :global(.jwt-cols__results) {
      border-left: 1px solid var(--color-inverse-hairline);
    }
    /* The row separators are Tailwind border-b on the INNER section divs —
       kill the last one so no hairline dangles above the column's empty
       remainder when the results column is taller. */
    .jwt-cols__inputs > div:last-child {
      border-bottom: 0;
    }
  }

  /* "Example" tag in the result toolbar while a bundled example shows — it
     only ever sits on the slab, so slab inks (label role). */
  :global(.jwt-example-tag) {
    display: inline-flex;
    align-items: center;
    padding: 1px 8px;
    border-radius: var(--radius-xs);
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    @apply label-field;
    color: var(--color-inverse-mute);
  }
  .jwt-noshare {
    margin: 0 0 12px;
  }

  .jwt-mode-btn {
    flex: 0 0 auto;
    height: var(--control-h-md);
    padding: 0 14px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-brand-strong);
    font-size: 13px;
    line-height: 20px;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      box-shadow var(--dur-fast) var(--ease-brand),
      color var(--dur-fast) var(--ease-brand);
  }
  .jwt-mode-btn:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  /* REQ-9: the btn-primary recipe — theme-safe solid inversion (ink-on-cream
     light, cream-on-ink dark), unambiguous against the inactive canvas chips.
     NOT brand-strong fill (white-on-green fails AA in dark). */
  .jwt-mode-btn[aria-pressed='true'] {
    background: var(--color-primary);
    box-shadow: none;
    color: var(--color-on-primary);
    font-weight: 600;
  }
  /* Blue focus ring — visible against both the primary fill and canvas. */
  .jwt-mode-btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  @media (pointer: coarse) {
    .jwt-mode-btn {
      min-height: var(--control-h-lg);
    }
  }
  /* Phones: the three mode buttons wrapped onto 2-3 rows (121px) above the
     examples. They become one segmented row of equal widths; a long label may
     break inside its own button, which keeps the row to a single line. */
  @media (max-width: 639px) {
    [aria-label='Playground mode'] {
      flex-wrap: nowrap;
    }
    .jwt-mode-btn {
      flex: 1 1 0;
      min-width: 0;
      padding-inline: 8px;
      white-space: normal;
      text-align: center;
      line-height: 1.25;
    }
  }

  .jwt-select {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    height: var(--control-h-md);
    min-width: 0;
    max-width: 320px;
    padding: 0 32px 0 12px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 13px;
    line-height: 20px;
    cursor: pointer;
    text-overflow: ellipsis;
    touch-action: manipulation;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  @media (min-width: 640px) {
    .jwt-select {
      width: auto;
      min-width: 260px;
    }
  }
  .jwt-select:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .jwt-select:disabled {
    cursor: not-allowed;
    color: var(--color-mute);
    opacity: 0.7;
  }
  .jwt-select-wrap:hover .jwt-select-caret {
    color: var(--color-body);
  }

  .jwt-input {
    width: 100%;
    min-height: 116px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 13px;
    line-height: 20px;
    word-break: break-all;
    resize: vertical;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .jwt-key-input {
    min-height: 64px;
  }
  .jwt-input::placeholder {
    color: var(--color-mute);
  }
  .jwt-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .jwt-input:focus {
    outline: none;
  }
  .jwt-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .jwt-check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    cursor: pointer;
    user-select: none;
  }
  .jwt-check input {
    accent-color: var(--color-brand-strong);
    width: 14px;
    height: 14px;
  }
  .jwt-hint {
    margin-top: 8px;
    text-wrap: pretty;
  }
  .jwt-generate-btn {
    flex: 0 0 auto;
    height: var(--control-h-md);
    padding: 0 18px;
    border-radius: var(--radius-sm);
    border: none;
    background: var(--color-brand-soft);
    box-shadow: inset 0 0 0 1px var(--color-brand);
    color: var(--color-brand-strong);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      box-shadow var(--dur-fast) var(--ease-brand);
  }
  .jwt-generate-btn:hover {
    box-shadow: inset 0 0 0 1.5px var(--color-brand);
  }
  .jwt-generate-btn:disabled {
    cursor: wait;
    opacity: 0.6;
  }
  @media (pointer: coarse) {
    .jwt-generate-btn {
      min-height: var(--control-h-lg);
    }
  }
  .jwt-results {
    min-height: var(--control-h-lg);
  }

  /* ── Runtime-injected markup ─────────────────────────────────────────── */
  /* REQ-1 hero pill: icon + label + detail, tokens only (theme-safe). */
  :global(.jwt-pill) {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    padding: 10px 14px;
    margin-bottom: 12px;
    border-radius: var(--radius-md);
    font-size: 13px;
    line-height: 18px;
    animation: jwt-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.jwt-pill svg) {
    flex: 0 0 auto;
    align-self: center;
  }
  :global(.jwt-pill__label) {
    font-size: 13px;
    font-weight: 600;
  }
  :global(.jwt-pill__detail) {
    opacity: 0.9;
    word-break: break-word;
  }
  :global(.jwt-pill--valid) {
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
    box-shadow: inset 0 0 0 1px var(--color-brand);
  }
  :global(.jwt-pill--expired) {
    background: var(--color-error-soft);
    color: var(--color-error-deep);
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  :global(.jwt-pill--not-yet) {
    background: var(--color-warning-soft);
    color: var(--color-warning-deep);
    box-shadow: inset 0 0 0 1px var(--color-warning);
  }
  :global(.jwt-pill--none) {
    background: var(--color-canvas-soft);
    color: var(--color-mute);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }

  /* Partial-decode header block: same look as .jwt-block, but deliberately a
     DIFFERENT class — verifyOnly()/setVerifyBlock() treat .jwt-block as a
     verifiable result and would replace/eat this one. */
  :global(.jwt-block),
  :global(.jwt-partial-block) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: jwt-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.jwt-partial-block) {
    margin-top: 12px;
  }
  :global(.jwt-block + .jwt-block) {
    margin-top: 12px;
  }
  /* Block heading ("Header", "Payload", "Claims") — the group-heading
     role: sans 12/16 600 (global.css .result-panel__group-h), never one
     more mono caps label. */
  :global(.jwt-block__head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 14px 8px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    color: var(--color-ink);
  }
  :global(.jwt-block__meta) {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    color: var(--color-mute);
    white-space: nowrap;
  }
  :global(.jwt-block__caption) {
    margin: 0;
    padding: 6px 14px 0;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    color: var(--color-mute);
  }
  :global(.jwt-ref-row) {
    margin-top: 12px;
    display: flex;
  }
  :global(.jwt-code) {
    margin: 0;
    padding: 12px 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-ink);
    white-space: pre-wrap;
    word-break: break-word;
    overflow-x: auto;
  }
  :global(.jwt-sig) {
    padding: 12px 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-ink);
    white-space: pre-wrap;
    word-break: break-all;
  }

  /* Claim rows */
  :global(.jwt-row) {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 8px 14px;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-body);
  }
  :global(.jwt-row + .jwt-row) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.jwt-row__label) {
    flex: 0 0 auto;
    min-width: 132px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-mute);
  }
  :global(.jwt-row__value) {
    flex: 1 1 auto;
    word-break: break-word;
  }
  :global(.jwt-row__value--mono) {
    font-family: var(--font-mono);
    font-size: 12px;
  }
  :global(.jwt-row__caption) {
    display: block;
    margin-top: 2px;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 16px;
    color: var(--color-mute);
  }
  :global(.jwt-row--warn .jwt-row__value) {
    color: var(--color-warning-deep);
  }
  :global(.jwt-row--error .jwt-row__value) {
    color: var(--color-error-deep);
  }
  :global(.jwt-none) {
    padding: 10px 14px;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-mute);
  }

  /* Warnings list */
  :global(.jwt-warn) {
    display: flex;
    gap: 10px;
    padding: 8px 14px;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-warning-deep);
  }
  :global(.jwt-warn + .jwt-warn) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.jwt-warn__dot) {
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    margin-top: 6px;
    border-radius: 50%;
    background: var(--color-warning);
  }

  /* Verification line + badge */
  :global(.jwt-verify) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
  }
  :global(.jwt-badge) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    @apply label-field;
    line-height: 18px;
  }
  :global(.jwt-badge__dot) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  :global(.jwt-badge--valid) {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
    box-shadow: inset 0 0 0 1px var(--color-brand);
  }
  :global(.jwt-badge--invalid) {
    color: var(--color-error-deep);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  :global(.jwt-badge--muted) {
    color: var(--color-mute);
    background: var(--color-canvas-soft);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  :global(.jwt-verify__detail) {
    flex: 1 1 auto;
    color: var(--color-mute);
    word-break: break-word;
  }
  :global(.jwt-verify-warning) {
    padding: 0 14px 10px;
    font-size: 13px;
    line-height: 17px;
    color: var(--color-warning-deep);
  }

  /* Decode → encode handoff */
  :global(.jwt-actions) {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  :global(.jwt-action-btn) {
    flex: 0 0 auto;
    height: var(--control-h-md);
    padding: 0 12px;
    border-radius: var(--radius-pill);
    border: none;
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-brand-strong);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      box-shadow var(--dur-fast) var(--ease-brand);
  }
  :global(.jwt-action-btn:hover) {
    box-shadow: inset 0 0 0 1px var(--color-brand);
  }
  @media (pointer: coarse) {
    :global(.jwt-action-btn) {
      min-height: var(--control-h-lg);
    }
  }

  @keyframes jwt-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.jwt-block) {
      animation: none;
    }
  }

  :global(.jwt-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.jwt-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.jwt-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.jwt-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.jwt-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* Block copy (render.ts): the kit's labelled copy recipe — sentence case,
     sans; buttons are never uppercase. */
  :global(.jwt-copy-btn) {
    flex: 0 0 auto;
    padding: 1px 8px;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-mute);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 18px;
    cursor: pointer;
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
    transition:
      color var(--dur-fast) var(--ease-brand),
      box-shadow var(--dur-fast) var(--ease-brand);
  }
  :global(.jwt-copy-btn:hover) {
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-body);
  }

  /* REQ-12: explicit focus rings on every interactive control class (the
     global default is overridden by local shadows on several of these). */
  :global(.jwt-copy-btn:focus-visible),
  :global(.jwt-action-btn:focus-visible),
  .jwt-select:focus-visible,
  .jwt-generate-btn:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }

  /* ── Instrument re-skin — the three result panels are the L2 slab (dark
     in BOTH themes). Everything below uses the slab ink tier; the light
     rules above remain the documented defaults. ─────────────────────── */
  .jwt-results :global(.jwt-empty),
  .jwt-results :global(.jwt-block),
  .jwt-results :global(.jwt-partial-block) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .jwt-results :global(.jwt-empty) {
    color: var(--color-inverse-mute);
  }
  .jwt-results :global(.jwt-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .jwt-results :global(.jwt-block__head),
  .jwt-results :global(.jwt-row + .jwt-row),
  .jwt-results :global(.jwt-warn + .jwt-warn) {
    border-color: #ffffff12;
  }
  .jwt-results :global(.jwt-block__head),
  .jwt-results :global(.jwt-code),
  .jwt-results :global(.jwt-sig),
  .jwt-results :global(.jwt-row),
  .jwt-results :global(.jwt-verify) {
    color: var(--color-inverse-fg);
  }
  .jwt-results :global(.jwt-block__meta),
  .jwt-results :global(.jwt-block__caption),
  .jwt-results :global(.jwt-row__label),
  .jwt-results :global(.jwt-row__caption),
  .jwt-results :global(.jwt-none),
  .jwt-results :global(.jwt-verify__detail) {
    color: var(--color-inverse-mute);
  }
  .jwt-results :global(.jwt-row--warn .jwt-row__value),
  .jwt-results :global(.jwt-warn),
  .jwt-results :global(.jwt-verify-warning) {
    color: var(--color-inverse-accent);
  }
  .jwt-results :global(.jwt-warn__dot) {
    background: var(--color-inverse-accent);
  }
  .jwt-results :global(.jwt-row--error .jwt-row__value) {
    color: var(--color-inverse-error);
  }
  .jwt-results :global(.jwt-pill--valid),
  .jwt-results :global(.jwt-badge--valid) {
    background: #8fc97a1f;
    color: var(--color-inverse-brand);
    box-shadow: inset 0 0 0 1px var(--color-inverse-brand);
  }
  .jwt-results :global(.jwt-pill--expired),
  .jwt-results :global(.jwt-badge--invalid) {
    background: #ff9d9514;
    color: var(--color-inverse-error);
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
  }
  .jwt-results :global(.jwt-pill--not-yet) {
    background: #e0a45814;
    color: var(--color-inverse-accent);
    box-shadow: inset 0 0 0 1px var(--color-inverse-accent);
  }
  .jwt-results :global(.jwt-pill--none),
  .jwt-results :global(.jwt-badge--muted) {
    background: #ffffff0a;
    color: var(--color-inverse-mute);
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  /* The trust banner (render.ts) carries its paper colours as an inline
     style, one per state; on the slab each state maps to its slab ink.
     `!important` is the only way past an inline declaration. */
  .jwt-results :global(#jwt-trust-banner) {
    background: #ffffff0a !important;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline) !important;
    color: var(--color-inverse-mute) !important;
  }
  .jwt-results :global(#jwt-trust-banner[style*='--color-brand-soft']) {
    background: #8fc97a1f !important;
    box-shadow: inset 0 0 0 1px var(--color-inverse-brand) !important;
    color: var(--color-inverse-brand) !important;
  }
  .jwt-results :global(#jwt-trust-banner[style*='--color-warning-soft']) {
    background: #e0a45814 !important;
    box-shadow: inset 0 0 0 1px var(--color-inverse-accent) !important;
    color: var(--color-inverse-accent) !important;
  }
  .jwt-results :global(#jwt-trust-banner[style*='--color-error-soft']) {
    background: #ff9d9514 !important;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error) !important;
    color: var(--color-inverse-error) !important;
  }
  .jwt-results :global(.jwt-action-btn) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-brand);
  }
  .jwt-results :global(.jwt-action-btn:hover) {
    background: #ffffff14;
    box-shadow: inset 0 0 0 1px var(--color-inverse-brand);
  }
  .jwt-results :global(.jwt-copy-btn) {
    color: var(--color-inverse-mute);
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .jwt-results :global(.jwt-copy-btn:hover) {
    color: var(--color-inverse-fg);
    box-shadow: inset 0 0 0 1px var(--color-inverse-mute);
  }
  .jwt-results :global(.jwt-copy-btn[data-copied]) {
    color: var(--color-inverse-brand);
    box-shadow: inset 0 0 0 1px var(--color-inverse-brand);
  }
  .jwt-results :global(a) {
    color: var(--color-inverse-brand);
  }
</style>

<script>
  import { escapeHtml } from '../lib/escape-html';
  import type { JwtResult } from '../lib/jwt-decoder/types';
  import {
    EMPTY_HTML,
    errorHtml,
    copyBtnHtml,
    jsonBlock,
    resultHtml,
    summaryText,
    trustBanner,
    verifyBlock,
  } from '../lib/jwt-decoder/render';
  import { copyTextToClipboard } from '../lib/clipboard';
  import { setCopyStatus, STATUS_COPIED, STATUS_FAILED } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { readHandoffOnce } from '../lib/tool-state/handoff';
  import { wireSnapshotUI } from '../lib/tool-state/wire';
  import { wireRunKeys } from '../lib/run-keys';

  type ClaimTone = 'ok' | 'warn' | 'error';
  type ClaimRow = { label: string; value: string; mono?: boolean; tone?: ClaimTone; caption?: string };
  type Freshness = { state: 'valid' | 'expired' | 'not-yet' | 'none'; detail: string };
  // The engine's own shape — a hand-mirrored copy is how a type drifts.
  type VerifyStatus = 'valid' | 'invalid' | 'unsupported' | 'error';
  type VerifyResult = { status: VerifyStatus; detail: string; warning?: string };
  type SignResult = { ok: true; token: string } | { ok: false; error: string };
  type KeygenRequest =
    | { kind: 'hmac'; bytes: 32 | 48 | 64 }
    | { kind: 'rsa'; modulus: 2048 | 3072 | 4096 }
    | { kind: 'ec'; curve: 'P-256' | 'P-384' | 'P-521' }
    | { kind: 'ed25519' };
  type KeygenResult =
    | {
        ok: true;
        secretB64u?: string;
        publicPem?: string;
        privatePem?: string;
        publicJwk?: string;
        privateJwk?: string;
      }
    | { ok: false; error: string };
  type Example = { id: string; label: string; chip: string; token: string; key?: string };
  type EngineModule = {
    decode: (token: string, nowMs?: number) => JwtResult;
    stripBearer: (token: string) => string;
    verify: (token: string, keyInput: string, opts?: { secretBase64url?: boolean }) => Promise<VerifyResult>;
    sign: (
      headerJson: string,
      payloadJson: string,
      keyInput: string,
      opts: { alg: string; secretBase64url?: boolean },
    ) => Promise<SignResult>;
    generateKeys: (req: KeygenRequest) => Promise<KeygenResult>;
    edDsaSupported: () => Promise<boolean>;
  };

  const ROOT_SEL = '.jwt-pg';
  const DEBOUNCE_MS = 220;
  /** Extra hold before showing an encode error, so JSON edits never flash red. */
  const ERROR_HOLD_MS = 400;

  const HMAC_ALGS = new Set(['HS256', 'HS384', 'HS512']);
  const ALL_ALGS = new Set([
    'HS256', 'HS384', 'HS512',
    'RS256', 'RS384', 'RS512',
    'PS256', 'PS384', 'PS512',
    'ES256', 'ES384', 'ES512',
    'EdDSA',
  ]);

  const ENC_SEED_HEADER = '{\n  "alg": "HS256",\n  "typ": "JWT"\n}';
  const ENC_SEED_PAYLOAD = '{\n  "sub": "1234567890",\n  "name": "John Doe",\n  "iat": 1516239022\n}';
  const ENC_SEED_KEY = 'your-256-bit-secret';

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.jwtWired === 'true') return;
      root.dataset.jwtWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        const label = typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label,
          chip: typeof o.chip === 'string' && o.chip ? o.chip : label,
          token: typeof o.token === 'string' ? o.token : '',
          key: typeof o.key === 'string' && o.key ? o.key : undefined,
        } satisfies Example;
      })
      .filter((e) => e.token.length > 0);
  }

  function setSummary(summary: HTMLElement, text: string, isError = false): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '');
    container.innerHTML = EMPTY_HTML;
  }
  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    setSummary(summary, '');
    container.innerHTML = errorHtml('Can’t decode this token', message);
  }

  function renderResult(
    container: HTMLElement,
    summary: HTMLElement,
    result: JwtResult,
    verifyHtml: string,
    bannerState: 'no-key' | 'pending' | VerifyStatus,
  ): void {
    setSummary(summary, summaryText(result));
    container.innerHTML = resultHtml(result, verifyHtml, bannerState);
  }

  async function init(root: HTMLElement): Promise<void> {
    // ── Decode mode elements ──
    const input = el<HTMLTextAreaElement>(root, '#jwt-input');
    const secretInput = el<HTMLTextAreaElement>(root, '#jwt-secret');
    const secretB64u = el<HTMLInputElement>(root, '#jwt-secret-b64u');
    const chipsWrap = el<HTMLElement>(root, '#jwt-chips');
    const exampleTagSlot = el<HTMLElement>(root, '#jwt-example-tag-slot');
    const resultsBox = el<HTMLElement>(root, '#jwt-results');
    const summaryEl = el<HTMLElement>(root, '#jwt-summary');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#jwt-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#jwt-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#jwt-snap-delete');
    // ── Encode mode elements ──
    const encAlg = el<HTMLSelectElement>(root, '#jwt-enc-alg');
    const encHeader = el<HTMLTextAreaElement>(root, '#jwt-enc-header');
    const encPayload = el<HTMLTextAreaElement>(root, '#jwt-enc-payload');
    const encKey = el<HTMLTextAreaElement>(root, '#jwt-enc-key');
    const encKeyLabel = el<HTMLElement>(root, '#jwt-enc-key-label');
    const encB64u = el<HTMLInputElement>(root, '#jwt-enc-b64u');
    const encB64uRow = el<HTMLElement>(root, '#jwt-enc-b64u-row');
    const encResults = el<HTMLElement>(root, '#jwt-enc-results');
    const encStatus = el<HTMLElement>(root, '#jwt-enc-summary');
    // ── Keys mode elements ──
    const keysKind = el<HTMLSelectElement>(root, '#jwt-keys-kind');
    const keysParam = el<HTMLSelectElement>(root, '#jwt-keys-param');
    const keysParamWrap = el<HTMLElement>(root, '#jwt-keys-param-wrap');
    const keysGenerate = el<HTMLButtonElement>(root, '#jwt-keys-generate');
    const keysResults = el<HTMLElement>(root, '#jwt-keys-results');
    const keysStatus = el<HTMLElement>(root, '#jwt-keys-summary');

    if (
      !input || !secretInput || !secretB64u || !chipsWrap || !resultsBox || !summaryEl ||
      !snapSaveBtn || !snapSelect || !snapDeleteBtn ||
      !encAlg || !encHeader || !encPayload || !encKey || !encKeyLabel || !encB64u || !encB64uRow ||
      !encResults || !encStatus ||
      !keysKind || !keysParam || !keysParamWrap || !keysGenerate || !keysResults || !keysStatus
    ) {
      return;
    }

    let engine: EngineModule;
    let examples: Example[] = [];
    try {
      const [engineMod, examplesMod] = await Promise.all([
        import('../lib/jwt-decoder/engine'),
        import('../lib/jwt-decoder/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
    } catch (err) {
      renderError(resultsBox, summaryEl, 'The decoder engine failed to load. Reload the page to try again.');
      console.error('[JwtDecoder] engine import failed:', err);
      return;
    }

    // ── Copy plumbing — the kit's announcer, one per mode's ResultPanel ──
    // render.ts's block-copy buttons carry `data-copy-label` and their text
    // is the label itself; a block button with no payload copies its block's
    // <pre>. The status is the sr-only `#<prefix>-copy-status` of the panel
    // the button sits in, so a copy is announced in the mode on screen.
    function statusFor(btn: HTMLElement): HTMLElement | null {
      return btn.closest('[data-result-panel]')?.querySelector<HTMLElement>('[id$="-copy-status"]') ?? null;
    }
    async function handleCopy(btn: HTMLButtonElement): Promise<void> {
      const status = statusFor(btn);
      const text =
        btn.dataset.copy ??
        btn.closest('.jwt-block, .jwt-partial-block')?.querySelector('.jwt-code')?.textContent ??
        '';
      const ok = await copyTextToClipboard(text);
      if (ok) {
        const idle = btn.dataset.copyLabel ?? 'Copy';
        btn.textContent = 'Copied';
        btn.setAttribute('data-copied', '');
        setCopyStatus(status, STATUS_COPIED, false);
        window.clearTimeout(Number(btn.dataset.copyTimer));
        btn.dataset.copyTimer = String(
          window.setTimeout(() => {
            btn.textContent = idle;
            btn.removeAttribute('data-copied');
            if (status?.textContent === STATUS_COPIED) setCopyStatus(status, '', false);
          }, 1200),
        );
      } else {
        setCopyStatus(status, STATUS_FAILED, true);
      }
    }
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.jwt-results button[data-copy-label]');
      if (!btn) return;
      void handleCopy(btn);
    });

    // ── Mode switching ──
    const modeBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.jwt-mode-btn'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.jwt-panel'));
    let encodeSeeded = false;
    function setMode(mode: string): void {
      modeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== mode;
      });
      if (mode === 'encode' && !encodeSeeded) {
        encodeSeeded = true;
        if (!encHeader!.value.trim() && !encPayload!.value.trim()) {
          encHeader!.value = ENC_SEED_HEADER;
          encPayload!.value = ENC_SEED_PAYLOAD;
          encKey!.value = ENC_SEED_KEY;
        }
        evaluateEncode(true);
      }
    }
    modeBtns.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode ?? 'decode')));

    // Feature-detect Ed25519 once and grey out the affected options.
    void engine.edDsaSupported().then((ok) => {
      if (ok) return;
      const encOpt = encAlg!.querySelector<HTMLOptionElement>('option[value="EdDSA"]');
      if (encOpt) {
        encOpt.disabled = true;
        encOpt.textContent = 'EdDSA (not supported in this browser)';
      }
      const keyOpt = keysKind!.querySelector<HTMLOptionElement>('option[value="ed25519"]');
      if (keyOpt) {
        keyOpt.disabled = true;
        keyOpt.textContent = 'Ed25519 (not supported in this browser)';
      }
    });

    // ═════════════════════════ Decode & verify ═════════════════════════

    // One-click example chips (REQ-5) — native <button>s give Tab/Enter/Space
    // for free; aria-pressed marks the active one. The server renders them from
    // the same examples, so adopt those; build only when they are absent
    // (appending unconditionally doubled the row once the SSR seed landed).
    const ssrChips = Array.from(chipsWrap!.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));
    const adopt = ssrChips.length === examples.length;
    if (!adopt) ssrChips.forEach((c) => c.remove());
    if (!adopt) {
      examples.forEach((ex, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'chip';
        btn.dataset.exampleIdx = String(i);
        btn.setAttribute('aria-pressed', 'false');
        btn.setAttribute('aria-label', ex.label);
        btn.textContent = ex.chip;
        chipsWrap!.appendChild(btn);
      });
    }

    /** The token the input was last programmatically filled with, or null once the user edits. */
    let exampleToken: string | null = null;
    /** Single owner of chip active state, exampleToken, AND the "Example" result tag. */
    function setActiveChip(i: number | null): void {
      syncChipsByIndex(chipsWrap, i);
      exampleToken = i === null ? null : examples[i].token;
      if (exampleTagSlot) {
        exampleTagSlot.innerHTML = i === null ? '' : '<span class="jwt-example-tag">Example</span>';
      }
    }

    // Monotonic token guard so a slow verify() never overwrites a newer render.
    let runId = 0;
    /** The token behind the current SUCCESS render — '' for empty/error/partial. */
    let renderedToken = '';

    function verifyOpts(): { secretBase64url?: boolean } {
      return secretB64u!.checked ? { secretBase64url: true } : {};
    }

    function evaluate(): void {
      const value = input!.value;
      renderedToken = '';
      if (value.trim().length === 0) {
        runId++;
        renderEmpty(resultsBox!, summaryEl!);
        return;
      }

      const current = ++runId;
      let result: JwtResult | null = null;
      try {
        result = engine.decode(value);
      } catch {
        renderError(resultsBox!, summaryEl!, 'Unexpected error while decoding the token.');
        return;
      }
      if (!result || result.valid === false) {
        // REQ-3 partial success: the header decoded even though the payload
        // didn't — show it under the error. The block deliberately does NOT
        // carry .jwt-block (verifyOnly's setVerifyBlock would replace the
        // LAST .jwt-block on a secret-field keystroke and eat the header).
        if (result?.partial?.header) {
          setSummary(summaryEl!, result.partial.alg ?? '');
          resultsBox!.innerHTML =
            errorHtml('Can’t fully decode this token', result.error ?? 'Decode failed.') +
            '<div class="jwt-partial-block">' +
            `<div class="jwt-block__head"><span>Header (decoded)</span><span style="display:flex;align-items:center;gap:8px;"><span class="jwt-block__meta">${escapeHtml(result.partial.alg ?? '')}</span>${copyBtnHtml()}</span></div>` +
            `<pre class="jwt-code">${escapeHtml(result.partial.header)}</pre>` +
            '</div>' +
            '<p class="jwt-none">Payload could not be decoded — header shown.</p>';
          return;
        }
        renderError(resultsBox!, summaryEl!, result?.error ?? 'This does not look like a JWT.');
        return;
      }

      const secret = secretInput!.value;
      const hasSecret = secret.trim().length > 0;
      const initialBanner: 'no-key' | 'pending' = hasSecret ? 'pending' : 'no-key';
      const initialVerify = hasSecret
        ? verifyBlock('pending', 'Checking the signature with the supplied secret / key…')
        : verifyBlock('no-key', 'Add a secret, PEM public key, JWK, or JWKS above to verify the signature.');
      renderResult(resultsBox!, summaryEl!, result, initialVerify, initialBanner);
      renderedToken = engine.stripBearer(value);

      // REQ-7 copy payloads — assigned via dataset AFTER innerHTML so
      // newlines/quotes never round-trip through an HTML attribute.
      const jsonBtn = resultsBox!.querySelector<HTMLButtonElement>('[data-copy-all]');
      if (jsonBtn) {
        try {
          jsonBtn.dataset.copy = JSON.stringify(
            { header: JSON.parse(result.header ?? '{}'), payload: JSON.parse(result.payload ?? '{}') },
            null,
            2,
          );
        } catch {
          /* header/payload are engine-produced JSON; parse cannot realistically fail */
        }
      }
      const bearerBtn = resultsBox!.querySelector<HTMLButtonElement>('[data-jwt-copy-bearer]');
      if (bearerBtn) bearerBtn.dataset.copy = `Authorization: Bearer ${renderedToken}`;

      if (!hasSecret) return;

      void engine
        .verify(value, secret, verifyOpts())
        .then((res) => {
          if (current !== runId) return; // a newer evaluate() superseded this one
          patchVerify(res);
        })
        .catch(() => {
          if (current !== runId) return;
          patchVerify({ status: 'error', detail: 'Verification failed unexpectedly.' });
        });
    }

    /** Replace just the verification block in place (header/payload/claims stay put). */
    function setVerifyBlock(
      status: VerifyStatus | 'pending' | 'no-key',
      detail: string,
      warning?: string,
    ): void {
      const blocks = resultsBox!.querySelectorAll('.jwt-block');
      const last = blocks[blocks.length - 1];
      if (!last) return;
      const tmp = document.createElement('div');
      tmp.innerHTML = verifyBlock(status, detail, warning);
      const fresh = tmp.firstElementChild;
      if (fresh) last.replaceWith(fresh);
    }

    /** Replace just the trust banner at the top of results. */
    function patchTrustBanner(state: 'no-key' | 'pending' | VerifyStatus): void {
      const existing = resultsBox!.querySelector('#jwt-trust-banner');
      if (!existing) return;
      const tmp = document.createElement('div');
      tmp.innerHTML = trustBanner(state);
      const fresh = tmp.firstElementChild;
      if (fresh) existing.replaceWith(fresh);
    }

    function patchVerify(res: VerifyResult): void {
      setVerifyBlock(res.status, res.detail, res.warning);
      patchTrustBanner(res.status);
    }

    /** Editing only the secret must not re-decode / re-flash the whole panel — just re-verify. */
    function verifyOnly(): void {
      const value = input!.value;
      // The trust banner only exists on a decode SUCCESS render — its absence
      // means an error/partial state is showing, which has no verify block to
      // patch. And when the token field changed but its debounce hasn't fired
      // yet, patching would verify a DIFFERENT token than the blocks on
      // screen — full re-evaluate is the safe path in both cases.
      if (
        value.trim().length === 0 ||
        !resultsBox!.querySelector('#jwt-trust-banner') ||
        engine.stripBearer(value) !== renderedToken
      ) {
        scheduleEvaluate();
        return;
      }
      const secret = secretInput!.value;
      const current = ++runId;
      if (secret.trim().length === 0) {
        setVerifyBlock('no-key', 'Add a secret, PEM public key, JWK, or JWKS above to verify the signature.');
        patchTrustBanner('no-key');
        return;
      }
      // Show "Verifying…" cue immediately so the previous result doesn't look stale.
      setVerifyBlock('pending', 'Checking the signature with the supplied secret / key…');
      patchTrustBanner('pending');
      void engine
        .verify(value, secret, verifyOpts())
        .then((res) => { if (current === runId) patchVerify(res); })
        .catch(() => { if (current === runId) patchVerify({ status: 'error', detail: 'Verification failed unexpectedly.' }); });
    }

    let timer: number | undefined;
    function scheduleEvaluate(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(evaluate, DEBOUNCE_MS);
    }
    let secretTimer: number | undefined;
    function scheduleVerifyOnly(): void {
      window.clearTimeout(secretTimer);
      secretTimer = window.setTimeout(verifyOnly, DEBOUNCE_MS);
    }

    function onUserInput(): void {
      setActiveChip(null);
      scheduleEvaluate();
    }

    input.addEventListener('input', onUserInput);
    const runNow = (): void => {
      window.clearTimeout(timer);
      evaluate();
    };
    // One JWT-specific guard, registered BEFORE wireRunKeys so it can claim
    // the key: a bare Enter while the WHOLE value is selected (the REQ-6
    // select-all just ran) must not let the newline replace the selection —
    // that would wipe the token the moment the user follows the hint line.
    // Everything else is the shared contract below.
    input.addEventListener('keydown', (ev) => {
      if (ev.key !== 'Enter' || ev.isComposing || ev.ctrlKey || ev.metaKey) return;
      if (
        input!.value.length > 0 &&
        input!.selectionStart === 0 &&
        input!.selectionEnd === input!.value.length
      ) {
        ev.preventDefault();
        ev.stopImmediatePropagation();
        runNow();
      }
    });
    // Playground UX contract: Ctrl/⌘+Enter runs immediately (and blurs on
    // coarse pointers); bare Enter lets the newline insert, then flushes.
    wireRunKeys(input, runNow, { enter: 'insert-then-run' });
    // Editing only the secret (or its encoding) re-verifies in place.
    secretInput.addEventListener('input', scheduleVerifyOnly);
    secretB64u.addEventListener('change', () => verifyOnly());
    chipsWrap.addEventListener('click', (ev) => {
      const chip = (ev.target as HTMLElement).closest<HTMLButtonElement>(CHIP_SELECTOR);
      if (!chip || !chipsWrap!.contains(chip)) return;
      const idx = Number(chip.dataset.exampleIdx);
      if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
      input.value = examples[idx].token;
      // Bundled examples carry their matching key so "verified" is one click;
      // examples without one clear the field to avoid stale-key confusion.
      secretInput.value = examples[idx].key ?? '';
      secretB64u.checked = false;
      setActiveChip(idx);
      window.clearTimeout(timer);
      evaluate();
    });

    // REQ-6: a paste while the bundled example still fills the input REPLACES
    // it wholesale (no accidental concatenation); focusing selects-all so
    // typing overwrites naturally too.
    input.addEventListener('paste', (ev) => {
      if (exampleToken === null || input.value.trim() !== exampleToken) return;
      ev.preventDefault();
      input.value = ev.clipboardData?.getData('text') ?? '';
      secretInput.value = '';
      setActiveChip(null);
      window.clearTimeout(timer);
      evaluate();
    });
    input.addEventListener('focus', () => {
      if (exampleToken !== null && input.value.trim() === exampleToken) input.select();
    });

    // Decode → encode handoff (delegated: the button is re-rendered each eval).
    resultsBox.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest('[data-jwt-open-encoder]');
      if (!btn) return;
      const decoded = engine.decode(input!.value);
      if (!decoded.valid) return;
      encHeader!.value = decoded.header ?? '{}';
      encPayload!.value = decoded.payload ?? '{}';
      encodeSeeded = true;
      if (decoded.alg && ALL_ALGS.has(decoded.alg)) {
        encAlg!.value = decoded.alg;
      }
      syncEncKeyUi();
      setMode('encode');
      evaluateEncode(true);
    });

    // Save-snapshot only — this tool is hard-excluded from auto-restore-last-input
    // (its input may be a secret), so there is no getRestoredLastInput() seed here.
    wireSnapshotUI({
      slug: 'jwt-decoder',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => input!.value.trim(),
      setValue: (value) => {
        input!.value = value;
        setActiveChip(null);
        window.clearTimeout(timer);
        evaluate();
      },
    });

    // ═════════════════════════ Encode & sign ═══════════════════════════

    let encRunId = 0;
    let encTimer: number | undefined;
    let encErrTimer: number | undefined;
    /** The token currently rendered in the encode results, '' when none. */
    let encRendered = '';

    function syncEncKeyUi(): void {
      const isHmac = HMAC_ALGS.has(encAlg!.value);
      encKeyLabel!.textContent = isHmac ? 'Secret' : 'Private key (PKCS8 PEM or JWK)';
      encB64uRow!.hidden = !isHmac;
    }

    function renderEncToken(token: string): void {
      window.clearTimeout(encErrTimer);
      // Idempotent: an unchanged token (e.g. a blur-triggered re-sign) must
      // NOT replace the DOM — swapping nodes mid-click swallows the user's
      // press on the "Open in decoder" button.
      if (token === encRendered && encResults!.querySelector('.jwt-code')) return;
      encRendered = token;
      const segs = token.split('.');
      encStatus!.textContent = `${encAlg!.value} · ${token.length} chars`;
      encResults!.innerHTML =
        jsonBlock('Compact JWS', token, `${segs.length} segments`) +
        '<div class="jwt-actions"><button type="button" class="jwt-action-btn" data-jwt-open-decoder>Open in decoder →</button></div>';
    }

    function renderEncError(message: string): void {
      encRendered = '';
      encStatus!.textContent = '';
      encResults!.innerHTML = errorHtml('Can’t sign yet', message);
    }

    /**
     * Live signing with the calm-error contract: a success renders
     * immediately, but an error is held ~ERROR_HOLD_MS after the debounce so
     * a half-typed JSON edit never flashes red. `immediate` (Enter/blur/mode
     * switch) skips the hold.
     */
    function evaluateEncode(immediate: boolean): void {
      const current = ++encRunId;
      const alg = encAlg!.value;
      void engine
        .sign(encHeader!.value, encPayload!.value, encKey!.value, {
          alg,
          secretBase64url: !encB64uRow!.hidden && encB64u!.checked,
        })
        .then((res) => {
          if (current !== encRunId) return;
          if (res.ok) {
            renderEncToken(res.token);
            return;
          }
          if (immediate) {
            renderEncError(res.error);
          } else {
            window.clearTimeout(encErrTimer);
            encErrTimer = window.setTimeout(() => {
              if (current === encRunId) renderEncError(res.error);
            }, ERROR_HOLD_MS);
          }
        })
        .catch(() => {
          if (current === encRunId) renderEncError('Signing failed unexpectedly.');
        });
    }

    function scheduleEncode(): void {
      window.clearTimeout(encTimer);
      encTimer = window.setTimeout(() => evaluateEncode(false), DEBOUNCE_MS);
    }

    encHeader.addEventListener('input', () => {
      // Typing a recognised alg into the header JSON updates the selector.
      try {
        const parsed = JSON.parse(encHeader!.value) as Record<string, unknown>;
        const alg = typeof parsed.alg === 'string' ? parsed.alg : '';
        if (ALL_ALGS.has(alg) && alg !== encAlg!.value) {
          encAlg!.value = alg;
          syncEncKeyUi();
        }
      } catch {
        /* defer sync until the JSON parses */
      }
      scheduleEncode();
    });
    encPayload.addEventListener('input', scheduleEncode);
    encKey.addEventListener('input', scheduleEncode);
    encB64u.addEventListener('change', () => evaluateEncode(true));
    for (const ta of [encHeader, encPayload, encKey]) {
      ta.addEventListener('blur', () => {
        window.clearTimeout(encTimer);
        evaluateEncode(true);
      });
    }

    encAlg.addEventListener('change', () => {
      // Changing the selector rewrites header.alg, preserving other members.
      try {
        const parsed = JSON.parse(encHeader!.value) as Record<string, unknown>;
        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
          parsed.alg = encAlg!.value;
          encHeader!.value = JSON.stringify(parsed, null, 2);
        }
      } catch {
        /* invalid JSON — sign() forces alg anyway; sync once it parses */
      }
      syncEncKeyUi();
      evaluateEncode(true);
    });

    // Encode → decode handoff. For HMAC the same secret verifies, so it rides
    // along; asymmetric keys do NOT (the decoder needs the public half).
    encResults.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest('[data-jwt-open-decoder]');
      if (!btn) return;
      const tokenEl = encResults!.querySelector('.jwt-code');
      const token = tokenEl?.textContent ?? '';
      if (!token) return;
      input!.value = token;
      setActiveChip(null);
      if (HMAC_ALGS.has(encAlg!.value)) {
        secretInput!.value = encKey!.value;
        secretB64u!.checked = !encB64uRow!.hidden && encB64u!.checked;
      }
      setMode('decode');
      evaluate();
    });

    // ═════════════════════════ Generate keys ═══════════════════════════

    const PARAM_OPTIONS: Record<string, { label: string; options: [string, string][] } | null> = {
      hmac: {
        label: 'Length',
        options: [
          ['32', '32 bytes (HS256)'],
          ['48', '48 bytes (HS384)'],
          ['64', '64 bytes (HS512)'],
        ],
      },
      rsa: {
        label: 'Modulus',
        options: [
          ['2048', '2048 bits'],
          ['3072', '3072 bits'],
          ['4096', '4096 bits'],
        ],
      },
      ec: {
        label: 'Curve',
        options: [
          ['P-256', 'P-256 (ES256)'],
          ['P-384', 'P-384 (ES384)'],
          ['P-521', 'P-521 (ES512)'],
        ],
      },
      ed25519: null,
    };

    function syncKeysParams(): void {
      const conf = PARAM_OPTIONS[keysKind!.value];
      if (!conf) {
        keysParamWrap!.hidden = true;
        return;
      }
      keysParamWrap!.hidden = false;
      keysParamWrap!.querySelector('label')!.textContent = conf.label;
      keysParam!.innerHTML = '';
      for (const [value, label] of conf.options) {
        const opt = document.createElement('option');
        opt.value = value;
        opt.textContent = label;
        keysParam!.appendChild(opt);
      }
    }
    keysKind.addEventListener('change', syncKeysParams);
    syncKeysParams();

    let keysBusy = false;
    keysGenerate.addEventListener('click', () => {
      if (keysBusy) return;
      keysBusy = true;
      keysGenerate!.disabled = true;
      keysGenerate!.textContent = 'Generating…';
      keysStatus!.textContent = '';

      let req: KeygenRequest;
      switch (keysKind!.value) {
        case 'rsa':
          req = { kind: 'rsa', modulus: Number(keysParam!.value) as 2048 | 3072 | 4096 };
          break;
        case 'ec':
          req = { kind: 'ec', curve: keysParam!.value as 'P-256' | 'P-384' | 'P-521' };
          break;
        case 'ed25519':
          req = { kind: 'ed25519' };
          break;
        default:
          req = { kind: 'hmac', bytes: Number(keysParam!.value) as 32 | 48 | 64 };
      }

      void engine
        .generateKeys(req)
        .then((res) => {
          if (!res.ok) {
            keysResults!.innerHTML = errorHtml('Key generation failed', res.error);
            return;
          }
          const blocks: string[] = [];
          if (res.secretB64u) blocks.push(jsonBlock('Secret (base64url)', res.secretB64u));
          if (res.publicPem) blocks.push(jsonBlock('Public key (PEM · SPKI)', res.publicPem));
          if (res.privatePem) blocks.push(jsonBlock('Private key (PEM · PKCS8)', res.privatePem));
          if (res.publicJwk) blocks.push(jsonBlock('Public key (JWK)', res.publicJwk));
          if (res.privateJwk) blocks.push(jsonBlock('Private key (JWK)', res.privateJwk));
          keysResults!.innerHTML = blocks.join('');
          keysStatus!.textContent = res.secretB64u ? 'secret generated' : 'key pair generated';
        })
        .catch(() => {
          keysResults!.innerHTML = errorHtml('Key generation failed', 'Unexpected error — try again.');
        })
        .finally(() => {
          keysBusy = false;
          keysGenerate!.disabled = false;
          keysGenerate!.textContent = 'Generate';
        });
    });

    // ═════════════════════════ First paint ═════════════════════════════

    // Seed priority: a secret-safe handoff (e.g. from Base64's "Decode as
    // JWT" chip) > the first example. A handoff is a one-time read — it
    // never lingers for a later visit.
    const handoff = readHandoffOnce();
    if (handoff) {
      input.value = handoff;
      setActiveChip(null);
      evaluate();
    } else {
      const seed = examples[0];
      if (seed) {
        input.value = seed.token;
        secretInput.value = seed.key ?? '';
        setActiveChip(0);
        evaluate();
      } else {
        renderEmpty(resultsBox, summaryEl);
      }
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
