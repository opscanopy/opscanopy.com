---
/**
 * DataSizeConverterPlayground — the interactive Data Size & Transfer-Rate island.
 *
 * Two plain single-line inputs, no CodeMirror (one short token each — the
 * chmod-calculator / subnet-calculator precedent). Band 1 converts a size and
 * prints the exact bit/byte counts plus the paired SI|IEC ladder; band 2 is
 * optional and divides that size by a link speed, always showing a 90%-of-line-
 * rate row next to the theoretical best case. Everything is exact BigInt
 * rational math, and the state is shareable via `#q=`.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar, ResultPanel (figure cap, live summary, copy status)
 * and CopyButton. The results container stays here, seeded with
 * `set:html` + `data-results`; its slab overrides anchor on `.dsz-results`.
 *
 * Runtime contract (engine lazy-imported inside boot, for code-splitting):
 *   ../lib/data-size/engine → convert(input): ConvertResult
 *                             transferTime(size, rate): TransferResult
 *                             significantLadder(ladder): LadderPair[]
 *                             encodeState(state) / parseState(fragment)
 *                             decodeState(): DataSizeState | null
 */
import { examples } from '../lib/data-size/examples';
import { convert, transferTime, significantLadder } from '../lib/data-size/engine';
import { resultHtml, EMPTY_HTML } from '../lib/data-size/render';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-computes the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees a real worked answer
 * instead of an empty "type something here" panel.
 *
 * `convert` / `transferTime` are pure and synchronous (exact BigInt math), so
 * they run at build time unchanged.
 */
const seedExample = examples[0];
const seedResult = seedExample ? convert(seedExample.size) : null;
const seedTransfer =
  seedExample && seedExample.rate && seedResult?.valid
    ? transferTime(seedExample.size, seedExample.rate)
    : null;
const seedValid = !!(seedResult && seedResult.valid && (!seedTransfer || seedTransfer.valid));
const localePrefix = Astro.currentLocale && Astro.currentLocale !== 'en' ? `/${Astro.currentLocale}` : '';
const seedHtml =
  seedValid && seedResult
    ? resultHtml(seedResult, seedTransfer, significantLadder(seedResult.ladder ?? []), { localePrefix })
    : EMPTY_HTML;
const seedSummary =
  seedValid && seedResult
    ? seedTransfer?.valid && seedTransfer.summary
      ? seedTransfer.summary
      : (seedResult.summary ?? '')
    : '';
const seedDetection =
  seedValid && seedResult?.detection ? `Detected: ${seedResult.detection.caption}` : '';
const chipItems = examples.map((ex) => ({
  label: ex.label,
  input: ex.size,
  ariaLabel: `${ex.label} — ${ex.size}${ex.rate ? ` over ${ex.rate}` : ''}`,
}));
---

<section class="dsz-pg" aria-label="Data Size Converter playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: example chips ───────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow">Examples</span>
      <ExampleChips prefix="dsz" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
    </div>

    {/* ── Band 1: the size ─────────────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <label class="eyebrow mb-1 block" for="dsz-size">Data size</label>
      <p class="dsz-gloss caption text-mute">
        Two conventions share the same words: SI (<span class="code-mono" translate="no">kB</span>,
        <span class="code-mono" translate="no">MB</span>,
        <span class="code-mono" translate="no">GB</span>) counts in 1000s, IEC (<span
          class="code-mono"
          translate="no">KiB</span
        >, <span class="code-mono" translate="no">MiB</span>,
        <span class="code-mono" translate="no">GiB</span>) counts in 1024s — that is
        <span translate="no">ISO/IEC 80000-13</span>. Drives are sold in SI; Windows,
        <span class="code-mono" translate="no">ls -l</span> and Kubernetes report in IEC.
      </p>
      <div class="dsz-input-wrap mt-2">
        <svg
          class="dsz-input-icon pointer-events-none"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <ellipse cx="10" cy="5.75" rx="6.25" ry="2.5"></ellipse>
          <path d="M3.75 5.75v8.5c0 1.38 2.8 2.5 6.25 2.5s6.25-1.12 6.25-2.5v-8.5"></path>
          <path d="M3.75 10c0 1.38 2.8 2.5 6.25 2.5s6.25-1.12 6.25-2.5"></path>
        </svg>
        <input
          id="dsz-size"
          type="text"
          class="dsz-input code-mono"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          enterkeyhint="done"
          placeholder="1.5 GiB"
          value={seedExample?.size}
          aria-describedby="dsz-size-detect dsz-size-hint dsz-run-hint"
        />
      </div>
      <p id="dsz-size-detect" class="dsz-detect caption">{seedDetection}</p>
      <p id="dsz-size-hint" class="dsz-hint caption text-mute">
        A bare number means bytes. <span class="code-mono" translate="no">b</span> is always bits and
        <span class="code-mono" translate="no">B</span> always bytes, so
        <span class="code-mono" translate="no">128 Mb</span> is not
        <span class="code-mono" translate="no">128 MB</span>. Kubernetes forms like
        <span class="code-mono" translate="no">500Gi</span> work too.
      </p>
      <RunHint id="dsz-run-hint" />
    </div>

    {/* ── Band 2: the link speed (optional) ────────────────────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <label class="eyebrow mb-1 block" for="dsz-rate">
        Link speed <span class="dsz-optional">optional</span>
      </label>
      <p class="dsz-gloss caption text-mute">
        A link speed is a <em>line rate</em> in bits per second — the ceiling, not the throughput.
        <span class="code-mono" translate="no">1 Gbps</span> moves at most
        <span class="code-mono" translate="no">125 MB</span> per second, before TCP, TLS and
        filesystem overhead.
      </p>
      <div class="dsz-input-wrap mt-2">
        <svg
          class="dsz-input-icon pointer-events-none"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M2.5 14.5h15"></path>
          <path d="M5.5 14.5v-3.5"></path>
          <path d="M10 14.5V7.5"></path>
          <path d="M14.5 14.5v-10"></path>
        </svg>
        <input
          id="dsz-rate"
          type="text"
          class="dsz-input code-mono"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          enterkeyhint="done"
          placeholder="1 Gbps"
          value={seedExample?.rate}
          aria-describedby="dsz-rate-hint"
        />
      </div>
      <p id="dsz-rate-hint" class="dsz-hint caption text-mute">
        Leave empty to skip the transfer maths. Accepts
        <span class="code-mono" translate="no">1 Gbps</span>,
        <span class="code-mono" translate="no">100 Mb/s</span>,
        <span class="code-mono" translate="no">50 MB/s</span> or
        <span class="code-mono" translate="no">1.5 MiB/s</span>.
      </p>
      <SnapshotBar prefix="dsz" />
    </div>

    {/* ── Results panel — the L2 instrument (dark in both themes) under its
        figure cap; the live summary reads out in the cap's actions slot. ── */}
    <ResultPanel slug="data-size-converter" prefix="dsz" summary={seedSummary} split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="dsz-share" />
        <CopyButton kind="all" id="dsz-copy-all" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the exact byte count is
          in the static HTML; the script re-renders it into this same node. */}
      <div id="dsz-results" class="dsz-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* ── Inputs ─────────────────────────────────────────────────────────── */
  .dsz-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .dsz-input-icon {
    position: absolute;
    left: 14px;
    width: 18px;
    height: 18px;
    color: var(--color-mute);
  }
  .dsz-input {
    width: 100%;
    height: var(--control-h-lg);
    padding: 0 16px 0 42px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 15px;
    line-height: 24px;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .dsz-input::placeholder {
    color: var(--color-mute);
  }
  .dsz-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .dsz-input:focus {
    outline: none;
  }
  .dsz-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .dsz-input.dsz-input--error {
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  .dsz-input.dsz-input--error:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-error);
  }
  /* "optional" beside the field label — the label-field caption role. */
  .dsz-optional {
    @apply label-field;
    margin-left: 4px;
  }
  .dsz-gloss {
    max-width: 68ch;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .dsz-gloss .code-mono,
  .dsz-hint .code-mono {
    font-size: 12px;
  }
  .dsz-hint {
    margin-top: 8px;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  /* The live detection line: same caption weight, brand ink when it reads. */
  .dsz-detect {
    margin-top: 8px;
    min-height: 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-brand-strong);
    overflow-wrap: anywhere;
  }
  .dsz-detect:empty {
    margin-top: 0;
    min-height: 0;
  }

  .dsz-results {
    min-height: 260px;
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.dsz-results` container (the panel
     wrapper is ResultPanel's and carries no scope attribute). */
  :global(.dsz-block) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: dsz-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.dsz-block + .dsz-block) {
    margin-top: 12px;
  }
  /* Block heading ("Exact size", "Transfer time", …) — the group-heading
     role: sans 12/16 600 ink (global.css .result-panel__group-h), never one
     more mono caps label. */
  :global(.dsz-block__head) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 10px;
    padding: 12px 14px 10px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    color: var(--color-ink);
  }
  /* Counts and units: mono metadata, also when it sits in a heading. */
  :global(.dsz-block__meta) {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }
  :global(.dsz-block__sub) {
    padding: 8px 14px;
    border-bottom: 1px solid var(--color-hairline);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-mute);
    text-wrap: pretty;
  }

  /* Key → value rows (exact size, transfer time) */
  :global(.dsz-rows) {
    margin: 0;
  }
  :global(.dsz-row) {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 2px 12px;
    padding: 9px 14px;
    align-items: baseline;
  }
  @media (max-width: 519px) {
    :global(.dsz-row) {
      grid-template-columns: 1fr;
    }
  }
  :global(.dsz-row + .dsz-row) {
    border-top: 1px solid var(--color-hairline);
  }
  /* Row-key role (label-field): mono 11/16 uppercase, the only label. */
  :global(.dsz-row__k) {
    @apply label-field;
  }
  :global(.dsz-row__gloss) {
    display: block;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 16px;
    letter-spacing: normal;
    text-transform: none;
    color: var(--color-mute);
    text-wrap: pretty;
  }
  :global(.dsz-row__v-wrap) {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    margin: 0;
  }
  :global(.dsz-row__v) {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 20px;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }
  :global(.dsz-row__v.is-hero) {
    font-size: 18px;
    line-height: 26px;
    font-weight: 600;
    color: var(--color-brand-strong);
  }
  :global(.dsz-row__cap) {
    display: block;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 16px;
    color: var(--color-mute);
  }

  /* The SI ↔ IEC ladder */
  :global(.dsz-rung) {
    padding: 10px 14px;
  }
  :global(.dsz-rung + .dsz-rung) {
    border-top: 1px solid var(--color-hairline);
  }
  /* Rung caption — the label-field role, laid out as a row. */
  :global(.dsz-rung__head) {
    @apply label-field;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }
  :global(.dsz-rung__gap) {
    flex: 0 0 auto;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-accent-ink);
  }
  :global(.dsz-rung__cells) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
    margin-top: 6px;
  }
  @media (min-width: 560px) {
    :global(.dsz-rung__cells) {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
  }
  :global(.dsz-cellbox) {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    padding: 5px 8px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-soft);
  }
  :global(.dsz-cellbox__u) {
    flex: 0 0 auto;
    min-width: 30px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    color: var(--color-mute);
  }
  :global(.dsz-cellbox__v) {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }
  :global(.dsz-approx) {
    color: var(--color-mute);
  }

  /* Notes */
  :global(.dsz-notelist) {
    margin: 0;
    padding: 4px 14px 10px;
    list-style: none;
  }
  :global(.dsz-note) {
    display: flex;
    gap: 8px;
    padding: 6px 0;
    font-size: 13px;
    line-height: 19px;
    color: var(--color-body);
    text-wrap: pretty;
  }
  :global(.dsz-note + .dsz-note) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.dsz-note__mark) {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    color: var(--color-accent-ink);
  }

  /* Cross-tool LINK chips under the result (`-xchip`, render.ts). The row
     layout comes from global.css (`[data-results] [class$='-xchips']`). */
  :global(.dsz-xchip) {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h-sm);
    padding: 4px 12px;
    border: none;
    border-radius: var(--radius-pill);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-brand-strong);
    text-decoration: none;
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-brand),
      box-shadow var(--dur-fast) var(--ease-brand);
  }
  :global(.dsz-xchip:hover) {
    background: var(--color-canvas-soft-2);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  :global(.dsz-xchip:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }

  @keyframes dsz-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.dsz-block) {
      animation: none;
    }
  }

  :global(.dsz-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.dsz-error + .dsz-block),
  :global(.dsz-block + .dsz-error) {
    margin-top: 12px;
  }
  :global(.dsz-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.dsz-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.dsz-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.dsz-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* ── Per-row copy buttons (render.ts; copy.ts drives them) ──────────── */
  :global(.dsz-copy) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-brand),
      background var(--dur-fast) var(--ease-brand);
  }
  :global(.dsz-copy:hover) {
    color: var(--color-brand-strong);
    background: var(--color-hairline);
  }
  :global(.dsz-copy:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  :global(.dsz-copy[data-copied]) {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
  }
  @media (pointer: coarse) {
    :global(.dsz-xchip) {
      min-height: var(--control-h-lg); /* site touch-target standard */
    }
    :global(.dsz-copy) {
      width: var(--control-h-lg);
      height: var(--control-h-lg);
    }
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below it uses the slab ink tier; the light rules
     above remain the documented defaults. ──────────────────────────────── */
  .dsz-results :global(.dsz-empty),
  .dsz-results :global(.dsz-block) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .dsz-results :global(.dsz-empty) {
    color: var(--color-inverse-mute);
  }
  .dsz-results :global(.dsz-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .dsz-results :global(.dsz-block__head),
  .dsz-results :global(.dsz-block__sub),
  .dsz-results :global(.dsz-row + .dsz-row),
  .dsz-results :global(.dsz-rung + .dsz-rung),
  .dsz-results :global(.dsz-note + .dsz-note) {
    border-color: #ffffff12;
  }
  .dsz-results :global(.dsz-block__head),
  .dsz-results :global(.dsz-block__meta),
  .dsz-results :global(.dsz-row__v),
  .dsz-results :global(.dsz-cellbox__v),
  .dsz-results :global(.dsz-note) {
    color: var(--color-inverse-fg);
  }
  .dsz-results :global(.dsz-block__sub),
  .dsz-results :global(.dsz-row__k),
  .dsz-results :global(.dsz-row__gloss),
  .dsz-results :global(.dsz-row__cap),
  .dsz-results :global(.dsz-rung__head),
  .dsz-results :global(.dsz-cellbox__u),
  .dsz-results :global(.dsz-approx) {
    color: var(--color-inverse-mute);
  }
  .dsz-results :global(.dsz-row__v.is-hero) {
    color: var(--color-inverse-brand);
  }
  .dsz-results :global(.dsz-rung__gap),
  .dsz-results :global(.dsz-note__mark) {
    color: var(--color-inverse-accent);
  }
  .dsz-results :global(.dsz-cellbox) {
    background: #ffffff0a;
  }
  /* Values right-align like every instrument readout; the stacked <520px
     layout returns to the left edge. */
  .dsz-results :global(.dsz-row__v-wrap) {
    justify-content: flex-end;
  }
  .dsz-results :global(.dsz-row__v) {
    text-align: right;
  }
  @media (max-width: 519px) {
    .dsz-results :global(.dsz-row__v-wrap) {
      justify-content: flex-start;
    }
    .dsz-results :global(.dsz-row__v) {
      text-align: left;
    }
  }
  .dsz-results :global(.dsz-copy) {
    color: var(--color-inverse-mute);
  }
  .dsz-results :global(.dsz-copy:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .dsz-results :global(.dsz-copy[data-copied]) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
  .dsz-results :global(.dsz-xchip) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-brand);
  }
  .dsz-results :global(.dsz-xchip:hover) {
    background: #ffffff14;
    box-shadow: inset 0 0 0 1px var(--color-inverse-control-edge);
  }
  .dsz-results :global(.dsz-xchip:focus-visible) {
    outline-color: var(--color-inverse-brand);
  }
</style>

<script>
  import { wireRunKeys } from '../lib/run-keys';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  import { resultHtml, errorCardHtml, buildCopyAll, EMPTY_HTML } from '../lib/data-size/render';
  import { examples } from '../lib/data-size/examples';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChips, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import type {
    ConvertResult,
    DataSizeState,
    LadderPair,
    TransferResult,
  } from '../lib/data-size/types';

  type State = DataSizeState;
  type EngineModule = {
    convert: (input: string) => ConvertResult;
    transferTime: (size: string, rate: string) => TransferResult;
    significantLadder: (ladder: LadderPair[], minimum?: number) => LadderPair[];
    encodeState: (state: State) => string;
    parseState: (fragment: string) => State | null;
    decodeState: () => State | null;
  };

  const ROOT_SEL = '.dsz-pg';
  const SLUG = 'data-size-converter';
  const DEBOUNCE_MS = 160;
  const ERROR_HOLD_MS = 600;
  // Past ~2000 chars a fragment stops being a dependable URL (browser, proxy and
  // chat-client limits), so we neither write it nor offer the share button.
  const MAX_HASH_LEN = 2000;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.dszWired === 'true') return;
      root.dataset.dszWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  /** '' for English, '/de' etc. on a localized page — prefixes the cross-tool links. */
  function currentLocalePrefix(): string {
    const match = window.location.pathname.match(/^\/(de|es|fr|pt-br)\//);
    return match ? `/${match[1]}` : '';
  }

  async function init(root: HTMLElement): Promise<void> {
    const sizeInput = el<HTMLInputElement>(root, '#dsz-size');
    const rateInput = el<HTMLInputElement>(root, '#dsz-rate');
    const detectEl = el<HTMLElement>(root, '#dsz-size-detect');
    const resultsBox = el<HTMLElement>(root, '#dsz-results');
    const summaryEl = el<HTMLElement>(root, '#dsz-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#dsz-share');
    const copyAllBtn = el<HTMLButtonElement>(root, '#dsz-copy-all');
    const copyStatus = el<HTMLElement>(root, '#dsz-copy-status');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#dsz-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#dsz-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#dsz-snap-delete');
    const chipsWrap = el<HTMLElement>(root, '#dsz-chips');
    const chips = Array.from(chipsWrap?.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR) ?? []);
    if (
      !sizeInput ||
      !rateInput ||
      !detectEl ||
      !resultsBox ||
      !summaryEl ||
      !shareBtn ||
      !copyAllBtn ||
      !copyStatus ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    )
      return;

    /* ------------------------------------------------------------------ */
    /* Copy plumbing (row buttons, Copy all, Copy link) — the kit helper:  */
    /* one delegated listener; outcomes announced in #dsz-copy-status.     */
    /* ------------------------------------------------------------------ */

    wireCopyButtons(root, { status: copyStatus });

    /** The example a chip loads (chips are index-keyed: each sets two fields). */
    function exampleFor(chip: { getAttribute(name: string): string | null }): { size: string; rate: string } | null {
      const ex = examples[Number(chip.getAttribute('data-example-idx'))];
      return ex ? { size: ex.size, rate: ex.rate ?? '' } : null;
    }

    /* ------------------------------------------------------------------ */
    /* Engine                                                              */
    /* ------------------------------------------------------------------ */

    let engine: EngineModule;
    try {
      engine = (await import('../lib/data-size/engine')) as unknown as EngineModule;
    } catch (err) {
      summaryEl.textContent = '';
      resultsBox.innerHTML = errorCardHtml(
        'Converter unavailable',
        'The converter engine failed to load. Reload the page to try again.',
        true,
        'dsz-error-detail',
      );
      console.error('[DataSizeConverter] engine import failed:', err);
      return;
    }

    /* ------------------------------------------------------------------ */
    /* State machine: EMPTY | VALID | PENDING | INVALID                    */
    /* ------------------------------------------------------------------ */

    type EvalSource = 'type' | 'commit' | 'seed';
    let state: 'empty' | 'valid' | 'pending' | 'invalid' = 'empty';
    let evalTimer: number | undefined;
    let errorTimer: number | undefined;
    let lastWrittenHash: string | null = null;

    function clearTimers(): void {
      window.clearTimeout(evalTimer);
      window.clearTimeout(errorTimer);
    }

    function setSummary(text: string, isError: boolean): void {
      summaryEl!.textContent = text;
      summaryEl!.classList.toggle('text-inverse-error', isError);
      summaryEl!.classList.toggle('text-inverse-mute', !isError);
    }

    function setDetection(text: string): void {
      detectEl!.textContent = text;
    }

    function setFieldError(field: 'size' | 'rate' | null, detailId: string | null): void {
      for (const [name, input, base] of [
        ['size', sizeInput!, 'dsz-size-detect dsz-size-hint dsz-run-hint'],
        ['rate', rateInput!, 'dsz-rate-hint'],
      ] as const) {
        const on = field === name;
        input.classList.toggle('dsz-input--error', on);
        if (on) {
          input.setAttribute('aria-invalid', 'true');
          input.setAttribute('aria-describedby', detailId ? `${base} ${detailId}` : base);
        } else {
          input.removeAttribute('aria-invalid');
          input.setAttribute('aria-describedby', base);
        }
      }
    }

    function hideActions(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
      copyAllBtn!.hidden = true;
      copyAllBtn!.dataset.copy = '';
    }

    /** Press the chip whose size AND rate both match the fields. */
    function syncChipState(): void {
      const size = sizeInput!.value.trim();
      const rate = rateInput!.value.trim();
      syncChips(chipsWrap, (chip) => {
        const ex = exampleFor(chip);
        return !!ex && ex.size === size && ex.rate === rate;
      });
    }

    function writeHash(fragment: string | null): void {
      if (fragment === lastWrittenHash) return;
      // Safari throttles replaceState (~100/30s) and throws — never let that break input.
      try {
        if (fragment) history.replaceState(null, '', fragment);
        else history.replaceState(null, '', location.pathname + location.search);
        lastWrittenHash = fragment;
      } catch {
        /* ignore */
      }
    }

    function renderEmpty(): void {
      state = 'empty';
      clearTimers();
      setFieldError(null, null);
      hideActions();
      setSummary('', false);
      setDetection('');
      syncChipState();
      resultsBox!.innerHTML = EMPTY_HTML;
    }

    function showError(field: 'size' | 'rate', message: string, keep: string): void {
      state = 'invalid';
      clearTimers();
      setFieldError(field, 'dsz-error-detail');
      hideActions();
      setSummary(`Invalid — ${message}`, true);
      if (field === 'size') setDetection('');
      resultsBox!.innerHTML =
        errorCardHtml(
          field === 'rate' ? 'Could not read that link speed' : 'Could not read that size',
          message,
          false,
          'dsz-error-detail',
        ) + keep;
      syncChipState();
    }

    function evaluate(source: EvalSource): void {
      clearTimers();
      const size = sizeInput!.value.trim();
      const rate = rateInput!.value.trim();
      if (size.length === 0 && rate.length === 0) {
        renderEmpty();
        if (source !== 'seed') writeHash(null);
        return;
      }

      let result: ConvertResult | null = null;
      try {
        result = engine.convert(size);
      } catch {
        result = null;
      }

      if (!result || result.valid === false) {
        const message = result?.error ?? 'Unexpected error while converting.';
        if (source === 'type') {
          // Mid-typing: hold the last card, no red yet — and never while the
          // value still ends in a separator someone is about to complete.
          state = 'pending';
          setFieldError(null, null);
          hideActions();
          setSummary('', false);
          setDetection('');
          if (!/[.,_+\-\s]$/.test(sizeInput!.value)) {
            errorTimer = window.setTimeout(() => showError('size', message, ''), ERROR_HOLD_MS);
          }
          return;
        }
        showError('size', message, '');
        return;
      }

      let transfer: TransferResult | null = null;
      if (rate.length > 0) {
        try {
          transfer = engine.transferTime(size, rate);
        } catch {
          transfer = null;
        }
      }

      const ladder = engine.significantLadder(result.ladder ?? []);
      const body = resultHtml(result, transfer, ladder, { localePrefix: currentLocalePrefix() });

      // Clear any stale field flag up front. When the rate is broken, showError re-applies it
      // — either now or when the hold expires. Leaving it to the gated call below stranded the
      // field red with an aria-describedby pointing at an error card that had been removed.
      setFieldError(null, null);

      // A broken rate never hides a good size answer — it annotates it.
      if (transfer && transfer.valid === false) {
        const message = transfer.error ?? 'Unexpected error while timing the transfer.';
        if (source === 'type' && !/[.,_+\-\s/]$/.test(rateInput!.value)) {
          errorTimer = window.setTimeout(() => showError('rate', message, body), ERROR_HOLD_MS);
        } else if (source !== 'type') {
          showError('rate', message, body);
          return;
        }
      }

      state = 'valid';
      setDetection(result.detection ? `Detected: ${result.detection.caption}` : '');
      setSummary(
        transfer?.valid && transfer.summary ? transfer.summary : (result.summary ?? ''),
        false,
      );
      resultsBox!.innerHTML = body;

      copyAllBtn!.hidden = false;
      copyAllBtn!.dataset.copy = buildCopyAll(result, transfer);

      // A half-typed rate must not reach the address bar or last-input storage: a stored
      // invalid rate boots the next visit straight into an error card with no interaction.
      const shareable = !transfer || transfer.valid;
      const fragment = engine.encodeState({ size, rate });
      if (fragment.length > MAX_HASH_LEN || !shareable) {
        shareBtn!.hidden = true;
        shareBtn!.dataset.copy = '';
      } else {
        shareBtn!.hidden = false;
        shareBtn!.dataset.copy =
          location.origin + location.pathname + location.search + fragment;
        if (source !== 'seed') {
          writeHash(fragment);
          recordToolLastInput(SLUG, fragment);
        }
      }
      syncChipState();
    }

    /* ------------------------------------------------------------------ */
    /* Events                                                              */
    /* ------------------------------------------------------------------ */

    // Previous value per field, so a keystroke can be told apart from a paste.
    const seen = new WeakMap<HTMLInputElement, string>();
    function remember(): void {
      seen.set(sizeInput!, sizeInput!.value);
      seen.set(rateInput!, rateInput!.value);
    }

    for (const input of [sizeInput, rateInput]) {
      input.addEventListener('input', () => {
        const previous = seen.get(input) ?? '';
        // A jump of more than one character is a paste, a cut or an autofill —
        // a FINISHED value, not a half-typed one. The calm-error hold exists to
        // avoid flashing red mid-composition; applying it to a paste would just
        // make the tool look slow, so pasted values commit straight away.
        const pasted = Math.abs(input.value.length - previous.length) > 1;
        remember();
        clearTimers();
        syncChipState();
        if (pasted) {
          evaluate('commit');
          return;
        }
        evalTimer = window.setTimeout(() => evaluate('type'), DEBOUNCE_MS);
      });
      wireRunKeys(input, () => evaluate('commit'));
      input.addEventListener('blur', () => {
        if (state === 'pending') evaluate('commit');
      });
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const ex = exampleFor(chip);
        if (!ex) return;
        sizeInput.value = ex.size;
        rateInput.value = ex.rate;
        remember();
        evaluate('commit');
      });
    });

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      // Snapshot the same serialized state the share link carries, so a restored
      // snapshot brings BOTH bands back, not just the size.
      getValue: () =>
        engine.encodeState({ size: sizeInput!.value.trim(), rate: rateInput!.value.trim() }),
      setValue: (value) => {
        const restored = engine.parseState(value);
        sizeInput!.value = restored?.size ?? value;
        rateInput!.value = restored?.rate ?? '';
        remember();
        evaluate('commit');
      },
    });

    /* ------------------------------------------------------------------ */
    /* First load: typed value → #q= → restored last input → first chip.   */
    /* Seeding never writes the hash — only user actions do.               */
    /* ------------------------------------------------------------------ */

    const shared = engine.decodeState();
    const restored = shared ? null : engine.parseState(getRestoredLastInput(SLUG) ?? '');

    // A value the visitor typed BEFORE hydration wins. The server seeds both
    // `value=` attributes with examples[0], so compare against `defaultValue`
    // (the seeded attribute): a bare non-emptiness test always took this
    // branch and made the #q= deep link and the restored input unreachable.
    const typed =
      sizeInput.value.trim() !== sizeInput.defaultValue.trim() ||
      rateInput.value.trim() !== rateInput.defaultValue.trim();
    if (typed && (sizeInput.value.trim() || rateInput.value.trim())) {
      remember();
      evaluate('seed');
    } else if (shared) {
      sizeInput.value = shared.size ?? '';
      rateInput.value = shared.rate ?? '';
      remember();
      evaluate('seed');
    } else if (restored) {
      sizeInput.value = restored.size ?? '';
      rateInput.value = restored.rate ?? '';
      remember();
      evaluate('seed');
    } else if (chips[0]) {
      const ex = exampleFor(chips[0]);
      sizeInput.value = ex?.size ?? '';
      rateInput.value = ex?.rate ?? '';
      remember();
      evaluate('seed');
    } else {
      renderEmpty();
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
