---
/**
 * StoredDataPurge — the erase control rendered on the /privacy pages (all
 * locales; each page passes translated strings).
 *
 * The counterpart to the key inventory in the privacy copy: that section lists
 * what is stored, this one removes the part of it the visitor pasted. Scope and
 * rationale live in src/lib/tool-state/purge.ts — settings and Mission 90
 * progress deliberately survive.
 *
 * Progressive enhancement, matching ConsentToggle: without JS the button is
 * hidden (`hidden` until wired), so nothing offers an action it cannot perform.
 */
export interface Props {
  /** Heading above the control. */
  heading: string;
  /** Scope explanation. */
  description: string;
  /** Button label. */
  button: string;
  /** Status text when there is nothing stored. */
  empty: string;
  /** Status text after a successful purge. */
  done: string;
}

const { heading, description, button, empty, done } = Astro.props;
---

<div
  class="mt-6 rounded-xl border border-hairline bg-canvas-soft p-5"
  data-purge-widget
  data-empty={empty}
  data-done={done}
>
  <h3 class="body-md font-semibold text-ink">{heading}</h3>
  <p class="body-sm mt-1 text-mute">{description}</p>
  <button
    type="button"
    data-purge-button
    hidden
    class="mt-3 inline-flex min-h-11 cursor-pointer items-center rounded-pill border border-hairline bg-canvas px-4 py-2 body-sm font-medium text-brand-strong transition-colors hover:bg-brand-soft disabled:cursor-default disabled:opacity-60"
  >
    {button}
  </button>
  <p class="body-sm mt-2 text-mute" role="status" data-purge-status></p>
</div>

<script>
  import { purgeStoredInputs, summarizeStoredInputs } from '../lib/tool-state/purge';

  function bootPurgeWidgets() {
    document.querySelectorAll<HTMLElement>('[data-purge-widget]').forEach((root) => {
      if (root.dataset.wired === 'true') return;
      root.dataset.wired = 'true';

      const btn = root.querySelector<HTMLButtonElement>('[data-purge-button]');
      const status = root.querySelector<HTMLElement>('[data-purge-status]');
      if (!btn || !status) return;

      const targets = { local: localStorage, session: sessionStorage };

      // Only reveal the button once we know JS can actually do the deleting.
      btn.hidden = false;

      const refresh = () => {
        const { lastInputTools, snapshots, handoff } = summarizeStoredInputs(targets);
        const total = lastInputTools + snapshots + (handoff ? 1 : 0);
        btn.disabled = total === 0;
        if (total === 0) status.textContent = root.dataset.empty ?? '';
        return total;
      };

      refresh();

      btn.addEventListener('click', () => {
        purgeStoredInputs(targets);
        status.textContent = root.dataset.done ?? '';
        btn.disabled = true;
      });
    });
  }

  bootPurgeWidgets();
  document.addEventListener('astro:page-load', bootPurgeWidgets);
</script>
