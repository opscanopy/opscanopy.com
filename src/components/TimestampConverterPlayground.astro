---
/**
 * TimestampConverterPlayground — the interactive Timestamp Converter island.
 *
 * Single-input, live tool: type a Unix epoch (seconds / milliseconds /
 * microseconds) or a parseable date string and every representation of that
 * instant is rendered. A "Now" button fills the current epoch seconds. Fully
 * client-side, no framework.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar, ResultPanel (figure cap, live summary, copy status)
 * and CopyButton. The results container stays here, seeded with
 * `set:html` + `data-results`; its slab overrides anchor on `.ts-results`.
 *
 * Runtime contract (lazy-imported):
 *   ../lib/timestamp-converter/engine   → convert(input: string, nowMs?: number): TimeResult
 *   ../lib/timestamp-converter/examples → examples: { id; label; input }[]
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. The script only
// wires click handlers onto these already-rendered buttons — it never rebuilds
// them — so this adds nothing to the client bundle and cannot drift.
import { examples as prerenderedExamples } from '../lib/timestamp-converter/examples';
import { convert } from '../lib/timestamp-converter/engine';
import { resultHtml, CLIENT_ONLY_LABELS, EMPTY_HTML } from '../lib/timestamp-converter/render';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-converts the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees a real converted
 * instant instead of an empty "type something here" panel.
 *
 * PARTIAL by design: `convert` takes an injectable clock, pinned here so the
 * build is reproducible, but the `Relative` row ("7 years ago") would still
 * drift with the build date and `Local` is the build machine's timezone, not
 * the visitor's. Those two rows render as client-only placeholders; the
 * other five are deterministic facts about the epoch.
 */
const FIXED_NOW = Date.UTC(2026, 0, 1);
const seedExample = prerenderedExamples[0];
const seedResult = seedExample ? convert(seedExample.input, FIXED_NOW) : null;
const seedHtml =
  seedResult && seedResult.valid
    ? resultHtml(seedResult, { clientOnlyLabels: CLIENT_ONLY_LABELS })
    : EMPTY_HTML;
const seedSummary = seedResult && seedResult.valid ? (seedResult.detected ?? '') : '';
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="ts-pg" aria-label="Timestamp Converter playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      {/* The chip group carries its own accessible name; there is no <label
          for=…> because a group of buttons is not a labelable control. */}
      <span class="eyebrow shrink-0">Example</span>
      <ExampleChips prefix="ts" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
    </div>

    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <div class="ts-label-row mb-2 flex items-center gap-2">
        <label class="eyebrow" for="ts-input">Timestamp</label>
        {/* Shown for the seeded example (as the script shows it on boot); the
            script hides it for a deep link, a restored input or hand typing. */}
        <span id="ts-sample-badge" class="ts-sample-badge" aria-label="pre-filled sample value">(sample)</span>
      </div>
      <div class="ts-input-row">
        <div class="ts-input-wrap">
          <svg
            class="ts-input-icon pointer-events-none"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="10" cy="10" r="7.25"></circle>
            <path d="M10 6v4l2.5 2.5"></path>
          </svg>
          <input
            id="ts-input"
            type="text"
            class="ts-input code-mono"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            autocomplete="off"
            placeholder="1516239022"
            value={seedExample?.input}
            aria-describedby="ts-input-hint ts-run-hint"
          />
        </div>
        {/* Fills the current epoch: an input helper, not a run button, so it
            is the quiet tool control rather than a primary CTA. */}
        <button id="ts-now" type="button" class="btn-tool ts-now code-mono">Now</button>
      </div>
      <p id="ts-input-hint" class="ts-hint caption text-mute">
        A Unix epoch in seconds <span class="code-mono">1516239022</span>, milliseconds
        <span class="code-mono">1516239022000</span>, or a date string
        <span class="code-mono">2018-01-18T01:30:22Z</span>.
      </p>
      <RunHint id="ts-run-hint" />
      <SnapshotBar prefix="ts" />
    </div>

    {/* ── Results panel — the L2 instrument (dark in both themes) under its
        figure cap; the live summary reads out in the cap's actions slot. ── */}
    <ResultPanel slug="timestamp-converter" prefix="ts" summary={seedSummary} split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="ts-share" />
        <CopyButton kind="all" id="ts-md" label="Copy as Markdown" icon="markdown" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the answer is in the
          static HTML; the client replaces it with the full rows on boot. */}
      <div id="ts-results" class="ts-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .ts-input-row {
    display: flex;
    align-items: stretch;
    gap: 10px;
  }
  .ts-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1 1 auto;
    min-width: 0;
  }
  .ts-input-icon {
    position: absolute;
    left: 14px;
    width: 18px;
    height: 18px;
    color: var(--color-mute);
    pointer-events: none;
  }
  .ts-input {
    width: 100%;
    height: var(--control-h-lg);
    padding: 0 16px 0 42px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 15px;
    line-height: 24px;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .ts-input::placeholder {
    color: var(--color-mute);
  }
  .ts-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .ts-input:focus {
    outline: none;
  }
  .ts-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .ts-input.ts-input--error {
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  .ts-input.ts-input--error:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-error);
  }

  /* The kit's .btn-tool, as tall as the input it sits beside. */
  .ts-now {
    height: var(--control-h-lg);
    padding: 0 16px;
    touch-action: manipulation;
  }
  .ts-now:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }

  .ts-hint {
    margin-top: 8px;
    text-wrap: pretty;
  }
  .ts-results {
    min-height: var(--control-h-lg);
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.ts-results` container (the panel
     wrapper is ResultPanel's and carries no scope attribute). */
  :global(.ts-card) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: ts-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.ts-title) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-mute);
  }
  :global(.ts-title__badge) {
    flex: 0 0 auto;
    font-size: 11px;
    line-height: 16px;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
    text-transform: capitalize;
  }
  :global(.ts-row) {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr) auto;
    gap: 12px;
    padding: 9px 14px;
    align-items: center;
  }
  :global(.ts-row + .ts-row) {
    border-top: 1px solid var(--color-hairline);
  }
  /* Row-key role (label-field): mono 11/16 uppercase, the only label. */
  :global(.ts-row__k) {
    @apply label-field;
  }
  :global(.ts-row__v) {
    min-width: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-word;
  }
  :global(.ts-row__v.is-mono) {
    font-family: var(--font-mono);
    font-size: 13px;
  }
  /* Build-time stand-in for the two rows only a browser can fill (local
     timezone, "x ago"); reads as muted caption text, replaced on boot. */
  :global(.ts-client-only) {
    min-width: 0;
    font-size: 13px;
    line-height: 20px;
    font-style: italic;
    color: var(--color-mute);
  }

  @keyframes ts-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.ts-card) {
      animation: none;
    }
  }

  :global(.ts-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.ts-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.ts-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.ts-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .ts-sample-badge {
    display: inline-block;
    font-size: 11px;
    line-height: 16px;
    padding: 1px 7px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft);
    color: var(--color-mute);
    font-family: var(--font-sans);
    font-weight: 400;
    vertical-align: middle;
  }
  .ts-sample-badge[hidden] {
    display: none;
  }

  /* Per-row copy (render.ts; the island binds [data-copy-value]). */
  :global(.ts-copy-btn) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      color var(--dur-fast) var(--ease-brand);
  }
  :global(.ts-copy-btn:hover) {
    background: var(--color-canvas-soft);
    color: var(--color-ink);
  }
  :global(.ts-copy-btn:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  :global(.ts-copy-btn[data-copied]) {
    color: var(--color-success);
  }
  :global(.ts-copy-btn svg) {
    width: 14px;
    height: 14px;
    pointer-events: none;
  }
  @media (pointer: coarse) {
    :global(.ts-copy-btn) {
      width: var(--control-h-lg);
      height: var(--control-h-lg);
    }
  }

  :global(.ts-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below it uses the slab ink tier; the light rules
     above remain the documented defaults. ──────────────────────────────── */
  .ts-results :global(.ts-empty),
  .ts-results :global(.ts-card) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .ts-results :global(.ts-empty) {
    color: var(--color-inverse-mute);
  }
  .ts-results :global(.ts-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .ts-results :global(.ts-title) {
    border-bottom-color: var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .ts-results :global(.ts-title__badge) {
    background: #8fc97a1f;
    color: var(--color-inverse-brand);
  }
  .ts-results :global(.ts-row + .ts-row) {
    border-top-color: #ffffff12;
  }
  .ts-results :global(.ts-row__k),
  .ts-results :global(.ts-client-only) {
    color: var(--color-inverse-mute);
  }
  .ts-results :global(.ts-row__v) {
    color: var(--color-inverse-fg);
  }
  .ts-results :global(.ts-copy-btn) {
    color: var(--color-inverse-mute);
  }
  .ts-results :global(.ts-copy-btn:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .ts-results :global(.ts-copy-btn[data-copied]) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
</style>

<script>
  import { wireRunKeys } from '../lib/run-keys';
  import { copyTextToClipboard } from '../lib/clipboard';
  import { createHashState } from '../lib/hash-state';
  import { buildMarkdownBlock } from '../lib/share-md';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  import { wireCopyButtons, setCopyStatus, STATUS_COPIED, STATUS_FAILED, RESET_MS } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  // The HTML builders are shared with the frontmatter's build-time seed —
  // one implementation, so the no-JS markup and the live markup never drift.
  // The client passes no `clientOnlyLabels`, so it always gets the full rows.
  import { resultHtml, errorHtml, EMPTY_HTML, COPY_SVG, CHECK_SVG } from '../lib/timestamp-converter/render';
  import type { TimeResult as Result } from '../lib/timestamp-converter/types';

  type Example = { id: string; label: string; input: string };
  type EngineModule = { convert: (input: string, nowMs?: number) => Result };

  const ROOT_SEL = '.ts-pg';
  const DEBOUNCE_MS = 140;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.tsWired === 'true') return;
      root.dataset.tsWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          input: typeof o.input === 'string' ? o.input : '',
        } satisfies Example;
      })
      .filter((e) => e.input.length > 0);
  }

  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = EMPTY_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    setSummary(summary, 'Invalid', true);
    container.innerHTML = errorHtml(message);
  }

  function renderResult(container: HTMLElement, summary: HTMLElement, result: Result): void {
    setSummary(summary, result.detected ?? '', false);
    container.innerHTML = resultHtml(result);
  }

  /**
   * Per-row copy. render.ts emits `data-copy-value` (not the kit's
   * `data-copy`) and swaps whole icons, so these rows keep their own small
   * handler; the outcome still goes through the kit's announcer.
   */
  function wireResultCopyClicks(container: HTMLElement, status: HTMLElement): void {
    container.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('[data-copy-value]');
      if (!btn) return;
      const text = btn.dataset.copyValue ?? '';
      void copyTextToClipboard(text).then((ok) => {
        if (!ok) {
          setCopyStatus(status, STATUS_FAILED, true);
          return;
        }
        btn.innerHTML = CHECK_SVG;
        btn.setAttribute('data-copied', '');
        setCopyStatus(status, STATUS_COPIED, false);
        setTimeout(() => {
          btn.innerHTML = COPY_SVG;
          btn.removeAttribute('data-copied');
          if (status.textContent === STATUS_COPIED) setCopyStatus(status, '', false);
        }, RESET_MS);
      });
    });
  }

  async function init(root: HTMLElement): Promise<void> {
    const input = el<HTMLInputElement>(root, '#ts-input');
    const chipsWrap = el<HTMLElement>(root, '#ts-chips');
    const nowBtn = el<HTMLButtonElement>(root, '#ts-now');
    const resultsBox = el<HTMLElement>(root, '#ts-results');
    const summaryEl = el<HTMLElement>(root, '#ts-summary');
    const sampleBadge = el<HTMLElement>(root, '#ts-sample-badge');
    const shareBtn = el<HTMLButtonElement>(root, '#ts-share');
    const mdBtn = el<HTMLButtonElement>(root, '#ts-md');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#ts-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#ts-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#ts-snap-delete');
    const copyStatus = el<HTMLElement>(root, '#ts-copy-status');
    if (
      !input ||
      !chipsWrap ||
      !nowBtn ||
      !resultsBox ||
      !summaryEl ||
      !shareBtn ||
      !mdBtn ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn ||
      !copyStatus
    ) {
      return;
    }

    const hashState = createHashState('t');

    /* Copy plumbing: Copy link and Copy as Markdown through the kit helper
       (one delegated listener, announced in #ts-copy-status); the per-row
       buttons through the small handler above. */
    wireCopyButtons(root, { status: copyStatus });
    wireResultCopyClicks(resultsBox, copyStatus);

    let engine: EngineModule;
    let examples: Example[] = [];
    try {
      const [engineMod, examplesMod] = await Promise.all([
        import('../lib/timestamp-converter/engine'),
        import('../lib/timestamp-converter/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
    } catch (err) {
      renderError(resultsBox, summaryEl, 'The converter engine failed to load. Reload the page to try again.');
      console.error('[TimestampConverter] engine import failed:', err);
      return;
    }

    // The chips are already in the static HTML (server-rendered from the same
    // `examples` module); the script only wires them. `chips` is captured as a
    // plain array so the helpers below never lose the null-narrowing on
    // `chipsWrap` inside a hoisted function declaration.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));

    /** Press one chip, or none at all (custom / shared / restored input). */
    function setActiveChip(idx: number | null): void {
      syncChipsByIndex(chipsWrap, idx);
    }

    function hideShare(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
      mdBtn!.hidden = true;
      mdBtn!.dataset.copy = '';
    }

    function evaluate(userInitiated = true): void {
      const value = input!.value.trim();
      if (value.length === 0) {
        input!.classList.remove('ts-input--error');
        hideShare();
        renderEmpty(resultsBox!, summaryEl!);
        if (userInitiated) hashState.write(null);
        return;
      }
      let result: Result | null = null;
      try {
        result = engine.convert(value);
      } catch {
        input!.classList.add('ts-input--error');
        hideShare();
        renderError(resultsBox!, summaryEl!, 'Unexpected error while converting.');
        if (userInitiated) hashState.write(null);
        return;
      }
      if (!result || result.valid === false) {
        input!.classList.add('ts-input--error');
        hideShare();
        renderError(resultsBox!, summaryEl!, result?.error ?? 'This is not a valid timestamp.');
        if (userInitiated) hashState.write(null);
        return;
      }
      input!.classList.remove('ts-input--error');
      renderResult(resultsBox!, summaryEl!, result);
      shareBtn!.hidden = false;
      shareBtn!.dataset.copy = location.origin + location.pathname + location.search + hashState.build(value);
      if (userInitiated) hashState.write(value);
      if (userInitiated) recordToolLastInput('timestamp-converter', value);

      mdBtn!.hidden = false;
      const rows = Array.isArray(result.rows) ? result.rows : [];
      mdBtn!.dataset.copy = buildMarkdownBlock('Timestamp Converter', [
        { label: 'Input', value },
        ...rows.map((r) => ({ label: r.label ?? '', value: typeof r.value === 'string' ? r.value : '' })),
      ]);
    }

    let timer: number | undefined;
    function scheduleEvaluate(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(evaluate, DEBOUNCE_MS);
    }

    input.addEventListener('input', () => {
      setActiveChip(null);
      if (sampleBadge) sampleBadge.hidden = true;
      scheduleEvaluate();
    });

    wireRunKeys(input, () => {
      window.clearTimeout(timer);
      evaluate(true);
    });
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        input.value = examples[idx].input;
        setActiveChip(idx);
        if (sampleBadge) sampleBadge.hidden = idx !== 0;
        window.clearTimeout(timer);
        evaluate();
      });
    });
    nowBtn.addEventListener('click', () => {
      input.value = String((Date.now() / 1000) | 0);
      setActiveChip(null);
      if (sampleBadge) sampleBadge.hidden = true;
      window.clearTimeout(timer);
      evaluate();
      input.focus();
    });

    wireSnapshotUI({
      slug: 'timestamp-converter',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => input!.value.trim(),
      setValue: (value) => {
        input!.value = value;
        setActiveChip(null);
        if (sampleBadge) sampleBadge.hidden = true;
        window.clearTimeout(timer);
        evaluate();
      },
    });

    // Seed priority: #t= deep link > restored last input > seeded example.
    // Neither seed path writes the hash or records a last-input — only
    // user-initiated evaluations do.
    const hashValue = hashState.read();
    const restored = getRestoredLastInput('timestamp-converter');
    if (hashValue) {
      input.value = hashValue;
      // Shared/restored state is not one of the bundled examples — no chip is active.
      setActiveChip(null);
      if (sampleBadge) sampleBadge.hidden = true;
      evaluate(false);
    } else if (restored) {
      input.value = restored;
      setActiveChip(null);
      if (sampleBadge) sampleBadge.hidden = true;
      evaluate(false);
    } else {
      const seed = examples[0];
      if (seed) {
        input.value = seed.input;
        setActiveChip(0);
        if (sampleBadge) sampleBadge.hidden = false;
        evaluate(false);
      } else {
        setActiveChip(null);
        renderEmpty(resultsBox, summaryEl);
      }
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
