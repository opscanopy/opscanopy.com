---
/**
 * TimestampConverterPlayground — the interactive Timestamp Converter island.
 *
 * Single-input, live tool: type a Unix epoch (seconds / milliseconds /
 * microseconds) or a parseable date string and every representation of that
 * instant is rendered. A "Now" button fills the current epoch seconds. Fully
 * client-side, no framework.
 *
 * Runtime contract (lazy-imported):
 *   ../lib/timestamp-converter/engine   → convert(input: string, nowMs?: number): TimeResult
 *   ../lib/timestamp-converter/examples → examples: { id; label; input }[]
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. The script only
// wires click handlers onto these already-rendered buttons — it never rebuilds
// them — so this adds nothing to the client bundle and cannot drift.
import { examples as prerenderedExamples } from '../lib/timestamp-converter/examples';
import { convert } from '../lib/timestamp-converter/engine';
import { resultHtml, CLIENT_ONLY_LABELS, EMPTY_HTML } from '../lib/timestamp-converter/render';

/**
 * Server-rendered seed. The client re-converts the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees a real converted
 * instant instead of an empty "type something here" panel.
 *
 * PARTIAL by design: `convert` takes an injectable clock, pinned here so the
 * build is reproducible, but the `Relative` row ("7 years ago") would still
 * drift with the build date and `Local` is the build machine's timezone, not
 * the visitor's. Those two rows render as client-only placeholders; the
 * other five are deterministic facts about the epoch.
 */
const FIXED_NOW = Date.UTC(2026, 0, 1);
const seedExample = prerenderedExamples[0];
const seedResult = seedExample ? convert(seedExample.input, FIXED_NOW) : null;
const seedHtml =
  seedResult && seedResult.valid
    ? resultHtml(seedResult, { clientOnlyLabels: CLIENT_ONLY_LABELS })
    : EMPTY_HTML;
const seedSummary = seedResult && seedResult.valid ? (seedResult.detected ?? '') : '';
---

<section class="ts-pg" aria-label="Timestamp Converter playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      {/* The chip group carries its own accessible name; there is no <label
          for=…> because a group of buttons is not a labelable control. */}
      <span class="eyebrow shrink-0">Example</span>
      <div id="ts-chips" class="ts-chips" role="group" aria-label="Examples">
        {prerenderedExamples.map((ex, i) => (
          <button
            type="button"
            class:list={['ts-chip', { 'is-active': i === 0 }]}
            data-example-idx={i}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {ex.label}
          </button>
        ))}
      </div>
    </div>

    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <div class="ts-label-row mb-2 flex items-center gap-2">
        <label class="eyebrow" for="ts-input">Timestamp</label>
        {/* Shown for the seeded example (as the script shows it on boot); the
            script hides it for a deep link, a restored input or hand typing. */}
        <span id="ts-sample-badge" class="ts-sample-badge" aria-label="pre-filled sample value">(sample)</span>
      </div>
      <div class="ts-input-row">
        <div class="ts-input-wrap">
          <svg
            class="ts-input-icon pointer-events-none"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="10" cy="10" r="7.25"></circle>
            <path d="M10 6v4l2.5 2.5"></path>
          </svg>
          <input
            id="ts-input"
            type="text"
            class="ts-input code-mono"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            autocomplete="off"
            placeholder="1516239022"
            value={seedExample?.input}
            aria-describedby="ts-input-hint"
          />
        </div>
        <button id="ts-now" type="button" class="ts-now code-mono">Now</button>
      </div>
      <p id="ts-input-hint" class="ts-hint caption text-mute">
        A Unix epoch in seconds <span class="code-mono">1516239022</span>, milliseconds
        <span class="code-mono">1516239022000</span>, or a date string
        <span class="code-mono">2018-01-18T01:30:22Z</span>.
      </p>
      <div class="ts-snap-row mt-3 flex flex-wrap items-center gap-2">
        <button id="ts-snap-save" type="button" class="ts-snap-btn">Save snapshot</button>
        <select id="ts-snap-select" class="ts-snap-select" aria-label="Load a saved snapshot" disabled>
          <option value="">No snapshots yet</option>
        </select>
        <button id="ts-snap-delete" type="button" class="ts-snap-delete" aria-label="Delete this snapshot" hidden>&times;</button>
      </div>
    </div>

    <div class="bg-canvas-soft px-4 py-4 sm:px-5">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
        <span class="flex items-center gap-2">
          <span class="eyebrow">Result</span>
          <button id="ts-share" type="button" class="ts-share-btn" data-copy="" hidden>
            <svg
              class="ts-share-icon"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6.75 9.25l2.5-2.5"></path>
              <path d="M8.75 4.25l1.5-1.5a2.47 2.47 0 0 1 3.5 3.5l-1.5 1.5"></path>
              <path d="M7.25 11.75l-1.5 1.5a2.47 2.47 0 0 1-3.5-3.5l1.5-1.5"></path>
            </svg>
            <span class="ts-share-label">Copy link</span>
          </button>
          <button id="ts-md" type="button" class="ts-share-btn" data-copy="" hidden>
            <svg
              class="ts-share-icon"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M2.5 4.5h11v7h-11z"></path>
              <path d="M4.5 10V6l1.75 2L8 6v4"></path>
              <path d="M9.75 6.5v3.25M9.75 9.75l1.25-1.25M9.75 9.75l-1.25-1.25"></path>
            </svg>
            <span class="ts-md-label">Copy as Markdown</span>
          </button>
        </span>
        <span id="ts-summary" class="ts-summary code-mono text-mute" role="status" aria-live="polite">{seedSummary}</span>
      </div>
      {/* Seeded at build time (see `seedHtml` above) so the answer is in the
          static HTML; the client replaces it with the full rows on boot. */}
      <div id="ts-results" class="ts-results" set:html={seedHtml}></div>
    </div>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* ── Example chips (server-rendered buttons) ─────────────────────────── */
  .ts-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
