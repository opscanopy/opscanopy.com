  :global(.ts-row) {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr) 30px;
    gap: 12px;
    padding: 9px 14px;
    align-items: center;
  }
  :global(.ts-row + .ts-row) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.ts-row__k) {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 18px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  :global(.ts-row__v) {
    min-width: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-word;
  }
  :global(.ts-row__v.is-mono) {
    font-family: var(--font-mono);
    font-size: 13px;
  }
  /* Build-time stand-in for the two rows only a browser can fill (local
     timezone, "x ago"); reads as muted caption text, replaced on boot. */
  :global(.ts-client-only) {
    min-width: 0;
    font-size: 13px;
    line-height: 20px;
    font-style: italic;
    color: var(--color-mute);
  }

  @keyframes ts-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.ts-card) {
      animation: none;
    }
  }

  :global(.ts-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.ts-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.ts-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.ts-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
