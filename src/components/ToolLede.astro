---
/**
 * ToolLede — a tool page's lede paragraph, rendered BELOW the result panel.
 *
 * Until batch D (2026-10) the lede lived in ToolHero's `lead` slot, between
 * the H1 and the playground. It carries the long-tail terms the title does
 * not (netmask, wildcard, host range…), so it was never cut — it moved:
 * `scripts/codemods/move-tool-lede.mjs` lifted every page's lead Fragment
 * verbatim into this component as the LAST child of `#playground`'s
 * `.container-page`, so the paragraph sits under the instrument (after any
 * VerifyPanel) and directly precedes the first visible `<h2>` of `#why`.
 *
 * The SEO guard's `lede-present` rule proves on built HTML that the baseline
 * hero paragraph's text appears verbatim inside `<main>` after the move.
 *
 * One block on the rail: `measure-prose` hangs from the container's left
 * edge, never `mx-auto`.
 */
export interface Props {
  /** Extra classes (spacing overrides). */
  class?: string;
}

const { class: className } = Astro.props;
---

<p class:list={['tool-lede body-md measure-prose mt-10 text-pretty text-body', className]}>
  <slot />
</p>
