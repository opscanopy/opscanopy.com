---
/**
 * TerraformPlanSummarizerPlayground — the terraform-plan-summarizer island.
 *
 * Paste `terraform plan` output (or `terraform show -json`) and get the four
 * numbers that matter, the resources behind them, and — the part no other plan
 * reader does — a cross-check of the parsed list against Terraform's own "Plan:"
 * line, in which each replacement counts once as an add AND once as a destroy.
 * When the two disagree the tool says so loudly instead of printing a confident
 * wrong total.
 *
 * Ported from `CidrCheckerPlayground.astro` (the contract reference): example
 * chips at `var(--radius-pill)`, one debounce plus a 600 ms calm-error hold, the
 * exact run hint line, per-row copy plus `data-copy-all`, one visible
 * `role="status"` summary and one sr-only copy status, NO `aria-live` on the
 * results container, `escapeHtml()` on every injected value (attributes
 * included), and the two coarse-pointer tap-target tiers.
 *
 * FOUR DELIBERATE DEVIATIONS, each with a reason:
 *
 *  1. **No deep link, and no `data-copy-link` at all.** Plans run 5,000–50,000
 *     lines; the smallest useful one is already past the ~2,000-character
 *     fragment cap every other tool here respects. Nothing in this file reads or
 *     writes `location.hash`. The share affordance is "Copy summary as Markdown"
 *     carrying `data-copy-all` — PR-comment shaped, which is where a plan review
 *     actually happens. It already emits `result_copied` through Layout.astro's
 *     listener, so analytics is unaffected.
 *
 *  2. **Plain textarea, no CodeMirror.** Syntax highlighting a 50,000-line log
 *     costs ~150 KB of editor for zero information (certificate-decoder and
 *     chmod-calculator set the same precedent). Input is capped at 2 MiB with a
 *     note that says exactly how many characters were dropped.
 *
 *  3. **The stat band shows four DISJOINT tiles**, not Terraform's overlapping
 *     add/change/destroy. `+ add` is resources created outright and `± replace`
 *     is resources destroyed and recreated — a replacement is never counted in
 *     both tiles. Terraform's own accounting is printed underneath, verbatim, so
 *     neither number can be mistaken for the other.
 *
 *  4. **No cost estimate, permanently.** Pricing goes stale and a stale figure
 *     printed with confidence is the one mistake this site cannot make.
 *
 * Runtime contract (lazy-imported inside the boot closure so the engine and its
 * fixtures code-split away from the page shell):
 *   ../lib/terraform-plan-summarizer/engine → summarizePlan, toMarkdown,
 *                                             formatTerraformTotals
 *
 * The HTML builders themselves are NOT lazy: they live in
 * `../lib/terraform-plan-summarizer/render`, are imported by this frontmatter
 * AND by the `<script>`, and depend on nothing but `escapeHtml` — so the
 * server-rendered seed and every client repaint come from one implementation.
 * That module deliberately does not import the engine (it would then land in
 * the page shell); `formatTerraformTotals(totals)` is passed in instead.
 */
import { examples } from '../lib/terraform-plan-summarizer/examples';
import { formatTerraformTotals, summarizePlan } from '../lib/terraform-plan-summarizer/engine';
import { EMPTY_HTML, resultHtml, summaryText } from '../lib/terraform-plan-summarizer/render';

/**
 * Server-rendered seed. `summarizePlan()` is pure, synchronous and reads no
 * clock, key or randomness, and `PlanSummary` carries no elapsed-time field —
 * so the first example's stat band, resource rows and count cross-check are
 * computed at build time and land in the static HTML, which is all an AI
 * crawler (no JS) ever sees. The client re-runs the same example on boot and
 * repaints identical markup.
 *
 * `grouping` is the only view state, and it is `'action'` on both sides at
 * first paint, so the seed is reproducible byte-for-byte.
 *
 * `resultHtml` also returns the per-row copy payloads; the server ignores them
 * (they cannot ride in an attribute — see the render module's header) and the
 * client rebinds them after its own render.
 */
const seedExample = examples[0];
const seedParsed = seedExample ? summarizePlan(seedExample.input) : null;
const seedOk = seedParsed && seedParsed.ok ? seedParsed : null;
const seedHtml = seedOk
  ? resultHtml(seedOk, {
      grouping: 'action',
      terraformTotals: formatTerraformTotals(seedOk.totals),
    }).html
  : EMPTY_HTML;
const seedSummary = seedOk ? summaryText(seedOk) : '';
const seedMismatch = seedOk !== null && seedOk.reconciliation.status === 'mismatch';
const seedInput = seedOk && seedExample ? seedExample.input : '';
---

<section class="tps-pg" aria-label="Terraform plan summarizer playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Example chips ─────────────────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow">Examples</span>
      <div id="tps-chips" class="tps-chips" role="group" aria-label="Examples">
        {
          examples.map((ex, i) => (
            <button
              type="button"
              class="tps-chip"
              data-example-idx={String(i)}
              aria-pressed={i === 0 && seedOk !== null ? 'true' : 'false'}
            >
              {ex.label}
            </button>
          ))
        }
      </div>
    </div>

    {/* ── Input ─────────────────────────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <label class="eyebrow mb-2 block" for="tps-input">Plan output</label>
      <textarea
        id="tps-input"
        class="tps-input code-mono"
        spellcheck="false"
        autocapitalize="off"
        autocorrect="off"
        autocomplete="off"
        rows="12"
        placeholder="Terraform will perform the following actions:&#10;&#10;  # aws_db_instance.primary must be replaced&#10;-/+ resource &quot;aws_db_instance&quot; &quot;primary&quot; {&#10;      ~ engine_version = &quot;13.4&quot; -&gt; &quot;15.3&quot; # forces replacement&#10;    }&#10;&#10;Plan: 1 to add, 0 to change, 1 to destroy."
        aria-describedby="tps-input-hint tps-run-hint">{seedInput}</textarea>
      <p id="tps-input-hint" class="tps-hint caption text-mute">
        Both formats work and the format is detected for you: the human-readable
        <span class="code-mono">terraform plan</span> transcript (ANSI colour codes and CRLF from a
        CI log are fine) or <span class="code-mono">terraform show -json tfplan</span>. Up to 2 MiB
        — roughly a 50,000-line plan. It stays in this tab: there is no server here to send it to,
        which matters, because plan output is full of account IDs, ARNs, CIDRs and policy JSON.
      </p>
      <p id="tps-run-hint" class="tps-hint caption text-mute">Results update as you type — press Enter to run now.</p>

      <div class="tps-control">
        <span class="eyebrow" id="tps-group-label">Grouping</span>
        <div class="tps-seg" role="radiogroup" aria-labelledby="tps-group-label">
          <button
            id="tps-group-action"
            type="button"
            role="radio"
            aria-checked="true"
            tabindex="0"
            class="tps-seg__btn code-mono"
          >
            By action
          </button>
          <button
            id="tps-group-module"
            type="button"
            role="radio"
            aria-checked="false"
            tabindex="-1"
            class="tps-seg__btn code-mono"
          >
            By module
          </button>
        </div>
        <p class="tps-gloss caption text-mute">
          By action puts replacements and destroys first, because those are the ones that can take
          something down. By module follows the code instead, which is what you want when one
          module call is the thing under review.
        </p>
      </div>

      <div class="tps-snap-row mt-3 flex flex-wrap items-center gap-2">
        <button id="tps-snap-save" type="button" class="tps-snap-btn">Save snapshot</button>
        <select id="tps-snap-select" class="tps-snap-select" aria-label="Load a saved snapshot" disabled>
          <option value="">No snapshots yet</option>
        </select>
        <button id="tps-snap-delete" type="button" class="tps-snap-delete" aria-label="Delete this snapshot" hidden>&times;</button>
      </div>
    </div>

    {/* ── Results ───────────────────────────────────────────────────────── */}
    <div class="bg-canvas-soft px-4 py-4 sm:px-5">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
        <span class="flex flex-wrap items-center gap-2">
          <span class="eyebrow">Result</span>
          <button
            id="tps-copy-md"
            type="button"
            class="tps-copy tps-copy--labeled"
            data-copy-all
            data-copy=""
            data-copy-label="Copy summary as Markdown"
            hidden
          >
            <svg
              class="tps-copy-icon"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="5" y="5" width="9" height="9" rx="1.5"></rect>
              <path d="M3 11H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v1"></path>
            </svg>
            <svg
              class="tps-check-icon hidden"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 8.5l3.5 3.5L13 4.5"></path>
            </svg>
            <span class="tps-copy-label">Copy summary as Markdown</span>
          </button>
        </span>
        <span
          id="tps-summary"
          class:list={[
            'tps-summary code-mono',
            seedMismatch ? 'text-error-deep' : 'text-mute',
          ]}
          role="status"
          aria-live="polite">{seedSummary}</span
        >
      </div>
      <p class="caption text-mute mb-3">
        No share links on this tool — a plan is full of account IDs, ARNs and policy JSON.
      </p>
      <div id="tps-results" class="tps-results" set:html={seedHtml}></div>
      <span id="tps-copy-status" class="sr-only" role="status" aria-live="polite"></span>
    </div>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* ── Example chips ───────────────────────────────────────────────────── */
  .tps-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    min-height: 26px;
  }
  .tps-chip {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border: none;
    border-radius: var(--radius-pill);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-brand-strong);
    cursor: pointer;
    transition: background 0.12s ease, box-shadow 0.12s ease;
  }
  .tps-chip:hover,
  .tps-chip[aria-pressed='true'] {
    background: var(--color-brand-soft);
    box-shadow: inset 0 0 0 1px var(--color-brand);
  }
  .tps-chip:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }

  /* ── Input ───────────────────────────────────────────────────────────── */
  .tps-input {
    width: 100%;
    min-height: 260px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 13px;
    line-height: 19px;
    resize: vertical;
    white-space: pre;
    overflow: auto;
    transition: box-shadow 0.15s ease;
  }
  .tps-input::placeholder {
    color: var(--color-mute);
  }
  .tps-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .tps-input:focus {
    outline: none;
  }
  .tps-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .tps-input--error {
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  .tps-hint {
    margin-top: 8px;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .tps-hint + .tps-hint {
    margin-top: 2px;
  }
  .tps-hint .code-mono {
    font-size: 12px;
  }

  /* ── Grouping control ────────────────────────────────────────────────── */
  .tps-control {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--color-hairline);
  }
  .tps-seg {
    display: inline-flex;
    max-width: 100%;
    padding: 2px;
    border-radius: var(--radius-md);
    background: var(--color-canvas-soft-2);
    box-shadow: var(--shadow-hairline);
  }
  .tps-seg__btn {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--color-mute);
    font-size: 12px;
    line-height: 16px;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    white-space: nowrap;
    touch-action: manipulation;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .tps-seg__btn:hover {
    color: var(--color-body);
  }
  .tps-seg__btn[aria-checked='true'] {
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
  }
  .tps-seg__btn:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  .tps-gloss {
    max-width: 62ch;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }

  /* ── Snapshot row (same shape as every other playground) ─────────────── */
  .tps-snap-btn {
    flex: 0 0 auto;
    height: 30px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    border: none;
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-size: 13px;
    cursor: pointer;
    transition: background 0.12s ease, box-shadow 0.12s ease;
  }
  .tps-snap-btn:hover {
    background: var(--color-canvas-soft);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .tps-snap-select {
    height: 30px;
    max-width: 220px;
    padding: 0 8px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-size: 13px;
  }
  .tps-snap-select:disabled {
    color: var(--color-mute);
    cursor: not-allowed;
  }
  .tps-snap-delete {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .tps-snap-delete:hover {
    background: var(--color-error-soft);
    color: var(--color-error-deep);
  }

  .tps-summary {
    min-width: 0;
    text-align: right;
    overflow-wrap: anywhere;
  }
  .tps-results {
    min-height: 44px;
  }
  .tps-copy-status--fail {
    display: block;
    margin-top: 10px;
    font-size: 12px;
    line-height: 18px;
    color: var(--color-error-deep);
  }

  /* ── Runtime-injected: stat band ─────────────────────────────────────── */
  :global(.tps-stats) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  @media (min-width: 560px) {
    :global(.tps-stats) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  :global(.tps-stat) {
    min-width: 0;
    padding: 10px 12px 11px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    border-top: 3px solid var(--color-hairline-strong);
  }
  :global(.tps-stat--add) {
    border-top-color: var(--color-brand);
  }
  :global(.tps-stat--change) {
    border-top-color: var(--color-accent-ink);
  }
  :global(.tps-stat--destroy) {
    border-top-color: var(--color-error);
  }
  :global(.tps-stat--replace) {
    border-top-color: var(--color-warning);
  }
  :global(.tps-stat__n) {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 600;
    line-height: 26px;
  }
  :global(.tps-stat__sym) {
    font-size: 15px;
    font-weight: 600;
  }
  :global(.tps-stat--add .tps-stat__n) {
    color: var(--color-success);
  }
  :global(.tps-stat--change .tps-stat__n) {
    color: var(--color-accent-ink);
  }
  :global(.tps-stat--destroy .tps-stat__n) {
    color: var(--color-error-deep);
  }
  :global(.tps-stat--replace .tps-stat__n) {
    color: var(--color-warning-deep);
  }
  :global(.tps-stat__label) {
    display: block;
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-body);
  }
  :global(.tps-stat__sub) {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    line-height: 16px;
    color: var(--color-mute);
    text-wrap: pretty;
  }
  :global(.tps-tf-line) {
    margin-top: 8px;
    font-size: 12px;
    line-height: 18px;
    color: var(--color-mute);
    text-wrap: pretty;
  }

  /* ── Runtime-injected: blocks + rows ─────────────────────────────────── */
  :global(.tps-block) {
    margin-top: 12px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
  }
  :global(.tps-block__head) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  :global(.tps-block__title) {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--color-body);
  }
  :global(.tps-block__actions) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  :global(.tps-none) {
    padding: 10px 14px;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-mute);
    text-wrap: pretty;
  }

  :global(.tps-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 6px 10px;
    padding: 9px 14px;
  }
  :global(.tps-row + .tps-row) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.tps-row__main) {
    flex: 1 1 220px;
    min-width: 0;
  }
  :global(.tps-row__addr) {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 19px;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }
  :global(.tps-row__note) {
    display: block;
    margin-top: 3px;
    font-size: 12px;
    line-height: 17px;
    color: var(--color-mute);
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  :global(.tps-row__side) {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 6px;
  }
  :global(.tps-forces) {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 5px;
  }
  :global(.tps-force) {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-warning-soft);
    color: var(--color-warning-deep);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 17px;
    overflow-wrap: anywhere;
  }

  :global(.tps-badge) {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft-2);
    color: var(--color-body);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  :global(.tps-badge--add) {
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
  }
  :global(.tps-badge--change) {
    background: var(--color-canvas);
    color: var(--color-accent-ink);
    box-shadow: inset 0 0 0 1px var(--color-accent-ink);
  }
  :global(.tps-badge--destroy) {
    background: var(--color-error-soft);
    color: var(--color-error-deep);
  }
  :global(.tps-badge--replace) {
    background: var(--color-warning-soft);
    color: var(--color-warning-deep);
  }

  /* ── Runtime-injected: reconciliation + notes ────────────────────────── */
  :global(.tps-note) {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    padding: 10px 14px;
    font-size: 13px;
    line-height: 19px;
    color: var(--color-body);
    text-wrap: pretty;
  }
  :global(.tps-note + .tps-note) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.tps-note--error) {
    background: var(--color-error-soft);
    color: var(--color-error-deep);
  }
  :global(.tps-note--warning) {
    background: var(--color-warning-soft);
    color: var(--color-warning-deep);
  }
  :global(.tps-note--ok) {
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
  }
  :global(.tps-note__icon) {
    flex: 0 0 auto;
    width: 15px;
    height: 15px;
    margin-top: 2px;
  }

  /* ── Runtime-injected: the dark-stable high-risk slab ────────────────── */
  :global(.tps-risk) {
    margin-top: 12px;
    border-radius: var(--radius-md);
    background: var(--color-inverse);
    color: var(--color-inverse-fg);
    overflow: hidden;
  }
  :global(.tps-risk__head) {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    padding: 11px 14px 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-cyan);
  }
  :global(.tps-risk__lead) {
    padding: 0 14px 10px;
    font-size: 13px;
    line-height: 19px;
    color: var(--color-inverse-fg);
    text-wrap: pretty;
  }
  :global(.tps-risk__row) {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 6px 10px;
    padding: 10px 14px;
    border-top: 1px solid rgba(244, 241, 234, 0.14);
  }
  :global(.tps-risk__addr) {
    flex: 1 1 220px;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 19px;
    color: var(--color-inverse-fg);
    overflow-wrap: anywhere;
  }
  :global(.tps-risk__why) {
    display: block;
    margin-top: 3px;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 18px;
    letter-spacing: 0.01em;
    color: var(--color-inverse-fg);
    text-wrap: pretty;
  }
  :global(.tps-risk__class) {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--color-cyan);
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  :global(.tps-risk .tps-copy) {
    color: var(--color-inverse-fg);
  }
  :global(.tps-risk .tps-copy:hover) {
    color: var(--color-cyan);
    background: rgba(244, 241, 234, 0.14);
  }

  /* ── Hard error card + empty state ──────────────────────────────────── */
  :global(.tps-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.tps-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.tps-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.tps-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 19px;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  :global(.tps-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* ── Copy buttons: two coarse-pointer tiers, matching the reference ─── */
  :global(.tps-copy) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition: color 0.12s ease, background 0.12s ease;
  }
  :global(.tps-copy:hover) {
    color: var(--color-brand-strong);
    background: var(--color-hairline);
  }
  :global(.tps-copy:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  :global(.tps-copy--labeled) {
    width: auto;
    height: 26px;
    gap: 6px;
    padding: 0 10px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  :global(.tps-copy--labeled:hover) {
    color: var(--color-brand-strong);
    background: var(--color-canvas-soft);
  }
  :global(.tps-copy--copied) {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
  }
  @media (pointer: coarse) {
    :global(.tps-copy) {
      width: 44px;
      height: 44px;
    }
    :global(.tps-copy--labeled) {
      width: auto;
      height: auto;
      min-height: 44px;
    }
    .tps-chip {
      min-height: 44px;
    }
    .tps-seg__btn {
      min-height: 36px;
    }
  }
</style>

<script>
  import { copyTextToClipboard } from '../lib/clipboard';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  import { examples } from '../lib/terraform-plan-summarizer/examples';
  // The pure HTML builders, shared with this component's frontmatter so the
  // server-rendered seed and every client repaint come from one implementation.
  import {
    EMPTY_HTML,
    LOAD_ERROR_HTML,
    TYPING_HTML,
    errorHtml,
    resultHtml,
    summaryText,
  } from '../lib/terraform-plan-summarizer/render';
  // Result shapes are imported, never hand-mirrored: a hand-copied type that
  // drifts from the engine is a documented past bug on this site.
  import type { PlanSummary, PlanTotals } from '../lib/terraform-plan-summarizer/types';

  /* ---- Engine contract ------------------------------------------------------
     What stays here is the shape of the LAZY module handle, which has no engine
     counterpart. */
  type EngineModule = {
    summarizePlan: (input: string) => PlanSummary;
    toMarkdown: (summary: PlanSummary) => string;
    formatTerraformTotals: (totals: PlanTotals) => string;
  };

  const ROOT_SEL = '.tps-pg';
  const SLUG = 'terraform-plan-summarizer';
  const DEBOUNCE_MS = 200;
  const ERROR_HOLD_MS = 600;
  const RESET_MS = 1800;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.tpsWired === 'true') return;
      root.dataset.tpsWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  async function init(root: HTMLElement): Promise<void> {
    const input = el<HTMLTextAreaElement>(root, '#tps-input');
    const chipsWrap = el<HTMLElement>(root, '#tps-chips');
    const resultsBox = el<HTMLElement>(root, '#tps-results');
    const summaryEl = el<HTMLElement>(root, '#tps-summary');
    const mdBtn = el<HTMLButtonElement>(root, '#tps-copy-md');
    const copyStatus = el<HTMLElement>(root, '#tps-copy-status');
    const groupAction = el<HTMLButtonElement>(root, '#tps-group-action');
    const groupModule = el<HTMLButtonElement>(root, '#tps-group-module');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#tps-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#tps-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#tps-snap-delete');
    if (
      !input ||
      !chipsWrap ||
      !resultsBox ||
      !summaryEl ||
      !mdBtn ||
      !copyStatus ||
      !groupAction ||
      !groupModule ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    )
      return;

    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>('.tps-chip'));

    /* ------------------------------------------------------------------ */
    /* Copy plumbing                                                      */
    /* ------------------------------------------------------------------ */

    // Payloads live in an array and are resolved by `data-copy-ref` at click
    // time. NOTHING untrusted is ever written into an attribute, and that is a
    // deliberate rule rather than an implementation detail:
    //
    //   1. A newline-joined list of 200 addresses does not round-trip through an
    //      HTML attribute at all.
    //   2. HTML attribute-value serialization escapes only `&`, `"` and U+00A0 —
    //      NOT `<`. So a resource address like `aws_s3_bucket.<img src=x
    //      onerror=alert(1)>` assigned to `data-copy` or echoed into an
    //      `aria-label` reappears as literal `<img` when the container's
    //      innerHTML is read back, even though `escapeHtml()` was applied on the
    //      way in. It is inert — an attribute value is never parsed as markup —
    //      but it is indistinguishable from a real escaping bug, so this file
    //      keeps every attribute static and every untrusted value in TEXT
    //      position, where `escapeHtml()` is genuinely sufficient.
    //
    // `data-copy` therefore stays present-but-empty: Layout.astro's analytics
    // listener matches on the attribute's presence, not its value.
    let payloads: string[] = [];
    /** The Markdown report behind the header button (outside `#tps-results`). */
    let markdown = '';

    function payloadFor(btn: HTMLButtonElement): string {
      const ref = btn.dataset.copyRef;
      if (ref !== undefined) return payloads[Number(ref)] ?? '';
      if (btn === mdBtn) return markdown;
      return btn.dataset.copy ?? '';
    }

    function setCopyStatus(message: string, failed: boolean): void {
      copyStatus!.textContent = message;
      copyStatus!.classList.toggle('sr-only', !failed);
      copyStatus!.classList.toggle('tps-copy-status--fail', failed);
    }

    function setCopied(btn: HTMLButtonElement, copied: boolean): void {
      btn.classList.toggle('tps-copy--copied', copied);
      btn.querySelector('.tps-copy-icon')?.classList.toggle('hidden', copied);
      btn.querySelector('.tps-check-icon')?.classList.toggle('hidden', !copied);
      const label = btn.querySelector<HTMLElement>('.tps-copy-label');
      if (label) {
        label.textContent = copied ? 'Copied' : (btn.dataset.copyLabel ?? 'Copy');
      } else if (copied) {
        btn.dataset.prevAriaLabel = btn.getAttribute('aria-label') ?? '';
        btn.setAttribute('aria-label', 'Copied');
      } else if (btn.dataset.prevAriaLabel) {
        btn.setAttribute('aria-label', btn.dataset.prevAriaLabel);
        delete btn.dataset.prevAriaLabel;
      }
    }

    async function handleCopy(btn: HTMLButtonElement): Promise<void> {
      const ok = await copyTextToClipboard(payloadFor(btn));
      if (ok) {
        setCopied(btn, true);
        setCopyStatus('Copied to clipboard.', false);
        window.clearTimeout(Number(btn.dataset.copyTimer));
        btn.dataset.copyTimer = String(
          window.setTimeout(() => {
            setCopied(btn, false);
            if (copyStatus!.textContent === 'Copied to clipboard.') setCopyStatus('', false);
          }, RESET_MS),
        );
      } else {
        setCopyStatus('Copy failed — select the value manually.', true);
      }
    }

    /* ------------------------------------------------------------------ */
    /* Rendering — every builder lives in                                 */
    /* ../lib/terraform-plan-summarizer/render, which the frontmatter uses */
    /* for the server-rendered seed.                                      */
    /* ------------------------------------------------------------------ */

    function setSummary(text: string, isError: boolean): void {
      summaryEl!.textContent = text;
      summaryEl!.classList.toggle('text-error-deep', isError);
      summaryEl!.classList.toggle('text-mute', !isError);
    }

    function renderEmpty(): void {
      setSummary('', false);
      payloads = [];
      resultsBox!.innerHTML = EMPTY_HTML;
    }

    /**
     * Write a rendered panel, then adopt its copy payloads. The builders return
     * the payload array instead of pushing into a closure, so the frontmatter
     * can call exactly the same function and simply drop them.
     */
    function paint(html: string, next: string[]): void {
      resultsBox!.innerHTML = html;
      payloads = next;
    }

    /* ------------------------------------------------------------------ */
    /* Engine                                                             */
    /* ------------------------------------------------------------------ */

    let engine: EngineModule;
    try {
      engine = (await import('../lib/terraform-plan-summarizer/engine')) as unknown as EngineModule;
    } catch (err) {
      setSummary('', true);
      resultsBox.innerHTML = LOAD_ERROR_HTML;
      console.error('[TerraformPlanSummarizer] engine import failed:', err);
      return;
    }

    /* ------------------------------------------------------------------ */
    /* State machine: EMPTY | VALID | PENDING | INVALID                   */
    /* ------------------------------------------------------------------ */

    type State = 'empty' | 'valid' | 'pending' | 'invalid';
    let state: State = 'empty';
    /** Previous textarea value, so one `input` event's delta can be measured. */
    let prevValue = input.value;
    let evalTimer: number | undefined;
    let errTimer: number | undefined;
    let grouping: 'action' | 'module' = 'action';
    /** The last valid summary, so the grouping toggle re-renders without reparsing. */
    let lastSummary: PlanSummary | null = null;

    function clearTimers(): void {
      window.clearTimeout(evalTimer);
      window.clearTimeout(errTimer);
    }

    function setErrorState(on: boolean): void {
      input!.classList.toggle('tps-input--error', on);
      if (on) {
        input!.setAttribute('aria-invalid', 'true');
        input!.setAttribute('aria-describedby', 'tps-input-hint tps-run-hint tps-error-detail');
      } else {
        input!.removeAttribute('aria-invalid');
        input!.setAttribute('aria-describedby', 'tps-input-hint tps-run-hint');
      }
    }

    function hideActions(): void {
      mdBtn!.hidden = true;
      markdown = '';
    }

    function setActiveChip(idx: number | null): void {
      chips.forEach((chip) => {
        chip.setAttribute(
          'aria-pressed',
          idx !== null && chip.dataset.exampleIdx === String(idx) ? 'true' : 'false',
        );
      });
    }

    function toEmpty(): void {
      state = 'empty';
      clearTimers();
      lastSummary = null;
      setErrorState(false);
      hideActions();
      renderEmpty();
      setActiveChip(null);
    }

    /** The hard-error card: shown when nothing usable was found at all. */
    function showError(summary: PlanSummary, isAlert: boolean): void {
      state = 'invalid';
      clearTimers();
      lastSummary = null;
      setErrorState(true);
      hideActions();
      setSummary('nothing to summarize', true);
      paint(errorHtml(summary, isAlert), []);
    }

    function renderSummary(summary: PlanSummary): void {
      const rendered = resultHtml(summary, {
        grouping,
        terraformTotals: engine.formatTerraformTotals(summary.totals),
      });
      paint(rendered.html, rendered.payloads);
      setSummary(summaryText(summary), summary.reconciliation.status === 'mismatch');

      markdown = engine.toMarkdown(summary);
      mdBtn!.hidden = false;
    }

    function evaluate(source: 'type' | 'bulk' | 'commit' | 'seed'): void {
      clearTimers();
      const value = input!.value;
      prevValue = value;
      if (value.trim().length === 0) {
        toEmpty();
        return;
      }

      const summary = engine.summarizePlan(value);

      if (summary.ok) {
        state = 'valid';
        setErrorState(false);
        lastSummary = summary;
        renderSummary(summary);
        // Only a fully valid, user-initiated evaluation is allowed to persist.
        // A seeded boot must never write, and neither must a partial paste:
        // poisoning `oc-last-v1` makes the NEXT visit boot broken. There is no
        // deep-link hash for this tool, so nothing else is written either.
        //
        // Auto-restore is kept here deliberately, and it is the closest call of
        // any tool that has it: a plan is infrastructure TOPOLOGY (ARNs, account
        // ids, resource graph), which is sensitive-ish but not a credential, and
        // re-pasting a large plan is exactly the friction this feature exists to
        // remove. `looksSecret()` in last-input.ts refuses anything key-shaped
        // that rides along inside the plan. Revisit if plans with embedded
        // provider credentials turn out to be common.
        if (source !== 'seed') recordToolLastInput(SLUG, value);
        return;
      }

      if (source !== 'type') {
        showError(summary, source === 'commit');
        return;
      }

      // Mid-typing: hold the error. No red border, no error card — keep whatever
      // is on screen until the person stops typing for ERROR_HOLD_MS.
      const wasInvalid = state === 'invalid';
      state = 'pending';
      setErrorState(false);
      hideActions();
      setSummary('', false);
      if (wasInvalid) paint(TYPING_HTML, []);
      errTimer = window.setTimeout(() => showError(summary, false), ERROR_HOLD_MS);
    }

    /* ------------------------------------------------------------------ */
    /* Events                                                             */
    /* ------------------------------------------------------------------ */

    function setGrouping(next: 'action' | 'module'): void {
      if (grouping === next) return;
      grouping = next;
      groupAction!.setAttribute('aria-checked', String(next === 'action'));
      groupAction!.tabIndex = next === 'action' ? 0 : -1;
      groupModule!.setAttribute('aria-checked', String(next === 'module'));
      groupModule!.tabIndex = next === 'module' ? 0 : -1;
      // Re-render from the summary already in hand: regrouping is a view change,
      // not a new evaluation, so it must not re-persist the last input either.
      if (lastSummary !== null) renderSummary(lastSummary);
    }

    root.addEventListener('click', (evt) => {
      const target = evt.target as HTMLElement;

      const chip = target.closest<HTMLButtonElement>('.tps-chip');
      if (chip && chipsWrap!.contains(chip)) {
        const idx = Number(chip.dataset.exampleIdx);
        const example = examples[idx];
        if (!example) return;
        input!.value = example.input;
        prevValue = example.input;
        setActiveChip(idx);
        evaluate('commit');
        return;
      }

      const seg = target.closest<HTMLButtonElement>('.tps-seg__btn');
      if (seg) {
        setGrouping(seg.id === 'tps-group-module' ? 'module' : 'action');
        return;
      }

      const copy = target.closest<HTMLButtonElement>('.tps-copy');
      if (copy) void handleCopy(copy);
    });

    // Arrow keys move within a radiogroup, per the ARIA pattern.
    root.addEventListener('keydown', (evt) => {
      const seg = (evt.target as HTMLElement).closest<HTMLButtonElement>('.tps-seg__btn');
      if (!seg) return;
      if (evt.key !== 'ArrowLeft' && evt.key !== 'ArrowRight') return;
      evt.preventDefault();
      const next = grouping === 'action' ? 'module' : 'action';
      setGrouping(next);
      (next === 'module' ? groupModule! : groupAction!).focus();
    });

    input.addEventListener('input', (e) => {
      clearTimers();
      const value = input.value;
      // Only GROWTH beyond one character is a paste. `Math.abs(delta) > 1` would
      // treat a backspace over a selection as a paste, flash a red border
      // mid-edit, and break the calm-error contract. Deletions and IME
      // composition debounce like typing.
      const grew = value.length - prevValue.length > 1;
      const composing = (e as InputEvent).isComposing === true;
      prevValue = value;
      setActiveChip(null);
      if (value.trim().length === 0) {
        toEmpty();
        return;
      }
      if (grew && !composing) {
        evaluate('bulk');
        return;
      }
      evalTimer = window.setTimeout(() => evaluate('type'), DEBOUNCE_MS);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      if (e.ctrlKey || e.metaKey) {
        e.preventDefault();
        evaluate('commit');
        if (window.matchMedia?.('(pointer: coarse)').matches) input.blur();
        return;
      }
      // Plain Enter must still insert the newline — a plan is multi-line. Flush
      // on the next tick, once the textarea value includes it.
      window.setTimeout(() => evaluate('commit'), 0);
    });

    input.addEventListener('blur', () => {
      if (state === 'pending') evaluate('commit');
    });

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => input!.value,
      setValue: (value) => {
        input!.value = value;
        prevValue = value;
        setActiveChip(null);
        evaluate('commit');
      },
    });

    /* ------------------------------------------------------------------ */
    /* First load: typed value → restored last input → first example.     */
    /* There is NO deep link for this tool (a plan is orders of magnitude  */
    /* past the fragment cap), so nothing here reads or writes            */
    /* location.hash — including an unknown key someone appends by hand.   */
    /* ------------------------------------------------------------------ */

    const restored = getRestoredLastInput(SLUG);
    // Typed-before-hydration wins, but the textarea is SERVER-SEEDED with
    // examples[0] — compare against `defaultValue` (the seeded text), because a
    // bare non-emptiness test always wins once the server fills it in, which
    // would silently shadow the restored last input.
    if (input.value.trim() && input.value !== input.defaultValue) {
      evaluate('seed');
    } else if (restored) {
      input.value = restored;
      prevValue = restored;
      evaluate('seed');
    } else if (examples[0]) {
      input.value = examples[0].input;
      prevValue = examples[0].input;
      setActiveChip(0);
      evaluate('seed');
    } else {
      renderEmpty();
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
