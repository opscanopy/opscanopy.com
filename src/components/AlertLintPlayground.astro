---
/**
 * AlertLintPlayground — the interactive AlertLint island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>
 * that lazily boots two CodeMirror 6 editors (Rules + Test), wires an example
 * picker, a "Run tests" action, and a shareable-URL encoder. It runs entirely
 * client-side and is fully usable offline once loaded.
 *
 * Runtime contract (built by sibling agents — imported lazily in the script):
 *   ../lib/alertlint/engine →
 *     runTests(rulesYaml: string, testYaml: string) => RunResult
 *       RunResult = {
 *         ok: boolean
 *         error?: string
 *         summary: { total, passed, failed, durationMs }
 *         results: Array<{
 *           name: string
 *           evalTime?: string
 *           status: 'pass' | 'fail'
 *           kind?: string
 *           message?: string
 *           diff?: { expected?: string; actual?: string }
 *         }>
 *       }
 *     encodeState(rulesYaml: string, testYaml: string) => string  // hash fragment
 *     decodeState() => { rules: string; test: string } | null
 *   ../lib/alertlint/examples →
 *     examples: Array<{ name|label|title; rules|rulesYaml; test|testYaml }>
 *
 * The dark editor surface follows DESIGN.md `code-editor-mockup`; results use the
 * semantic success / error tokens. Headlines stay sentence-case, weight 600.
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. The script never
// rebuilds them — it only reads each chip's `data-example-idx` into the lazily
// imported array — so this adds nothing to the client bundle and cannot drift.
import { examples as prerenderedExamples } from '../lib/alertlint/examples';
import { runTests } from '../lib/alertlint/engine';
import { resultsHtml, countsText, EMPTY_HTML } from '../lib/alertlint/render';

/**
 * Server-rendered seed. The client re-runs the same example on boot, so this
 * is the same markup it would paint — but it is already in the static HTML,
 * which is all an AI crawler (no JS) ever sees.
 *
 * `runTests()` is deterministic except for `summary.durationMs`, a wall-clock
 * reading. `countsText` deliberately omits it and the client alone appends
 * `formatDuration`, so the built page carries no timing and is reproducible.
 *
 * The two YAML documents go into `<pre data-cm-fallback>` elements inside the
 * CodeMirror hosts; CM appends its editor to the host, so `init` removes them
 * once mounted.
 */
const seedExample = prerenderedExamples[0];
const seedResult = seedExample ? runTests(seedExample.rulesYaml, seedExample.testYaml) : null;
const seedOk = seedResult && seedResult.ok !== false && !seedResult.error ? seedResult : null;
const seedHtml = seedOk ? resultsHtml(seedOk) : EMPTY_HTML;
const seedSummary = seedOk && seedOk.summary ? countsText(seedOk.summary) : '';
const seedFailed = Boolean(seedOk && seedOk.summary && seedOk.summary.failed > 0);

---

<section class="playground" aria-label="AlertLint playground">
  <div class="card shadow-float rounded-lg overflow-hidden">
    {/* ── Toolbar ──────────────────────────────────────────────────────── */}
    <div
      class="flex flex-col gap-3 border-b border-hairline px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-5"
    >
      <div class="flex min-w-0 flex-col gap-2">
        {/* A chip group is not a form control, so the visible caption is a
            plain span and the group carries its own aria-label. */}
        <span class="eyebrow shrink-0">Example</span>
        <div id="al-chips" class="al-chips" role="group" aria-label="Examples">
          {/* Server-rendered so the examples are in the static HTML; the
              hydration script only wires clicks onto these buttons. */}
          {prerenderedExamples.map((ex, i) => (
            <button
              type="button"
              class={i === 0 ? 'al-chip is-active' : 'al-chip'}
              data-example-idx={i}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {ex.label}
            </button>
          ))}
        </div>
      </div>

      <div class="flex shrink-0 flex-wrap items-center gap-2">
        <span class="caption text-mute hidden items-center sm:inline-flex">⌘/Ctrl + Enter</span>
        <button
          id="al-share"
          type="button"
          class="btn btn-secondary btn-sm al-tap"
          data-default-label="Share Link"
          title="This link encodes your alert rules — review before sharing."
        >
          <svg
            class="h-4 w-4 shrink-0"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 8.5l4-1.5M6 8.5l4 1.5"></path>
            <circle cx="4" cy="8" r="1.6"></circle>
            <circle cx="11.5" cy="5" r="1.6"></circle>
            <circle cx="11.5" cy="11" r="1.6"></circle>
          </svg>
          <span class="al-share-label">Share Link</span>
        </button>
        <button
          id="al-run"
          type="button"
          class="btn btn-primary btn-sm al-tap"
          title="Run Tests (⌘/Ctrl + Enter)"
          aria-keyshortcuts="Meta+Enter Control+Enter"
        >
          <svg
            class="al-run-icon h-4 w-4 shrink-0"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 3.5l7 4.5-7 4.5z" fill="currentColor" stroke="none"></path>
          </svg>
          <span class="al-run-label">Run Tests</span>
        </button>
      </div>
    </div>

    {/* ── Mobile tab switch (single-pane on small screens) ─────────────── */}
    <div
      class="al-tabs flex gap-1 border-b border-hairline px-4 py-2 sm:hidden"
      role="tablist"
      aria-label="Editor panes"
    >
      <button
        id="al-tab-rules"
        type="button"
        class="al-tab al-tap is-active"
        role="tab"
        aria-selected="true"
        aria-controls="al-pane-rules"
        data-pane="rules"
        tabindex="0"
      >
        Rules
      </button>
      <button
        id="al-tab-test"
        type="button"
        class="al-tab al-tap"
        role="tab"
        aria-selected="false"
        aria-controls="al-pane-test"
        data-pane="test"
        tabindex="-1"
      >
        Test
      </button>
    </div>

    {/* ── Editor split (side-by-side on desktop, tabbed on mobile) ─────── */}
    <div class="al-grid grid grid-cols-1 sm:grid-cols-2">
      <div
        id="al-pane-rules"
        class="al-pane al-pane--active flex min-w-0 flex-col bg-inverse sm:border-r sm:border-white/10"
        role="tabpanel"
        aria-labelledby="al-tab-rules"
      >
        <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2.5">
          <span class="flex shrink-0 items-center gap-1.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
          </span>
          <span class="code-mono text-white/45">rules.yaml</span>
        </div>
        <p class="body-sm text-white/55 px-4 mb-2">Runs in your browser — nothing is uploaded.</p>
        <div
          id="al-editor-rules"
          class="al-editor min-h-72"
          aria-label="Loki alert rules (YAML)"
        >
          <pre class="al-cm-fallback code-mono" data-cm-fallback>{seedExample?.rulesYaml}</pre>
        </div>
        <p class="text-xs text-white/55 px-4 mt-1">Tip: press <kbd style="border:1px solid currentColor;border-radius:3px;padding:0 3px;font-size:0.85em">Esc</kbd> to release focus.</p>
        <div class="al-snap-row mt-2 mb-2 flex flex-wrap items-center gap-2" style="padding: 0 16px;">
          <button id="al-snap-save" type="button" class="al-snap-btn">Save snapshot</button>
          <select id="al-snap-select" class="al-snap-select" aria-label="Load a saved snapshot" disabled>
            <option value="">No snapshots yet</option>
          </select>
          <button id="al-snap-delete" type="button" class="al-snap-delete" aria-label="Delete this snapshot" hidden>&times;</button>
        </div>
      </div>

      <div
        id="al-pane-test"
        class="al-pane flex min-w-0 flex-col bg-inverse"
        role="tabpanel"
        aria-labelledby="al-tab-test"
      >
        <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2.5">
          <span class="flex shrink-0 items-center gap-1.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
          </span>
          <span class="code-mono text-white/45">test.yaml</span>
        </div>
        <div
          id="al-editor-test"
          class="al-editor min-h-72"
          aria-label="Test cases (YAML)"
        >
          <pre class="al-cm-fallback code-mono" data-cm-fallback>{seedExample?.testYaml}</pre>
        </div>
      </div>
    </div>

    {/* ── Results panel ────────────────────────────────────────────────── */}
    <div class="border-t border-hairline bg-canvas-soft px-4 py-4 sm:px-5">
      <div class="mb-3 flex items-center justify-between gap-3">
        <span class="eyebrow">Results</span>
        <span
          id="al-summary"
          class:list={['al-summary code-mono', seedFailed ? 'text-error' : 'text-mute']}
          role="status"
          aria-live="polite"
        >{seedSummary}</span>
      </div>

      {/* Seeded at build time (see `seedHtml` above) so the pass/fail rows are
          in the static HTML; the script repaints this same node on every run. */}
      <div id="al-results" class="al-results" set:html={seedHtml}></div>
    </div>
  </div>

  {/* Polite announcer for clipboard + transient toasts. */}
  <span id="al-announce" class="sr-only" role="status" aria-live="polite"></span>
</section>

<style>
  @reference "../styles/global.css";

  /* Tap targets opt into fast-tap + no double-tap-zoom on touch. */
  .al-tap {
    touch-action: manipulation;
  }

  /* Build-time text stand-in for each CodeMirror document: what a no-JS
     visitor and every AI crawler read. `init` removes it once CM mounts. */
  .al-cm-fallback {
    margin: 0;
    padding: 14px 16px 16px;
    max-height: 360px;
    overflow: auto;
    color: #e6e6e6;
    font-size: 13px;
    line-height: 20px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* The example picker: squared mono chips (playground UX contract). */
  .al-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .al-chip {
    display: inline-flex;
    align-items: center;
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline-muted);
    background: var(--color-canvas);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.01em;
    color: var(--color-brand-strong);
    cursor: pointer;
    touch-action: manipulation;
    transition: background 0.12s ease, border-color 0.12s ease, color 0.12s ease;
  }
  .al-chip:hover {
    border-color: var(--color-hairline-strong);
    background: var(--color-canvas-hover);
  }
  .al-chip.is-active {
    background: var(--color-brand-soft);
    border-color: var(--color-brand-strong);
    color: var(--color-brand-strong);
  }
  .al-chip:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  @media (pointer: coarse) {
    .al-chip {
      min-height: 44px;
    }
  }

  .al-snap-btn {
    flex: 0 0 auto;
    height: 30px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    border: none;
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-size: 13px;
    cursor: pointer;
    transition: background 0.12s ease, box-shadow 0.12s ease;
  }
  .al-snap-btn:hover {
    background: var(--color-canvas-soft);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .al-snap-select {
    height: 30px;
    max-width: 220px;
    padding: 0 8px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-size: 13px;
  }
  .al-snap-select:disabled {
    color: var(--color-mute);
    cursor: not-allowed;
  }
  .al-snap-delete {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .al-snap-delete:hover {
    background: var(--color-error-soft);
    color: var(--color-error-deep);
  }

  /* Mobile tab pills (square in-app scale; never the 100px marketing pill). */
  .al-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 0;
    min-height: 44px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-mute);
    background: transparent;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .al-tab:hover:not(.is-active) {
    color: var(--color-body);
    background: var(--color-canvas-soft-2);
  }
  .al-tab.is-active {
    color: var(--color-on-primary);
    background: var(--color-primary);
  }

  /* Visibility is driven by the .al-pane--active class, NOT the [hidden]
     attribute. Tailwind v4's layered `[hidden]{display:none!important}` (in
     @layer base) beats any unlayered !important override, which previously left
     the test pane invisible on desktop. */
  @media (max-width: 639px) {
    .al-pane {
      display: none;
    }
    .al-pane.al-pane--active {
      display: flex;
    }
  }
  @media (min-width: 640px) {
    /* Desktop: both panes always visible side by side. */
    .al-pane {
      display: flex;
    }
  }

  /* CodeMirror host — fills the dark pane, scrolls internally. */
  .al-editor {
    overflow: hidden;
  }
  .al-editor :global(.cm-editor) {
    height: 100%;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
  }
  .al-editor :global(.cm-editor.cm-focused) {
    /* Replace CM's default outline with a brand-blue ring (a11y: keep a ring). */
    outline: 2px solid var(--color-link);
    outline-offset: -2px;
  }
  .al-editor :global(.cm-scroller) {
    overflow: auto;
    max-height: 300px;
    font-family: var(--font-mono);
    /* Thin, theme-matched scrollbars on the dark surface. */
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
  }
  .al-editor :global(.cm-scroller)::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }
  .al-editor :global(.cm-scroller)::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-pill);
    border: 3px solid transparent;
    background-clip: content-box;
  }
  .al-editor :global(.cm-scroller)::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.28);
    background-clip: content-box;
  }
  .al-editor :global(.cm-gutters) {
    background: transparent;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }
  .al-editor :global(.cm-lineNumbers .cm-gutterElement) {
    color: rgba(255, 255, 255, 0.32);
  }
  .al-editor :global(.cm-content) {
    padding: 14px 0 16px;
  }
  .al-editor :global(.cm-line) {
    padding-inline: 4px;
  }

  /* Summary — right-aligned counts use tabular figures so they don't jitter. */
  .al-summary {
    white-space: nowrap;
  }

  /* Results rows. */
  .al-results {
    min-height: 44px;
  }
  :global(.al-row) {
    display: flex;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    animation: al-rise 0.18s ease both;
  }
  :global(.al-row:hover) {
    box-shadow: var(--shadow-subtle);
  }
  :global(.al-row--fail:hover) {
    box-shadow: inset 0 0 0 1px var(--color-error-soft), var(--shadow-subtle);
  }
  :global(.al-row + .al-row) {
    margin-top: 8px;
  }
  @keyframes al-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.al-row) {
      animation: none;
    }
  }
  :global(.al-row__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.al-row--pass .al-row__icon) {
    color: var(--color-success);
  }
  :global(.al-row--fail) {
    box-shadow: inset 0 0 0 1px var(--color-error-soft);
  }
  :global(.al-row--fail .al-row__icon) {
    color: var(--color-error);
  }
  :global(.al-row__body) {
    min-width: 0;
    flex: 1 1 auto;
  }
  :global(.al-row__name) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    word-break: break-word;
  }
  :global(.al-row__meta) {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    color: var(--color-mute);
  }
  :global(.al-row__msg) {
    margin-top: 4px;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    word-break: break-word;
  }

  /* Expected / actual diff block. */
  :global(.al-diff) {
    margin-top: 8px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-hairline);
  }
  :global(.al-diff__row) {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 8px;
    padding: 6px 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
  }
  :global(.al-diff__row + .al-diff__row) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.al-diff__label) {
    color: var(--color-mute);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  :global(.al-diff__val) {
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--color-ink);
  }
  :global(.al-diff__row--exp) {
    background: var(--color-canvas-soft-2);
  }
  :global(.al-diff__row--act) {
    background: var(--color-error-soft);
  }
  :global(.al-diff__row--act .al-diff__val) {
    color: var(--color-error-deep);
  }

  /* Parse-error banner. */
  :global(.al-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
    animation: al-rise 0.18s ease both;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.al-error) {
      animation: none;
    }
  }
  :global(.al-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.al-error__body) {
    min-width: 0;
  }
  :global(.al-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.al-error__detail) {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* Empty state — generous, centered frame (ex-empty-state-card scale). */
  :global(.al-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* Loading dots — animate opacity only; reduced-motion handled globally. */
  :global(.al-loading) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-body);
  }
  :global(.al-loading__dot) {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-mute);
    animation: al-pulse 1.1s ease-in-out infinite;
  }
  :global(.al-loading__dot:nth-child(2)) {
    animation-delay: 0.18s;
  }
  :global(.al-loading__dot:nth-child(3)) {
    animation-delay: 0.36s;
  }
  @keyframes al-pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.al-loading__dot) {
      animation: none;
      opacity: 0.6;
    }
  }

  .is-busy {
    opacity: 0.65;
    pointer-events: none;
    cursor: progress;
  }
  .is-busy .al-run-icon {
    display: none;
  }
  /* Compact spinner shown in the Run button while tests execute. */
  .al-spinner {
    width: 14px;
    height: 14px;
    flex: 0 0 auto;
    border-radius: 9999px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    animation: al-spin 0.6s linear infinite;
  }
  @keyframes al-spin {
    to {
      transform: rotate(360deg);
    }
  }
  /* Reduced motion is handled globally (animations clamped); the “Running…”
     label + aria-busy still convey the in-flight state without a spin. */
</style>

<script>
  import { copyTextToClipboard as copyText } from '../lib/clipboard';
  import type { EditorView } from '@codemirror/view';
  import type { RunResult } from '../lib/alertlint/types';
  import {
    EMPTY_HTML,
    LOADING_HTML,
    countsText,
    errorHtml,
    formatDuration,
    resultsHtml,
  } from '../lib/alertlint/render';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';

  // CodeMirror is loaded via dynamic import inside init() so its ~200KB runtime
  // code-splits into its own chunk instead of shipping in the page's initial JS.
  // The `EditorView` type above is erased at build time and ships no runtime code.

  /* ---- Engine contract ------------------------------------------------------
     Imported, never hand-mirrored: a copied shape drifts silently when the
     engine gains a field the render code reads (`import type` is erased at
     build time, so it does not affect code-splitting). */

  type EngineModule = {
    runTests: (rulesYaml: string, testYaml: string) => RunResult | Promise<RunResult>;
    encodeState: (rulesYaml: string, testYaml: string) => string;
    decodeState: () => { rules: string; test: string } | null;
  };
  type ExampleRaw = Record<string, unknown>;
  type Example = { name: string; rules: string; test: string };

  const ROOT_SEL = '.playground';
  const COPIED_RESET_MS = 1800;
  const SLUG = 'loki-alert-rule-tester';

  /** Boot every (so far un-hydrated) playground instance on the page. */
  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.alWired === 'true') return;
      root.dataset.alWired = 'true';
      void init(root);
    });
  }

  /* ---- Small helpers -------------------------------------------------------- */

  function pick(obj: ExampleRaw, keys: string[]): string {
    for (const k of keys) {
      const v = obj[k];
      if (typeof v === 'string' && v.length > 0) return v;
    }
    return '';
  }

  /** Normalise the sibling `examples` array against likely field names. */
  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw.map((item, i) => {
      const o = (item ?? {}) as ExampleRaw;
      return {
        name: pick(o, ['name', 'label', 'title', 'id']) || `Example ${i + 1}`,
        rules: pick(o, ['rules', 'rulesYaml', 'rulesDoc', 'ruleYaml']),
        test: pick(o, ['test', 'testYaml', 'testDoc', 'tests']),
      };
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  /* ---- Result rendering --------------------------------------------------
     The pure HTML builders live in `../lib/alertlint/render`, imported above and
     ALSO used by this component's frontmatter, so the server-rendered seed and
     every client repaint are produced by one implementation. Only the DOM
     writes stay here. */

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    summary.textContent = '';
    container.innerHTML = EMPTY_HTML;
  }

  function renderLoading(container: HTMLElement, summary: HTMLElement): void {
    summary.textContent = '';
    container.innerHTML = LOADING_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    summary.textContent = 'Error';
    summary.classList.add('text-error');
    summary.classList.remove('text-mute');
    container.innerHTML = errorHtml(message);
  }

  function renderResults(
    container: HTMLElement,
    summary: HTMLElement,
    result: RunResult
  ): void {
    if (!result || result.ok === false || result.error) {
      renderError(container, summary, result?.error ?? 'Unknown error while running tests.');
      return;
    }

    const s = result.summary ?? { total: 0, passed: 0, failed: 0, durationMs: 0 };
    // The counts come from the shared builder; the wall-clock duration is
    // appended only here, so the server-rendered seed carries no timing.
    const dur = formatDuration(s.durationMs);
    summary.textContent = countsText(s) + (dur ? ` · ${dur}` : '');
    summary.classList.toggle('text-error', s.failed > 0);
    summary.classList.toggle('text-mute', s.failed === 0);

    container.innerHTML = resultsHtml(result);
  }

  /* ---- Clipboard ------------------------------------------------------------ */

  /* ---- Instance init -------------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const rulesHost = el<HTMLElement>(root, '#al-editor-rules');
    const testHost = el<HTMLElement>(root, '#al-editor-test');
    const chipsWrap = el<HTMLElement>(root, '#al-chips');
    const runBtn = el<HTMLButtonElement>(root, '#al-run');
    const shareBtn = el<HTMLButtonElement>(root, '#al-share');
    const resultsBox = el<HTMLElement>(root, '#al-results');
    const summaryEl = el<HTMLElement>(root, '#al-summary');
    const announce = el<HTMLElement>(root, '#al-announce');
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.al-tab'));
    const snapSaveBtn = el<HTMLButtonElement>(root, '#al-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#al-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#al-snap-delete');

    if (
      !rulesHost ||
      !testHost ||
      !chipsWrap ||
      !runBtn ||
      !shareBtn ||
      !resultsBox ||
      !summaryEl ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    // Lazily load CodeMirror + the sibling engine + examples (kept out of the
    // initial path so the ~200KB CM runtime code-splits into its own chunk).
    let engine: EngineModule;
    let examples: Example[] = [];
    let makeEditor: (host: HTMLElement, doc: string) => EditorView;
    let setEditorDoc: (view: EditorView, doc: string) => void;
    try {
      const [
        { EditorState },
        { EditorView, keymap, lineNumbers, highlightActiveLine },
        { defaultKeymap, history: cmHistory, historyKeymap, indentWithTab },
        { yaml },
        { oneDark },
        engineMod,
        examplesMod,
      ] = await Promise.all([
        import('@codemirror/state'),
        import('@codemirror/view'),
        import('@codemirror/commands'),
        import('@codemirror/lang-yaml'),
        import('@codemirror/theme-one-dark'),
        import('../lib/alertlint/engine'),
        import('../lib/alertlint/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);

      // Editor factory + doc-setter as closures over the freshly imported CM
      // symbols (so no runtime CM reference lives at module top level).
      makeEditor = (host: HTMLElement, doc: string): EditorView => {
        const state = EditorState.create({
          doc,
          extensions: [
            lineNumbers(),
            cmHistory(),
            highlightActiveLine(),
            yaml(),
            oneDark,
            EditorView.lineWrapping,
            keymap.of([...defaultKeymap, ...historyKeymap, indentWithTab, { key: 'Escape', run: function(view) { view.contentDOM.blur(); return true; } }]),
            EditorView.theme({
              '&': { color: '#e6e6e6' },
              '.cm-content': { caretColor: '#e6e6e6' },
              '.cm-cursor, .cm-dropCursor': { borderLeftColor: '#e6e6e6' },
              '&.cm-focused .cm-selectionBackground, .cm-selectionBackground, ::selection':
                { backgroundColor: 'rgba(0, 112, 243, 0.32)' },
              '.cm-activeLine': { backgroundColor: 'rgba(255, 255, 255, 0.035)' },
              '.cm-activeLineGutter': { backgroundColor: 'transparent' },
            }),
          ],
        });
        // The host already carries the aria-label/role for screen readers; CM mounts inside.
        return new EditorView({ state, parent: host });
      };

      setEditorDoc = (view: EditorView, doc: string): void => {
        view.dispatch({
          changes: { from: 0, to: view.state.doc.length, insert: doc },
        });
      };
    } catch (err) {
      renderError(
        resultsBox,
        summaryEl,
        'The AlertLint engine failed to load. Reload the page to try again.'
      );
      // Surface the underlying reason in dev tooling without breaking the UI.
      // eslint-disable-next-line no-console
      console.error('[AlertLint] engine/examples import failed:', err);
      return;
    }

    // The build-time text stand-ins have done their job (no-JS visitors and
    // crawlers); CodeMirror appended its editors beside them, so drop them.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());

    // Seed content: prefer a shared-state URL, else a restored last input,
    // else the first example.
    const seedExample = examples[0] ?? { name: 'Example', rules: '', test: '' };
    let seedRules = seedExample.rules;
    let seedTest = seedExample.test;
    let fromShare = false;
    try {
      const decoded = engine.decodeState();
      if (decoded && (decoded.rules || decoded.test)) {
        seedRules = decoded.rules ?? '';
        seedTest = decoded.test ?? '';
        fromShare = true;
      }
    } catch {
      /* malformed hash — fall back to the example seed */
    }

    // Restored last-input tier — only consulted when there's no shared-state
    // URL. Defensive JSON parse: bails silently on anything malformed.
    let fromRestored = false;
    if (!fromShare) {
      const raw = getRestoredLastInput(SLUG);
      if (raw) {
        try {
          const parsed = JSON.parse(raw) as Partial<{ rules: string; test: string }>;
          if (typeof parsed.rules === 'string' && typeof parsed.test === 'string' && (parsed.rules || parsed.test)) {
            seedRules = parsed.rules;
            seedTest = parsed.test;
            fromRestored = true;
          }
        } catch {
          /* malformed stored value — ignore, fall back to the example seed */
        }
      }
    }

    const rulesView = makeEditor(rulesHost, seedRules);
    const testView = makeEditor(testHost, seedTest);

    // The example chips are server-rendered from the same `examples` module,
    // so a chip's data-example-idx indexes straight into the array above.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>('.al-chip'));

    /** Mark one chip active (or none, when the seed came from a share/restore). */
    const setActiveChip = (idx: number | null): void => {
      chips.forEach((chip) => {
        const active = idx !== null && chip.dataset.exampleIdx === String(idx);
        chip.classList.toggle('is-active', active);
        chip.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    };

    // A shared snippet or a restored input matches no example — leave every
    // chip unpressed rather than implying one of them is loaded.
    setActiveChip(fromShare || fromRestored || examples.length === 0 ? null : 0);

    // Swap both editors when a different example is chosen.
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        const ex = examples[idx];
        setEditorDoc(rulesView, ex.rules);
        setEditorDoc(testView, ex.test);
        setActiveChip(idx);
        renderEmpty(resultsBox, summaryEl);
        summaryEl.classList.remove('text-error');
        summaryEl.classList.add('text-mute');
      });
    });

    // Mobile tab switching (panes are always visible on desktop via CSS).
    const rulesPane = el<HTMLElement>(root, '#al-pane-rules');
    const testPane = el<HTMLElement>(root, '#al-pane-test');

    /** Activate a tab: update aria-selected, roving tabindex, pane visibility. */
    function activateTab(tab: HTMLButtonElement, focusTab: boolean): void {
      const showRules = tab.dataset.pane === 'rules';
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
        // Roving tabindex: only the selected tab is in the tab order.
        t.tabIndex = active ? 0 : -1;
      });
      rulesPane?.classList.toggle('al-pane--active', showRules);
      testPane?.classList.toggle('al-pane--active', !showRules);
      if (focusTab) tab.focus();
      // Refresh CM measurement once the pane is visible (next frame, post-layout).
      requestAnimationFrame(() => (showRules ? rulesView : testView).requestMeasure());
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activateTab(tab, false));
      // Roving focus with Left/Right/Home/End per the tablist a11y pattern.
      tab.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp')
          next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        activateTab(tabs[next], true);
      });
    });

    // Run — non-blocking; show loading, yield a microtask, then render.
    let running = false;
    const runLabel = runBtn.querySelector<HTMLElement>('.al-run-label');
    let spinner: HTMLElement | null = null;
    async function run(userInitiated = true): Promise<void> {
      // Guaranteed present by the early return in boot(); restated because TypeScript
      // discards that narrowing inside a hoisted function declaration.
      if (!runBtn) return;
      if (running) return;
      running = true;
      runBtn.classList.add('is-busy');
      // Keep the control enabled until work begins, then mark it busy (not disabled,
      // so focus stays put for keyboard users) and swap the play glyph for a spinner.
      runBtn.setAttribute('aria-disabled', 'true');
      runBtn.setAttribute('aria-busy', 'true');
      if (!spinner) {
        spinner = document.createElement('span');
        spinner.className = 'al-spinner';
        spinner.setAttribute('aria-hidden', 'true');
        // Inline the visual so it never depends on Astro's scoped CSS — this span
        // is created at runtime and would not receive the component's scope hash.
        spinner.style.cssText =
          'display:inline-block;width:14px;height:14px;flex:0 0 auto;border-radius:9999px;' +
          'border:2px solid currentColor;border-top-color:transparent;';
        if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          spinner.animate(
            [{ transform: 'rotate(0deg)' }, { transform: 'rotate(360deg)' }],
            { duration: 700, iterations: Infinity }
          );
        }
        runBtn.insertBefore(spinner, runBtn.firstChild);
      }
      if (runLabel) runLabel.textContent = 'Running…';
      renderLoading(resultsBox!, summaryEl!);

      // Yield so the loading state paints before (potentially heavy) work runs.
      await new Promise<void>((resolve) => {
        if ('requestAnimationFrame' in window) {
          requestAnimationFrame(() => resolve());
        } else {
          setTimeout(resolve, 0);
        }
      });

      try {
        const rulesDoc = rulesView.state.doc.toString();
        const testDoc = testView.state.doc.toString();
        const result = await Promise.resolve(engine.runTests(rulesDoc, testDoc));
        renderResults(resultsBox!, summaryEl!, result);
        // Persist current state into the URL hash without a history entry.
        // Only a user-initiated run (button click / ⌘⏎) rewrites the address
        // bar and records the last input — the initial seed-from-hash/
        // restored/example run never does either.
        try {
          const hash = engine.encodeState(rulesDoc, testDoc);
          if (typeof hash === 'string') {
            const url = hash.startsWith('#') ? hash : `#${hash}`;
            // window.history — the CM `history` import no longer shadows the global.
            if (userInitiated) window.history.replaceState(null, '', url);
          }
        } catch {
          /* non-fatal: sharing just won't update */
        }
        if (userInitiated) {
          recordToolLastInput(SLUG, JSON.stringify({ rules: rulesDoc, test: testDoc }));
        }
      } catch (err) {
        const msg =
          err instanceof Error ? err.message : 'Unexpected error while running tests.';
        renderError(resultsBox!, summaryEl!, msg);
      } finally {
        running = false;
        runBtn.classList.remove('is-busy');
        runBtn.removeAttribute('aria-disabled');
        runBtn.removeAttribute('aria-busy');
        if (spinner) {
          spinner.remove();
          spinner = null;
        }
        if (runLabel) runLabel.textContent = 'Run Tests';
      }
    }

    runBtn.addEventListener('click', () => void run());

    // Cmd/Ctrl+Enter from inside either editor triggers a run.
    root.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        void run();
      }
    });

    // Share — copy the encodeState URL to the clipboard.
    const shareLabel = shareBtn.querySelector<HTMLElement>('.al-share-label');
    let shareTimer: number | undefined;
    shareBtn.addEventListener('click', async () => {
      const rulesDoc = rulesView.state.doc.toString();
      const testDoc = testView.state.doc.toString();
      let shareUrl = window.location.href;
      try {
        const hash = engine.encodeState(rulesDoc, testDoc);
        if (typeof hash === 'string') {
          const frag = hash.startsWith('#') ? hash : `#${hash}`;
          const base = window.location.href.split('#')[0];
          shareUrl = `${base}${frag}`;
          // window.history — the CM `history` import no longer shadows the global.
          window.history.replaceState(null, '', frag);
        }
      } catch {
        /* fall back to the current URL */
      }
      const ok = await copyText(shareUrl);
      if (shareLabel) shareLabel.textContent = ok ? 'Link Copied' : 'Copy Failed';
      if (announce) {
        announce.textContent = ok
          ? 'Share link copied to your clipboard.'
          : 'Could not copy the link. Copy the URL from your address bar instead.';
      }
      window.clearTimeout(shareTimer);
      shareTimer = window.setTimeout(() => {
        if (shareLabel) shareLabel.textContent = shareBtn.dataset.defaultLabel ?? 'Share Link';
      }, COPIED_RESET_MS);
    });

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () =>
        JSON.stringify({ rules: rulesView.state.doc.toString(), test: testView.state.doc.toString() }),
      setValue: (value) => {
        let parsed: Partial<{ rules: string; test: string }> | null = null;
        try {
          parsed = JSON.parse(value) as Partial<{ rules: string; test: string }>;
        } catch {
          return;
        }
        if (!parsed || typeof parsed.rules !== 'string' || typeof parsed.test !== 'string') {
          return;
        }
        setEditorDoc(rulesView, parsed.rules);
        setEditorDoc(testView, parsed.test);
        void run();
      },
    });

    // Auto-run on load so the output panel is populated immediately. Passing
    // `false` means this first run never rewrites the URL hash or records a
    // last-input — only subsequent user-initiated runs do (see the
    // `userInitiated` gate in run() above).
    void run(false);
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
