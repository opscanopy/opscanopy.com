---
/**
 * AlertLintPlayground — the interactive AlertLint island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>
 * that lazily boots two CodeMirror 6 editors (Rules + Test), wires the example
 * chips, live test runs with a "Run now" control, and Copy link (the state
 * encoded in the URL hash). It is fully usable offline once loaded.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * two EditorPanes (each a FigureCap over its CodeMirror host, seeded with a
 * `<pre data-cm-fallback>`), RunHint and SnapshotBar on paper, and
 * ResultPanel (figure cap, live summary, copy status) with CopyButton. The
 * results container stays here, seeded with `set:html` + `data-results`; its
 * slab overrides anchor on `.al-results`.
 *
 * Runtime contract (imported lazily in the script):
 *   ../lib/alertlint/engine →
 *     runTests(rulesYaml: string, testYaml: string) => RunResult
 *       RunResult = {
 *         ok: boolean
 *         error?: string
 *         summary: { total, passed, failed, durationMs }
 *         results: Array<{
 *           name: string
 *           evalTime?: string
 *           status: 'pass' | 'fail'
 *           kind?: string
 *           message?: string
 *           diff?: { expected?: string; actual?: string }
 *         }>
 *       }
 *     encodeState(rulesYaml: string, testYaml: string) => string  // hash fragment
 *     decodeState() => { rules: string; test: string } | null
 *   ../lib/alertlint/examples →
 *     examples: Array<{ name|label|title; rules|rulesYaml; test|testYaml }>
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. The script never
// rebuilds them — it only reads each chip's `data-example-idx` into the lazily
// imported array — so this adds nothing to the client bundle and cannot drift.
import { examples as prerenderedExamples } from '../lib/alertlint/examples';
import { runTests } from '../lib/alertlint/engine';
import { resultsHtml, countsText, EMPTY_HTML } from '../lib/alertlint/render';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-runs the same example on boot, so this
 * is the same markup it would paint — but it is already in the static HTML,
 * which is all an AI crawler (no JS) ever sees.
 *
 * `runTests()` is deterministic except for `summary.durationMs`, a wall-clock
 * reading. `countsText` deliberately omits it and the client alone appends
 * `formatDuration`, so the built page carries no timing and is reproducible.
 *
 * The two YAML documents go into `<pre data-cm-fallback>` elements inside the
 * CodeMirror hosts; CM appends its editor to the host, so `init` removes them
 * once mounted.
 */
const seedExample = prerenderedExamples[0];
const seedResult = seedExample ? runTests(seedExample.rulesYaml, seedExample.testYaml) : null;
const seedOk = seedResult && seedResult.ok !== false && !seedResult.error ? seedResult : null;
const seedHtml = seedOk ? resultsHtml(seedOk) : EMPTY_HTML;
const seedSummary = seedOk && seedOk.summary ? countsText(seedOk.summary) : '';
const seedFailed = Boolean(seedOk && seedOk.summary && seedOk.summary.failed > 0);
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="playground al-pg" aria-label="AlertLint playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: example chips + Run now (paper) ─────────────────────── */}
    <div
      class="flex flex-col gap-3 border-b border-hairline px-4 py-3 sm:flex-row sm:items-end sm:justify-between sm:px-5"
    >
      <div class="flex min-w-0 flex-col gap-2">
        <span class="eyebrow shrink-0">Example</span>
        <ExampleChips prefix="al" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
      </div>
      <button
        id="al-run"
        type="button"
        class="btn-tool al-tap self-start sm:self-auto"
        title="Run now (⌘/Ctrl + Enter)"
        aria-keyshortcuts="Meta+Enter Control+Enter"
      >
        <svg
          class="al-run-icon h-4 w-4 shrink-0"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 3.5l7 4.5-7 4.5z" fill="currentColor" stroke="none"></path>
        </svg>
        <span class="al-run-label">Run now</span>
      </button>
    </div>

    {/* ── Mobile tab switch (single-pane on small screens) ─────────────── */}
    <div class="al-tabs flex gap-1 border-b border-hairline px-4 py-2 sm:hidden" role="tablist" aria-label="Editor panes">
      <button
        id="al-tab-rules"
        type="button"
        class="al-tab al-tap"
        role="tab"
        aria-selected="true"
        aria-controls="al-pane-rules"
        data-pane="rules"
        tabindex="0"
      >
        Rules
      </button>
      <button
        id="al-tab-test"
        type="button"
        class="al-tab al-tap"
        role="tab"
        aria-selected="false"
        aria-controls="al-pane-test"
        data-pane="test"
        tabindex="-1"
      >
        Test
      </button>
    </div>

    {/* ── Editor split on the plate (side by side on desktop, tabbed on
        mobile) ── */}
    <div class="al-grid grid grid-cols-1 sm:grid-cols-2">
      <div id="al-pane-rules" class="al-pane al-pane--active" role="tabpanel" aria-labelledby="al-tab-rules">
        <EditorPane prefix="al" id="al-editor-rules" label="rules.yaml">
          <pre class="editor-pane__fallback code-mono al-fallback" data-cm-fallback>{seedExample?.rulesYaml}</pre>
        </EditorPane>
      </div>
      <div id="al-pane-test" class="al-pane" role="tabpanel" aria-labelledby="al-tab-test">
        <EditorPane prefix="al" id="al-editor-test" label="test.yaml">
          <pre class="editor-pane__fallback code-mono al-fallback" data-cm-fallback>{seedExample?.testYaml}</pre>
        </EditorPane>
      </div>
    </div>

    {/* ── Run hint + snapshots, on paper (never inside the slab) ──────── */}
    <div class="border-b border-hairline px-4 py-3 sm:px-5">
      <RunHint variant="cm" />
      <SnapshotBar prefix="al" />
    </div>

    {/* ── Results — the L2 instrument under its figure cap ─────────────── */}
    <ResultPanel
      slug="loki-alert-rule-tester"
      prefix="al"
      label="Results"
      summary={seedSummary}
      summaryClass={seedFailed ? 'whitespace-nowrap text-inverse-error' : 'whitespace-nowrap'}
      split
    >
      <Fragment slot="actions">
        <CopyButton kind="link" id="al-share" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the pass/fail rows are
          in the static HTML; the script repaints this same node on every run. */}
      <div id="al-results" class="al-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* Tap targets opt into fast-tap + no double-tap-zoom on touch. */
  .al-tap {
    touch-action: manipulation;
  }

  /* The seeded documents a crawler reads (global .editor-pane__fallback sets
     the metrics), boxed to the editors' own min/max height (the script's
     size theme) so the swap on hydration does not move the page. */
  .al-fallback {
    min-height: 288px;
    max-height: 300px;
    overflow: auto;
  }

  /* The divider between the two plates on desktop. */
  @media (min-width: 640px) {
    .al-pane + .al-pane {
      border-left: 1px solid var(--color-inverse-hairline);
    }
  }

  /* Mobile tabs (square in-app scale). The selected state IS aria-selected. */
  .al-tab {
    @apply label-field;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 0;
    min-height: var(--control-h-lg);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      color var(--dur-fast) var(--ease-brand);
  }
  .al-tab:hover:not([aria-selected='true']) {
    color: var(--color-body);
    background: var(--color-canvas-soft-2);
  }
  .al-tab[aria-selected='true'] {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
    box-shadow: inset 0 0 0 1px var(--color-brand);
  }
  .al-tab:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }

  /* Visibility is driven by the .al-pane--active class, NOT the [hidden]
     attribute. Tailwind v4's layered `[hidden]{display:none!important}` (in
     @layer base) beats any unlayered !important override, which previously left
     the test pane invisible on desktop. */
  @media (max-width: 639px) {
    .al-pane {
      display: none;
    }
    .al-pane.al-pane--active {
      display: block;
    }
  }

  /* The summary is ResultPanel's span (no scope attribute here). A seeded
     failure tone must beat the panel's own text-inverse-mute utility. */
  .al-pg :global(.result-panel__summary.text-inverse-error) {
    color: var(--color-inverse-error);
  }

  /* ── Results rows (runtime-injected → :global). Light rules first as the
     documented defaults; the slab re-skin follows, anchored on this
     component's own `.al-results` container. ─────────────────────────── */
  .al-results {
    min-height: var(--control-h-lg);
  }
  :global(.al-row) {
    display: flex;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    animation: al-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.al-row + .al-row) {
    margin-top: 8px;
  }
  @keyframes al-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.al-row),
    :global(.al-error) {
      animation: none;
    }
  }
  :global(.al-row__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.al-row--pass .al-row__icon) {
    color: var(--color-success);
  }
  :global(.al-row--fail) {
    box-shadow: inset 0 0 0 1px var(--color-error-soft);
  }
  :global(.al-row--fail .al-row__icon) {
    color: var(--color-error);
  }
  :global(.al-row__body) {
    min-width: 0;
    flex: 1 1 auto;
  }
  :global(.al-row__name) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-word;
  }
  :global(.al-row__meta) {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    color: var(--color-mute);
  }
  :global(.al-row__msg) {
    margin-top: 4px;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    word-break: break-word;
  }

  /* Expected / actual diff block. */
  :global(.al-diff) {
    margin-top: 8px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-hairline);
  }
  :global(.al-diff__row) {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 8px;
    padding: 6px 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
  }
  :global(.al-diff__row + .al-diff__row) {
    border-top: 1px solid var(--color-hairline);
  }
  /* Row-key role (label-field): mono 11/16 uppercase, the only label. */
  :global(.al-diff__label) {
    @apply label-field;
    line-height: 18px;
  }
  :global(.al-diff__val) {
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--color-ink);
  }
  :global(.al-diff__row--exp) {
    background: var(--color-canvas-soft-2);
  }
  :global(.al-diff__row--act) {
    background: var(--color-error-soft);
  }
  :global(.al-diff__row--act .al-diff__val) {
    color: var(--color-error-deep);
  }

  /* Parse-error banner. */
  :global(.al-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
    animation: al-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.al-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.al-error__body) {
    min-width: 0;
  }
  :global(.al-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.al-error__detail) {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* Empty state — generous, centered frame. */
  :global(.al-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* Loading dots — animate opacity only. */
  :global(.al-loading) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-body);
  }
  :global(.al-loading__dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-mute);
    animation: al-pulse calc(var(--dur-base) * 6) ease-in-out infinite;
  }
  :global(.al-loading__dot:nth-child(2)) {
    animation-delay: var(--dur-base);
  }
  :global(.al-loading__dot:nth-child(3)) {
    animation-delay: calc(var(--dur-base) * 2);
  }
  @keyframes al-pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.al-loading__dot) {
      animation: none;
      opacity: 0.6;
    }
  }

  .is-busy {
    opacity: 0.65;
    pointer-events: none;
    cursor: progress;
  }
  .is-busy .al-run-icon {
    display: none;
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below uses the slab ink tier. ─────────────────── */
  .al-results :global(.al-empty) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .al-results :global(.al-loading) {
    color: var(--color-inverse-mute);
  }
  .al-results :global(.al-loading__dot) {
    background: var(--color-inverse-mute);
  }
  .al-results :global(.al-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .al-results :global(.al-row) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .al-results :global(.al-row--fail) {
    box-shadow: inset 0 0 0 1px #ff9d9559;
  }
  .al-results :global(.al-row--pass .al-row__icon) {
    color: var(--color-inverse-brand);
  }
  .al-results :global(.al-row--fail .al-row__icon) {
    color: var(--color-inverse-error);
  }
  .al-results :global(.al-row__name),
  .al-results :global(.al-diff__val) {
    color: var(--color-inverse-fg);
  }
  .al-results :global(.al-row__meta),
  .al-results :global(.al-row__msg),
  .al-results :global(.al-diff__label) {
    color: var(--color-inverse-mute);
  }
  .al-results :global(.al-diff) {
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .al-results :global(.al-diff__row + .al-diff__row) {
    border-top-color: var(--color-inverse-hairline);
  }
  .al-results :global(.al-diff__row--exp) {
    background: #ffffff0a;
  }
  .al-results :global(.al-diff__row--act) {
    background: #ff9d9514;
  }
  .al-results :global(.al-diff__row--act .al-diff__val) {
    color: var(--color-inverse-error);
  }
</style>

<script>
  import type { EditorView } from '@codemirror/view';
  import type { RunResult } from '../lib/alertlint/types';
  import { LOADING_HTML, countsText, errorHtml, formatDuration, resultsHtml } from '../lib/alertlint/render';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';

  // CodeMirror (and the kit's plate theme, which imports @codemirror/view) is
  // loaded via dynamic import inside init() so its runtime code-splits into
  // its own chunk instead of shipping in the page's initial JS. The
  // `EditorView` type above is erased at build time and ships no runtime code.

  /* ---- Engine contract ------------------------------------------------------
     Imported, never hand-mirrored: a copied shape drifts silently when the
     engine gains a field the render code reads (`import type` is erased at
     build time, so it does not affect code-splitting). */

  type EngineModule = {
    runTests: (rulesYaml: string, testYaml: string) => RunResult | Promise<RunResult>;
    encodeState: (rulesYaml: string, testYaml: string) => string;
    decodeState: () => { rules: string; test: string } | null;
  };
  type ExampleRaw = Record<string, unknown>;
  type Example = { name: string; rules: string; test: string };

  const ROOT_SEL = '.al-pg';
  const SLUG = 'loki-alert-rule-tester';

  /** Boot every (so far un-hydrated) playground instance on the page. */
  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.alWired === 'true') return;
      root.dataset.alWired = 'true';
      void init(root);
    });
  }

  /* ---- Small helpers -------------------------------------------------------- */

  function pick(obj: ExampleRaw, keys: string[]): string {
    for (const k of keys) {
      const v = obj[k];
      if (typeof v === 'string' && v.length > 0) return v;
    }
    return '';
  }

  /** Normalise the sibling `examples` array against likely field names. */
  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw.map((item, i) => {
      const o = (item ?? {}) as ExampleRaw;
      return {
        name: pick(o, ['name', 'label', 'title', 'id']) || `Example ${i + 1}`,
        rules: pick(o, ['rules', 'rulesYaml', 'rulesDoc', 'ruleYaml']),
        test: pick(o, ['test', 'testYaml', 'testDoc', 'tests']),
      };
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  /* ---- Result rendering --------------------------------------------------
     The pure HTML builders live in `../lib/alertlint/render`, imported above and
     ALSO used by this component's frontmatter, so the server-rendered seed and
     every client repaint are produced by one implementation. Only the DOM
     writes stay here. */

  /** Summary ink on the slab: inverse tier only (never paper text-mute). */
  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderLoading(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = LOADING_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    setSummary(summary, 'Error', true);
    container.innerHTML = errorHtml(message);
  }

  function renderResults(container: HTMLElement, summary: HTMLElement, result: RunResult): void {
    if (!result || result.ok === false || result.error) {
      renderError(container, summary, result?.error ?? 'Unknown error while running tests.');
      return;
    }
    const s = result.summary ?? { total: 0, passed: 0, failed: 0, durationMs: 0 };
    // The counts come from the shared builder; the wall-clock duration is
    // appended only here, so the server-rendered seed carries no timing.
    const dur = formatDuration(s.durationMs);
    setSummary(summary, countsText(s) + (dur ? ` · ${dur}` : ''), s.failed > 0);
    container.innerHTML = resultsHtml(result);
  }

  /* ---- Instance init -------------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const rulesHost = el<HTMLElement>(root, '#al-editor-rules');
    const testHost = el<HTMLElement>(root, '#al-editor-test');
    const chipsWrap = el<HTMLElement>(root, '#al-chips');
    const runBtn = el<HTMLButtonElement>(root, '#al-run');
    const shareBtn = el<HTMLButtonElement>(root, '#al-share');
    const resultsBox = el<HTMLElement>(root, '#al-results');
    const summaryEl = el<HTMLElement>(root, '#al-summary');
    const copyStatus = el<HTMLElement>(root, '#al-copy-status');
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.al-tab'));
    const snapSaveBtn = el<HTMLButtonElement>(root, '#al-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#al-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#al-snap-delete');

    if (
      !rulesHost ||
      !testHost ||
      !chipsWrap ||
      !runBtn ||
      !shareBtn ||
      !resultsBox ||
      !summaryEl ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    // Copy link: the kit's one delegated listener; outcomes are announced in
    // ResultPanel's #al-copy-status.
    wireCopyButtons(root, { status: copyStatus });
    shareBtn.title = 'This link encodes your alert rules — review before sharing.';

    // Lazily load CodeMirror + the plate theme + the engine + examples (kept
    // out of the initial path so the CM runtime code-splits into its own chunk).
    let engine: EngineModule;
    let examples: Example[] = [];
    let makeEditor: (host: HTMLElement, doc: string, label: string) => EditorView;
    let setEditorDoc: (view: EditorView, doc: string) => void;
    try {
      const [
        { EditorState },
        { EditorView, keymap, lineNumbers, highlightActiveLine },
        { defaultKeymap, history: cmHistory, historyKeymap, indentWithTab },
        { yaml },
        { plate },
        engineMod,
        examplesMod,
      ] = await Promise.all([
        import('@codemirror/state'),
        import('@codemirror/view'),
        import('@codemirror/commands'),
        import('@codemirror/lang-yaml'),
        import('../lib/playground-kit/cm-theme'),
        import('../lib/alertlint/engine'),
        import('../lib/alertlint/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);

      // Size only (the plate theme owns colour; global.css owns the focus
      // ring): 13px like the seeded fallback, scrolling inside 288–300px.
      const sizeTheme = EditorView.theme({
        '&': { fontSize: '13px', maxHeight: '300px' },
        '.cm-scroller': { overflow: 'auto' },
        '.cm-content, .cm-gutter': { minHeight: '288px' },
      });

      // Editor factory + doc-setter as closures over the freshly imported CM
      // symbols (so no runtime CM reference lives at module top level).
      makeEditor = (host: HTMLElement, doc: string, label: string): EditorView => {
        const state = EditorState.create({
          doc,
          extensions: [
            lineNumbers(),
            cmHistory(),
            highlightActiveLine(),
            yaml(),
            plate,
            sizeTheme,
            EditorView.lineWrapping,
            EditorView.contentAttributes.of({ 'aria-label': label }),
            keymap.of([
              // ⌘/Ctrl+Enter runs now — placed BEFORE defaultKeymap, whose
              // Mod-Enter would otherwise insert a blank line.
              {
                key: 'Mod-Enter',
                run: (v) => {
                  forceRun();
                  if (window.matchMedia?.('(pointer: coarse)').matches) v.contentDOM.blur();
                  return true;
                },
              },
              ...defaultKeymap,
              ...historyKeymap,
              indentWithTab,
              {
                key: 'Escape',
                run: (v) => {
                  v.contentDOM.blur();
                  return true;
                },
              },
            ]),
            // Live eval: re-run the tests once the documents settle, so the
            // panel never describes rules that are no longer in the editors.
            EditorView.updateListener.of((u) => {
              if (u.docChanged) scheduleLive();
            }),
          ],
        });
        return new EditorView({ state, parent: host });
      };

      setEditorDoc = (view: EditorView, doc: string): void => {
        view.dispatch({
          changes: { from: 0, to: view.state.doc.length, insert: doc },
        });
      };
    } catch (err) {
      renderError(resultsBox, summaryEl, 'The AlertLint engine failed to load. Reload the page to try again.');
      // Surface the underlying reason in dev tooling without breaking the UI.
      // eslint-disable-next-line no-console
      console.error('[AlertLint] engine/examples import failed:', err);
      return;
    }

    // Seed content: prefer a shared-state URL, else a restored last input,
    // else the first example.
    const seedExample = examples[0] ?? { name: 'Example', rules: '', test: '' };
    let seedRules = seedExample.rules;
    let seedTest = seedExample.test;
    let fromShare = false;
    try {
      const decoded = engine.decodeState();
      if (decoded && (decoded.rules || decoded.test)) {
        seedRules = decoded.rules ?? '';
        seedTest = decoded.test ?? '';
        fromShare = true;
      }
    } catch {
      /* malformed hash — fall back to the example seed */
    }

    // Restored last-input tier — only consulted when there's no shared-state
    // URL. Defensive JSON parse: bails silently on anything malformed.
    let fromRestored = false;
    if (!fromShare) {
      const raw = getRestoredLastInput(SLUG);
      if (raw) {
        try {
          const parsed = JSON.parse(raw) as Partial<{ rules: string; test: string }>;
          if (typeof parsed.rules === 'string' && typeof parsed.test === 'string' && (parsed.rules || parsed.test)) {
            seedRules = parsed.rules;
            seedTest = parsed.test;
            fromRestored = true;
          }
        } catch {
          /* malformed stored value — ignore, fall back to the example seed */
        }
      }
    }

    /* ---- Live evaluation ---------------------------------------------------
     * ~220ms after either document settles the tests re-run quietly (no
     * spinner, no loading flash, no hash write). Calm errors: a live run that
     * fails to parse holds the previous panel and reveals the error only after
     * ~600ms of idle in total. `liveReady` keeps the seed and example
     * dispatches from firing it.                                            */
    const LIVE_DEBOUNCE_MS = 220;
    const ERROR_HOLD_MS = 380;
    let liveReady = false;
    let liveTimer: number | undefined;
    let errorHoldTimer: number | undefined;

    function scheduleLive(): void {
      if (!liveReady) return;
      window.clearTimeout(liveTimer);
      window.clearTimeout(errorHoldTimer);
      liveTimer = window.setTimeout(() => void run({ live: true }), LIVE_DEBOUNCE_MS);
    }

    /** Deliberate run (Run now, ⌘/Ctrl+Enter, a chip): cancel the debounce, go now. */
    function forceRun(): void {
      window.clearTimeout(liveTimer);
      window.clearTimeout(errorHoldTimer);
      void run();
    }

    const rulesView = makeEditor(rulesHost, seedRules, 'Loki alert rules (YAML)');
    const testView = makeEditor(testHost, seedTest, 'Test cases (YAML)');
    // The build-time text stand-ins have done their job (no-JS visitors and
    // crawlers); CodeMirror appended its editors beside them, so drop them.
    // The share/restore tiers above already chose the documents.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());

    // The example chips are server-rendered from the same `examples` module,
    // so a chip's data-example-idx indexes straight into the array above.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));

    // A shared snippet or a restored input matches no example — leave every
    // chip unpressed rather than implying one of them is loaded.
    syncChipsByIndex(chipsWrap, fromShare || fromRestored || examples.length === 0 ? null : 0);

    // Swap both editors when a different example is chosen, then run it.
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        const ex = examples[idx];
        setEditorDoc(rulesView, ex.rules);
        setEditorDoc(testView, ex.test);
        syncChipsByIndex(chipsWrap, idx);
        forceRun();
      });
    });

    // Mobile tab switching (panes are always visible on desktop via CSS).
    const rulesPane = el<HTMLElement>(root, '#al-pane-rules');
    const testPane = el<HTMLElement>(root, '#al-pane-test');

    /** Activate a tab: update aria-selected, roving tabindex, pane visibility. */
    const activateTab = (tab: HTMLButtonElement, focusTab: boolean): void => {
      const showRules = tab.dataset.pane === 'rules';
      tabs.forEach((t) => {
        const active = t === tab;
        t.setAttribute('aria-selected', active ? 'true' : 'false');
        // Roving tabindex: only the selected tab is in the tab order.
        t.tabIndex = active ? 0 : -1;
      });
      rulesPane?.classList.toggle('al-pane--active', showRules);
      testPane?.classList.toggle('al-pane--active', !showRules);
      if (focusTab) tab.focus();
      // Refresh CM measurement once the pane is visible (next frame, post-layout).
      requestAnimationFrame(() => (showRules ? rulesView : testView).requestMeasure());
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activateTab(tab, false));
      // Roving focus with Left/Right/Home/End per the tablist a11y pattern.
      tab.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        activateTab(tabs[next], true);
      });
    });

    /** Copy link appears once the tests ran, carrying both documents. */
    function setShare(rulesDoc: string | null, testDoc = ''): void {
      if (!shareBtn) return;
      let url = '';
      if (rulesDoc !== null) {
        try {
          const hash = engine.encodeState(rulesDoc, testDoc);
          if (typeof hash === 'string') url = `${window.location.href.split('#')[0]}${hash.startsWith('#') ? hash : `#${hash}`}`;
        } catch {
          url = '';
        }
      }
      shareBtn.hidden = url === '';
      shareBtn.dataset.copy = url;
    }

    // Run — non-blocking. A deliberate run shows the loading state and a
    // spinner in Run now; a live (debounced) or seed run is quiet. Only a
    // deliberate run rewrites the address bar; only the seed skips the
    // last-input record (it is not something the visitor typed).
    type RunOpts = { live?: boolean; showErrors?: boolean; seed?: boolean };
    let running = false;
    let rerun: RunOpts | null = null;
    const runLabel = runBtn.querySelector<HTMLElement>('.al-run-label');
    let spinner: HTMLElement | null = null;
    async function run(opts: RunOpts = {}): Promise<void> {
      // Guaranteed present by the early return in init(); restated because TypeScript
      // discards that narrowing inside a hoisted function declaration.
      if (!runBtn) return;
      const live = opts.live === true;
      const seeded = opts.seed === true;
      const quiet = live || seeded;
      if (running) {
        rerun = opts;
        return;
      }
      running = true;
      if (!quiet) {
        runBtn.classList.add('is-busy');
        // Mark busy (not disabled, so focus stays put for keyboard users) and
        // swap the play glyph for a spinner.
        runBtn.setAttribute('aria-disabled', 'true');
        runBtn.setAttribute('aria-busy', 'true');
        if (!spinner) {
          spinner = document.createElement('span');
          spinner.setAttribute('aria-hidden', 'true');
          // Inline the visual so it never depends on Astro's scoped CSS — this span
          // is created at runtime and would not receive the component's scope hash.
          spinner.style.cssText =
            'display:inline-block;width:14px;height:14px;flex:0 0 auto;border-radius:50%;' +
            'border:2px solid currentColor;border-top-color:transparent;';
          if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            spinner.animate([{ transform: 'rotate(0deg)' }, { transform: 'rotate(360deg)' }], {
              duration: 700,
              iterations: Infinity,
            });
          }
          runBtn.insertBefore(spinner, runBtn.firstChild);
        }
        if (runLabel) runLabel.textContent = 'Running…';
        renderLoading(resultsBox!, summaryEl!);

        // Yield so the loading state paints before (potentially heavy) work runs.
        await new Promise<void>((resolve) => {
          if ('requestAnimationFrame' in window) {
            requestAnimationFrame(() => resolve());
          } else {
            setTimeout(resolve, 0);
          }
        });
      }

      try {
        const rulesDoc = rulesView.state.doc.toString();
        const testDoc = testView.state.doc.toString();
        const result = await Promise.resolve(engine.runTests(rulesDoc, testDoc));
        if (!seeded) recordToolLastInput(SLUG, JSON.stringify({ rules: rulesDoc, test: testDoc }));
        const failed = !result || result.ok === false || Boolean(result.error);
        if (live && failed && opts.showErrors !== true) {
          // Hold the last good panel; reveal the error only after a longer idle.
          window.clearTimeout(errorHoldTimer);
          errorHoldTimer = window.setTimeout(() => void run({ live: true, showErrors: true }), ERROR_HOLD_MS);
        } else {
          renderResults(resultsBox!, summaryEl!, result);
          if (failed) setShare(null);
          else setShare(rulesDoc, testDoc);
          // Persist current state into the URL hash without a history entry —
          // a deliberate run only (Safari rate-limits replaceState).
          if (!quiet && !failed) {
            try {
              const hash = engine.encodeState(rulesDoc, testDoc);
              if (typeof hash === 'string') window.history.replaceState(null, '', hash.startsWith('#') ? hash : `#${hash}`);
            } catch {
              /* non-fatal: sharing just won't update */
            }
          }
        }
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Unexpected error while running tests.';
        renderError(resultsBox!, summaryEl!, msg);
        setShare(null);
      } finally {
        running = false;
        runBtn.classList.remove('is-busy');
        runBtn.removeAttribute('aria-disabled');
        runBtn.removeAttribute('aria-busy');
        if (spinner) {
          spinner.remove();
          spinner = null;
        }
        if (runLabel) runLabel.textContent = 'Run now';
        if (rerun) {
          const next = rerun;
          rerun = null;
          void run(next);
        }
      }
    }

    runBtn.addEventListener('click', () => forceRun());

    // ⌘/Ctrl+Enter anywhere else in the playground (a chip, a tab, Run now);
    // inside an editor the Mod-Enter binding has already handled it.
    root.addEventListener('keydown', (e) => {
      if (e.defaultPrevented) return;
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        forceRun();
      }
    });

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => JSON.stringify({ rules: rulesView.state.doc.toString(), test: testView.state.doc.toString() }),
      setValue: (value) => {
        let parsed: Partial<{ rules: string; test: string }> | null = null;
        try {
          parsed = JSON.parse(value) as Partial<{ rules: string; test: string }>;
        } catch {
          return;
        }
        if (!parsed || typeof parsed.rules !== 'string' || typeof parsed.test !== 'string') {
          return;
        }
        syncChipsByIndex(chipsWrap, null);
        setEditorDoc(rulesView, parsed.rules);
        setEditorDoc(testView, parsed.test);
        forceRun();
      },
    });

    // Run once on load over whatever the editors hold (the seed, a deep link
    // or a restored input) so the client state matches the panel. The seed
    // run never rewrites the URL hash or records a last input.
    void run({ seed: true });
    // Only now may keystrokes drive the panel (seed dispatches must not).
    liveReady = true;
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
