---
/**
 * ToolCard — the single source of truth for a tool's catalog card.
 *
 * Used by BOTH /tools (the filterable catalog) and /tools/{category} (the
 * static category landing pages) so the card markup never drifts between them.
 *
 * Renders the `<li>` wrapper itself, carrying the data-* hooks the catalog's
 * inline filter/sort script reads:
 *   - data-name      → lowercased tool name (search match)
 *   - data-category  → lowercased category  (chip filter)
 *   - data-order     → registry index       ("Default" + "Newest" sort)
 *   - data-added     → git-derived last-updated date (YYYY-MM-DD) if
 *                       available, else "" — the real-date upgrade to the
 *                       "Newest" sort's registry-order proxy (ToolsCatalog.astro)
 *   - data-tagline   → lowercased tagline   (extended search match)
 *   - data-desc      → lowercased description (extended search match)
 *   - data-keywords  → lowercased keywords joined by space (extended search match)
 *
 * Color MEANS category: the category dot uses categoryAccentVar(category).
 * Batch D (2026-10) trimmed the card to what a reader scans: the `LIVE` badge
 * (every card on the catalog is live) and the two "Try:" keyword chips went;
 * the mono amber `fig. NN` — the tool's position in the `tools` registry, the
 * same number its result panel's FigureCap carries — sits where LIVE was, so
 * the catalog and the instrument agree on the figure. The art strip is 96px
 * (was the 2:1 tile), the description clamps at three lines, and the "Open
 * tool" row is a `.link-cta` (underline + arrow, lifts on card hover).
 */
import Card from './Card.astro';
import ToolArt from './ToolArt.astro';
import { tools, categoryAccentVar, type Tool } from '../data/tools';
import { getToolUpdatedAt } from '../data/tool-meta';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { useTranslations, localizeKey } from '../i18n/utils';

export interface Props {
  tool: Tool;
  /** Stable registry index — drives the Default/Newest sort on the catalog. */
  order: number;
}

const { tool, order } = Astro.props;
const accent = categoryAccentVar(tool.category);
// Rendered on both the English and localized /tools catalogs, so the card's
// own microcopy ("Open tool") and its link must localize — tool name/tagline/
// description stay English by design (no translated tool copy source exists yet).
const lang: Locale = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE;
const t = useTranslations(lang);
const href = localizeKey(`/${tool.slug}`, lang);
// Git-derived (scripts/gen-tool-meta.mjs), falling back to the registry's
// hand-set addedAt (rarely populated — see data/tools.ts) if not generated.
const updatedAt = getToolUpdatedAt(tool.slug) ?? tool.addedAt;
// Figure number = registry position (append order, so it never shifts) —
// the same derivation as ResultPanel's cap, so the two can never disagree.
const registryIndex = tools.findIndex((x) => x.slug === tool.slug);
if (registryIndex < 0) throw new Error(`[ToolCard] "${tool.slug}" is not in the tools registry`);
const figNo = String(registryIndex + 1).padStart(2, '0');
---

<li
  class="h-full tool-card"
  data-name={tool.name.toLowerCase()}
  data-category={tool.category.toLowerCase()}
  data-order={order}
  data-added={updatedAt ?? ''}
  data-tagline={tool.tagline.toLowerCase()}
  data-desc={tool.description.toLowerCase()}
  data-keywords={tool.keywords.join(' ').toLowerCase()}
>
  <Card class="card-interactive group relative flex h-full flex-col overflow-hidden rounded-lg p-0 shadow-soft focus-within:shadow-float focus-within:ring-2 focus-within:ring-link focus-within:ring-offset-2">
    <ToolArt slug={tool.slug} accent={accent} class="tool-card__art border-b border-hairline" />
    <div class="flex h-full flex-col p-5">
      <div class="flex items-center justify-between gap-3">
        <span class="inline-flex min-w-0 items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-body">
          <span class="size-1.5 shrink-0 rounded-full" style={`background-color: ${accent}`} aria-hidden="true"></span>
          <span>{tool.category}</span>
        </span>
        <span class="code-mono shrink-0 text-[11px] text-accent-ink">fig. {figNo}</span>
      </div>

      <h3 class="display-sm mt-4 text-balance text-ink">
        <a
          href={href}
          class="rounded-sm outline-none after:absolute after:inset-0 after:content-['']"
        >
          {tool.name}
        </a>
      </h3>
      <p class="body-md mt-1.5 font-medium text-pretty text-ink">{tool.tagline}</p>

      <p class="body-sm mt-3 line-clamp-3 text-pretty text-body">{tool.description}</p>

      <div class="mt-auto pt-5">
        <span class="link-cta body-sm">{t('tools.openTool')}</span>
      </div>
    </div>
  </Card>
</li>

<style>
  /* 96px art strip (batch D; was the 2:1 tile, ~185px in a 3-up grid). The
     explicit height wins over ToolArt's aspect-ratio; the tighter padding
     keeps the illustration legible in the shorter band. */
  .tool-card :global(.tool-card__art) {
    height: 96px;
    aspect-ratio: auto;
    padding: 10px 20px;
  }
</style>
