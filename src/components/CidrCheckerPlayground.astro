---
/**
 * CidrCheckerPlayground — the interactive CIDR / Subnet Checker island.
 *
 * Multi-line tool: paste an IP plus the CIDRs to check it against — or any
 * list of IPs/CIDRs. Bare IPs (no /prefix) get an in-range verdict against
 * every listed range; range entries are checked pairwise for overlap /
 * containment; and everything is aggregated into the minimal covering CIDR
 * set. Updates live (debounced), fully client-side, shareable via `#list=`.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar, ResultPanel (figure cap, live summary, copy status)
 * and CopyButton. The results container stays here, seeded with
 * `set:html` + `data-results`; its slab overrides anchor on `.cdc-results`.
 *
 * Runtime contract (lazy-imported):
 *   ../lib/cidr-checker/engine   → check(input: string): CheckResult
 *   ../lib/cidr-checker/examples → examples: { id; label; input }[]
 */
import { examples } from '../lib/cidr-checker/examples';
import { check } from '../lib/cidr-checker/engine';
import { resultHtml, summaryText, EMPTY_HTML } from '../lib/cidr-checker/render';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed — the same example the client seeds on boot, computed
 * at build time so the in-range verdict is in the static HTML for a no-JS
 * visitor and for AI crawlers (which never execute JS). `check` is pure and
 * synchronous. The chips are rendered here too, and the script adopts them
 * rather than rebuilding them.
 */
const seedExample = examples[0];
const seedResult = seedExample ? check(seedExample.input) : null;
const seedHtml = seedResult && seedResult.valid ? resultHtml(seedResult) : EMPTY_HTML;
const seedSummary = seedResult && seedResult.valid ? summaryText(seedResult) : '';
const chipItems = examples.map((ex) => ({ label: ex.label }));

---

<section class="cdc-pg" aria-label="CIDR / Subnet Checker playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    <div class="flex flex-col gap-1 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow shrink-0">Examples</span>
      <ExampleChips prefix="cdc" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
    </div>

    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <label class="eyebrow mb-2 block" for="cdc-input">IPs / CIDRs — one per line</label>
      <textarea
        id="cdc-input"
        class="cdc-input code-mono"
        spellcheck="false"
        autocapitalize="off"
        autocorrect="off"
        autocomplete="off"
        rows="6"
        placeholder="10.0.0.5&#10;10.0.0.0/24&#10;10.10.0.0/16"
        aria-describedby="cdc-input-hint">{seedExample?.input}</textarea>
      <p id="cdc-input-hint" class="cdc-hint caption text-mute">
        One IP or CIDR per line. A bare IP (no /prefix) is checked against every CIDR in the list.
        Blank lines and <span class="code-mono">#</span> comments are ignored.
      </p>
      <RunHint id="cdc-run-hint" />
      <SnapshotBar prefix="cdc" />
    </div>

    {/* ── Results panel — the L2 instrument under its figure cap; the live
        summary reads out in the cap's actions slot. ─────────────────── */}
    <ResultPanel slug="cidr-checker" prefix="cdc" summary={seedSummary} split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="cdc-share" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the verdict is in the
          static HTML; the client replaces it with the same markup on boot. */}
      <div id="cdc-results" class="cdc-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .cdc-input {
    width: 100%;
    min-height: 132px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 14px;
    line-height: 22px;
    resize: vertical;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .cdc-input::placeholder {
    color: var(--color-mute);
  }
  .cdc-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .cdc-input:focus {
    outline: none;
  }
  .cdc-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .cdc-hint {
    margin-top: 8px;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .cdc-hint .code-mono {
    font-size: 12px;
  }
  /* One control row high, so the empty state does not collapse the panel. */
  .cdc-results {
    min-height: var(--control-h-lg);
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.cdc-results` container. */
  :global(.cdc-block) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: cdc-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.cdc-block + .cdc-block) {
    margin-top: 12px;
  }
  /* Block heading ("IP in range?", "Overlaps & containment") — the
     group-heading role: sans 12/16 600 ink (global.css
     .result-panel__group-h), never one more mono caps label. */
  :global(.cdc-block__head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 14px 10px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    color: var(--color-ink);
  }
  :global(.cdc-block__actions) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  :global(.cdc-block__sub) {
    padding: 8px 14px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-mute);
    text-wrap: pretty;
  }
  :global(.cdc-line) {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-word;
  }
  :global(.cdc-line + .cdc-line) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.cdc-line__icon) {
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    margin-top: 3px;
  }
  :global(.cdc-line__icon--ok) {
    color: var(--color-success);
  }
  :global(.cdc-line__icon--bad) {
    color: var(--color-error);
  }
  /* Counts and diagnostics: mono metadata, also when it sits in a heading. */
  :global(.cdc-line__meta) {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    color: var(--color-mute);
    white-space: nowrap;
  }
  :global(.cdc-line--bad) {
    color: var(--color-error-deep);
  }
  /* Diagnostics are sentences — let them wrap instead of overflowing. */
  :global(.cdc-line--bad .cdc-line__meta) {
    white-space: normal;
    text-align: right;
    max-width: 60%;
  }
  :global(.cdc-rel) {
    padding: 8px 14px;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink);
  }
  :global(.cdc-rel + .cdc-rel) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.cdc-none) {
    padding: 10px 14px;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-mute);
  }

  /* ── Verdict card (IP in range?) ─────────────────────────────────────── */
  :global(.cdc-verdict__row) {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 14px;
  }
  :global(.cdc-verdict__row + .cdc-verdict__row) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.cdc-verdict__row--in) {
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
  }
  :global(.cdc-verdict__row--out) {
    background: var(--color-error-soft);
    color: var(--color-error-deep);
  }
  :global(.cdc-verdict__row--none) {
    background: var(--color-warning-soft);
    color: var(--color-warning-deep);
  }
  :global(.cdc-verdict__icon) {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    margin-top: 2px;
  }
  :global(.cdc-verdict__text) {
    min-width: 0;
  }
  :global(.cdc-verdict__main) {
    font-size: 14px;
    line-height: 20px;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  :global(.cdc-verdict__ip) {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
  }
  :global(.cdc-verdict__cidr) {
    font-family: var(--font-mono);
    font-size: 13px;
  }
  :global(.cdc-verdict__extra) {
    margin-top: 2px;
    font-size: 12px;
    line-height: 18px;
    opacity: 0.9;
    overflow-wrap: anywhere;
  }

  @keyframes cdc-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.cdc-block) {
      animation: none;
    }
  }

  :global(.cdc-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.cdc-error + .cdc-block) {
    margin-top: 12px;
  }
  :global(.cdc-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.cdc-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.cdc-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.cdc-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* ── Copy buttons in the result (render.ts; copy.ts drives them): the
     per-row icon button and the labelled per-block "Copy all". ───────── */
  :global(.cdc-copy) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    margin-left: auto;
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-brand),
      background var(--dur-fast) var(--ease-brand);
  }
  :global(.cdc-copy:hover) {
    color: var(--color-brand-strong);
    background: var(--color-hairline);
  }
  :global(.cdc-copy:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  /* Same recipe as the kit's .copy-btn--labeled: sentence case, sans. */
  :global(.cdc-copy--all) {
    width: auto;
    gap: 6px;
    padding: 0 10px;
    margin-left: 0;
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    white-space: nowrap;
  }
  :global(.cdc-copy[data-copied]) {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
  }
  @media (pointer: coarse) {
    :global(.cdc-copy) {
      width: var(--control-h-lg);
      height: var(--control-h-lg);
    }
    :global(.cdc-copy--all) {
      width: auto;
    }
  }

  /* Normalisation note: host bits stripped warning */
  :global(.cdc-norm-note) {
    font-size: 12px;
    color: var(--color-warning-deep);
    white-space: normal;
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below it uses the slab ink tier; the light rules
     above remain the documented defaults. ──────────────────────────────── */
  .cdc-results :global(.cdc-empty),
  .cdc-results :global(.cdc-block) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .cdc-results :global(.cdc-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .cdc-results :global(.cdc-block__head),
  .cdc-results :global(.cdc-block__sub),
  .cdc-results :global(.cdc-line + .cdc-line),
  .cdc-results :global(.cdc-rel + .cdc-rel),
  .cdc-results :global(.cdc-verdict__row + .cdc-verdict__row) {
    border-color: #ffffff12;
  }
  .cdc-results :global(.cdc-block__head) {
    color: var(--color-inverse-fg);
  }
  .cdc-results :global(.cdc-block__sub),
  .cdc-results :global(.cdc-line__meta),
  .cdc-results :global(.cdc-none) {
    color: var(--color-inverse-mute);
  }
  .cdc-results :global(.cdc-line),
  .cdc-results :global(.cdc-rel) {
    color: var(--color-inverse-fg);
  }
  .cdc-results :global(.cdc-line__icon--ok) {
    color: var(--color-inverse-brand);
  }
  .cdc-results :global(.cdc-line__icon--bad),
  .cdc-results :global(.cdc-line--bad) {
    color: var(--color-inverse-error);
  }
  .cdc-results :global(.cdc-norm-note) {
    color: var(--color-inverse-accent);
  }
  .cdc-results :global(.cdc-verdict__row--in) {
    background: #8fc97a1f;
    color: var(--color-inverse-brand);
  }
  .cdc-results :global(.cdc-verdict__row--out) {
    background: #ff9d9514;
    color: var(--color-inverse-error);
  }
  .cdc-results :global(.cdc-verdict__row--none) {
    background: #e0a45814;
    color: var(--color-inverse-accent);
  }
  .cdc-results :global(.cdc-copy) {
    color: var(--color-inverse-mute);
  }
  .cdc-results :global(.cdc-copy:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .cdc-results :global(.cdc-copy--all) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .cdc-results :global(.cdc-copy[data-copied]) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
</style>

<script>
  import {
    EMPTY_HTML,
    errorHtml,
    resultHtml,
    summaryText,
  } from '../lib/cidr-checker/render';
  import type { CheckResult, CheckEntry } from '../lib/cidr-checker/types';
  import { snapshotValues, markChanged } from '../lib/mark-changed';
  import { readIpHash, readListHash, buildListHash } from '../lib/ip-hash';
  import { wireRunKeys } from '../lib/run-keys';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';

  // Types come from the engine (erased at build, so no code-splitting cost) —
  // a hand-mirrored copy is how a shape drifts out of sync with its engine.
  type Entry = CheckEntry;
  type Result = CheckResult;
  type Example = { id: string; label: string; input: string };
  type EngineModule = { check: (input: string) => Result };

  const ROOT_SEL = '.cdc-pg';
  const DEBOUNCE_MS = 220;
  // Fragments beyond ~2000 chars stop being reliable URLs (browser / proxy /
  // chat-client limits), so past that we neither write the hash nor offer the
  // share link — the tool itself keeps working on lists of any size.
  const MAX_HASH_LEN = 2000;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.cdcWired === 'true') return;
      root.dataset.cdcWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          input: typeof o.input === 'string' ? o.input : '',
        } satisfies Example;
      })
      .filter((e) => e.input.length > 0);
  }

  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = EMPTY_HTML;
  }

  function renderError(
    container: HTMLElement,
    title: string,
    detail: string,
    entries: Entry[],
  ): void {
    container.innerHTML = errorHtml(title, detail, entries);
  }

  function renderResult(container: HTMLElement, summary: HTMLElement, result: Result): void {
    setSummary(summary, summaryText(result), false);
    container.innerHTML = resultHtml(result);
    // Newlines round-trip badly through HTML attributes — set the multi-line
    // Copy-all payload on the live element instead.
    container.querySelectorAll<HTMLButtonElement>('[data-copy-all]').forEach((btn) => {
      const group = (result.aggregated ?? []).find((g) => String(g.version) === btn.dataset.version);
      if (group) btn.dataset.copy = group.cidrs.join('\n');
    });
  }

  async function init(root: HTMLElement): Promise<void> {
    const input = el<HTMLTextAreaElement>(root, '#cdc-input');
    const chipsWrap = el<HTMLElement>(root, '#cdc-chips');
    const resultsBox = el<HTMLElement>(root, '#cdc-results');
    const summaryEl = el<HTMLElement>(root, '#cdc-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#cdc-share');
    const copyStatus = el<HTMLElement>(root, '#cdc-copy-status');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#cdc-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#cdc-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#cdc-snap-delete');
    if (
      !input ||
      !chipsWrap ||
      !resultsBox ||
      !summaryEl ||
      !shareBtn ||
      !copyStatus ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    )
      return;

    let engine: EngineModule;
    let examples: Example[] = [];
    try {
      const [engineMod, examplesMod] = await Promise.all([
        import('../lib/cidr-checker/engine'),
        import('../lib/cidr-checker/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
    } catch (err) {
      setSummary(summaryEl, '', false);
      renderError(
        resultsBox,
        'Checker unavailable',
        'The checker engine failed to load. Reload the page to try again.',
        [],
      );
      console.error('[CidrChecker] engine import failed:', err);
      return;
    }

    // The chips are server-rendered (see the frontmatter) so they exist without
    // JS; only build them here if the markup somehow lacks them.
    if (chipsWrap.querySelectorAll(CHIP_SELECTOR).length === 0) {
      examples.forEach((ex, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'chip';
        btn.dataset.exampleIdx = String(i);
        btn.setAttribute('aria-pressed', 'false');
        btn.textContent = ex.label;
        chipsWrap.appendChild(btn);
      });
    }

    function setActiveChip(idx: number | null): void {
      syncChipsByIndex(chipsWrap, idx);
    }

    /* ------------------------------------------------------------------ */
    /* Copy plumbing (row buttons, Copy all, Copy link) — the kit helper:  */
    /* one delegated listener; outcomes announced in #cdc-copy-status.     */
    /* ------------------------------------------------------------------ */

    wireCopyButtons(root, { status: copyStatus });

    /* ------------------------------------------------------------------ */
    /* Evaluation + share link / #list= deep-link plumbing                  */
    /* ------------------------------------------------------------------ */

    let lastWrittenHash: string | null = null;

    function writeHash(value: string | null): void {
      const target = value ? buildListHash(value) : '';
      if (target === lastWrittenHash) return;
      // Safari throttles replaceState (~100/30s) and throws — never let that break input.
      try {
        if (value) {
          history.replaceState(null, '', target);
        } else {
          history.replaceState(null, '', location.pathname + location.search);
        }
        lastWrittenHash = target;
      } catch {
        /* ignore */
      }
    }

    function hideShare(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
    }

    function evaluate(userInitiated: boolean): void {
      const value = input!.value;
      if (value.trim().length === 0) {
        hideShare();
        renderEmpty(resultsBox!, summaryEl!);
        if (userInitiated) writeHash(null);
        return;
      }
      let result: Result | null = null;
      try {
        result = engine.check(value);
      } catch {
        hideShare();
        setSummary(summaryEl!, '', false);
        renderError(resultsBox!, 'Checker unavailable', 'Unexpected error while checking the list.', []);
        if (userInitiated) writeHash(null);
        return;
      }
      if (!result || result.valid === false) {
        hideShare();
        const entries = result?.entries ?? [];
        // Zero parsed lines = nothing but blanks/comments; otherwise every line failed.
        const nothingToCheck = entries.length === 0;
        const invalid = result?.stats?.invalid ?? entries.filter((e) => !e.ok).length;
        setSummary(summaryEl!, `0 valid${invalid ? ` · ${invalid} invalid` : ''}`, true);
        renderError(
          resultsBox!,
          nothingToCheck ? 'Nothing to check yet' : 'No valid entries',
          result?.error ?? 'Enter one IP or CIDR per line, e.g. 10.0.0.0/24.',
          entries,
        );
        if (userInitiated) writeHash(null);
        return;
      }
      // Amber tick on the verdicts whose text changed — never on a seed.
      const prev = userInitiated ? snapshotValues(resultsBox!) : new Map<string, string>();
      renderResult(resultsBox!, summaryEl!, result);
      markChanged(resultsBox!, prev);
      const hash = buildListHash(value);
      if (hash.length > MAX_HASH_LEN) {
        // Too long to be a dependable link — skip the hash write, hide the share button.
        hideShare();
      } else {
        shareBtn!.hidden = false;
        shareBtn!.dataset.copy = location.origin + location.pathname + location.search + hash;
        if (userInitiated) writeHash(value);
        if (userInitiated) recordToolLastInput('cidr-checker', value);
      }
    }

    let timer: number | undefined;

    /* ------------------------------------------------------------------ */
    /* Events (chips delegated from the root; copy is wired above)          */
    /* ------------------------------------------------------------------ */

    root.addEventListener('click', (evt) => {
      const target = evt.target as HTMLElement;
      const chip = target.closest<HTMLButtonElement>(CHIP_SELECTOR);
      if (chip && chipsWrap!.contains(chip)) {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        input!.value = examples[idx].input;
        setActiveChip(idx);
        window.clearTimeout(timer);
        evaluate(true);
      }
    });

    input.addEventListener('input', () => {
      setActiveChip(null);
      window.clearTimeout(timer);
      timer = window.setTimeout(() => evaluate(true), DEBOUNCE_MS);
    });

    // ⌘/Ctrl+Enter runs now (and releases a touch keyboard); plain Enter
    // still inserts the newline, then flushes once the value includes it.
    wireRunKeys(
      input,
      () => {
        window.clearTimeout(timer);
        evaluate(true);
      },
      { enter: 'insert-then-run' },
    );

    wireSnapshotUI({
      slug: 'cidr-checker',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => input!.value,
      setValue: (value) => {
        input!.value = value;
        setActiveChip(null);
        window.clearTimeout(timer);
        evaluate(true);
      },
    });

    /* ------------------------------------------------------------------ */
    /* First load: typed value → #list= → #ip= (seeded) → restored last     */
    /* input → first example. None of these write the hash — only          */
    /* user-initiated evaluations do.                                       */
    /* ------------------------------------------------------------------ */

    const listShared = readListHash();
    const ipShared = readIpHash();
    const restored = getRestoredLastInput('cidr-checker');

    // Typed-before-hydration wins, but the textarea is server-seeded with
    // examples[0] — compare against `defaultValue` so the seed does not shadow
    // the #list= / #ip= deep links or the restored last input.
    const typed = input.value.trim();
    if (typed && typed !== input.defaultValue.trim()) {
      evaluate(false);
    } else if (listShared) {
      input.value = listShared;
      evaluate(false);
    } else if (ipShared) {
      // Deep link from the IP Address Converter — the '#' hint line is inert.
      input.value = ipShared + '\n# add the CIDR ranges to check this IP against';
      evaluate(false);
    } else if (restored) {
      input.value = restored;
      evaluate(false);
    } else if (examples[0]) {
      input.value = examples[0].input;
      setActiveChip(0);
      evaluate(false);
    } else {
      renderEmpty(resultsBox, summaryEl);
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
