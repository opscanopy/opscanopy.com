---
/**
 * JsonYamlConverterPlayground — the interactive JSON ↔ YAML Converter island.
 *
 * ONE CodeMirror editor (the input) plus a read-only, fully escaped output pane.
 * The editor's language rides a CM `Compartment` and follows the direction:
 * YAML highlighting for YAML → JSON, JSON highlighting for JSON → YAML. Three
 * controls sit above it — a direction radiogroup, an indent radiogroup, and a
 * "Sort keys" checkbox — and all three ride the `#s=` deep link and snapshots,
 * so a shared URL restores the exact conversion, not just the text.
 *
 * The differentiator, and the reason the results pane has two halves: the
 * converted document AND a report of everything the conversion cost. Comments,
 * anchors, merge keys, timestamps, multi-document streams and out-of-range
 * integers all vanish on the way through, and every one of them is named.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * EditorPane (the editor slab under its figure cap, whose label follows the
 * direction), RunHint, SnapshotBar, ResultPanel (the L2 instrument: figure
 * cap, the one live summary, copy status) and CopyButton. The results
 * container stays here, seeded with `set:html` + `data-results`; its slab
 * inks anchor on `.jy-results`.
 *
 * UX contract (CLAUDE.md): one ~180ms debounce, a ~600ms calm-error hold
 * before anything goes red, per-row copy + `data-copy-all` + `data-copy-link`,
 * a results container that is NOT `aria-live`, glossary captions instead of
 * tooltips, and `escapeHtml()` on every injected value.
 *
 * Runtime contract (lazy-imported inside the boot closure so the engine,
 * CodeMirror and the plate theme code-split away from the page shell):
 *   ../lib/json-yaml-converter/engine   → convert, detectFormat,
 *                                         encodeState, decodeState
 *   ../lib/json-yaml-converter/examples → examples: ConverterExample[]
 *   ../lib/playground-kit/cm-theme      → plate
 *
 * Only the example LABELS are read at build time (for server-rendered chips, so
 * they exist before hydration); the chip payloads come from the lazy import by
 * index, which keeps multi-line YAML out of HTML attributes entirely.
 */
import { examples } from '../lib/json-yaml-converter/examples';
import { convert } from '../lib/json-yaml-converter/engine';
import { resultHtml, summaryText, EMPTY_HTML } from '../lib/json-yaml-converter/render';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-converts the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees the real converted
 * document AND its loss report instead of an empty "paste JSON or YAML" panel.
 *
 * `convert` is pure and synchronous and reads no clock, so it runs at build
 * time unchanged. The seed uses the example's own direction and the control
 * defaults the script boots with (indent 2, sortKeys off), so the two agree.
 * The input body goes into a `<pre data-cm-fallback>` inside the CodeMirror
 * host; the OUTPUT is already a plain `<pre>` inside `resultHtml`, so it needs
 * no stand-in of its own. The `payloads` array is client-only — the copy text
 * is bound to `[data-payload]` after hydration, because multi-line text
 * round-trips badly through an HTML attribute.
 */
const seedExample = examples[0];
/** The direction the seeded chip runs in — also what the segmented control shows. */
const seedDirection = seedExample?.direction ?? 'yaml-to-json';
const seedResult = seedExample
  ? convert(seedExample.input, { direction: seedDirection, indent: 2, sortKeys: false })
  : null;
const seedOk = seedResult && seedResult.ok ? seedResult : null;
const seedText = seedExample?.input ?? '';
const seedHtml = seedOk ? resultHtml(seedOk).html : EMPTY_HTML;
const seedSummary = seedOk ? summaryText(seedOk) : '';
const chipItems = examples.map((ex) => ({ label: ex.label }));
---

<section class="jy-pg" aria-label="JSON ↔ YAML Converter playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Example chips ────────────────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow shrink-0">Examples</span>
      <ExampleChips prefix="jy" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
    </div>

    {/* ── Controls: direction, indent, sort ────────────────────────────── */}
    <div class="jy-controls border-b border-hairline px-4 py-4 sm:px-5">
      <div class="jy-control">
        <span class="eyebrow" id="jy-dir-label">Direction</span>
        <div class="jy-seg" role="radiogroup" aria-labelledby="jy-dir-label">
          <button
            id="jy-dir-y2j"
            type="button"
            role="radio"
            aria-checked={seedDirection === 'yaml-to-json' ? 'true' : 'false'}
            tabindex={seedDirection === 'yaml-to-json' ? 0 : -1}
            class="jy-seg__btn code-mono"
          >
            YAML → JSON
          </button>
          <button
            id="jy-dir-j2y"
            type="button"
            role="radio"
            aria-checked={seedDirection === 'json-to-yaml' ? 'true' : 'false'}
            tabindex={seedDirection === 'json-to-yaml' ? 0 : -1}
            class="jy-seg__btn code-mono"
          >
            JSON → YAML
          </button>
        </div>
        <p class="jy-gloss caption text-mute">
          Every JSON file is already valid YAML — YAML 1.2 is a superset of JSON. The reverse is
          not true, which is why the direction is yours to pick.
        </p>
        <button id="jy-switch" type="button" class="jy-switch" hidden></button>
      </div>

      <div class="jy-control">
        <span class="eyebrow" id="jy-indent-label">Indent</span>
        <div class="jy-seg" role="radiogroup" aria-labelledby="jy-indent-label">
          <button
            id="jy-indent-2"
            type="button"
            role="radio"
            aria-checked="true"
            tabindex="0"
            class="jy-seg__btn code-mono"
          >
            2 spaces
          </button>
          <button
            id="jy-indent-4"
            type="button"
            role="radio"
            aria-checked="false"
            tabindex="-1"
            class="jy-seg__btn code-mono"
          >
            4 spaces
          </button>
        </div>
      </div>

      <div class="jy-control">
        <span class="eyebrow" id="jy-keys-label">Keys</span>
        <label class="jy-check" for="jy-sort">
          <input type="checkbox" id="jy-sort" />
          <span>Sort keys</span>
        </label>
        <p class="jy-gloss caption text-mute">
          Off by default: the order you wrote is kept, except for integer-like keys.
        </p>
      </div>
    </div>

    {/* ── Input editor: the plate under its figure cap. The cap's label
        follows the direction (input.yaml / input.json). ─────────────────── */}
    <EditorPane prefix="jy" label={seedDirection === 'yaml-to-json' ? 'input.yaml' : 'input.json'} id="jy-input">
      <pre class="jy-fallback editor-pane__fallback code-mono" data-cm-fallback>{seedText}</pre>
    </EditorPane>

    {/* ── Hints + snapshots (on paper) ─────────────────────────────────── */}
    <div class="border-b border-hairline px-4 pt-3 pb-4 sm:px-5">
      <RunHint variant="cm" id="jy-run-hint" />
      <p class="jy-hint caption text-mute">
        An <strong class="font-medium text-body">anchor</strong> (<span class="code-mono">&amp;name</span>)
        marks a value so an <strong class="font-medium text-body">alias</strong>
        (<span class="code-mono">*name</span>) can reuse it. JSON has neither, so every alias is
        written out as a full copy.
      </p>
      <SnapshotBar prefix="jy" />
    </div>

    {/* ── Result — the L2 instrument; the live summary reads out in the
        figure cap's actions slot. ────────────────────────────────────── */}
    <ResultPanel slug="json-yaml-converter" prefix="jy" summary={seedSummary} split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="jy-share" />
        <CopyButton kind="all" id="jy-copy-all" label="Copy output" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the converted document
          and the loss report are in the static HTML; the client replaces them
          with the same markup on boot and binds the copy payloads. */}
      <div id="jy-results" class="jy-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* ── Control row: direction / indent / sort (paper) ──────────────────── */
  .jy-controls {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 720px) {
    .jy-controls {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: 20px;
      align-items: start;
    }
  }
  .jy-control {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 6px;
  }
  .jy-seg {
    display: inline-flex;
    align-self: flex-start;
    max-width: 100%;
    padding: 2px;
    border-radius: var(--radius-md);
    background: var(--color-canvas-soft-2);
    box-shadow: var(--shadow-hairline);
  }
  .jy-seg__btn {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--color-mute);
    font-size: 12px;
    line-height: 16px;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    white-space: nowrap;
    touch-action: manipulation;
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      color var(--dur-fast) var(--ease-brand);
  }
  .jy-seg__btn:hover {
    color: var(--color-body);
  }
  .jy-seg__btn[aria-checked='true'] {
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
  }
  .jy-seg__btn:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  .jy-check {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 8px;
    min-height: var(--control-h-sm);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-body);
    cursor: pointer;
  }
  .jy-check input {
    width: 16px;
    height: 16px;
    accent-color: var(--color-brand-strong);
    cursor: pointer;
  }
  .jy-gloss {
    margin: 0;
    font-size: 12px;
    line-height: 17px;
    text-wrap: pretty;
  }
  /* The "looks like YAML — switch?" nudge. Never auto-switches; one tap does. */
  .jy-switch {
    align-self: flex-start;
    padding: 5px 10px;
    border: none;
    border-radius: var(--radius-pill);
    background: var(--color-warning-soft);
    box-shadow: var(--shadow-hairline);
    color: var(--color-warning-deep);
    font-size: 12px;
    line-height: 16px;
    text-align: left;
    cursor: pointer;
    touch-action: manipulation;
  }
  .jy-switch:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  @media (pointer: coarse) {
    .jy-seg__btn,
    .jy-switch {
      min-height: var(--control-h-md);
    }
  }

  .jy-hint {
    margin-top: 4px;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .jy-hint .code-mono {
    font-size: 12px;
  }

  /* The build-time stand-in for the editor (global .editor-pane__fallback
     matches the CodeMirror metrics), held to the editor's scroller box and
     wrapped like its lineWrapping so the swap does not jump. */
  .jy-fallback {
    min-height: 240px;
    max-height: 440px;
    overflow: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  /* Invalid input: a hairline slab-red rule down the editor, never a flash.
     The pane root is EditorPane's (no scope hash), hence :global. */
  .jy-pg :global([data-editor-pane][data-invalid] .cm-editor) {
    box-shadow: inset 2px 0 0 0 var(--color-inverse-error);
  }

  .jy-results {
    min-height: 120px;
  }
  .jy-pg :global(.result-panel__summary.text-inverse-error) {
    color: var(--color-inverse-error);
  }

  /* ── Runtime-injected markup (render.ts) — on the slab, so slab inks only.
     Anchored on this component's own `.jy-results` container (the panel
     wrapper is ResultPanel's and carries no scope attribute). ─────────── */
  .jy-results :global(.jy-out) {
    border-radius: var(--radius-md);
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    overflow: hidden;
    animation: jy-rise var(--dur-base) var(--ease-brand) both;
  }
  .jy-results :global(.jy-out__bar) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px 7px 14px;
    border-bottom: 1px solid var(--color-inverse-hairline);
  }
  .jy-results :global(.jy-out__name) {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-inverse-fg);
  }
  .jy-results :global(.jy-out__meta) {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-inverse-mute);
    white-space: nowrap;
  }
  .jy-results :global(.jy-out__pre) {
    margin: 0;
    padding: 14px 16px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-inverse-fg);
    white-space: pre;
    tab-size: 2;
  }

  .jy-results :global(.jy-block) {
    margin-top: 12px;
    border-radius: var(--radius-md);
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    overflow: hidden;
    animation: jy-rise var(--dur-base) var(--ease-brand) both;
  }
  /* Group-heading role (a sans heading over its rows, not one more label). */
  .jy-results :global(.jy-block__head) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--color-inverse-hairline);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    color: var(--color-inverse-fg);
  }
  .jy-results :global(.jy-block__meta) {
    margin-left: auto;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--color-inverse-mute);
    white-space: nowrap;
  }
  .jy-results :global(.jy-block__sub) {
    margin: 0;
    padding: 8px 14px;
    border-bottom: 1px solid #ffffff12;
    font-size: 12px;
    line-height: 18px;
    color: var(--color-inverse-mute);
    text-wrap: pretty;
  }
  .jy-results :global(.jy-diag) {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 9px 10px 9px 14px;
  }
  .jy-results :global(.jy-diag + .jy-diag) {
    border-top: 1px solid #ffffff12;
  }
  /* Severity: the row-key role (label-field), tinted in slab inks. */
  .jy-results :global(.jy-diag__sev) {
    @apply label-field;
    flex: 0 0 auto;
    margin-top: 1px;
    padding: 1px 7px;
    border-radius: var(--radius-xs);
  }
  .jy-results :global(.jy-diag--error .jy-diag__sev) {
    background: #ff9d951f;
    color: var(--color-inverse-error);
  }
  .jy-results :global(.jy-diag--warning .jy-diag__sev) {
    background: #e0a4581f;
    color: var(--color-inverse-accent);
  }
  .jy-results :global(.jy-diag--note .jy-diag__sev) {
    background: #ffffff14;
    color: var(--color-inverse-mute);
  }
  .jy-results :global(.jy-diag__body) {
    min-width: 0;
    flex: 1 1 auto;
  }
  .jy-results :global(.jy-diag__msg) {
    margin: 0;
    font-size: 13px;
    line-height: 19px;
    color: var(--color-inverse-fg);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  .jy-results :global(.jy-diag__loc) {
    display: inline-block;
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    color: var(--color-inverse-mute);
    overflow-wrap: anywhere;
  }
  .jy-results :global(.jy-clean) {
    margin: 0;
    padding: 12px 14px;
    font-size: 13px;
    line-height: 19px;
    color: var(--color-inverse-mute);
    text-wrap: pretty;
  }

  .jy-results :global(.jy-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .jy-results :global(.jy-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  .jy-results :global(.jy-error__title) {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  .jy-results :global(.jy-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 19px;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .jy-results :global(.jy-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 96px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }

  /* Per-row copy (render.ts emits the button; playground-kit/copy.ts drives
     it, and marks success with [data-copied]). */
  .jy-results :global(.jy-copy) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-inverse-mute);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      color var(--dur-fast) var(--ease-brand),
      background-color var(--dur-fast) var(--ease-brand);
  }
  .jy-results :global(.jy-copy:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .jy-results :global(.jy-copy[data-copied]) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
  .jy-results :global(.jy-copy:focus-visible),
  .jy-results :global(.jy-out__pre:focus-visible) {
    outline: 2px solid var(--color-inverse-brand);
    outline-offset: 1px;
  }
  @media (pointer: coarse) {
    .jy-results :global(.jy-copy) {
      width: var(--control-h-lg);
      height: var(--control-h-lg);
    }
  }

  @keyframes jy-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .jy-results :global(.jy-out),
    .jy-results :global(.jy-block) {
      animation: none;
    }
  }
</style>

<script>
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import type { Extension } from '@codemirror/state';
  import type { EditorView } from '@codemirror/view';
  // The HTML builders are shared with the frontmatter's build-time seed —
  // one implementation, so the no-JS markup and the live markup never drift.
  // They return `{ html, payloads }`: the multi-line copy text is bound to the
  // live `[data-payload]` buttons below, because it round-trips badly through
  // an HTML attribute. The server ignores the array.
  import { resultHtml, errorHtml, summaryText, EMPTY_HTML } from '../lib/json-yaml-converter/render';
  import type {
    ConvertResult as Result,
    DetectedFormat as Detected,
    Diagnostic,
    Direction,
    Indent,
    ShareState,
  } from '../lib/json-yaml-converter/types';

  type EngineModule = {
    convert: (
      input: string,
      options: { direction: Direction; indent?: Indent; sortKeys?: boolean },
    ) => Result;
    encodeState: (state: ShareState) => string;
    decodeState: (hash?: string) => ShareState | null;
  };
  type Example = { id: string; label: string; direction: Direction; input: string };

  const ROOT_SEL = '.jy-pg';
  const SLUG = 'json-yaml-converter';
  /* One debounce, inside the contract's 130–220ms band. */
  const DEBOUNCE_MS = 180;
  /* Nothing goes red until the typing has been idle this long. */
  const ERROR_HOLD_MS = 600;
  /* Past ~2000 chars a fragment stops being a dependable URL (browser, proxy
     and chat-client limits), so we neither write it nor offer the share link —
     the converter itself keeps working on documents of any size. */
  const MAX_HASH_LEN = 2000;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.jyWired === 'true') return;
      root.dataset.jyWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          direction: o.direction === 'json-to-yaml' ? 'json-to-yaml' : 'yaml-to-json',
          input: typeof o.input === 'string' ? o.input : '',
        } satisfies Example;
      })
      .filter((e) => e.input.length > 0);
  }

  /* ---- Instance init ----------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const editorHost = el<HTMLElement>(root, '#jy-input');
    const paneEl = el<HTMLElement>(root, '[data-editor-pane]');
    // The editor pane's figure-cap label names the input's format.
    const inputName = paneEl?.querySelector<HTMLElement>('.figcap__label') ?? null;
    const resultsBox = el<HTMLElement>(root, '#jy-results');
    const summaryEl = el<HTMLElement>(root, '#jy-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#jy-share');
    const copyAllBtn = el<HTMLButtonElement>(root, '#jy-copy-all');
    const copyStatus = el<HTMLElement>(root, '#jy-copy-status');
    const dirY2jBtn = el<HTMLButtonElement>(root, '#jy-dir-y2j');
    const dirJ2yBtn = el<HTMLButtonElement>(root, '#jy-dir-j2y');
    const indent2Btn = el<HTMLButtonElement>(root, '#jy-indent-2');
    const indent4Btn = el<HTMLButtonElement>(root, '#jy-indent-4');
    const sortInput = el<HTMLInputElement>(root, '#jy-sort');
    const switchBtn = el<HTMLButtonElement>(root, '#jy-switch');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#jy-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#jy-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#jy-snap-delete');
    const chipsWrap = el<HTMLElement>(root, '#jy-chips');
    const chips = Array.from(chipsWrap?.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR) ?? []);

    if (
      !editorHost ||
      !paneEl ||
      !resultsBox ||
      !summaryEl ||
      !shareBtn ||
      !copyAllBtn ||
      !copyStatus ||
      !dirY2jBtn ||
      !dirJ2yBtn ||
      !indent2Btn ||
      !indent4Btn ||
      !sortInput ||
      !switchBtn ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    /* ---- Copy plumbing (output + diagnostic rows, Copy link, Copy output) —
       the kit helper: one delegated listener; outcomes announced in
       #jy-copy-status. ------------------------------------------------------ */

    wireCopyButtons(root, { status: copyStatus });

    /* ---- Lazy engine + examples + CodeMirror ----------------------------- */

    let engine: EngineModule;
    let examples: Example[] = [];
    let EditorState: typeof import('@codemirror/state').EditorState;
    let Compartment: typeof import('@codemirror/state').Compartment;
    let EditorViewCtor: typeof import('@codemirror/view').EditorView;
    let keymap: typeof import('@codemirror/view').keymap;
    let lineNumbers: typeof import('@codemirror/view').lineNumbers;
    let highlightActiveLine: typeof import('@codemirror/view').highlightActiveLine;
    let defaultKeymap: typeof import('@codemirror/commands').defaultKeymap;
    // Named `cmHistory`, not `history`: a bare `history` here would shadow
    // `window.history`, which `writeHash` needs for replaceState.
    let cmHistory: typeof import('@codemirror/commands').history;
    let historyKeymap: typeof import('@codemirror/commands').historyKeymap;
    let indentWithTab: typeof import('@codemirror/commands').indentWithTab;
    let yamlLang: typeof import('@codemirror/lang-yaml').yaml;
    let jsonLang: typeof import('@codemirror/lang-json').json;
    let plate: typeof import('../lib/playground-kit/cm-theme').plate;

    try {
      const [engineMod, examplesMod, stateMod, viewMod, commandsMod, yamlMod, jsonMod, themeMod] =
        await Promise.all([
          import('../lib/json-yaml-converter/engine'),
          import('../lib/json-yaml-converter/examples'),
          import('@codemirror/state'),
          import('@codemirror/view'),
          import('@codemirror/commands'),
          import('@codemirror/lang-yaml'),
          import('@codemirror/lang-json'),
          // The plate theme + highlight (the ONE code palette), in the same
          // closure as the languages — a static import would pull
          // @codemirror/view into the page shell.
          import('../lib/playground-kit/cm-theme'),
        ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
      ({ EditorState, Compartment } = stateMod);
      ({ EditorView: EditorViewCtor, keymap, lineNumbers, highlightActiveLine } = viewMod);
      ({ history: cmHistory, defaultKeymap, historyKeymap, indentWithTab } = commandsMod);
      ({ yaml: yamlLang } = yamlMod);
      ({ json: jsonLang } = jsonMod);
      ({ plate } = themeMod);
    } catch (err) {
      summaryEl.textContent = '';
      resultsBox.innerHTML = errorHtml(
        'yaml-to-json',
        'The converter engine failed to load. Reload the page to try again.',
        true,
      ).html;
      console.error('[JsonYamlConverter] engine/CodeMirror import failed:', err);
      return;
    }

    /* ---- Control state --------------------------------------------------- */

    type EvalSource = 'type' | 'commit' | 'seed';
    type UiState = 'empty' | 'valid' | 'pending' | 'invalid';

    let direction: Direction = 'yaml-to-json';
    let indent: Indent = 2;
    let sortKeys = false;
    let uiState: UiState = 'empty';
    let evalTimer: number | undefined;
    let errTimer: number | undefined;
    let lastWrittenHash: string | null = null;
    let liveReady = false;

    const langCompartment = new Compartment();

    function inputLanguage(): Extension {
      return direction === 'json-to-yaml' ? jsonLang() : yamlLang();
    }

    function clearTimers(): void {
      window.clearTimeout(evalTimer);
      window.clearTimeout(errTimer);
    }

    /* ---- Editor ---------------------------------------------------------- */

    function makeEditor(host: HTMLElement, doc: string): EditorView {
      const state = EditorState.create({
        doc,
        extensions: [
          lineNumbers(),
          cmHistory(),
          highlightActiveLine(),
          langCompartment.of(inputLanguage()),
          plate,
          // This pane's size only; colours, gutter and focus ring are the
          // kit's (cm-theme.ts + global.css .editor-pane__host).
          EditorViewCtor.theme({
            '&': { fontSize: '13px' },
            '.cm-scroller': { minHeight: '240px', maxHeight: '440px', scrollbarWidth: 'thin' },
          }),
          EditorViewCtor.lineWrapping,
          // CodeMirror puts role="textbox" on the content DOM; without a name
          // that is an unlabelled input field for a screen reader (and an axe
          // violation). aria-describedby points at the live-eval hint line.
          EditorViewCtor.contentAttributes.of({
            'aria-label': 'JSON or YAML input',
            'aria-describedby': 'jy-run-hint',
          }),
          keymap.of([
            // Ours FIRST, so they win over defaultKeymap's Enter/Escape.
            {
              key: 'Mod-Enter',
              run: () => {
                clearTimers();
                evaluate('commit');
                view.contentDOM.blur();
                return true;
              },
            },
            {
              // Plain Enter must still insert the newline, so this returns
              // false and lets insertNewlineAndIndent run — the eval is
              // flushed on the next tick, once the doc includes the newline.
              key: 'Enter',
              run: () => {
                window.setTimeout(() => {
                  clearTimers();
                  evaluate('commit');
                }, 0);
                return false;
              },
            },
            {
              // The Tab-trap escape hatch: indentWithTab means Tab indents, so
              // Escape is the documented way out of the editor.
              key: 'Escape',
              run: (v) => {
                v.contentDOM.blur();
                return true;
              },
            },
            ...defaultKeymap,
            ...historyKeymap,
            indentWithTab,
          ]),
          EditorViewCtor.updateListener.of((u) => {
            if (!u.docChanged || !liveReady) return;
            clearChips();
            clearTimers();
            evalTimer = window.setTimeout(() => evaluate('type'), DEBOUNCE_MS);
          }),
        ],
      });
      return new EditorViewCtor({ state, parent: host });
    }

    function setEditorDoc(view: EditorView, doc: string): void {
      view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: doc } });
      view.requestMeasure();
    }

    /* ---- Chrome ---------------------------------------------------------- */

    function applyDirectionChrome(): void {
      const toJson = direction === 'yaml-to-json';
      dirY2jBtn!.setAttribute('aria-checked', String(toJson));
      dirJ2yBtn!.setAttribute('aria-checked', String(!toJson));
      // Roving tabindex: only the checked radio is in the tab order.
      dirY2jBtn!.tabIndex = toJson ? 0 : -1;
      dirJ2yBtn!.tabIndex = toJson ? -1 : 0;
      const name = toJson ? 'input.yaml' : 'input.json';
      if (inputName) {
        inputName.textContent = name;
        inputName.title = name;
      }
    }

    function applyIndentChrome(): void {
      const two = indent === 2;
      indent2Btn!.setAttribute('aria-checked', String(two));
      indent4Btn!.setAttribute('aria-checked', String(!two));
      indent2Btn!.tabIndex = two ? 0 : -1;
      indent4Btn!.tabIndex = two ? -1 : 0;
    }

    function applyLanguage(): void {
      view.dispatch({ effects: langCompartment.reconfigure(inputLanguage()) });
    }

    function setSummary(text: string, isError: boolean): void {
      summaryEl!.textContent = text;
      summaryEl!.classList.toggle('text-inverse-error', isError);
      summaryEl!.classList.toggle('text-inverse-mute', !isError);
    }

    function setErrorState(on: boolean): void {
      paneEl!.toggleAttribute('data-invalid', on);
      if (on) {
        view.contentDOM.setAttribute('aria-invalid', 'true');
        view.contentDOM.setAttribute('aria-describedby', 'jy-run-hint jy-error-detail');
      } else {
        view.contentDOM.removeAttribute('aria-invalid');
        view.contentDOM.setAttribute('aria-describedby', 'jy-run-hint');
      }
    }

    function hideActions(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
      copyAllBtn!.hidden = true;
      copyAllBtn!.dataset.copy = '';
    }

    function setActiveChip(idx: number | null): void {
      syncChipsByIndex(chipsWrap, idx);
    }

    function clearChips(): void {
      setActiveChip(null);
    }

    /**
     * The "looks like the other format" nudge. Never auto-switches — a silent
     * reinterpretation of a paste is exactly the behaviour this tool exists to
     * argue against.
     */
    function updateSwitchNudge(detected: Detected): void {
      const mismatch =
        (direction === 'json-to-yaml' && detected === 'yaml') ||
        (direction === 'yaml-to-json' && detected === 'json');
      if (!mismatch) {
        switchBtn!.hidden = true;
        return;
      }
      switchBtn!.textContent =
        direction === 'json-to-yaml'
          ? 'Looks like YAML — switch to YAML → JSON'
          : 'Looks like JSON already — switch to JSON → YAML';
      switchBtn!.hidden = false;
    }

    /* ---- Deep link / share ---------------------------------------------- */

    function currentFragment(): string {
      try {
        return engine.encodeState({
          direction,
          indent,
          sortKeys,
          text: view.state.doc.toString(),
        });
      } catch {
        return '';
      }
    }

    function writeHash(fragment: string | null): void {
      const target = fragment ?? '';
      if (target === lastWrittenHash) return;
      // Safari throttles replaceState (~100 per 30s) and throws — never let
      // that break typing.
      try {
        if (fragment) {
          window.history.replaceState(null, '', fragment);
        } else {
          window.history.replaceState(null, '', location.pathname + location.search);
        }
        lastWrittenHash = target;
      } catch {
        /* ignore */
      }
    }

    /* ---- Render + evaluate ---------------------------------------------- */

    function renderEmpty(): void {
      uiState = 'empty';
      setErrorState(false);
      hideActions();
      setSummary('', false);
      switchBtn!.hidden = true;
      resultsBox!.innerHTML = EMPTY_HTML;
    }

    /**
     * Write a `Rendered` block and bind its copy payloads. The builders number
     * every copy button `data-payload="<i>"` into the array they return, so the
     * multi-line output and each diagnostic line never touch an HTML attribute.
     */
    function paint(rendered: { html: string; payloads: string[] }): void {
      resultsBox!.innerHTML = rendered.html;
      resultsBox!.querySelectorAll<HTMLButtonElement>('[data-payload]').forEach((btn) => {
        const text = rendered.payloads[Number(btn.dataset.payload)];
        if (typeof text === 'string') btn.dataset.copy = text;
      });
    }

    function renderResult(result: Result): void {
      paint(resultHtml(result));
    }

    function renderErrorState(message: string, extra: Diagnostic[], isAlert: boolean): void {
      paint(errorHtml(direction, message, isAlert, extra));
    }

    function showError(message: string, extra: Diagnostic[], source: EvalSource): void {
      uiState = 'invalid';
      clearTimers();
      setErrorState(true);
      hideActions();
      setSummary('Could not convert', true);
      renderErrorState(message, extra, source === 'commit');
      if (source !== 'seed') writeHash(null);
    }

    function evaluate(source: EvalSource): void {
      clearTimers();
      const text = view.state.doc.toString();
      if (text.trim().length === 0) {
        renderEmpty();
        if (source !== 'seed') writeHash(null);
        return;
      }

      let result: Result | null = null;
      try {
        result = engine.convert(text, { direction, indent, sortKeys });
      } catch (err) {
        console.error('[JsonYamlConverter] convert threw:', err);
        result = null;
      }

      updateSwitchNudge(result?.detected ?? 'ambiguous');

      if (result && result.ok) {
        uiState = 'valid';
        setErrorState(false);
        renderResult(result);
        setSummary(summaryText(result), false);
        copyAllBtn!.hidden = false;
        copyAllBtn!.dataset.copy = result.output;
        const fragment = currentFragment();
        if (fragment.length > 0 && fragment.length <= MAX_HASH_LEN) {
          shareBtn!.hidden = false;
          shareBtn!.dataset.copy =
            location.origin + location.pathname + location.search + fragment;
          if (source !== 'seed') {
            writeHash(fragment);
            recordToolLastInput(SLUG, fragment);
          }
        } else {
          // Too long to be a dependable link: keep converting, drop the share.
          shareBtn!.hidden = true;
          shareBtn!.dataset.copy = '';
          if (source !== 'seed') writeHash(null);
        }
        return;
      }

      const diagnostics = result?.diagnostics ?? [];
      const firstError = diagnostics.find((d) => d.severity === 'error');
      const message =
        firstError?.message ?? 'The converter could not read this input. Check the format above.';
      const extra = diagnostics.filter((d) => d !== firstError);

      if (source !== 'type') {
        showError(message, extra, source);
        return;
      }

      // Mid-typing: hold the previous card, nothing goes red yet. The error only
      // surfaces once the typing has been idle for ERROR_HOLD_MS.
      uiState = 'pending';
      setErrorState(false);
      hideActions();
      setSummary('', false);
      errTimer = window.setTimeout(() => showError(message, extra, 'type'), ERROR_HOLD_MS);
    }

    /* ---- Seed (before any listener fires, so nothing writes the hash) ---- */

    const firstExample = examples[0];
    let seedText = firstExample?.input ?? '';
    let seedChip: number | null = firstExample ? 0 : null;
    if (firstExample) direction = firstExample.direction;

    function applyShareState(state: ShareState): void {
      direction = state.direction === 'json-to-yaml' ? 'json-to-yaml' : 'yaml-to-json';
      indent = state.indent === 4 ? 4 : 2;
      sortKeys = state.sortKeys === true;
      seedText = state.text;
      seedChip = null;
    }

    let fromHash = false;
    try {
      const shared = engine.decodeState(window.location.hash);
      if (shared && shared.text.length > 0) {
        applyShareState(shared);
        fromHash = true;
      }
    } catch {
      /* malformed fragment — fall through to the restore/example tiers */
    }

    if (!fromHash) {
      const restored = getRestoredLastInput(SLUG);
      if (restored) {
        try {
          const state = engine.decodeState(restored);
          if (state && state.text.length > 0) applyShareState(state);
        } catch {
          /* malformed stored value — keep the example seed */
        }
      }
    }

    const view = makeEditor(editorHost, seedText);
    // The build-time text stand-in has done its job (no-JS visitors and
    // crawlers); CodeMirror appended its editor beside it, so drop it. The
    // `#s=` share state and the restore tier above already won over the example
    // seed where they applied, so nothing the fallback held is lost.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());
    sortInput.checked = sortKeys;
    applyDirectionChrome();
    applyIndentChrome();
    setActiveChip(seedChip);

    /* ---- Events ---------------------------------------------------------- */

    function setDirection(next: Direction, focus: boolean): void {
      if (direction !== next) {
        direction = next;
        applyDirectionChrome();
        applyLanguage();
        // The active example no longer describes what is on screen.
        clearChips();
        clearTimers();
        evaluate('commit');
      }
      if (focus) (next === 'yaml-to-json' ? dirY2jBtn! : dirJ2yBtn!).focus();
    }

    function setIndent(next: Indent, focus: boolean): void {
      if (indent !== next) {
        indent = next;
        applyIndentChrome();
        clearTimers();
        evaluate('commit');
      }
      if (focus) (next === 2 ? indent2Btn! : indent4Btn!).focus();
    }

    dirY2jBtn.addEventListener('click', () => setDirection('yaml-to-json', false));
    dirJ2yBtn.addEventListener('click', () => setDirection('json-to-yaml', false));
    indent2Btn.addEventListener('click', () => setIndent(2, false));
    indent4Btn.addEventListener('click', () => setIndent(4, false));

    // WAI-ARIA radio group keyboard pattern: arrows move AND select; Home/End
    // jump to the ends.
    function radioKeydown(
      e: KeyboardEvent,
      isFirstChecked: () => boolean,
      select: (first: boolean) => void,
    ): void {
      switch (e.key) {
        case 'ArrowRight':
        case 'ArrowDown':
        case 'ArrowLeft':
        case 'ArrowUp':
          e.preventDefault();
          select(!isFirstChecked());
          break;
        case 'Home':
          e.preventDefault();
          select(true);
          break;
        case 'End':
          e.preventDefault();
          select(false);
          break;
      }
    }

    const onDirKeydown = (e: KeyboardEvent): void =>
      radioKeydown(
        e,
        () => direction === 'yaml-to-json',
        (first) => setDirection(first ? 'yaml-to-json' : 'json-to-yaml', true),
      );
    dirY2jBtn.addEventListener('keydown', onDirKeydown);
    dirJ2yBtn.addEventListener('keydown', onDirKeydown);

    const onIndentKeydown = (e: KeyboardEvent): void =>
      radioKeydown(
        e,
        () => indent === 2,
        (first) => setIndent(first ? 2 : 4, true),
      );
    indent2Btn.addEventListener('keydown', onIndentKeydown);
    indent4Btn.addEventListener('keydown', onIndentKeydown);

    sortInput.addEventListener('change', () => {
      sortKeys = sortInput.checked;
      clearTimers();
      evaluate('commit');
    });

    switchBtn.addEventListener('click', () => {
      setDirection(direction === 'yaml-to-json' ? 'json-to-yaml' : 'yaml-to-json', false);
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        const ex = examples[idx];
        if (direction !== ex.direction) {
          direction = ex.direction;
          applyDirectionChrome();
          applyLanguage();
        }
        liveReady = false;
        setEditorDoc(view, ex.input);
        liveReady = true;
        setActiveChip(idx);
        clearTimers();
        evaluate('commit');
      });
    });

    // Committing on blur means a half-typed document that the user tabbed away
    // from still explains itself, instead of sitting silently in `pending`.
    view.contentDOM.addEventListener('blur', () => {
      if (uiState === 'pending') {
        clearTimers();
        evaluate('commit');
      }
    });

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      // The snapshot payload is the same `#s=` fragment the share link uses, so
      // direction, indent and Sort-keys all come back with the text.
      getValue: () => currentFragment(),
      setValue: (value) => {
        let state: ShareState | null = null;
        try {
          state = engine.decodeState(value);
        } catch {
          return;
        }
        if (!state) return;
        direction = state.direction === 'json-to-yaml' ? 'json-to-yaml' : 'yaml-to-json';
        indent = state.indent === 4 ? 4 : 2;
        sortKeys = state.sortKeys === true;
        sortInput!.checked = sortKeys;
        applyDirectionChrome();
        applyIndentChrome();
        applyLanguage();
        liveReady = false;
        setEditorDoc(view, state.text);
        liveReady = true;
        clearChips();
        clearTimers();
        evaluate('commit');
      },
    });

    /* ---- First render: never writes the hash ---------------------------- */

    evaluate('seed');
    liveReady = true;
    requestAnimationFrame(() => view.requestMeasure());
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
