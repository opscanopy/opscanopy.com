---
/**
 * DockerRunToComposePlayground — the interactive Docker Run ↔ Compose island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>
 * that lazily boots ONE CodeMirror 6 editor (YAML highlighting) plus a mode
 * toggle (run → compose | compose → run) and the example chips. Conversion is
 * live and debounced; "Run now" and ⌘/Ctrl + Enter convert immediately.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * EditorPane (the input slab), RunHint, SnapshotBar, ResultPanel (figure cap,
 * live summary, copy status) and CopyButton. The two seeded containers
 * (`#drc-output`, `#drc-warnings`) stay here with `set:html` +
 * `data-results`; their slab overrides anchor on `.drc-output` /
 * `.drc-warnings`.
 *
 * Runtime contract (imported lazily in the script):
 *   ../lib/docker-run-to-compose/engine →
 *     runToCompose(cmd: string)  => { ok, yaml?, warnings, error? }
 *     composeToRun(yaml: string) => { ok, command?, warnings, error? }
 *   ../lib/docker-run-to-compose/examples →
 *     examples: Array<{ id; label; run; compose }>
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used to server-render the example chips (ExampleChips), so the static HTML
// carries real example names for crawlers and no-JS visitors. The script
// re-reads the examples module at hydration and addresses each chip by its
// `data-example-idx`, so this adds nothing to the client bundle.
import { examples as prerenderedExamples } from '../lib/docker-run-to-compose/examples';
import { runToCompose } from '../lib/docker-run-to-compose/engine';
import {
  resultHtml,
  warningsHtml,
  statusText,
  EMPTY_HTML,
} from '../lib/docker-run-to-compose/render';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-converts the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees the real Compose YAML
 * and its migration notes instead of "pick a mode, then convert".
 *
 * The seed is always the DEFAULT `run → compose` direction, which is the mode
 * the markup ships checked. `runToCompose` is pure, synchronous and clock-free,
 * so it runs at build time unchanged. The command itself goes into a
 * `<pre data-cm-fallback>` inside the CodeMirror host — CM appends its editor
 * to the host, so the script removes the fallback once mounted.
 */
const seedExample = prerenderedExamples[0];
const seedInput = seedExample?.run ?? '';
const seedResult = seedExample ? runToCompose(seedInput) : null;
// A bundled example that fails to convert would be a bug, not a note — fall
// back to the shared empty state rather than server-rendering an error banner.
const seedOk = seedResult && seedResult.ok !== false && !seedResult.error ? seedResult : null;
const seedHtml = seedOk ? resultHtml('docker-compose.yml', seedOk.yaml ?? '') : EMPTY_HTML;
const seedWarnings = seedOk ? (seedOk.warnings ?? []) : [];
const seedWarningsHtml = seedOk ? warningsHtml(seedWarnings) : '';
const seedStatus = seedOk ? statusText(seedWarnings) : '';
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="drc" aria-label="Docker Run to Compose converter playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: direction, examples, Run now ────────────────────────── */}
    <div
      class="flex flex-col gap-3 border-b border-hairline px-4 py-3 sm:flex-row sm:items-end sm:justify-between sm:px-5"
    >
      <div class="flex min-w-0 flex-wrap items-end gap-3">
        {/* Mode toggle — mutually-exclusive direction switch (radio group). */}
        <div
          class="drc-modes inline-flex shrink-0 rounded-md p-0.5"
          role="radiogroup"
          aria-label="Conversion direction"
        >
          <button
            id="drc-mode-run"
            type="button"
            role="radio"
            aria-checked="true"
            tabindex="0"
            class="drc-mode code-mono"
          >
            run → compose
          </button>
          <button
            id="drc-mode-compose"
            type="button"
            role="radio"
            aria-checked="false"
            tabindex="-1"
            class="drc-mode code-mono"
          >
            compose → run
          </button>
        </div>

        <div class="flex min-w-0 flex-col gap-1">
          <span class="eyebrow">Examples</span>
          <ExampleChips prefix="drc" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
        </div>
      </div>

      <button
        id="drc-run"
        type="button"
        class="btn-tool drc-tap"
        title="Run now (⌘/Ctrl + Enter)"
        aria-keyshortcuts="Meta+Enter Control+Enter"
      >
        Run now
      </button>
    </div>

    {/* ── Input editor ──────────────────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <EditorPane prefix="drc" id="drc-editor" label="docker run">
        <pre class="editor-pane__fallback code-mono" data-cm-fallback>{seedInput}</pre>
      </EditorPane>
      <RunHint variant="cm" class="mt-2" />
      <SnapshotBar prefix="drc" />
    </div>

    {/* ── Result: the converted output + migration notes ───────────────── */}
    <ResultPanel slug="docker-run-to-compose" prefix="drc" summary={seedStatus} summaryClass="whitespace-nowrap" split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="drc-share" />
        <CopyButton kind="all" id="drc-copy" label="Copy output" />
        <CopyButton kind="value" id="drc-md" label="Copy as Markdown" icon="markdown" />
      </Fragment>

      {/* Seeded at build time (see `seedHtml` above) so the converted YAML is
          in the static HTML; the client rebuilds the same markup on boot. */}
      <div id="drc-output" class="drc-output" set:html={seedHtml} data-results></div>

      <div
        id="drc-warnings"
        class="drc-warnings"
        role="status"
        aria-live="polite"
        aria-atomic="false"
        set:html={seedWarningsHtml}
        data-results
      ></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .drc-tap {
    touch-action: manipulation;
  }

  /* Mode toggle — segmented control on a soft track. */
  .drc-modes {
    background: var(--color-canvas-soft-2);
    box-shadow: var(--shadow-hairline);
  }
  .drc-mode {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--color-mute);
    font-size: 12px;
    line-height: 16px;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      color var(--dur-fast) var(--ease-brand);
  }
  .drc-mode:hover {
    color: var(--color-body);
  }
  .drc-mode[aria-checked='true'] {
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
  }
  .drc-mode:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  @media (pointer: coarse) {
    .drc-mode {
      min-height: var(--control-h-lg);
    }
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.drc-output` / `.drc-warnings`. */
  :global(.drc-result) {
    border-radius: var(--radius-md);
    background: var(--color-inverse);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: drc-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.drc-result__bar) {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--color-inverse-hairline);
  }
  :global(.drc-result__dot) {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-inverse-hairline);
  }
  :global(.drc-result__name) {
    margin-left: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-inverse-mute);
  }
  :global(.drc-result__pre) {
    margin: 0;
    padding: 14px 16px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-inverse-fg);
    white-space: pre;
    tab-size: 2;
  }

  /* Error banner. */
  :global(.drc-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
    animation: drc-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.drc-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.drc-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.drc-error__detail) {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* Warnings list (non-fatal notes). */
  .drc-warnings:empty {
    display: none;
  }
  .drc-warnings {
    margin-top: 12px;
  }
  :global(.drc-warn) {
    display: flex;
    gap: 10px;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    background: var(--color-warning-soft);
    box-shadow: var(--shadow-hairline);
    color: var(--color-warning-deep);
    animation: drc-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.drc-warn + .drc-warn) {
    margin-top: 8px;
  }
  :global(.drc-warn__icon) {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    margin-top: 1px;
  }
  :global(.drc-warn__text) {
    font-size: 13px;
    line-height: 18px;
    word-break: break-word;
    text-wrap: pretty;
  }
  :global(.drc-warn code) {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--color-canvas-soft-2);
    padding: 1px 5px;
    border-radius: var(--radius-xs);
    color: var(--color-ink);
  }

  :global(.drc-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  @keyframes drc-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.drc-result),
    :global(.drc-error),
    :global(.drc-warn) {
      animation: none;
    }
  }

  /* ── Instrument re-skin — the output and notes sit on the L2 result slab
     (dark in BOTH themes), so everything render.ts emits uses the slab ink
     tier. The converted file reads as a hairline frame on the plate, not a
     second slab. ─────────────────────────────────────────────────────── */
  .drc-output :global(.drc-result) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .drc-output :global(.drc-empty) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .drc-output :global(.drc-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .drc-warnings :global(.drc-warn) {
    background: #e0a45814;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-accent);
  }
  .drc-warnings :global(.drc-warn__text) {
    color: var(--color-inverse-fg);
  }
  .drc-warnings :global(.drc-warn code) {
    background: #ffffff14;
    color: var(--color-inverse-fg);
  }

  .is-busy {
    opacity: 0.65;
    pointer-events: none;
    cursor: progress;
  }
</style>

<script>
  import type { EditorView } from '@codemirror/view';
  import { buildMarkdownBlock } from '../lib/share-md';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  // The HTML builders are shared with the frontmatter's build-time seed —
  // one implementation, so the no-JS markup and the live markup never drift.
  import {
    resultHtml,
    warningsHtml,
    statusText,
    errorHtml,
    EMPTY_HTML,
  } from '../lib/docker-run-to-compose/render';

  /* ---- Types mirrored from the engine contract (structural, not imported). -- */
  type RunResult = { ok: boolean; yaml?: string; warnings?: string[]; error?: string };
  type ComposeResult = { ok: boolean; command?: string; warnings?: string[]; error?: string };
  type ShareState = { dir: Mode; text: string };

  type EngineModule = {
    runToCompose: (cmd: string) => RunResult;
    composeToRun: (yamlText: string) => ComposeResult;
    encodeState: (dir: Mode, text: string) => string;
    decodeState: () => ShareState | null;
  };
  type ExampleRaw = Record<string, unknown>;
  type Example = { id: string; label: string; run: string; compose: string };
  type Mode = 'run' | 'compose';
  /** `seed` = boot / deep link / restore (never written or recorded); `type` = debounced edit; `run` = explicit. */
  type Source = 'seed' | 'type' | 'run';

  const ROOT_SEL = '.drc';
  const SLUG = 'docker-run-to-compose';
  const DEBOUNCE_MS = 180;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.drcWired === 'true') return;
      root.dataset.drcWired = 'true';
      void init(root);
    });
  }

  /* ---- Small helpers -------------------------------------------------------- */

  function pick(obj: ExampleRaw, keys: string[]): string {
    for (const k of keys) {
      const v = obj[k];
      if (typeof v === 'string' && v.length > 0) return v;
    }
    return '';
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw.map((item, i) => {
      const o = (item ?? {}) as ExampleRaw;
      return {
        id: pick(o, ['id', 'slug', 'key']) || `example-${i + 1}`,
        label: pick(o, ['label', 'name', 'title']) || `Example ${i + 1}`,
        run: pick(o, ['run', 'command', 'cmd']),
        compose: pick(o, ['compose', 'yaml', 'service']),
      };
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function isCoarsePointer(): boolean {
    return window.matchMedia?.('(pointer: coarse)').matches ?? false;
  }

  /**
   * Rename an EditorPane's figure cap (the input's name follows the mode).
   * EditorPane renders a static label; the cap's label span is the only text
   * in it, so this rewrites that span and its title.
   */
  function setPaneLabel(host: HTMLElement, text: string): void {
    const label = host.closest('[data-editor-pane]')?.querySelector<HTMLElement>('.figcap__label');
    if (!label) return;
    label.textContent = text;
    label.title = text;
  }

  /* ---- Result rendering (DOM writes over the shared pure builders) --------- */

  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderEmpty(output: HTMLElement, warnings: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    output.innerHTML = EMPTY_HTML;
    warnings.innerHTML = '';
  }

  function renderError(output: HTMLElement, warnings: HTMLElement, summary: HTMLElement, message: string): void {
    setSummary(summary, 'Error', true);
    output.innerHTML = errorHtml(message);
    warnings.innerHTML = '';
  }

  function renderResult(
    output: HTMLElement,
    warningsBox: HTMLElement,
    summary: HTMLElement,
    name: string,
    code: string,
    warnings: string[],
  ): void {
    output.innerHTML = resultHtml(name, code);
    setSummary(summary, statusText(warnings), false);
    warningsBox.innerHTML = warningsHtml(warnings);
  }

  /* ---- Instance init -------------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const editorHost = el<HTMLElement>(root, '#drc-editor');
    const chipsWrap = el<HTMLElement>(root, '#drc-chips');
    const runBtn = el<HTMLButtonElement>(root, '#drc-run');
    const copyBtn = el<HTMLButtonElement>(root, '#drc-copy');
    const shareBtn = el<HTMLButtonElement>(root, '#drc-share');
    const mdBtn = el<HTMLButtonElement>(root, '#drc-md');
    const copyStatus = el<HTMLElement>(root, '#drc-copy-status');
    const outputBox = el<HTMLElement>(root, '#drc-output');
    const warningsBox = el<HTMLElement>(root, '#drc-warnings');
    const summaryEl = el<HTMLElement>(root, '#drc-summary');
    const modeRunBtn = el<HTMLButtonElement>(root, '#drc-mode-run');
    const modeComposeBtn = el<HTMLButtonElement>(root, '#drc-mode-compose');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#drc-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#drc-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#drc-snap-delete');

    if (
      !editorHost || !chipsWrap || !runBtn || !copyBtn || !shareBtn || !mdBtn || !copyStatus ||
      !outputBox || !warningsBox || !summaryEl || !modeRunBtn || !modeComposeBtn ||
      !snapSaveBtn || !snapSelect || !snapDeleteBtn
    ) {
      return;
    }

    // The notes list keeps its server-rendered attributes byte-for-byte (the
    // ssr-diff gate compares them), but once hydrated the result panel's
    // summary is the ONE live region: the results are not re-announced.
    warningsBox.removeAttribute('role');
    warningsBox.removeAttribute('aria-live');
    warningsBox.removeAttribute('aria-atomic');

    // Copy plumbing (Copy output, Copy link, Copy as Markdown) — the kit
    // helper: one delegated listener; outcomes announced in #drc-copy-status.
    wireCopyButtons(root, { status: copyStatus });

    // Lazily load the sibling engine + examples + CodeMirror + the kit's plate
    // theme (kept out of the initial path so CM code-splits into its own chunk).
    let engine: EngineModule;
    let examples: Example[] = [];
    let EditorState: typeof import('@codemirror/state').EditorState;
    let EditorViewCtor: typeof import('@codemirror/view').EditorView;
    let keymap: typeof import('@codemirror/view').keymap;
    let lineNumbers: typeof import('@codemirror/view').lineNumbers;
    let highlightActiveLine: typeof import('@codemirror/view').highlightActiveLine;
    let defaultKeymap: typeof import('@codemirror/commands').defaultKeymap;
    let history: typeof import('@codemirror/commands').history;
    let historyKeymap: typeof import('@codemirror/commands').historyKeymap;
    let indentWithTab: typeof import('@codemirror/commands').indentWithTab;
    let yaml: typeof import('@codemirror/lang-yaml').yaml;
    let plate: typeof import('../lib/playground-kit/cm-theme').plate;
    try {
      const [engineMod, examplesMod, stateMod, viewMod, commandsMod, yamlMod, themeMod] =
        await Promise.all([
          import('../lib/docker-run-to-compose/engine'),
          import('../lib/docker-run-to-compose/examples'),
          import('@codemirror/state'),
          import('@codemirror/view'),
          import('@codemirror/commands'),
          import('@codemirror/lang-yaml'),
          import('../lib/playground-kit/cm-theme'),
        ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
      ({ EditorState } = stateMod);
      ({ EditorView: EditorViewCtor, keymap, lineNumbers, highlightActiveLine } = viewMod);
      ({ defaultKeymap, history, historyKeymap, indentWithTab } = commandsMod);
      ({ yaml } = yamlMod);
      ({ plate } = themeMod);
    } catch (err) {
      renderError(outputBox, warningsBox, summaryEl, 'The converter engine failed to load. Reload the page to try again.');
      // eslint-disable-next-line no-console
      console.error('[DockerRunToCompose] engine/examples import failed:', err);
      return;
    }

    let mode: Mode = 'run';
    let lastOutput = '';

    // Live conversion hook, called by the editor's update listener; a no-op
    // until run() exists below, so the seed's own doc writes never fire it.
    let onInputEdit: () => void = () => {};

    /* ---- Editor factory (CM symbols now in async scope) --------------------- */

    // Sizing only — colours, gutters and the focus ring come from the plate
    // theme and the EditorPane rule in global.css.
    const sizing = EditorViewCtor.theme({
      '&': { fontSize: '13px', maxHeight: '420px' },
      '.cm-scroller': { overflow: 'auto' },
    });

    function makeEditor(host: HTMLElement, doc: string): EditorView {
      const state = EditorState.create({
        doc,
        extensions: [
          lineNumbers(),
          history(),
          highlightActiveLine(),
          yaml(),
          plate,
          sizing,
          EditorViewCtor.lineWrapping,
          EditorViewCtor.contentAttributes.of({ 'aria-label': 'Converter input' }),
          keymap.of([
            // Ours FIRST, so it wins over defaultKeymap's Enter.
            {
              key: 'Mod-Enter',
              run: (v) => {
                void run('run');
                if (isCoarsePointer()) v.contentDOM.blur();
                return true;
              },
            },
            { key: 'Escape', run: (v) => { v.contentDOM.blur(); return true; } },
            ...defaultKeymap,
            ...historyKeymap,
            indentWithTab,
          ]),
          EditorViewCtor.updateListener.of((u) => {
            if (u.docChanged) onInputEdit();
          }),
        ],
      });
      return new EditorViewCtor({ state, parent: host });
    }

    function setEditorDoc(view: EditorView, doc: string): void {
      view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: doc } });
      view.requestMeasure();
    }

    const seedExample = examples[0] ?? { id: 'example', label: 'Example', run: '', compose: '' };

    // Seed content: prefer a shared `#s=` URL, else a restored last input,
    // else the first example. No seed path writes the hash or records the
    // input — only user-initiated evaluations do.
    let seedText = seedExample.run;
    let fromShare = false;
    try {
      const decoded = engine.decodeState();
      if (decoded && decoded.text.length > 0) {
        mode = decoded.dir;
        seedText = decoded.text;
        fromShare = true;
      }
    } catch {
      /* malformed hash — fall back to the example seed */
    }

    // Restored last-input tier — only consulted when there's no `#s=` deep
    // link. Validates `dir` against the known directions the same way
    // engine.decodeState() does, and never throws on malformed JSON.
    let fromRestored = false;
    if (!fromShare) {
      const raw = getRestoredLastInput(SLUG);
      if (raw) {
        try {
          const parsed = JSON.parse(raw) as Partial<ShareState>;
          if (
            (parsed.dir === 'run' || parsed.dir === 'compose') &&
            typeof parsed.text === 'string' &&
            parsed.text.length > 0
          ) {
            mode = parsed.dir;
            seedText = parsed.text;
            fromRestored = true;
          }
        } catch {
          /* malformed stored value — ignore, fall back to the example seed */
        }
      }
    }

    const view = makeEditor(editorHost, seedText);
    // The build-time text stand-in has done its job (no-JS visitors and
    // crawlers); CodeMirror appended its editor beside it, so drop it. The
    // share/restore tiers above already resolved, so the seed never wins over
    // a deep link or a remembered input.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());

    // The example chips are server-rendered (ExampleChips); wire them by index.
    // A shared-link or restored input matches no example: no chip pressed.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));
    let selectedIdx = -1;

    /** Press one chip (idx < 0 releases the whole group). */
    function setActiveChip(idx: number): void {
      selectedIdx = idx;
      syncChipsByIndex(chipsWrap, idx < 0 ? null : idx);
    }

    if (examples.length === 0) {
      chips.forEach((chip) => {
        chip.disabled = true;
      });
      setActiveChip(-1);
    } else {
      setActiveChip(fromShare || fromRestored ? -1 : 0);
    }

    /** Seed the editor for the current mode from the selected example. Leaves
     *  the editor untouched while no chip is active (shared/pasted text), so
     *  toggling mode doesn't silently discard it. */
    function seedFromExample(): void {
      if (selectedIdx < 0) return;
      const keep = selectedIdx;
      const ex =
        Number.isInteger(selectedIdx) && selectedIdx < examples.length
          ? examples[selectedIdx]
          : seedExample;
      setEditorDoc(view, mode === 'run' ? ex.run : ex.compose);
      // The doc write released every chip (update listener); press it again.
      setActiveChip(keep);
    }

    /** Update labels + checked styling + roving tabindex for the current mode. */
    function applyModeChrome(): void {
      const isRun = mode === 'run';
      modeRunBtn!.setAttribute('aria-checked', String(isRun));
      modeComposeBtn!.setAttribute('aria-checked', String(!isRun));
      // Roving tabindex: only the checked radio is in the tab order.
      modeRunBtn!.tabIndex = isRun ? 0 : -1;
      modeComposeBtn!.tabIndex = isRun ? -1 : 0;
      setPaneLabel(editorHost!, isRun ? 'docker run' : 'docker-compose.yml');
    }

    function setMode(next: Mode, focus = false): void {
      if (mode === next) {
        if (focus) (next === 'run' ? modeRunBtn! : modeComposeBtn!).focus();
        return;
      }
      mode = next;
      applyModeChrome();
      if (focus) (next === 'run' ? modeRunBtn! : modeComposeBtn!).focus();
      seedFromExample();
      void run('run');
    }

    modeRunBtn.addEventListener('click', () => setMode('run'));
    modeComposeBtn.addEventListener('click', () => setMode('compose'));

    // Radiogroup keyboard support: ArrowLeft/Up ↔ ArrowRight/Down move + select
    // the radio (per the WAI-ARIA radio group pattern); Home/End jump to ends.
    const onModeKeydown = (e: KeyboardEvent): void => {
      switch (e.key) {
        case 'ArrowRight':
        case 'ArrowDown':
        case 'ArrowLeft':
        case 'ArrowUp':
          e.preventDefault();
          setMode(mode === 'run' ? 'compose' : 'run', true);
          break;
        case 'Home':
          e.preventDefault();
          setMode('run', true);
          break;
        case 'End':
          e.preventDefault();
          setMode('compose', true);
          break;
      }
    };
    modeRunBtn.addEventListener('keydown', onModeKeydown);
    modeComposeBtn.addEventListener('keydown', onModeKeydown);

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        setActiveChip(idx);
        seedFromExample();
        void run('run');
      });
    });

    // Copy actions — hidden until there's a valid, non-empty result; cleared
    // on every empty/error path.
    function hideActions(): void {
      for (const btn of [shareBtn!, mdBtn!, copyBtn!]) {
        btn.hidden = true;
        btn.dataset.copy = '';
      }
    }

    /** Populate the copy payloads from the just-produced result. */
    function showActions(input: string, directionLabel: string): void {
      let shareUrl = window.location.href;
      try {
        const hash = engine.encodeState(mode, input);
        if (typeof hash === 'string') {
          const frag = hash.startsWith('#') ? hash : `#${hash}`;
          const base = window.location.href.split('#')[0];
          shareUrl = `${base}${frag}`;
        }
      } catch {
        /* fall back to the current URL */
      }
      shareBtn!.hidden = false;
      shareBtn!.dataset.copy = shareUrl;

      copyBtn!.hidden = false;
      copyBtn!.dataset.copy = lastOutput;

      mdBtn!.hidden = false;
      mdBtn!.dataset.copy = buildMarkdownBlock('Docker Run → Compose Converter', [
        { label: 'Direction', value: directionLabel },
        { label: 'Input', value: input },
        { label: 'Output', value: lastOutput },
      ]);
    }

    /** Write the current state into the `#s=` hash without a history entry. */
    function writeShareHash(): void {
      try {
        const hash = engine.encodeState(mode, view.state.doc.toString());
        if (typeof hash === 'string') {
          const url = hash.startsWith('#') ? hash : `#${hash}`;
          window.history.replaceState(null, '', url);
        }
      } catch {
        /* non-fatal: sharing just won't update */
      }
    }

    /** Clear the `#s=` fragment, leaving the rest of the URL untouched. */
    function clearShareHash(): void {
      try {
        window.history.replaceState(null, '', window.location.pathname + window.location.search);
      } catch {
        /* non-fatal: sharing just won't clear */
      }
    }

    // Convert. `source` gates the `#s=` hash write/clear and the last-input
    // record: the seed (init, decoded share state, restore) never rewrites the
    // page's own URL.
    let timer: number | undefined;
    let running = false;
    let queued: Source | null = null;

    async function run(source: Source): Promise<void> {
      window.clearTimeout(timer);
      if (running) {
        queued = source;
        return;
      }
      running = true;
      const userInitiated = source !== 'seed';
      if (source === 'run') {
        runBtn!.classList.add('is-busy');
        runBtn!.setAttribute('aria-busy', 'true');
        // Yield so the busy state paints before the work runs.
        await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
      }

      try {
        const input = view.state.doc.toString();
        if (input.trim().length === 0) {
          renderEmpty(outputBox!, warningsBox!, summaryEl!);
          lastOutput = '';
          hideActions();
          if (userInitiated) clearShareHash();
          return;
        }
        const res: RunResult | ComposeResult =
          mode === 'run' ? engine.runToCompose(input) : engine.composeToRun(input);
        if (!res.ok || res.error) {
          renderError(
            outputBox!,
            warningsBox!,
            summaryEl!,
            res.error ?? (mode === 'run' ? 'Could not convert the command.' : 'Could not convert the service.'),
          );
          lastOutput = '';
          hideActions();
          if (userInitiated) clearShareHash();
        } else {
          lastOutput = mode === 'run' ? ((res as RunResult).yaml ?? '') : ((res as ComposeResult).command ?? '');
          renderResult(
            outputBox!,
            warningsBox!,
            summaryEl!,
            mode === 'run' ? 'docker-compose.yml' : 'docker run',
            lastOutput,
            res.warnings ?? [],
          );
          showActions(input, mode === 'run' ? 'docker run → Compose' : 'Compose → docker run');
          if (userInitiated) {
            writeShareHash();
            recordToolLastInput(SLUG, JSON.stringify({ dir: mode, text: input }));
          }
        }
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Unexpected error while converting.';
        renderError(outputBox!, warningsBox!, summaryEl!, msg);
        lastOutput = '';
        hideActions();
        if (userInitiated) clearShareHash();
      } finally {
        running = false;
        runBtn!.classList.remove('is-busy');
        runBtn!.removeAttribute('aria-busy');
        if (queued) {
          const next = queued;
          queued = null;
          void run(next);
        }
      }
    }

    function schedule(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => void run('type'), DEBOUNCE_MS);
    }

    runBtn.addEventListener('click', () => void run('run'));

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => JSON.stringify({ dir: mode, text: view.state.doc.toString() }),
      setValue: (value) => {
        let parsed: Partial<ShareState> | null = null;
        try {
          parsed = JSON.parse(value) as Partial<ShareState>;
        } catch {
          return;
        }
        if (!parsed || (parsed.dir !== 'run' && parsed.dir !== 'compose') || typeof parsed.text !== 'string') {
          return;
        }
        mode = parsed.dir;
        applyModeChrome();
        setEditorDoc(view, parsed.text);
        setActiveChip(-1);
        void run('run');
      },
    });

    // Initial chrome + auto-convert the seeded example/shared state. The seed
    // run never rewrites the URL hash or records the input. The output pane is
    // already server-rendered from `examples[0]` in the default run → compose
    // direction, so there is nothing to clear first.
    applyModeChrome();
    void run('seed');
    // Now that run() exists, every subsequent user edit converts live: no
    // example is on screen any more, so the pressed chip is released.
    onInputEdit = () => {
      setActiveChip(-1);
      schedule();
    };
    // Settle CM layout once the pane is laid out.
    requestAnimationFrame(() => view.requestMeasure());
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
