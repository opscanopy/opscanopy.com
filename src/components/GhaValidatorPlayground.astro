---
/**
 * GhaValidatorPlayground — the interactive GitHub Actions Validator island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>
 * that lazily boots ONE CodeMirror 6 editor (YAML), wires the example chips,
 * live validation with a "Run now" control, Copy (the YAML) and Copy link.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * EditorPane (the editor on the plate, its FigureCap and the seeded
 * `<pre data-cm-fallback>`), RunHint and SnapshotBar on paper under it, and
 * ResultPanel (figure cap, live summary, copy status) with CopyButton. The
 * results container stays here, seeded with `set:html` + `data-results`; its
 * slab overrides anchor on `.gha-results`.
 *
 * Runtime contract (imported lazily in the script):
 *   ../lib/gha-validator/engine →
 *     validate(yamlText: string) => ValidateResult
 *       ValidateResult = {
 *         ok: boolean
 *         error?: string
 *         findings: Array<{
 *           id: string
 *           severity: 'error' | 'warning' | 'info'
 *           title: string
 *           detail: string
 *           line?: number
 *           remediation?: string
 *         }>
 *         summary: { errors: number; warnings: number; infos: number }
 *       }
 *   ../lib/gha-validator/examples →
 *     examples: Array<{ id: string; label: string; yaml: string }>
 *
 * All runtime-injected result markup is styled via :global(...) because
 * Astro scoped styles do not reach innerHTML-injected nodes.
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. The chips are
// final markup — hydration only attaches click handlers and moves the pressed
// state — so this adds nothing to the client bundle and cannot drift.
import { examples as prerenderedExamples } from '../lib/gha-validator/examples';
import { validate } from '../lib/gha-validator/engine';
import { resultsHtml, resultSummary, EMPTY_HTML } from '../lib/gha-validator/render';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-validates the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees the real findings for
 * the first workflow instead of "load an example, then validate".
 *
 * `validate` is pure, synchronous and clock-free, so it runs at build time
 * unchanged. The workflow YAML itself goes into a `<pre data-cm-fallback>`
 * inside the CodeMirror host — CM appends its editor to the host, so the
 * script removes the fallback once mounted.
 */
const seedExample = prerenderedExamples[0];
const seedYaml = seedExample?.yaml ?? '';
const seedResult = seedExample ? validate(seedYaml) : null;
// A bundled example that fails to parse would be a bug, not a finding — fall
// back to the shared empty state rather than server-rendering a parse error.
const seedOk = seedResult && seedResult.ok !== false && !seedResult.error ? seedResult : null;
const seedHtml = seedOk ? resultsHtml(seedOk) : EMPTY_HTML;
const seedSummary = seedOk ? resultSummary(seedOk).text : '';
const seedError = Boolean(seedOk && resultSummary(seedOk).tone === 'error');
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="gha" aria-label="GitHub Actions Validator playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: example chips + Run now (paper) ─────────────────────── */}
    <div
      class="flex flex-col gap-3 border-b border-hairline px-4 py-3 sm:flex-row sm:items-end sm:justify-between sm:px-5"
    >
      <div class="flex min-w-0 flex-col gap-2">
        <span class="eyebrow shrink-0">Example</span>
        {/* Chip 0 is the seed; a #gha= share link or a restored input
            releases it (see the script). */}
        <ExampleChips prefix="gha" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
      </div>
      <button
        id="gha-run"
        type="button"
        class="btn-tool gha-tap self-start sm:self-auto"
        title="Run now (⌘/Ctrl + Enter)"
        aria-keyshortcuts="Meta+Enter Control+Enter"
      >
        <svg
          class="gha-run-icon h-4 w-4 shrink-0"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M2.5 8.5l3.5 3.5 7.5-8"></path>
        </svg>
        <span class="gha-run-label">Run now</span>
      </button>
    </div>

    {/* ── Editor on the plate ──────────────────────────────────────────── */}
    <EditorPane prefix="gha" label=".github/workflows/ci.yml">
      <Fragment slot="actions">
        <CopyButton kind="value" id="gha-copy" label="Copy" hidden={false} ariaLabel="Copy workflow YAML" />
      </Fragment>
      <pre class="editor-pane__fallback code-mono gha-fallback" data-cm-fallback>{seedYaml}</pre>
    </EditorPane>

    {/* ── Run hint + snapshots, on paper (never inside the slab) ──────── */}
    <div class="border-b border-hairline px-4 py-3 sm:px-5">
      <RunHint variant="cm" />
      <SnapshotBar prefix="gha" />
    </div>

    {/* ── Results — the L2 instrument under its figure cap ─────────────── */}
    <ResultPanel
      slug="github-actions-validator"
      prefix="gha"
      label="Results"
      summary={seedSummary}
      summaryClass={seedError ? 'whitespace-nowrap text-inverse-error' : 'whitespace-nowrap'}
      split
    >
      <Fragment slot="actions">
        <CopyButton kind="link" id="gha-share" />
      </Fragment>
      {/* NOT a live region: with live eval the whole findings list would be
          re-announced on every keystroke pause. `#gha-summary` (role="status")
          is the sole live region — the playground a11y contract.

          Seeded at build time (see `seedHtml` above) so the findings are in the
          static HTML; the client rebuilds the same markup on boot. */}
      <div id="gha-results" class="gha-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* Tap targets opt into fast-tap + no double-tap-zoom on touch. */
  .gha-tap {
    touch-action: manipulation;
  }

  /* The seeded document a crawler reads (global .editor-pane__fallback sets
     the metrics); boxed to the editor's own min/max height (the script's
     size theme) so the swap on hydration does not move the page. */
  .gha-fallback {
    min-height: 320px;
    max-height: 520px;
    overflow: auto;
  }

  /* The summary is ResultPanel's span (no scope attribute here). A seeded
     error tone must beat the panel's own text-inverse-mute utility. */
  .gha :global(.result-panel__summary.text-inverse-error) {
    color: var(--color-inverse-error);
  }

  /* ── Results container + finding rows (runtime-injected → :global) ─────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.gha-results` container. */
  .gha-results {
    min-height: var(--control-h-lg);
  }
  :global(.gha-group + .gha-group) {
    margin-top: 16px;
  }
  /* Group-heading role: sans 12/16 600, never one more mono caps label. */
  :global(.gha-group__head) {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    color: var(--color-ink);
  }

  :global(.gha-row) {
    display: flex;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    animation: gha-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.gha-row + .gha-row) {
    margin-top: 8px;
  }
  /* Severity ring on the row, drawn only from contract tokens. */
  :global(.gha-row--error) {
    box-shadow: inset 0 0 0 1px var(--color-error-soft);
  }
  :global(.gha-row--warning) {
    box-shadow: inset 0 0 0 1px var(--color-warning-soft);
  }
  @keyframes gha-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.gha-row),
    :global(.gha-error),
    :global(.gha-success) {
      animation: none;
    }
  }

  :global(.gha-row__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.gha-row--error .gha-row__icon) {
    color: var(--color-error);
  }
  :global(.gha-row--warning .gha-row__icon) {
    color: var(--color-warning-deep);
  }
  :global(.gha-row--info .gha-row__icon) {
    color: var(--color-mute);
  }

  :global(.gha-row__body) {
    min-width: 0;
    flex: 1 1 auto;
  }
  :global(.gha-row__head) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  :global(.gha-row__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-word;
  }
  :global(.gha-row__detail) {
    margin-top: 4px;
    font-size: 13px;
    line-height: 19px;
    color: var(--color-body);
    word-break: break-word;
    text-wrap: pretty;
  }

  /* Severity pill — the row-key role (label-field), tones from tokens. */
  :global(.gha-pill) {
    @apply label-field;
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-hairline);
  }
  :global(.gha-pill--error) {
    background: var(--color-error-soft);
    color: var(--color-error-deep);
  }
  :global(.gha-pill--warning) {
    background: var(--color-warning-soft);
    color: var(--color-warning-deep);
  }
  :global(.gha-pill--info) {
    background: var(--color-canvas-soft-2);
    color: var(--color-body);
  }

  /* Line reference chip (monospace). */
  :global(.gha-line) {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    padding: 1px 7px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-soft-2);
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
  }

  /* Remediation block. */
  :global(.gha-fix) {
    display: flex;
    gap: 8px;
    margin-top: 8px;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-soft);
    box-shadow: var(--shadow-hairline);
  }
  :global(.gha-fix__icon) {
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    margin-top: 3px;
    color: var(--color-mute);
  }
  :global(.gha-fix__label) {
    @apply label-field;
  }
  :global(.gha-fix__text) {
    margin-top: 1px;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    word-break: break-word;
    text-wrap: pretty;
  }
  :global(.gha-fix code) {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--color-canvas-soft-2);
    padding: 1px 5px;
    border-radius: var(--radius-xs);
    color: var(--color-ink);
  }

  /* Parse-error banner (result.error). */
  :global(.gha-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
    animation: gha-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.gha-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.gha-error__body) {
    min-width: 0;
  }
  :global(.gha-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.gha-error__detail) {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* Success state — clean "no issues found" frame. */
  :global(.gha-success) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    animation: gha-rise var(--dur-base) var(--ease-brand) both;
  }
  /* 22×22 comes from the SVG's own width/height attributes (render.ts). */
  :global(.gha-success__icon) {
    flex: 0 0 auto;
    color: var(--color-success);
  }
  :global(.gha-success__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--color-ink);
  }
  :global(.gha-success__sub) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-mute);
  }

  /* Empty state — generous, centered frame. */
  :global(.gha-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* Loading dots — animate opacity only. */
  :global(.gha-loading) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-body);
  }
  :global(.gha-loading__dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-mute);
    animation: gha-pulse calc(var(--dur-base) * 6) ease-in-out infinite;
  }
  :global(.gha-loading__dot:nth-child(2)) {
    animation-delay: var(--dur-base);
  }
  :global(.gha-loading__dot:nth-child(3)) {
    animation-delay: calc(var(--dur-base) * 2);
  }
  @keyframes gha-pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.gha-loading__dot) {
      animation: none;
      opacity: 0.6;
    }
  }

  /* Run-button busy state. */
  .is-busy {
    opacity: 0.65;
    pointer-events: none;
    cursor: progress;
  }
  .is-busy .gha-run-icon {
    display: none;
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below uses the slab ink tier; the light rules above
     remain the documented defaults. ──────────────────────────────────── */
  .gha-results :global(.gha-empty) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .gha-results :global(.gha-loading) {
    color: var(--color-inverse-mute);
  }
  .gha-results :global(.gha-loading__dot) {
    background: var(--color-inverse-mute);
  }
  .gha-results :global(.gha-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .gha-results :global(.gha-success) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .gha-results :global(.gha-success__icon) {
    color: var(--color-inverse-brand);
  }
  .gha-results :global(.gha-success__title),
  .gha-results :global(.gha-row__title),
  .gha-results :global(.gha-group__head) {
    color: var(--color-inverse-fg);
  }
  .gha-results :global(.gha-success__sub),
  .gha-results :global(.gha-row__detail),
  .gha-results :global(.gha-fix__text) {
    color: var(--color-inverse-mute);
  }
  .gha-results :global(.gha-group + .gha-group) {
    padding-top: 16px;
    border-top: 1px solid var(--color-inverse-hairline);
  }
  .gha-results :global(.gha-row) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .gha-results :global(.gha-row--error) {
    box-shadow: inset 0 0 0 1px #ff9d9559;
  }
  .gha-results :global(.gha-row--warning) {
    box-shadow: inset 0 0 0 1px #e0a45859;
  }
  .gha-results :global(.gha-row--error .gha-row__icon) {
    color: var(--color-inverse-error);
  }
  .gha-results :global(.gha-row--warning .gha-row__icon) {
    color: var(--color-inverse-accent);
  }
  .gha-results :global(.gha-row--info .gha-row__icon) {
    color: var(--color-inverse-mute);
  }
  .gha-results :global(.gha-pill) {
    box-shadow: none;
  }
  .gha-results :global(.gha-pill--error) {
    background: #ff9d951f;
    color: var(--color-inverse-error);
  }
  .gha-results :global(.gha-pill--warning) {
    background: #e0a4581f;
    color: var(--color-inverse-accent);
  }
  .gha-results :global(.gha-pill--info) {
    background: #ffffff14;
    color: var(--color-inverse-mute);
  }
  .gha-results :global(.gha-line) {
    background: #ffffff14;
    color: var(--color-inverse-mute);
  }
  .gha-results :global(.gha-fix) {
    background: #ffffff08;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .gha-results :global(.gha-fix__icon),
  .gha-results :global(.gha-fix__label) {
    color: var(--color-inverse-mute);
  }
  .gha-results :global(.gha-fix code) {
    background: #ffffff14;
    color: var(--color-inverse-fg);
  }
</style>

<script>
  import type { EditorView } from '@codemirror/view';
  import { base64UrlEncode, base64UrlDecode } from '../lib/codec';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  // The HTML builders are shared with the frontmatter's build-time seed —
  // one implementation, so the no-JS markup and the live markup never drift.
  import { resultsHtml, resultSummary, errorHtml, LOADING_HTML } from '../lib/gha-validator/render';
  import type { ValidateResult } from '../lib/gha-validator/types';

  // CodeMirror (and the kit's plate theme, which imports @codemirror/view) is
  // loaded via dynamic import inside init() so its runtime code-splits into
  // its own chunk instead of shipping in the page's initial JS. The
  // `EditorView` type above is erased at build time and ships no runtime code.

  type EngineModule = {
    validate: (yamlText: string) => ValidateResult | Promise<ValidateResult>;
  };
  type ExampleRaw = Record<string, unknown>;
  type Example = { id: string; label: string; yaml: string };

  const ROOT_SEL = '.gha';
  const SHARE_KEY = 'gha';

  /** Boot every (so far un-hydrated) playground instance on the page. */
  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.ghaWired === 'true') return;
      root.dataset.ghaWired = 'true';
      void init(root);
    });
  }

  /* ---- Small helpers -------------------------------------------------------- */

  function pick(obj: ExampleRaw, keys: string[]): string {
    for (const k of keys) {
      const v = obj[k];
      if (typeof v === 'string' && v.length > 0) return v;
    }
    return '';
  }

  /** Normalise the sibling `examples` array against likely field names. */
  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw.map((item, i) => {
      const o = (item ?? {}) as ExampleRaw;
      return {
        id: pick(o, ['id', 'slug', 'key']) || `example-${i + 1}`,
        label: pick(o, ['label', 'name', 'title']) || `Example ${i + 1}`,
        yaml: pick(o, ['yaml', 'workflow', 'content', 'doc', 'text']),
      };
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  /* ---- Result rendering (DOM writes over the shared pure builders) --------- */

  /** Summary ink on the slab: inverse tier only (never paper text-mute). */
  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderLoading(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = LOADING_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    // No role="alert": `#gha-summary` (role="status") already announces
    // "Parse error", and an assertive alert would interrupt on every debounce.
    setSummary(summary, 'Parse error', true);
    container.innerHTML = errorHtml(message);
  }

  function renderResults(container: HTMLElement, summary: HTMLElement, result: ValidateResult): void {
    const { text, tone } = resultSummary(result);
    setSummary(summary, text, tone === 'error');
    container.innerHTML = resultsHtml(result);
  }

  /* ---- Share-state codec (self-contained; no engine dependency) ------------- */

  function encodeShare(yamlText: string): string {
    return `#${SHARE_KEY}=${base64UrlEncode(yamlText)}`;
  }

  function decodeShare(): string | null {
    const hash = window.location.hash.replace(/^#/, '');
    if (!hash) return null;
    const param = hash
      .split('&')
      .map((p) => p.split('='))
      .find(([k]) => k === SHARE_KEY);
    if (!param || !param[1]) return null;
    try {
      return base64UrlDecode(param[1]);
    } catch {
      return null;
    }
  }

  /* ---- Instance init -------------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const editorHost = el<HTMLElement>(root, '#gha-editor');
    const chipsWrap = el<HTMLElement>(root, '#gha-chips');
    const runBtn = el<HTMLButtonElement>(root, '#gha-run');
    const copyBtn = el<HTMLButtonElement>(root, '#gha-copy');
    const shareBtn = el<HTMLButtonElement>(root, '#gha-share');
    const resultsBox = el<HTMLElement>(root, '#gha-results');
    const summaryEl = el<HTMLElement>(root, '#gha-summary');
    const copyStatus = el<HTMLElement>(root, '#gha-copy-status');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#gha-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#gha-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#gha-snap-delete');

    if (
      !editorHost ||
      !chipsWrap ||
      !runBtn ||
      !copyBtn ||
      !shareBtn ||
      !resultsBox ||
      !summaryEl ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    // Copy (the YAML) and Copy link: the kit's one delegated listener;
    // outcomes are announced in ResultPanel's #gha-copy-status.
    wireCopyButtons(root, { status: copyStatus });

    // Lazily load CodeMirror + the plate theme + the engine + examples (kept
    // out of the initial path so the CM runtime code-splits into its own chunk).
    let engine: EngineModule;
    let examples: Example[] = [];
    let makeEditor: (host: HTMLElement, doc: string) => EditorView;
    let setEditorDoc: (view: EditorView, doc: string) => void;
    try {
      const [
        { EditorState },
        { EditorView, keymap, lineNumbers, highlightActiveLine },
        { defaultKeymap, history, historyKeymap, indentWithTab },
        { yaml },
        { plate },
        engineMod,
        examplesMod,
      ] = await Promise.all([
        import('@codemirror/state'),
        import('@codemirror/view'),
        import('@codemirror/commands'),
        import('@codemirror/lang-yaml'),
        import('../lib/playground-kit/cm-theme'),
        import('../lib/gha-validator/engine'),
        import('../lib/gha-validator/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);

      // Size only (the plate theme owns colour; global.css owns the focus
      // ring): 13px like the seeded fallback, scrolling inside 320–520px.
      const sizeTheme = EditorView.theme({
        '&': { fontSize: '13px', maxHeight: '520px' },
        '.cm-scroller': { overflow: 'auto' },
        '.cm-content, .cm-gutter': { minHeight: '320px' },
      });

      // Editor factory + doc-setter as closures over the freshly imported CM
      // symbols (so no runtime CM reference lives at module top level).
      makeEditor = (host: HTMLElement, doc: string): EditorView => {
        const state = EditorState.create({
          doc,
          extensions: [
            lineNumbers(),
            history(),
            highlightActiveLine(),
            yaml(),
            plate,
            sizeTheme,
            EditorView.lineWrapping,
            EditorView.contentAttributes.of({ 'aria-label': 'GitHub Actions workflow (YAML)' }),
            keymap.of([
              // ⌘/Ctrl+Enter runs now — placed BEFORE defaultKeymap, whose
              // Mod-Enter would otherwise insert a blank line.
              {
                key: 'Mod-Enter',
                run: (v) => {
                  forceRun();
                  if (window.matchMedia?.('(pointer: coarse)').matches) v.contentDOM.blur();
                  return true;
                },
              },
              // Plain Enter: let CodeMirror insert the newline (this is YAML —
              // Enter must never be swallowed), then flush the pending debounce
              // so the panel is current the moment you finish a line.
              {
                key: 'Enter',
                run: () => {
                  window.setTimeout(() => forceRun(), 0);
                  return false; // fall through to the default newline binding
                },
              },
              ...defaultKeymap,
              ...historyKeymap,
              indentWithTab,
              {
                key: 'Escape',
                run: (v) => {
                  v.contentDOM.blur();
                  return true;
                },
              },
            ]),
            // Live eval: re-validate ~180ms after the document settles so the
            // results panel can never silently describe stale YAML.
            EditorView.updateListener.of((u) => {
              if (u.docChanged) scheduleLive();
            }),
          ],
        });
        return new EditorView({ state, parent: host });
      };

      setEditorDoc = (view: EditorView, doc: string): void => {
        view.dispatch({
          changes: { from: 0, to: view.state.doc.length, insert: doc },
        });
      };
    } catch (err) {
      renderError(resultsBox, summaryEl, 'The validator engine failed to load. Reload the page to try again.');
      // eslint-disable-next-line no-console
      console.error('[GhaValidator] engine/examples import failed:', err);
      return;
    }

    // Seed priority: #gha=<base64 yaml> deep link (Copy link) >
    // restored last input > the first example.
    const seedExample = examples[0] ?? { id: 'example', label: 'Example', yaml: '' };
    let seedYaml = seedExample.yaml;
    let fromShare = false;
    let fromRestored = false;
    const shared = decodeShare();
    const restored = getRestoredLastInput('github-actions-validator');
    if (shared) {
      seedYaml = shared;
      fromShare = true;
    } else if (restored) {
      seedYaml = restored;
      fromRestored = true;
    }

    /* ---- Live evaluation ---------------------------------------------------
     * The results panel must never describe YAML that is no longer in the
     * editor. A ~180ms debounced re-validate keeps it honest while typing;
     * `liveReady` gates it so the seed/example dispatches below cannot fire it
     * before the first explicit run has set everything up. `run` / `forceRun` /
     * `scheduleLive` are function declarations, so the CodeMirror extensions
     * built above can close over them safely.                               */
    const LIVE_DEBOUNCE_MS = 180;
    // Calm errors: a half-typed line is not a mistake. A LIVE run that fails to
    // parse holds the previous panel and only reveals the error once the doc has
    // been idle for ~600ms total (180 + 420) — never mid-composition.
    const ERROR_HOLD_MS = 420;
    let liveReady = false;
    let liveTimer: number | undefined;
    let errorHoldTimer: number | undefined;

    function scheduleLive(): void {
      if (!liveReady) return;
      window.clearTimeout(liveTimer);
      window.clearTimeout(errorHoldTimer);
      liveTimer = window.setTimeout(() => void run({ live: true }), LIVE_DEBOUNCE_MS);
    }

    /** Deliberate run (Run now, Enter, ⌘/Ctrl+Enter): cancel the debounce, go now. */
    function forceRun(): void {
      window.clearTimeout(liveTimer);
      window.clearTimeout(errorHoldTimer);
      void run();
    }

    const view = makeEditor(editorHost, seedYaml);
    // The build-time text stand-in has done its job (no-JS visitors and
    // crawlers); CodeMirror appended its editor beside it, so drop it. The
    // share/restore tiers above already resolved, so the seed never wins over
    // a deep link or a remembered input.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());

    // Example chips are server-rendered from the same `examples` module, in the
    // same order, so `data-example-idx` indexes this array directly.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));

    // The editor was seeded from a share link or a restored input, not from an
    // example: NO chip is pressed — the picker claims nothing it cannot back up.
    if (fromShare || fromRestored) syncChipsByIndex(chipsWrap, null);

    // Swap the editor when a different example is chosen, then validate it.
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        syncChipsByIndex(chipsWrap, idx);
        setEditorDoc(view, examples[idx].yaml);
        forceRun();
      });
    });

    // Copy fills its payload at click time: this target-phase listener runs
    // before the kit's delegated one on the root.
    copyBtn.addEventListener('click', () => {
      copyBtn.dataset.copy = view.state.doc.toString();
    });

    /** Copy link appears once a result exists, carrying the current YAML. */
    function setShare(doc: string | null): void {
      if (!shareBtn) return;
      shareBtn.hidden = doc === null;
      shareBtn.dataset.copy = doc === null ? '' : `${window.location.href.split('#')[0]}${encodeShare(doc)}`;
    }

    // Run — non-blocking; show loading, yield a frame, then render.
    // `live: true` marks a debounced keystroke-driven run: no spinner, no
    // loading flash and no history write (Safari rate-limits replaceState), so
    // typing stays smooth while the panel still tracks the editor.
    // `seed: true` marks the one boot-time run over the server-rendered seed:
    // it re-validates so client state is consistent, but the seed is NOT user
    // input — no spinner over the already-painted panel, no hash write and no
    // last-input record.
    type RunOpts = { live?: boolean; showErrors?: boolean; seed?: boolean };
    let running = false;
    let rerun: RunOpts | null = null;
    const runLabel = runBtn.querySelector<HTMLElement>('.gha-run-label');
    let spinner: HTMLElement | null = null;
    async function run(opts: RunOpts = {}): Promise<void> {
      // Guaranteed present by the early return in init(); restated because TypeScript
      // discards that narrowing inside a hoisted function declaration.
      if (!runBtn) return;
      const live = opts.live === true;
      const seeded = opts.seed === true;
      // Both the debounced live run and the boot seed skip the busy chrome.
      const quiet = live || seeded;
      if (running) {
        // Never drop a deliberate run behind an in-flight one: queue it.
        rerun = opts;
        return;
      }
      running = true;

      if (!quiet) {
        runBtn.classList.add('is-busy');
        // Keep focus put for keyboard users: mark busy (not disabled) + swap glyph.
        runBtn.setAttribute('aria-disabled', 'true');
        runBtn.setAttribute('aria-busy', 'true');
        if (!spinner) {
          spinner = document.createElement('span');
          spinner.setAttribute('aria-hidden', 'true');
          // Inline the visual so it never depends on Astro's scoped CSS (runtime node).
          spinner.style.cssText =
            'display:inline-block;width:14px;height:14px;flex:0 0 auto;border-radius:50%;' +
            'border:2px solid currentColor;border-top-color:transparent;';
          if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            spinner.animate([{ transform: 'rotate(0deg)' }, { transform: 'rotate(360deg)' }], {
              duration: 700,
              iterations: Infinity,
            });
          }
          runBtn.insertBefore(spinner, runBtn.firstChild);
        }
        if (runLabel) runLabel.textContent = 'Validating…';
        renderLoading(resultsBox!, summaryEl!);

        // Yield so the loading state paints before (potentially heavy) work runs.
        await new Promise<void>((resolve) => {
          if ('requestAnimationFrame' in window) {
            requestAnimationFrame(() => resolve());
          } else {
            setTimeout(resolve, 0);
          }
        });
      }

      try {
        const doc = view.state.doc.toString();
        const result = await Promise.resolve(engine.validate(doc));
        // The server-rendered seed is not something the visitor typed.
        if (!seeded) recordToolLastInput('github-actions-validator', doc);

        const failed = !result || result.ok === false || Boolean(result.error);
        if (live && failed && opts.showErrors !== true) {
          // Hold the last good panel; reveal the error only after a longer idle.
          window.clearTimeout(errorHoldTimer);
          errorHoldTimer = window.setTimeout(() => void run({ live: true, showErrors: true }), ERROR_HOLD_MS);
        } else {
          renderResults(resultsBox!, summaryEl!, result);
          setShare(failed ? null : doc);
          if (!live && !seeded) {
            // Persist current state into the URL hash without a history entry.
            try {
              window.history.replaceState(null, '', encodeShare(doc));
            } catch {
              /* non-fatal: sharing just won't update */
            }
          }
        }
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Unexpected error while validating.';
        renderError(resultsBox!, summaryEl!, msg);
        setShare(null);
      } finally {
        running = false;
        runBtn.classList.remove('is-busy');
        runBtn.removeAttribute('aria-disabled');
        runBtn.removeAttribute('aria-busy');
        if (spinner) {
          spinner.remove();
          spinner = null;
        }
        if (runLabel) runLabel.textContent = 'Run now';
        if (rerun) {
          const next = rerun;
          rerun = null;
          void run(next);
        }
      }
    }

    runBtn.addEventListener('click', () => forceRun());

    // ⌘/Ctrl+Enter anywhere else in the playground (a chip, Run now) runs too;
    // inside the editor the Mod-Enter binding has already handled it.
    root.addEventListener('keydown', (e) => {
      if (e.defaultPrevented) return;
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        forceRun();
      }
    });

    wireSnapshotUI({
      slug: 'github-actions-validator',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => view.state.doc.toString(),
      setValue: (value) => {
        // A snapshot is the visitor's own workflow, not one of the examples.
        syncChipsByIndex(chipsWrap, null);
        setEditorDoc(view, value);
        forceRun();
      },
    });

    // The results panel is already server-rendered from `examples[0]`, so there
    // is nothing to clear — re-validate whatever the editor ended up holding (a
    // #gha= deep link, a restored input, or that same seed) so the client state
    // matches the markup.
    void run({ seed: true });
    // Only now may keystrokes drive the panel (seed dispatches must not).
    liveReady = true;
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
