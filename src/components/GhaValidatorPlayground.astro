---
/**
 * GhaValidatorPlayground — the interactive GitHub Actions Validator island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>
 * that lazily boots ONE CodeMirror 6 editor (YAML), wires an example picker,
 * a "Validate" action, plus Copy + Share. It runs entirely client-side and is
 * fully usable offline once loaded.
 *
 * Runtime contract (built by a sibling agent — imported lazily in the script):
 *   ../lib/gha-validator/engine →
 *     validate(yamlText: string) => ValidateResult
 *       ValidateResult = {
 *         ok: boolean
 *         error?: string
 *         findings: Array<{
 *           id: string
 *           severity: 'error' | 'warning' | 'info'
 *           title: string
 *           detail: string
 *           line?: number
 *           remediation?: string
 *         }>
 *         summary: { errors: number; warnings: number; infos: number }
 *       }
 *   ../lib/gha-validator/examples →
 *     examples: Array<{ id: string; label: string; yaml: string }>
 *
 * The dark editor surface follows DESIGN.md `code-editor-mockup`; findings use
 * the semantic error / warning tokens and mute/neutral for info. Headlines stay
 * sentence-case, weight 600. All runtime-injected result markup is styled via
 * :global(...) because Astro scoped styles do not reach innerHTML-injected nodes.
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. The chips are
// final markup — hydration only attaches click handlers and moves the active
// state — so this adds nothing to the client bundle and cannot drift.
import { examples as prerenderedExamples } from '../lib/gha-validator/examples';
import { validate } from '../lib/gha-validator/engine';
import { resultsHtml, resultSummary, EMPTY_HTML } from '../lib/gha-validator/render';

/**
 * Server-rendered seed. The client re-validates the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees the real findings for
 * the first workflow instead of "load an example, then validate".
 *
 * `validate` is pure, synchronous and clock-free, so it runs at build time
 * unchanged. The workflow YAML itself goes into a `<pre data-cm-fallback>`
 * inside the CodeMirror host — CM appends its editor to the host, so the
 * script removes the fallback once mounted.
 */
const seedExample = prerenderedExamples[0];
const seedYaml = seedExample?.yaml ?? '';
const seedResult = seedExample ? validate(seedYaml) : null;
// A bundled example that fails to parse would be a bug, not a finding — fall
// back to the shared empty state rather than server-rendering a parse error.
const seedOk = seedResult && seedResult.ok !== false && !seedResult.error ? seedResult : null;
const seedHtml = seedOk ? resultsHtml(seedOk) : EMPTY_HTML;
const seedSummary = seedOk ? resultSummary(seedOk).text : '';
const seedSummaryTone =
  seedOk && resultSummary(seedOk).tone === 'error' ? 'text-error' : 'text-mute';
---

<section class="gha" aria-label="GitHub Actions Validator playground">
  <div class="card shadow-float rounded-lg overflow-hidden">
    {/* ── Toolbar ──────────────────────────────────────────────────────── */}
    <div
      class="flex flex-col gap-3 border-b border-hairline px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-5"
    >
      <div class="flex min-w-0 flex-col gap-2">
        <span class="eyebrow shrink-0">Example</span>
        {/* Server-rendered chips: real buttons in DOM order, so the tab order
            works with no roving tabindex. The group's aria-label names them —
            a chip group has nothing a label can point at. Chip 0 is the seed;
            a #gha= share link or a restored input clears it (see the script). */}
        <div id="gha-chips" class="gha-chips" role="group" aria-label="Examples">
          {prerenderedExamples.map((ex, i) => (
            <button
              type="button"
              class:list={['gha-chip', { 'is-active': i === 0 }]}
              data-example-idx={i}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {ex.label}
            </button>
          ))}
        </div>
      </div>

      <div class="flex shrink-0 flex-wrap items-center gap-2">
        <span class="caption text-mute hidden items-center sm:inline-flex">⌘/Ctrl + Enter</span>
        <button
          id="gha-copy"
          type="button"
          class="btn btn-secondary btn-sm gha-tap"
          data-default-label="Copy"
        >
          <svg
            class="h-4 w-4 shrink-0"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
            <path d="M3.5 10.5h-.5a1.5 1.5 0 0 1-1.5-1.5v-6A1.5 1.5 0 0 1 3 1.5h6A1.5 1.5 0 0 1 10.5 3v.5"></path>
          </svg>
          <span class="gha-copy-label">Copy</span>
        </button>
        <button
          id="gha-share"
          type="button"
          class="btn btn-secondary btn-sm gha-tap"
          data-default-label="Share Link"
          title="This link encodes your full workflow YAML — review before sharing"
        >
          <svg
            class="h-4 w-4 shrink-0"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 8.5l4-1.5M6 8.5l4 1.5"></path>
            <circle cx="4" cy="8" r="1.6"></circle>
            <circle cx="11.5" cy="5" r="1.6"></circle>
            <circle cx="11.5" cy="11" r="1.6"></circle>
          </svg>
          <span class="gha-share-label">Share Link</span>
        </button>
        <button
          id="gha-run"
          type="button"
          class="btn btn-primary btn-sm gha-tap"
          title="Validate (⌘/Ctrl + Enter)"
          aria-keyshortcuts="Meta+Enter Control+Enter"
        >
          <svg
            class="gha-run-icon h-4 w-4 shrink-0"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M2.5 8.5l3.5 3.5 7.5-8"></path>
          </svg>
          <span class="gha-run-label">Validate</span>
        </button>
      </div>
    </div>

    {/* ── Editor (single, full-width, dark mockup surface) ─────────────── */}
    <div class="gha-pane flex min-w-0 flex-col bg-inverse">
      <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2.5">
        <span class="flex shrink-0 items-center gap-1.5" aria-hidden="true">
          <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
        </span>
        <span class="code-mono text-white/45">.github/workflows/ci.yml</span>
      </div>
      <p class="body-sm text-mute mb-2">Runs entirely in your browser — nothing is uploaded.</p>
      <div
        id="gha-editor"
        class="gha-editor min-h-80"
        aria-label="GitHub Actions workflow (YAML)"
      >
        <pre class="gha-cm-fallback code-mono" data-cm-fallback>{seedYaml}</pre>
      </div>
      <p class="text-xs text-mute mt-1">Results update as you type — press Enter to run now.</p>
      <p class="text-xs text-mute mt-1">Tip: press <kbd style="border:1px solid currentColor;border-radius:3px;padding:0 3px;font-size:0.85em">Esc</kbd> to release keyboard focus from the editor.</p>
      <div class="gha-snap-row mt-3 flex flex-wrap items-center gap-2">
        <button id="gha-snap-save" type="button" class="gha-snap-btn">Save snapshot</button>
        <select id="gha-snap-select" class="gha-snap-select" aria-label="Load a saved snapshot" disabled>
          <option value="">No snapshots yet</option>
        </select>
        <button id="gha-snap-delete" type="button" class="gha-snap-delete" aria-label="Delete this snapshot" hidden>&times;</button>
      </div>
    </div>

    {/* ── Results panel ────────────────────────────────────────────────── */}
    <div class="border-t border-hairline bg-canvas-soft px-4 py-4 sm:px-5">
      <div class="mb-3 flex items-center justify-between gap-3">
        <span class="eyebrow">Results</span>
        <span
          id="gha-summary"
          class:list={['gha-summary code-mono', seedSummaryTone]}
          role="status"
          aria-live="polite"
        >{seedSummary}</span>
      </div>

      {/* NOT a live region: with live eval the whole findings list would be
          re-announced on every keystroke pause. `#gha-summary` (role="status")
          is the sole live region — the playground a11y contract.

          Seeded at build time (see `seedHtml` above) so the findings are in the
          static HTML; the client rebuilds the same markup on boot. */}
      <div id="gha-results" class="gha-results" set:html={seedHtml}></div>
    </div>
  </div>

  {/* Polite announcer for clipboard + transient toasts. */}
  <span id="gha-announce" class="sr-only" role="status" aria-live="polite"></span>
</section>

<style>
  @reference "../styles/global.css";

  /* Tap targets opt into fast-tap + no double-tap-zoom on touch. */
  .gha-tap {
    touch-action: manipulation;
  }

  /* Example chips — the playground UX contract's picker (squared, mono, brand
     ink). Ported from SlugifyPlayground.astro; tokens only, no new ones. */
  .gha-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .gha-chip {
    display: inline-flex;
    align-items: center;
    /* Long labels wrap inside the chip instead of pushing the page sideways. */
    max-width: 100%;
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline-muted);
    background: var(--color-canvas);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.01em;
    color: var(--color-brand-strong);
    cursor: pointer;
    touch-action: manipulation;
    transition: background 0.12s ease, border-color 0.12s ease, color 0.12s ease;
  }
  .gha-chip:hover {
    border-color: var(--color-hairline-strong);
    background: var(--color-canvas-hover);
  }
  .gha-chip.is-active {
    background: var(--color-brand-soft);
    border-color: var(--color-brand-strong);
    color: var(--color-brand-strong);
  }
  .gha-chip:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  @media (pointer: coarse) {
    .gha-chip {
      min-height: 44px;
    }
  }

  /* CodeMirror host — fills the dark pane, scrolls internally. */
  .gha-editor {
    overflow: hidden;
  }
  /* Build-time text stand-in for the editor, sized like the CM content so the
     pane does not jump when the script swaps it out. Removed on mount. */
  .gha-cm-fallback {
    margin: 0;
    padding: 14px 16px 16px;
    max-height: 360px;
    overflow: auto;
    color: #e6e6e6;
    font-size: 13px;
    line-height: 20px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .gha-editor :global(.cm-editor) {
    height: 100%;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
  }
  .gha-editor :global(.cm-editor.cm-focused) {
    /* Replace CM's default outline with a brand-blue ring (a11y: keep a ring). */
    outline: 2px solid var(--color-link);
    outline-offset: -2px;
  }
  .gha-editor :global(.cm-scroller) {
    overflow: auto;
    max-height: 520px;
    font-family: var(--font-mono);
    /* Thin, theme-matched scrollbars on the dark surface. */
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
  }
  .gha-editor :global(.cm-scroller)::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }
  .gha-editor :global(.cm-scroller)::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-pill);
    border: 3px solid transparent;
    background-clip: content-box;
  }
  .gha-editor :global(.cm-scroller)::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.28);
    background-clip: content-box;
  }
  .gha-editor :global(.cm-gutters) {
    background: transparent;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }
  .gha-editor :global(.cm-lineNumbers .cm-gutterElement) {
    color: rgba(255, 255, 255, 0.32);
  }
  .gha-editor :global(.cm-content) {
    padding: 14px 0 16px;
  }
  .gha-editor :global(.cm-line) {
    padding-inline: 4px;
  }

  /* Summary — counts use tabular figures so they don't jitter. */
  .gha-summary {
    white-space: nowrap;
  }

  .gha-snap-btn {
    flex: 0 0 auto;
    height: 30px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    border: none;
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-size: 13px;
    cursor: pointer;
    transition: background 0.12s ease, box-shadow 0.12s ease;
  }
  .gha-snap-btn:hover {
    background: var(--color-canvas-soft);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .gha-snap-select {
    height: 30px;
    max-width: 220px;
    padding: 0 8px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-size: 13px;
  }
  .gha-snap-select:disabled {
    color: var(--color-mute);
    cursor: not-allowed;
  }
  .gha-snap-delete {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .gha-snap-delete:hover {
    background: var(--color-error-soft);
    color: var(--color-error-deep);
  }

  /* ── Results container + finding rows (runtime-injected → :global) ───── */
  .gha-results {
    min-height: 44px;
  }
  :global(.gha-group + .gha-group) {
    margin-top: 18px;
  }
  :global(.gha-group__head) {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  :global(.gha-row) {
    display: flex;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    animation: gha-rise 0.18s ease both;
  }
  :global(.gha-row:hover) {
    box-shadow: var(--shadow-subtle);
  }
  :global(.gha-row + .gha-row) {
    margin-top: 8px;
  }
  /* Severity ring on the row, drawn only from contract tokens. */
  :global(.gha-row--error) {
    box-shadow: inset 0 0 0 1px var(--color-error-soft);
  }
  :global(.gha-row--error:hover) {
    box-shadow: inset 0 0 0 1px var(--color-error-soft), var(--shadow-subtle);
  }
  :global(.gha-row--warning) {
    box-shadow: inset 0 0 0 1px var(--color-warning-soft);
  }
  :global(.gha-row--warning:hover) {
    box-shadow: inset 0 0 0 1px var(--color-warning-soft), var(--shadow-subtle);
  }
  @keyframes gha-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.gha-row),
    :global(.gha-error),
    :global(.gha-success) {
      animation: none;
    }
  }

  :global(.gha-row__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.gha-row--error .gha-row__icon) {
    color: var(--color-error);
  }
  :global(.gha-row--warning .gha-row__icon) {
    color: var(--color-warning-deep);
  }
  :global(.gha-row--info .gha-row__icon) {
    color: var(--color-mute);
  }

  :global(.gha-row__body) {
    min-width: 0;
    flex: 1 1 auto;
  }
  :global(.gha-row__head) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  :global(.gha-row__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    word-break: break-word;
  }
  :global(.gha-row__detail) {
    margin-top: 4px;
    font-size: 13px;
    line-height: 19px;
    color: var(--color-body);
    word-break: break-word;
    text-wrap: pretty;
  }

  /* Severity pill — tones drawn ONLY from contract tokens. */
  :global(.gha-pill) {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    box-shadow: var(--shadow-hairline);
  }
  :global(.gha-pill--error) {
    background: var(--color-error-soft);
    color: var(--color-error-deep);
  }
  :global(.gha-pill--warning) {
    background: var(--color-warning-soft);
    color: var(--color-warning-deep);
  }
  :global(.gha-pill--info) {
    background: var(--color-canvas-soft-2);
    color: var(--color-body);
  }

  /* Line reference chip (monospace). */
  :global(.gha-line) {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    padding: 1px 7px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-soft-2);
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
  }

  /* Remediation block. */
  :global(.gha-fix) {
    display: flex;
    gap: 8px;
    margin-top: 8px;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-soft);
    box-shadow: var(--shadow-hairline);
  }
  :global(.gha-fix__icon) {
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    margin-top: 3px;
    color: var(--color-mute);
  }
  :global(.gha-fix__label) {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  :global(.gha-fix__text) {
    margin-top: 1px;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    word-break: break-word;
    text-wrap: pretty;
  }
  :global(.gha-fix code) {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--color-canvas-soft-2);
    padding: 1px 5px;
    border-radius: var(--radius-xs);
    color: var(--color-ink);
  }

  /* Parse-error banner (result.error). */
  :global(.gha-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
    animation: gha-rise 0.18s ease both;
  }
  :global(.gha-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.gha-error__body) {
    min-width: 0;
  }
  :global(.gha-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.gha-error__detail) {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* Success state — clean "no issues found" frame. */
  :global(.gha-success) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 16px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    animation: gha-rise 0.18s ease both;
  }
  :global(.gha-success__icon) {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    color: var(--color-success);
  }
  :global(.gha-success__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--color-ink);
  }
  :global(.gha-success__sub) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-mute);
  }

  /* Empty state — generous, centered frame (ex-empty-state-card scale). */
  :global(.gha-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* Loading dots — animate opacity only; reduced-motion handled globally. */
  :global(.gha-loading) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-body);
  }
  :global(.gha-loading__dot) {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-mute);
    animation: gha-pulse 1.1s ease-in-out infinite;
  }
  :global(.gha-loading__dot:nth-child(2)) {
    animation-delay: 0.18s;
  }
  :global(.gha-loading__dot:nth-child(3)) {
    animation-delay: 0.36s;
  }
  @keyframes gha-pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.gha-loading__dot) {
      animation: none;
      opacity: 0.6;
    }
  }

  /* Run-button busy state. */
  .is-busy {
    opacity: 0.65;
    pointer-events: none;
    cursor: progress;
  }
  .is-busy .gha-run-icon {
    display: none;
  }
</style>

<script>
  import { copyTextToClipboard as copyText } from '../lib/clipboard';
  import type { EditorView } from '@codemirror/view';
  import { base64UrlEncode, base64UrlDecode } from '../lib/codec';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  // The HTML builders are shared with the frontmatter's build-time seed —
  // one implementation, so the no-JS markup and the live markup never drift.
  import {
    resultsHtml,
    resultSummary,
    errorHtml,
    LOADING_HTML,
  } from '../lib/gha-validator/render';
  import type { ValidateResult } from '../lib/gha-validator/types';

  // CodeMirror is loaded via dynamic import inside init() so its ~200KB runtime
  // code-splits into its own chunk instead of shipping in the page's initial JS.
  // The `EditorView` type above is erased at build time and ships no runtime code.

  type EngineModule = {
    validate: (yamlText: string) => ValidateResult | Promise<ValidateResult>;
  };
  type ExampleRaw = Record<string, unknown>;
  type Example = { id: string; label: string; yaml: string };

  const ROOT_SEL = '.gha';
  const COPIED_RESET_MS = 1800;
  const SHARE_KEY = 'gha';

  /** Boot every (so far un-hydrated) playground instance on the page. */
  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.ghaWired === 'true') return;
      root.dataset.ghaWired = 'true';
      void init(root);
    });
  }

  /* ---- Small helpers -------------------------------------------------------- */

  function pick(obj: ExampleRaw, keys: string[]): string {
    for (const k of keys) {
      const v = obj[k];
      if (typeof v === 'string' && v.length > 0) return v;
    }
    return '';
  }

  /** Normalise the sibling `examples` array against likely field names. */
  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw.map((item, i) => {
      const o = (item ?? {}) as ExampleRaw;
      return {
        id: pick(o, ['id', 'slug', 'key']) || `example-${i + 1}`,
        label: pick(o, ['label', 'name', 'title']) || `Example ${i + 1}`,
        yaml: pick(o, ['yaml', 'workflow', 'content', 'doc', 'text']),
      };
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  /* ---- Result rendering (DOM writes over the shared pure builders) --------- */

  function renderLoading(container: HTMLElement, summary: HTMLElement): void {
    summary.textContent = '';
    container.innerHTML = LOADING_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    summary.textContent = 'Parse error';
    summary.classList.add('text-error');
    summary.classList.remove('text-mute');
    // No role="alert": `#gha-summary` (role="status") already announces
    // "Parse error", and an assertive alert would interrupt on every debounce.
    container.innerHTML = errorHtml(message);
  }

  function renderResults(
    container: HTMLElement,
    summary: HTMLElement,
    result: ValidateResult
  ): void {
    const { text, tone } = resultSummary(result);
    summary.textContent = text;
    summary.classList.toggle('text-error', tone === 'error');
    summary.classList.toggle('text-mute', tone !== 'error');
    container.innerHTML = resultsHtml(result);
  }

  /* ---- Clipboard ------------------------------------------------------------ */

  /* ---- Share-state codec (self-contained; no engine dependency) ------------- */

  function encodeShare(yamlText: string): string {
    return `#${SHARE_KEY}=${base64UrlEncode(yamlText)}`;
  }

  function decodeShare(): string | null {
    const hash = window.location.hash.replace(/^#/, '');
    if (!hash) return null;
    const param = hash
      .split('&')
      .map((p) => p.split('='))
      .find(([k]) => k === SHARE_KEY);
    if (!param || !param[1]) return null;
    try {
      return base64UrlDecode(param[1]);
    } catch {
      return null;
    }
  }

  /* ---- Instance init -------------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const editorHost = el<HTMLElement>(root, '#gha-editor');
    const chipsWrap = el<HTMLElement>(root, '#gha-chips');
    const runBtn = el<HTMLButtonElement>(root, '#gha-run');
    const copyBtn = el<HTMLButtonElement>(root, '#gha-copy');
    const shareBtn = el<HTMLButtonElement>(root, '#gha-share');
    const resultsBox = el<HTMLElement>(root, '#gha-results');
    const summaryEl = el<HTMLElement>(root, '#gha-summary');
    const announce = el<HTMLElement>(root, '#gha-announce');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#gha-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#gha-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#gha-snap-delete');

    if (
      !editorHost ||
      !chipsWrap ||
      !runBtn ||
      !copyBtn ||
      !shareBtn ||
      !resultsBox ||
      !summaryEl ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    // Lazily load CodeMirror + the sibling engine + examples (kept out of the
    // initial path so the ~200KB CM runtime code-splits into its own chunk).
    let engine: EngineModule;
    let examples: Example[] = [];
    let makeEditor: (host: HTMLElement, doc: string) => EditorView;
    let setEditorDoc: (view: EditorView, doc: string) => void;
    try {
      const [
        { EditorState },
        { EditorView, keymap, lineNumbers, highlightActiveLine },
        { defaultKeymap, history, historyKeymap, indentWithTab },
        { yaml },
        { oneDark },
        engineMod,
        examplesMod,
      ] = await Promise.all([
        import('@codemirror/state'),
        import('@codemirror/view'),
        import('@codemirror/commands'),
        import('@codemirror/lang-yaml'),
        import('@codemirror/theme-one-dark'),
        import('../lib/gha-validator/engine'),
        import('../lib/gha-validator/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);

      // Editor factory + doc-setter as closures over the freshly imported CM
      // symbols (so no runtime CM reference lives at module top level).
      makeEditor = (host: HTMLElement, doc: string): EditorView => {
        const state = EditorState.create({
          doc,
          extensions: [
            lineNumbers(),
            history(),
            highlightActiveLine(),
            yaml(),
            oneDark,
            EditorView.lineWrapping,
            keymap.of([
              // Plain Enter: let CodeMirror insert the newline (this is YAML —
              // Enter must never be swallowed), then flush the pending debounce
              // so the panel is current the moment you finish a line.
              {
                key: 'Enter',
                run: () => {
                  window.setTimeout(() => forceRun(), 0);
                  return false; // fall through to the default newline binding
                },
              },
              ...defaultKeymap,
              ...historyKeymap,
              indentWithTab,
              { key: 'Escape', run: function (view) { view.contentDOM.blur(); return true; } },
            ]),
            // Live eval: re-validate ~180ms after the document settles so the
            // results panel can never silently describe stale YAML.
            EditorView.updateListener.of((u) => {
              if (u.docChanged) scheduleLive();
            }),
            EditorView.theme({
              '&': { color: '#e6e6e6' },
              '.cm-content': { caretColor: '#e6e6e6' },
              '.cm-cursor, .cm-dropCursor': { borderLeftColor: '#e6e6e6' },
              '&.cm-focused .cm-selectionBackground, .cm-selectionBackground, ::selection':
                { backgroundColor: 'rgba(0, 112, 243, 0.32)' },
              '.cm-activeLine': { backgroundColor: 'rgba(255, 255, 255, 0.035)' },
              '.cm-activeLineGutter': { backgroundColor: 'transparent' },
            }),
          ],
        });
        // The host already carries the aria-label/role for screen readers; CM mounts inside.
        return new EditorView({ state, parent: host });
      };

      setEditorDoc = (view: EditorView, doc: string): void => {
        view.dispatch({
          changes: { from: 0, to: view.state.doc.length, insert: doc },
        });
      };
    } catch (err) {
      renderError(
        resultsBox,
        summaryEl,
        'The validator engine failed to load. Reload the page to try again.'
      );
      // eslint-disable-next-line no-console
      console.error('[GhaValidator] engine/examples import failed:', err);
      return;
    }

    // Seed priority: #gha=<base64 yaml> deep link (Share Link button) >
    // restored last input > the first example.
    const seedExample = examples[0] ?? { id: 'example', label: 'Example', yaml: '' };
    let seedYaml = seedExample.yaml;
    let fromShare = false;
    let fromRestored = false;
    const shared = decodeShare();
    const restored = getRestoredLastInput('github-actions-validator');
    if (shared) {
      seedYaml = shared;
      fromShare = true;
    } else if (restored) {
      seedYaml = restored;
      fromRestored = true;
    }

    /* ---- Live evaluation ---------------------------------------------------
     * The results panel must never describe YAML that is no longer in the
     * editor. A ~180ms debounced re-validate keeps it honest while typing;
     * `liveReady` gates it so the seed/example dispatches below cannot fire it
     * before the first explicit run has set everything up. `run` / `forceRun` /
     * `scheduleLive` are function declarations, so the CodeMirror extensions
     * built above can close over them safely.                               */
    const LIVE_DEBOUNCE_MS = 180;
    // Calm errors: a half-typed line is not a mistake. A LIVE run that fails to
    // parse holds the previous panel and only reveals the error once the doc has
    // been idle for ~600ms total (180 + 420) — never mid-composition.
    const ERROR_HOLD_MS = 420;
    let liveReady = false;
    let liveTimer: number | undefined;
    let errorHoldTimer: number | undefined;

    function scheduleLive(): void {
      if (!liveReady) return;
      window.clearTimeout(liveTimer);
      window.clearTimeout(errorHoldTimer);
      liveTimer = window.setTimeout(() => void run({ live: true }), LIVE_DEBOUNCE_MS);
    }

    /** Deliberate run (button, Enter, ⌘/Ctrl+Enter): cancel the debounce, go now. */
    function forceRun(): void {
      window.clearTimeout(liveTimer);
      window.clearTimeout(errorHoldTimer);
      void run();
    }

    const view = makeEditor(editorHost, seedYaml);
    // The build-time text stand-in has done its job (no-JS visitors and
    // crawlers); CodeMirror appended its editor beside it, so drop it. The
    // share/restore tiers above already resolved, so the seed never wins over
    // a deep link or a remembered input.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());

    // Example chips are server-rendered from the same `examples` module, in the
    // same order, so `data-example-idx` indexes this array directly.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>('.gha-chip'));

    /** Move the pressed/active state; pass null for "none of them". */
    function setActiveChip(active: HTMLButtonElement | null): void {
      chips.forEach((chip) => {
        const on = chip === active;
        chip.classList.toggle('is-active', on);
        chip.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }

    // The editor was seeded from a share link or a restored input, not from an
    // example. The old picker grew a synthetic "Shared workflow" / "Restored
    // workflow" entry to say so; a chip group has no such entry, so instead NO
    // chip is pressed — the picker claims nothing it cannot back up.
    if (fromShare || fromRestored) setActiveChip(null);

    // Swap the editor when a different example is chosen, then validate it.
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        setActiveChip(chip);
        setEditorDoc(view, examples[idx].yaml);
        forceRun();
      });
    });

    // Run — non-blocking; show loading, yield a frame, then render.
    // `live: true` marks a debounced keystroke-driven run: no spinner, no
    // loading flash and no history write (Safari rate-limits replaceState), so
    // typing stays smooth while the panel still tracks the editor.
    // `seed: true` marks the one boot-time run over the server-rendered seed:
    // it re-validates so client state is consistent, but the seed is NOT user
    // input — no spinner over the already-painted panel, no hash write and no
    // last-input record.
    type RunOpts = { live?: boolean; showErrors?: boolean; seed?: boolean };
    let running = false;
    let rerun: RunOpts | null = null;
    const runLabel = runBtn.querySelector<HTMLElement>('.gha-run-label');
    let spinner: HTMLElement | null = null;
    async function run(opts: RunOpts = {}): Promise<void> {
      // Guaranteed present by the early return in boot(); restated because TypeScript
      // discards that narrowing inside a hoisted function declaration.
      if (!runBtn) return;
      const live = opts.live === true;
      const seeded = opts.seed === true;
      // Both the debounced live run and the boot seed skip the busy chrome.
      const quiet = live || seeded;
      if (running) {
        // Never drop a deliberate run behind an in-flight one: queue it.
        rerun = opts;
        return;
      }
      running = true;

      if (!quiet) {
        runBtn.classList.add('is-busy');
        // Keep focus put for keyboard users: mark busy (not disabled) + swap glyph.
        runBtn.setAttribute('aria-disabled', 'true');
        runBtn.setAttribute('aria-busy', 'true');
        if (!spinner) {
          spinner = document.createElement('span');
          spinner.setAttribute('aria-hidden', 'true');
          // Inline the visual so it never depends on Astro's scoped CSS (runtime node).
          spinner.style.cssText =
            'display:inline-block;width:14px;height:14px;flex:0 0 auto;border-radius:9999px;' +
            'border:2px solid currentColor;border-top-color:transparent;';
          if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            spinner.animate(
              [{ transform: 'rotate(0deg)' }, { transform: 'rotate(360deg)' }],
              { duration: 700, iterations: Infinity }
            );
          }
          runBtn.insertBefore(spinner, runBtn.firstChild);
        }
        if (runLabel) runLabel.textContent = 'Validating…';
        renderLoading(resultsBox!, summaryEl!);

        // Yield so the loading state paints before (potentially heavy) work runs.
        await new Promise<void>((resolve) => {
          if ('requestAnimationFrame' in window) {
            requestAnimationFrame(() => resolve());
          } else {
            setTimeout(resolve, 0);
          }
        });
      }

      try {
        const doc = view.state.doc.toString();
        const result = await Promise.resolve(engine.validate(doc));
        // The server-rendered seed is not something the visitor typed.
        if (!seeded) recordToolLastInput('github-actions-validator', doc);

        const failed = !result || result.ok === false || Boolean(result.error);
        if (live && failed && opts.showErrors !== true) {
          // Hold the last good panel; reveal the error only after a longer idle.
          window.clearTimeout(errorHoldTimer);
          errorHoldTimer = window.setTimeout(
            () => void run({ live: true, showErrors: true }),
            ERROR_HOLD_MS
          );
        } else {
          renderResults(resultsBox!, summaryEl!, result);
          if (!live && !seeded) {
            // Persist current state into the URL hash without a history entry.
            try {
              window.history.replaceState(null, '', encodeShare(doc));
            } catch {
              /* non-fatal: sharing just won't update */
            }
          }
        }
      } catch (err) {
        const msg =
          err instanceof Error ? err.message : 'Unexpected error while validating.';
        renderError(resultsBox!, summaryEl!, msg);
      } finally {
        running = false;
        runBtn.classList.remove('is-busy');
        runBtn.removeAttribute('aria-disabled');
        runBtn.removeAttribute('aria-busy');
        if (spinner) {
          spinner.remove();
          spinner = null;
        }
        if (runLabel) runLabel.textContent = 'Validate';
        if (rerun) {
          const next = rerun;
          rerun = null;
          void run(next);
        }
      }
    }

    runBtn.addEventListener('click', () => forceRun());

    // Cmd/Ctrl+Enter from inside the editor triggers a run.
    root.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        forceRun();
      }
    });

    // Copy — copy the workflow YAML to the clipboard.
    const copyLabel = copyBtn.querySelector<HTMLElement>('.gha-copy-label');
    let copyTimer: number | undefined;
    copyBtn.addEventListener('click', async () => {
      const ok = await copyText(view.state.doc.toString());
      if (copyLabel) copyLabel.textContent = ok ? 'Copied' : 'Copy Failed';
      if (announce) {
        announce.textContent = ok
          ? 'Workflow YAML copied to your clipboard.'
          : 'Could not copy. Select the text in the editor and copy it manually.';
      }
      window.clearTimeout(copyTimer);
      copyTimer = window.setTimeout(() => {
        if (copyLabel) copyLabel.textContent = copyBtn.dataset.defaultLabel ?? 'Copy';
      }, COPIED_RESET_MS);
    });

    // Share — copy a shareable URL (current YAML encoded in the hash).
    const shareLabel = shareBtn.querySelector<HTMLElement>('.gha-share-label');
    let shareTimer: number | undefined;
    shareBtn.addEventListener('click', async () => {
      const frag = encodeShare(view.state.doc.toString());
      const base = window.location.href.split('#')[0];
      const shareUrl = `${base}${frag}`;
      try {
        window.history.replaceState(null, '', frag);
      } catch {
        /* fall back to the current URL */
      }
      const ok = await copyText(shareUrl);
      if (shareLabel) shareLabel.textContent = ok ? 'Link Copied' : 'Copy Failed';
      if (announce) {
        announce.textContent = ok
          ? 'Share link copied to your clipboard.'
          : 'Could not copy the link. Copy the URL from your address bar instead.';
      }
      window.clearTimeout(shareTimer);
      shareTimer = window.setTimeout(() => {
        if (shareLabel) shareLabel.textContent = shareBtn.dataset.defaultLabel ?? 'Share Link';
      }, COPIED_RESET_MS);
    });

    wireSnapshotUI({
      slug: 'github-actions-validator',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => view.state.doc.toString(),
      setValue: (value) => {
        // A snapshot is the visitor's own workflow, not one of the examples.
        setActiveChip(null);
        setEditorDoc(view, value);
        forceRun();
      },
    });

    // The results panel is already server-rendered from `examples[0]`, so there
    // is nothing to clear — re-validate whatever the editor ended up holding (a
    // #gha= deep link, a restored input, or that same seed) so the client state
    // matches the markup.
    void run({ seed: true });
    // Only now may keystrokes drive the panel (seed dispatches must not).
    liveReady = true;
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
