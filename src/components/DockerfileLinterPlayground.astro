---
/**
 * DockerfileLinterPlayground — the interactive Dockerfile Linter island.
 *
 * ONE CodeMirror editor (line numbers on — it is a linter, and every finding
 * names a line) plus a grouped findings panel. Each finding row carries three
 * affordances: a line badge that selects and centres that line in the editor, a
 * rule chip that links to the rule's own subsection in the page catalog
 * (`#rule-df007`), and a copy button that yields one plain-text line fit for
 * pasting into a code review.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * EditorPane (the editor slab under its figure cap), RunHint, SnapshotBar,
 * ResultPanel (the L2 instrument: figure cap, the one live summary, copy
 * status) and CopyButton. The results container stays here, seeded with
 * `set:html` + `data-results`; its slab inks anchor on `.df-results`.
 *
 * UX contract (CLAUDE.md): ONE ~160ms debounce, a ~600ms calm-error hold
 * before anything goes red, per-row copy + `data-copy-all` + `data-copy-link`,
 * a results container that is NOT `aria-live`, glossary captions instead of
 * tooltips, and `escapeHtml()` on every injected value — including values
 * that land inside an HTML attribute.
 *
 * Runtime contract (lazy-imported inside the boot closure so the engine, the
 * CodeMirror runtime, the plate theme and the Dockerfile stream mode all
 * code-split away from the page shell):
 *   ../lib/dockerfile-linter/engine   → lint, summaryLine
 *   ../lib/dockerfile-linter/examples → examples: DockerfileExample[]
 *   ../lib/playground-kit/cm-theme    → plate
 *
 * Only the example LABELS are read at build time (so the chips are
 * server-rendered and exist before hydration); the Dockerfiles themselves come
 * from the lazy import by index, which keeps multi-line text out of HTML
 * attributes entirely.
 */
import { examples } from '../lib/dockerfile-linter/examples';
import { lint, summaryLine } from '../lib/dockerfile-linter/engine';
import { resultHtml, EMPTY_HTML } from '../lib/dockerfile-linter/render';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-lints the same example on boot, so this
 * is pure progressive enhancement — but it means a visitor with no JS, and
 * every AI crawler (they do not execute JS), sees the fifteen real,
 * line-numbered findings the kitchen-sink example produces instead of an empty
 * "paste a Dockerfile" panel.
 *
 * `lint` is pure and synchronous and reads no clock, so it runs at build time
 * unchanged. The Dockerfile body goes into a `<pre data-cm-fallback>` inside
 * the CodeMirror host — CM appends its editor to the host, so the script
 * removes the fallback once mounted. The per-row copy payloads are NOT seeded:
 * they are assigned on the live elements after hydration (see `renderResult`).
 */
const seedExample = examples[0];
const seedResult = seedExample ? lint(seedExample.dockerfile) : null;
const seedOk = seedResult && seedResult.ok ? seedResult : null;
const seedText = seedExample?.dockerfile ?? '';
const seedHtml = seedOk ? resultHtml(seedOk) : EMPTY_HTML;
const seedSummary = seedOk ? summaryLine(seedOk) : '';
const seedHasErrors = Boolean(seedOk && seedOk.summary.errors > 0);
const chipItems = examples.map((ex) => ({ label: ex.label }));
---

<section class="df-pg" aria-label="Dockerfile Linter playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Example chips ────────────────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow shrink-0">Examples</span>
      <ExampleChips prefix="df" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
      <p class="df-gloss caption text-mute">
        A <strong class="font-medium text-body">build stage</strong> is one
        <span class="code-mono">FROM</span> and every instruction under it; a multi-stage file has
        several, and only the last one ships. The
        <strong class="font-medium text-body">layer cache</strong> reuses an instruction's result
        until that instruction — or anything it copied — changes.
      </p>
    </div>

    {/* ── Input editor: the plate under its figure cap ─────────────────── */}
    <EditorPane prefix="df" label="Dockerfile" id="df-input">
      <pre class="df-fallback editor-pane__fallback code-mono" data-cm-fallback>{seedText}</pre>
    </EditorPane>

    {/* ── Hints + snapshots (on paper) ─────────────────────────────────── */}
    <div class="border-b border-hairline px-4 pt-3 pb-4 sm:px-5">
      <RunHint variant="cm" id="df-run-hint" />
      <p class="df-hint caption text-mute">
        Tap a <span class="code-mono">Line</span> badge to jump to that line in the editor.
      </p>
      <SnapshotBar prefix="df" />
    </div>

    {/* ── Findings — the L2 instrument; the live summary reads out in the
        figure cap's actions slot. ────────────────────────────────────── */}
    <ResultPanel
      slug="dockerfile-linter"
      prefix="df"
      summary={seedSummary}
      summaryClass={seedHasErrors ? 'text-inverse-error' : undefined}
      label="Findings"
      split
    >
      <Fragment slot="actions">
        <CopyButton kind="link" id="df-share" />
        <CopyButton kind="all" id="df-copy-all" label="Copy report" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the findings are in the
          static HTML; the client replaces them with the same markup on boot and
          binds the per-row copy payloads. */}
      <div id="df-results" class="df-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .df-gloss {
    margin: 0;
    font-size: 12px;
    line-height: 17px;
    text-wrap: pretty;
  }
  .df-hint {
    margin-top: 4px;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .df-hint .code-mono {
    font-size: 12px;
  }

  /* The build-time stand-in for the editor (global .editor-pane__fallback
     matches the CodeMirror metrics), held to the editor's scroller box and
     wrapped like its lineWrapping so the swap does not jump. */
  .df-fallback {
    min-height: 260px;
    max-height: 460px;
    overflow: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  /* Invalid input: a hairline slab-red rule down the editor, never a flash.
     The pane root is EditorPane's (no scope hash), hence :global. */
  .df-pg :global([data-editor-pane][data-invalid] .cm-editor) {
    box-shadow: inset 2px 0 0 0 var(--color-inverse-error);
  }

  .df-results {
    min-height: 120px;
  }
  /* The seeded summary carries the error tone server-side too (the span is
     ResultPanel's, so its base mute class is also present). */
  .df-pg :global(.result-panel__summary.text-inverse-error) {
    color: var(--color-inverse-error);
  }

  /* ── Runtime-injected markup (render.ts) — on the slab, so slab inks only.
     Anchored on this component's own `.df-results` container (the panel
     wrapper is ResultPanel's and carries no scope attribute). ─────────── */
  .df-results :global(.df-group) {
    margin-top: 12px;
    border-radius: var(--radius-md);
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    overflow: hidden;
    animation: df-rise var(--dur-base) var(--ease-brand) both;
  }
  .df-results :global(.df-group:first-child) {
    margin-top: 0;
  }
  /* Group-heading role (a sans heading over its rows, not one more label). */
  .df-results :global(.df-group__head) {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 9px 14px;
    border-bottom: 1px solid var(--color-inverse-hairline);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    color: var(--color-inverse-fg);
  }
  .df-results :global(.df-group__count) {
    margin-left: auto;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--color-inverse-mute);
    white-space: nowrap;
  }
  .df-results :global(.df-row) {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 10px 12px 14px;
  }
  .df-results :global(.df-row + .df-row) {
    border-top: 1px solid #ffffff12;
  }
  .df-results :global(.df-row__body) {
    min-width: 0;
    flex: 1 1 auto;
  }
  .df-results :global(.df-row__head) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  /* Severity: the row-key role (label-field), tinted in slab inks. */
  .df-results :global(.df-pill) {
    @apply label-field;
    flex: 0 0 auto;
    padding: 1px 7px;
    border-radius: var(--radius-xs);
  }
  .df-results :global(.df-pill--error) {
    background: #ff9d951f;
    color: var(--color-inverse-error);
  }
  .df-results :global(.df-pill--warning) {
    background: #e0a4581f;
    color: var(--color-inverse-accent);
  }
  .df-results :global(.df-pill--info) {
    background: #ffffff14;
    color: var(--color-inverse-mute);
  }
  .df-results :global(.df-rule) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    padding: 1px 7px;
    border-radius: var(--radius-xs);
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-brand);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    text-decoration: none;
  }
  .df-results :global(.df-rule:hover) {
    background: #ffffff14;
    text-decoration: underline;
  }
  .df-results :global(.df-jump) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    padding: 1px 7px;
    border: none;
    border-radius: var(--radius-xs);
    background: #ffffff14;
    color: var(--color-inverse-fg);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    cursor: pointer;
    touch-action: manipulation;
  }
  .df-results :global(.df-jump:hover) {
    background: #ffffff24;
  }
  .df-results :global(.df-jump:focus-visible),
  .df-results :global(.df-rule:focus-visible),
  .df-results :global(.df-copy:focus-visible) {
    outline: 2px solid var(--color-inverse-brand);
    outline-offset: 1px;
  }
  .df-results :global(.df-row__title) {
    flex: 1 1 100%;
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-inverse-fg);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  .df-results :global(.df-row__detail) {
    margin: 4px 0 0;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-inverse-mute);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  .df-results :global(.df-fix) {
    display: flex;
    gap: 7px;
    margin-top: 7px;
    padding: 7px 9px;
    border-radius: var(--radius-sm);
    background: #ffffff0a;
    color: var(--color-inverse-fg);
  }
  .df-results :global(.df-fix__label) {
    @apply label-field;
    flex: 0 0 auto;
    line-height: 17px;
    color: var(--color-inverse-accent);
  }
  .df-results :global(.df-fix__text) {
    margin: 0;
    min-width: 0;
    font-size: 13px;
    line-height: 17px;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  .df-results :global(.df-fix__text code) {
    font-family: var(--font-mono);
    font-size: 0.94em;
  }
  .df-results :global(.df-note) {
    margin: 0;
    padding: 9px 14px;
    border-top: 1px solid var(--color-inverse-hairline);
    font-size: 12px;
    line-height: 17px;
    color: var(--color-inverse-mute);
    text-wrap: pretty;
  }
  .df-results :global(.df-clean) {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 14px;
    border-radius: var(--radius-md);
    background: #8fc97a14;
    box-shadow: inset 0 0 0 1px #8fc97a4d;
  }
  .df-results :global(.df-clean__icon) {
    flex: 0 0 auto;
    color: var(--color-inverse-brand);
  }
  .df-results :global(.df-clean__title) {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--color-inverse-fg);
  }
  .df-results :global(.df-clean__sub) {
    margin: 2px 0 0;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-inverse-mute);
    text-wrap: pretty;
  }
  .df-results :global(.df-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .df-results :global(.df-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  .df-results :global(.df-error__title) {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  .df-results :global(.df-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 19px;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .df-results :global(.df-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 96px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }

  /* Per-row copy (render.ts emits the button; playground-kit/copy.ts drives
     it, and marks success with [data-copied]). */
  .df-results :global(.df-copy) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-inverse-mute);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      color var(--dur-fast) var(--ease-brand),
      background-color var(--dur-fast) var(--ease-brand);
  }
  .df-results :global(.df-copy:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .df-results :global(.df-copy[data-copied]) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
  @media (pointer: coarse) {
    .df-results :global(.df-copy) {
      width: var(--control-h-lg);
      height: var(--control-h-lg);
    }
    .df-results :global(.df-jump),
    .df-results :global(.df-rule) {
      min-height: var(--control-h-md);
      padding-inline: 10px;
    }
  }

  @keyframes df-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .df-results :global(.df-group),
    .df-results :global(.df-clean) {
      animation: none;
    }
  }
</style>

<script>
  import { base64UrlDecode, base64UrlEncode } from '../lib/codec';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import type { EditorView } from '@codemirror/view';
  // The HTML builders are shared with the frontmatter's build-time seed —
  // one implementation, so the no-JS markup and the live markup never drift.
  // `import type` is erased at build time, so the engine's types cost nothing.
  import {
    resultHtml,
    errorCardHtml,
    reportText,
    rowText,
    plural,
    EMPTY_HTML,
  } from '../lib/dockerfile-linter/render';
  import type { LintResult } from '../lib/dockerfile-linter/types';

  type EngineModule = {
    lint: (text: string) => LintResult;
    summaryLine: (result: LintResult) => string;
  };
  type Example = { id: string; label: string; dockerfile: string };

  const ROOT_SEL = '.df-pg';
  const SLUG = 'dockerfile-linter';
  /** The deep-link fragment key, matching `GhaValidatorPlayground`'s pattern. */
  const SHARE_KEY = 'df';
  /* One debounce, inside the contract's 130–220ms band. */
  const DEBOUNCE_MS = 160;
  /* Nothing goes red until the typing has been idle this long. */
  const ERROR_HOLD_MS = 600;
  /* Past ~2000 chars a fragment stops being a dependable URL (browser, proxy and
     chat-client limits), so we neither write it nor offer the share link — the
     linter itself keeps working on files of any size. */
  const MAX_HASH_LEN = 2000;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.dfWired === 'true') return;
      root.dataset.dfWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          dockerfile: typeof o.dockerfile === 'string' ? o.dockerfile : '',
        } satisfies Example;
      })
      .filter((e) => e.dockerfile.length > 0);
  }

  /* ---- Share fragment ----------------------------------------------------- */

  function encodeShare(text: string): string {
    return `#${SHARE_KEY}=${base64UrlEncode(text)}`;
  }

  /**
   * Decode a `#df=` fragment. Two accepted forms, in order: the base64url
   * payload `encodeShare` writes, and RAW TEXT (`#df=FROM%20ubuntu`). Accepting
   * the second is deliberate — a fragment is typo- and attacker-controlled
   * input, and the honest degradation for "this is not my payload" is to lint it
   * as pasted text and show a real diagnostic, not to silently drop it and
   * display an example the visitor never asked for.
   */
  function decodeShare(hash: string): string | null {
    const match = /[#&]df=([^&]*)/.exec(hash);
    if (!match || match[1] === '') return null;
    const encoded = match[1];
    try {
      const decoded = base64UrlDecode(encoded);
      // A Dockerfile always contains an instruction keyword; base64 of unrelated
      // text can decode into mojibake, so require something plausible before
      // trusting form 1.
      if (decoded.trim() !== '' && /[\x20-\x7e\r\n\t]{3,}/.test(decoded)) return decoded;
    } catch {
      /* not our payload — fall through to the raw-text form */
    }
    try {
      const raw = decodeURIComponent(encoded);
      return raw.trim() === '' ? null : raw;
    } catch {
      return encoded;
    }
  }

  /* ---- Instance init ----------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const editorHost = el<HTMLElement>(root, '#df-input');
    const paneEl = el<HTMLElement>(root, '[data-editor-pane]');
    const resultsBox = el<HTMLElement>(root, '#df-results');
    const summaryEl = el<HTMLElement>(root, '#df-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#df-share');
    const copyAllBtn = el<HTMLButtonElement>(root, '#df-copy-all');
    const copyStatus = el<HTMLElement>(root, '#df-copy-status');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#df-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#df-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#df-snap-delete');
    const chipsWrap = el<HTMLElement>(root, '#df-chips');
    const chips = Array.from(chipsWrap?.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR) ?? []);

    if (
      !editorHost ||
      !paneEl ||
      !resultsBox ||
      !summaryEl ||
      !shareBtn ||
      !copyAllBtn ||
      !copyStatus ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    /* ---- Copy plumbing (row buttons, Copy link, Copy report) — the kit
       helper: one delegated listener; outcomes announced in #df-copy-status. */

    wireCopyButtons(root, { status: copyStatus });

    root.addEventListener('click', (e) => {
      const jumpBtn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-df-jump]');
      if (jumpBtn && root.contains(jumpBtn)) jumpToLine(Number(jumpBtn.dataset.dfJump));
    });

    /* ---- Lazy engine + examples + CodeMirror ----------------------------- */

    let engine: EngineModule;
    let examples: Example[] = [];
    let EditorState: typeof import('@codemirror/state').EditorState;
    let EditorViewCtor: typeof import('@codemirror/view').EditorView;
    let keymap: typeof import('@codemirror/view').keymap;
    let lineNumbers: typeof import('@codemirror/view').lineNumbers;
    let highlightActiveLine: typeof import('@codemirror/view').highlightActiveLine;
    let defaultKeymap: typeof import('@codemirror/commands').defaultKeymap;
    // Named `cmHistory`, not `history`: a bare `history` would shadow
    // `window.history`, which `writeHash` needs for replaceState.
    let cmHistory: typeof import('@codemirror/commands').history;
    let historyKeymap: typeof import('@codemirror/commands').historyKeymap;
    let indentWithTab: typeof import('@codemirror/commands').indentWithTab;
    let StreamLanguage: typeof import('@codemirror/language').StreamLanguage;
    let dockerFileMode: typeof import('@codemirror/legacy-modes/mode/dockerfile').dockerFile;
    let plate: typeof import('../lib/playground-kit/cm-theme').plate;

    try {
      const [engineMod, examplesMod, stateMod, viewMod, commandsMod, langMod, modeMod, themeMod] =
        await Promise.all([
          import('../lib/dockerfile-linter/engine'),
          import('../lib/dockerfile-linter/examples'),
          import('@codemirror/state'),
          import('@codemirror/view'),
          import('@codemirror/commands'),
          import('@codemirror/language'),
          import('@codemirror/legacy-modes/mode/dockerfile'),
          // The plate theme + highlight (the ONE code palette), in the same
          // closure as the languages — a static import would pull
          // @codemirror/view into the page shell.
          import('../lib/playground-kit/cm-theme'),
        ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
      ({ EditorState } = stateMod);
      ({ EditorView: EditorViewCtor, keymap, lineNumbers, highlightActiveLine } = viewMod);
      ({ history: cmHistory, defaultKeymap, historyKeymap, indentWithTab } = commandsMod);
      ({ StreamLanguage } = langMod);
      ({ dockerFile: dockerFileMode } = modeMod);
      ({ plate } = themeMod);
    } catch (err) {
      summaryEl.textContent = '';
      resultsBox.innerHTML = errorCardHtml(
        'The linter engine failed to load. Reload the page to try again.',
        true,
      );
      console.error('[DockerfileLinter] engine/CodeMirror import failed:', err);
      return;
    }

    /* ---- State ----------------------------------------------------------- */

    type EvalSource = 'type' | 'commit' | 'seed';
    type UiState = 'empty' | 'valid' | 'pending' | 'invalid';

    let uiState: UiState = 'empty';
    let evalTimer: number | undefined;
    let errTimer: number | undefined;
    let lastWrittenHash: string | null = null;
    let liveReady = false;

    function clearTimers(): void {
      window.clearTimeout(evalTimer);
      window.clearTimeout(errTimer);
    }

    /* ---- Editor ---------------------------------------------------------- */

    function makeEditor(host: HTMLElement, doc: string): EditorView {
      const state = EditorState.create({
        doc,
        extensions: [
          lineNumbers(),
          cmHistory(),
          highlightActiveLine(),
          StreamLanguage.define(dockerFileMode),
          plate,
          // This pane's size only; colours, gutter and focus ring are the
          // kit's (cm-theme.ts + global.css .editor-pane__host).
          EditorViewCtor.theme({
            '&': { fontSize: '13px' },
            '.cm-scroller': { minHeight: '260px', maxHeight: '460px', scrollbarWidth: 'thin' },
          }),
          EditorViewCtor.lineWrapping,
          // CodeMirror puts role="textbox" on the content DOM; without a name
          // that is an unlabelled input field for a screen reader (and an axe
          // violation). aria-describedby points at the run hint line.
          EditorViewCtor.contentAttributes.of({
            'aria-label': 'Dockerfile input',
            'aria-describedby': 'df-run-hint',
          }),
          keymap.of([
            // Ours FIRST, so they win over defaultKeymap's Enter/Escape.
            {
              key: 'Mod-Enter',
              run: () => {
                clearTimers();
                evaluate('commit');
                view.contentDOM.blur();
                return true;
              },
            },
            {
              // Plain Enter must still insert the newline, so this returns false
              // and lets insertNewlineAndIndent run — the eval is flushed on the
              // next tick, once the document includes the newline.
              key: 'Enter',
              run: () => {
                window.setTimeout(() => {
                  clearTimers();
                  evaluate('commit');
                }, 0);
                return false;
              },
            },
            {
              // The Tab-trap escape hatch: indentWithTab means Tab indents, so
              // Escape is the documented way out of the editor.
              key: 'Escape',
              run: (v) => {
                v.contentDOM.blur();
                return true;
              },
            },
            ...defaultKeymap,
            ...historyKeymap,
            indentWithTab,
          ]),
          EditorViewCtor.updateListener.of((u) => {
            if (!u.docChanged || !liveReady) return;
            setActiveChip(null);
            clearTimers();
            evalTimer = window.setTimeout(() => evaluate('type'), DEBOUNCE_MS);
          }),
        ],
      });
      return new EditorViewCtor({ state, parent: host });
    }

    function setEditorDoc(doc: string): void {
      view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: doc } });
      view.requestMeasure();
    }

    /** Select and centre a physical line — the line badge's whole purpose. */
    function jumpToLine(lineNumber: number): void {
      if (!Number.isFinite(lineNumber)) return;
      const clamped = Math.min(Math.max(1, Math.trunc(lineNumber)), view.state.doc.lines);
      const line = view.state.doc.line(clamped);
      view.dispatch({
        selection: { anchor: line.from, head: line.to },
        effects: EditorViewCtor.scrollIntoView(line.from, { y: 'center' }),
      });
      view.focus();
    }

    /* ---- Chrome ---------------------------------------------------------- */

    function setSummary(text: string, isError: boolean): void {
      summaryEl!.textContent = text;
      summaryEl!.classList.toggle('text-inverse-error', isError);
      summaryEl!.classList.toggle('text-inverse-mute', !isError);
    }

    function setErrorState(on: boolean): void {
      paneEl!.toggleAttribute('data-invalid', on);
      if (on) {
        view.contentDOM.setAttribute('aria-invalid', 'true');
        view.contentDOM.setAttribute('aria-describedby', 'df-run-hint df-error-detail');
      } else {
        view.contentDOM.removeAttribute('aria-invalid');
        view.contentDOM.setAttribute('aria-describedby', 'df-run-hint');
      }
    }

    function hideActions(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
      copyAllBtn!.hidden = true;
      copyAllBtn!.dataset.copy = '';
    }

    function setActiveChip(idx: number | null): void {
      syncChipsByIndex(chipsWrap, idx);
    }

    /* ---- Deep link ------------------------------------------------------- */

    function writeHash(fragment: string | null): void {
      const target = fragment ?? '';
      if (target === lastWrittenHash) return;
      // Safari throttles replaceState (~100 per 30s) and throws — never let that
      // break typing.
      try {
        if (fragment) {
          window.history.replaceState(null, '', fragment);
        } else {
          window.history.replaceState(null, '', location.pathname + location.search);
        }
        lastWrittenHash = target;
      } catch {
        /* ignore */
      }
    }

    /* ---- Render ---------------------------------------------------------- */

    function renderEmpty(): void {
      uiState = 'empty';
      setErrorState(false);
      hideActions();
      setSummary('', false);
      resultsBox!.innerHTML = EMPTY_HTML;
    }

    function renderResult(result: LintResult, summary: string): void {
      resultsBox!.innerHTML = resultHtml(result);

      // Multi-line and quote-bearing payloads round-trip badly through HTML
      // attributes, so per-row copy text is assigned on the live elements.
      resultsBox!.querySelectorAll<HTMLButtonElement>('[data-df-row]').forEach((btn) => {
        const finding = result.findings[Number(btn.dataset.dfRow)];
        if (finding) btn.dataset.copy = rowText(finding);
      });

      copyAllBtn!.hidden = false;
      copyAllBtn!.dataset.copy = reportText(result, summary);
    }

    function showError(message: string, source: EvalSource): void {
      uiState = 'invalid';
      clearTimers();
      setErrorState(true);
      hideActions();
      setSummary('Could not lint', true);
      resultsBox!.innerHTML = errorCardHtml(message, source === 'commit');
      if (source !== 'seed') writeHash(null);
    }

    function evaluate(source: EvalSource): void {
      clearTimers();
      const text = view.state.doc.toString();
      if (text.trim() === '') {
        renderEmpty();
        if (source !== 'seed') writeHash(null);
        return;
      }

      let result: LintResult | null = null;
      try {
        result = engine.lint(text);
      } catch (err) {
        console.error('[DockerfileLinter] lint threw:', err);
        result = null;
      }

      if (result && result.ok) {
        uiState = 'valid';
        setErrorState(false);
        let summary = '';
        try {
          summary = engine.summaryLine(result);
        } catch {
          summary = plural(result.findings.length, 'finding');
        }
        renderResult(result, summary);
        setSummary(summary, result.summary.errors > 0);

        // Gated on BOTH a fully valid lint AND a user-initiated eval: a boot seed
        // must never write the restore store. NOT gated on the hash length — a
        // Dockerfile too long to share as a URL is exactly the one worth
        // remembering, and `recordToolLastInput` has its own 16 KB cap.
        if (source !== 'seed') recordToolLastInput(SLUG, text);

        const fragment = encodeShare(text);
        if (fragment.length <= MAX_HASH_LEN) {
          shareBtn!.hidden = false;
          shareBtn!.dataset.copy =
            location.origin + location.pathname + location.search + fragment;
          if (source !== 'seed') writeHash(fragment);
        } else {
          // Too long to be a dependable link: keep linting, drop the share.
          shareBtn!.hidden = true;
          shareBtn!.dataset.copy = '';
          if (source !== 'seed') writeHash(null);
        }
        return;
      }

      const message =
        result?.error ?? 'The linter could not read this file. Check it against the rules below.';

      if (source !== 'type') {
        showError(message, source);
        return;
      }

      // Mid-typing: hold the previous panel, nothing goes red yet. The error only
      // surfaces once the typing has been idle for ERROR_HOLD_MS.
      uiState = 'pending';
      setErrorState(false);
      hideActions();
      setSummary('', false);
      errTimer = window.setTimeout(() => showError(message, 'type'), ERROR_HOLD_MS);
    }

    /* ---- Seed (before any listener fires, so nothing writes the hash) ---- */

    const firstExample = examples[0];
    let seedText = firstExample?.dockerfile ?? '';
    let seedChip: number | null = firstExample ? 0 : null;

    const shared = decodeShare(window.location.hash);
    if (shared !== null) {
      seedText = shared;
      seedChip = null;
    } else {
      const restored = getRestoredLastInput(SLUG);
      if (restored && restored.trim() !== '') {
        seedText = restored;
        seedChip = null;
      }
    }

    const view = makeEditor(editorHost, seedText);
    // The build-time text stand-in has done its job (no-JS visitors and
    // crawlers); CodeMirror appended its editor beside it, so drop it. The
    // share-link and restore tiers above already won over the example seed
    // where they applied, so nothing the fallback held is lost.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());
    setActiveChip(seedChip);

    /* ---- Events ---------------------------------------------------------- */

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        liveReady = false;
        setEditorDoc(examples[idx].dockerfile);
        liveReady = true;
        setActiveChip(idx);
        clearTimers();
        evaluate('commit');
      });
    });

    // Committing on blur means a half-typed file that the user tabbed away from
    // still explains itself, instead of sitting silently in `pending`.
    view.contentDOM.addEventListener('blur', () => {
      if (uiState === 'pending') {
        clearTimers();
        evaluate('commit');
      }
    });

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => view.state.doc.toString(),
      setValue: (value) => {
        liveReady = false;
        setEditorDoc(value);
        liveReady = true;
        setActiveChip(null);
        clearTimers();
        evaluate('commit');
      },
    });

    /* ---- First render: never writes the hash ---------------------------- */

    evaluate('seed');
    liveReady = true;
    requestAnimationFrame(() => view.requestMeasure());
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
