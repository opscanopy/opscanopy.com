---
/**
 * HashGeneratorPlayground — the interactive Hash Generator island.
 *
 * Async, live tool: type (or paste) text and every digest — MD5, SHA-1,
 * SHA-256, SHA-512 — is rendered as a copyable lowercase-hex row. An optional
 * HMAC section keys one SHA algorithm with a UTF-8 secret; when a key is
 * present an extra "HMAC-<algo>" row appears. SHA digests come from the Web
 * Crypto API (SubtleCrypto), so evaluation is asynchronous and stale results
 * are discarded via a per-instance request id.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar and ResultPanel (figure cap, live summary, copy
 * status). The results container stays here, seeded with `set:html` +
 * `data-results`; its slab overrides anchor on `.hash-results`. No share link
 * and no Copy all: inputs may be secrets, so each digest copies on its own.
 *
 * Runtime contract (lazy-imported):
 *   ../lib/hash-generator/engine   → async hash(input): Promise<HashResult>
 *                                    async hmac(input, key, algo): Promise<string>
 *   ../lib/hash-generator/examples → examples: { id; label; input }[]
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. The chips are
// never rebuilt at hydration — the script only wires clicks onto them and
// reads `data-example-idx`, so this adds nothing to the client bundle and
// cannot drift from the array the script lazily imports.
import { examples as prerenderedExamples } from '../lib/hash-generator/examples';
import { hash } from '../lib/hash-generator/engine';
import { resultHtml, summaryText, EMPTY_HTML } from '../lib/hash-generator/render';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';

/**
 * Server-rendered seed. The client re-computes the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees the real digests
 * instead of an empty "type something here" panel.
 *
 * `hash` is async (SHA-* come from SubtleCrypto), which Node exposes on
 * `globalThis.crypto.subtle` — so the frontmatter simply awaits it. The seed
 * ladder mirrors the script: a handoff wins over the first example, and a
 * handoff is browser state, so the build always seeds `examples[0]`.
 */
const seedExample = prerenderedExamples[0];
const seedResult = seedExample ? await hash(seedExample.input) : null;
const seedHtml =
  seedResult && seedResult.valid && seedExample ? resultHtml(seedResult, null, seedExample.input) : EMPTY_HTML;
const seedSummary = seedResult && seedResult.valid ? summaryText(seedResult, null) : '';
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="hash-pg" aria-label="Hash Generator playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow shrink-0">Example</span>
      {/* Real <button> chips, server-rendered in DOM order so tab order and
          no-JS legibility come for free. The first is pre-pressed to match
          the boot seed; the script releases it when a handoff wins, or once
          the text is edited by hand. */}
      <ExampleChips prefix="hash" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
    </div>

    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <label class="eyebrow mb-2 block" for="hash-input">Text to hash</label>
      <textarea
        id="hash-input"
        class="hash-input code-mono"
        spellcheck="false"
        autocapitalize="off"
        autocorrect="off"
        autocomplete="off"
        rows="5"
        placeholder="The quick brown fox jumps over the lazy dog"
        aria-describedby="hash-input-hint hash-run-hint">{seedExample?.input}</textarea>
      <p id="hash-input-hint" class="hash-hint caption text-mute">
        Hashed as UTF-8. Line breaks are normalised to LF, so pasted CRLF text hashes
        differently from the same file piped to <span class="code-mono">md5sum</span>. The empty string is valid — its digests are well-known (MD5
        <span class="code-mono">d41d8cd9…</span>).
      </p>
      <RunHint id="hash-run-hint" />
      <SnapshotBar prefix="hash" />
    </div>

    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <label class="eyebrow mb-2 block" for="hash-hmac-key">HMAC key — optional</label>
      <p class="text-xs text-mute">HMAC key never leaves your browser.</p>
      <div class="hash-hmac-row">
        <input
          id="hash-hmac-key"
          type="text"
          class="hash-hmac-input code-mono"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          placeholder="secret key"
          aria-describedby="hash-hmac-hint"
        />
        <div class="hash-select-wrap relative min-w-0">
          <select id="hash-hmac-algo" class="hash-select hash-select--algo code-mono" autocomplete="off" aria-label="HMAC algorithm">
            <option value="SHA-256">SHA-256</option>
            <option value="SHA-1">SHA-1</option>
            <option value="SHA-512">SHA-512</option>
          </select>
          <svg
            class="hash-select-caret pointer-events-none absolute top-1/2 right-3 h-4 w-4 -translate-y-1/2 text-mute"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 6l4 4 4-4"></path>
          </svg>
        </div>
      </div>
      <p id="hash-hmac-hint" class="hash-hint caption text-mute">
        Enter a secret to add a keyed <span class="code-mono">HMAC-&lt;algo&gt;</span> row below. Leave
        blank for plain digests only.
      </p>
    </div>

    {/* ── Digests — the L2 instrument (dark in both themes) under its figure
        cap; the digest count reads out in the cap's actions slot. ─────── */}
    <ResultPanel
      slug="hash-generator"
      prefix="hash"
      summary={seedSummary}
      label="Digests"
      summaryClass="whitespace-nowrap"
      split
    >
      <p class="caption text-inverse-mute mb-3">No share links on this tool — inputs may be secrets.</p>
      {/* Seeded at build time (see `seedHtml` above) so the digests are in the
          static HTML; the client replaces it with the same markup on boot. */}
      <div id="hash-results" class="hash-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* The HMAC algorithm picker — the one remaining <select> on this island. */
  .hash-select {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    height: var(--control-h-md);
    min-width: 0;
    max-width: 320px;
    padding: 0 32px 0 12px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 13px;
    line-height: 20px;
    cursor: pointer;
    text-overflow: ellipsis;
    touch-action: manipulation;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  @media (min-width: 640px) {
    .hash-select {
      width: auto;
      min-width: 260px;
    }
  }
  .hash-select--algo {
    min-width: 0;
    max-width: 130px;
  }
  @media (min-width: 640px) {
    .hash-select--algo {
      min-width: 120px;
    }
  }
  .hash-select:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .hash-select:disabled {
    cursor: not-allowed;
    color: var(--color-mute);
    opacity: 0.7;
  }
  .hash-select-wrap:hover .hash-select-caret {
    color: var(--color-body);
  }

  .hash-input {
    width: 100%;
    min-height: 110px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 14px;
    line-height: 22px;
    resize: vertical;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .hash-input::placeholder {
    color: var(--color-mute);
  }
  .hash-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .hash-input:focus {
    outline: none;
  }
  .hash-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }

  .hash-hmac-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .hash-hmac-input {
    flex: 1 1 200px;
    min-width: 0;
    height: var(--control-h-lg);
    padding: 0 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 14px;
    line-height: 22px;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .hash-hmac-input::placeholder {
    color: var(--color-mute);
  }
  .hash-hmac-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .hash-hmac-input:focus {
    outline: none;
  }
  .hash-hmac-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }

  .hash-hint {
    margin-top: 8px;
    text-wrap: pretty;
  }
  .hash-results {
    min-height: var(--control-h-lg);
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.hash-results` container (the panel
     wrapper is ResultPanel's and carries no scope attribute). */
  :global(.hash-card) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: hash-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.hash-row) {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr) minmax(0, auto);
    gap: 10px 12px;
    padding: 10px 14px;
    align-items: center;
  }
  :global(.hash-row + .hash-row) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.hash-row--hmac) {
    background: var(--color-brand-soft);
  }
  /* Row-key role (label-field): mono 11/16 uppercase, the only label. */
  :global(.hash-row__k) {
    @apply label-field;
    white-space: nowrap;
  }
  :global(.hash-row--hmac .hash-row__k) {
    color: var(--color-brand-strong);
  }
  :global(.hash-row__v) {
    min-width: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-all;
  }
  :global(.hash-row__v.is-mono) {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  /* Per-row labelled copy button (render.ts) — the kit's labelled copy
     recipe: sentence case, sans, never uppercase. */
  :global(.hash-copy) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: var(--control-h-sm);
    padding: 0 9px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    touch-action: manipulation;
    transition:
      box-shadow var(--dur-fast) var(--ease-brand),
      color var(--dur-fast) var(--ease-brand);
  }
  :global(.hash-copy:hover) {
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  :global(.hash-copy:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
  :global(.hash-copy__icon) {
    width: 13px;
    height: 13px;
    flex: 0 0 auto;
  }
  :global(.hash-copy[data-copied]) {
    /* Use the AA-safe brand link colour (emerald-strong on light, bright on dark)
       rather than --color-success, which is too light for label text on white. */
    color: var(--color-link);
  }
  @media (pointer: coarse) {
    :global(.hash-copy) {
      height: var(--control-h-lg);
    }
  }

  @keyframes hash-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.hash-card) {
      animation: none;
    }
  }

  :global(.hash-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.hash-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.hash-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.hash-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.hash-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* Hand-off button ("View as Base64 →") under the digests. render.ts
     emits it as `<button data-handoff-to>` in a `-chips` row; global.css
     lays the row out and draws the LINK form (`a[class$='-chip']`), so the
     button form takes the same slab chip recipe here, keyed on its hook
     rather than its render.ts class. */
  .hash-results :global(button[data-handoff-to]) {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h-sm);
    padding: 4px 12px;
    border: none;
    border-radius: var(--radius-pill);
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-inverse-brand);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      box-shadow var(--dur-fast) var(--ease-brand);
  }
  .hash-results :global(button[data-handoff-to]:hover) {
    background: #ffffff14;
    box-shadow: inset 0 0 0 1px var(--color-inverse-control-edge);
  }
  .hash-results :global(button[data-handoff-to]:focus-visible) {
    outline: 2px solid var(--color-inverse-brand);
    outline-offset: 1px;
  }
  @media (pointer: coarse) {
    .hash-results :global(button[data-handoff-to]) {
      min-height: var(--control-h-lg);
    }
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below it uses the slab ink tier; the light rules
     above remain the documented defaults. ──────────────────────────────── */
  .hash-results :global(.hash-empty) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .hash-results :global(.hash-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .hash-results :global(.hash-card) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .hash-results :global(.hash-row + .hash-row) {
    border-top-color: #ffffff12;
  }
  .hash-results :global(.hash-row--hmac) {
    background: #8fc97a1f;
  }
  .hash-results :global(.hash-row__k) {
    color: var(--color-inverse-mute);
  }
  .hash-results :global(.hash-row--hmac .hash-row__k) {
    color: var(--color-inverse-brand);
  }
  .hash-results :global(.hash-row__v) {
    color: var(--color-inverse-fg);
  }
  .hash-results :global(.hash-copy) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .hash-results :global(.hash-copy:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .hash-results :global(.hash-copy[data-copied]) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
  .hash-results :global(.hash-copy:focus-visible) {
    outline-color: var(--color-inverse-brand);
  }
</style>

<script>
  import { wireRunKeys } from '../lib/run-keys';
  import { writeHandoff, readHandoffOnce } from '../lib/tool-state/handoff';
  import { wireSnapshotUI } from '../lib/tool-state/wire';
  import { copyButtonFor, copyFromButton, COPIED_TEXT, RESET_MS } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  // The HTML builders are shared with the frontmatter's build-time seed —
  // one implementation, so the no-JS markup and the live markup never drift.
  import { resultHtml, summaryText, errorHtml, EMPTY_HTML } from '../lib/hash-generator/render';
  import type { HashRow as Row, HashResult, HmacAlgo } from '../lib/hash-generator/types';

  type Example = { id: string; label: string; input: string };
  type EngineModule = {
    hash: (input: string) => Promise<HashResult>;
    hmac: (input: string, key: string, algo: HmacAlgo) => Promise<string>;
  };

  const ROOT_SEL = '.hash-pg';
  const DEBOUNCE_MS = 180;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.hashWired === 'true') return;
      root.dataset.hashWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw.map((item, i) => {
      const o = (item ?? {}) as Record<string, unknown>;
      return {
        id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
        label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
        input: typeof o.input === 'string' ? o.input : '',
      } satisfies Example;
    });
    // Note: unlike list tools we keep the empty-string example — its digests
    // are well-defined and a useful fixture — so we do NOT filter on length.
  }

  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = EMPTY_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    setSummary(summary, 'Unavailable', true);
    container.innerHTML = errorHtml(message);
  }

  /** Localise the secret-safe handoff chip's target path (the chip itself is built in render.ts). */
  function localePath(p: string): string {
    const m = window.location.pathname.match(/^\/(de|es|fr|pt-br)\//);
    return m ? `/${m[1]}${p}` : p;
  }

  function renderResult(
    container: HTMLElement,
    summary: HTMLElement,
    result: HashResult,
    hmacRow: Row | null,
    rawInput: string
  ): void {
    setSummary(summary, summaryText(result, hmacRow), false);
    container.innerHTML = resultHtml(result, hmacRow, rawInput);
  }

  async function init(root: HTMLElement): Promise<void> {
    const input = el<HTMLTextAreaElement>(root, '#hash-input');
    const keyInput = el<HTMLInputElement>(root, '#hash-hmac-key');
    const algoSel = el<HTMLSelectElement>(root, '#hash-hmac-algo');
    const chipsWrap = el<HTMLElement>(root, '#hash-chips');
    const resultsBox = el<HTMLElement>(root, '#hash-results');
    const summaryEl = el<HTMLElement>(root, '#hash-summary');
    const copyStatus = el<HTMLElement>(root, '#hash-copy-status');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#hash-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#hash-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#hash-snap-delete');
    if (
      !input ||
      !keyInput ||
      !algoSel ||
      !chipsWrap ||
      !resultsBox ||
      !summaryEl ||
      !copyStatus ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    // Copy any digest: the kit's copy cycle (icon / aria-label swap, the
    // `data-copied` state, the #hash-copy-status announcement). render.ts's
    // labelled row button names its label `hash-copy__lbl`, which the kit's
    // label hooks do not match, so the visible "Copy" → "Copied" swap is
    // mirrored here on the same reset clock.
    root.addEventListener('click', (e) => {
      const btn = copyButtonFor(root, e.target);
      if (!btn) return;
      void copyFromButton(btn, { status: copyStatus }).then((ok) => {
        const lbl = btn.querySelector('.hash-copy__lbl');
        if (!ok || !lbl) return;
        lbl.textContent = COPIED_TEXT;
        window.setTimeout(() => {
          lbl.textContent = 'Copy';
        }, RESET_MS);
      });
    });

    let engine: EngineModule;
    let examples: Example[] = [];
    try {
      const [engineMod, examplesMod] = await Promise.all([
        import('../lib/hash-generator/engine'),
        import('../lib/hash-generator/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
    } catch (err) {
      renderError(resultsBox, summaryEl, 'The hash engine failed to load. Reload the page to try again.');
      console.error('[HashGenerator] engine import failed:', err);
      return;
    }

    // The chips are already in the DOM (server-rendered from the same module),
    // so there is nothing to build — only to wire and to mark.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));

    /**
     * Press one chip, or none for -1 — the chip equivalent of the old
     * "Custom input" option: hand-typed text, a restored snapshot, or a
     * handoff from another tool belongs to no example.
     */
    const setActiveChip = (index: number): void => {
      syncChipsByIndex(chipsWrap, index >= 0 ? index : null);
    };

    // Monotonic request id: only the latest async run is allowed to paint, so a
    // slow earlier digest can never overwrite a newer one (stale-result guard).
    let reqId = 0;

    function normaliseAlgo(value: string): HmacAlgo {
      return value === 'SHA-1' || value === 'SHA-512' ? value : 'SHA-256';
    }

    async function evaluate(): Promise<void> {
      const value = input!.value;
      const key = keyInput!.value;
      const algo = normaliseAlgo(algoSel!.value);
      const id = ++reqId;

      // Show a transient "Computing…" cue so the output container never shows
      // a stale result while the async digest is in flight.
      resultsBox!.innerHTML =
        '<p class="hash-empty body-sm text-mute">Computing…</p>';
      summaryEl!.textContent = '';

      let result: HashResult;
      try {
        result = await engine.hash(value);
      } catch {
        if (id !== reqId) return;
        renderError(resultsBox!, summaryEl!, 'Unexpected error while hashing.');
        return;
      }
      if (id !== reqId) return; // a newer request superseded this one
      if (!result || result.valid === false) {
        renderError(resultsBox!, summaryEl!, result?.error ?? 'Could not compute hashes.');
        return;
      }

      let hmacRow: Row | null = null;
      if (key.length > 0) {
        try {
          const hex = await engine.hmac(value, key, algo);
          if (id !== reqId) return; // stale — drop
          hmacRow = { label: `HMAC-${algo}`, value: hex, mono: true };
        } catch {
          if (id !== reqId) return;
          renderError(resultsBox!, summaryEl!, 'Could not compute the HMAC with that key.');
          return;
        }
      }
      if (id !== reqId) return;
      renderResult(resultsBox!, summaryEl!, result, hmacRow, value);
    }

    let timer: number | undefined;
    function scheduleEvaluate(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => void evaluate(), DEBOUNCE_MS);
    }

    input.addEventListener('input', () => {
      setActiveChip(-1);
      scheduleEvaluate();
    });
    keyInput.addEventListener('input', scheduleEvaluate);

    const runNow = (): void => {
      window.clearTimeout(timer);
      void evaluate();
    };
    // The text field is multi-line (hashing "a\nb" is a real case); the HMAC
    // key is a single-line input.
    wireRunKeys(input, runNow, { enter: 'insert-then-run' });
    wireRunKeys(keyInput, runNow);
    algoSel.addEventListener('change', () => {
      window.clearTimeout(timer);
      void evaluate();
    });
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        setActiveChip(idx);
        input.value = examples[idx].input;
        window.clearTimeout(timer);
        void evaluate();
      });
    });

    // Save-snapshot only — this tool is hard-excluded from auto-restore-last-input
    // (its input may be a secret), so there is no getRestoredLastInput() seed here.
    wireSnapshotUI({
      slug: 'hash-generator',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => input!.value,
      setValue: (value) => {
        input!.value = value;
        setActiveChip(-1);
        window.clearTimeout(timer);
        void evaluate();
      },
    });

    // Handoff chip — hand off the raw input (never a #-fragment; it may be a secret).
    resultsBox.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-handoff-to]');
      if (!chip) return;
      const to = chip.dataset.handoffTo;
      if (!to) return;
      writeHandoff(input!.value);
      window.location.href = localePath(to);
    });

    // Seed priority: a secret-safe handoff (e.g. from Base64's "Hash this
    // text" chip) > the first example (the catalog "abc" vector). Empty-
    // string examples are kept, so seed on presence rather than non-empty
    // input. A handoff is a one-time read — it never lingers for a later visit.
    const handoff = readHandoffOnce();
    if (handoff !== null) {
      input.value = handoff;
      setActiveChip(-1);
      void evaluate();
    } else if (examples.length > 0) {
      input.value = examples[0].input;
      setActiveChip(0);
      void evaluate();
    } else {
      setActiveChip(-1);
      renderEmpty(resultsBox, summaryEl);
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
