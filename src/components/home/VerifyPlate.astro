---
/**
 * VerifyPlate — the homepage's "Verify the AI" moment as a working instrument,
 * not a paragraph: a claimed answer beside the computed one, on a slab.
 *
 * Seeded at build time with the pure subnet verify engine, so the HTML already
 * shows a complete claim-vs-computed pair (crawlers and no-JS readers get the
 * real thing). The client re-runs the same engine on input. The seeded claim
 * is a deliberately typical mistake (256 "usable" hosts in a /24) and is
 * labelled an example — it is never attributed to a named model, the same
 * no-fabrication rule as /verify-ai/.
 *
 * Shared across the 5 locale homepages: translated eyebrow / heading / body
 * arrive through slots; everything inside the slab is playground-internal UI
 * and stays English, like every tool. The single "Verify the AI →" link to
 * /verify-ai/ lives here (its anchor text is watched by the SEO guard). That
 * page exists in English only (src/pages/verify-ai.astro, no locale copies),
 * so every locale links the unprefixed /verify-ai/ — the same target the
 * tool pages' verify panels use; a locale prefix here would be a 404. No
 * `fig.` prefix on the cap: a figure number is a tool's registry index, and
 * this plate is a check, not a tool.
 */
import FigureCap from '../FigureCap.astro';
import { verifyClaims, type SubnetClaims } from '../../lib/subnet-calculator/verify';
import { buildIpHash } from '../../lib/ip-hash';
import { site } from '../../data/site';

interface Props {
  /** Localized href of the subnet calculator (deep link target). */
  calculatorHref?: string;
}
const { calculatorHref = '/subnet-calculator/' } = Astro.props;
/** English-only page: never locale-prefixed (see the header comment). */
const verifyHref = '/verify-ai/';

const SEED = {
  cidr: '192.168.1.0/24',
  claims: { broadcast: '192.168.1.255', usableHosts: '256' } satisfies SubnetClaims,
};
const FIELDS = [
  { key: 'broadcast', label: 'Broadcast address' },
  { key: 'usableHosts', label: 'Usable hosts' },
] as const;

const seeded = verifyClaims(SEED.cidr, SEED.claims);
const byField = new Map(seeded.checks.map((c) => [c.field, c]));
// The engine's own one-line summary (the same text the tool page's panel
// announces), so the plate and the tool never disagree about a verdict.
const summary = seeded.summary;
const shareUrl = `${site.url}${calculatorHref}${buildIpHash(SEED.cidr)}`;
---

<section class="section-pad bg-canvas" aria-labelledby="verify-heading">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow"><slot name="eyebrow" /></p>
      <h2 id="verify-heading" class="display-lg mt-3 text-balance text-ink"><slot name="heading" /></h2>
      <p class="body-md mt-3 text-pretty text-body"><slot name="body" /></p>
    </div>

    <div class="vp-plate instrument mt-8" data-verify-plate data-calc-href={calculatorHref}>
      <FigureCap label="verify-ai · subnet-calculator" tone="traffic">
        <span class="vp-status" role="status" data-vp-status>{summary}</span>
      </FigureCap>

      <div class="vp-body">
        <form class="vp-form" data-vp-form novalidate>
          <label class="vp-field">
            <span class="vp-label">CIDR</span>
            <input class="vp-input" type="text" name="cidr" value={SEED.cidr} spellcheck="false" autocomplete="off" autocapitalize="off" data-vp-cidr />
          </label>
          <p class="vp-hint">Example claim — paste the numbers your assistant gave you.</p>
          {
            FIELDS.map((f) => (
              <label class="vp-field">
                <span class="vp-label">claimed {f.label.toLowerCase()}</span>
                <input
                  class="vp-input"
                  type="text"
                  name={f.key}
                  value={SEED.claims[f.key]}
                  spellcheck="false"
                  autocomplete="off"
                  autocapitalize="off"
                  inputmode={f.key === 'usableHosts' ? 'numeric' : 'text'}
                  data-vp-claim={f.key}
                />
              </label>
            ))
          }
        </form>

        <table class="vp-ledger" data-vp-ledger>
          <thead>
            <tr><th scope="col">field</th><th scope="col">claimed</th><th scope="col">computed</th><th scope="col">verdict</th></tr>
          </thead>
          <tbody>
            {
              FIELDS.map((f) => {
                const c = byField.get(f.key);
                return (
                  <tr data-vp-row={f.key}>
                    <th scope="row">{f.label}</th>
                    <td data-label="claimed" data-k={`claimed:${f.key}`} data-vp-claimed>{c?.claimed ?? SEED.claims[f.key]}</td>
                    <td data-label="computed" data-k={`actual:${f.key}`} data-vp-actual>{c?.actual ?? '—'}</td>
                    <td data-label="verdict"><span class="vp-verdict" data-vp-verdict data-verdict={c?.verdict ?? 'unreadable'}>{c?.verdict ?? 'unreadable'}</span></td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>

        <div class="vp-actions">
          <button type="button" class="vp-copy" data-copy-link data-copy={shareUrl} data-vp-share>
            <svg data-copy-icon width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <svg data-check-icon width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="hidden"><path d="M20 6 9 17l-5-5"/></svg>
            <span data-copy-text>Copy link</span>
          </button>
          <span class="sr-only" role="status" data-copy-status></span>
          <a href={verifyHref} class="vp-more">Verify the AI &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Chrome (slab fill, edge, float, radius) comes from `.instrument`. */
  .vp-status {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-inverse-mute);
    white-space: nowrap;
  }
  /* An engine diagnostic ("Octet 256 is greater than 255.") can be longer
     than a summary: let it wrap instead of pushing the cap wider. */
  .vp-status[data-error] {
    color: var(--color-inverse-error);
    white-space: normal;
    text-align: right;
  }
  .vp-body {
    padding: 18px;
    display: grid;
    gap: 18px;
  }
  @media (min-width: 768px) {
    .vp-body {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
      grid-template-areas: 'form ledger' 'actions actions';
      column-gap: 32px;
      padding: 22px 24px;
    }
    .vp-form { grid-area: form; }
    .vp-ledger { grid-area: ledger; }
    .vp-actions { grid-area: actions; }
  }
  .vp-form { display: flex; flex-direction: column; gap: 10px; }
  .vp-field { display: flex; flex-direction: column; gap: 4px; }
  .vp-label {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-inverse-mute);
  }
  .vp-input {
    min-width: 0;
    background: color-mix(in srgb, #000 20%, transparent);
    border: 1px solid var(--color-inverse-hairline);
    border-radius: var(--radius-sm);
    color: var(--color-inverse-fg);
    font-family: var(--font-mono);
    font-size: 14px;
    padding: 8px 10px;
  }
  .vp-input:focus-visible {
    outline: 2px solid var(--color-inverse-brand);
    outline-offset: 1px;
    border-color: transparent;
  }
  .vp-hint {
    margin: 2px 0 0;
    font-size: 12px;
    line-height: 16px;
    color: var(--color-inverse-mute);
  }
  .vp-ledger {
    /* A table stretched by the grid row spreads the extra height across its
       rows, leaving each verdict floating in a tall empty cell. */
    align-self: start;
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
  }
  .vp-ledger th,
  .vp-ledger td {
    padding: 8px 6px;
    border-bottom: 1px solid var(--color-inverse-hairline);
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
  }
  .vp-ledger thead th {
    font-size: 11px;
    line-height: 16px;
    font-weight: 400;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-inverse-mute);
  }
  .vp-ledger tbody th {
    font-weight: 400;
    color: var(--color-inverse-mute);
  }
  .vp-ledger td[data-vp-actual] { color: var(--color-inverse-brand); }
  .vp-ledger td[data-vp-claimed] { color: var(--color-inverse-fg); }
  .vp-verdict {
    display: inline-block;
    padding: 1px 7px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-inverse-hairline);
    font-size: 11px;
    line-height: 18px;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-inverse-mute);
    /* The cell allows breaks anywhere (long IPv6 values); a verdict word must
       never split ("MISMA / TCH" at 390px). */
    white-space: nowrap;
    overflow-wrap: normal;
  }
  .vp-verdict[data-verdict='none'] { color: var(--color-inverse-mute); }
  /* Phones: four columns cannot hold an IPv4 address on one line ("192.168.1."
     / "255" at 390px). Each row becomes a small card — the field name on top,
     then claimed / computed / verdict as label-value lines (labels from the
     cells' data-label; the column header row is kept for screen readers). */
  @media (max-width: 479px) {
    .vp-body { padding: 14px; }
    .vp-ledger,
    .vp-ledger tbody,
    .vp-ledger tr,
    .vp-ledger th,
    .vp-ledger td { display: block; }
    .vp-ledger thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .vp-ledger tbody tr {
      padding: 10px 0;
      border-bottom: 1px solid var(--color-inverse-hairline);
    }
    .vp-ledger tbody th,
    .vp-ledger td {
      padding: 0;
      border-bottom: 0;
    }
    .vp-ledger tbody th {
      padding-bottom: 4px;
      font-size: 11px;
      line-height: 16px;
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }
    .vp-ledger td {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
      padding: 2px 0;
      text-align: right;
    }
    .vp-ledger td::before {
      content: attr(data-label);
      flex: none;
      font-size: 11px;
      color: var(--color-inverse-mute);
      text-align: left;
    }
  }
  .vp-verdict[data-verdict='match'] { color: var(--color-inverse-brand); border-color: color-mix(in srgb, var(--color-inverse-brand) 50%, transparent); }
  .vp-verdict[data-verdict='mismatch'] { color: var(--color-inverse-error); border-color: color-mix(in srgb, var(--color-inverse-error) 50%, transparent); }
  .vp-verdict[data-verdict='unreadable'] { color: var(--color-inverse-accent); border-color: color-mix(in srgb, var(--color-inverse-accent) 50%, transparent); }
  .vp-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    padding-top: 4px;
  }
  .vp-copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-inverse-mute);
    background: color-mix(in srgb, var(--color-inverse-fg) 5%, transparent);
    border: 1px solid var(--color-inverse-hairline);
    border-radius: var(--radius-sm);
    padding: 5px 10px;
    cursor: pointer;
  }
  .vp-copy:hover { color: var(--color-inverse-fg); border-color: var(--color-inverse-control-edge); }
  .vp-copy[data-copied] { color: var(--color-inverse-brand); }
  .vp-more {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-inverse-brand);
    text-decoration: none;
  }
  .vp-more:hover { text-decoration: underline; }
  [data-copy-status][data-failed] {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    clip: auto;
    overflow: visible;
    white-space: normal;
    font-size: 12px;
    color: var(--color-inverse-error);
  }
</style>

<script>
  import { snapshotValues, markChanged } from '../../lib/mark-changed';
  import { wireCopyButtons } from '../../lib/playground-kit/copy';
  import { buildIpHash } from '../../lib/ip-hash';
  import { wireRunKeys } from '../../lib/run-keys';

  import type { ClaimVerdict as Verdict, VerifyResult } from '../../lib/verify-shared';
  type Engine = { verifyClaims: (cidr: string, claims: Record<string, string>) => VerifyResult };

  function boot(): void {
    const root = document.querySelector<HTMLElement>('[data-verify-plate]');
    if (!root || root.dataset.booted) return;
    root.dataset.booted = '1';

    const cidr = root.querySelector<HTMLInputElement>('[data-vp-cidr]');
    const claims = Array.from(root.querySelectorAll<HTMLInputElement>('[data-vp-claim]'));
    const ledger = root.querySelector<HTMLElement>('[data-vp-ledger]');
    const status = root.querySelector<HTMLElement>('[data-vp-status]');
    const share = root.querySelector<HTMLElement>('[data-vp-share]');
    const form = root.querySelector<HTMLFormElement>('[data-vp-form]');
    if (!cidr || !ledger) return;

    wireCopyButtons(root, { status: root.querySelector<HTMLElement>('[data-copy-status]') });
    let timer: number | undefined;
    // Enter forces an immediate eval (and shows a held diagnostic at once).
    const runNow = (): void => { window.clearTimeout(timer); void run(true); };
    form?.addEventListener('submit', (e) => { e.preventDefault(); runNow(); });
    wireRunKeys(cidr, runNow);
    claims.forEach((el) => wireRunKeys(el, runNow));

    let engine: Promise<Engine> | null = null;
    const load = () => (engine ??= import('../../lib/subnet-calculator/verify') as Promise<Engine>);

    // Calm errors (playground contract): a CIDR diagnostic is held until the
    // reader pauses (~600ms idle), blurs the field, or presses Enter — never
    // flashed mid-keystroke. A pending diagnostic is dropped once the input
    // parses again.
    let pendingError = '';
    let errorTimer: number | undefined;
    const showStatus = (text: string, isError: boolean): void => {
      if (!status) return;
      status.textContent = text;
      if (isError) status.dataset.error = '';
      else delete status.dataset.error;
    };
    const flushError = (): void => {
      window.clearTimeout(errorTimer);
      if (pendingError) showStatus(pendingError, true);
    };

    async function run(immediate = false): Promise<void> {
      const mod = await load();
      const input: Record<string, string> = {};
      const empty: Record<string, string> = {};
      for (const el of claims) {
        const key = el.dataset.vpClaim ?? '';
        if (el.value.trim()) input[key] = el.value.trim();
        // An empty claim still has a computable answer: probe the engine with
        // an unreadable placeholder and keep only its `actual`.
        else empty[key] = '?';
      }
      const result = mod.verifyClaims(cidr!.value, input);
      const probe = result.valid && Object.keys(empty).length ? mod.verifyClaims(cidr!.value, empty) : null;
      const byField = new Map(result.checks.map((c) => [c.field, c]));
      const computed = new Map(probe?.checks.map((c) => [c.field, c.actual]) ?? []);
      const prev = snapshotValues(ledger!);
      for (const el of claims) {
        const key = el.dataset.vpClaim ?? '';
        const row = ledger!.querySelector<HTMLElement>(`[data-vp-row="${key}"]`);
        if (!row) continue;
        const c = byField.get(key);
        const claimed = row.querySelector<HTMLElement>('[data-vp-claimed]');
        const actual = row.querySelector<HTMLElement>('[data-vp-actual]');
        const verdict = row.querySelector<HTMLElement>('[data-vp-verdict]');
        if (claimed) claimed.textContent = c?.claimed ?? (el.value.trim() || '—');
        if (actual) actual.textContent = c?.actual ?? computed.get(key) ?? '—';
        if (verdict) {
          // No verdict without both sides: an invalid CIDR or an empty claim
          // shows a neutral dash, not "unreadable" (that word means the claim
          // itself could not be parsed).
          const v: Verdict | 'none' = c?.verdict ?? 'none';
          verdict.textContent = v === 'none' ? '—' : v;
          verdict.dataset.verdict = v;
        }
      }
      markChanged(ledger!, prev);

      window.clearTimeout(errorTimer);
      if (result.valid) {
        pendingError = '';
        showStatus(result.summary, false);
      } else {
        pendingError = result.error ?? 'That CIDR could not be read.';
        if (immediate) flushError();
        else {
          // Keep the cap quiet while the reader is mid-edit.
          showStatus('', false);
          errorTimer = window.setTimeout(flushError, 420);
        }
      }
      if (share) {
        // Share only a link that works: hidden until the CIDR parses.
        share.hidden = !result.valid;
        if (result.valid) {
          share.dataset.copy = `${location.origin}${root!.dataset.calcHref ?? '/subnet-calculator/'}${buildIpHash(cidr!.value.trim())}`;
        }
      }
    }

    const schedule =() => { window.clearTimeout(timer); timer = window.setTimeout(() => run(), 180); };
    cidr.addEventListener('input', schedule);
    cidr.addEventListener('blur', flushError);
    claims.forEach((el) => el.addEventListener('input', schedule));
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
