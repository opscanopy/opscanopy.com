---
/**
 * HomeDoors — the hero's "what can I do here" row: the three things the site
 * is for (use a tool, learn DevOps, practise for a certification), each one
 * line. Replaces the old single-CTA row, which only ever described the tools
 * third of the site. Translated door copy + hrefs arrive as props (hrefs
 * already localized by the page, English-only sections unprefixed); the
 * layout lives here once, like ProofStrip.
 */
interface Door {
  href: string;
  title: string;
  body: string;
}
interface Props {
  doors: Door[];
  ariaLabel: string;
}
const { doors, ariaLabel } = Astro.props;
---

<nav aria-label={ariaLabel} class="mt-8">
  <ul role="list" class="grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-4">
    {
      doors.map((d) => (
        <li class="min-w-0">
          <a href={d.href} class="hd-door card group flex h-full min-w-0 flex-col gap-1 p-5">
            <span class="hd-door__title inline-flex items-center gap-1 text-ink transition-colors group-hover:text-link">
              {d.title}
              <span
                aria-hidden="true"
                class="transition-transform duration-150 ease-out group-hover:translate-x-0.5"
              >
                &rarr;
              </span>
            </span>
            <span class="body-sm text-pretty text-mute">{d.body}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* Printed card, no lift (2026-10 editorial pass): hover draws the edge in ink.
     The serif title replaced the amber 01/02/03 counters, which numbered three
     equal choices for no reason. */
  .hd-door {
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .hd-door:hover {
    box-shadow: inset 0 0 0 1px var(--color-ink), 0 1px 0 0 var(--color-hairline-strong);
  }
  .hd-door__title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: 20px;
    font-weight: 580;
    line-height: 28px;
    letter-spacing: -0.005em;
  }
  @media (prefers-reduced-motion: reduce) {
    .hd-door {
      transition: none;
    }
  }
</style>
