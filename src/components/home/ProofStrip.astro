---
/**
 * ProofStrip — the homepage proof ledger: the evidence for the hero's "exact"
 * claim, set as an instrument plate (dark in both themes) with a mono ledger
 * instead of a row of cards. Shared across the 5 locale homepages: the
 * translated `principles` (label / title / body) and the section aria-label
 * arrive as props, the layout lives here once. Counts inside `principles` are
 * derived at build by the page (conformance corpus length, the jq pin), never
 * typed, so the ledger cannot drift from the code it describes.
 *
 * No `fig.` prefix on the cap: a figure number is always a tool's registry
 * index, and this plate is not a tool.
 */
import FigureCap from '../FigureCap.astro';

interface Principle {
  label: string;
  title: string;
  body: string;
  icon?: string;
}
interface Props {
  principles: Principle[];
  ariaLabel: string;
  /** Visible heading above the plate (the hero's evidence strip). */
  heading?: string;
  /** Mono caption in the plate's figure cap. */
  capLabel?: string;
}
const { principles, ariaLabel, heading, capLabel = 'proof ledger · how we know' } = Astro.props;
---

<section class="section-pad-sm bg-canvas" aria-label={ariaLabel}>
  <div class="container-page">
    {heading && <h2 class="display-sm mb-6 text-balance text-ink">{heading}</h2>}
    <div class="proof-plate instrument">
      <FigureCap label={capLabel} tone="traffic" />
      <ol class="proof-ledger" role="list">
        {
          principles.map((p, i) => (
            <li class="proof-row">
              <span class="proof-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="proof-key">{p.label}</span>
              <span class="proof-val">
                <span class="proof-title">{p.title}</span>
                <span class="proof-body">{p.body}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* Chrome (slab fill, edge, float, radius) comes from `.instrument`. */
  .proof-ledger {
    margin: 0;
    padding: 4px 0 6px;
    list-style: none;
  }
  .proof-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(7rem, 11rem) minmax(0, 1fr);
    column-gap: 16px;
    align-items: baseline;
    padding: 12px 18px;
    border-bottom: 1px solid var(--color-inverse-hairline);
  }
  .proof-row:last-child {
    border-bottom: 0;
  }
  .proof-idx {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 20px;
    color: var(--color-inverse-accent);
  }
  .proof-key {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 20px;
    letter-spacing: var(--tracking-label, 0.06em);
    text-transform: uppercase;
    color: var(--color-inverse-mute);
  }
  .proof-val {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .proof-title {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    color: var(--color-inverse-brand);
  }
  .proof-body {
    font-size: 14px;
    line-height: 20px;
    color: var(--color-inverse-mute);
    text-wrap: pretty;
  }
  @media (max-width: 639px) {
    .proof-row {
      grid-template-columns: 2rem minmax(0, 1fr);
      row-gap: 2px;
    }
    .proof-val {
      grid-column: 2;
    }
  }
</style>
