---
/**
 * TwoDoorClose — the homepage's closing band: one heading, one line, two
 * doors (use a tool / start learning), on the rail like every other section
 * (no centred block — the 2026-09 close was the homepage's last `text-center`
 * child of `.container-page`). The first door is always `<a href="/tools/">`
 * (localized), the catalog's primary inbound link from the homepage.
 */
import Button from '../Button.astro';

interface Door {
  href: string;
  label: string;
  variant: 'primary' | 'secondary';
}
interface Props {
  doors: [Door, Door];
}
const { doors } = Astro.props;
---

<section class="section-pad bg-canvas" aria-labelledby="closing-cta">
  <div class="container-page">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
      <div class="max-w-3xl">
        <h2 id="closing-cta" class="display-xl text-balance text-ink"><slot name="heading" /></h2>
        <p class="body-lg mt-4 max-w-xl text-pretty text-body"><slot name="body" /></p>
      </div>
      <div class="flex flex-wrap items-center gap-3 lg:shrink-0">
        {doors.map((d) => <Button href={d.href} variant={d.variant}>{d.label}</Button>)}
      </div>
    </div>
  </div>
</section>
