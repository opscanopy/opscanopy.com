---
/**
 * PrivacyProof — the homepage "why + privacy" band (one band since Batch E;
 * until then `#why` and `#privacy` were two sections with two H2s and two
 * stacked paddings on the same surface).
 *
 * Shared component (kills the 5-locale clone tax for this section): the
 * translated eyebrow / heading / body arrive via named slots, the three
 * "what you get" points as a prop, while the distinctive part — a faux
 * DevTools "Network" panel rendered as a dark-stable instrument slab — lives
 * here once. The readout is technical mono output (English in every locale,
 * like the tool demos).
 *
 * Both anchors stay: `#why` is the section (site.ts links `/#why`), `#privacy`
 * is the slab (the logql pages link `/#privacy`).
 *
 * The two rows that can be measured ARE measured: `requests (this page)` and
 * `cookies (this origin)` fill after load from the Performance API and
 * `document.cookie` (`src/lib/privacy-readout.ts`, called from HeroDemo's
 * island so this band adds no inline script and no CSP hash), so the panel
 * reports what this visit did rather than asserting a number. Both render as
 * a dash on the server, which is what no-JS readers and crawlers see: a
 * static count would be false (a real visit makes ~25 requests, and analytics
 * may set cookies), so the HTML claims no number it cannot measure. `data-ssr`
 * only carries the requests floor for `countRequests`. The labels say what is
 * counted so the panel cannot contradict the FAQ's analytics answer.
 */
import FigureCap from '../FigureCap.astro';

interface Point {
  eyebrow: string;
  title: string;
  body: string;
  icon: string;
}
interface Props {
  points?: Point[];
}
const { points = [] } = Astro.props;
---

<section id="why" class="section-pad scroll-mt-24 bg-canvas" aria-labelledby="why-heading">
  <div class="container-page">
    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[1fr_0.85fr] lg:gap-14">
      <div class="min-w-0">
        <p class="eyebrow"><slot name="eyebrow" /></p>
        <h2 id="why-heading" class="display-lg mt-3 text-balance text-ink">
          <slot name="heading" />
        </h2>
        <p class="body-lg mt-5 max-w-xl text-pretty text-body">
          <slot name="body" />
        </p>

        {
          points.length > 0 && (
            <ul role="list" class="mt-8 flex flex-col divide-y divide-hairline border-y border-hairline">
              {points.map((c) => (
                <li class="flex min-w-0 items-start gap-4 py-4">
                  <span class="mt-0.5 inline-flex size-9 shrink-0 items-center justify-center rounded-md bg-brand/10 text-brand-strong">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon} />
                  </span>
                  <span class="flex min-w-0 flex-col gap-1">
                    <span class="eyebrow">{c.eyebrow}</span>
                    <span class="body-md font-medium text-ink">{c.title}</span>
                    <span class="body-sm text-pretty text-body">{c.body}</span>
                  </span>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {/* Instrument slab: a devtools Network panel that stays (almost) empty on purpose. */}
      <div id="privacy" class="pp-panel instrument scroll-mt-24" data-privacy-proof>
        <FigureCap label="devtools · network" tone="traffic" />
        <dl class="pp-readout">
          <div><dt>requests (this page)</dt><dd data-pp="requests" data-ssr="1">&mdash;</dd></div>
          <div><dt>your input</dt><dd>0 bytes sent</dd></div>
          <div><dt>uploads</dt><dd>0</dd></div>
          <div><dt>cookies (this origin)</dt><dd data-pp="cookies" data-ssr="0">&mdash;</dd></div>
          <div><dt>accounts</dt><dd>0</dd></div>
        </dl>
        <div class="pp-trust"><span class="pp-dot" aria-hidden="true"></span> all processing is local · 100% client-side</div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Chrome comes from `.instrument`; this only sizes and places the slab. */
  .pp-panel {
    width: 100%;
    max-width: 26rem;
    justify-self: start;
  }
  @media (min-width: 1024px) {
    .pp-panel {
      justify-self: end;
      position: sticky;
      top: 6rem;
    }
  }
  .pp-readout {
    display: grid;
    grid-template-columns: auto 1fr;
    margin: 0;
    padding: 6px 18px 4px;
  }
  .pp-readout > div { display: contents; }
  .pp-readout dt,
  .pp-readout dd {
    padding: 8px 0;
    border-bottom: 1px solid var(--color-inverse-hairline);
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .pp-readout dt { color: var(--color-inverse-mute); font-size: 12px; letter-spacing: 0.02em; }
  .pp-readout dd { color: var(--color-inverse-brand); text-align: right; }
  .pp-trust {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-inverse-mute);
  }
  .pp-dot {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--color-inverse-brand);
    flex: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pp-dot { animation: pulse-ring 2.6s ease-in-out infinite; }
  }
</style>

