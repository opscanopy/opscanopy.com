---
/**
 * MissionBand — the homepage's Mission 90 drill: one instrument slab (dark in
 * both themes) carrying the pitch, the registry-derived stats, a 3-tile
 * mission board naming real missions, and the week-1 transcript typing itself
 * out. Shared across the 5 locale homepages (the ToolsCatalog pattern): the
 * translated pitch arrives through slots, the structure lives here once.
 *
 * Inks are the slab tier only (`inverse-fg / -mute / -brand / -accent`), the
 * CTA is `<Button variant="inverse">`, and the nested terminal renders
 * `flush` so the band is the one L2 object in the viewport. Mission titles and
 * blurbs come from the registry in English: Mission 90 is an English-only
 * section, so the tiles link to the unprefixed /mission-90/missions/<id>/.
 *
 * The CTA anchor text to /mission-90/ is watched by the SEO guard — callers
 * pass it through unchanged.
 */
import Button from '../Button.astro';
import TerminalPlay from '../TerminalPlay.astro';
import { missions } from '../../data/mission90';
import { trackIcon } from '../../data/track-icons';
import { DEFAULT_LOCALE, type Locale } from '../../i18n/config';
import { localizeNavHref } from '../../i18n/utils';

interface Stat {
  n: string;
  l: string;
}
interface Props {
  lang?: Locale;
  stats: Stat[];
  transcript: string;
  /** Mission ids from src/data/mission90.ts to feature on the board (3). */
  boardIds?: string[];
  /** Translated label over the board, e.g. "Three of the ten missions". */
  boardLabel: string;
  /** Translated "Week N" formatter prefix, e.g. "Week" / "Woche". */
  weekLabel: string;
  /** Translated per-tile action, e.g. "Play →". */
  playLabel: string;
}
const {
  lang = DEFAULT_LOCALE,
  stats,
  transcript,
  boardIds = ['week1-server-down', 'week4-docker-rescue', 'week11-kubernetes-chaos'],
  boardLabel,
  weekLabel,
  playLabel,
} = Astro.props;

const board = boardIds
  .map((id) => missions.find((m) => m.id === id && m.status === 'live'))
  .filter((m): m is NonNullable<typeof m> => Boolean(m));
const mission90Icon = trackIcon('mission-90');
const href = (key: string) => localizeNavHref(key, lang);
---

<section class="section-pad bg-canvas" aria-labelledby="mission90-home">
  <div class="container-page">
    <div class="instrument mb-band">
      <div class="grid grid-cols-1 gap-10 p-6 sm:p-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-start lg:gap-14 lg:p-14">
        {/* Left — the pitch */}
        <div class="flex min-w-0 flex-col">
          <span
            class="grid size-12 place-items-center rounded-md border border-inverse-hairline text-inverse-brand"
            aria-hidden="true"
          >
            <svg width="26" height="26" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={mission90Icon} />
          </span>
          <span class="eyebrow mt-5 !text-inverse-brand">Mission · 90 Days · DevOps</span>
          <h2 id="mission90-home" class="display-lg mt-3 text-balance text-inverse-fg">
            <slot name="heading" />
          </h2>
          <p class="body-lg mt-5 max-w-xl text-pretty text-inverse-mute">
            <slot name="body" />
          </p>

          <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4">
            {
              stats.map((s) => (
                <div class="flex flex-col gap-1 border-l border-inverse-hairline pl-4">
                  <dt class="display-sm text-inverse-fg">{s.n}</dt>
                  <dd class="caption text-inverse-mute">{s.l}</dd>
                </div>
              ))
            }
          </dl>

          <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3">
            <Button href={href('/mission-90')} variant="inverse"><slot name="cta" /></Button>
            <a
              href={href('/mission-90/missions')}
              class="mb-link group body-md inline-flex items-center gap-1 font-medium text-inverse-mute hover:text-inverse-fg"
            >
              <slot name="browse" />
              <span
                aria-hidden="true"
                class="transition-transform duration-150 ease-out group-hover:translate-x-0.5"
              >
                &rarr;
              </span>
            </a>
          </div>
        </div>

        {/* Right — the mission board and the week-1 "Server Down!" payoff. */}
        <div class="flex min-w-0 flex-col gap-6">
          <div>
            <p class="label-field !text-inverse-mute">{boardLabel}</p>
            <ol role="list" class="mb-board mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
              {
                board.map((m) => (
                  <li class="min-w-0">
                    <a href={href(`/mission-90/missions/${m.id}`)} class="mb-tile group flex h-full min-w-0 flex-col gap-1 p-4">
                      <span class="code-mono text-[11px] uppercase tracking-wide text-inverse-accent">{weekLabel} {m.week}</span>
                      <span class="body-md font-medium text-inverse-fg">{m.title}</span>
                      <span class="caption line-clamp-3 text-pretty text-inverse-mute">{m.blurb}</span>
                      <span class="code-mono mt-auto pt-2 text-[12px] text-inverse-brand">
                        {playLabel}
                        <span aria-hidden="true" class="inline-block transition-transform duration-150 ease-out group-hover:translate-x-0.5">&rarr;</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </div>
          <TerminalPlay transcript={transcript} title="mission: server-down" flush />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mb-tile {
    border: 1px solid var(--color-inverse-hairline);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-inverse-fg) 4%, transparent);
    transition: border-color var(--dur-fast, 120ms) var(--ease-brand, ease-out), background-color var(--dur-fast, 120ms) var(--ease-brand, ease-out);
  }
  .mb-tile:hover {
    border-color: var(--color-inverse-control-edge, var(--color-inverse-brand));
    background: color-mix(in srgb, var(--color-inverse-fg) 8%, transparent);
  }
  .mb-link {
    text-decoration: underline;
    text-decoration-color: var(--color-inverse-hairline);
    text-underline-offset: 4px;
  }
  .mb-link:hover {
    text-decoration-color: currentColor;
  }
</style>
