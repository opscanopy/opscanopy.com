---
/**
 * "From the blog" — the homepage's link into the blog, set as an incident
 * ledger: numbered mono rows with a date column, a title and a one-line
 * summary, instead of three cards. The posts are write-ups of things that
 * went wrong (a red pipeline, a vanished alert), so a ledger is the honest
 * shape for them.
 *
 * Exists because the blog was an orphaned silo: all 100 posts linked OUT to their
 * related tool, and nothing on the site linked back in. Posts were reachable only
 * from other blog pages, so the homepage's authority never reached them.
 *
 * Shared across all five homepages (the ToolsCatalog pattern) — locale comes in as
 * a prop and every string is looked up, so there is no English copy to re-translate
 * per locale page. The "Browse all posts" anchor text is watched by the SEO guard.
 */
import { getPostsForLocale, formatPostDate } from '../../i18n/blog';
import { DEFAULT_LOCALE, type Locale } from '../../i18n/config';
import { localizeKey, useTranslations } from '../../i18n/utils';

interface Props {
  lang?: Locale;
  /** How many posts to surface. Three fits the ledger without pushing the fold. */
  max?: number;
}

const { lang = DEFAULT_LOCALE, max = 3 } = Astro.props;
const t = useTranslations(lang);
const posts = (await getPostsForLocale(lang)).slice(0, max);
---

{
  posts.length > 0 && (
    <section class="section-pad bg-canvas-soft" aria-labelledby="home-blog">
      <div class="container-page">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div class="max-w-2xl">
            <span class="eyebrow">{t('home.blogEyebrow')}</span>
            <h2 id="home-blog" class="display-lg mt-3 text-balance text-ink">
              {t('home.blogHeading')}
            </h2>
            <p class="body-md mt-3 text-pretty text-body">{t('home.blogLead')}</p>
          </div>
          <a
            href={localizeKey('/blog', lang)}
            class="link-inline group body-md inline-flex shrink-0 items-center gap-1 whitespace-nowrap font-medium"
          >
            {t('home.blogBrowseAll')}
            <span
              aria-hidden="true"
              class="transition-transform duration-150 ease-out group-hover:translate-x-0.5"
            >
              &rarr;
            </span>
          </a>
        </div>

        <ol role="list" class="lp-ledger mt-10 overflow-hidden rounded-lg border border-hairline bg-card">
          {posts.map((post, i) => (
            <li class="min-w-0">
              <a
                href={localizeKey(`/blog/${post.slug}`, lang)}
                class="lp-row group grid min-w-0 gap-x-5 gap-y-1 px-5 py-4 transition-colors hover:bg-canvas-soft-2 sm:px-6"
              >
                <span class="code-mono text-[12px] text-accent-ink" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <time class="code-mono text-[12px] text-mute" datetime={post.entry.data.pubDate.toISOString()}>
                  {formatPostDate(lang, post.entry.data.pubDate)}
                </time>
                <span class="lp-title body-md min-w-0 font-medium text-balance text-ink transition-colors group-hover:text-link">
                  {post.entry.data.title}
                </span>
                <span class="lp-desc body-sm min-w-0 text-pretty text-body">{post.entry.data.description}</span>
                <span aria-hidden="true" class="lp-arrow shrink-0 self-start text-mute transition-transform duration-150 ease-out group-hover:translate-x-0.5 group-hover:text-brand-strong">
                  &rarr;
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  .lp-ledger > li + li {
    border-top: 1px solid var(--color-hairline);
  }
  /* idx · date · title · arrow, with the summary under the title (sm+); on
     phones the meta row stacks over the title. */
  .lp-row {
    grid-template-columns: 1.5rem auto minmax(0, 1fr) auto;
    grid-template-areas:
      'idx date title arrow'
      'idx date desc arrow';
    align-items: baseline;
  }
  .lp-row > :nth-child(1) { grid-area: idx; }
  .lp-row > :nth-child(2) { grid-area: date; }
  .lp-title { grid-area: title; }
  .lp-desc { grid-area: desc; }
  .lp-arrow { grid-area: arrow; }
  @media (max-width: 639px) {
    .lp-row {
      grid-template-columns: 1.5rem minmax(0, 1fr) auto;
      grid-template-areas:
        'idx date arrow'
        'idx title arrow'
        'idx desc arrow';
    }
  }
</style>
