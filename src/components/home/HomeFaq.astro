---
/**
 * HomeFaq — the homepage FAQ: the same disclosure list FaqList renders on the
 * tool pages, with one difference — the first `foldAfter` questions sit at the
 * top level and the rest nest inside a single "More questions" `<details>`,
 * so the section stops being nine closed rows of equal weight.
 *
 * Every question stays a rendered `<details>` with its answer in the DOM (a
 * `<details>` is not hidden content: no `hidden`, no `sr-only`, no
 * `display:none`), and the page's FAQPage JSON-LD is built from the same
 * `faqs` array it always was, so the machine-readable surface is byte-identical.
 *
 * Chrome strings (eyebrow, heading, tap hint) self-detect the locale via
 * Astro.currentLocale, as FaqList does; the "More questions" label is a prop
 * because it is new copy the five homepages pass in their own language.
 */
import { DEFAULT_LOCALE, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';
import type { Faq } from '../../data/tool-faqs';

export interface Props {
  id?: string;
  /** Plain text only — answers render as text nodes; markup would be escaped. */
  faqs: Faq[];
  /** How many questions stay at the top level (default 4). */
  foldAfter?: number;
  /** Visible label of the folded group, e.g. "More questions". */
  moreLabel: string;
}

const lang: Locale = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE;
const t = useTranslations(lang);
const { id = 'faq', faqs, foldAfter = 4, moreLabel } = Astro.props;
const top = faqs.slice(0, foldAfter);
const more = faqs.slice(foldAfter);
---

<section id={id} class="scroll-mt-24 border-t border-hairline bg-canvas-soft">
  <div class="container-page py-16 sm:py-20">
    <div class="max-w-2xl">
      <p class="eyebrow">{t('faq.eyebrow')}</p>
      <h2 class="display-lg mt-3 text-ink">{t('faq.heading')}</h2>
      <p class="body-sm mt-3 text-mute">{t('faq.tapHint')}</p>
    </div>
    <div class="mt-10 max-w-3xl divide-y divide-hairline border-y border-hairline">
      {top.map((f) => (
        <details class="faq-item group">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-5">
            <h3 class="display-sm text-balance text-ink transition-colors group-hover:text-link">{f.q}</h3>
            <span aria-hidden="true" class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full text-mute transition-colors group-hover:bg-canvas-soft-2 group-hover:text-ink">
              <svg class="faq-chevron size-4 transition-transform duration-200 ease-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
            </span>
          </summary>
          <div class="pb-6 pr-10">
            <p class="body-md text-pretty text-body">{f.a}</p>
          </div>
        </details>
      ))}
      {more.length > 0 && (
        <details class="faq-item faq-more group/more">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5">
            <span class="body-md font-medium text-ink transition-colors group-hover/more:text-link">
              {moreLabel} <span class="code-mono text-[12px] text-mute">({more.length})</span>
            </span>
            <span aria-hidden="true" class="grid size-7 shrink-0 place-items-center rounded-full text-mute transition-colors group-hover/more:bg-canvas-soft-2 group-hover/more:text-ink">
              <svg class="faq-chevron size-4 transition-transform duration-200 ease-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
            </span>
          </summary>
          <div class="divide-y divide-hairline border-t border-hairline pl-4 sm:pl-6">
            {more.map((f) => (
              <details class="faq-item group">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-5">
                  <h3 class="display-sm text-balance text-ink transition-colors group-hover:text-link">{f.q}</h3>
                  <span aria-hidden="true" class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full text-mute transition-colors group-hover:bg-canvas-soft-2 group-hover:text-ink">
                    <svg class="faq-chevron size-4 transition-transform duration-200 ease-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                  </span>
                </summary>
                <div class="pb-6 pr-10">
                  <p class="body-md text-pretty text-body">{f.a}</p>
                </div>
              </details>
            ))}
          </div>
        </details>
      )}
    </div>
  </div>
</section>

<style>
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] > summary .faq-chevron {
    transform: rotate(180deg);
  }
</style>
