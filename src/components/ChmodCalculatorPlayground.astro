---
/**
 * ChmodCalculatorPlayground — the interactive chmod Calculator island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>.
 * Three inputs stay in sync — a user/group/other × read/write/execute checkbox
 * matrix (plus setuid/setgid/sticky special-bit checkboxes), an octal input,
 * and a symbolic input. Editing any one re-renders the others via the engine.
 * Output rows (octal, symbolic, ls -l, chmod command) are each copyable, with
 * Copy all, a shareable #m=<octal> deep link and saved snapshots of the
 * octal value.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar, ResultPanel (figure cap, live summary, copy status)
 * and CopyButton. The results container stays here, seeded with
 * `set:html` + `data-results`; its slab overrides anchor on `.chmod-results`.
 *
 * Runtime contract (engine lazy-imported for code-splitting):
 *   ../lib/chmod-calculator/engine → parseOctal / parseSymbolic / fromState
 *   ../lib/chmod-calculator/types  → ChmodResult, ChmodState
 *
 * examples.ts is statically imported here in the frontmatter so the chips
 * render server-side; only the engine is dynamically imported in the boot
 * closure.
 */
import { examples } from '../lib/chmod-calculator/examples';
import { parseOctal } from '../lib/chmod-calculator/engine';
import { resultHtml, summaryText, EMPTY_HTML } from '../lib/chmod-calculator/render';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-computes the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees a real worked answer
 * instead of an empty "toggle the matrix" panel. The matrix checkboxes and
 * both text fields are pre-filled the same way the client's `commit` does.
 *
 * `parseOctal` is pure and synchronous, so it runs at build time unchanged.
 */
export interface Props {
  /** Variant pages (/chmod-calculator/777/) seed this octal; parent pages pass nothing. */
  seed?: string;
}
const { seed } = Astro.props;
const seedExample = examples[0];
const seedInput = seed ?? seedExample?.octal;
const seedResult = seedInput !== undefined ? parseOctal(seedInput) : null;
const seedState = seedResult && seedResult.valid ? seedResult.state : undefined;
const seedHtml = seedResult && seedResult.valid ? resultHtml(seedResult) : EMPTY_HTML;
const seedSummary = seedResult && seedResult.valid ? summaryText(seedResult) : '';
const chipItems = examples.map((ex) => ({ label: ex.label, input: ex.octal, ariaLabel: ex.label }));
const seedIdx = seedInput !== undefined ? examples.findIndex((ex) => ex.octal === seedInput) : -1;

const ROWS = [
  { key: 'user', label: 'Owner' },
  { key: 'group', label: 'Group' },
  { key: 'other', label: 'Other' },
] as const;
const COLS = [
  { key: 'read', label: 'Read' },
  { key: 'write', label: 'Write' },
  { key: 'execute', label: 'Exec' },
] as const;
const SPECIAL = [
  { key: 'setuid', label: 'setuid' },
  { key: 'setgid', label: 'setgid' },
  { key: 'sticky', label: 'sticky' },
] as const;
---

<section class="chmod-pg" aria-label="chmod Calculator playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: example chips ───────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow">Examples</span>
      <ExampleChips prefix="chmod" items={chipItems} active={seedIdx >= 0 ? seedIdx : null} ariaLabel="Examples" />
    </div>

    {/* ── Permission matrix ────────────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <span class="eyebrow chmod-block-label">Permission bits</span>
      <div class="chmod-grid" role="group" aria-label="Permission matrix">
        <div class="chmod-grid__cell chmod-grid__cell--corner" aria-hidden="true">·</div>
        {COLS.map((c) => <div class="chmod-grid__cell chmod-grid__cell--colh">{c.label}</div>)}
        {
          ROWS.map((r) => (
            <>
              <div class="chmod-grid__cell chmod-grid__cell--rowh">{r.label}</div>
              {COLS.map((c) => (
                <div class="chmod-grid__cell">
                  <input
                    type="checkbox"
                    class="chmod-box"
                    data-who={r.key}
                    data-bit={c.key}
                    checked={Boolean(seedState?.[r.key]?.[c.key])}
                    aria-label={`${r.label} ${c.label}`}
                  />
                </div>
              ))}
            </>
          ))
        }
      </div>
      <div class="chmod-special mt-3" role="group" aria-label="Special bits">
        {
          SPECIAL.map((s) => (
            <label class="chmod-check" for={`chmod-${s.key}`}>
              <input
                id={`chmod-${s.key}`}
                type="checkbox"
                class="chmod-box chmod-box--sm"
                data-special={s.key}
                checked={Boolean(seedState?.special?.[s.key])}
              />
              <span class="chmod-check__label">{s.label}</span>
            </label>
          ))
        }
      </div>
    </div>

    {/* ── Octal + symbolic inputs ──────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <span class="eyebrow chmod-block-label">Enter a value</span>
      <div class="chmod-sync-row">
        <div class="chmod-sync-field">
          <label class="chmod-field-label" for="chmod-octal">Octal</label>
          <input
            id="chmod-octal"
            class="chmod-input code-mono"
            type="text"
            inputmode="numeric"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            autocomplete="off"
            enterkeyhint="done"
            placeholder="755"
            value={seedInput}
            aria-label="Octal permission value"
            aria-describedby="chmod-input-hint chmod-input-live"
          />
        </div>
        <div class="chmod-sync-field">
          <label class="chmod-field-label" for="chmod-symbolic">Symbolic</label>
          <input
            id="chmod-symbolic"
            class="chmod-input code-mono"
            type="text"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            autocomplete="off"
            enterkeyhint="done"
            placeholder="rwxr-xr-x"
            value={seedResult?.valid ? seedResult.symbolic : undefined}
            aria-label="Symbolic permission value"
            aria-describedby="chmod-input-hint chmod-input-live"
          />
        </div>
      </div>
      <p id="chmod-input-hint" class="chmod-hint caption text-mute">
        The matrix, octal and symbolic fields all stay in sync — edit any one and the others follow.
      </p>
      <RunHint id="chmod-input-live" />
      <SnapshotBar prefix="chmod" />
    </div>

    {/* ── Results panel — the L2 instrument (dark in both themes) under its
        figure cap; the live summary reads out in the cap's actions slot. ── */}
    <ResultPanel slug="chmod-calculator" prefix="chmod" summary={seedSummary} label="Output" split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="chmod-share" />
        <CopyButton kind="all" id="chmod-copy-all" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the answer is in the
          static HTML; the client replaces it with the same markup on boot. */}
      <div id="chmod-results" class="chmod-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .chmod-block-label {
    display: block;
    margin-bottom: 10px;
  }

  /* ── Permission matrix ──────────────────────────────────────────────── */
  .chmod-grid {
    display: grid;
    grid-template-columns: 72px repeat(3, 1fr);
    gap: 0;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
  }
  .chmod-grid__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 8px;
    border-bottom: 1px solid var(--color-hairline);
  }
  .chmod-grid > .chmod-grid__cell:nth-last-child(-n + 4) {
    border-bottom: none;
  }
  .chmod-grid__cell--rowh {
    justify-content: flex-start;
    padding-left: 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-body);
  }
  /* Column heads are field captions: the label-field role. */
  .chmod-grid__cell--colh {
    @apply label-field;
  }
  .chmod-grid__cell--corner {
    color: transparent;
  }
  @media (pointer: coarse) {
    .chmod-grid__cell {
      padding: 14px 8px;
    }
  }

  .chmod-box {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    accent-color: var(--color-brand);
    cursor: pointer;
  }
  .chmod-box--sm {
    width: 16px;
    height: 16px;
  }
  .chmod-box:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .chmod-special {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .chmod-check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    user-select: none;
  }
  .chmod-check__label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-body);
  }

  /* ── Sync inputs ────────────────────────────────────────────────────── */
  .chmod-sync-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .chmod-sync-field {
    flex: 1 1 180px;
    min-width: 0;
  }
  .chmod-field-label {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-body);
  }
  .chmod-input {
    width: 100%;
    height: var(--control-h-lg);
    padding: 0 14px;
    border: none;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 14px;
    line-height: 24px;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .chmod-input::placeholder {
    color: var(--color-mute);
  }
  .chmod-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .chmod-input:focus {
    outline: none;
  }
  .chmod-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-focus);
    outline: none;
  }
  .chmod-input.chmod-input--error {
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  .chmod-input.chmod-input--error:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-error);
  }
  .chmod-hint {
    margin-top: 10px;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .chmod-hint .code-mono {
    font-size: 12px;
  }

  .chmod-results {
    min-height: 176px;
    display: grid;
    align-content: center;
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.chmod-results` container (the panel
     wrapper is ResultPanel's and carries no scope attribute). */
  :global(.chmod-card) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: chmod-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.chmod-row) {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 12px;
    padding: 9px 14px;
    align-items: baseline;
  }
  @media (max-width: 479px) {
    :global(.chmod-row) {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
  :global(.chmod-row + .chmod-row) {
    border-top: 1px solid var(--color-hairline);
  }
  /* Row-key role (label-field): mono 11/16 uppercase, the only label. */
  :global(.chmod-row__k) {
    @apply label-field;
  }
  :global(.chmod-row__v-wrap) {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  :global(.chmod-row__v) {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-all;
  }
  /* ── Per-row copy buttons (render.ts; copy.ts drives them) ──────────── */
  :global(.chmod-copy-btn) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-brand),
      background var(--dur-fast) var(--ease-brand);
    padding: 0;
  }
  :global(.chmod-copy-btn:hover) {
    color: var(--color-brand-strong);
    background: var(--color-hairline);
  }
  :global(.chmod-copy-btn:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
  }
  :global(.chmod-copy-btn[data-copied]) {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
  }
  @media (pointer: coarse) {
    :global(.chmod-copy-btn) {
      width: var(--control-h-lg);
      height: var(--control-h-lg);
    }
  }

  :global(.chmod-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.chmod-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.chmod-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.chmod-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.chmod-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }
  :global(.chmod-empty) .code-mono {
    font-size: 12px;
  }

  @keyframes chmod-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.chmod-card) {
      animation: none;
    }
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below it uses the slab ink tier; the light rules
     above remain the documented defaults. ──────────────────────────────── */
  .chmod-results :global(.chmod-empty) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .chmod-results :global(.chmod-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .chmod-results :global(.chmod-card) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .chmod-results :global(.chmod-row + .chmod-row) {
    border-top-color: #ffffff12;
  }
  .chmod-results :global(.chmod-row__k) {
    color: var(--color-inverse-mute);
  }
  .chmod-results :global(.chmod-row__v) {
    color: var(--color-inverse-fg);
  }
  /* Values right-align like every instrument readout; the stacked <480px
     layout returns to the left edge. */
  .chmod-results :global(.chmod-row__v-wrap) {
    justify-content: flex-end;
  }
  .chmod-results :global(.chmod-row__v) {
    text-align: right;
  }
  @media (max-width: 479px) {
    .chmod-results :global(.chmod-row__v-wrap) {
      justify-content: flex-start;
    }
    .chmod-results :global(.chmod-row__v) {
      text-align: left;
    }
  }
  .chmod-results :global(.chmod-copy-btn) {
    color: var(--color-inverse-mute);
  }
  .chmod-results :global(.chmod-copy-btn:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .chmod-results :global(.chmod-copy-btn[data-copied]) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
</style>

<script>
  import {
    EMPTY_HTML,
    errorHtml,
    resultHtml,
    buildCopyAll,
    summaryText,
  } from '../lib/chmod-calculator/render';
  import { wireRunKeys } from '../lib/run-keys';
  import { createHashState } from '../lib/hash-state';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByInput, clearChips, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { wireSnapshotUI } from '../lib/tool-state/wire';
  import type { Perm, Special, ChmodState, ChmodResult } from '../lib/chmod-calculator/types';

  type EngineModule = {
    parseOctal: (input: string) => ChmodResult;
    parseSymbolic: (input: string) => ChmodResult;
    fromState: (state: ChmodState) => ChmodResult;
    emptyState: () => ChmodState;
  };

  const ROOT_SEL = '.chmod-pg';
  const DEBOUNCE_MS = 140;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.chmodWired === 'true') return;
      root.dataset.chmodWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    setSummary(summary, `Invalid — ${message}`, true);
    container.innerHTML = errorHtml(message);
  }

  function renderResult(container: HTMLElement, summary: HTMLElement, result: ChmodResult): void {
    setSummary(summary, summaryText(result), false);
    container.innerHTML = resultHtml(result);
  }

  async function init(root: HTMLElement): Promise<void> {
    const octalInput = el<HTMLInputElement>(root, '#chmod-octal');
    const symbolicInput = el<HTMLInputElement>(root, '#chmod-symbolic');
    const resultsBox = el<HTMLElement>(root, '#chmod-results');
    const summaryEl = el<HTMLElement>(root, '#chmod-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#chmod-share');
    const copyAllBtn = el<HTMLButtonElement>(root, '#chmod-copy-all');
    const copyStatus = el<HTMLElement>(root, '#chmod-copy-status');
    const boxes = Array.from(root.querySelectorAll<HTMLInputElement>('.chmod-box[data-who]'));
    const specialBoxes = Array.from(
      root.querySelectorAll<HTMLInputElement>('.chmod-box[data-special]'),
    );
    const chipsWrap = el<HTMLElement>(root, '#chmod-chips');
    const chips = Array.from(chipsWrap?.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR) ?? []);
    const snapSaveBtn = el<HTMLButtonElement>(root, '#chmod-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#chmod-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#chmod-snap-delete');
    if (
      !octalInput ||
      !symbolicInput ||
      !resultsBox ||
      !summaryEl ||
      !shareBtn ||
      !copyAllBtn ||
      !copyStatus ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    /* ------------------------------------------------------------------ */
    /* Copy plumbing (row buttons, Copy link, Copy all) — the kit helper:  */
    /* one delegated listener; outcomes announced in #chmod-copy-status.   */
    /* ------------------------------------------------------------------ */

    wireCopyButtons(root, { status: copyStatus });

    let engine: EngineModule;
    try {
      engine = (await import('../lib/chmod-calculator/engine')) as unknown as EngineModule;
    } catch (err) {
      renderError(
        resultsBox,
        summaryEl,
        'The calculator engine failed to load. Reload the page to try again.',
      );
      console.error('[ChmodCalculator] engine import failed:', err);
      return;
    }

    /* ------------------------------------------------------------------ */
    /* Sync helpers                                                         */
    /* ------------------------------------------------------------------ */

    function setOctalError(on: boolean): void {
      octalInput!.classList.toggle('chmod-input--error', on);
      octalInput!.setAttribute('aria-invalid', on ? 'true' : 'false');
    }
    function setSymbolicError(on: boolean): void {
      symbolicInput!.classList.toggle('chmod-input--error', on);
      symbolicInput!.setAttribute('aria-invalid', on ? 'true' : 'false');
    }

    const hashState = createHashState('m');
    function writeHash(octal: string | null): void {
      hashState.write(octal);
    }

    function applyState(state: ChmodState): void {
      boxes.forEach((box) => {
        const who = box.dataset.who as 'user' | 'group' | 'other';
        const bit = box.dataset.bit as 'read' | 'write' | 'execute';
        box.checked = Boolean(state[who]?.[bit]);
      });
      specialBoxes.forEach((box) => {
        const key = box.dataset.special as keyof Special;
        box.checked = Boolean(state.special?.[key]);
      });
    }

    function readState(): ChmodState {
      const mk = (who: 'user' | 'group' | 'other'): Perm => ({
        read: boxes.some((b) => b.dataset.who === who && b.dataset.bit === 'read' && b.checked),
        write: boxes.some((b) => b.dataset.who === who && b.dataset.bit === 'write' && b.checked),
        execute: boxes.some(
          (b) => b.dataset.who === who && b.dataset.bit === 'execute' && b.checked,
        ),
      });
      const special = (key: keyof Special): boolean =>
        specialBoxes.some((b) => b.dataset.special === key && b.checked);
      return {
        special: { setuid: special('setuid'), setgid: special('setgid'), sticky: special('sticky') },
        user: mk('user'),
        group: mk('group'),
        other: mk('other'),
      };
    }

    /**
     * Render a valid result: refresh output rows, share/copy-all payloads, and
     * (from every field except the one being edited) keep inputs + matrix in
     * sync. `source` names the field the user just edited so we don't clobber
     * their caret.
     */
    function commit(result: ChmodResult, source: 'octal' | 'symbolic' | 'matrix', userInitiated: boolean): void {
      renderResult(resultsBox!, summaryEl!, result);
      applyState(result.state!);
      if (source !== 'octal') octalInput!.value = result.octal!;
      if (source !== 'symbolic') symbolicInput!.value = result.symbolic!;
      setOctalError(false);
      setSymbolicError(false);

      shareBtn!.hidden = false;
      shareBtn!.dataset.copy =
        location.origin + location.pathname + location.search + hashState.build(result.octal!);
      copyAllBtn!.hidden = false;
      copyAllBtn!.dataset.copy = buildCopyAll(result);

      if (userInitiated) writeHash(result.octal ?? null);
    }

    function fail(source: 'octal' | 'symbolic', message: string, userInitiated: boolean): void {
      if (source === 'octal') setOctalError(true);
      else setSymbolicError(true);
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
      copyAllBtn!.hidden = true;
      copyAllBtn!.dataset.copy = '';
      renderError(resultsBox!, summaryEl!, message);
      if (userInitiated) writeHash(null);
    }

    /* ------------------------------------------------------------------ */
    /* Evaluators                                                           */
    /* ------------------------------------------------------------------ */

    function evalOctal(userInitiated: boolean): void {
      const value = octalInput!.value.trim();
      if (!value) {
        fail('octal', 'Enter an octal mode like 755 or 4755.', userInitiated);
        return;
      }
      const result = engine.parseOctal(value);
      if (!result.valid) {
        fail('octal', result.error ?? 'Invalid octal mode.', userInitiated);
        return;
      }
      commit(result, 'octal', userInitiated);
    }

    function evalSymbolic(userInitiated: boolean): void {
      const value = symbolicInput!.value.trim();
      if (!value) {
        fail('symbolic', 'Enter a symbolic mode like rwxr-xr-x.', userInitiated);
        return;
      }
      const result = engine.parseSymbolic(value);
      if (!result.valid) {
        fail('symbolic', result.error ?? 'Invalid symbolic mode.', userInitiated);
        return;
      }
      commit(result, 'symbolic', userInitiated);
    }

    function evalMatrix(userInitiated: boolean): void {
      const result = engine.fromState(readState());
      commit(result, 'matrix', userInitiated);
    }

    /* ------------------------------------------------------------------ */
    /* Events                                                               */
    /* ------------------------------------------------------------------ */

    let timer: number | undefined;
    function debounce(fn: () => void): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(fn, DEBOUNCE_MS);
    }

    octalInput.addEventListener('input', () => {
      clearActiveChips();
      debounce(() => evalOctal(true));
    });
    wireRunKeys(octalInput, () => {
      window.clearTimeout(timer);
      evalOctal(true);
    });

    symbolicInput.addEventListener('input', () => {
      clearActiveChips();
      debounce(() => evalSymbolic(true));
    });
    wireRunKeys(symbolicInput, () => {
      window.clearTimeout(timer);
      evalSymbolic(true);
    });

    [...boxes, ...specialBoxes].forEach((box) => {
      box.addEventListener('change', () => {
        clearActiveChips();
        window.clearTimeout(timer);
        evalMatrix(true);
      });
    });

    function clearActiveChips(): void {
      clearChips(chipsWrap);
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const octal = chip.dataset.input ?? '';
        octalInput.value = octal;
        window.clearTimeout(timer);
        syncChipsByInput(chipsWrap, octal);
        evalOctal(true);
      });
    });

    // Snapshots store the raw octal field (the same value #m= carries).
    wireSnapshotUI({
      slug: 'chmod-calculator',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => octalInput!.value.trim(),
      setValue: (value) => {
        octalInput!.value = value;
        window.clearTimeout(timer);
        syncChipsByInput(chipsWrap, value.trim());
        evalOctal(true);
      },
    });

    /* ------------------------------------------------------------------ */
    /* First load: #m=<octal> deep link > server-seeded value (the input's  */
    /* defaultValue: examples[0], or a variant page's `seed`)              */
    /* ------------------------------------------------------------------ */

    // Accept ANY `#m=` payload and let the engine judge it. The guard used to be
    // /^#m=([0-7]{3,4})$/ — the very grammar parseOctal enforces — so every
    // fragment the engine would have diagnosed was discarded before it could,
    // and boot fell through to the seeded example instead. Opening a shared
    // /chmod-calculator/#m=888 therefore rendered a different, valid-looking
    // answer (755) while the bad mode stayed in the address bar, with nothing
    // to tell the reader the link was wrong. evalOctal already reports a
    // specific diagnostic for a bad value; it simply never saw one.
    const hashMatch = window.location.hash.match(/^#m=(.+)$/);
    let hashValue: string | null = null;
    if (hashMatch) {
      try {
        hashValue = decodeURIComponent(hashMatch[1]);
      } catch {
        // A malformed percent-escape is still a deliberate `#m=`, so show the
        // raw text and let the engine name what is wrong with it.
        hashValue = hashMatch[1];
      }
    }
    if (hashValue !== null && hashValue.trim().length > 0) {
      octalInput.value = hashValue;
      // The deep link wins over the seed: release the server-pressed chip
      // unless the link IS one of the examples.
      syncChipsByInput(chipsWrap, hashValue.trim());
      evalOctal(false);
    } else if (octalInput.defaultValue.trim() || chips[0]) {
      const octal = octalInput.defaultValue.trim() || (chips[0].dataset.input ?? '755');
      octalInput.value = octal;
      syncChipsByInput(chipsWrap, octal);
      evalOctal(false);
    } else {
      resultsBox.innerHTML = EMPTY_HTML;
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
