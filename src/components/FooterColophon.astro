---
/**
 * FooterColophon — the footer's "colophon plate": a neofetch-style readout of
 * how the site is made, set as an instrument slab (dark in both themes).
 *
 *   variant="plate" (default) — `.instrument` slab + FigureCap + a mono <dl>
 *                               (two pairs per row). Shown from lg (1024).
 *   variant="line"            — one compact mono line in paper inks, for the
 *                               phone/tablet bottom bar. Shown below lg only (a
 *                               full-width plate on tablets was half empty and
 *                               made the footer ~200px taller than before).
 * Each variant carries its own breakpoint visibility, so the footer can render
 * both and exactly one ever shows.
 *
 * Every value is derived at build time from the registries (tool + category
 * counts, the locale list, the jq pin) and is English by design: the plate is
 * marked lang="en" + translate="no" so screen readers pronounce it as English
 * and page translators leave it alone, and data-nosnippet keeps it out of
 * search snippets. Google honours data-nosnippet ONLY on <span>, <div> and
 * <section>, so both variants' roots are <div>s: never turn the line into a
 * <p> (and never render either variant inside a <p>, where a <div> is invalid).
 *
 * Deliberately absent — do not add:
 *   - privacy / trust claims (a tool page has ONE trust line, ToolHero's);
 *   - dates or the build SHA (a site-wide date competes with each page's real
 *     "Updated" date, and a SHA would change every page on every deploy);
 *   - any inline <script> or define:vars (the CSP hash budget).
 * The plate uses only slab inks (inverse-*); the line uses paper inks, and
 * never accent-ink (4.12:1 on the footer surface — contrast.test.ts).
 */
import FigureCap from './FigureCap.astro';
import LogoMark from './LogoMark.astro';
import { liveTools, categories } from '../data/tools';
import { JQ_VERSION } from '../data/versions';
import { BCP47, LOCALES, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import { repoUrl } from '../lib/site-links';

interface Props {
  /** The page's locale: bracketed in the locales row; names the sr-only new-tab hint. */
  lang: Locale;
  variant?: 'plate' | 'line';
}

const { lang, variant = 'plate' } = Astro.props;
const t = useTranslations(lang);

const localesValue = LOCALES.map((l) => (l === lang ? `[${l}]` : l)).join(' ');
const rows: { key: string; value: string }[] = [
  { key: 'tools', value: `${liveTools.length} live · ${categories.length} categories` },
  { key: 'locales', value: localesValue },
  { key: 'engines', value: `TypeScript · jq ${JQ_VERSION}` },
  { key: 'license', value: 'MIT' },
  { key: 'type', value: 'IBM Plex Sans · Mono' },
];
/** The repo URL without its scheme, split after each "/" so the label can wrap
    at a path boundary (<wbr>) in a narrow value column instead of mid-word. */
const repoLabelParts = repoUrl.replace(/^https?:\/\//, '').split(/(?<=\/)/);
const localesSegment = ` · ${LOCALES.length} locales`;
---

{
  variant === 'line' ? (
    <div class="font-mono text-[12px] leading-4 text-mute lg:hidden" lang="en" translate="no" data-nosnippet>
      {/* The locales segment drops below 360px so the line never wraps to a lone "MIT". */}
      opscanopy.com · {liveTools.length} tools<span class="max-[359px]:hidden">{localesSegment}</span> · MIT
    </div>
  ) : (
    <div class="colophon instrument shadow-none max-lg:hidden" lang="en" translate="no" data-nosnippet>
      <FigureCap label="colophon — opscanopy.com" />
      <div class="flex items-center gap-5 px-4 py-4 sm:px-5">
        <LogoMark class="hidden h-14 w-auto shrink-0 text-inverse-brand xl:block" />
        <dl class="grid min-w-0 flex-1 grid-cols-[max-content_1fr_max-content_1fr] items-baseline gap-x-4 gap-y-1.5 font-mono">
          {rows.map((row) => (
            <>
              <dt class="text-[12px] leading-5 text-inverse-mute">{row.key}</dt>
              <dd class="min-w-0 text-[13px] leading-5 text-inverse-fg wrap-anywhere">{row.value}</dd>
            </>
          ))}
          <dt class="text-[12px] leading-5 text-inverse-mute">source</dt>
          <dd class="min-w-0 text-[13px] leading-5 text-inverse-fg wrap-anywhere">
            {/* Focus ring: `.instrument :focus-visible` in global.css paints it
                in slab leaf (the base link-green ring is 2.54:1 on the slab). */}
            <a
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-xs text-inverse-brand underline decoration-1 underline-offset-2 transition-colors hover:text-inverse-fg"
            >
              {repoLabelParts.map((part, i) => (i === 0 ? part : <><wbr />{part}</>))}
              <span class="sr-only" lang={BCP47[lang]}> {t('a11y.opensNewTab')}</span>
            </a>
          </dd>
        </dl>
      </div>
    </div>
  )
}
