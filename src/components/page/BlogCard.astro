---
/**
 * BlogCard — one post in the /blog grids (BlogIndexBody, /blog/tag/<tag>/).
 *
 * The title appears ONCE: the card image is the post's cover THUMBNAIL
 * (`public/blog/<slug>-thumb.svg`, written by `npm run gen:heroes` — the
 * cover's plate, caption and icon without the title), so the <h2> below it is
 * the only place the words are drawn. The full cover with the title stays the
 * post page's hero and og:image.
 *
 * Two links, never nested: the byline (the person behind the org default,
 * `rel="author"` to /about/, exactly as BlogPost's header does) and the post
 * link, which wraps the title, description, tags and the "Read post" label and
 * is stretched over the whole card with ::after. The byline sits above that
 * overlay (`relative z-10`), so both stay clickable. The post link's text is
 * the card's own words; the date and reading time now sit outside it.
 */
import type { Locale } from '../../i18n/config';
import { useTranslations, localizeKey } from '../../i18n/utils';
import { formatPostDate, estimateReadingTime, type LocalizedPost } from '../../i18n/blog';
import { site } from '../../data/site';

interface Props {
  post: LocalizedPost;
  lang: Locale;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const { data } = post.entry;
---

<li class="h-full">
  <article class="card card-interactive group relative flex h-full min-w-0 flex-col p-6">
    <div class="-mx-6 -mt-6 mb-5 overflow-hidden rounded-t-[var(--radius-md)]">
      <img
        src={`/blog/${post.slug}-thumb.svg`}
        alt=""
        loading="lazy"
        width="1200"
        height="630"
        class="aspect-[1200/630] w-full bg-canvas-soft-2 object-cover transition-transform duration-300 ease-out group-hover:scale-[1.04] motion-reduce:transform-none"
      />
    </div>
    <p class="caption flex flex-wrap items-center gap-x-1.5 gap-y-1 text-mute">
      {
        data.author === site.author ? (
          <a
            href={localizeKey('/about', lang)}
            rel="author"
            class="relative z-10 text-body underline decoration-1 underline-offset-2 transition-colors hover:text-link"
          >
            {site.person.name}
          </a>
        ) : (
          <span class="text-body">{data.author}</span>
        )
      }
      <span aria-hidden="true">·</span>
      <time datetime={data.pubDate.toISOString()} class="tabular-nums">
        {formatPostDate(lang, data.pubDate)}
      </time>
      <span aria-hidden="true">·</span>
      <span class="tabular-nums">
        {t('blog.readingTime', { minutes: estimateReadingTime(post.entry.body) })}
      </span>
    </p>
    <a
      href={localizeKey(`/blog/${post.slug}`, lang)}
      class="mt-3 flex grow flex-col outline-none after:absolute after:inset-0 after:content-['']"
    >
      <h2 class="display-sm text-balance text-ink">{data.title}</h2>
      <p class="body-sm mt-3 line-clamp-4 grow text-pretty text-body">{data.description}</p>
      {data.tags && data.tags.length > 0 && (
        <ul role="list" class="mt-5 flex flex-wrap gap-2">
          {data.tags.map((tag) => (
            <li class="badge code-mono lowercase">{tag}</li>
          ))}
        </ul>
      )}
      <span class="link-cta body-sm mt-5 self-start" aria-hidden="true">{t('blog.readPost')}</span>
    </a>
  </article>
</li>
