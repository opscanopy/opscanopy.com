---
/**
 * GrafanaDashboardValidatorPlayground — the Grafana Dashboard Validator island.
 *
 * ONE CodeMirror JSON editor plus a grouped diagnostics panel. Each finding row
 * carries the severity, the rule id (linking to that rule's subsection in the
 * page catalog, `#rule-no-uid`), the JSON path it lives at, the reason and the
 * fix, and a copy button that yields one plain-text line fit for a review
 * comment.
 *
 * NO DEEP LINK, deliberately and permanently. A dashboard is kilobytes to
 * megabytes of JSON — one or two orders of magnitude past the ~2000-character
 * fragment cap every other tool here works inside — so this playground never
 * reads `location.hash`, never writes it, and omits `data-copy-link` ENTIRELY
 * rather than offering a share button that could only ever copy the page URL
 * (which would contradict the contract's "hidden until valid" wording). Saved
 * snapshots and last-input restore still apply, so nothing is lost on reload.
 *
 * UX contract (CLAUDE.md), ported from CidrCheckerPlayground — the only correct
 * reference for state handling, since SubnetCalculator writes its hash during the
 * boot seed: example chips at `var(--radius-pill)`, ONE ~220ms debounce (this
 * tool's inputs are large) with the exact hint line, a ~600ms calm-error hold
 * before anything goes red, per-row copy + `data-copy-all`, a single visible
 * `role="status"` summary plus an sr-only copy-status span, a results container
 * that is NOT `aria-live`, glossary captions instead of tooltips, and
 * `escapeHtml()` on every injected value — attribute contexts included.
 *
 * Runtime contract (lazy-imported inside the boot closure so the engine, the
 * CodeMirror runtime and the JSON language mode all code-split away from the page
 * shell):
 *   ../lib/grafana-dashboard-validator/engine   → lintDashboard, summaryLine
 *   ../lib/grafana-dashboard-validator/examples → examples: DashboardExample[]
 *
 * Only the example LABELS are read at build time (so the chips are
 * server-rendered and exist before hydration); the dashboards themselves come
 * from the lazy import by index, which keeps multi-kilobyte JSON out of HTML
 * attributes entirely.
 */
import { examples } from '../lib/grafana-dashboard-validator/examples';
import { GRAFANA_RULES_VERSION } from '../lib/grafana-dashboard-validator/types';
---

<section class="gd-pg" aria-label="Grafana Dashboard Validator playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Example chips ────────────────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow shrink-0">Examples</span>
      <div id="gd-chips" class="gd-chips" role="group" aria-label="Examples">
        {
          examples.map((ex, i) => (
            <button type="button" class="gd-chip" data-example-idx={String(i)} aria-pressed="false">
              {ex.label}
            </button>
          ))
        }
      </div>
      <p class="gd-gloss caption text-mute">
        The <strong class="font-medium text-body">uid</strong> is the stable identifier you choose and
        keep in git; the <strong class="font-medium text-body">id</strong> is a row number belonging to
        one Grafana database, and it should be <span class="code-mono">null</span> in any file you
        commit. <strong class="font-medium text-body">schemaVersion</strong> records which of Grafana's
        own dashboard-format migrations have already been applied to the JSON.
      </p>
      <p class="gd-gloss caption text-mute">
        Rules pinned to <strong class="code-mono text-body">{GRAFANA_RULES_VERSION}</strong> — every
        version-sensitive finding is phrased as a range, never as one exact release.
      </p>
    </div>

    {/* ── Input editor (dark instrument slab) ──────────────────────────── */}
    <div class="gd-pane bg-inverse">
      <div class="gd-pane__bar">
        <span class="flex shrink-0 items-center gap-1.5" aria-hidden="true">
          <span class="gd-pane__dot"></span>
          <span class="gd-pane__dot"></span>
          <span class="gd-pane__dot"></span>
        </span>
        <span class="gd-pane__name code-mono">dashboard.json</span>
        <span class="gd-pane__tag code-mono">input</span>
      </div>
      <div id="gd-input" class="gd-editor"></div>
    </div>

    {/* ── Hints + snapshots ────────────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 pt-3 pb-4 sm:px-5">
      <p id="gd-run-hint" class="gd-hint caption text-mute">
        Results update as you type — press Enter to run now.
      </p>
      <p class="gd-hint caption text-mute">
        Press <kbd class="gd-kbd">Esc</kbd> to release keyboard focus from the editor;
        <kbd class="gd-kbd">⌘</kbd>/<kbd class="gd-kbd">Ctrl</kbd> + <kbd class="gd-kbd">Enter</kbd>
        lints and leaves the editor. Dashboards are too large for a shareable link, so use
        <span class="code-mono">Save snapshot</span> instead — it stays in this browser. Nothing you
        paste is uploaded.
      </p>
      <div class="gd-snap-row mt-3 flex flex-wrap items-center gap-2">
        <button id="gd-snap-save" type="button" class="gd-snap-btn">Save snapshot</button>
        <select
          id="gd-snap-select"
          class="gd-snap-select"
          aria-label="Load a saved snapshot"
          disabled
        >
          <option value="">No snapshots yet</option>
        </select>
        <button
          id="gd-snap-delete"
          type="button"
          class="gd-snap-delete"
          aria-label="Delete this snapshot"
          hidden>&times;</button
        >
      </div>
    </div>

    {/* ── Findings ─────────────────────────────────────────────────────── */}
    <div class="bg-canvas-soft px-4 py-4 sm:px-5">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
        <span class="flex flex-wrap items-center gap-2">
          <span class="eyebrow">Findings</span>
          <button
            id="gd-copy-all"
            type="button"
            class="gd-copy gd-copy--labeled"
            data-copy-all
            data-copy=""
            data-copy-label="Copy report"
            hidden
          >
            <svg
              class="gd-copy-icon"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="5" y="5" width="9" height="9" rx="1.5"></rect>
              <path d="M3 11H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v1"></path>
            </svg>
            <svg
              class="gd-check-icon hidden"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 8.5l3.5 3.5L13 4.5"></path>
            </svg>
            <span class="gd-copy-label">Copy report</span>
          </button>
        </span>
        <span id="gd-summary" class="gd-summary code-mono text-mute" role="status" aria-live="polite"
        ></span>
      </div>
      <div id="gd-results" class="gd-results">
        <p class="gd-empty body-sm text-mute">
          Paste a Grafana dashboard JSON above — or tap an example — to see every finding here, with
          the JSON path it lives at and the fix.
        </p>
      </div>
      <span id="gd-copy-status" class="sr-only" role="status" aria-live="polite"></span>
    </div>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* ── Example chips ───────────────────────────────────────────────────── */
  .gd-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .gd-chip {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border: none;
    border-radius: var(--radius-pill);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-brand-strong);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      background 0.12s ease,
      box-shadow 0.12s ease;
  }
  .gd-chip:hover,
  .gd-chip[aria-pressed='true'] {
    background: var(--color-brand-soft);
    box-shadow: inset 0 0 0 1px var(--color-brand);
  }
  .gd-chip:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  .gd-gloss {
    margin: 0;
    font-size: 12px;
    line-height: 17px;
    text-wrap: pretty;
  }
  .gd-gloss + .gd-gloss {
    margin-top: 2px;
  }
  .gd-gloss .code-mono {
    font-size: 11.5px;
  }

  /* ── Input pane (dark instrument slab) ───────────────────────────────── */
  .gd-pane {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }
  .gd-pane__bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .gd-pane__dot {
    width: 9px;
    height: 9px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.18);
  }
  .gd-pane__name {
    /* 0.72 alpha over --color-inverse clears 4.5:1 in both themes. */
    color: rgba(255, 255, 255, 0.72);
    font-size: 12px;
  }
  .gd-pane__tag {
    margin-left: auto;
    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* CodeMirror host. Background stays transparent so the slab shows through:
     One Dark's own #282c34 is LIGHTER than --color-inverse, and its dimmest
     token only clears 4.5:1 against the darker slab. */
  .gd-editor {
    overflow: hidden;
    padding-inline: 4px;
  }
  .gd-editor :global(.cm-editor) {
    background: transparent;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
  }
  .gd-editor :global(.cm-editor.cm-focused) {
    outline: 2px solid var(--color-link);
    outline-offset: -2px;
  }
  .gd-editor :global(.cm-scroller) {
    overflow: auto;
    min-height: 280px;
    max-height: 480px;
    font-family: var(--font-mono);
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.22) transparent;
  }
  .gd-editor :global(.cm-scroller)::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }
  .gd-editor :global(.cm-scroller)::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-pill);
    border: 3px solid transparent;
    background-clip: content-box;
  }
  .gd-editor :global(.cm-gutters) {
    background: transparent;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
  }
  /* One Dark's gutter foreground is below 4.5:1 on this slab — lift it. */
  .gd-editor :global(.cm-lineNumbers .cm-gutterElement) {
    color: #a9a39a;
  }
  .gd-editor :global(.cm-content) {
    padding: 14px 0 16px;
  }
  .gd-editor :global(.cm-line) {
    padding-inline: 4px;
  }
  /* Invalid input: a hairline red rule down the editor, never a flash. */
  .gd-pane.gd-pane--error .gd-editor :global(.cm-editor) {
    box-shadow: inset 2px 0 0 0 var(--color-error);
  }

  .gd-hint {
    margin-top: 8px;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .gd-hint + .gd-hint {
    margin-top: 4px;
  }
  .gd-hint .code-mono {
    font-size: 12px;
  }
  .gd-kbd {
    border: 1px solid currentColor;
    border-radius: var(--radius-xs);
    padding: 0 3px;
    font-size: 0.85em;
  }

  /* ── Snapshot row ────────────────────────────────────────────────────── */
  .gd-snap-btn {
    flex: 0 0 auto;
    height: 30px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    border: none;
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-size: 12.5px;
    cursor: pointer;
    transition:
      background 0.12s ease,
      box-shadow 0.12s ease;
  }
  .gd-snap-btn:hover {
    background: var(--color-canvas-soft);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .gd-snap-select {
    height: 30px;
    max-width: 220px;
    padding: 0 8px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-size: 12.5px;
  }
  .gd-snap-select:disabled {
    color: var(--color-mute);
    cursor: not-allowed;
  }
  .gd-snap-delete {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition:
      background 0.12s ease,
      color 0.12s ease;
  }
  .gd-snap-delete:hover {
    background: var(--color-error-soft);
    color: var(--color-error-deep);
  }

  /* ── Findings panel ──────────────────────────────────────────────────── */
  .gd-summary {
    min-width: 0;
    text-align: right;
    overflow-wrap: anywhere;
  }
  .gd-results {
    min-height: 120px;
  }
  .gd-copy-status--fail {
    display: block;
    margin-top: 10px;
    font-size: 12px;
    line-height: 18px;
    color: var(--color-error-deep);
  }

  /* ── Runtime-injected markup (Astro scoped styles never reach it) ────── */
  :global(.gd-group) {
    margin-top: 12px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: gd-rise 0.18s ease both;
  }
  :global(.gd-group:first-child) {
    margin-top: 0;
  }
  :global(.gd-group__head) {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 9px 14px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  :global(.gd-group__count) {
    margin-left: auto;
    text-transform: none;
    letter-spacing: 0;
    white-space: nowrap;
  }
  :global(.gd-row) {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 10px 12px 14px;
  }
  :global(.gd-row + .gd-row) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.gd-row__body) {
    min-width: 0;
    flex: 1 1 auto;
  }
  :global(.gd-row__head) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  :global(.gd-pill) {
    flex: 0 0 auto;
    padding: 1px 7px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 16px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  :global(.gd-pill--error) {
    background: var(--color-error-soft);
    color: var(--color-error-deep);
  }
  :global(.gd-pill--warning) {
    background: var(--color-warning-soft);
    color: var(--color-warning-deep);
  }
  :global(.gd-pill--info) {
    background: var(--color-canvas-soft-2);
    color: var(--color-body);
  }
  :global(.gd-rule) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    padding: 1px 7px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft);
    box-shadow: var(--shadow-hairline);
    color: var(--color-brand-strong);
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 16px;
    letter-spacing: 0.03em;
    text-decoration: none;
  }
  :global(.gd-rule:hover) {
    background: var(--color-brand-soft);
    text-decoration: underline;
  }
  :global(.gd-rule:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  :global(.gd-path) {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    color: var(--color-mute);
    overflow-wrap: anywhere;
  }
  :global(.gd-row__title) {
    flex: 1 1 100%;
    margin: 4px 0 0;
    font-size: 13.5px;
    line-height: 19px;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  :global(.gd-fix) {
    display: flex;
    gap: 7px;
    margin-top: 7px;
    padding: 7px 9px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-soft);
    color: var(--color-body);
  }
  :global(.gd-fix__label) {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 17px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent-ink);
  }
  :global(.gd-fix__text) {
    margin: 0;
    min-width: 0;
    font-size: 12.5px;
    line-height: 17px;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  :global(.gd-note) {
    margin: 0;
    padding: 9px 14px;
    font-size: 12px;
    line-height: 17px;
    color: var(--color-mute);
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  :global(.gd-note + .gd-note) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.gd-clean) {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 14px;
    border-radius: var(--radius-md);
    background: var(--color-brand-soft);
    box-shadow: var(--shadow-hairline);
  }
  :global(.gd-clean__icon) {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    color: var(--color-brand-strong);
  }
  :global(.gd-clean__title) {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--color-ink);
  }
  :global(.gd-clean__sub) {
    margin: 2px 0 0;
    font-size: 12.5px;
    line-height: 18px;
    color: var(--color-body);
    text-wrap: pretty;
  }
  :global(.gd-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.gd-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.gd-error__title) {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.gd-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 19px;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  :global(.gd-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 96px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* ── Copy buttons: icon-only per row, labeled in the header ──────────── */
  :global(.gd-copy) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      color 0.12s ease,
      background 0.12s ease;
  }
  :global(.gd-copy:hover) {
    color: var(--color-brand-strong);
    background: var(--color-hairline);
  }
  :global(.gd-copy:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  :global(.gd-copy--labeled) {
    width: auto;
    height: 26px;
    gap: 6px;
    padding: 0 10px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  :global(.gd-copy--copied) {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
  }

  /* Coarse-pointer tap targets, in the two tiers the contract defines: chips
     and icon-only per-row copy buttons at 44px, labeled header copy controls at
     36px (wide text targets, not the primary in-result action). The row's rule
     chip sits at the labeled tier too. */
  @media (pointer: coarse) {
    .gd-chip {
      min-height: 44px;
    }
    :global(.gd-copy) {
      width: 44px;
      height: 44px;
    }
    :global(.gd-copy--labeled) {
      width: auto;
      height: auto;
      min-height: 36px;
    }
    :global(.gd-rule) {
      min-height: 36px;
      padding-inline: 10px;
    }
  }

  @keyframes gd-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.gd-group),
    :global(.gd-clean) {
      animation: none;
    }
  }
</style>

<script>
  import { escapeHtml } from '../lib/escape-html';
  import { copyTextToClipboard } from '../lib/clipboard';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  import type { EditorView } from '@codemirror/view';

  /* ---- Engine contract, mirrored structurally (never statically imported) -- */
  type Severity = 'error' | 'warning' | 'info';
  type Diagnostic = {
    id: string;
    severity: Severity | string;
    path: string;
    message: string;
    hint?: string;
    panelTitle?: string;
  };
  type LintResult = {
    ok: boolean;
    error?: string;
    parseNotes: string[];
    diagnostics: Diagnostic[];
    summary: { errors: number; warnings: number; infos: number };
    stats: {
      schemaVersion: number | null;
      panels: number;
      rows: number;
      varsDefined: number;
      varsUsed: number;
      varsUnresolved: number;
    };
    truncatedRules: { ruleId: string; shown: number; total: number }[];
    truncated: boolean;
    rulesVersion: string;
  };
  type EngineModule = {
    lintDashboard: (text: string) => LintResult;
    summaryLine: (result: LintResult) => string;
  };
  type Example = { id: string; label: string; json: string };

  const ROOT_SEL = '.gd-pg';
  const SLUG = 'grafana-dashboard-validator';
  /* One debounce, at the top of the contract's 130–220ms band: this tool's inputs
     are thousands of lines, so the extra 60ms buys a lot of skipped work. */
  const DEBOUNCE_MS = 220;
  /* Nothing goes red until the typing has been idle this long. */
  const ERROR_HOLD_MS = 600;
  const RESET_MS = 1800;
  /* DOM cap. The engine already caps itself at 50 diagnostics per rule and 400 in
     total; this caps what is RENDERED per severity group, because a 400-row panel
     is what freezes the tab. Each group states what it is hiding. */
  const MAX_ROWS_PER_GROUP = 50;
  /* Parser notes are bounded too — a hostile file can produce one per panel. */
  const MAX_PARSE_NOTES = 8;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.gdWired === 'true') return;
      root.dataset.gdWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          json: typeof o.json === 'string' ? o.json : '',
        } satisfies Example;
      })
      .filter((e) => e.json.length > 0);
  }

  /* ---- Icons (decorative) ------------------------------------------------- */

  const ALERT_SVG =
    '<svg class="gd-error__icon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2.5L18.5 17H1.5z"></path><path d="M10 8v4"></path><path d="M10 14.6v.01"></path></svg>';
  const CHECK_SVG =
    '<svg class="gd-clean__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M7.5 12.5l3 3 6-6.5"></path></svg>';
  const COPY_ICON_SVG =
    '<svg class="gd-copy-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="1.5"/><path d="M3 11H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v1"/></svg>';
  const CHECK_ICON_SVG =
    '<svg class="gd-check-icon hidden" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.5 3.5L13 4.5"/></svg>';

  /* ---- Pure render helpers ------------------------------------------------ */

  const SEV_ORDER: Severity[] = ['error', 'warning', 'info'];
  const SEV_GROUP: Record<Severity, string> = {
    error: 'Errors',
    warning: 'Warnings',
    info: 'Notes',
  };
  const SEV_WORD: Record<Severity, string> = {
    error: 'error',
    warning: 'warning',
    info: 'note',
  };

  function normSeverity(value: string): Severity {
    return value === 'error' || value === 'warning' || value === 'info' ? value : 'info';
  }

  function plural(n: number, word: string): string {
    return `${n} ${word}${n === 1 ? '' : 's'}`;
  }

  /** Rule id → its subsection anchor in the page catalog (`#rule-no-uid`). */
  function ruleAnchor(id: string): string {
    return `#rule-${id.toLowerCase().replace(/[^a-z0-9-]/g, '')}`;
  }

  /** One plain-text line per finding, shaped for a pull-request comment. */
  function rowText(diagnostic: Diagnostic): string {
    const sev = normSeverity(String(diagnostic.severity));
    const where = diagnostic.path ? ` (${diagnostic.path})` : '';
    const fix = diagnostic.hint ? ` — fix: ${diagnostic.hint}` : '';
    return `${SEV_WORD[sev]} ${diagnostic.id}${where}: ${diagnostic.message}${fix}`;
  }

  function rowHtml(diagnostic: Diagnostic, index: number): string {
    const sev = normSeverity(String(diagnostic.severity));
    const rule =
      `<a class="gd-rule" href="${escapeHtml(ruleAnchor(diagnostic.id))}" ` +
      `aria-label="${escapeHtml(diagnostic.id)} rule reference">${escapeHtml(diagnostic.id)}</a>`;
    const path = diagnostic.path
      ? `<span class="gd-path">${escapeHtml(diagnostic.path)}</span>`
      : '';
    const fix = diagnostic.hint
      ? '<div class="gd-fix"><span class="gd-fix__label">Fix</span>' +
        `<p class="gd-fix__text">${escapeHtml(diagnostic.hint)}</p></div>`
      : '';
    return (
      `<div class="gd-row gd-row--${sev}">` +
      '<div class="gd-row__body">' +
      '<div class="gd-row__head">' +
      `<span class="gd-pill gd-pill--${sev}">${escapeHtml(SEV_WORD[sev])}</span>` +
      rule +
      path +
      `<p class="gd-row__title">${escapeHtml(diagnostic.message)}</p>` +
      '</div>' +
      fix +
      '</div>' +
      `<button class="gd-copy" type="button" data-gd-row="${escapeHtml(String(index))}" data-copy="" ` +
      `aria-label="Copy this ${escapeHtml(SEV_WORD[sev])}" title="Copy">` +
      COPY_ICON_SVG +
      CHECK_ICON_SVG +
      '</button></div>'
    );
  }

  function groupHtml(sev: Severity, rows: { diagnostic: Diagnostic; index: number }[]): string {
    const shown = rows.slice(0, MAX_ROWS_PER_GROUP);
    const body = shown.map(({ diagnostic, index }) => rowHtml(diagnostic, index)).join('');
    const cap =
      rows.length > shown.length
        ? `<p class="gd-note">Showing the first ${shown.length} of ${rows.length} ` +
          `${SEV_WORD[sev]}s. Fix these and re-run to see the rest.</p>`
        : '';
    return (
      '<div class="gd-group">' +
      `<p class="gd-group__head"><span>${escapeHtml(SEV_GROUP[sev])}</span>` +
      `<span class="gd-group__count">${escapeHtml(String(rows.length))}</span></p>` +
      body +
      cap +
      '</div>'
    );
  }

  /** What the parser had to tolerate. Never hidden: Grafana is not this lenient. */
  function parseNotesHtml(result: LintResult): string {
    if (result.parseNotes.length === 0) return '';
    const shown = result.parseNotes.slice(0, MAX_PARSE_NOTES);
    const notes = shown.map((note) => `<p class="gd-note">${escapeHtml(note)}</p>`);
    if (result.parseNotes.length > shown.length) {
      notes.push(
        `<p class="gd-note">…and ${escapeHtml(
          String(result.parseNotes.length - shown.length),
        )} more parser notes.</p>`,
      );
    }
    return (
      '<div class="gd-group"><p class="gd-group__head"><span>Read as</span></p>' +
      notes.join('') +
      '</div>'
    );
  }

  /** Engine-level caps, stated rather than hidden. */
  function truncationHtml(result: LintResult): string {
    const notes: string[] = [];
    for (const rule of result.truncatedRules.slice(0, 6)) {
      notes.push(
        `${escapeHtml(rule.ruleId)} matched ${escapeHtml(String(rule.total))} places; the first ` +
          `${escapeHtml(String(rule.shown))} are listed.`,
      );
    }
    if (result.truncatedRules.length > 6) {
      notes.push(`…and ${escapeHtml(String(result.truncatedRules.length - 6))} more capped rules.`);
    }
    if (result.truncated) {
      notes.push(
        'This dashboard produced more findings than one report can usefully hold, so the list ' +
          'stops here.',
      );
    }
    if (notes.length === 0) return '';
    return `<div class="gd-group"><p class="gd-group__head"><span>Limits</span></p>${notes
      .map((n) => `<p class="gd-note">${n}</p>`)
      .join('')}</div>`;
  }

  function cleanHtml(result: LintResult, ruleCount: number): string {
    const scope =
      result.stats.rows > 0
        ? `${plural(result.stats.panels, 'panel')} in ${plural(result.stats.rows, 'row')}`
        : plural(result.stats.panels, 'panel');
    return (
      '<div class="gd-clean">' +
      CHECK_SVG +
      '<div><p class="gd-clean__title">No findings — this dashboard imports cleanly.</p>' +
      `<p class="gd-clean__sub">All ${escapeHtml(String(ruleCount))} rules ran over ${escapeHtml(
        scope,
      )} and none of them matched. The rule catalog below lists exactly what was checked — and ` +
      'what this linter deliberately does not check.</p></div></div>'
    );
  }

  function errorCardHtml(message: string, isAlert: boolean): string {
    return (
      `<div class="gd-error"${isAlert ? ' role="alert"' : ''}>` +
      ALERT_SVG +
      '<div><p class="gd-error__title">This is not a dashboard this linter can read</p>' +
      `<p id="gd-error-detail" class="gd-error__detail">${escapeHtml(message)}</p></div></div>`
    );
  }

  /** The plain-text report behind "Copy report" — built for a review comment. */
  function reportText(result: LintResult, summary: string): string {
    const lines = [`Grafana Dashboard Validator — ${summary}`, `Rules: ${result.rulesVersion}`, ''];
    if (result.parseNotes.length > 0) {
      lines.push('READ AS');
      for (const note of result.parseNotes) lines.push(`  ${note}`);
      lines.push('');
    }
    for (const sev of SEV_ORDER) {
      const group = result.diagnostics.filter((d) => normSeverity(String(d.severity)) === sev);
      if (group.length === 0) continue;
      lines.push(`${SEV_GROUP[sev].toUpperCase()} (${group.length})`);
      for (const diagnostic of group) lines.push(`  ${rowText(diagnostic)}`);
      lines.push('');
    }
    if (result.diagnostics.length === 0) lines.push('No findings.', '');
    for (const rule of result.truncatedRules) {
      lines.push(`Note: ${rule.ruleId} matched ${rule.total} places; ${rule.shown} listed.`);
    }
    if (result.truncated) lines.push('Note: the finding list was capped.');
    lines.push(
      'Checked client-side at opscanopy.com/grafana-dashboard-validator/ — 0 bytes uploaded.',
    );
    return lines.join('\n');
  }

  /* ---- Instance init ----------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const editorHost = el<HTMLElement>(root, '#gd-input');
    const paneEl = el<HTMLElement>(root, '.gd-pane');
    const resultsBox = el<HTMLElement>(root, '#gd-results');
    const summaryEl = el<HTMLElement>(root, '#gd-summary');
    const copyAllBtn = el<HTMLButtonElement>(root, '#gd-copy-all');
    const copyStatus = el<HTMLElement>(root, '#gd-copy-status');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#gd-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#gd-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#gd-snap-delete');
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('#gd-chips .gd-chip'));

    if (
      !editorHost ||
      !paneEl ||
      !resultsBox ||
      !summaryEl ||
      !copyAllBtn ||
      !copyStatus ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    /* ---- Copy plumbing --------------------------------------------------- */

    function setCopyStatus(message: string, failed: boolean): void {
      copyStatus!.textContent = message;
      copyStatus!.classList.toggle('sr-only', !failed);
      copyStatus!.classList.toggle('gd-copy-status--fail', failed);
    }

    function setCopied(btn: HTMLButtonElement, copied: boolean): void {
      btn.classList.toggle('gd-copy--copied', copied);
      btn.querySelector('.gd-copy-icon')?.classList.toggle('hidden', copied);
      btn.querySelector('.gd-check-icon')?.classList.toggle('hidden', !copied);
      const label = btn.querySelector<HTMLElement>('.gd-copy-label');
      if (label) {
        label.textContent = copied ? 'Copied' : (btn.dataset.copyLabel ?? 'Copy');
      } else if (copied) {
        btn.dataset.prevAriaLabel = btn.getAttribute('aria-label') ?? '';
        btn.setAttribute('aria-label', 'Copied');
      } else if (btn.dataset.prevAriaLabel) {
        btn.setAttribute('aria-label', btn.dataset.prevAriaLabel);
        delete btn.dataset.prevAriaLabel;
      }
    }

    async function handleCopy(btn: HTMLButtonElement): Promise<void> {
      const ok = await copyTextToClipboard(btn.dataset.copy ?? '');
      if (ok) {
        setCopied(btn, true);
        setCopyStatus('Copied to clipboard.', false);
        window.clearTimeout(Number(btn.dataset.copyTimer));
        btn.dataset.copyTimer = String(
          window.setTimeout(() => {
            setCopied(btn, false);
            if (copyStatus!.textContent === 'Copied to clipboard.') setCopyStatus('', false);
          }, RESET_MS),
        );
      } else {
        setCopyStatus('Copy failed — select the value manually.', true);
      }
    }

    root.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const copyBtn = target.closest<HTMLButtonElement>('.gd-copy');
      if (copyBtn && root.contains(copyBtn)) void handleCopy(copyBtn);
    });

    /* ---- Lazy engine + examples + CodeMirror ----------------------------- */

    let engine: EngineModule;
    let examples: Example[] = [];
    let ruleCount = 22;
    let EditorState: typeof import('@codemirror/state').EditorState;
    let EditorViewCtor: typeof import('@codemirror/view').EditorView;
    let keymap: typeof import('@codemirror/view').keymap;
    let lineNumbers: typeof import('@codemirror/view').lineNumbers;
    let highlightActiveLine: typeof import('@codemirror/view').highlightActiveLine;
    let defaultKeymap: typeof import('@codemirror/commands').defaultKeymap;
    // Named `cmHistory`, not `history`: a bare `history` would shadow
    // `window.history`.
    let cmHistory: typeof import('@codemirror/commands').history;
    let historyKeymap: typeof import('@codemirror/commands').historyKeymap;
    let indentWithTab: typeof import('@codemirror/commands').indentWithTab;
    let json: typeof import('@codemirror/lang-json').json;
    let oneDark: typeof import('@codemirror/theme-one-dark').oneDark;

    try {
      const [engineMod, examplesMod, stateMod, viewMod, commandsMod, jsonMod, themeMod] =
        await Promise.all([
          import('../lib/grafana-dashboard-validator/engine'),
          import('../lib/grafana-dashboard-validator/examples'),
          import('@codemirror/state'),
          import('@codemirror/view'),
          import('@codemirror/commands'),
          import('@codemirror/lang-json'),
          import('@codemirror/theme-one-dark'),
        ]);
      engine = engineMod as unknown as EngineModule;
      const ids = (engineMod as { RULE_IDS?: readonly string[] }).RULE_IDS;
      if (Array.isArray(ids) && ids.length > 0) ruleCount = ids.length;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
      ({ EditorState } = stateMod);
      ({ EditorView: EditorViewCtor, keymap, lineNumbers, highlightActiveLine } = viewMod);
      ({ history: cmHistory, defaultKeymap, historyKeymap, indentWithTab } = commandsMod);
      ({ json } = jsonMod);
      ({ oneDark } = themeMod);
    } catch (err) {
      summaryEl.textContent = '';
      resultsBox.innerHTML = errorCardHtml(
        'The validator engine failed to load. Reload the page to try again.',
        true,
      );
      console.error('[GrafanaDashboardValidator] engine/CodeMirror import failed:', err);
      return;
    }

    /* ---- State ----------------------------------------------------------- */

    type EvalSource = 'type' | 'commit' | 'seed';
    type UiState = 'empty' | 'valid' | 'pending' | 'invalid';

    let uiState: UiState = 'empty';
    let evalTimer: number | undefined;
    let errTimer: number | undefined;
    let liveReady = false;

    function clearTimers(): void {
      window.clearTimeout(evalTimer);
      window.clearTimeout(errTimer);
    }

    /* ---- Editor ---------------------------------------------------------- */

    function makeEditor(host: HTMLElement, doc: string): EditorView {
      const state = EditorState.create({
        doc,
        extensions: [
          lineNumbers(),
          cmHistory(),
          highlightActiveLine(),
          json(),
          oneDark,
          EditorViewCtor.lineWrapping,
          // CodeMirror puts role="textbox" on the content DOM; without a name
          // that is an unlabelled input field for a screen reader (and an axe
          // violation). aria-describedby points at the live-eval hint line.
          EditorViewCtor.contentAttributes.of({
            'aria-label': 'Grafana dashboard JSON input',
            'aria-describedby': 'gd-run-hint',
          }),
          keymap.of([
            // Ours FIRST, so they win over defaultKeymap's Enter/Escape.
            {
              key: 'Mod-Enter',
              run: () => {
                clearTimers();
                evaluate('commit');
                view.contentDOM.blur();
                return true;
              },
            },
            {
              // Plain Enter must still insert the newline, so this returns false
              // and lets insertNewlineAndIndent run — the eval is flushed on the
              // next tick, once the document includes the newline.
              key: 'Enter',
              run: () => {
                window.setTimeout(() => {
                  clearTimers();
                  evaluate('commit');
                }, 0);
                return false;
              },
            },
            {
              // The Tab-trap escape hatch: indentWithTab means Tab indents, so
              // Escape is the documented way out of the editor.
              key: 'Escape',
              run: (v) => {
                v.contentDOM.blur();
                return true;
              },
            },
            ...defaultKeymap,
            ...historyKeymap,
            indentWithTab,
          ]),
          EditorViewCtor.updateListener.of((u) => {
            if (!u.docChanged || !liveReady) return;
            clearChips();
            clearTimers();
            evalTimer = window.setTimeout(() => evaluate('type'), DEBOUNCE_MS);
          }),
          EditorViewCtor.theme({
            '&': { color: '#eae7e0' },
            '.cm-content': { caretColor: '#eae7e0' },
            '.cm-cursor, .cm-dropCursor': { borderLeftColor: '#eae7e0' },
            '&.cm-focused .cm-selectionBackground, .cm-selectionBackground, ::selection': {
              backgroundColor: 'rgba(79, 138, 200, 0.34)',
            },
            '.cm-activeLine': { backgroundColor: 'rgba(255, 255, 255, 0.04)' },
            '.cm-activeLineGutter': { backgroundColor: 'transparent' },
          }),
        ],
      });
      return new EditorViewCtor({ state, parent: host });
    }

    function setEditorDoc(doc: string): void {
      view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: doc } });
      view.requestMeasure();
    }

    /* ---- Chrome ---------------------------------------------------------- */

    function setSummary(text: string, isError: boolean): void {
      summaryEl!.textContent = text;
      summaryEl!.classList.toggle('text-error-deep', isError);
      summaryEl!.classList.toggle('text-mute', !isError);
    }

    function setErrorState(on: boolean): void {
      paneEl!.classList.toggle('gd-pane--error', on);
      if (on) {
        view.contentDOM.setAttribute('aria-invalid', 'true');
        view.contentDOM.setAttribute('aria-describedby', 'gd-run-hint gd-error-detail');
      } else {
        view.contentDOM.removeAttribute('aria-invalid');
        view.contentDOM.setAttribute('aria-describedby', 'gd-run-hint');
      }
    }

    function hideActions(): void {
      copyAllBtn!.hidden = true;
      copyAllBtn!.dataset.copy = '';
    }

    function setActiveChip(idx: number | null): void {
      chips.forEach((chip) => {
        chip.setAttribute(
          'aria-pressed',
          idx !== null && chip.dataset.exampleIdx === String(idx) ? 'true' : 'false',
        );
      });
    }

    function clearChips(): void {
      setActiveChip(null);
    }

    /* ---- Render ---------------------------------------------------------- */

    function renderEmpty(): void {
      uiState = 'empty';
      setErrorState(false);
      hideActions();
      setSummary('', false);
      resultsBox!.innerHTML =
        '<p class="gd-empty body-sm text-mute">Paste a Grafana dashboard JSON above — or tap an ' +
        'example — to see every finding here, with the JSON path it lives at and the fix.</p>';
    }

    function renderResult(result: LintResult, summary: string): void {
      const indexed = result.diagnostics.map((diagnostic, index) => ({ diagnostic, index }));
      const groups = SEV_ORDER.map((sev) =>
        indexed.filter(({ diagnostic }) => normSeverity(String(diagnostic.severity)) === sev),
      );
      const body =
        result.diagnostics.length === 0
          ? cleanHtml(result, ruleCount)
          : groups
              .map((group, i) => (group.length > 0 ? groupHtml(SEV_ORDER[i], group) : ''))
              .join('');
      resultsBox!.innerHTML = parseNotesHtml(result) + body + truncationHtml(result);

      // Multi-line and quote-bearing payloads round-trip badly through HTML
      // attributes, so per-row copy text is assigned on the live elements.
      resultsBox!.querySelectorAll<HTMLButtonElement>('[data-gd-row]').forEach((btn) => {
        const diagnostic = result.diagnostics[Number(btn.dataset.gdRow)];
        if (diagnostic) btn.dataset.copy = rowText(diagnostic);
      });

      copyAllBtn!.hidden = false;
      copyAllBtn!.dataset.copy = reportText(result, summary);
    }

    function showError(message: string, source: EvalSource): void {
      uiState = 'invalid';
      clearTimers();
      setErrorState(true);
      hideActions();
      setSummary('Could not lint', true);
      resultsBox!.innerHTML = errorCardHtml(message, source === 'commit');
    }

    function evaluate(source: EvalSource): void {
      clearTimers();
      const text = view.state.doc.toString();
      if (text.trim() === '') {
        renderEmpty();
        return;
      }

      let result: LintResult | null = null;
      try {
        result = engine.lintDashboard(text);
      } catch (err) {
        console.error('[GrafanaDashboardValidator] lintDashboard threw:', err);
        result = null;
      }

      if (result && result.ok) {
        uiState = 'valid';
        setErrorState(false);
        let summary = '';
        try {
          summary = engine.summaryLine(result);
        } catch {
          summary = plural(result.diagnostics.length, 'finding');
        }
        renderResult(result, summary);
        setSummary(summary, result.summary.errors > 0);
        // Gated on BOTH a fully valid lint AND a user-initiated eval: a boot seed
        // must never write the restore store. There is no hash to write — this
        // tool ships no payload deep link at all.
        if (source !== 'seed') recordToolLastInput(SLUG, text);
        return;
      }

      const message =
        result?.error ??
        'This dashboard could not be read. Check it against the reference on this page.';

      if (source !== 'type') {
        showError(message, source);
        return;
      }

      // Mid-typing: hold the previous panel, nothing goes red yet. The error only
      // surfaces once the typing has been idle for ERROR_HOLD_MS.
      uiState = 'pending';
      setErrorState(false);
      hideActions();
      setSummary('', false);
      errTimer = window.setTimeout(() => showError(message, 'type'), ERROR_HOLD_MS);
    }

    /* ---- Seed (before any listener fires) -------------------------------- */

    const firstExample = examples[0];
    let seedText = firstExample?.json ?? '';
    let seedChip: number | null = firstExample ? 0 : null;

    // No fragment is ever read: a dashboard cannot fit in one, so an `#…=`
    // payload here would always be somebody else's key.
    const restored = getRestoredLastInput(SLUG);
    if (restored && restored.trim() !== '') {
      seedText = restored;
      seedChip = null;
    }

    const view = makeEditor(editorHost, seedText);
    setActiveChip(seedChip);

    /* ---- Events ---------------------------------------------------------- */

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        liveReady = false;
        setEditorDoc(examples[idx].json);
        liveReady = true;
        setActiveChip(idx);
        clearTimers();
        evaluate('commit');
      });
    });

    // Committing on blur means a half-typed file the user tabbed away from still
    // explains itself, instead of sitting silently in `pending`.
    view.contentDOM.addEventListener('blur', () => {
      if (uiState === 'pending') {
        clearTimers();
        evaluate('commit');
      }
    });

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => view.state.doc.toString(),
      setValue: (value) => {
        liveReady = false;
        setEditorDoc(value);
        liveReady = true;
        clearChips();
        clearTimers();
        evaluate('commit');
      },
    });

    /* ---- First render: never records the restore store ------------------- */

    evaluate('seed');
    liveReady = true;
    requestAnimationFrame(() => view.requestMeasure());
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
