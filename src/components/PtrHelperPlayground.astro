---
/**
 * PtrHelperPlayground — the interactive Reverse DNS / PTR Helper island.
 *
 * Single-input, live tool: type an IP address or IP/prefix and the PTR record
 * name, reverse-delegation zone, and a ready-to-run `dig -x` command are
 * rendered. No button.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar, ResultPanel (figure cap, live summary, copy status)
 * and CopyButton. The results container stays here, seeded with
 * `set:html` + `data-results`; its slab overrides anchor on `.ptr-results`.
 *
 * Runtime contract (lazy-imported):
 *   ../lib/ptr-helper/engine   → generate(input: string): PtrResult
 *   ../lib/ptr-helper/examples → examples: { id; label; input }[]
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. Only the labels
// are read here; the chips are never rebuilt at hydration — the script wires
// clicks and reads `data-example-idx` into the lazily-imported `examples`,
// so this adds nothing to the client bundle.
import { examples as prerenderedExamples } from '../lib/ptr-helper/examples';
import { generate } from '../lib/ptr-helper/engine';
import { resultHtml, summaryText, EMPTY_HTML } from '../lib/ptr-helper/render';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-computes the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees a real worked answer
 * instead of an empty "type an address" panel.
 *
 * `generate` is pure and synchronous, so it runs at build time unchanged.
 */
const seedExample = prerenderedExamples[0];
const seedResult = seedExample ? generate(seedExample.input) : null;
const seedHtml = seedResult && seedResult.valid ? resultHtml(seedResult) : EMPTY_HTML;
const seedSummary = seedResult && seedResult.valid ? summaryText(seedResult) : '';
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="ptr-pg" aria-label="Reverse DNS / PTR Helper playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow shrink-0">Example</span>
      {/* Server-rendered chips: the labels are in the static HTML, and the
          hydration script only wires the clicks. */}
      <ExampleChips prefix="ptr" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
    </div>

    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <label class="eyebrow mb-2 block" for="ptr-input">IP address or CIDR <span class="ptr-sample-cue">(sample)</span></label>
      <div class="ptr-input-wrap">
        <svg
          class="ptr-input-icon pointer-events-none"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 10h12M10 4v12"></path>
          <circle cx="10" cy="10" r="7.25"></circle>
        </svg>
        <input
          id="ptr-input"
          type="text"
          class="ptr-input code-mono"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          placeholder="192.0.2.1"
          value={seedExample?.input}
          aria-describedby="ptr-input-hint ptr-run-hint"
        />
      </div>
      <p id="ptr-input-hint" class="ptr-hint caption text-mute">
        IPv4 or IPv6 — host <span class="code-mono">192.0.2.1</span> or
        <span class="code-mono">2001:db8::1</span>. Add a prefix like
        <span class="code-mono">192.0.2.0/24</span> to get the reverse zone.
      </p>
      <RunHint id="ptr-run-hint" />
      <SnapshotBar prefix="ptr" />
    </div>

    {/* ── Results panel — the L2 instrument (dark in both themes) under its
        figure cap; the live summary reads out in the cap's actions slot. ── */}
    <ResultPanel
      slug="reverse-dns-ptr"
      prefix="ptr"
      summary={seedSummary}
      summaryClass="whitespace-nowrap"
      split
    >
      <Fragment slot="actions">
        <CopyButton kind="link" id="ptr-share" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the answer is in the
          static HTML; the client replaces it with the same markup on boot. */}
      <div id="ptr-results" class="ptr-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .ptr-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .ptr-input-icon {
    position: absolute;
    left: 14px;
    width: 18px;
    height: 18px;
    color: var(--color-mute);
    pointer-events: none;
  }
  .ptr-input {
    width: 100%;
    height: var(--control-h-lg);
    padding: 0 16px 0 42px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 15px;
    line-height: 24px;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .ptr-input::placeholder {
    color: var(--color-mute);
  }
  .ptr-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .ptr-input:focus {
    outline: none;
  }
  .ptr-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .ptr-input.ptr-input--error {
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  .ptr-input.ptr-input--error:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-error);
  }
  .ptr-sample-cue {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-mute);
    font-family: var(--font-sans);
  }
  .ptr-sample-cue.is-hidden {
    display: none;
  }
  .ptr-hint {
    margin-top: 8px;
    text-wrap: pretty;
  }
  .ptr-results {
    min-height: var(--control-h-lg);
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.ptr-results` container (the panel
     wrapper is ResultPanel's and carries no scope attribute). */
  :global(.ptr-card) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: ptr-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.ptr-title) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-mute);
  }
  :global(.ptr-title__badge) {
    flex: 0 0 auto;
    font-size: 11px;
    line-height: 16px;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
  }
  :global(.ptr-row) {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr) auto;
    gap: 12px;
    padding: 9px 14px;
    align-items: center;
  }
  :global(.ptr-row + .ptr-row) {
    border-top: 1px solid var(--color-hairline);
  }
  /* Row-key role (label-field): mono 11/16 uppercase, the only label. */
  :global(.ptr-row__k) {
    @apply label-field;
  }
  :global(.ptr-row__v) {
    min-width: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-word;
  }
  :global(.ptr-row__v.is-mono) {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  /* ── Per-row copy buttons (render.ts `button[data-copy-value]`; the
     script adopts them into the kit's copy cycle, copy.ts drives them) ── */
  :global(.ptr-copy-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background var(--dur-fast) var(--ease-brand),
      color var(--dur-fast) var(--ease-brand);
  }
  :global(.ptr-copy-btn:hover) {
    background: var(--color-canvas-soft);
    color: var(--color-ink);
  }
  :global(.ptr-copy-btn:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  :global(.ptr-copy-btn[data-copied]) {
    color: var(--color-brand-strong);
  }
  :global(.ptr-copy-btn svg) {
    pointer-events: none;
  }
  @media (pointer: coarse) {
    :global(.ptr-copy-btn) {
      width: var(--control-h-lg);
      height: var(--control-h-lg);
    }
  }

  @keyframes ptr-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.ptr-card) {
      animation: none;
    }
  }

  :global(.ptr-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.ptr-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.ptr-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.ptr-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.ptr-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below it uses the slab ink tier; the light rules
     above remain the documented defaults. ──────────────────────────────── */
  .ptr-results :global(.ptr-empty),
  .ptr-results :global(.ptr-card) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .ptr-results :global(.ptr-empty) {
    color: var(--color-inverse-mute);
  }
  .ptr-results :global(.ptr-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .ptr-results :global(.ptr-title) {
    border-bottom-color: var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .ptr-results :global(.ptr-title__badge) {
    background: #8fc97a1f;
    color: var(--color-inverse-brand);
  }
  .ptr-results :global(.ptr-row + .ptr-row) {
    border-top-color: #ffffff12;
  }
  .ptr-results :global(.ptr-row__k) {
    color: var(--color-inverse-mute);
  }
  .ptr-results :global(.ptr-row__v) {
    color: var(--color-inverse-fg);
  }
  .ptr-results :global(.ptr-copy-btn) {
    color: var(--color-inverse-mute);
  }
  .ptr-results :global(.ptr-copy-btn:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .ptr-results :global(.ptr-copy-btn[data-copied]) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
</style>

<script>
  import {
    EMPTY_HTML,
    CHECK_SVG,
    errorHtml,
    resultHtml,
    summaryText,
  } from '../lib/ptr-helper/render';
  import { wireRunKeys } from '../lib/run-keys';
  import { buildIpHash, readIpHash } from '../lib/ip-hash';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  import type { PtrResult as Result } from '../lib/ptr-helper/types';

  type Example = { id: string; label: string; input: string };
  type EngineModule = { generate: (input: string) => Result };

  const ROOT_SEL = '.ptr-pg';
  const DEBOUNCE_MS = 140;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.ptrWired === 'true') return;
      root.dataset.ptrWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          input: typeof o.input === 'string' ? o.input : '',
        } satisfies Example;
      })
      .filter((e) => e.input.length > 0);
  }

  /**
   * render.ts emits each row's copy button as `button[data-copy-value]` with a
   * bare icon. Adopt it into the kit's copy cycle on the live element: the
   * payload moves to `data-copy`, the icon gains the `data-copy-icon` hook and
   * a hidden `data-check-icon` is appended for the success swap. Client-only,
   * so the seeded HTML (and render.ts) stay unchanged.
   */
  function adoptRowCopyButtons(container: HTMLElement): void {
    container.querySelectorAll<HTMLButtonElement>('button[data-copy-value]').forEach((btn) => {
      btn.dataset.copy = btn.dataset.copyValue ?? '';
      btn.querySelector('svg')?.setAttribute('data-copy-icon', '');
      if (btn.querySelector('[data-check-icon]')) return;
      btn.insertAdjacentHTML('beforeend', CHECK_SVG);
      const check = btn.lastElementChild;
      check?.setAttribute('data-check-icon', '');
      check?.classList.add('hidden');
    });
  }

  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = EMPTY_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    setSummary(summary, 'Invalid', true);
    container.innerHTML = errorHtml(message);
  }

  function renderResult(container: HTMLElement, summary: HTMLElement, result: Result): void {
    setSummary(summary, summaryText(result), false);
    container.innerHTML = resultHtml(result);
    adoptRowCopyButtons(container);
  }

  async function init(root: HTMLElement): Promise<void> {
    const input = el<HTMLInputElement>(root, '#ptr-input');
    const chipsWrap = el<HTMLElement>(root, '#ptr-chips');
    const resultsBox = el<HTMLElement>(root, '#ptr-results');
    const summaryEl = el<HTMLElement>(root, '#ptr-summary');
    const copyStatus = el<HTMLElement>(root, '#ptr-copy-status');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#ptr-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#ptr-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#ptr-snap-delete');
    if (
      !input ||
      !chipsWrap ||
      !resultsBox ||
      !summaryEl ||
      !copyStatus ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    // Row copy and Copy link: the kit's delegated copy listener; outcomes
    // announced in #ptr-copy-status.
    wireCopyButtons(root, { status: copyStatus });

    let engine: EngineModule;
    let examples: Example[] = [];
    try {
      const [engineMod, examplesMod] = await Promise.all([
        import('../lib/ptr-helper/engine'),
        import('../lib/ptr-helper/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
    } catch (err) {
      renderError(resultsBox, summaryEl, 'The PTR helper engine failed to load. Reload the page to try again.');
      console.error('[PtrHelper] engine import failed:', err);
      return;
    }

    // The chips are already in the static HTML (server-rendered from the same
    // `examples` module); hydration only wires them.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));
    if (!examples.length) chips.forEach((chip) => { chip.disabled = true; });

    /** Press one chip (or none, when the input came from a hash/restore). */
    function setActiveChip(idx: number | null): void {
      syncChipsByIndex(chipsWrap, idx);
    }

    /* ---- Share link / #ip= deep link ---------------------------------- */
    /* The tool already READ #ip= on boot (written by the sibling networking
       tools) but never wrote one, so a result here could not be linked to.
       Same contract as the cidr-checker: only user-initiated evaluations touch
       the hash — a boot seed or a restored input must not rewrite the URL. */
    const shareBtn = root.querySelector<HTMLButtonElement>('#ptr-share');
    let lastWrittenHash: string | null = null;

    function writeHash(value: string | null): void {
      const target = value ? buildIpHash(value) : '';
      if (target === lastWrittenHash) return;
      // Safari throttles replaceState (~100/30s) and throws — never let that
      // break typing.
      try {
        if (value) {
          history.replaceState(null, '', target);
        } else {
          history.replaceState(null, '', location.pathname + location.search);
        }
        lastWrittenHash = target;
      } catch {
        /* ignore */
      }
    }

    function hideShare(): void {
      if (!shareBtn) return;
      shareBtn.hidden = true;
      shareBtn.dataset.copy = '';
    }

    function showShare(value: string): void {
      if (!shareBtn) return;
      shareBtn.hidden = false;
      shareBtn.dataset.copy = location.origin + location.pathname + location.search + buildIpHash(value);
    }

    function evaluate(userInitiated = false): void {
      const value = input!.value.trim();
      if (value.length === 0) {
        input!.classList.remove('ptr-input--error');
        renderEmpty(resultsBox!, summaryEl!);
        hideShare();
        if (userInitiated) writeHash(null);
        return;
      }
      let result: Result | null = null;
      try {
        result = engine.generate(value);
      } catch {
        input!.classList.add('ptr-input--error');
        renderError(resultsBox!, summaryEl!, 'Unexpected error while generating the PTR record.');
        hideShare();
        if (userInitiated) writeHash(null);
        return;
      }
      if (!result || result.valid === false) {
        input!.classList.add('ptr-input--error');
        renderError(resultsBox!, summaryEl!, result?.error ?? 'This is not a valid IP address or CIDR.');
        hideShare();
        if (userInitiated) writeHash(null);
        return;
      }
      input!.classList.remove('ptr-input--error');
      renderResult(resultsBox!, summaryEl!, result);
      showShare(value);
      if (userInitiated) writeHash(value);
      // A boot seed (example, #ip= or restored input) is not user input: only
      // a user-initiated evaluation records the last input (CLAUDE.md, "A
      // seeded boot is not user input").
      if (userInitiated) recordToolLastInput('reverse-dns-ptr', value);
    }

    let timer: number | undefined;
    function scheduleEvaluate(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => evaluate(true), DEBOUNCE_MS);
    }

    const sampleCue = root.querySelector<HTMLElement>('.ptr-sample-cue');
    input.addEventListener('input', () => {
      setActiveChip(null);
      if (sampleCue) sampleCue.classList.add('is-hidden');
      scheduleEvaluate();
    });

    wireRunKeys(input, () => {
      window.clearTimeout(timer);
      evaluate(true);
    });
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        input.value = examples[idx].input;
        setActiveChip(idx);
        window.clearTimeout(timer);
        evaluate(true);
      });
    });

    wireSnapshotUI({
      slug: 'reverse-dns-ptr',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => input!.value.trim(),
      setValue: (value) => {
        input!.value = value;
        setActiveChip(null);
        if (sampleCue) sampleCue.classList.add('is-hidden');
        window.clearTimeout(timer);
        evaluate(true);
      },
    });

    // Seed priority: #ip=<address> deep link (written by the IP Address
    // Converter) > restored last input > seeded example.
    const shared = readIpHash();
    const restored = getRestoredLastInput('reverse-dns-ptr');
    const seed = examples[0];
    if (shared) {
      input.value = shared;
      setActiveChip(null);
      if (sampleCue) sampleCue.classList.add('is-hidden');
      evaluate();
    } else if (restored) {
      input.value = restored;
      setActiveChip(null);
      if (sampleCue) sampleCue.classList.add('is-hidden');
      evaluate();
    } else if (seed) {
      input.value = seed.input;
      setActiveChip(0);
      evaluate();
    } else {
      setActiveChip(null);
      renderEmpty(resultsBox, summaryEl);
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
