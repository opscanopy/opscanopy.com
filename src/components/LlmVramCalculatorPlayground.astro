---
/**
 * LlmVramCalculatorPlayground — the interactive LLM VRAM Calculator island.
 *
 * Two chip groups on paper (model presets + Custom, quantization), two slider
 * rows (parameters in billions, context length over seven stops) each paired
 * with a number input, then the L2 result slab: a stacked bar (weights / KV
 * cache / overhead), stat rows and the GPU-tier list — all emitted by
 * render.ts, shared with the SSR seed below so the two can never drift.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar, ResultPanel and CopyButton. Slab overrides anchor on
 * this component's own `.lvc-results`.
 *
 * Runtime contract (engine lazy-imported for code-splitting):
 *   ../lib/llm-vram-calculator/engine → estimate(input: VramInput): VramResult
 *   deep link: #m=<params>|<quant>|<context>|<preset>
 */
import { estimate, QUANTS } from '../lib/llm-vram-calculator/engine';
import { PRESETS } from '../lib/llm-vram-calculator/presets';
import { examples } from '../lib/llm-vram-calculator/examples';
import { resultHtml, summaryText, EMPTY_HTML } from '../lib/llm-vram-calculator/render';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/** Context slider stops (tokens); the range input carries the index. */
const CONTEXT_STOPS = [2048, 4096, 8192, 16384, 32768, 65536, 131072];

/* Server-rendered seed from examples[0] — pure, synchronous, no clock. */
const seed = examples[0].input;
const seedResult = estimate(seed);
const seedHtml = seedResult.valid ? resultHtml(seedResult) : EMPTY_HTML;
const seedSummary = seedResult.valid ? summaryText(seedResult) : '';

const modelChips = [
  ...PRESETS.map((p) => ({
    label: p.name,
    input: p.slug,
    ariaLabel: `${p.name} — ${p.params} B parameters`,
    data: { params: String(p.params), 'max-context': String(p.maxContext) },
  })),
  { label: 'Custom', input: 'custom', ariaLabel: 'Custom parameter count' },
];
const seedModelIdx = PRESETS.findIndex((p) => p.slug === seed.preset);
const quantChips = QUANTS.map((q) => ({ label: q.label, input: q.id, ariaLabel: `${q.label} — ${q.bpw} bits per weight` }));
const seedQuantIdx = QUANTS.findIndex((q) => q.id === seed.quant);
const seedCtxIdx = Math.max(0, CONTEXT_STOPS.indexOf(seed.context));
const fmtTokens = (n: number) => `${n.toLocaleString('en-US')} tokens`;
---

<section class="lvc-pg" aria-label="LLM VRAM Calculator playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Model presets ──────────────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow" id="lvc-model-label">Model</span>
      <ExampleChips prefix="lvc" id="lvc-model-chips" items={modelChips} active={seedModelIdx >= 0 ? seedModelIdx : modelChips.length - 1} labelledby="lvc-model-label" />
    </div>

    {/* ── Quantization ───────────────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow" id="lvc-quant-label">Quantization</span>
      <ExampleChips prefix="lvc" id="lvc-quant-chips" items={quantChips} active={seedQuantIdx >= 0 ? seedQuantIdx : 0} labelledby="lvc-quant-label" />
    </div>

    {/* ── Sliders ────────────────────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <div class="lvc-field">
        <label class="eyebrow" for="lvc-params-range">Parameters (billions)</label>
        <input
          id="lvc-params-range"
          class="lvc-range"
          type="range"
          min="1"
          max="405"
          step="1"
          value={String(Math.round(seed.params))}
          aria-valuetext={`${seed.params} B parameters`}
        />
        <input
          id="lvc-params"
          class="lvc-num code-mono"
          type="number"
          inputmode="decimal"
          min="0.1"
          max="405"
          step="any"
          value={String(seed.params)}
          aria-label="Parameters in billions"
          aria-describedby="lvc-run-hint"
        />
      </div>
      <div class="lvc-field mt-4">
        <label class="eyebrow" for="lvc-context-range">Context length (tokens)</label>
        <input
          id="lvc-context-range"
          class="lvc-range"
          type="range"
          min="0"
          max={String(CONTEXT_STOPS.length - 1)}
          step="1"
          value={String(seedCtxIdx)}
          aria-valuetext={fmtTokens(seed.context)}
          list="lvc-context-stops"
        />
        <datalist id="lvc-context-stops">
          {CONTEXT_STOPS.map((_, i) => <option value={String(i)}></option>)}
        </datalist>
        <input
          id="lvc-context"
          class="lvc-num code-mono"
          type="number"
          inputmode="numeric"
          min="512"
          max="131072"
          step="1"
          value={String(seed.context)}
          aria-label="Context length in tokens"
          aria-describedby="lvc-run-hint"
        />
      </div>
      <p class="lvc-hint caption text-mute">
        KV cache is counted at FP16. Overhead is a fixed 1.5 GiB estimate for the runtime and compute
        buffers. A custom size borrows the architecture of the nearest preset.
      </p>
      <RunHint id="lvc-run-hint" />
      <SnapshotBar prefix="lvc" />
    </div>

    {/* ── Results panel — the L2 instrument ──────────────────────────── */}
    <ResultPanel slug="llm-vram-calculator" prefix="lvc" summary={seedSummary} split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="lvc-share" />
        <CopyButton kind="all" id="lvc-copy-all" />
      </Fragment>
      <div id="lvc-results" class="lvc-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* ── Slider rows: label / range / number ─────────────────────────── */
  .lvc-field {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'label label'
      'range num';
    gap: 8px 12px;
    align-items: center;
  }
  .lvc-field > label {
    grid-area: label;
  }
  .lvc-range {
    grid-area: range;
    width: 100%;
    height: var(--control-h-md);
    margin: 0;
    accent-color: var(--color-brand-strong);
    cursor: pointer;
  }
  .lvc-range:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
  .lvc-num {
    grid-area: num;
    width: 7rem;
    height: var(--control-h-md);
    padding: 0 10px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 14px;
    line-height: 20px;
    text-align: right;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .lvc-num:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .lvc-num:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--color-link);
  }
  .lvc-num.lvc-num--error {
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  @media (pointer: coarse) {
    .lvc-range,
    .lvc-num {
      min-height: var(--control-h-lg);
    }
  }
  .lvc-hint {
    margin-top: 12px;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .lvc-results {
    min-height: 320px;
    display: grid;
    align-content: start;
  }

  /* ── Runtime-injected markup (render.ts) on the slab ─────────────── */
  .lvc-results :global(.lvc-card) {
    display: grid;
    gap: 14px;
    animation: lvc-rise var(--dur-base) var(--ease-brand) both;
  }
  .lvc-results :global(.lvc-empty),
  .lvc-results :global(.lvc-error) {
    margin: 0;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }

  /* Stacked bar: weights leaf, KV amber, overhead mute — inverse inks only. */
  .lvc-results :global(.lvc-bar) {
    display: flex;
    height: 14px;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-inverse-fg) 8%, transparent);
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .lvc-results :global(.lvc-bar__seg) {
    min-width: 2px;
    transition: width var(--dur-base) var(--ease-brand);
  }
  .lvc-results :global(.lvc-bar__seg--weights) {
    background: var(--color-inverse-brand);
  }
  .lvc-results :global(.lvc-bar__seg--kv) {
    background: var(--color-inverse-accent);
  }
  .lvc-results :global(.lvc-bar__seg--overhead) {
    background: var(--color-inverse-mute);
  }

  /* Stat rows; the first (Total VRAM) is the hero. Legend swatches on the
     three bar components, keyed through the value's data-k. */
  .lvc-results :global(.lvc-stats) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
  }
  .lvc-results :global(.lvc-stat) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .lvc-results :global(.lvc-stat:first-child) {
    grid-column: 1 / -1;
  }
  .lvc-results :global(.lvc-stat__k) {
    @apply label-field;
    color: var(--color-inverse-mute);
  }
  .lvc-results :global(.lvc-stat__k::before) {
    content: '';
    display: none;
    width: 8px;
    height: 8px;
    margin-right: 6px;
    border-radius: var(--radius-sm);
    vertical-align: baseline;
  }
  .lvc-results :global(.lvc-stat:has([data-k='stat:Weights']) .lvc-stat__k::before),
  .lvc-results :global(.lvc-stat:has([data-k='stat:KV cache']) .lvc-stat__k::before),
  .lvc-results :global(.lvc-stat:has([data-k='stat:Overhead']) .lvc-stat__k::before) {
    display: inline-block;
  }
  .lvc-results :global(.lvc-stat:has([data-k='stat:Weights']) .lvc-stat__k::before) {
    background: var(--color-inverse-brand);
  }
  .lvc-results :global(.lvc-stat:has([data-k='stat:KV cache']) .lvc-stat__k::before) {
    background: var(--color-inverse-accent);
  }
  .lvc-results :global(.lvc-stat:has([data-k='stat:Overhead']) .lvc-stat__k::before) {
    background: var(--color-inverse-mute);
  }
  .lvc-results :global(.lvc-stat__v) {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-inverse-fg);
    overflow-wrap: anywhere;
  }
  .lvc-results :global(.lvc-stat:first-child .lvc-stat__v) {
    font-size: 20px;
    line-height: 28px;
    font-weight: 600;
    color: var(--color-inverse-brand);
  }
  .lvc-results :global(.lvc-stat__cap) {
    font-size: 12px;
    line-height: 16px;
    color: var(--color-inverse-mute);
    text-wrap: pretty;
  }

  /* Group heading: sans 12/16 600 with a rule above — never one more label. */
  .lvc-results :global(.lvc-group__h) {
    margin: 0;
    padding-top: 12px;
    border-top: 1px solid var(--color-inverse-hairline);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    color: var(--color-inverse-fg);
  }

  /* Tier list: tick mark (leaf = fits, mute = too small), size, verdict, cards. */
  .lvc-results :global(.lvc-tiers) {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lvc-results :global(.lvc-tier) {
    display: grid;
    grid-template-columns: 8px 4.5rem 5rem minmax(0, 1fr);
    gap: 10px;
    align-items: baseline;
    padding: 7px 0;
  }
  .lvc-results :global(.lvc-tier + .lvc-tier) {
    border-top: 1px solid color-mix(in srgb, var(--color-inverse-fg) 7%, transparent);
  }
  .lvc-results :global(.lvc-tier::before) {
    content: '';
    width: 8px;
    height: 8px;
    align-self: center;
    border-radius: var(--radius-sm);
    background: var(--color-inverse-mute);
    opacity: 0.4;
  }
  .lvc-results :global(.lvc-tier.is-fit::before) {
    background: var(--color-inverse-brand);
    opacity: 1;
  }
  .lvc-results :global(.lvc-tier__gib) {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-inverse-fg);
  }
  .lvc-results :global(.lvc-tier__v) {
    @apply label-field;
    color: var(--color-inverse-mute);
  }
  .lvc-results :global(.lvc-tier.is-fit .lvc-tier__v) {
    color: var(--color-inverse-brand);
  }
  .lvc-results :global(.lvc-tier__cards) {
    font-size: 12px;
    line-height: 16px;
    color: var(--color-inverse-mute);
    overflow-wrap: anywhere;
  }
  @media (max-width: 479px) {
    .lvc-results :global(.lvc-tier) {
      grid-template-columns: 8px 4.5rem 1fr;
    }
    .lvc-results :global(.lvc-tier__cards) {
      grid-column: 2 / -1;
    }
  }

  @keyframes lvc-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lvc-results :global(.lvc-card) {
      animation: none;
    }
    .lvc-results :global(.lvc-bar__seg) {
      transition: none;
    }
  }
</style>

<script>
  import type { Quant, VramInput, VramResult } from '../lib/llm-vram-calculator/types';
  import { EMPTY_HTML, errorHtml, resultHtml, summaryText, buildCopyAll } from '../lib/llm-vram-calculator/render';
  import { snapshotValues, markChanged } from '../lib/mark-changed';
  import { wireRunKeys } from '../lib/run-keys';
  import { createHashState } from '../lib/hash-state';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByInput, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';

  type EngineModule = {
    estimate: (input: VramInput) => VramResult;
    QUANTS: { id: Quant }[];
    LIMITS: { params: { min: number; max: number }; context: { min: number; max: number } };
  };

  const SLUG = 'llm-vram-calculator';
  const ROOT_SEL = '.lvc-pg';
  const DEBOUNCE_MS = 150;
  const ERROR_HOLD_MS = 600;
  const CONTEXT_STOPS = [2048, 4096, 8192, 16384, 32768, 65536, 131072];

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.lvcWired === 'true') return;
      root.dataset.lvcWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  /** Index of the context stop nearest to `tokens`. */
  function nearestStop(tokens: number): number {
    let best = 0;
    CONTEXT_STOPS.forEach((s, i) => {
      if (Math.abs(s - tokens) < Math.abs(CONTEXT_STOPS[best] - tokens)) best = i;
    });
    return best;
  }

  const serialize = (s: VramInput) => `${s.params}|${s.quant}|${s.context}|${s.preset ?? 'custom'}`;

  async function init(root: HTMLElement): Promise<void> {
    const paramsRange = el<HTMLInputElement>(root, '#lvc-params-range');
    const paramsNum = el<HTMLInputElement>(root, '#lvc-params');
    const ctxRange = el<HTMLInputElement>(root, '#lvc-context-range');
    const ctxNum = el<HTMLInputElement>(root, '#lvc-context');
    const resultsBox = el<HTMLElement>(root, '#lvc-results');
    const summaryEl = el<HTMLElement>(root, '#lvc-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#lvc-share');
    const copyAllBtn = el<HTMLButtonElement>(root, '#lvc-copy-all');
    const copyStatus = el<HTMLElement>(root, '#lvc-copy-status');
    const modelChips = el<HTMLElement>(root, '#lvc-model-chips');
    const quantChips = el<HTMLElement>(root, '#lvc-quant-chips');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#lvc-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#lvc-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#lvc-snap-delete');
    if (
      !paramsRange || !paramsNum || !ctxRange || !ctxNum || !resultsBox || !summaryEl ||
      !shareBtn || !copyAllBtn || !copyStatus || !modelChips || !quantChips ||
      !snapSaveBtn || !snapSelect || !snapDeleteBtn
    )
      return;

    wireCopyButtons(root, { status: copyStatus });

    let engine: EngineModule;
    try {
      engine = (await import('../lib/llm-vram-calculator/engine')) as unknown as EngineModule;
    } catch (err) {
      resultsBox.innerHTML = errorHtml('The calculator engine failed to load. Reload the page to try again.');
      console.error('[LlmVramCalculator] engine import failed:', err);
      return;
    }

    const hash = createHashState('m');
    const quantIds = new Set(engine.QUANTS.map((q) => q.id));
    const presetChip = (slug: string) =>
      Array.from(modelChips.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR)).find((c) => c.dataset.input === slug);

    /* ── State: quant + preset live here; params + context live in the inputs. */
    let quant: Quant = (quantChips.querySelector<HTMLElement>('.chip[aria-pressed="true"]')?.dataset.input as Quant) ?? 'q4_k_m';
    let preset = modelChips.querySelector<HTMLElement>('.chip[aria-pressed="true"]')?.dataset.input ?? 'custom';
    let maxContext = Number(presetChip(preset)?.dataset.maxContext) || engine.LIMITS.context.max;
    let evalTimer: number | undefined;
    let errTimer: number | undefined;

    const clearTimers = () => {
      window.clearTimeout(evalTimer);
      window.clearTimeout(errTimer);
    };

    function readForm(): VramInput {
      return { params: Number(paramsNum!.value), quant, context: Number(ctxNum!.value), preset };
    }

    /** `<params>|<quant>|<context>|<preset>` → input, or null when any part is off. */
    function parse(s: string): VramInput | null {
      const [p, q, c, pr] = s.split('|');
      const params = Number(p);
      const context = Number(c);
      if (!Number.isFinite(params) || !Number.isFinite(context) || !quantIds.has(q as Quant)) return null;
      if (pr !== 'custom' && !presetChip(pr)) return null;
      return { params, quant: q as Quant, context, preset: pr };
    }

    /* ── Sync the paired controls and their spoken values. */
    function syncParams(fromRange: boolean): void {
      if (fromRange) paramsNum!.value = paramsRange!.value;
      else {
        const n = Number(paramsNum!.value);
        if (Number.isFinite(n)) paramsRange!.value = String(Math.min(405, Math.max(1, Math.round(n))));
      }
      paramsRange!.setAttribute('aria-valuetext', `${paramsNum!.value} B parameters`);
    }
    function syncContext(fromRange: boolean): void {
      if (fromRange) ctxNum!.value = String(Math.min(CONTEXT_STOPS[Number(ctxRange!.value)] ?? maxContext, maxContext));
      else {
        const n = Number(ctxNum!.value);
        if (Number.isFinite(n)) ctxRange!.value = String(nearestStop(n));
      }
      const n = Number(ctxNum!.value);
      ctxRange!.setAttribute('aria-valuetext', Number.isFinite(n) ? `${n.toLocaleString('en-US')} tokens` : 'invalid');
    }

    function applyState(s: VramInput): void {
      quant = s.quant;
      preset = s.preset ?? 'custom';
      maxContext = Number(presetChip(preset)?.dataset.maxContext) || engine.LIMITS.context.max;
      paramsNum!.value = String(s.params);
      ctxNum!.value = String(s.context);
      syncParams(false);
      syncContext(false);
      syncChipsByInput(modelChips, preset);
      syncChipsByInput(quantChips, quant);
    }

    function setSummary(text: string, isError: boolean): void {
      summaryEl!.textContent = text;
      summaryEl!.classList.toggle('text-inverse-error', isError);
      summaryEl!.classList.toggle('text-inverse-mute', !isError);
    }

    function setErrorState(on: boolean): void {
      for (const n of [paramsNum!, ctxNum!]) {
        n.classList.toggle('lvc-num--error', on);
        if (on) n.setAttribute('aria-invalid', 'true');
        else n.removeAttribute('aria-invalid');
      }
    }

    function hideActions(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
      copyAllBtn!.hidden = true;
      copyAllBtn!.dataset.copy = '';
    }

    function showError(message: string): void {
      clearTimers();
      setErrorState(true);
      hideActions();
      setSummary(message, true);
      resultsBox!.innerHTML = errorHtml(message);
      hash.write(null);
    }

    function evaluate(source: 'type' | 'commit' | 'seed'): void {
      clearTimers();
      const input = readForm();
      let result: VramResult | null = null;
      try {
        result = engine.estimate(input);
      } catch {
        result = null;
      }

      if (result && result.valid) {
        setErrorState(false);
        // Amber tick on the values that changed — never on the boot seed.
        const prev = source === 'seed' ? new Map<string, string>() : snapshotValues(resultsBox!);
        resultsBox!.innerHTML = resultHtml(result);
        markChanged(resultsBox!, prev);
        setSummary(summaryText(result), false);
        const serial = serialize(input);
        shareBtn!.hidden = false;
        shareBtn!.dataset.copy = location.origin + location.pathname + location.search + hash.build(serial);
        copyAllBtn!.hidden = false;
        copyAllBtn!.dataset.copy = buildCopyAll(result);
        if (source !== 'seed') {
          hash.write(serial);
          recordToolLastInput(SLUG, serial);
        }
        return;
      }

      const message = result?.error ?? EMPTY_HTML.replace(/<[^>]*>/g, '');
      if (source !== 'type') {
        showError(message);
        return;
      }
      // Mid-typing: hold the last card, surface the error only after a pause.
      setErrorState(false);
      hideActions();
      setSummary('', false);
      errTimer = window.setTimeout(() => showError(message), ERROR_HOLD_MS);
    }

    const schedule = () => {
      clearTimers();
      evalTimer = window.setTimeout(() => evaluate('type'), DEBOUNCE_MS);
    };

    /* ── Events ──────────────────────────────────────────────────────── */
    const toCustom = () => {
      if (preset === 'custom') return;
      preset = 'custom';
      maxContext = engine.LIMITS.context.max;
      syncChipsByInput(modelChips, preset);
    };
    paramsRange.addEventListener('input', () => {
      toCustom();
      syncParams(true);
      schedule();
    });
    paramsNum.addEventListener('input', () => {
      toCustom();
      syncParams(false);
      schedule();
    });
    ctxRange.addEventListener('input', () => {
      syncContext(true);
      schedule();
    });
    ctxNum.addEventListener('input', () => {
      syncContext(false);
      schedule();
    });
    wireRunKeys(paramsNum, () => evaluate('commit'));
    wireRunKeys(ctxNum, () => evaluate('commit'));
    for (const n of [paramsNum, ctxNum]) n.addEventListener('blur', () => evaluate('commit'));

    modelChips.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>(CHIP_SELECTOR);
      if (!chip || !modelChips.contains(chip)) return;
      const slug = chip.dataset.input ?? 'custom';
      const cur = readForm();
      const max = Number(chip.dataset.maxContext) || engine.LIMITS.context.max;
      applyState({
        params: slug === 'custom' ? cur.params : Number(chip.dataset.params) || cur.params,
        quant,
        context: Math.min(cur.context, max),
        preset: slug,
      });
      evaluate('commit');
    });
    quantChips.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>(CHIP_SELECTOR);
      if (!chip || !quantChips.contains(chip)) return;
      quant = (chip.dataset.input as Quant) ?? quant;
      syncChipsByInput(quantChips, quant);
      evaluate('commit');
    });

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => serialize(readForm()),
      setValue: (value) => {
        const s = parse(value);
        if (!s) return;
        applyState(s);
        evaluate('commit');
      },
    });

    /* ── First load: #m= deep link → restored last input → the SSR seed.
       Seeding never writes the hash or records — only user actions do. ── */
    const fromHash = hash.read();
    const restored = getRestoredLastInput(SLUG);
    const state = (fromHash && parse(fromHash)) || (restored && parse(restored)) || null;
    if (state) applyState(state);
    else {
      syncParams(false);
      syncContext(false);
    }
    evaluate('seed');
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
