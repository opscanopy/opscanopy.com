---
/**
 * CronTesterPlayground — the interactive Cron Expression Tester island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>.
 * Unlike the editor-based playgrounds, this tool takes a single-line cron
 * expression in a labeled text input, a numeric "next runs" count, and an
 * example picker. It explains the expression in plain English and lists the
 * upcoming run times. It updates live on input — no button required — and runs
 * entirely client-side (no upload, no network).
 *
 * Runtime contract (built by sibling agents — imported lazily in the script):
 *   ../lib/cron-tester/engine →
 *     explain(expr, opts?): CronResult
 *     nextRuns(expr, count?, fromIso?, opts?): string[]
 *     nextRunEpochSeconds(expr, count?, fromIso?, opts?): number[]
 *     where opts is { timeZone?: string }
 *   ../lib/cron-tester/types →
 *     type CronResult = {
 *       valid: boolean
 *       error?: string
 *       description: string
 *       fields: { minute; hour; dayOfMonth; month; dayOfWeek }
 *       nextRuns: string[]
 *       timeZone: string   // the zone the runs were computed in
 *     }
 *
 *   ../lib/cron-tester/examples →
 *     examples: { id: string; label: string; expr: string }[]
 *
 * Timezone: a crontab fires on the wall clock of the HOST it runs on, not the
 * visitor's laptop. The zone is a chip row, defaults to the browser's (named,
 * not implied), persists in localStorage, and is printed next to every run.
 *
 * Results are injected at runtime; every injected selector is styled with
 * :global(...) and injected SVGs carry explicit width/height. Headlines stay
 * sentence-case, weight 600.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar, ResultPanel (figure cap, live summary, copy status)
 * and CopyButton. The results container stays here, seeded with
 * `set:html` + `data-results`; its slab overrides anchor on `.cron-results`.
 */
import { examples } from '../lib/cron-tester/examples';
import { explain } from '../lib/cron-tester/engine';
import { descCardHtml, runsSkeletonHtml, EMPTY_HTML } from '../lib/cron-tester/render';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed — the DETERMINISTIC half of the result only.
 *
 * `description` and the parsed fields depend on the expression alone, so they
 * are baked into the static HTML for no-JS visitors and AI crawlers. Next-run
 * times are a function of `new Date()` and the reader's timezone, so the
 * server emits a skeleton and the browser fills in real times on boot —
 * shipping a frozen "in 5 minutes" to every reader would be a lie.
 *
 * The zone is pinned to UTC here so the build host cannot leak into the HTML.
 */
const seedExample = examples[0];
const seedResult = seedExample ? explain(seedExample.expr, { timeZone: 'UTC' }) : null;
const seedHtml =
  seedResult && seedResult.valid
    ? descCardHtml(seedResult.description, seedResult.fields) + runsSkeletonHtml()
    : EMPTY_HTML;
const seedSummary = seedResult && seedResult.valid ? 'Valid' : '';
const chipItems = examples.map((ex) => ({ label: ex.label }));

---

<section class="cron-pg" aria-label="Cron Expression Tester playground">
  <div class="card shadow-float rounded-lg overflow-hidden">
    {/* ── Toolbar: example picker + next-runs count ────────────────────── */}
    <div
      class="flex flex-col gap-3 border-b border-hairline px-4 py-3 sm:flex-row sm:items-end sm:justify-between sm:px-5"
    >
      <div class="flex min-w-0 flex-col gap-1">
        <span class="eyebrow shrink-0" id="cron-examples-label">Example</span>
        {/* Server-rendered so they work without JS; the script adopts them. */}
        <ExampleChips prefix="cron" items={chipItems} active={seedExample ? 0 : null} labelledby="cron-examples-label" />
      </div>

      <div class="flex shrink-0 flex-col gap-1">
        <label class="eyebrow shrink-0" for="cron-count">Next runs to show</label>
        <div class="cron-stepper" role="group" aria-label="Number of next runs to show">
          <button
            id="cron-count-dec"
            type="button"
            class="cron-step-btn cron-tap"
            aria-label="Show fewer runs"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M3.5 8h9"></path>
            </svg>
          </button>
          <input
            id="cron-count"
            type="number"
            class="cron-count-input code-mono"
            inputmode="numeric"
            min="1"
            max="20"
            step="1"
            value="5"
            autocomplete="off"
          />
          <button
            id="cron-count-inc"
            type="button"
            class="cron-step-btn cron-tap"
            aria-label="Show more runs"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M8 3.5v9M3.5 8h9"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    {/* ── Expression input ─────────────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <label class="eyebrow mb-2 block" for="cron-input">Cron expression <span class="caption text-mute font-normal">(sample)</span></label>
      <div class="cron-input-wrap">
        <svg
          class="cron-input-icon pointer-events-none"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="10" cy="10" r="7.25"></circle>
          <path d="M10 5.75V10l2.75 1.75"></path>
        </svg>
        <input
          id="cron-input"
          type="text"
          class="cron-input code-mono"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          placeholder="*/5 * * * *"
          value={seedExample?.expr}
          aria-describedby="cron-input-hint"
        />
      </div>
      <p id="cron-input-hint" class="cron-hint caption text-mute">
        Five fields — minute, hour, day of month, month, day of week. Macros like
        <span class="code-mono">@daily</span> are supported too.
      </p>
      <RunHint />

      {/* ── Timezone ──────────────────────────────────────────────────────
          A crontab fires on the wall clock of the HOST it runs on, which is
          rarely the visitor's laptop. The zone is explicit and switchable so a
          next-run time is never shown without saying which clock it is on. */}
      <div class="cron-tz mt-3">
        <span class="eyebrow" id="cron-tz-label">Timezone</span>
        <div
          id="cron-tz-chips"
          class="chips mt-1"
          role="group"
          aria-labelledby="cron-tz-label"
          data-chips
        >
          {/* Kit chips injected at boot — the browser zone's name is read at runtime. */}
        </div>
        <input
          id="cron-tz-custom"
          class="cron-tz-input code-mono mt-2"
          list="cron-tz-list"
          type="text"
          spellcheck="false"
          autocomplete="off"
          placeholder="Or type an IANA zone, e.g. Europe/Berlin"
          aria-label="Custom IANA timezone"
        />
        <datalist id="cron-tz-list"></datalist>
      </div>
      <SnapshotBar prefix="cron" />
    </div>

    {/* ── Results panel (description + next runs) — the L2 instrument under
        its figure cap; the live summary reads out in the cap's actions slot. */}
    <ResultPanel slug="cron-expression-tester" prefix="cron" summary={seedSummary} split>
      <Fragment slot="actions">
        <CopyButton kind="all" id="cron-copy-all" />
        <CopyButton kind="link" id="cron-share" />
        <CopyButton kind="value" id="cron-md" label="Copy as Markdown" icon="markdown" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above): the plain-English reading
          is in the static HTML, the run times arrive on hydration. The
          container is deliberately NOT a live region — ResultPanel's
          #cron-copy-status is the sole announcement channel for copies. */}
      <div id="cron-results" class="cron-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* Tap targets opt into fast-tap + no double-tap-zoom on touch. */
  .cron-tap {
    touch-action: manipulation;
  }

  .cron-tz-input {
    width: 100%;
    max-width: 320px;
    height: var(--control-h-md);
    padding: 0 10px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 12px;
  }
  .cron-tz-input:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }

  /* The zone each run time is measured in — muted, always present. */
  :global(.cron-tz-note) {
    margin-bottom: 8px;
    padding-bottom: 4px;
    color: var(--color-mute);
    font-size: 12px;
  }
  /* DST advisory: amber annotation ink, matching the Field Manual system. */
  :global(.cron-dst-note) {
    margin-top: 8px;
    color: var(--color-accent-ink);
    font-size: 12px;
    line-height: 1.5;
  }

  /* Numeric stepper — three-segment in-app control. */
  .cron-stepper {
    display: inline-flex;
    align-items: stretch;
    height: var(--control-h-md);
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
  }
  .cron-step-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    flex: 0 0 auto;
    color: var(--color-body);
    background: transparent;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      color var(--dur-fast) var(--ease-brand);
  }
  .cron-step-btn:hover {
    background: var(--color-canvas-soft-2);
    color: var(--color-ink);
  }
  .cron-step-btn:disabled {
    cursor: not-allowed;
    color: var(--color-mute);
    opacity: 0.5;
    background: transparent;
  }
  /* Touch: grow the composed stepper + its buttons to the 44px tap minimum.
     align-items: stretch makes the count input follow the taller container.
     The kit's chips grow in global.css. */
  @media (pointer: coarse) {
    .cron-stepper {
      height: var(--control-h-lg);
    }
    .cron-step-btn {
      min-width: var(--control-h-lg);
    }
    .cron-tz-input {
      height: var(--control-h-lg);
    }
  }
  .cron-count-input {
    width: 44px;
    min-width: 0;
    border: 0;
    border-left: 1px solid var(--color-hairline);
    border-right: 1px solid var(--color-hairline);
    background: transparent;
    color: var(--color-ink);
    text-align: center;
    font-size: 13px;
    line-height: 20px;
    -moz-appearance: textfield;
  }
  .cron-count-input::-webkit-outer-spin-button,
  .cron-count-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .cron-count-input:focus {
    outline: none;
  }
  .cron-count-input:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: -2px;
  }

  /* Single-line expression input. */
  .cron-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .cron-input-icon {
    position: absolute;
    left: 14px;
    width: 18px;
    height: 18px;
    color: var(--color-mute);
    pointer-events: none;
  }
  .cron-input {
    width: 100%;
    height: var(--control-h-lg);
    padding: 0 16px 0 42px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 15px;
    line-height: 24px;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .cron-input::placeholder {
    color: var(--color-mute);
  }
  .cron-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .cron-input:focus {
    outline: none;
  }
  .cron-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .cron-input.cron-input--error {
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  .cron-input.cron-input--error:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-error);
  }
  .cron-hint {
    margin-top: 8px;
    text-wrap: pretty;
  }

  /* One control row high, so the empty state does not collapse the panel. */
  .cron-results {
    min-height: var(--control-h-lg);
  }

  /* ── Runtime-injected markup (render.ts + runsHtml; styled with :global).
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.cron-results` container. The chain
     chips render.ts appends take the kit's link-chip recipe (global.css). */

  /* Description card — the plain-English read of the expression. */
  :global(.cron-desc) {
    padding: 14px 16px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    animation: cron-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.cron-desc__text) {
    font-size: 15px;
    font-weight: 500;
    line-height: 22px;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  /* Parsed-field grid — minute / hour / dom / month / dow. */
  :global(.cron-fields) {
    margin-top: 12px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  @media (min-width: 560px) {
    :global(.cron-fields) {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  :global(.cron-field) {
    min-width: 0;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-soft);
    box-shadow: var(--shadow-hairline);
  }
  /* Row-key role (label-field): mono 11/16 uppercase, the only label. */
  :global(.cron-field__label) {
    display: block;
    @apply label-field;
  }
  :global(.cron-field__val) {
    display: block;
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-word;
  }

  /* Next-runs list. */
  :global(.cron-runs) {
    margin-top: 12px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
  }
  :global(.cron-runs__head) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-hairline);
  }
  :global(.cron-runs__head-icon) {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    color: var(--color-mute);
  }
  /* "Next 5 runs" — the group-heading role: sans 12/16 600 ink (global.css
     .result-panel__group-h), not a mono caps label. */
  :global(.cron-runs__head-text) {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    color: var(--color-ink);
  }
  :global(.cron-runs__list) {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.cron-run) {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 9px 14px;
    animation: cron-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.cron-run + .cron-run) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.cron-run__idx) {
    flex: 0 0 auto;
    width: 20px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 20px;
    color: var(--color-mute);
  }
  :global(.cron-run__time) {
    min-width: 0;
    flex: 1 1 auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-word;
  }

  @keyframes cron-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.cron-desc),
    :global(.cron-run) {
      animation: none;
    }
  }

  /* Parse-error banner. */
  :global(.cron-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
    animation: cron-rise var(--dur-base) var(--ease-brand) both;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.cron-error) {
      animation: none;
    }
  }
  :global(.cron-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.cron-error__body) {
    min-width: 0;
  }
  :global(.cron-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.cron-error__detail) {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* Empty state — generous, centered frame. */
  :global(.cron-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below it uses the slab ink tier; the light rules
     above remain the documented defaults. ──────────────────────────────── */
  .cron-results :global(.cron-empty),
  .cron-results :global(.cron-error) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .cron-results :global(.cron-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .cron-results :global(.cron-desc),
  .cron-results :global(.cron-runs) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .cron-results :global(.cron-field) {
    background: #ffffff08;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .cron-results :global(.cron-desc__text),
  .cron-results :global(.cron-field__val),
  .cron-results :global(.cron-run__time),
  .cron-results :global(.cron-runs__head-text) {
    color: var(--color-inverse-fg);
  }
  .cron-results :global(.cron-field__label),
  .cron-results :global(.cron-runs__head-icon),
  .cron-results :global(.cron-run__idx),
  .cron-results :global(.cron-tz-note) {
    color: var(--color-inverse-mute);
  }
  .cron-results :global(.cron-dst-note) {
    color: var(--color-inverse-accent);
  }
  .cron-results :global(.cron-runs__head),
  .cron-results :global(.cron-run + .cron-run) {
    border-color: #ffffff12;
  }
  /* Next-run times right-align like every instrument readout. */
  .cron-results :global(.cron-run__time) {
    text-align: right;
  }
  /* The <480px stacked layout returns readouts to the left edge. */
  @media (max-width: 479px) {
    .cron-results :global(.cron-run__time) {
      text-align: left;
    }
  }
</style>

<script>
  import { escapeHtml } from '../lib/escape-html';
  import {
    CLOCK_SVG,
    EMPTY_HTML,
    chainsHtml,
    descCardHtml,
    errorHtml,
  } from '../lib/cron-tester/render';
  import { snapshotValues, markChanged } from '../lib/mark-changed';
  // Static: it is a few hundred bytes of Intl wrapper, and the DST advisory
  // needs it on the very first render, before any lazy chunk resolves.
  import { zoneOffsetMinutes } from '../lib/cron-tester/wall-clock';
  import { createHashState } from '../lib/hash-state';
  import { wireRunKeys } from '../lib/run-keys';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChips, syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { buildMarkdownBlock } from '../lib/share-md';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';

  /* ---- Types mirrored from the engine contract (structural, not imported). -- */
  type CronFields = {
    minute: string;
    hour: string;
    dayOfMonth: string;
    month: string;
    dayOfWeek: string;
  };
  type CronResult = {
    valid: boolean;
    error?: string;
    description: string;
    fields: CronFields;
    nextRuns: string[];
    /** The zone the engine actually evaluated and rendered in. Always shown. */
    timeZone: string;
  };
  type Example = { id: string; label: string; expr: string };
  /** Trailing options accepted by every engine entry point. */
  type CronTimeOptions = { timeZone?: string };
  type EngineModule = {
    explain: (expr: string, opts?: CronTimeOptions) => CronResult;
    nextRuns: (
      expr: string,
      count?: number,
      fromIso?: string,
      opts?: CronTimeOptions,
    ) => string[];
    nextRunEpochSeconds: (
      expr: string,
      count?: number,
      fromIso?: string,
      opts?: CronTimeOptions,
    ) => number[];
  };

  const ROOT_SEL = '.cron-pg';
  const DEFAULT_COUNT = 5;
  const MIN_COUNT = 1;
  const MAX_COUNT = 20;
  const DEBOUNCE_MS = 150;
  /** Hold a parse error until typing settles — no red border mid-compose. */
  const ERROR_HOLD_MS = 600;

  /** Boot every (so far un-hydrated) playground instance on the page. */
  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.cronWired === 'true') return;
      root.dataset.cronWired = 'true';
      void init(root);
    });
  }

  /* ---- Small helpers -------------------------------------------------------- */

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function clampCount(n: number): number {
    if (!Number.isFinite(n)) return DEFAULT_COUNT;
    return Math.min(MAX_COUNT, Math.max(MIN_COUNT, Math.round(n)));
  }

  /** Normalise the sibling `examples` array defensively. */
  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        const expr = typeof o.expr === 'string' ? o.expr : '';
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          expr,
        } satisfies Example;
      })
      .filter((e) => e.expr.length > 0);
  }

  /* ---- Result rendering ----------------------------------------------------- */

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    summary.textContent = '';
    summary.classList.remove('text-inverse-error');
    summary.classList.add('text-inverse-mute');
    container.innerHTML = EMPTY_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    summary.textContent = 'Invalid';
    summary.classList.remove('text-inverse-mute');
    summary.classList.add('text-inverse-error');
    container.innerHTML = errorHtml(message);
  }

  /**
   * Does a DST transition sit within a day either side of any listed run? The
   * offset changing across that window is the signal — no tzdata needed.
   */
  function nearTransition(runEpochs: number[], timeZone: string): boolean {
    const DAY = 86_400_000;
    for (const sec of runEpochs) {
      const ms = sec * 1000;
      try {
        if (zoneOffsetMinutes(ms - DAY, timeZone) !== zoneOffsetMinutes(ms + DAY, timeZone)) {
          return true;
        }
      } catch {
        return false;
      }
    }
    return false;
  }

  function runsHtml(runs: string[], timeZone: string, dstNearby: boolean): string {
    if (runs.length === 0) {
      return (
        '<div class="cron-runs"><div class="cron-runs__head">' +
        CLOCK_SVG +
        '<span class="cron-runs__head-text">Next runs</span></div>' +
        '<ul class="cron-runs__list"><li class="cron-run">' +
        '<span class="cron-run__time">No upcoming runs found.</span></li></ul></div>'
      );
    }
    // The zone is stated once, next to the times it applies to. An unlabelled
    // run time is the whole defect this tool had.
    const zoneNote =
      `<p class="cron-tz-note">Times shown in ${escapeHtml(timeZone)}.</p>`;
    const dstNote = dstNearby
      ? '<p class="cron-dst-note">This zone changes offset near one of these runs. ' +
        'A wall time that does not exist is skipped; one that occurs twice runs on its ' +
        'first occurrence. Check your host’s cron implementation for jobs near a ' +
        'DST boundary — they do not all agree.</p>'
      : '';
    const items = runs
      .map(
        (run, i) =>
          '<li class="cron-run">' +
          `<span class="cron-run__idx" aria-hidden="true">${i + 1}</span>` +
          `<span class="cron-run__time" data-k="run:${i}">${escapeHtml(run)}</span></li>`
      )
      .join('');
    return (
      '<div class="cron-runs"><div class="cron-runs__head">' +
      CLOCK_SVG +
      `<span class="cron-runs__head-text">Next ${runs.length === 1 ? 'run' : `${runs.length} runs`}</span></div>` +
      `<ul class="cron-runs__list">${items}</ul>` +
      zoneNote +
      dstNote +
      '</div>'
    );
  }

  /** Cross-tool chain chips — Cron Expression Tester → Cron-to-systemd + Timestamp Converter. */
  function localePath(p: string): string {
    const m = window.location.pathname.match(/^\/(de|es|fr|pt-br)\//);
    return m ? `/${m[1]}${p}` : p;
  }

  function renderResult(
    container: HTMLElement,
    summary: HTMLElement,
    result: CronResult,
    runs: string[],
    expr: string,
    firstRunEpoch: number | undefined,
    dstNearby: boolean
  ): void {
    summary.textContent = 'Valid';
    summary.classList.remove('text-inverse-error');
    summary.classList.add('text-inverse-mute');
    const desc =
      typeof result.description === 'string' && result.description.length > 0
        ? result.description
        : 'Schedule parsed.';
    const fields = result.fields ?? {
      minute: '',
      hour: '',
      dayOfMonth: '',
      month: '',
      dayOfWeek: '',
    };
    container.innerHTML =
      descCardHtml(desc, fields) +
      runsHtml(runs, result.timeZone ?? '', dstNearby) +
      chainsHtml(expr, firstRunEpoch, localePath(''));
  }

  /* ---- Instance init -------------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const exprInput = el<HTMLInputElement>(root, '#cron-input');
    const countInput = el<HTMLInputElement>(root, '#cron-count');
    const decBtn = el<HTMLButtonElement>(root, '#cron-count-dec');
    const incBtn = el<HTMLButtonElement>(root, '#cron-count-inc');
    const chipsWrap = el<HTMLElement>(root, '#cron-chips');
    const tzChipsWrap = el<HTMLElement>(root, '#cron-tz-chips');
    const tzCustom = el<HTMLInputElement>(root, '#cron-tz-custom');
    const tzList = el<HTMLDataListElement>(root, '#cron-tz-list');
    const copyAllBtn = el<HTMLButtonElement>(root, '#cron-copy-all');
    const copyStatus = el<HTMLElement>(root, '#cron-copy-status');
    const resultsBox = el<HTMLElement>(root, '#cron-results');
    const summaryEl = el<HTMLElement>(root, '#cron-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#cron-share');
    const mdBtn = el<HTMLButtonElement>(root, '#cron-md');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#cron-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#cron-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#cron-snap-delete');

    if (
      !exprInput ||
      !countInput ||
      !decBtn ||
      !incBtn ||
      !chipsWrap ||
      !tzChipsWrap ||
      !copyAllBtn ||
      !resultsBox ||
      !summaryEl ||
      !shareBtn ||
      !mdBtn ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    const hashState = createHashState('cron');

    // Lazily load the sibling engine + examples (kept out of the initial path).
    let engine: EngineModule;
    let examples: Example[] = [];
    try {
      const [engineMod, examplesMod] = await Promise.all([
        import('../lib/cron-tester/engine'),
        import('../lib/cron-tester/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
    } catch (err) {
      renderError(
        resultsBox,
        summaryEl,
        'The cron engine failed to load. Reload the page to try again.'
      );
      // eslint-disable-next-line no-console
      console.error('[CronTester] engine/examples import failed:', err);
      return;
    }

    // Example chips — the UX contract's picker, not a <select>.
    // Server-rendered (see the frontmatter) so they work without JS; only
    // build them here if the markup somehow lacks them.
    if (chipsWrap.querySelectorAll(CHIP_SELECTOR).length === 0) {
      examples.forEach((ex, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'chip';
        btn.dataset.exampleIdx = String(i);
        btn.setAttribute('aria-pressed', 'false');
        btn.textContent = ex.label;
        chipsWrap!.appendChild(btn);
      });
    }

    function setActiveChip(idx: number | null): void {
      syncChipsByIndex(chipsWrap, idx);
    }

    /* ── Timezone ────────────────────────────────────────────────────────
       The browser zone is offered BY NAME rather than as an unlabelled
       default, so picking it is a decision instead of an accident.
       Some runtimes still resolve legacy IANA links (Chrome reports
       "Asia/Calcutta"); canonicalise them once here so every label, note
       and copy payload shows the current name. */
    const CANON: Record<string, string> = {
      'Asia/Calcutta': 'Asia/Kolkata',
      'Asia/Saigon': 'Asia/Ho_Chi_Minh',
      'Asia/Katmandu': 'Asia/Kathmandu',
      'Asia/Rangoon': 'Asia/Yangon',
      'Europe/Kiev': 'Europe/Kyiv',
    };
    const canonZone = (z: string): string => CANON[z] ?? z;
    const browserZone = (() => {
      try {
        return canonZone(Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC');
      } catch {
        return 'UTC';
      }
    })();
    const TZ_PRESETS: { label: string; zone: string }[] = [
      { label: 'UTC', zone: 'UTC' },
      { label: `Browser (${browserZone})`, zone: browserZone },
      { label: 'US East', zone: 'America/New_York' },
      { label: 'Europe', zone: 'Europe/Berlin' },
    ].filter((t, i, all) => all.findIndex((x) => x.zone === t.zone) === i);

    const TZ_PREF_KEY = 'oc-cron-tz';
    let activeZone = readZonePref() ?? browserZone;

    function readZonePref(): string | null {
      try {
        // A pref stored before canonicalisation may hold a legacy name;
        // normalise it so it still de-dups against the Browser chip.
        const z = localStorage.getItem(TZ_PREF_KEY);
        return z === null ? null : canonZone(z);
      } catch {
        return null;
      }
    }
    function writeZonePref(zone: string): void {
      try {
        localStorage.setItem(TZ_PREF_KEY, zone);
      } catch {
        /* storage blocked — the choice just won't persist */
      }
    }

    tzChipsWrap.innerHTML = '';
    TZ_PRESETS.forEach((t) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'chip';
      btn.dataset.zone = t.zone;
      btn.setAttribute('aria-pressed', 'false');
      btn.textContent = t.label;
      tzChipsWrap!.appendChild(btn);
    });

    function syncZoneUi(): void {
      syncChips(tzChipsWrap, (b) => b.getAttribute('data-zone') === activeZone);
      // Only mirror into the box when the zone is not one of the chips.
      if (tzCustom && TZ_PRESETS.every((t) => t.zone !== activeZone)) {
        tzCustom.value = activeZone;
      }
    }

    // Offer every zone the runtime knows, where the API exists.
    if (tzList && typeof Intl.supportedValuesOf === 'function') {
      try {
        for (const z of Intl.supportedValuesOf('timeZone')) {
          const o = document.createElement('option');
          o.value = z;
          tzList.appendChild(o);
        }
      } catch {
        /* older runtime — the preset chips still work */
      }
    }
    syncZoneUi();

    tzChipsWrap.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>(CHIP_SELECTOR);
      if (!chip || !chip.dataset.zone) return;
      activeZone = chip.dataset.zone;
      writeZonePref(activeZone);
      syncZoneUi();
      evaluate();
    });

    tzCustom?.addEventListener('change', () => {
      const v = tzCustom.value.trim();
      if (v === '') return;
      activeZone = canonZone(v);
      writeZonePref(activeZone);
      syncZoneUi();
      evaluate();
    });

    /** Read the desired next-run count, clamped to range. */
    function getCount(): number {
      return clampCount(Number(countInput!.value));
    }

    function hideShare(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
      mdBtn!.hidden = true;
      copyAllBtn!.hidden = true;
    }

    /** Re-evaluate the current expression and re-render the results panel. */
    function evaluate(userInitiated = true): void {
      const expr = exprInput!.value.trim();
      if (expr.length === 0) {
        exprInput!.classList.remove('cron-input--error');
        hideShare();
        renderEmpty(resultsBox!, summaryEl!);
        if (userInitiated) hashState.write(null);
        return;
      }

      let result: CronResult | null = null;
      try {
        result = engine.explain(expr, { timeZone: activeZone });
      } catch (err) {
        const msg =
          err instanceof Error ? err.message : 'Unexpected error while parsing the expression.';
        exprInput!.classList.add('cron-input--error');
        hideShare();
        renderError(resultsBox!, summaryEl!, msg);
        if (userInitiated) hashState.write(null);
        return;
      }

      if (!result || result.valid === false) {
        exprInput!.classList.add('cron-input--error');
        hideShare();
        renderError(
          resultsBox!,
          summaryEl!,
          result?.error ?? 'This is not a valid cron expression.'
        );
        if (userInitiated) hashState.write(null);
        return;
      }

      exprInput!.classList.remove('cron-input--error');

      // Prefer a fresh nextRuns() call so the count control takes effect; fall
      // back to whatever the explain() result already carried.
      let runs: string[] = [];
      try {
        const fromEngine = engine.nextRuns(expr, getCount(), undefined, {
          timeZone: activeZone,
        });
        runs = Array.isArray(fromEngine)
          ? fromEngine.filter((r): r is string => typeof r === 'string')
          : [];
      } catch {
        runs = Array.isArray(result.nextRuns)
          ? result.nextRuns.filter((r): r is string => typeof r === 'string')
          : [];
      }
      if (runs.length === 0 && Array.isArray(result.nextRuns)) {
        runs = result.nextRuns
          .filter((r): r is string => typeof r === 'string')
          .slice(0, getCount());
      }

      let firstRunEpoch: number | undefined;
      try {
        firstRunEpoch = engine.nextRunEpochSeconds(expr, 1, undefined, {
          timeZone: activeZone,
        })[0];
      } catch {
        firstRunEpoch = undefined;
      }

      // Collect the run instants once so the DST check does not re-derive them.
      let runEpochs: number[] = [];
      try {
        runEpochs = engine.nextRunEpochSeconds(expr, getCount(), undefined, {
          timeZone: activeZone,
        });
      } catch {
        runEpochs = [];
      }
      const dstNearby = nearTransition(runEpochs, result.timeZone ?? activeZone);

      // Amber tick on the runs/fields whose value changed — never on a seed.
      const prev = userInitiated ? snapshotValues(resultsBox!) : new Map<string, string>();
      renderResult(resultsBox!, summaryEl!, result, runs, expr, firstRunEpoch, dstNearby);
      markChanged(resultsBox!, prev);
      shareBtn!.hidden = false;
      shareBtn!.dataset.copy =
        location.origin + location.pathname + location.search + hashState.build(expr);
      if (userInitiated) hashState.write(expr);
      if (userInitiated) recordToolLastInput('cron-expression-tester', expr);

      mdBtn!.hidden = false;
      mdBtn!.dataset.copy = buildMarkdownBlock('Cron Expression Tester', [
        { label: 'Expression', value: expr },
        { label: 'Description', value: result.description ?? '' },
        { label: 'Timezone', value: result.timeZone ?? activeZone },
        { label: 'Next run', value: runs[0] ?? '' },
      ]);

      // Copy all carries the zone with the times. A pasted bare timestamp is
      // exactly how a timezone mistake propagates into someone else's runbook.
      copyAllBtn!.hidden = false;
      copyAllBtn!.dataset.copy = [
        expr,
        result.description ?? '',
        `Times shown in ${result.timeZone ?? activeZone}`,
        ...runs,
      ].join('\n');
    }

    // Copy all, Copy link and Copy as Markdown — the kit helper: one
    // delegated listener; outcomes announced in the one sr-only live region
    // (#cron-copy-status), never the results container.
    wireCopyButtons(root, { status: copyStatus });

    // Debounced live evaluation on input (keeps typing smooth).
    let timer: number | undefined;
    function scheduleEvaluate(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(evaluate, DEBOUNCE_MS);
    }

    // Editing the expression means we're no longer on a named example.
    exprInput.addEventListener('input', () => {
      setActiveChip(null);
      scheduleEvaluate();
    });

    // Enter (and ⌘/Ctrl+Enter) flushes the pending debounce and evaluates now.
    wireRunKeys(exprInput, () => {
      window.clearTimeout(timer);
      evaluate();
    });

    // Choosing an example chip loads its expression and evaluates immediately.
    chipsWrap.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>(CHIP_SELECTOR);
      if (!chip || !chipsWrap!.contains(chip)) return;
      const idx = Number(chip.dataset.exampleIdx);
      if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
      exprInput.value = examples[idx].expr;
      setActiveChip(idx);
      window.clearTimeout(timer);
      evaluate();
    });

    /** Apply a clamped count value and refresh the steppers' disabled state. */
    function setCount(n: number): void {
      const c = clampCount(n);
      countInput!.value = String(c);
      decBtn!.disabled = c <= MIN_COUNT;
      incBtn!.disabled = c >= MAX_COUNT;
    }

    decBtn.addEventListener('click', () => {
      setCount(getCount() - 1);
      evaluate();
    });
    incBtn.addEventListener('click', () => {
      setCount(getCount() + 1);
      evaluate();
    });
    countInput.addEventListener('input', () => {
      // Re-evaluate live, but don't fight the user mid-edit by re-clamping the
      // field text on every keystroke.
      decBtn!.disabled = getCount() <= MIN_COUNT;
      incBtn!.disabled = getCount() >= MAX_COUNT;
      scheduleEvaluate();
    });
    countInput.addEventListener('change', () => {
      setCount(getCount());
      evaluate();
    });

    wireSnapshotUI({
      slug: 'cron-expression-tester',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => exprInput!.value.trim(),
      setValue: (value) => {
        exprInput!.value = value;
        setActiveChip(null);
        window.clearTimeout(timer);
        evaluate();
      },
    });

    // Seed priority: #cron= deep link > restored last input > first example.
    // Normalise the count control once. Neither seed path writes the hash or
    // records a last-input — only user-initiated evaluations do.
    setCount(DEFAULT_COUNT);
    const hashValue = hashState.read();
    const restored = getRestoredLastInput('cron-expression-tester');
    if (hashValue) {
      exprInput.value = hashValue;
      setActiveChip(null);
      evaluate(false);
    } else if (restored) {
      exprInput.value = restored;
      setActiveChip(null);
      evaluate(false);
    } else {
      const seed = examples[0];
      if (seed) {
        exprInput.value = seed.expr;
        setActiveChip(0);
        evaluate(false);
      } else {
        renderEmpty(resultsBox, summaryEl);
      }
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
