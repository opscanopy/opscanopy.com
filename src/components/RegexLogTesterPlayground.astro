---
/**
 * RegexLogTesterPlayground — the interactive Regex Log Tester island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>
 * that lazily boots a CodeMirror 6 editor for the sample log text, wires a
 * pattern input, five flag toggles (g i m s u) and the example chips.
 * Matching is live and debounced — every edit re-runs the engine, updates a
 * match count, a highlighted rendering of the text and a table of matches
 * with their capture and named groups.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * EditorPane (sample.log), RunHint, SnapshotBar, ResultPanel (figure cap,
 * live summary, copy status) and CopyButton. The two seeded containers
 * (`#rx-highlight` on its own slab beside the editor, `#rx-results` in the
 * result panel) stay here with `set:html` + `data-results`; their slab
 * overrides anchor on `.rx-highlight` / `.rx-results`.
 *
 * Runtime contract (imported lazily in the script):
 *   ../lib/regex-tester/engine →
 *     run(pattern: string, flags: string, text: string): RegexResult
 *     encodeState(pattern: string, flags: string, text: string): string  // hash fragment
 *     decodeState(): ShareState | null
 *   ../lib/regex-tester/types →
 *     RegexMatch  { index: number; length: number; match: string;
 *                   groups: string[]; named: Record<string, string> }
 *     RegexResult { valid: boolean; error?: string; notice?: string;
 *                   matchCount: number; matches: RegexMatch[] }
 *     — `error` is fatal (nothing to show); `notice` is a non-fatal caveat on a
 *       successful run (input over the scan cap, or matching stopped at the
 *       10,000-match cap). Only `valid === false` means "invalid pattern".
 *     ShareState  { pattern: string; flags: string; text: string }
 *   ../lib/regex-tester/examples →
 *     examples: { id: string; label: string; pattern: string; flags: string;
 *                 text: string }[]
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used to server-render the example chips (ExampleChips), so the static HTML
// carries real example names. The script only wires click handlers onto
// these already-rendered buttons — it never rebuilds them.
import { examples as prerenderedExamples } from '../lib/regex-tester/examples';
import { run as runRegex } from '../lib/regex-tester/engine';
import { resultsHtml, buildHighlight, summaryText, EMPTY_HTML } from '../lib/regex-tester/render';
import FigureCap from './FigureCap.astro';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-runs the same example on boot, so this
 * is pure progressive enhancement — but it means a visitor with no JS, and
 * every AI crawler (they do not execute JS), sees the real matches, their
 * capture groups and the highlighted log instead of an empty panel.
 *
 * `run()` is a RegExp over a fixed string — pure, synchronous, clock-free —
 * so it runs at build time unchanged. The sample log goes into a
 * `<pre data-cm-fallback>` inside the CodeMirror host; CM appends its editor
 * to the host, so the script removes the fallback once mounted.
 */
const FLAG_ORDER = ['g', 'i', 'm', 's', 'u'] as const;
const seedExample = prerenderedExamples[0];
const seedPattern = seedExample?.pattern ?? '';
const seedText = seedExample?.text ?? '';
const seedFlagSet = new Set((seedExample?.flags ?? '').split(''));
/** Canonical g i m s u order — the same string the script's currentFlags() builds. */
const seedFlags = FLAG_ORDER.filter((f) => seedFlagSet.has(f)).join('');
const seedResult = seedExample ? runRegex(seedPattern, seedFlags, seedText) : null;
// A bundled example whose pattern does not compile would be a bug, not a
// result — fall back to the shared empty state rather than an error banner.
const seedOk = seedResult && seedResult.valid !== false ? seedResult : null;
const seedHtml = seedOk ? resultsHtml(seedOk) : EMPTY_HTML;
const seedHighlightHtml = buildHighlight(seedText, seedOk ? seedOk.matches : []);
const seedSummary = seedOk ? summaryText(seedOk) : '';
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="rx-pg" aria-label="Regex Log Tester playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: pattern + flags + examples ──────────────────────────── */}
    <div class="flex flex-col gap-3 border-b border-hairline px-4 py-3 sm:px-5">
      <div class="flex flex-col gap-1">
        <div class="flex items-baseline gap-2">
          <label class="eyebrow" for="rx-pattern">Pattern</label>
          <span id="rx-sample-cue" class="caption text-mute">(sample)</span>
        </div>
        <div class="rx-pattern-wrap flex items-stretch">
          <span class="rx-delim code-mono" aria-hidden="true">/</span>
          <input
            id="rx-pattern"
            type="text"
            class="rx-pattern code-mono"
            value={seedPattern}
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            inputmode="text"
            placeholder="Enter a regular expression…"
            aria-describedby="rx-pattern-hint"
          />
          <span id="rx-flag-mirror" class="rx-delim rx-delim--flags code-mono" aria-hidden="true">{`/${seedFlags}`}</span>
        </div>
        <p id="rx-pattern-hint" class="sr-only">
          JavaScript regular expression syntax. Matching updates as you type.
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <fieldset class="rx-flags flex flex-col gap-1.5">
          <legend class="eyebrow">Flags</legend>
          <div class="flex flex-wrap gap-1.5" role="group" aria-label="Regular expression flags">
            <label class="rx-flag rx-tap" title="Global — find all matches">
              <input type="checkbox" class="rx-flag-input sr-only" value="g" checked={seedFlagSet.has('g')} />
              <span class="rx-flag-glyph code-mono" aria-hidden="true">g</span>
              <span class="rx-flag-name">global</span>
            </label>
            <label class="rx-flag rx-tap" title="Ignore case">
              <input type="checkbox" class="rx-flag-input sr-only" value="i" checked={seedFlagSet.has('i')} />
              <span class="rx-flag-glyph code-mono" aria-hidden="true">i</span>
              <span class="rx-flag-name">ignore case</span>
            </label>
            <label class="rx-flag rx-tap" title="Multiline — ^ and $ match line breaks">
              <input type="checkbox" class="rx-flag-input sr-only" value="m" checked={seedFlagSet.has('m')} />
              <span class="rx-flag-glyph code-mono" aria-hidden="true">m</span>
              <span class="rx-flag-name">multiline</span>
            </label>
            <label class="rx-flag rx-tap" title="Dotall — . matches newlines">
              <input type="checkbox" class="rx-flag-input sr-only" value="s" checked={seedFlagSet.has('s')} />
              <span class="rx-flag-glyph code-mono" aria-hidden="true">s</span>
              <span class="rx-flag-name">dotall</span>
            </label>
            <label class="rx-flag rx-tap" title="Unicode">
              <input type="checkbox" class="rx-flag-input sr-only" value="u" checked={seedFlagSet.has('u')} />
              <span class="rx-flag-glyph code-mono" aria-hidden="true">u</span>
              <span class="rx-flag-name">unicode</span>
            </label>
          </div>
        </fieldset>

        <div class="flex min-w-0 flex-wrap items-end gap-2">
          <div class="flex min-w-0 flex-col gap-1.5">
            {/* The EXAMPLE picker — the `.rx-flag` row above and the snapshot
                picker below are unrelated. */}
            <span class="eyebrow">Examples</span>
            <ExampleChips prefix="rx" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
          </div>
          <button
            id="rx-test"
            type="button"
            class="btn-tool rx-tap"
            title="Run now (⌘/Ctrl + Enter)"
            aria-keyshortcuts="Meta+Enter Control+Enter"
          >
            Run now
          </button>
        </div>
      </div>
    </div>

    {/* ── Sample editor | highlighted matches (side by side ≥768px) ────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <div class="rx-grid">
        <EditorPane prefix="rx" id="rx-editor" label="sample.log">
          <pre class="editor-pane__fallback code-mono" data-cm-fallback>{seedText}</pre>
        </EditorPane>
        <div class="rx-hl-pane instrument-flush">
          <FigureCap label="matches · highlighted" />
          {/* Seeded at build time (see `seedHighlightHtml` above) so the
              marked-up log is in the static HTML; the client rebuilds it. */}
          <div
            id="rx-highlight"
            class="rx-highlight"
            role="region"
            aria-label="Sample text with matches highlighted"
            set:html={seedHighlightHtml}
            data-results
          >
          </div>
        </div>
      </div>
      <RunHint variant="cm" class="mt-2" />
      <SnapshotBar prefix="rx" />
    </div>

    {/* ── Result: count + per-match groups table on the L2 instrument ──── */}
    <ResultPanel slug="regex-log-tester" prefix="rx" summary={seedSummary} label="Matches" summaryClass="whitespace-nowrap" split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="rx-share" />
        <CopyButton kind="all" id="rx-copy-md" label="Copy as Markdown" icon="markdown" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the match table is in
          the static HTML; the client rebuilds the same markup on boot. */}
      <div id="rx-results" class="rx-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* Tap targets opt into fast-tap + no double-tap-zoom on touch. */
  .rx-tap {
    touch-action: manipulation;
  }

  /* Pattern input — a slash-delimited /…/ field on the canvas surface. */
  .rx-pattern-wrap {
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .rx-pattern-wrap:focus-within {
    box-shadow: inset 0 0 0 1px var(--color-link), 0 0 0 3px var(--color-link-bg-soft);
  }
  .rx-delim {
    display: inline-flex;
    align-items: center;
    padding: 0 4px 0 10px;
    color: var(--color-mute);
    user-select: none;
  }
  .rx-delim--flags {
    padding: 0 12px 0 4px;
    min-width: 24px;
    justify-content: flex-start;
    white-space: nowrap;
  }
  .rx-pattern {
    flex: 1 1 auto;
    min-width: 0;
    height: var(--control-h-lg);
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-size: 14px;
    line-height: 20px;
    padding: 0;
    outline: none;
  }
  .rx-pattern::placeholder {
    color: var(--color-mute);
  }
  .rx-pattern-wrap.rx-pattern-wrap--error {
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  .rx-pattern-wrap.rx-pattern-wrap--error:focus-within {
    box-shadow: inset 0 0 0 1px var(--color-error), 0 0 0 3px var(--color-error-soft);
  }

  /* Flag toggles — selectable mono glyph + label. */
  .rx-flags {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .rx-flag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--control-h-md);
    padding: 0 10px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-mute);
    cursor: pointer;
    user-select: none;
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      color var(--dur-fast) var(--ease-brand),
      box-shadow var(--dur-fast) var(--ease-brand);
  }
  .rx-flag:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
    color: var(--color-body);
  }
  .rx-flag-glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    font-weight: 500;
  }
  .rx-flag-name {
    font-size: 12px;
    line-height: 16px;
  }
  /* Checked state — driven by the :checked sibling, not a JS class. */
  .rx-flag:has(.rx-flag-input:checked) {
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-hairline);
  }
  /* Keyboard focus ring on the visually-hidden checkbox. */
  .rx-flag:has(.rx-flag-input:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
  /* Coarse pointers (touch): meet the 44px minimum touch-target size. */
  @media (pointer: coarse) {
    .rx-flag {
      min-height: var(--control-h-lg);
    }
  }

  /* Sample editor | highlighted matches, side by side from 768px. */
  .rx-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  @media (min-width: 768px) {
    .rx-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .rx-hl-pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Highlighted preview — the sample text re-rendered with <mark> spans.
     Filled at runtime via innerHTML, so every selector inside is :global(...). */
  .rx-highlight {
    overflow: auto;
    max-height: 420px;
    padding: 4px 8px 8px;
    scrollbar-width: thin;
  }
  :global(.rx-pre) {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.4;
    color: var(--color-inverse-fg);
    white-space: pre-wrap;
    word-break: break-word;
    tab-size: 2;
  }
  :global(.rx-mark) {
    background: #8fc97a33;
    color: var(--color-inverse-fg);
    border-radius: 3px;
    box-shadow: inset 0 0 0 1px var(--color-inverse-brand);
    padding: 0 1px;
  }
  /* Alternate tint so adjacent matches stay distinguishable. */
  :global(.rx-mark--alt) {
    background: #c9bfe033;
    box-shadow: inset 0 0 0 1px #c9bfe0;
  }
  /* Zero-length match marker (e.g. /^/) — a thin caret rule. */
  :global(.rx-mark--empty) {
    box-shadow: inset 1px 0 0 0 var(--color-inverse-brand);
    background: transparent;
    padding: 0;
  }
  :global(.rx-hl-empty) {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-inverse-mute);
  }

  /* Results region. */
  .rx-results {
    min-height: var(--control-h-lg);
  }

  /* ── Matches table (render.ts; styled with :global) ──────────────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.rx-results` container. */
  :global(.rx-table-wrap) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: auto;
    animation: rx-rise var(--dur-base) var(--ease-brand) both;
  }
  @keyframes rx-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.rx-table-wrap) {
      animation: none;
    }
  }
  :global(.rx-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    line-height: 18px;
  }
  :global(.rx-table th),
  :global(.rx-table td) {
    text-align: left;
    padding: 8px 12px;
    vertical-align: top;
    border-bottom: 1px solid var(--color-hairline);
  }
  /* Column heads take the row-key role (label-field): mono 11/16 uppercase. */
  :global(.rx-table thead th) {
    @apply label-field;
    background: var(--color-canvas-soft-2);
    white-space: nowrap;
    position: sticky;
    top: 0;
  }
  :global(.rx-table tbody tr:last-child td) {
    border-bottom: 0;
  }
  :global(.rx-table tbody tr:hover) {
    background: var(--color-canvas-soft);
  }
  :global(.rx-idx) {
    font-family: var(--font-mono);
    color: var(--color-mute);
    white-space: nowrap;
  }
  :global(.rx-val) {
    font-family: var(--font-mono);
    color: var(--color-ink);
    word-break: break-word;
  }
  :global(.rx-val--empty) {
    color: var(--color-mute);
    font-style: italic;
  }
  /* Per-row capture / named group tags. */
  :global(.rx-groups) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  :global(.rx-group) {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-soft-2);
    box-shadow: var(--shadow-hairline);
    max-width: 100%;
  }
  :global(.rx-group__key) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-mute);
    white-space: nowrap;
  }
  :global(.rx-group__val) {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink);
    word-break: break-word;
  }
  :global(.rx-group__val--empty) {
    color: var(--color-mute);
    font-style: italic;
  }
  :global(.rx-nogroups) {
    color: var(--color-mute);
  }

  /* Parse-error banner. */
  :global(.rx-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
    animation: rx-rise var(--dur-base) var(--ease-brand) both;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.rx-error) {
      animation: none;
    }
  }
  :global(.rx-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.rx-error__body) {
    min-width: 0;
  }
  :global(.rx-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.rx-error__detail) {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* Non-fatal notice banner (scan cap / match cap) — informational, NOT an
     error: the results it sits above are real, just incomplete. */
  :global(.rx-notice) {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-bottom: 10px;
    padding: 10px 12px;
    border-radius: var(--radius-md);
    background: var(--color-warning-soft);
    box-shadow: inset 0 0 0 1px var(--color-warning);
    color: var(--color-warning-deep);
  }
  :global(.rx-notice__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.rx-notice__text) {
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }

  /* No-match note. */
  :global(.rx-nomatch) {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    animation: rx-rise var(--dur-base) var(--ease-brand) both;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.rx-nomatch) {
      animation: none;
    }
  }
  :global(.rx-nomatch__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    color: var(--color-mute);
  }
  :global(.rx-nomatch__text) {
    font-size: 13px;
    line-height: 18px;
  }

  /* Empty state — generous, centered frame. */
  :global(.rx-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* ── Instrument re-skin — the matches sit on the L2 result slab (dark in
     BOTH themes), so everything render.ts emits uses the slab ink tier. ── */
  .rx-results :global(.rx-table-wrap),
  .rx-results :global(.rx-nomatch),
  .rx-results :global(.rx-empty) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-fg);
  }
  .rx-results :global(.rx-table th),
  .rx-results :global(.rx-table td) {
    border-bottom-color: #ffffff12;
  }
  .rx-results :global(.rx-table thead th) {
    background: var(--color-inverse);
    color: var(--color-inverse-mute);
  }
  .rx-results :global(.rx-table tbody tr:hover) {
    background: #ffffff08;
  }
  .rx-results :global(.rx-val),
  .rx-results :global(.rx-group__val) {
    color: var(--color-inverse-fg);
  }
  .rx-results :global(.rx-idx),
  .rx-results :global(.rx-val--empty),
  .rx-results :global(.rx-group__key),
  .rx-results :global(.rx-group__val--empty),
  .rx-results :global(.rx-nogroups),
  .rx-results :global(.rx-nomatch__icon),
  .rx-results :global(.rx-empty) {
    color: var(--color-inverse-mute);
  }
  .rx-results :global(.rx-group) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .rx-results :global(.rx-notice) {
    background: #e0a45814;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-accent);
  }
  .rx-results :global(.rx-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
</style>

<script>
  import type { EditorView } from '@codemirror/view';
  import { wireRunKeys } from '../lib/run-keys';
  import { buildMarkdownBlock } from '../lib/share-md';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, clearChips, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  // The HTML builders are shared with the frontmatter's build-time seed —
  // one implementation, so the no-JS markup and the live markup never drift.
  import {
    resultsHtml,
    buildHighlight,
    summaryText,
    errorHtml,
    EMPTY_HTML,
  } from '../lib/regex-tester/render';
  import type { RegexResult, ShareState } from '../lib/regex-tester/types';

  type EngineModule = {
    run: (pattern: string, flags: string, text: string) => RegexResult;
    encodeState: (pattern: string, flags: string, text: string) => string;
    decodeState: () => ShareState | null;
  };
  type Example = {
    id: string;
    label: string;
    pattern: string;
    flags: string;
    text: string;
  };

  const ROOT_SEL = '.rx-pg';
  const SLUG = 'regex-log-tester';
  const DEBOUNCE_MS = 160;
  const FLAG_ORDER = ['g', 'i', 'm', 's', 'u'] as const;

  /** Boot every (so far un-hydrated) playground instance on the page. */
  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.rxWired === 'true') return;
      root.dataset.rxWired = 'true';
      void init(root);
    });
  }

  /* ---- Small helpers -------------------------------------------------------- */

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function isCoarsePointer(): boolean {
    return window.matchMedia?.('(pointer: coarse)').matches ?? false;
  }

  /** Normalise the sibling examples array defensively. */
  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          pattern: typeof o.pattern === 'string' ? o.pattern : '',
          flags: typeof o.flags === 'string' ? o.flags : '',
          text: typeof o.text === 'string' ? o.text : '',
        } satisfies Example;
      });
  }

  /* ---- Result rendering (DOM writes over the shared pure builders) --------- */

  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderResults(container: HTMLElement, summary: HTMLElement, result: RegexResult): void {
    // ONLY `valid === false` is an invalid pattern. A truthy `notice` is a
    // caveat on a perfectly good run (input over the scan cap, matching stopped
    // at the match cap) and must never suppress the real matches below.
    const invalid = !result || result.valid === false;
    setSummary(summary, summaryText(result), invalid);
    container.innerHTML = resultsHtml(result);
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = EMPTY_HTML;
  }

  /* ---- Instance init -------------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const editorHost = el<HTMLElement>(root, '#rx-editor');
    const patternInput = el<HTMLInputElement>(root, '#rx-pattern');
    const patternWrap = root.querySelector<HTMLElement>('.rx-pattern-wrap');
    const flagMirror = el<HTMLElement>(root, '#rx-flag-mirror');
    const chipsWrap = el<HTMLElement>(root, '#rx-chips');
    const highlightBox = el<HTMLElement>(root, '#rx-highlight');
    const resultsBox = el<HTMLElement>(root, '#rx-results');
    const summaryEl = el<HTMLElement>(root, '#rx-summary');
    const copyStatus = el<HTMLElement>(root, '#rx-copy-status');
    const shareBtn = el<HTMLButtonElement>(root, '#rx-share');
    const mdBtn = el<HTMLButtonElement>(root, '#rx-copy-md');
    const testBtn = el<HTMLButtonElement>(root, '#rx-test');
    const sampleCue = el<HTMLElement>(root, '#rx-sample-cue');
    const flagInputs = Array.from(root.querySelectorAll<HTMLInputElement>('.rx-flag-input'));
    const snapSaveBtn = el<HTMLButtonElement>(root, '#rx-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#rx-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#rx-snap-delete');

    if (
      !editorHost ||
      !patternInput ||
      !patternWrap ||
      !chipsWrap ||
      !highlightBox ||
      !resultsBox ||
      !summaryEl ||
      !copyStatus ||
      !shareBtn ||
      !mdBtn ||
      !testBtn ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    // Copy plumbing (Copy link, Copy as Markdown) — the kit helper: one
    // delegated listener; outcomes announced in #rx-copy-status.
    wireCopyButtons(root, { status: copyStatus });

    // Lazily load the sibling engine + examples + CodeMirror + the kit's plate
    // theme (kept off the initial path so CM code-splits into its own chunk).
    let engine: EngineModule;
    let examples: Example[] = [];
    let EditorState: typeof import('@codemirror/state').EditorState;
    let EditorViewCtor: typeof import('@codemirror/view').EditorView;
    let keymap: typeof import('@codemirror/view').keymap;
    let lineNumbers: typeof import('@codemirror/view').lineNumbers;
    let highlightActiveLine: typeof import('@codemirror/view').highlightActiveLine;
    let defaultKeymap: typeof import('@codemirror/commands').defaultKeymap;
    let history: typeof import('@codemirror/commands').history;
    let historyKeymap: typeof import('@codemirror/commands').historyKeymap;
    let indentWithTab: typeof import('@codemirror/commands').indentWithTab;
    let plate: typeof import('../lib/playground-kit/cm-theme').plate;
    try {
      const [engineMod, examplesMod, stateMod, viewMod, commandsMod, themeMod] =
        await Promise.all([
          import('../lib/regex-tester/engine'),
          import('../lib/regex-tester/examples'),
          import('@codemirror/state'),
          import('@codemirror/view'),
          import('@codemirror/commands'),
          import('../lib/playground-kit/cm-theme'),
        ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
      ({ EditorState } = stateMod);
      ({ EditorView: EditorViewCtor, keymap, lineNumbers, highlightActiveLine } = viewMod);
      ({ defaultKeymap, history, historyKeymap, indentWithTab } = commandsMod);
      ({ plate } = themeMod);
    } catch (err) {
      setSummary(summaryEl, 'Error', true);
      resultsBox.innerHTML = errorHtml(
        'Could not load the tester',
        'The regex engine failed to load. Reload the page to try again.'
      );
      // eslint-disable-next-line no-console
      console.error('[RegexLogTester] engine/examples import failed:', err);
      return;
    }

    /* ---- Editor factory (CM symbols now in async scope) --------------------- */

    function makeEditor(host: HTMLElement, doc: string, onChange: () => void): EditorView {
      const state = EditorState.create({
        doc,
        extensions: [
          lineNumbers(),
          history(),
          highlightActiveLine(),
          plate,
          // Sizing only — colours, gutters and the focus ring come from the
          // plate theme and the EditorPane rule in global.css.
          EditorViewCtor.theme({
            '&': { fontSize: '13px', maxHeight: '420px' },
            '.cm-scroller': { overflow: 'auto' },
          }),
          EditorViewCtor.lineWrapping,
          EditorViewCtor.contentAttributes.of({ 'aria-label': 'Sample log lines' }),
          keymap.of([
            // Ours FIRST, so it wins over defaultKeymap's Enter.
            {
              key: 'Mod-Enter',
              run: (view) => {
                runNow(true);
                if (isCoarsePointer()) view.contentDOM.blur();
                return true;
              },
            },
            { key: 'Escape', run: (view) => { view.contentDOM.blur(); return true; } },
            ...defaultKeymap,
            ...historyKeymap,
            indentWithTab,
          ]),
          EditorViewCtor.updateListener.of((u) => {
            if (u.docChanged) onChange();
          }),
        ],
      });
      return new EditorViewCtor({ state, parent: host });
    }

    function setEditorDoc(view: EditorView, doc: string): void {
      view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: doc } });
    }

    /** Collect the active flags in canonical g i m s u order. */
    function currentFlags(): string {
      const set = new Set(flagInputs.filter((c) => c.checked).map((c) => c.value));
      return FLAG_ORDER.filter((f) => set.has(f)).join('');
    }

    /** Mirror the active flags after the closing slash of the pattern field. */
    function syncFlagMirror(): void {
      if (flagMirror) flagMirror.textContent = `/${currentFlags()}`;
    }

    /** Hide + reset both copy actions (error/empty states never show them). */
    function hideActions(): void {
      for (const btn of [shareBtn!, mdBtn!]) {
        btn.hidden = true;
        btn.dataset.copy = '';
      }
    }

    /** Drop the `#s=...` share fragment without adding a history entry. */
    function clearHash(): void {
      try {
        window.history.replaceState(null, '', window.location.pathname + window.location.search);
      } catch {
        /* ignore — Safari's replaceState throttle must never break input */
      }
    }

    /**
     * Run the engine and repaint the highlight + table. Never throws.
     * `userInitiated` gates whether the URL hash is written and the last input
     * recorded — seeding from a bundled example, a shared link or a restored
     * input must never itself rewrite the address bar.
     */
    function runNow(userInitiated = true): void {
      window.clearTimeout(debounceTimer);
      const pattern = patternInput!.value;
      const flags = currentFlags();
      const text = editorView.state.doc.toString();

      if (pattern.length === 0) {
        patternWrap!.classList.remove('rx-pattern-wrap--error');
        highlightBox!.innerHTML = buildHighlight(text, []);
        renderEmpty(resultsBox!, summaryEl!);
        hideActions();
        if (userInitiated) clearHash();
        return;
      }

      let result: RegexResult;
      try {
        result = engine.run(pattern, flags, text);
      } catch (err) {
        result = {
          valid: false,
          error: err instanceof Error ? err.message : 'Unexpected error while matching.',
          matchCount: 0,
          matches: [],
        };
      }

      // A non-fatal `notice` (scan cap / match cap) is NOT a failure — the
      // pattern compiled and the matches are real, so the highlight and the
      // copy actions all stay available.
      const ok = result && result.valid !== false;
      patternWrap!.classList.toggle('rx-pattern-wrap--error', !ok);
      patternInput!.setAttribute('aria-invalid', ok ? 'false' : 'true');

      const matches = ok && Array.isArray(result.matches) ? result.matches : [];
      highlightBox!.innerHTML = buildHighlight(text, matches);
      renderResults(resultsBox!, summaryEl!, result);

      if (!ok) {
        hideActions();
        if (userInitiated) clearHash();
        return;
      }

      const hash = engine.encodeState(pattern, flags, text);
      shareBtn!.dataset.copy =
        window.location.origin + window.location.pathname + window.location.search + hash;
      shareBtn!.hidden = false;

      const count = Number.isFinite(result.matchCount) ? result.matchCount : 0;
      const matchSummary = count === 0 ? 'No matches' : count === 1 ? '1 match' : `${count} matches`;
      const first = matches[0];
      mdBtn!.dataset.copy = buildMarkdownBlock('Regex & Log Line Tester', [
        { label: 'Pattern', value: pattern },
        { label: 'Flags', value: flags },
        { label: 'Log', value: text },
        { label: 'Result', value: matchSummary },
        { label: 'First match', value: first ? first.match : '' },
      ]);
      mdBtn!.hidden = false;

      if (userInitiated) {
        try {
          window.history.replaceState(null, '', hash);
        } catch {
          /* ignore — Safari's replaceState throttle must never break input */
        }
        recordToolLastInput(SLUG, JSON.stringify({ pattern, flags, text }));
      }
    }

    // Debounce so heavy patterns/large text don't thrash on every keystroke.
    let debounceTimer: number | undefined;
    function scheduleRun(): void {
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(() => runNow(true), DEBOUNCE_MS);
    }

    // Seed content: prefer a shared-state URL hash, then a restored last
    // input, else the first example. Neither non-user seed path writes the
    // hash or records a last-input — only a user-initiated runNow() does.
    let seed = examples[0] ?? { id: '', label: '', pattern: '', flags: '', text: '' };
    let fromShare = false;
    try {
      const decoded = engine.decodeState();
      if (decoded && (decoded.pattern || decoded.text)) {
        seed = {
          id: '',
          label: 'Shared snippet',
          pattern: decoded.pattern,
          flags: decoded.flags,
          text: decoded.text,
        };
        fromShare = true;
      }
    } catch {
      /* malformed hash — fall back to the example seed */
    }

    let fromRestored = false;
    if (!fromShare) {
      const restored = getRestoredLastInput(SLUG);
      if (restored) {
        try {
          const parsed = JSON.parse(restored) as unknown;
          const obj = (parsed ?? {}) as Record<string, unknown>;
          const rPattern = typeof obj.pattern === 'string' ? obj.pattern : '';
          const rFlags = typeof obj.flags === 'string' ? obj.flags : '';
          const rText = typeof obj.text === 'string' ? obj.text : '';
          if (rPattern || rText) {
            seed = { id: '', label: 'Restored input', pattern: rPattern, flags: rFlags, text: rText };
            fromRestored = true;
          }
        } catch {
          /* malformed restored value — fall back to the example seed */
        }
      }
    }

    // The example chips are already in the static HTML (ExampleChips); the
    // script only wires them. A shared link, a restored input or a snapshot
    // is not a bundled example, so it leaves EVERY chip unpressed.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));

    /**
     * Any doc edit means what is on screen is no longer the bundled example, so
     * no chip stays pressed. The two programmatic writers (a chip click, a
     * snapshot restore) re-assert the chip they want AFTER their setEditorDoc
     * call, in the same synchronous block, so nothing flickers.
     */
    function onDocChange(): void {
      clearChips(chipsWrap);
      scheduleRun();
    }

    const editorView = makeEditor(editorHost, seed.text, onDocChange);
    // The build-time text stand-in has done its job (no-JS visitors and
    // crawlers); CodeMirror appended its editor beside it, so drop it. The
    // share/restore tiers above already resolved into `seed`, so the
    // server-rendered example never wins over a deep link or a saved input.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());
    patternInput.value = seed.pattern;
    const seedFlags = new Set(seed.flags.split(''));
    flagInputs.forEach((c) => {
      c.checked = seedFlags.has(c.value);
    });
    syncFlagMirror();

    syncChipsByIndex(chipsWrap, fromShare || fromRestored || examples.length === 0 ? null : 0);

    // A shared/restored/custom seed isn't a bundled "sample" — don't advertise it as one.
    let sampleCueDismissed = fromShare || fromRestored;
    if ((fromShare || fromRestored) && sampleCue) sampleCue.hidden = true;

    // Swap pattern + flags + sample text when a different example is chosen.
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        const ex = examples[idx];
        patternInput.value = ex.pattern;
        const want = new Set(ex.flags.split(''));
        flagInputs.forEach((c) => {
          c.checked = want.has(c.value);
        });
        syncFlagMirror();
        setEditorDoc(editorView, ex.text); // triggers onDocChange via updateListener
        syncChipsByIndex(chipsWrap, idx); // after the doc write, which clears every chip
        // Show the "(sample)" cue again for the newly loaded example.
        sampleCueDismissed = false;
        if (sampleCue) sampleCue.hidden = false;
        runNow();
      });
    });

    // "Run now" — immediate run on demand.
    testBtn.addEventListener('click', () => runNow());

    // Dismiss the "(sample)" cue once the user edits the pattern.
    function dismissSampleCue(): void {
      if (!sampleCueDismissed && sampleCue) {
        sampleCueDismissed = true;
        sampleCue.hidden = true;
      }
    }

    // Pattern edits + flag toggles re-run (debounced for typing, immediate for
    // flags). Either one means the on-screen state is no longer the bundled
    // example, so the pressed chip is released.
    patternInput.addEventListener('input', () => {
      clearChips(chipsWrap);
      dismissSampleCue();
      scheduleRun();
    });
    // The pattern field is single-line: Enter runs it, as does Ctrl/Cmd+Enter
    // (which also works from inside the log editor, via the keymap above).
    wireRunKeys(patternInput, () => runNow(true));
    flagInputs.forEach((c) => {
      c.addEventListener('change', () => {
        clearChips(chipsWrap);
        syncFlagMirror();
        runNow();
      });
    });

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () =>
        JSON.stringify({
          pattern: patternInput!.value,
          flags: currentFlags(),
          text: editorView.state.doc.toString(),
        }),
      setValue: (value) => {
        let parsed: unknown;
        try {
          parsed = JSON.parse(value);
        } catch {
          return;
        }
        const obj = (parsed ?? {}) as Record<string, unknown>;
        const pattern = typeof obj.pattern === 'string' ? obj.pattern : '';
        const flags = typeof obj.flags === 'string' ? obj.flags : '';
        const text = typeof obj.text === 'string' ? obj.text : '';
        patternInput!.value = pattern;
        const want = new Set(flags.split(''));
        flagInputs.forEach((c) => {
          c.checked = want.has(c.value);
        });
        syncFlagMirror();
        setEditorDoc(editorView, text); // triggers onDocChange via updateListener
        // A snapshot is not a bundled example — leave every chip unpressed.
        clearChips(chipsWrap);
        dismissSampleCue();
        runNow();
      },
    });

    // Initial paint — seeding (example or shared link) must never itself
    // rewrite the address bar; only user-initiated evaluations do.
    runNow(false);
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
