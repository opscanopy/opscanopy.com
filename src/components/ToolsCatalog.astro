---
/**
 * ToolsCatalog — the shared catalog body for /tools and its 4 localized
 * mirrors (de/es/fr/pt-br). Single source of truth for the pinned shelf, the
 * category row, search + sort + empty-state, the category sections of
 * ToolCards, and their script/style — previously hand-copied into all 5
 * pages, which had already drifted before this component existed.
 *
 * Shape since batch D (2026-10):
 *   - ONE category row. The "Browse by category" `<nav>` of real links to the
 *     12 `/tools/<cat>/` pages IS the filter row: each `<a>` carries
 *     `data-cat`, and `aria-current="true"` marks the active one (the only
 *     valid "selected" state on an anchor). "All" stays a `<button>` — there
 *     is no /tools/all/ page. The script intercepts PLAIN left clicks only
 *     (filters, brings the row to the top so the section sits under it, mirrors the choice into `?cat=` via
 *     replaceState); a modified click, middle click, keyboard "open in new
 *     tab" and no-JS all navigate to the category page. The links' anchor
 *     text (`<label> <count>`) is unchanged — the SEO guard watches it.
 *   - Every card is server-rendered, grouped into 12 category `<section>`s
 *     (registry order) with `label-field` headings. Filtering hides cards and
 *     emptied sections by CLASS only, so a crawled `?cat=` URL still shows
 *     the full catalog under the page's self-canonical.
 *   - No "Available now / Live tools." head: the page's H1 already says it,
 *     and the category headings carry the structure. `#live-heading` (the
 *     id the five /tools pages' `aria-labelledby` points at) now sits on
 *     the row's label.
 *
 * The <script> below is a REAL module (no define:vars), so Astro bundles it
 * into one hashed, cacheable chunk shared by every page that renders this
 * component — not 5 copies inlined into 5 HTML documents. Locale strings the
 * script needs (the empty-state template + its "your search" fallback) are
 * read from data-* attributes on #tool-empty at init, so the script itself
 * stays 100% locale-agnostic.
 *
 * Self-detects the locale via Astro.currentLocale (same pattern as ToolCard),
 * so callers pass no props. Tool name/tagline/description/keywords stay
 * English everywhere — only this catalog's own chrome is translated.
 */
import ToolCard from './ToolCard.astro';
import { liveTools, categories, toolsInCategory, categoryAccentVar } from '../data/tools';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { useTranslations, localizeKey } from '../i18n/utils';
import type { UiKey } from '../i18n/ui/en';

const lang: Locale = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE;
const t = useTranslations(lang);
const catLabel = (cat: string) => t(`category.${cat}` as UiKey);
---

{/* Pinned/recent shelf — every live tool gets a hidden tile so the client
    script needs no metadata of its own; it only reveals + reorders. Stays
    hidden entirely when there are no saved prefs (zero CLS) or storage is
    blocked. */}
<div id="tools-shelf" class="mb-8" hidden>
  <p class="eyebrow">{t('tools.jumpBackIn')}</p>
  <p class="caption mt-1 text-mute">{t('tools.jumpBackInCaption')}</p>
  <ul id="tools-shelf-list" role="list" class="mt-3 flex flex-wrap gap-2">
    {
      liveTools.map((tool) => (
        <li data-shelf-slug={tool.slug} hidden>
          <a
            href={localizeKey(`/${tool.slug}`, lang)}
            class="badge inline-flex items-center gap-1.5 hover:bg-brand/10"
          >
            <span class="shelf-pin-dot hidden size-1.5 rounded-full bg-brand-strong" aria-hidden="true" />
            {tool.name}
          </a>
        </li>
      ))
    }
  </ul>
</div>

{
  liveTools.length > 0 && (
    <nav aria-label={t('tools.browseByCategory')} class="cat-browse-nav">
      <span id="live-heading" class="cat-browse-label label-field">{t('tools.browseByCategory')}</span>
      <div class="cat-browse-scroll">
        <div id="cat-filters" class="cat-browse-inner">
          <button type="button" data-cat="all" class="cat-chip chip" aria-current="true">
            {t('category.all')}
          </button>
          {categories.map((c) => (
            <a
              href={`/tools/${c.slug}/`}
              data-cat={c.category.toLowerCase()}
              data-cat-slug={c.slug}
              class="cat-chip chip"
            >
              <span
                class="size-1.5 shrink-0 rounded-full"
                style={`background-color: ${categoryAccentVar(c.category)}`}
                aria-hidden="true"
              />
              {catLabel(c.category)}
              <span class="tabular-nums text-mute">{c.count}</span>
            </a>
          ))}
        </div>
      </div>
    </nav>
  )
}

{
  liveTools.length === 0 ? (
    <div class="card-soft mt-10 flex flex-col items-center rounded-lg px-6 py-16 text-center">
      <p class="display-sm text-ink">{t('tools.zeroLiveTitle')}</p>
      <p class="body-md mt-3 max-w-md text-pretty text-body">{t('tools.zeroLiveBody')}</p>
    </div>
  ) : (
    <>
      <div class="mt-6 space-y-4">
        <div class="flex flex-wrap items-center gap-3">
          <input
            id="tool-search"
            type="search"
            placeholder={t('tools.searchPlaceholder')}
            autocomplete="off"
            class="input-focus min-w-0 flex-1 basis-64 rounded-lg border border-hairline bg-canvas px-4 py-3 sm:py-2.5 text-sm text-ink placeholder:text-mute"
            aria-label={t('tools.searchLabel')}
          />
          <div class="flex shrink-0 items-center gap-2">
            <label for="tool-sort" class="label-field">{t('tools.sortLabel')}</label>
            <select
              id="tool-sort"
              class="input-focus cursor-pointer rounded-lg border border-hairline bg-canvas py-1.5 pl-3 pr-8 text-sm font-medium text-ink"
              aria-label={t('tools.sortAriaLabel')}
            >
              <option value="default">{t('tools.sortDefault')}</option>
              <option value="az">{t('tools.sortAZ')}</option>
              <option value="newest">{t('tools.sortNewest')}</option>
            </select>
          </div>
        </div>
        <div
          id="tool-empty"
          class="hidden py-6"
          role="status"
          aria-live="polite"
          data-empty-tpl={t('tools.emptyTitle')}
          data-empty-fallback={t('tools.emptyQueryFallback')}
        >
          <p class="body-md text-ink"><span id="tool-empty-msg"></span></p>
          <p class="body-sm mt-1 text-body">{t('tools.emptyHint')}</p>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <button type="button" data-example="subnet" class="example-chip chip">subnet</button>
            <button type="button" data-example="jwt" class="example-chip chip">jwt</button>
            <button type="button" data-example="cron" class="example-chip chip">cron</button>
            <button type="button" data-example="regex" class="example-chip chip">regex</button>
          </div>
          <button id="tool-clear" type="button" class="link-cta body-sm mt-4 inline-flex items-center">{t('tools.clearFilters')}</button>
        </div>
      </div>
      <div id="tool-grid" class="mt-10 space-y-14">
        {categories.map((c) => (
          <section
            id={`cat-${c.slug}`}
            class="cat-section scroll-mt-24"
            data-cat={c.category.toLowerCase()}
            aria-labelledby={`cat-h-${c.slug}`}
            style={`--cat-accent: ${categoryAccentVar(c.category)}`}
          >
            <h2 id={`cat-h-${c.slug}`} class="cat-section__h label-field">
              {catLabel(c.category)}
              <span class="tabular-nums">{c.count}</span>
            </h2>
            <ul role="list" class="cat-section__list mt-5 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
              {toolsInCategory(c.category).map((tool) => (
                <ToolCard tool={tool} order={liveTools.indexOf(tool)} />
              ))}
            </ul>
          </section>
        ))}
      </div>
    </>
  )
}

<script>
  import { TOOL_PREFS_KEY, parseToolPrefs, unpinnedRecentSlugs } from '../lib/tool-prefs/prefs';

  (function initShelf() {
    const shelf = document.getElementById('tools-shelf');
    const list = document.getElementById('tools-shelf-list');
    if (!shelf || !list) return;
    let prefs: ReturnType<typeof parseToolPrefs>;
    try {
      prefs = parseToolPrefs(localStorage.getItem(TOOL_PREFS_KEY));
    } catch (e) {
      prefs = parseToolPrefs(null);
    }
    const order = prefs.pins.concat(unpinnedRecentSlugs(prefs));
    if (order.length === 0) return; // stays hidden — zero CLS
    // A Map, not a plain object: a tampered oc-tools-v1 blob (devtools, a
    // shared computer) could otherwise contain a slug like "constructor"
    // that collides with Object.prototype and throws when treated as an
    // element, taking the whole catalog script (search/sort/filter) down
    // with it.
    const bySlug = new Map<string, HTMLElement>();
    list.querySelectorAll<HTMLElement>('[data-shelf-slug]').forEach(function (li) {
      bySlug.set(li.dataset.shelfSlug ?? '', li);
    });
    let shown = false;
    order.forEach(function (slug) {
      const li = bySlug.get(slug);
      if (!li) return; // renamed/removed tool — silently skip
      li.hidden = false;
      shown = true;
      if (prefs.pins.indexOf(slug) !== -1) {
        const dot = li.querySelector('.shelf-pin-dot');
        if (dot) dot.classList.remove('hidden');
      }
      list.appendChild(li); // moves the existing node, building the order
    });
    if (shown) shelf.hidden = false;
  })();

  (function () {
    const search = document.getElementById('tool-search') as HTMLInputElement | null;
    const empty = document.getElementById('tool-empty');
    const emptyMsg = document.getElementById('tool-empty-msg');
    const sortSelect = document.getElementById('tool-sort') as HTMLSelectElement | null;
    const grid = document.getElementById('tool-grid');
    const chips = Array.from(document.querySelectorAll<HTMLElement>('.cat-chip'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.cat-section'));
    const SORT_KEY = 'opscanopy:tools:sort';
    let activeCat = 'all';
    let activeSort = 'default';

    // Locale strings, read from the DOM (not define:vars) so this script is
    // identical — and therefore one cacheable chunk — across every locale.
    const emptyTitleTpl = (empty && empty.dataset.emptyTpl) || 'No tools match {query}.';
    const emptyFallback = (empty && empty.dataset.emptyFallback) || 'your search';

    // ── Sort ────────────────────────────────────────────────────────────
    // "Default" is ascending registry order (data-order). "Newest" prefers
    // the git-derived data-added date (real recency, from scripts/gen-tool-
    // meta.mjs) when BOTH cards being compared have one, falling back to the
    // registry-order proxy otherwise (e.g. before a build has generated
    // dates, or for a tool with no resolvable commit history). "A–Z" sorts
    // by tool name. Cards sort WITHIN their category section; the chosen
    // mode persists in localStorage.
    function applySort() {
      if (!grid) return;
      grid.querySelectorAll<HTMLElement>('.cat-section__list').forEach(function (list) {
        const cards = Array.from(list.querySelectorAll<HTMLElement>('.tool-card'));
        cards.sort(function (a, b) {
          if (activeSort === 'az') {
            return (a.dataset.name || '').localeCompare(b.dataset.name || '');
          }
          const oa = parseInt(a.dataset.order || '0', 10);
          const ob = parseInt(b.dataset.order || '0', 10);
          if (activeSort === 'newest') {
            const da = a.dataset.added, db = b.dataset.added;
            if (da && db) {
              const diff = new Date(db).getTime() - new Date(da).getTime();
              if (diff !== 0) return diff;
            }
            return ob - oa;
          }
          return oa - ob;
        });
        // Re-append in the new order; appendChild moves existing nodes (no clone),
        // so visibility (class) and event wiring are preserved.
        cards.forEach(function (card) { list.appendChild(card); });
      });
    }
    function setSort(mode: string) {
      activeSort = mode === 'az' || mode === 'newest' ? mode : 'default';
      if (sortSelect) sortSelect.value = activeSort;
      try { localStorage.setItem(SORT_KEY, activeSort); } catch (e) {}
      applySort();
    }

    // ── Category ────────────────────────────────────────────────────────
    // Reflect the active category onto the row: aria-current="true" on the
    // active chip (valid on the <a>s and the "All" <button> alike), absent on
    // the rest. `is-active` doubles it for CSS that cannot read ARIA.
    function setActiveCat(cat: string | undefined) {
      activeCat = cat || 'all';
      chips.forEach(function (chip) {
        const on = (chip.dataset.cat || 'all') === activeCat;
        if (on) chip.setAttribute('aria-current', 'true');
        else chip.removeAttribute('aria-current');
        chip.classList.toggle('is-active', on);
      });
    }
    function chipFor(slugOrCat: string | null): HTMLElement | undefined {
      if (!slugOrCat) return undefined;
      const q = slugOrCat.toLowerCase();
      return chips.find(function (c) { return c.dataset.catSlug === q || c.dataset.cat === q; });
    }
    // Mirror the choice into `?cat=<slug>` (never into an href: the row's
    // links stay the plain category URLs, and the sitemap never sees `?cat=`).
    function syncQuery() {
      if (!('replaceState' in history)) return;
      try {
        const url = new URL(location.href);
        const chip = chips.find(function (c) { return (c.dataset.cat || 'all') === activeCat; });
        if (activeCat === 'all' || !chip || !chip.dataset.catSlug) url.searchParams.delete('cat');
        else url.searchParams.set('cat', chip.dataset.catSlug);
        history.replaceState(history.state, '', url.pathname + url.search + url.hash);
      } catch (e) {}
    }
    function filter() {
      const raw = search ? search.value.trim() : '';
      const q = raw.toLowerCase();
      const cards = document.querySelectorAll<HTMLElement>('.tool-card');
      let visible = 0;
      cards.forEach(function (card) {
        const name = card.dataset.name || '';
        const cat = card.dataset.category || '';
        const tagline = card.dataset.tagline || '';
        const desc = card.dataset.desc || '';
        const keywords = card.dataset.keywords || '';
        const matchSearch =
          !q ||
          name.indexOf(q) !== -1 ||
          tagline.indexOf(q) !== -1 ||
          desc.indexOf(q) !== -1 ||
          keywords.indexOf(q) !== -1;
        const matchCat = activeCat === 'all' || cat === activeCat;
        const show = matchSearch && matchCat;
        // Class, not inline style: the SSR markup never carries display:none,
        // and a crawled ?cat= URL renders every card.
        card.classList.toggle('is-hidden', !show);
        if (show) visible++;
      });
      // A section with nothing left to show folds away with its heading.
      sections.forEach(function (section) {
        const any = Array.from(section.querySelectorAll<HTMLElement>('.tool-card')).some(function (c) {
          return !c.classList.contains('is-hidden');
        });
        section.classList.toggle('is-hidden', !any);
      });
      // Echo the query (or the localized "your search" fallback when filtering
      // by category only). Replacement via a function, not a bare string, so
      // a literal "$&"/"$'" typed into the search box is never expanded by
      // String.replace's special replacement-pattern syntax.
      if (emptyMsg) {
        const label = raw ? '"' + raw + '"' : emptyFallback;
        emptyMsg.textContent = emptyTitleTpl.replace('{query}', function () {
          return label;
        });
      }
      if (empty) empty.classList.toggle('hidden', visible > 0);
    }
    // The jump lands on the filter row, not on the section heading: once the
    // grid is filtered the chosen section is the first thing under the
    // search row anyway, and anchoring on the row keeps "All" and the other
    // categories on screen (scrolling to the section pushed the row off the
    // top on phones). The row's scroll-margin clears the 64px sticky header.
    function scrollToActive() {
      if (activeCat === 'all') return;
      const nav = document.querySelector<HTMLElement>('.cat-browse-nav');
      if (!nav) return;
      if (nav.getBoundingClientRect().top >= 0 && nav.getBoundingClientRect().top < 120) return;
      let reduce = false;
      try { reduce = matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      nav.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
    }
    // On narrow screens the row is a horizontal scroller, so the chosen chip
    // can sit outside the visible strip. Scroll only the strip (never the
    // page, so the vertical jump above is not interrupted) to centre it.
    function revealChip(chip: HTMLElement | undefined) {
      if (!chip) return;
      // The nearest ancestor that actually scrolls sideways (the inner wrapper is
      // wider than the screen but overflow-visible; .cat-browse-scroll scrolls).
      const scrolls = (el: HTMLElement) => {
        const ox = getComputedStyle(el).overflowX;
        return (ox === 'auto' || ox === 'scroll') && el.scrollWidth > el.clientWidth + 1;
      };
      let strip: HTMLElement | null = chip.parentElement;
      while (strip && !scrolls(strip)) strip = strip.parentElement;
      if (!strip || strip === document.body || strip === document.documentElement) return;
      const target = strip;
      // Rect maths, not offsetLeft: the strip may itself be positioned, which
      // changes what offsetLeft is relative to. One frame lets layout settle
      // (the boot path runs before the first paint).
      requestAnimationFrame(function () {
        const cr = chip.getBoundingClientRect();
        const sr = target.getBoundingClientRect();
        const left = target.scrollLeft + (cr.left - sr.left) - (target.clientWidth - cr.width) / 2;
        let reduce = false;
        try { reduce = matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
        target.scrollTo({ left: Math.max(0, left), behavior: reduce ? 'auto' : 'smooth' });
      });
    }
    if (search) search.addEventListener('input', filter);
    chips.forEach(function (chip) {
      chip.addEventListener('click', function (e: MouseEvent) {
        // Only a plain left click filters in place. Modified clicks (new tab /
        // window), middle clicks and the keyboard's "open link" variants keep
        // the anchor's native navigation to /tools/<cat>/.
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (chip.tagName === 'A') e.preventDefault();
        setActiveCat(chip.dataset.cat);
        filter();
        syncQuery();
        scrollToActive();
        revealChip(chip);
      });
    });
    if (sortSelect) {
      sortSelect.addEventListener('change', function () { setSort(sortSelect.value); });
    }
    // Empty-state escape hatches.
    const clearBtn = document.getElementById('tool-clear');
    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        if (search) search.value = '';
        setActiveCat('all');
        filter();
        syncQuery();
        if (search) search.focus();
      });
    }
    document.querySelectorAll<HTMLElement>('.example-chip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        if (search) search.value = chip.dataset.example || '';
        setActiveCat('all');
        filter();
        syncQuery();
        if (search) search.focus();
      });
    });

    // Restore the persisted sort on load (defaults to curated order), then sort.
    let saved = 'default';
    try { saved = localStorage.getItem(SORT_KEY) || 'default'; } catch (e) {}
    setSort(saved);
    // A shared `?cat=<slug>` link (or a reload after filtering) re-applies the
    // filter; an unknown value is ignored and the full catalog stays.
    let fromQuery: HTMLElement | undefined;
    try { fromQuery = chipFor(new URLSearchParams(location.search).get('cat')); } catch (e) {}
    if (fromQuery) {
      setActiveCat(fromQuery.dataset.cat);
      filter();
      revealChip(fromQuery);
    }
  })();
</script>

<style>
  /* Filtered-out cards and emptied sections fold away by class (never inline
     style), so the server-rendered catalog is always complete. The card <li>
     is rendered by ToolCard, so it carries ToolCard's scope, not this one:
     the card rule must be :global or it never matches. */
  :global(.tool-card.is-hidden),
  .cat-section.is-hidden {
    display: none;
  }

  /* Category row — the links to the 12 category pages, doubling as the filter
     chips. Wraps freely from 640px; collapses to a single-row scroll strip
     below, with a right-edge mask fade (continuation cue) and start-aligned
     scroll snap, so at rest no chip is cut at the strip's left edge. */
  .cat-browse-nav {
    scroll-margin-top: 5rem; /* sticky header (64px) + breathing room */
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .cat-browse-scroll {
    display: contents; /* transparent wrapper on desktop — no layout impact */
  }
  .cat-browse-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .cat-chip {
    gap: 0.375rem;
    white-space: nowrap;
  }
  /* Selected = brand-soft fill, brand-strong ink, inset leaf ring — the kit's
     `.chip[aria-pressed='true']` recipe keyed on aria-current, the valid
     selected state for an anchor. Hover is the neutral soft-2 step, so
     "pointing at" never reads as "chosen". */
  .cat-chip[aria-current='true'],
  .cat-chip[aria-current='true']:hover {
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
    box-shadow: inset 0 0 0 1px var(--color-brand);
  }
  @media (pointer: coarse) {
    .cat-chip {
      min-height: 44px;
    }
  }
  @media (max-width: 639px) {
    .cat-browse-nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .cat-browse-scroll {
      display: block; /* restore box layout so overflow-x works */
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; /* Firefox */
      scroll-snap-type: x proximity;
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
    }
    .cat-browse-scroll::-webkit-scrollbar {
      display: none; /* Chrome/Safari/Edge */
    }
    .cat-browse-inner {
      flex-wrap: nowrap;
      min-height: 44px;
      align-items: center;
      padding: 2px 40px 2px 2px; /* room for focus rings; the last chip clears the fade */
    }
    .cat-chip {
      flex-shrink: 0;
      min-height: 44px;
      scroll-snap-align: start;
    }
  }

  /* Category section heading: an L2 label with the category's dot drawn as a
     pseudo-element (no extra markup, nothing aria-hidden) and a hairline rule
     running to the right edge. */
  .cat-section__h {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cat-section__h::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--cat-accent, var(--color-brand));
    flex: none;
  }
  .cat-section__h::after {
    content: '';
    flex: 1 1 auto;
    height: 1px;
    margin-left: 0.5rem;
    background: var(--color-hairline);
  }
</style>
