---
/**
 * SystemdUnitValidatorPlayground — the interactive Systemd Unit Validator island.
 *
 * ONE CodeMirror editor with NO language mode (the CronToSystemd precedent — an
 * INI-ish unit file gains nothing from a highlighter, and a wrong one would
 * mis-colour `#` inside a value) plus line numbers, because every finding names a
 * line. Each finding row carries three affordances: a line badge that selects and
 * centres that line in the editor, the directive it is about, and a copy button
 * that yields one plain-text line fit for pasting into a review.
 *
 * Two controls beyond the usual: a System/User scope toggle (three rules only
 * make sense in one scope) and a read-only "Detected" chip showing which unit
 * kind the sections add up to.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * EditorPane (the editor slab under its figure cap), RunHint, SnapshotBar,
 * ResultPanel (the L2 instrument: figure cap, the one live summary, copy
 * status) and CopyButton. The results container stays here, seeded with
 * `set:html` + `data-results`; its slab inks anchor on `.su-results`.
 *
 * UX contract (CLAUDE.md): ONE ~160ms debounce, a ~600ms calm-error hold
 * before anything goes red, per-row copy + `data-copy-all` + `data-copy-link`,
 * a results container that is NOT `aria-live`, glossary captions instead of
 * tooltips, and `escapeHtml()` on every injected value — including values
 * that land inside an HTML attribute.
 *
 * Deep link: `createHashState('unit')` (`src/lib/hash-state.ts`). The fragment is
 * written ONLY after a valid, user-initiated evaluation — never on the boot seed,
 * which would hand every first-time visitor a shareable URL for input they never
 * typed. Hash logic is ported from CidrCheckerPlayground, NOT from
 * SubnetCalculatorPlayground, which writes during its own boot seed.
 *
 * Runtime contract (lazy-imported inside the boot closure so the engine, the
 * CodeMirror runtime and the plate theme code-split away from the page shell):
 *   ../lib/systemd-lint/engine      → lint, summaryLine, kindLabel
 *   ../lib/systemd-lint/examples    → examples: SystemdExample[]
 *   ../lib/playground-kit/cm-theme  → plate
 *
 * Only the example LABELS are read at build time (so the chips are
 * server-rendered and exist before hydration); the unit files themselves come
 * from the lazy import by index, which keeps multi-line text out of HTML
 * attributes entirely.
 */
import { examples } from '../lib/systemd-lint/examples';
import { lint, summaryLine, kindLabel } from '../lib/systemd-lint/engine';
import { resultHtml, EMPTY_HTML } from '../lib/systemd-lint/render';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-checks the same example on boot, so this
 * is pure progressive enhancement — but it means a visitor with no JS, and
 * every AI crawler (they do not execute JS), sees the real line-numbered
 * findings the first example produces instead of an empty "paste a unit file"
 * panel.
 *
 * `lint` is pure and synchronous and reads no clock, so it runs at build time
 * unchanged. It runs in the example's own scope, which is also what the scope
 * toggle below is server-rendered in, so the two agree. The unit text goes into
 * a `<pre data-cm-fallback>` inside the CodeMirror host — CM appends its editor
 * to the host, so the script removes the fallback once mounted. The `payloads`
 * array is client-only: per-row copy text is bound to `[data-payload]` after
 * hydration, because multi-line text round-trips badly through an attribute.
 */
const seedExample = examples[0];
const seedScope = seedExample?.scope ?? 'system';
const seedResult = seedExample ? lint(seedExample.unit, { scope: seedScope }) : null;
const seedOk = seedResult && seedResult.ok ? seedResult : null;
const seedText = seedExample?.unit ?? '';
const seedKind = seedOk ? kindLabel(seedOk.kind) : '—';
const seedHtml = seedOk ? resultHtml(seedOk, seedKind).html : EMPTY_HTML;
const seedSummary = seedOk ? summaryLine(seedOk) : '';
const seedHasErrors = Boolean(seedOk && seedOk.summary.errors > 0);
const chipItems = examples.map((ex) => ({ label: ex.label }));
---

<section class="su-pg" aria-label="Systemd Unit Validator playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Example chips ────────────────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow shrink-0">Examples</span>
      <ExampleChips prefix="su" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
      <p class="su-gloss caption text-mute">
        <strong class="font-medium text-body">WantedBy=</strong> lives in
        <span class="code-mono">[Install]</span> and is what <span class="code-mono">systemctl enable</span>
        reads to create its symlinks. <strong class="font-medium text-body">Type=</strong> tells systemd
        how to decide the service is up. <strong class="font-medium text-body">Persistent=true</strong>
        makes a calendar timer run immediately at boot if it missed its window.
      </p>
    </div>

    {/* ── Scope toggle + detected kind ─────────────────────────────────── */}
    <div
      class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-hairline px-4 py-3 sm:px-5"
    >
      <div class="flex flex-wrap items-center gap-2">
        <span class="eyebrow shrink-0">Scope</span>
        <div id="su-scope" class="su-scope" role="group" aria-label="Manager scope">
          <button
            type="button"
            class="su-scope__btn"
            data-scope="system"
            aria-pressed={seedScope === 'system' ? 'true' : 'false'}
          >
            System
          </button>
          <button
            type="button"
            class="su-scope__btn"
            data-scope="user"
            aria-pressed={seedScope === 'user' ? 'true' : 'false'}
          >
            User
          </button>
        </div>
      </div>
      <p id="su-kind" class="su-kind code-mono text-mute">Detected: {seedKind}</p>
    </div>

    {/* ── Input editor: the plate under its figure cap ─────────────────── */}
    <EditorPane prefix="su" label="unit file" id="su-input">
      <pre class="su-fallback editor-pane__fallback code-mono" data-cm-fallback>{seedText}</pre>
    </EditorPane>

    {/* ── Hints + snapshots (on paper) ─────────────────────────────────── */}
    <div class="border-b border-hairline px-4 pt-3 pb-4 sm:px-5">
      <RunHint variant="cm" id="su-run-hint" />
      <p class="su-hint caption text-mute">
        Tap a <span class="code-mono">Line</span> badge to jump to that line in the editor.
      </p>
      <SnapshotBar prefix="su" />
    </div>

    {/* ── Findings — the L2 instrument; the live summary reads out in the
        figure cap's actions slot. ────────────────────────────────────── */}
    <ResultPanel
      slug="systemd-unit-validator"
      prefix="su"
      summary={seedSummary}
      summaryClass={seedHasErrors ? 'text-inverse-error' : undefined}
      label="Findings"
      split
    >
      <Fragment slot="actions">
        <CopyButton kind="link" id="su-share" />
        <CopyButton kind="all" id="su-copy-all" label="Copy report" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the findings are in the
          static HTML; the client replaces them with the same markup on boot and
          binds the per-row copy payloads. */}
      <div id="su-results" class="su-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

