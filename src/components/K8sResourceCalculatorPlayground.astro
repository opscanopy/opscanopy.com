---
/**
 * K8sResourceCalculatorPlayground — the interactive Kubernetes Resource Calculator island.
 *
 * Given a Pod's CPU request / limit, memory request / limit, and a replica
 * count, it renders a per-pod and total-across-replicas breakdown as a rows
 * table (mono values) plus any advisory warnings (limit below request, no
 * limit set, …). Updates live (debounced).
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar, ResultPanel (figure cap, live summary, copy status)
 * and CopyButton. The results container stays here, seeded with
 * `set:html` + `data-results`; its slab overrides anchor on `.k8s-results`.
 *
 * Runtime contract (lazy-imported):
 *   ../lib/k8s-resources/engine   → calculate({ cpuRequest, cpuLimit, memRequest, memLimit, replicas }) → K8sResult
 *   ../lib/k8s-resources/examples → examples: { id; label; input: {...five fields} }[]
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. The chips are
// never rebuilt at hydration — the script only wires clicks onto them — so this
// adds nothing to the client bundle and cannot drift.
import { examples as prerenderedExamples } from '../lib/k8s-resources/examples';
import { calculate } from '../lib/k8s-resources/engine';
import { resultHtml, summaryText, EMPTY_HTML } from '../lib/k8s-resources/render';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-computes the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees a real worked answer
 * instead of an empty "enter a value" panel. The five fields are pre-filled
 * from the same example the client seeds them with.
 *
 * `calculate` is pure and synchronous, so it runs at build time unchanged.
 */
const seedExample = prerenderedExamples[0];
const seedResult = seedExample ? calculate(seedExample.input) : null;
const seedReplicas = seedExample ? Number(seedExample.input.replicas) || 1 : 1;
const seedHtml =
  seedResult && seedResult.valid ? resultHtml(seedResult, seedReplicas) : EMPTY_HTML;
const seedSummary = seedResult && seedResult.valid ? summaryText(seedResult) : '';
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="k8s-pg" aria-label="Kubernetes Resource Calculator playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow shrink-0">Example</span>
      {/* Server-rendered so the examples are in the static HTML; the hydration
          script only wires clicks onto these buttons, it never rebuilds them. */}
      <ExampleChips prefix="k8s" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
    </div>

    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <div class="k8s-fields">
        <div class="k8s-field" data-k8s-field="cpuRequest">
          <label class="eyebrow mb-2 block" for="k8s-cpu-req">CPU request</label>
          <input
            id="k8s-cpu-req"
            class="k8s-text code-mono"
            type="text"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            autocomplete="off"
            placeholder="500m"
            value={seedExample?.input.cpuRequest}
            aria-describedby="k8s-input-hint k8s-run-hint"
          />
        </div>
        <div class="k8s-field" data-k8s-field="cpuLimit">
          <label class="eyebrow mb-2 block" for="k8s-cpu-lim">CPU limit</label>
          <input
            id="k8s-cpu-lim"
            class="k8s-text code-mono"
            type="text"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            autocomplete="off"
            placeholder="1"
            value={seedExample?.input.cpuLimit}
            aria-describedby="k8s-input-hint k8s-run-hint"
          />
        </div>
        <div class="k8s-field" data-k8s-field="memRequest">
          <label class="eyebrow mb-2 block" for="k8s-mem-req">Memory request</label>
          <input
            id="k8s-mem-req"
            class="k8s-text code-mono"
            type="text"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            autocomplete="off"
            placeholder="256Mi"
            value={seedExample?.input.memRequest}
            aria-describedby="k8s-input-hint k8s-run-hint"
          />
        </div>
        <div class="k8s-field" data-k8s-field="memLimit">
          <label class="eyebrow mb-2 block" for="k8s-mem-lim">Memory limit</label>
          <input
            id="k8s-mem-lim"
            class="k8s-text code-mono"
            type="text"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            autocomplete="off"
            placeholder="512Mi"
            value={seedExample?.input.memLimit}
            aria-describedby="k8s-input-hint k8s-run-hint"
          />
        </div>
        <div class="k8s-field" data-k8s-field="replicas">
          <label class="eyebrow mb-2 block" for="k8s-replicas">Replicas</label>
          {/*
            type="text", not type="number". parseReplicas() already returns a
            specific diagnostic for a non-integer, but a number input lets the
            browser discard invalid characters before the engine ever sees them
            — pasting "10/10" silently became 10, so the user got a confidently
            wrong total instead of the error. inputmode="numeric" keeps the
            phone keypad; min/step are meaningless on a text input and are gone.
          */}
          <input
            id="k8s-replicas"
            class="k8s-text code-mono"
            type="text"
            inputmode="numeric"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            autocomplete="off"
            placeholder="1"
            value={seedExample?.input.replicas}
            aria-describedby="k8s-input-hint k8s-run-hint"
          />
        </div>
      </div>
      <p id="k8s-input-hint" class="k8s-hint caption text-mute">
        CPU takes cores or millicores (<span class="code-mono">500m</span>, <span class="code-mono">1</span>,
        <span class="code-mono">2.5</span>). Memory takes binary (<span class="code-mono">256Mi</span>,
        <span class="code-mono">4Gi</span>) or decimal (<span class="code-mono">1G</span>) suffixes, or bytes.
        Leave a field blank to skip it.
      </p>
      <RunHint id="k8s-run-hint" />
      <SnapshotBar prefix="k8s" />
    </div>

    {/* ── Results panel — the L2 instrument (dark in both themes) under its
        figure cap; the live summary reads out in the cap's actions slot. ── */}
    <ResultPanel
      slug="kubernetes-resource-calculator"
      prefix="k8s"
      summary={seedSummary}
      summaryClass="whitespace-nowrap"
      split
    >
      <Fragment slot="actions">
        <CopyButton kind="link" id="k8s-share" />
        <CopyButton kind="value" id="k8s-copy-md" label="Copy as Markdown" icon="markdown" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the answer is in the
          static HTML; the client replaces it with the same markup on boot. */}
      <div id="k8s-results" class="k8s-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .k8s-fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px 16px;
  }
  @media (min-width: 480px) {
    .k8s-fields {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 768px) {
    .k8s-fields {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .k8s-field {
    min-width: 0;
  }

  .k8s-text {
    width: 100%;
    height: var(--control-h-lg);
    padding: 0 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 14px;
    line-height: 22px;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .k8s-text::placeholder {
    color: var(--color-mute);
  }
  .k8s-text:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .k8s-text:focus {
    outline: none;
  }
  .k8s-text:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .k8s-hint {
    margin-top: 12px;
    text-wrap: pretty;
  }
  .k8s-results {
    min-height: var(--control-h-lg);
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.k8s-results` container (the panel
     wrapper is ResultPanel's and carries no scope attribute). */
  :global(.k8s-table) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: k8s-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.k8s-row) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 9px 14px;
    font-size: 13px;
    line-height: 20px;
  }
  :global(.k8s-row + .k8s-row) {
    border-top: 1px solid var(--color-hairline);
  }
  /* Row-key role (label-field): mono 11/16 uppercase, the only label. */
  :global(.k8s-row__label) {
    @apply label-field;
    flex: 1 1 auto;
    min-width: 0;
    word-break: break-word;
  }
  :global(.k8s-row__value) {
    flex: 0 1 auto;
    text-align: right;
    color: var(--color-ink);
    word-break: break-word;
  }
  :global(.k8s-row__value--mono) {
    font-family: var(--font-mono);
  }

  :global(.k8s-warnings) {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  :global(.k8s-warn) {
    display: flex;
    gap: 8px;
    padding: 9px 12px;
    border-radius: var(--radius-md);
    background: var(--color-warning-soft);
    box-shadow: inset 0 0 0 1px var(--color-warning);
    color: var(--color-warning-deep);
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.k8s-warn__icon) {
    flex: 0 0 auto;
    width: 15px;
    height: 15px;
    margin-top: 1px;
  }

  @keyframes k8s-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.k8s-table) {
      animation: none;
    }
  }

  :global(.k8s-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.k8s-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.k8s-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.k8s-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .k8s-text--error {
    box-shadow: inset 0 0 0 2px var(--color-error) !important;
  }
  .k8s-field-error {
    margin-top: 5px;
    font-size: 12px;
    line-height: 16px;
    color: var(--color-error-deep);
  }

  :global(.k8s-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below it uses the slab ink tier; the light rules
     above remain the documented defaults. ──────────────────────────────── */
  .k8s-results :global(.k8s-empty),
  .k8s-results :global(.k8s-table) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .k8s-results :global(.k8s-empty) {
    color: var(--color-inverse-mute);
  }
  .k8s-results :global(.k8s-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .k8s-results :global(.k8s-row + .k8s-row) {
    border-top-color: #ffffff12;
  }
  .k8s-results :global(.k8s-row__label) {
    color: var(--color-inverse-mute);
  }
  .k8s-results :global(.k8s-row__value) {
    color: var(--color-inverse-fg);
  }
  .k8s-results :global(.k8s-warn) {
    background: #e0a45814;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-accent);
  }
</style>

<script>
  import {
    EMPTY_HTML,
    errorHtml,
    resultHtml,
    summaryText,
    markdownFields,
  } from '../lib/k8s-resources/render';
  import { wireRunKeys } from '../lib/run-keys';
  import { buildMarkdownBlock } from '../lib/share-md';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  import type { K8sInput as Input, K8sResult as Result } from '../lib/k8s-resources/types';

  type ExampleInput = {
    cpuRequest: string;
    cpuLimit: string;
    memRequest: string;
    memLimit: string;
    replicas: string;
  };
  type Example = { id: string; label: string; input: ExampleInput };
  type EngineModule = {
    calculate: (input: Input) => Result;
    encodeState: (rows: Input[]) => string;
    decodeState: () => { rows: Input[] } | null;
  };

  const ROOT_SEL = '.k8s-pg';
  const DEBOUNCE_MS = 220;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.k8sWired === 'true') return;
      root.dataset.k8sWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function str(o: Record<string, unknown>, key: string): string {
    const v = o[key];
    return typeof v === 'string' ? v : '';
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        const input = (o.input ?? {}) as Record<string, unknown>;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          input: {
            cpuRequest: str(input, 'cpuRequest'),
            cpuLimit: str(input, 'cpuLimit'),
            memRequest: str(input, 'memRequest'),
            memLimit: str(input, 'memLimit'),
            replicas: str(input, 'replicas'),
          },
        } satisfies Example;
      })
      .filter(
        (e) =>
          e.input.cpuRequest.length > 0 ||
          e.input.cpuLimit.length > 0 ||
          e.input.memRequest.length > 0 ||
          e.input.memLimit.length > 0,
      );
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    summary.textContent = '';
    container.innerHTML = EMPTY_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    summary.textContent = '';
    container.innerHTML = errorHtml(message);
  }

  function renderResult(container: HTMLElement, summary: HTMLElement, result: Result, replicas: number): void {
    summary.textContent = summaryText(result);
    container.innerHTML = resultHtml(result, replicas);
  }

  async function init(root: HTMLElement): Promise<void> {
    const cpuReqInput = el<HTMLInputElement>(root, '#k8s-cpu-req');
    const cpuLimInput = el<HTMLInputElement>(root, '#k8s-cpu-lim');
    const memReqInput = el<HTMLInputElement>(root, '#k8s-mem-req');
    const memLimInput = el<HTMLInputElement>(root, '#k8s-mem-lim');
    const replicasInput = el<HTMLInputElement>(root, '#k8s-replicas');
    const chipsWrap = el<HTMLElement>(root, '#k8s-chips');
    const resultsBox = el<HTMLElement>(root, '#k8s-results');
    const summaryEl = el<HTMLElement>(root, '#k8s-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#k8s-share');
    const mdBtn = el<HTMLButtonElement>(root, '#k8s-copy-md');
    const copyStatus = el<HTMLElement>(root, '#k8s-copy-status');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#k8s-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#k8s-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#k8s-snap-delete');
    if (
      !cpuReqInput ||
      !cpuLimInput ||
      !memReqInput ||
      !memLimInput ||
      !replicasInput ||
      !chipsWrap ||
      !resultsBox ||
      !summaryEl ||
      !shareBtn ||
      !mdBtn ||
      !copyStatus ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    )
      return;

    // Copy link and Copy as Markdown: the kit's delegated copy listener;
    // outcomes announced in #k8s-copy-status.
    wireCopyButtons(root, { status: copyStatus });

    function hideShare(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
    }
    function hideMarkdown(): void {
      mdBtn!.hidden = true;
      mdBtn!.dataset.copy = '';
    }
    /** Replace the URL hash without adding a history entry; null clears it. */
    function writeHash(hash: string | null): void {
      const base = window.location.pathname + window.location.search;
      const url = hash ? `${base}${hash.startsWith('#') ? hash : `#${hash}`}` : base;
      window.history.replaceState(null, '', url);
    }

    let engine: EngineModule;
    let examples: Example[] = [];
    try {
      const [engineMod, examplesMod] = await Promise.all([
        import('../lib/k8s-resources/engine'),
        import('../lib/k8s-resources/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
    } catch (err) {
      renderError(resultsBox, summaryEl, 'The calculator engine failed to load. Reload the page to try again.');
      console.error('[K8sResourceCalculator] engine import failed:', err);
      return;
    }

    // The chips are server-rendered from the same `examples` module, so their
    // data-example-idx values index straight into `examples`. `null` clears the
    // selection — used whenever the fields no longer match any example.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));

    function setActiveChip(idx: number | null): void {
      syncChipsByIndex(chipsWrap, idx);
    }

    // ── Per-field error helpers ──────────────────────────────────────────────
    /** Map from engine field name to the corresponding input element. */
    const fieldInputMap: Record<string, HTMLInputElement> = {
      cpuRequest: cpuReqInput!,
      cpuLimit: cpuLimInput!,
      memRequest: memReqInput!,
      memLimit: memLimInput!,
      replicas: replicasInput!,
    };

    function clearFieldErrors(): void {
      root.querySelectorAll<HTMLInputElement>('.k8s-text--error').forEach((inp) => {
        inp.classList.remove('k8s-text--error');
      });
      root.querySelectorAll<HTMLElement>('.k8s-field-error').forEach((el) => el.remove());
    }

    /**
     * Highlight a specific field input and append an error message below it.
     * fieldName matches keys in fieldInputMap (cpuRequest, cpuLimit, etc.).
     */
    function setFieldError(fieldName: string, message: string): void {
      const inp = fieldInputMap[fieldName];
      if (!inp) return;
      inp.classList.add('k8s-text--error');
      const fieldDiv = inp.closest<HTMLElement>('[data-k8s-field]');
      if (fieldDiv) {
        const errEl = document.createElement('p');
        errEl.className = 'k8s-field-error';
        errEl.setAttribute('aria-live', 'polite');
        errEl.textContent = message;
        fieldDiv.appendChild(errEl);
      }
    }

    /**
     * Extract the field name from an engine error string.
     * Engine errors follow the pattern: `<fieldName> "..." is not a valid...`
     * or `replicas "..." must be a positive integer.`
     */
    function parseErrorField(error: string): string | null {
      const match = /^(cpuRequest|cpuLimit|memRequest|memLimit|replicas)\s+"/.exec(error);
      return match ? match[1] : null;
    }

    /**
     * Re-evaluate the current fields and re-render the results panel.
     * `userInitiated` gates whether this call writes the URL hash — only
     * user-driven recalculations do; the initial default/example/share seed
     * render never does (see the boot sequence at the end of init()).
     */
    function evaluate(userInitiated = true): void {
      clearFieldErrors();
      const input: Input = {
        cpuRequest: cpuReqInput!.value,
        cpuLimit: cpuLimInput!.value,
        memRequest: memReqInput!.value,
        memLimit: memLimInput!.value,
        replicas: replicasInput!.value,
      };
      if (
        input.cpuRequest!.trim().length === 0 &&
        input.cpuLimit!.trim().length === 0 &&
        input.memRequest!.trim().length === 0 &&
        input.memLimit!.trim().length === 0
      ) {
        renderEmpty(resultsBox!, summaryEl!);
        hideShare();
        hideMarkdown();
        if (userInitiated) writeHash(null);
        return;
      }
      let result: Result | null = null;
      try {
        result = engine.calculate(input);
      } catch {
        renderError(resultsBox!, summaryEl!, 'Unexpected error while calculating resources.');
        hideShare();
        hideMarkdown();
        if (userInitiated) writeHash(null);
        return;
      }
      if (!result || result.valid === false) {
        const errMsg = result?.error ?? 'Enter at least one valid resource value.';
        renderError(resultsBox!, summaryEl!, errMsg);
        const fieldName = parseErrorField(errMsg);
        if (fieldName) setFieldError(fieldName, errMsg);
        hideShare();
        hideMarkdown();
        if (userInitiated) writeHash(null);
        return;
      }
      const replicas = Number(input.replicas) || 1;
      renderResult(resultsBox!, summaryEl!, result, replicas);

      // Share link + Markdown export are only ever shown for a valid,
      // non-empty result (mirrors CronTesterPlayground's hideShare discipline).
      let hash = '';
      try {
        hash = engine.encodeState([input]);
      } catch {
        hash = '';
      }
      if (hash) {
        const frag = hash.startsWith('#') ? hash : `#${hash}`;
        shareBtn!.hidden = false;
        shareBtn!.dataset.copy =
          window.location.origin + window.location.pathname + window.location.search + frag;
        if (userInitiated) {
          writeHash(frag);
          recordToolLastInput('kubernetes-resource-calculator', JSON.stringify(input));
        }
      } else {
        hideShare();
      }

      mdBtn!.hidden = false;
      mdBtn!.dataset.copy = buildMarkdownBlock('Kubernetes Resource Calculator', markdownFields(result, replicas));
    }

    let timer: number | undefined;
    function scheduleEvaluate(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(evaluate, DEBOUNCE_MS);
    }

    function onUserInput(): void {
      setActiveChip(null);
      scheduleEvaluate();
    }

    cpuReqInput.addEventListener('input', onUserInput);
    cpuLimInput.addEventListener('input', onUserInput);
    memReqInput.addEventListener('input', onUserInput);
    memLimInput.addEventListener('input', onUserInput);
    replicasInput.addEventListener('input', onUserInput);

    // Five single-line quantity fields: Enter runs from whichever one has focus.
    const runNow = (): void => {
      window.clearTimeout(timer);
      evaluate(true);
    };
    for (const field of [cpuReqInput, cpuLimInput, memReqInput, memLimInput, replicasInput]) {
      wireRunKeys(field, runNow);
    }
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        const ex = examples[idx];
        cpuReqInput.value = ex.input.cpuRequest;
        cpuLimInput.value = ex.input.cpuLimit;
        memReqInput.value = ex.input.memRequest;
        memLimInput.value = ex.input.memLimit;
        replicasInput.value = ex.input.replicas;
        setActiveChip(idx);
        window.clearTimeout(timer);
        evaluate();
      });
    });

    wireSnapshotUI({
      slug: 'kubernetes-resource-calculator',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () =>
        JSON.stringify({
          cpuRequest: cpuReqInput!.value,
          cpuLimit: cpuLimInput!.value,
          memRequest: memReqInput!.value,
          memLimit: memLimInput!.value,
          replicas: replicasInput!.value,
        }),
      setValue: (value) => {
        let parsed: unknown;
        try {
          parsed = JSON.parse(value);
        } catch {
          return;
        }
        const obj = (parsed ?? {}) as Record<string, unknown>;
        cpuReqInput!.value = typeof obj.cpuRequest === 'string' ? obj.cpuRequest : '';
        cpuLimInput!.value = typeof obj.cpuLimit === 'string' ? obj.cpuLimit : '';
        memReqInput!.value = typeof obj.memRequest === 'string' ? obj.memRequest : '';
        memLimInput!.value = typeof obj.memLimit === 'string' ? obj.memLimit : '';
        replicasInput!.value = typeof obj.replicas === 'string' ? obj.replicas : '';
        setActiveChip(null);
        window.clearTimeout(timer);
        evaluate();
      },
    });

    // Seed priority: a valid #s= share link > a restored last input > the
    // first bundled example. Neither non-user seed path writes the hash or
    // records a last-input — only user-initiated evaluations do.
    let seedRow: Input | null = null;
    try {
      const decoded = engine.decodeState();
      if (decoded && Array.isArray(decoded.rows) && decoded.rows.length > 0) {
        const first = decoded.rows[0];
        const hasContent =
          (first.cpuRequest ?? '').trim().length > 0 ||
          (first.cpuLimit ?? '').trim().length > 0 ||
          (first.memRequest ?? '').trim().length > 0 ||
          (first.memLimit ?? '').trim().length > 0;
        if (hasContent) seedRow = first;
      }
    } catch {
      /* malformed hash — fall back to the example seed */
    }

    if (!seedRow) {
      const restored = getRestoredLastInput('kubernetes-resource-calculator');
      if (restored) {
        try {
          const parsed = JSON.parse(restored) as unknown;
          const obj = (parsed ?? {}) as Record<string, unknown>;
          const row: ExampleInput = {
            cpuRequest: typeof obj.cpuRequest === 'string' ? obj.cpuRequest : '',
            cpuLimit: typeof obj.cpuLimit === 'string' ? obj.cpuLimit : '',
            memRequest: typeof obj.memRequest === 'string' ? obj.memRequest : '',
            memLimit: typeof obj.memLimit === 'string' ? obj.memLimit : '',
            replicas: typeof obj.replicas === 'string' ? obj.replicas : '',
          };
          const hasContent =
            row.cpuRequest.trim().length > 0 ||
            row.cpuLimit.trim().length > 0 ||
            row.memRequest.trim().length > 0 ||
            row.memLimit.trim().length > 0;
          if (hasContent) seedRow = row;
        } catch {
          /* malformed restored value — fall back to the example seed */
        }
      }
    }

    if (seedRow) {
      cpuReqInput.value = seedRow.cpuRequest ?? '';
      cpuLimInput.value = seedRow.cpuLimit ?? '';
      memReqInput.value = seedRow.memRequest ?? '';
      memLimInput.value = seedRow.memLimit ?? '';
      replicasInput.value = seedRow.replicas ?? '';
      // Restored from a share link or a saved last input — the fields match no
      // example, so no chip is active.
      setActiveChip(null);
      evaluate(false);
    } else {
      const seed = examples[0];
      if (seed) {
        cpuReqInput.value = seed.input.cpuRequest;
        cpuLimInput.value = seed.input.cpuLimit;
        memReqInput.value = seed.input.memRequest;
        memLimInput.value = seed.input.memLimit;
        replicasInput.value = seed.input.replicas;
        setActiveChip(0);
        evaluate(false);
      } else {
        setActiveChip(null);
        renderEmpty(resultsBox, summaryEl);
      }
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
