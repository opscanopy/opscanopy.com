---
/**
 * LogqlPromqlPlayground — the interactive LogQL ↔ PromQL Helper island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>
 * that lazily boots a CodeMirror 6 input editor and a read-only output editor,
 * wires a direction toggle (LogQL → PromQL / PromQL → LogQL) and the example
 * chips. Conversion is live and debounced; "Run now" and ⌘/Ctrl + Enter
 * convert immediately.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * EditorPane (source query | translated query, side by side from 768px),
 * RunHint, SnapshotBar, ResultPanel (figure cap, live summary, copy status)
 * and CopyButton. The notes container stays here, seeded with `set:html` +
 * `data-results`; its slab overrides anchor on `.lp-notes`.
 *
 * Runtime contract (imported lazily in the script):
 *   ../lib/logql-promql/types →
 *     type Direction = "logql-to-promql" | "promql-to-logql"
 *     interface ConvertResult { output: string; notes: string[]; error?: string }
 *     interface ShareState { direction: Direction; query: string }
 *   ../lib/logql-promql/engine →
 *     convert(direction: Direction, query: string): ConvertResult
 *     encodeState(direction: Direction, query: string): string  // hash fragment
 *     decodeState(): ShareState | null
 *   ../lib/logql-promql/examples →
 *     examples: { id: string; label: string; direction: Direction; query: string }[]
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used to server-render the example chips (ExampleChips), so the static HTML
// carries real example names for crawlers and no-JS visitors. It adds nothing
// to the client bundle.
import { examples as prerenderedExamples } from '../lib/logql-promql/examples';
import { convert } from '../lib/logql-promql/engine';
import { DIRECTIONS } from '../lib/logql-promql/types';
import { EMPTY_HTML, errorHtml, filesFor, notesHtml, notesSummaryText, outputText } from '../lib/logql-promql/render';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-converts the same example on boot, so
 * this is pure progressive enhancement — but it means a no-JS visitor, and
 * every AI crawler (they do not execute JS), sees the real translated query
 * and the notes on what did not map, instead of two empty editors.
 *
 * `convert` is pure and synchronous — no clock, no random, no network — so it
 * runs unchanged at build time. Both queries go into a
 * `<pre data-cm-fallback>` inside each CodeMirror host; CM appends its editor
 * to the host, so the script removes every fallback once mounted.
 *
 * NOT seeded, because neither is knowable at build time: the `#s=` share URL
 * and the "Explain this query" chip (both built from `window.location`), which
 * stay hidden until the client converts.
 */
const seedExample = prerenderedExamples[0];
const seedDirection = seedExample ? seedExample.direction : 'logql-to-promql';
const seedResult = seedExample ? convert(seedDirection, seedExample.query) : null;
const seedOutput = seedResult ? outputText(seedResult) : '';
const seedNotes = seedResult && !seedResult.error ? seedResult.notes : [];
const seedNotesHtml = !seedResult
  ? EMPTY_HTML
  : seedResult.error
    ? errorHtml(seedResult.error)
    : notesHtml(seedNotes);
const seedSummary = !seedResult ? '' : seedResult.error ? 'Error' : notesSummaryText(seedNotes);
const seedFiles = filesFor(seedDirection);
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="lp-pg" aria-label="LogQL to PromQL helper playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: direction, examples, Run now ────────────────────────── */}
    <div
      class="flex flex-col gap-3 border-b border-hairline px-4 py-3 lg:flex-row lg:items-end lg:justify-between lg:px-5"
    >
      <div class="flex min-w-0 flex-wrap items-end gap-3">
        <div class="flex min-w-0 flex-col gap-1.5">
          <span class="eyebrow" id="lp-dir-label">Direction</span>
          {/* Segmented direction toggle — server-rendered from the engine's
              own DIRECTIONS list. The hydration script adopts these buttons by
              their data-dir and never rebuilds them. */}
          <div id="lp-direction" class="lp-seg" role="tablist" aria-labelledby="lp-dir-label">
            {
              DIRECTIONS.map((d) => (
                <button
                  type="button"
                  class="lp-seg__btn lp-tap"
                  data-dir={d.value}
                  role="tab"
                  aria-selected={d.value === seedDirection ? 'true' : 'false'}
                  tabindex={d.value === seedDirection ? 0 : -1}
                >
                  {d.label}
                </button>
              ))
            }
          </div>
        </div>

        <div class="flex min-w-0 basis-full flex-col gap-1.5">
          <span class="eyebrow">Examples</span>
          <ExampleChips prefix="lp" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
        </div>
      </div>

      <button
        id="lp-convert"
        type="button"
        class="btn-tool lp-tap"
        title="Run now (⌘/Ctrl + Enter)"
        aria-keyshortcuts="Meta+Enter Control+Enter"
      >
        Run now
      </button>
    </div>

    {/* ── Editors: source query | translated query (side by side ≥768px) ─ */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <div class="lp-grid">
        <EditorPane prefix="lp" id="lp-editor-input" label={seedFiles.input}>
          <pre class="editor-pane__fallback code-mono" data-cm-fallback>{seedExample?.query}</pre>
        </EditorPane>
        <EditorPane prefix="lp" id="lp-editor-output" label={seedFiles.output}>
          <Fragment slot="actions">
            <CopyButton kind="all" id="lp-copy" label="Copy output" />
          </Fragment>
          <pre class="editor-pane__fallback code-mono" data-cm-fallback>{seedOutput}</pre>
        </EditorPane>
      </div>
      <RunHint variant="cm" class="mt-2" />
      <SnapshotBar prefix="lp" />
    </div>

    {/* ── Result: what mapped and what did not, on the L2 instrument ───── */}
    <ResultPanel slug="logql-promql-helper" prefix="lp" summary={seedSummary} label="Notes" summaryClass="whitespace-nowrap" split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="lp-share" />
        <CopyButton kind="value" id="lp-copy-md" label="Copy as Markdown" icon="markdown" />
        <a id="lp-explain-chip" class="chip" href="#" hidden>Explain this query &rarr;</a>
      </Fragment>
      {/* Seeded at build time (see `seedNotesHtml` above) so the conversion
          notes are in the static HTML; the client replaces it with the same
          markup on boot. */}
      <div id="lp-notes" class="lp-notes" set:html={seedNotesHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* Tap targets opt into fast-tap + no double-tap-zoom on touch. */
  .lp-tap {
    touch-action: manipulation;
  }

  /* ── Segmented direction toggle ─────────────────────────────────────── */
  .lp-seg {
    display: inline-flex;
    align-items: stretch;
    gap: 2px;
    padding: 3px;
    border-radius: var(--radius-md);
    background: var(--color-canvas-soft-2);
    box-shadow: var(--shadow-hairline);
  }
  .lp-seg__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--control-h-md);
    padding: 0 12px;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-body);
    font-family: var(--font-mono);
    font-size: 12px;
    white-space: nowrap;
    cursor: pointer;
    touch-action: manipulation;
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      color var(--dur-fast) var(--ease-brand),
      box-shadow var(--dur-fast) var(--ease-brand);
  }
  .lp-seg__btn:hover:not([aria-selected='true']) {
    color: var(--color-ink);
  }
  .lp-seg__btn[aria-selected='true'] {
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-subtle);
  }
  .lp-seg__btn:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
  @media (pointer: coarse) {
    .lp-seg__btn {
      min-height: var(--control-h-lg);
    }
  }

  /* Source | translated, side by side from 768px. */
  .lp-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  @media (min-width: 768px) {
    .lp-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Notes list (mapping notes / success / empty). */
  .lp-notes {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.lp-notes` container. */
  :global(.lp-note) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    animation: lp-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.lp-note__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    color: var(--color-mute);
  }
  :global(.lp-note__body) {
    min-width: 0;
    flex: 1 1 auto;
  }
  :global(.lp-note__title) {
    font-size: 13px;
    font-weight: 500;
    line-height: 18px;
    color: var(--color-ink);
  }
  :global(.lp-note__list) {
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  :global(.lp-note__item) {
    position: relative;
    padding-left: 16px;
    font-size: 13px;
    line-height: 18px;
    word-break: break-word;
  }
  :global(.lp-note__item::before) {
    content: '';
    position: absolute;
    left: 4px;
    top: 7px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.55;
  }

  /* Success note (conversion clean, nothing to flag). */
  :global(.lp-ok) {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    animation: lp-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.lp-ok__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    color: var(--color-success);
  }
  :global(.lp-ok__text) {
    font-size: 13px;
    line-height: 18px;
  }

  /* Parse / conversion error banner. */
  :global(.lp-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
    animation: lp-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.lp-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.lp-error__body) {
    min-width: 0;
  }
  :global(.lp-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.lp-error__detail) {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  @keyframes lp-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.lp-note),
    :global(.lp-ok),
    :global(.lp-error) {
      animation: none;
    }
  }

  /* Empty state — generous, centered frame. */
  :global(.lp-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* ── Instrument re-skin — the notes sit on the L2 result slab (dark in
     BOTH themes), so everything render.ts emits uses the slab ink tier. ── */
  .lp-notes :global(.lp-note),
  .lp-notes :global(.lp-ok),
  .lp-notes :global(.lp-empty) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-fg);
  }
  .lp-notes :global(.lp-note__title) {
    color: var(--color-inverse-fg);
  }
  .lp-notes :global(.lp-note__icon),
  .lp-notes :global(.lp-empty) {
    color: var(--color-inverse-mute);
  }
  .lp-notes :global(.lp-ok__icon) {
    color: var(--color-inverse-brand);
  }
  .lp-notes :global(.lp-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }

  .is-busy {
    opacity: 0.65;
    pointer-events: none;
    cursor: progress;
  }
</style>

<script>
  import { buildMarkdownBlock } from '../lib/share-md';
  import { buildHashValue } from '../lib/hash-state';
  import type { EditorView } from '@codemirror/view';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, clearChips, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  // The same pure builders the frontmatter used for the SSR seed — one
  // implementation, so the seeded panel and every later conversion agree.
  import {
    EMPTY_HTML,
    errorHtml,
    filesFor,
    notesHtml,
    notesSummaryText,
  } from '../lib/logql-promql/render';

  // CodeMirror is loaded via dynamic import inside init() so its ~200KB runtime
  // code-splits into its own chunk instead of shipping in the page's initial JS.
  // The `EditorView` type above is erased at build time and ships no runtime code.

  /* ---- Types mirrored from the engine contract (structural, not imported). -- */
  type Direction = 'logql-to-promql' | 'promql-to-logql';
  type ConvertResult = { output: string; notes?: string[]; error?: string };
  type ShareState = { direction: Direction; query: string };
  type EngineModule = {
    convert: (direction: Direction, query: string) => ConvertResult | Promise<ConvertResult>;
    encodeState: (direction: Direction, query: string) => string;
    decodeState: () => ShareState | null;
  };
  type Example = { id: string; label: string; direction: Direction; query: string };
  /** `seed` = boot / deep link / restore (never written or recorded); `type` = debounced edit; `run` = explicit. */
  type Source = 'seed' | 'type' | 'run';

  const ROOT_SEL = '.lp-pg';
  const SLUG = 'logql-promql-helper';
  const DEBOUNCE_MS = 180;
  const DIRECTIONS: { value: Direction; label: string; from: string; to: string }[] = [
    { value: 'logql-to-promql', label: 'LogQL → PromQL', from: 'LogQL', to: 'PromQL' },
    { value: 'promql-to-logql', label: 'PromQL → LogQL', from: 'PromQL', to: 'LogQL' },
  ];

  /** Boot every (so far un-hydrated) playground instance on the page. */
  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.lpWired === 'true') return;
      root.dataset.lpWired = 'true';
      void init(root);
    });
  }

  /* ---- Small helpers -------------------------------------------------------- */

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function isDirection(v: unknown): v is Direction {
    return v === 'logql-to-promql' || v === 'promql-to-logql';
  }

  function isCoarsePointer(): boolean {
    return window.matchMedia?.('(pointer: coarse)').matches ?? false;
  }

  /**
   * Rename an EditorPane's figure cap (the file names follow the direction).
   * EditorPane renders a static label; the cap's label span is the only text
   * in it, so this rewrites that span and its title.
   */
  function setPaneLabel(host: HTMLElement, text: string): void {
    const label = host.closest('[data-editor-pane]')?.querySelector<HTMLElement>('.figcap__label');
    if (!label) return;
    label.textContent = text;
    label.title = text;
  }

  /** Normalise the sibling examples list defensively. */
  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        const query = typeof o.query === 'string' ? o.query : '';
        const direction = isDirection(o.direction) ? o.direction : 'logql-to-promql';
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          direction,
          query,
        } satisfies Example;
      })
      .filter((e) => e.query.length > 0);
  }

  /* ---- Summary + note rendering (slab inks) ---------------------------------
     The HTML itself is built by ../lib/logql-promql/render, which the Astro
     frontmatter also calls for the SSR seed. Only the DOM writes and the
     summary's tone classes live here. */

  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = EMPTY_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    setSummary(summary, 'Error', true);
    container.innerHTML = errorHtml(message);
  }

  function renderNotes(container: HTMLElement, summary: HTMLElement, notes: string[]): void {
    setSummary(summary, notesSummaryText(notes), false);
    container.innerHTML = notesHtml(notes);
  }

  /* ---- Instance init -------------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const inputHost = el<HTMLElement>(root, '#lp-editor-input');
    const outputHost = el<HTMLElement>(root, '#lp-editor-output');
    const dirGroup = el<HTMLElement>(root, '#lp-direction');
    const chipsWrap = el<HTMLElement>(root, '#lp-chips');
    const convertBtn = el<HTMLButtonElement>(root, '#lp-convert');
    const copyBtn = el<HTMLButtonElement>(root, '#lp-copy');
    const notesBox = el<HTMLElement>(root, '#lp-notes');
    const summaryEl = el<HTMLElement>(root, '#lp-summary');
    const copyStatus = el<HTMLElement>(root, '#lp-copy-status');
    const shareBtn = el<HTMLButtonElement>(root, '#lp-share');
    const mdBtn = el<HTMLButtonElement>(root, '#lp-copy-md');
    const explainChip = el<HTMLAnchorElement>(root, '#lp-explain-chip');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#lp-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#lp-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#lp-snap-delete');

    if (
      !inputHost ||
      !outputHost ||
      !dirGroup ||
      !chipsWrap ||
      !convertBtn ||
      !copyBtn ||
      !notesBox ||
      !summaryEl ||
      !copyStatus ||
      !shareBtn ||
      !mdBtn ||
      !explainChip ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    // Copy plumbing (Copy output, Copy link, Copy as Markdown) — the kit
    // helper: one delegated listener; outcomes announced in #lp-copy-status.
    wireCopyButtons(root, { status: copyStatus });

    /** Cross-tool chain — LogQL→PromQL output can be explained by PromQL Explainer. */
    function localePath(p: string): string {
      const m = window.location.pathname.match(/^\/(de|es|fr|pt-br)\//);
      return m ? `/${m[1]}${p}` : p;
    }

    // Live conversion hook, called by the input editor's update listener; a
    // no-op until convertNow exists below.
    let onInputEdit: () => void = () => {};

    // Lazily load CodeMirror + the kit's plate theme + the sibling engine +
    // examples (off the initial path so the ~200KB CM runtime code-splits into
    // its own chunk).
    let engine: EngineModule;
    let examples: Example[] = [];
    let makeInputEditor: (host: HTMLElement, doc: string) => EditorView;
    let makeOutputEditor: (host: HTMLElement, doc: string) => EditorView;
    let setEditorDoc: (view: EditorView, doc: string) => void;
    try {
      const [
        { EditorState },
        { EditorView, keymap, lineNumbers, highlightActiveLine },
        { defaultKeymap, history, historyKeymap, indentWithTab },
        { plate },
        engineMod,
        examplesMod,
      ] = await Promise.all([
        import('@codemirror/state'),
        import('@codemirror/view'),
        import('@codemirror/commands'),
        import('../lib/playground-kit/cm-theme'),
        import('../lib/logql-promql/engine'),
        import('../lib/logql-promql/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);

      // Sizing only — colours, gutters and the focus ring come from the plate
      // theme and the EditorPane rule in global.css.
      const sizing = EditorView.theme({
        '&': { fontSize: '13px', maxHeight: '420px' },
        '.cm-scroller': { overflow: 'auto' },
      });

      makeInputEditor = (host: HTMLElement, doc: string): EditorView => {
        const state = EditorState.create({
          doc,
          extensions: [
            lineNumbers(),
            history(),
            highlightActiveLine(),
            plate,
            sizing,
            EditorView.lineWrapping,
            EditorView.contentAttributes.of({ 'aria-label': 'Source query to convert' }),
            keymap.of([
              // Ours FIRST, so it wins over defaultKeymap's Enter.
              {
                key: 'Mod-Enter',
                run: (view) => {
                  void convertNow('run');
                  if (isCoarsePointer()) view.contentDOM.blur();
                  return true;
                },
              },
              { key: 'Escape', run: (view) => { view.contentDOM.blur(); return true; } },
              ...defaultKeymap,
              ...historyKeymap,
              indentWithTab,
            ]),
            EditorView.updateListener.of((u) => {
              if (u.docChanged) onInputEdit();
            }),
          ],
        });
        return new EditorView({ state, parent: host });
      };

      makeOutputEditor = (host: HTMLElement, doc: string): EditorView => {
        const state = EditorState.create({
          doc,
          extensions: [
            lineNumbers(),
            plate,
            sizing,
            EditorView.lineWrapping,
            EditorView.editable.of(false),
            EditorState.readOnly.of(true),
            EditorView.contentAttributes.of({ 'aria-label': 'Converted query (read-only)' }),
          ],
        });
        return new EditorView({ state, parent: host });
      };

      setEditorDoc = (view: EditorView, doc: string): void => {
        view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: doc } });
      };
    } catch (err) {
      renderError(
        notesBox,
        summaryEl,
        'The converter engine failed to load. Reload the page to try again.'
      );
      // eslint-disable-next-line no-console
      console.error('[LogqlPromql] engine/examples import failed:', err);
      return;
    }

    // Seed priority: a valid #s= deep link > a restored last input > the
    // first example > LogQL → PromQL. No seed path rewrites the URL hash or
    // records a last-input — only a user-initiated convert does.
    let sharedState: ShareState | null = null;
    try {
      sharedState = engine.decodeState();
    } catch {
      sharedState = null;
    }
    const fromShare = !!sharedState && sharedState.query.length > 0;

    let restoredState: ShareState | null = null;
    if (!fromShare) {
      const restored = getRestoredLastInput(SLUG);
      if (restored) {
        try {
          const parsed = JSON.parse(restored) as unknown;
          const obj = (parsed ?? {}) as Record<string, unknown>;
          const rQuery = typeof obj.query === 'string' ? obj.query : '';
          const rDirection = isDirection(obj.direction) ? obj.direction : 'logql-to-promql';
          if (rQuery.length > 0) restoredState = { direction: rDirection, query: rQuery };
        } catch {
          restoredState = null;
        }
      }
    }
    const fromRestored = !!restoredState;

    const seed = examples[0];
    let direction: Direction = fromShare
      ? (sharedState as ShareState).direction
      : fromRestored
        ? (restoredState as ShareState).direction
        : seed?.direction ?? 'logql-to-promql';

    // The direction toggle is server-rendered from the engine's own DIRECTIONS
    // list, so adopt the existing buttons.
    const dirButtons = Array.from(dirGroup.querySelectorAll<HTMLButtonElement>('.lp-seg__btn'));

    /** Reflect the active direction across the toggle + editor caps. */
    function syncDirection(): void {
      dirButtons.forEach((b) => {
        const active = b.dataset.dir === direction;
        b.setAttribute('aria-selected', active ? 'true' : 'false');
        b.tabIndex = active ? 0 : -1;
      });
      const files = filesFor(direction);
      setPaneLabel(inputHost!, files.input);
      setPaneLabel(outputHost!, files.output);
    }

    // The chips are server-rendered (ExampleChips); data-example-idx indexes
    // straight into `examples`. A shared link or a restored input matches no
    // example, so it leaves every chip unpressed.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));
    syncChipsByIndex(chipsWrap, fromShare || fromRestored || !examples.length ? null : 0);

    // Editors — seed the input from the shared link, else a restored last
    // input, else the first example.
    const inputView = makeInputEditor(
      inputHost,
      fromShare
        ? (sharedState as ShareState).query
        : fromRestored
          ? (restoredState as ShareState).query
          : seed?.query ?? ''
    );
    const outputView = makeOutputEditor(outputHost, '');
    // The build-time text stand-ins have done their job (no-JS visitors and
    // crawlers); CodeMirror appended its editors beside them, so drop them —
    // a fallback left behind renders the document twice. The share/restore
    // tiers above already chose the document.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());

    syncDirection();

    /* ---- Copy actions -------------------------------------------------------- */

    function hideActions(): void {
      for (const btn of [shareBtn!, mdBtn!, copyBtn!]) {
        btn.hidden = true;
        btn.dataset.copy = '';
      }
      explainChip!.hidden = true;
    }

    /** Drop the `#s=` fragment back to the bare path (non-fatal if it throws). */
    function clearShareHash(): void {
      try {
        window.history.replaceState(null, '', window.location.pathname + window.location.search);
      } catch {
        /* non-fatal: sharing just won't update */
      }
    }

    /** Reveal the copy actions for a freshly-converted, non-empty result. */
    function revealActions(dir: Direction, query: string, output: string, userInitiated: boolean): void {
      try {
        const hash = engine.encodeState(dir, query);
        const frag = hash.startsWith('#') ? hash : `#${hash}`;
        shareBtn!.dataset.copy =
          window.location.origin + window.location.pathname + window.location.search + frag;
        if (userInitiated) window.history.replaceState(null, '', frag);
      } catch {
        // Fall back to the current URL; sharing degrades gracefully.
        shareBtn!.dataset.copy = window.location.href;
      }
      if (userInitiated) recordToolLastInput(SLUG, JSON.stringify({ direction: dir, query }));
      shareBtn!.hidden = false;
      copyBtn!.dataset.copy = output;
      copyBtn!.hidden = false;
      const dirMeta = DIRECTIONS.find((d) => d.value === dir);
      mdBtn!.dataset.copy = buildMarkdownBlock('LogQL ↔ PromQL Helper', [
        { label: 'Direction', value: dirMeta?.label ?? dir },
        { label: 'Query', value: query },
        { label: 'Result', value: output },
      ]);
      mdBtn!.hidden = false;

      // logql→promql output is itself a valid PromQL query — chain it into
      // PromQL Explainer. The reverse (promql→logql) has no such explainer.
      if (dir === 'logql-to-promql' && output.length > 0) {
        explainChip!.href = localePath('/promql-explainer/') + buildHashValue('q', output);
        explainChip!.hidden = false;
      } else {
        explainChip!.hidden = true;
      }
    }

    // ── Conversion ───────────────────────────────────────────────────────────
    let timer: number | undefined;
    let running = false;
    let queued: Source | null = null;

    async function convertNow(source: Source): Promise<void> {
      window.clearTimeout(timer);
      // Guaranteed present by the early return above; restated because
      // TypeScript discards that narrowing inside a hoisted function declaration.
      if (!convertBtn) return;
      if (running) {
        queued = source;
        return;
      }
      running = true;
      const userInitiated = source !== 'seed';
      if (source === 'run') {
        convertBtn.classList.add('is-busy');
        convertBtn.setAttribute('aria-busy', 'true');
        // Yield so the busy state paints before the work runs.
        await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
      }

      try {
        const query = inputView.state.doc.toString();
        if (query.trim().length === 0) {
          setEditorDoc(outputView, '');
          hideActions();
          renderEmpty(notesBox!, summaryEl!);
          if (userInitiated) clearShareHash();
          return;
        }
        const result = await Promise.resolve(engine.convert(direction, query));

        if (!result || result.error) {
          setEditorDoc(outputView, '');
          hideActions();
          renderError(notesBox!, summaryEl!, result?.error ?? 'Unknown error while converting.');
          if (userInitiated) clearShareHash();
          return;
        }

        const output = typeof result.output === 'string' ? result.output : '';
        setEditorDoc(outputView, output);
        const notes = Array.isArray(result.notes)
          ? result.notes.filter((w): w is string => typeof w === 'string' && w.length > 0)
          : [];
        renderNotes(notesBox!, summaryEl!, notes);

        if (output.length > 0) {
          revealActions(direction, query, output, userInitiated);
        } else {
          hideActions();
          if (userInitiated) clearShareHash();
        }
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Unexpected error while converting.';
        setEditorDoc(outputView, '');
        hideActions();
        renderError(notesBox!, summaryEl!, msg);
        if (userInitiated) clearShareHash();
      } finally {
        running = false;
        convertBtn.classList.remove('is-busy');
        convertBtn.removeAttribute('aria-busy');
        if (queued) {
          const next = queued;
          queued = null;
          void convertNow(next);
        }
      }
    }

    function schedule(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => void convertNow('type'), DEBOUNCE_MS);
    }

    // Typing in the source editor: no example is on screen any more; convert live.
    onInputEdit = () => {
      clearChips(chipsWrap);
      schedule();
    };

    // Choosing an example swaps the input + direction and converts at once.
    // The doc write fires the update listener (which releases every chip), so
    // the chip is pressed again after it.
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        const ex = examples[idx];
        direction = ex.direction;
        syncDirection();
        setEditorDoc(inputView, ex.query);
        syncChipsByIndex(chipsWrap, idx);
        void convertNow('run');
      });
    });

    // Direction toggle: roving-tabindex tablist with arrow-key navigation.
    function selectDirection(value: Direction, focusBtn: boolean): void {
      if (value !== direction) {
        direction = value;
        clearChips(chipsWrap);
        syncDirection();
        void convertNow('run');
      }
      if (focusBtn) dirButtons.find((b) => b.dataset.dir === value)?.focus();
    }

    dirButtons.forEach((btn, i) => {
      btn.addEventListener('click', () => selectDirection(btn.dataset.dir as Direction, false));
      btn.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % dirButtons.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp')
          next = (i - 1 + dirButtons.length) % dirButtons.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = dirButtons.length - 1;
        if (next < 0) return;
        e.preventDefault();
        selectDirection(dirButtons[next].dataset.dir as Direction, true);
      });
    });

    convertBtn.addEventListener('click', () => void convertNow('run'));

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => JSON.stringify({ direction, query: inputView.state.doc.toString() }),
      setValue: (value) => {
        let parsed: unknown;
        try {
          parsed = JSON.parse(value);
        } catch {
          return;
        }
        const obj = (parsed ?? {}) as Record<string, unknown>;
        const query = typeof obj.query === 'string' ? obj.query : '';
        if (isDirection(obj.direction)) direction = obj.direction;
        syncDirection();
        setEditorDoc(inputView, query);
        clearChips(chipsWrap);
        void convertNow('run');
      },
    });

    // Convert whatever the editor ended up holding — a #s= deep link, a
    // restored last input, or the seeded example — so the panel is never empty
    // on arrival. The seed run never rewrites the hash or records the input.
    void convertNow('seed');
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
