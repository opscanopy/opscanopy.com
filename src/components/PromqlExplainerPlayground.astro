---
/**
 * PromqlExplainerPlayground — the interactive PromQL Explainer island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>
 * that lazily boots one CodeMirror 6 editor for a PromQL query, wires the
 * example chips and live explanation with a "Run now" control, then renders
 * a plain-English explanation card plus a token → meaning breakdown list.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * EditorPane (the editor on the plate, its FigureCap and the seeded
 * `<pre data-cm-fallback>`), RunHint and SnapshotBar on paper, and
 * ResultPanel (figure cap, live summary, copy status) with CopyButtons (Copy
 * link, Copy as Markdown). The results container stays here, seeded with
 * `set:html` + `data-results`; its slab overrides anchor on `.pq-results`.
 *
 * Runtime contract (imported lazily in the script):
 *   ../lib/promql-explainer/engine →
 *     explain(query: string) => ExplainResult
 *   ../lib/promql-explainer/types →
 *     type ExplainPart = { token: string; meaning: string }
 *     type ExplainResult = { error?: string; explanation: string; breakdown: ExplainPart[] }
 *   ../lib/promql-explainer/examples →
 *     examples: { id: string; label: string; query: string }[]
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. Only the labels
// are read here; the chips are never rebuilt at hydration — the script wires
// clicks and reads `data-example-idx` into the lazily-imported `examples`, so
// the queries themselves stay out of HTML attributes and off the shell path.
import { examples as prerenderedExamples } from '../lib/promql-explainer/examples';
import { explain } from '../lib/promql-explainer/engine';
import { resultHtml, summaryText, EMPTY_HTML } from '../lib/promql-explainer/render';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-explains the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees the real plain-English
 * reading and the token breakdown instead of an empty "load an example" panel.
 *
 * `explain` is pure, synchronous and clock-free, so it runs at build time
 * unchanged. The query itself goes into a `<pre data-cm-fallback>` inside the
 * CodeMirror host — CM appends its editor to the host, so the script removes
 * the fallback once mounted.
 */
const seedExample = prerenderedExamples[0];
const seedResult = seedExample ? explain(seedExample.query) : null;
const seedOk = seedResult && !seedResult.error ? seedResult : null;
const seedHtml = seedOk ? resultHtml(seedOk) : EMPTY_HTML;
const seedSummary = seedOk ? summaryText(seedOk) : '';
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="pq-pg" aria-label="PromQL Explainer playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: example chips + Run now (paper) ─────────────────────── */}
    <div
      class="flex flex-col gap-3 border-b border-hairline px-4 py-3 sm:flex-row sm:items-end sm:justify-between sm:px-5"
    >
      <div class="flex min-w-0 flex-col gap-2">
        <span class="eyebrow shrink-0">Example</span>
        <ExampleChips prefix="pq" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
      </div>
      <button
        id="pq-explain"
        type="button"
        class="btn-tool pq-tap self-start sm:self-auto"
        title="Run now (⌘/Ctrl + Enter)"
        aria-keyshortcuts="Meta+Enter Control+Enter"
      >
        <svg
          class="pq-explain-icon h-4 w-4 shrink-0"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="8" cy="8" r="6"></circle>
          <path d="M8 7.5v3"></path>
          <path d="M8 5.4v.01"></path>
        </svg>
        <span class="pq-explain-label">Run now</span>
      </button>
    </div>

    {/* ── Query editor on the plate ────────────────────────────────────── */}
    <EditorPane prefix="pq" label="query.promql">
      <pre class="editor-pane__fallback code-mono pq-fallback" data-cm-fallback>{seedExample?.query}</pre>
    </EditorPane>

    {/* ── Run hint + snapshots, on paper (never inside the slab) ──────── */}
    <div class="border-b border-hairline px-4 py-3 sm:px-5">
      <RunHint variant="cm" />
      <SnapshotBar prefix="pq" />
    </div>

    {/* ── Explanation — the L2 instrument under its figure cap ─────────── */}
    <ResultPanel
      slug="promql-explainer"
      prefix="pq"
      label="Explanation"
      summary={seedSummary}
      summaryClass="whitespace-nowrap"
      split
    >
      <Fragment slot="actions">
        <CopyButton kind="link" id="pq-share" />
        <CopyButton kind="all" id="pq-md" label="Copy as Markdown" icon="markdown" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the explanation is in
          the static HTML; the client replaces it with the same markup on boot. */}
      <div id="pq-results" class="pq-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* Tap targets opt into fast-tap + no double-tap-zoom on touch. */
  .pq-tap {
    touch-action: manipulation;
  }

  /* The seeded query a crawler reads (global .editor-pane__fallback sets the
     metrics), boxed to the editor's own min/max height (the script's size
     theme) so the swap on hydration does not move the page. */
  .pq-fallback {
    min-height: 160px;
    max-height: 320px;
    overflow: auto;
  }

  /* ── Results (runtime-injected → :global). Light rules first as the
     documented defaults; the slab re-skin follows, anchored on this
     component's own `.pq-results` container. ──────────────────────────── */
  .pq-results {
    min-height: var(--control-h-lg);
  }

  /* The plain-English explanation card. */
  :global(.pq-explanation) {
    padding: 14px 16px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    animation: pq-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.pq-explanation__text) {
    font-size: 15px;
    line-height: 24px;
    color: var(--color-ink);
    text-wrap: pretty;
    word-break: break-word;
  }

  /* Token → meaning breakdown list. */
  :global(.pq-breakdown) {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: none;
    padding: 0;
  }
  :global(.pq-part) {
    display: flex;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    animation: pq-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.pq-part__token) {
    flex: 0 0 auto;
    max-width: 42%;
    align-self: flex-start;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-soft-2);
    box-shadow: var(--shadow-hairline);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink);
    white-space: pre-wrap;
    word-break: break-word;
  }
  :global(.pq-part__meaning) {
    min-width: 0;
    flex: 1 1 auto;
    font-size: 14px;
    line-height: 22px;
    color: var(--color-body);
    text-wrap: pretty;
    word-break: break-word;
  }

  @keyframes pq-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.pq-explanation),
    :global(.pq-part),
    :global(.pq-error) {
      animation: none;
    }
  }

  /* Parse-error banner. */
  :global(.pq-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
    animation: pq-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.pq-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.pq-error__body) {
    min-width: 0;
  }
  :global(.pq-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.pq-error__detail) {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* Empty state — generous, centered frame. */
  :global(.pq-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* Loading dots — animate opacity only. */
  :global(.pq-loading) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-body);
  }
  :global(.pq-loading__dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-mute);
    animation: pq-pulse calc(var(--dur-base) * 6) ease-in-out infinite;
  }
  :global(.pq-loading__dot:nth-child(2)) {
    animation-delay: var(--dur-base);
  }
  :global(.pq-loading__dot:nth-child(3)) {
    animation-delay: calc(var(--dur-base) * 2);
  }
  @keyframes pq-pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.pq-loading__dot) {
      animation: none;
      opacity: 0.6;
    }
  }

  .is-busy {
    opacity: 0.65;
    pointer-events: none;
    cursor: progress;
  }
  .is-busy .pq-explain-icon {
    display: none;
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below uses the slab ink tier. ─────────────────── */
  .pq-results :global(.pq-empty) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .pq-results :global(.pq-loading) {
    color: var(--color-inverse-mute);
  }
  .pq-results :global(.pq-loading__dot) {
    background: var(--color-inverse-mute);
  }
  .pq-results :global(.pq-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .pq-results :global(.pq-explanation),
  .pq-results :global(.pq-part) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .pq-results :global(.pq-explanation__text) {
    color: var(--color-inverse-fg);
  }
  .pq-results :global(.pq-part__token) {
    background: #ffffff14;
    box-shadow: none;
    color: var(--color-inverse-brand);
  }
  .pq-results :global(.pq-part__meaning) {
    color: var(--color-inverse-mute);
  }
</style>

<script>
  import type { EditorView } from '@codemirror/view';
  import { createHashState } from '../lib/hash-state';
  import { buildMarkdownBlock } from '../lib/share-md';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  // The HTML builders are shared with the frontmatter's build-time seed —
  // one implementation, so the no-JS markup and the live markup never drift.
  import { resultHtml, summaryText, normaliseBreakdown, errorHtml, EMPTY_HTML, LOADING_HTML } from '../lib/promql-explainer/render';
  import type { ExplainResult } from '../lib/promql-explainer/types';

  // CodeMirror (and the kit's plate theme, which imports @codemirror/view) is
  // loaded via dynamic import inside init() so its runtime code-splits into
  // its own chunk instead of shipping in the page's initial JS.

  type EngineModule = {
    explain: (query: string) => ExplainResult | Promise<ExplainResult>;
  };
  type Example = { id: string; label: string; query: string };

  const ROOT_SEL = '.pq-pg';
  const SLUG = 'promql-explainer';

  /** Boot every (so far un-hydrated) playground instance on the page. */
  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.pqWired === 'true') return;
      root.dataset.pqWired = 'true';
      void init(root);
    });
  }

  /* ---- Small helpers -------------------------------------------------------- */

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  /** Normalise the sibling `examples` array defensively. */
  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          query: typeof o.query === 'string' ? o.query : '',
        } satisfies Example;
      })
      .filter((e) => e.query.length > 0);
  }

  /* ---- Result rendering (DOM writes over the shared pure builders) --------- */

  /** Summary ink on the slab: inverse tier only (never paper text-mute). */
  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = EMPTY_HTML;
  }

  function renderLoading(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = LOADING_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    setSummary(summary, 'Error', true);
    container.innerHTML = errorHtml(message);
  }

  function renderResult(container: HTMLElement, summary: HTMLElement, result: ExplainResult): void {
    setSummary(summary, summaryText(result), !result || Boolean(result.error));
    container.innerHTML = resultHtml(result);
  }

  /* ---- Instance init -------------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const editorHost = el<HTMLElement>(root, '#pq-editor');
    const chipsWrap = el<HTMLElement>(root, '#pq-chips');
    const explainBtn = el<HTMLButtonElement>(root, '#pq-explain');
    const resultsBox = el<HTMLElement>(root, '#pq-results');
    const summaryEl = el<HTMLElement>(root, '#pq-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#pq-share');
    const mdBtn = el<HTMLButtonElement>(root, '#pq-md');
    const copyStatus = el<HTMLElement>(root, '#pq-copy-status');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#pq-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#pq-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#pq-snap-delete');

    if (
      !editorHost ||
      !chipsWrap ||
      !explainBtn ||
      !resultsBox ||
      !summaryEl ||
      !shareBtn ||
      !mdBtn ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    // Copy link + Copy as Markdown: the kit's one delegated listener;
    // outcomes are announced in ResultPanel's #pq-copy-status.
    wireCopyButtons(root, { status: copyStatus });

    const hashState = createHashState('q');

    function hideShare(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
      mdBtn!.hidden = true;
      mdBtn!.dataset.copy = '';
    }

    // Lazily load CodeMirror + the plate theme + the engine + examples (kept
    // out of the initial path so the CM runtime code-splits into its own chunk).
    let engine: EngineModule;
    let examples: Example[] = [];
    let makeEditor: (host: HTMLElement, doc: string) => EditorView;
    let setEditorDoc: (view: EditorView, doc: string) => void;
    try {
      const [
        engineMod,
        examplesMod,
        { EditorState },
        { EditorView, keymap, lineNumbers, highlightActiveLine },
        { defaultKeymap, history, historyKeymap, indentWithTab },
        { plate },
      ] = await Promise.all([
        import('../lib/promql-explainer/engine'),
        import('../lib/promql-explainer/examples'),
        import('@codemirror/state'),
        import('@codemirror/view'),
        import('@codemirror/commands'),
        import('../lib/playground-kit/cm-theme'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);

      // Size only (the plate theme owns colour; global.css owns the focus
      // ring): 13px like the seeded fallback, scrolling inside 160–320px.
      const sizeTheme = EditorView.theme({
        '&': { fontSize: '13px', maxHeight: '320px' },
        '.cm-scroller': { overflow: 'auto' },
        '.cm-content, .cm-gutter': { minHeight: '160px' },
      });

      makeEditor = (host: HTMLElement, doc: string): EditorView => {
        const state = EditorState.create({
          doc,
          extensions: [
            lineNumbers(),
            history(),
            highlightActiveLine(),
            EditorView.lineWrapping,
            EditorView.contentAttributes.of({ 'aria-label': 'PromQL query' }),
            keymap.of([
              // ⌘/Ctrl+Enter runs now — placed BEFORE defaultKeymap, whose
              // Mod-Enter would otherwise insert a blank line.
              {
                key: 'Mod-Enter',
                run: (v) => {
                  forceRun();
                  if (window.matchMedia?.('(pointer: coarse)').matches) v.contentDOM.blur();
                  return true;
                },
              },
              {
                key: 'Escape',
                run: (v) => {
                  v.contentDOM.blur();
                  return true;
                },
              },
              ...defaultKeymap,
              ...historyKeymap,
              indentWithTab,
            ]),
            plate,
            sizeTheme,
            // Live eval: re-explain once the query settles.
            EditorView.updateListener.of((u) => {
              if (u.docChanged) scheduleLive();
            }),
          ],
        });
        return new EditorView({ state, parent: host });
      };

      setEditorDoc = (view: EditorView, doc: string): void => {
        view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: doc } });
      };
    } catch (err) {
      renderError(resultsBox, summaryEl, 'The PromQL Explainer engine failed to load. Reload the page to try again.');
      // eslint-disable-next-line no-console
      console.error('[PromqlExplainer] engine/examples import failed:', err);
      return;
    }

    /* ---- Live evaluation ---------------------------------------------------
     * ~220ms after the query settles it is re-explained quietly (no spinner,
     * no loading flash). Calm errors: a live run that fails to parse holds
     * the previous panel and reveals the error only after ~600ms of idle in
     * total. `liveReady` keeps the seed and example dispatches from firing it. */
    const LIVE_DEBOUNCE_MS = 220;
    const ERROR_HOLD_MS = 380;
    let liveReady = false;
    let liveTimer: number | undefined;
    let errorHoldTimer: number | undefined;

    function scheduleLive(): void {
      if (!liveReady) return;
      window.clearTimeout(liveTimer);
      window.clearTimeout(errorHoldTimer);
      liveTimer = window.setTimeout(() => void explainNow({ live: true }), LIVE_DEBOUNCE_MS);
    }

    /** Deliberate run (Run now, ⌘/Ctrl+Enter, a chip): cancel the debounce, go now. */
    function forceRun(): void {
      window.clearTimeout(liveTimer);
      window.clearTimeout(errorHoldTimer);
      void explainNow();
    }

    // Seed priority: #q= deep link > restored last input > first example. The
    // first example is also what the build-time `<pre data-cm-fallback>` holds,
    // so the deep-link and restore tiers must be resolved BEFORE the fallback
    // is dropped — they replace the seed, never the other way round.
    const hashValue = hashState.read();
    const restored = getRestoredLastInput(SLUG);
    const seedExample = examples[0] ?? { id: 'empty', label: 'Example', query: '' };
    const view = makeEditor(editorHost, hashValue ?? restored ?? seedExample.query);
    // The build-time text stand-in has done its job (no-JS visitors and
    // crawlers); CodeMirror appended its editor beside it, so drop it.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());

    // The example chips are already in the static HTML (server-rendered from
    // the same `examples` module); hydration only wires them.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));
    if (examples.length === 0)
      chips.forEach((chip) => {
        chip.disabled = true;
      });

    // The first chip is server-rendered pressed; a deep link or a restored
    // input means no example is loaded, so nothing should read as selected.
    syncChipsByIndex(chipsWrap, hashValue || restored || examples.length === 0 ? null : 0);

    // Swap the editor doc when a different example is chosen, then explain it.
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        syncChipsByIndex(chipsWrap, idx);
        setEditorDoc(view, examples[idx].query);
        forceRun();
      });
    });

    // Explain — non-blocking. A deliberate run shows the loading state and a
    // spinner in Run now; a live (debounced) or seed run is quiet. The seed
    // never writes the #q= hash or records a last input.
    type RunOpts = { live?: boolean; showErrors?: boolean; seed?: boolean };
    let running = false;
    let rerun: RunOpts | null = null;
    const explainLabel = explainBtn.querySelector<HTMLElement>('.pq-explain-label');
    let spinner: HTMLElement | null = null;

    async function explainNow(opts: RunOpts = {}): Promise<void> {
      // Guaranteed present by the early return in init(); restated because TypeScript
      // discards that narrowing inside a hoisted function declaration.
      if (!explainBtn) return;
      const live = opts.live === true;
      const seeded = opts.seed === true;
      const quiet = live || seeded;
      if (running) {
        rerun = opts;
        return;
      }
      running = true;
      if (!quiet) {
        explainBtn.classList.add('is-busy');
        // Keep focus on the control for keyboard users: mark busy, not disabled.
        explainBtn.setAttribute('aria-disabled', 'true');
        explainBtn.setAttribute('aria-busy', 'true');
        if (!spinner) {
          spinner = document.createElement('span');
          spinner.setAttribute('aria-hidden', 'true');
          // Inline the visual so it never depends on Astro's scoped CSS — this
          // span is created at runtime and would not receive the component's scope hash.
          spinner.style.cssText =
            'display:inline-block;width:14px;height:14px;flex:0 0 auto;border-radius:50%;' +
            'border:2px solid currentColor;border-top-color:transparent;';
          if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            spinner.animate([{ transform: 'rotate(0deg)' }, { transform: 'rotate(360deg)' }], {
              duration: 700,
              iterations: Infinity,
            });
          }
          explainBtn.insertBefore(spinner, explainBtn.firstChild);
        }
        if (explainLabel) explainLabel.textContent = 'Explaining…';
        renderLoading(resultsBox!, summaryEl!);

        // Yield so the loading state paints before (potentially heavy) work runs.
        await new Promise<void>((resolve) => {
          if ('requestAnimationFrame' in window) requestAnimationFrame(() => resolve());
          else setTimeout(resolve, 0);
        });
      }

      try {
        const query = view.state.doc.toString();
        if (query.trim().length === 0) {
          renderEmpty(resultsBox!, summaryEl!);
          hideShare();
          if (!seeded) hashState.write(null);
        } else {
          const result = await Promise.resolve(engine.explain(query));
          const breakdown = normaliseBreakdown(result?.breakdown);
          const explanation = typeof result?.explanation === 'string' ? result.explanation : '';
          const good = Boolean(result && !result.error && (explanation || breakdown.length > 0));
          if (live && !good && opts.showErrors !== true) {
            // Hold the last good panel; reveal the error only after a longer idle.
            window.clearTimeout(errorHoldTimer);
            errorHoldTimer = window.setTimeout(() => void explainNow({ live: true, showErrors: true }), ERROR_HOLD_MS);
          } else {
            renderResult(resultsBox!, summaryEl!, result);
            if (good) {
              shareBtn!.hidden = false;
              shareBtn!.dataset.copy = location.origin + location.pathname + location.search + hashState.build(query);
              mdBtn!.hidden = false;
              mdBtn!.dataset.copy = buildMarkdownBlock('PromQL Explainer', [
                { label: 'Query', value: query },
                { label: 'Explanation', value: explanation },
                ...breakdown.map((p) => ({ label: p.token, value: p.meaning })),
              ]);
              if (!seeded) {
                hashState.write(query);
                recordToolLastInput(SLUG, query);
              }
            } else {
              hideShare();
              if (!seeded) hashState.write(null);
            }
          }
        }
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Unexpected error while explaining the query.';
        renderError(resultsBox!, summaryEl!, msg);
        hideShare();
        if (!seeded) hashState.write(null);
      } finally {
        running = false;
        explainBtn.classList.remove('is-busy');
        explainBtn.removeAttribute('aria-disabled');
        explainBtn.removeAttribute('aria-busy');
        if (spinner) {
          spinner.remove();
          spinner = null;
        }
        if (explainLabel) explainLabel.textContent = 'Run now';
        if (rerun) {
          const next = rerun;
          rerun = null;
          void explainNow(next);
        }
      }
    }

    explainBtn.addEventListener('click', () => forceRun());

    // ⌘/Ctrl+Enter anywhere else in the playground (a chip, Run now); inside
    // the editor the Mod-Enter binding has already handled it.
    root.addEventListener('keydown', (e) => {
      if (e.defaultPrevented) return;
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        forceRun();
      }
    });

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => view.state.doc.toString(),
      setValue: (value) => {
        setEditorDoc(view, value);
        syncChipsByIndex(chipsWrap, null);
        forceRun();
      },
    });

    // Explain whatever the editor ended up holding — a #q= deep link, a restored
    // last input, or the seeded example — so the panel is never empty on
    // arrival. Quiet, and not user input: no hash write, no last-input record.
    void explainNow({ seed: true });
    // Only now may keystrokes drive the panel (seed dispatches must not).
    liveReady = true;
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
