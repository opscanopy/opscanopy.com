---
/**
 * ToolHero — the compact tool-page masthead, rendered through PageHero.
 *
 * Tool pages are tool-first: the interactive playground sits directly beneath
 * this masthead, so the masthead is intentionally tight (PageHero
 * `variant="tool"`: small padding, no CTA row) to keep the tool itself at the
 * top of the viewport with minimal scroll.
 *
 * One left-aligned stack ON THE RAIL (batch D, 2026-10): breadcrumb, H1,
 * trust line and the "Updated" caption all hang from the `container-page`
 * left edge, like the hubs. The centred `mx-auto max-w-3xl … sm:text-center`
 * column, the eyebrow and the badge row are gone:
 *
 *   - the H1 is `<name>:` on its own `display-lg` line, then the page's
 *     `headline` slot on a `body-lg` line. The separator is the JSX
 *     expression `{' '}` — never a literal newline, since `compressHTML`
 *     keeps text-to-tag whitespace but a tag-to-tag space is not promised —
 *     so the H1's textContent is unchanged: "Subnet Calculator: Subnet any…".
 *     `src/lib/tool-hero-h1.test.ts` renders this H1 and asserts the ": ".
 *   - the `lead` slot is retired: the lede now renders below the result panel
 *     as `<ToolLede>` (moved verbatim by scripts/codemods/move-tool-lede.mjs).
 *   - `eyebrow` and `badges` are accepted but no longer rendered (the name is
 *     in the H1 and the crumb; "No signup" is the trust line's job).
 *   - the git-derived "Updated" date stays VISIBLE — it backs
 *     SoftwareApplication `dateModified` and the sitemap `<lastmod>` — as a
 *     `<time>` caption under the trust line (same `tools.updatedBadge` string).
 *
 * (The CanopyField arc wallpaper and its two scrims were removed on
 * 2026-10-02: on a tool page the instrument below is the signature.)
 */
import PageHero from './PageHero.astro';
import type { Props as BadgeProps } from './Badge.astro';
import { getTool, categories, categoryToSlug } from '../data/tools';
import { getToolUpdatedAt } from '../data/tool-meta';
import { site } from '../data/site';
import { breadcrumbLd } from '../lib/jsonld';
import { DEFAULT_LOCALE, BCP47, type Locale } from '../i18n/config';
import { useTranslations, localizeKey } from '../i18n/utils';
import { toolSlugFromPath } from '../lib/tool-slug';

export interface Props {
  /** @deprecated no longer rendered since batch D — kept so the 195 page calls don't break. */
  eyebrow?: string;
  /** @deprecated no longer rendered since batch D — kept so existing page calls don't break. */
  badges?: { label: string; variant?: BadgeProps['variant'] }[];
  /**
   * Optional tool slug. When provided, the masthead renders a full
   * Home / Tools / {category} / {name} breadcrumb trail (with matching
   * BreadcrumbList JSON-LD) instead of the bare "All tools" back-link.
   */
  slug?: string;
  /** @deprecated no longer rendered — kept so existing page calls don't break. */
  primaryCta?: { label: string; href: string };
  /** @deprecated no longer rendered. */
  secondaryCta?: { label: string; href: string };
}

const { slug } = Astro.props;

const lang = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE;
const t = useTranslations(lang);

/* Derive the slug from the current path when the page didn't pass one
   explicitly. Every localized tool page omits the `slug` prop (a copy-paste
   gap across the whole locale tree, not a deliberate choice — the English
   copies all pass it) — without this fallback, EVERY localized tool page
   silently lost both the breadcrumb trail and the pin-star button below.
   The resolver is shared with ToolGapVisual (src/lib/tool-slug.ts). */
const resolvedSlug = slug ?? toolSlugFromPath(Astro.url.pathname);

// When a slug resolves to a registered tool, build the breadcrumb trail + LD.
// Category pages exist for the default locale only (/tools/{slug}); on other
// locales the category stays plain text so we never link a cross-locale URL.
const tool = resolvedSlug ? getTool(resolvedSlug) : undefined;
const isDefaultLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) === DEFAULT_LOCALE;
// `categories` is derived from liveTools and is EXACTLY the set of
// /tools/{slug}/ pages `[category].astro`'s getStaticPaths emits — so gating on
// it is what keeps this crumb from linking a page that was never built. That
// happens for real: a tool registered `status:'planned'` in a brand-new category
// (terraform-plan-summarizer opening `IaC`) has a page that builds and enters the
// sitemap, while its category page does not exist until the status flips to
// 'live'. Without this check the crumb — and its BreadcrumbList JSON-LD item —
// pointed at a 404. When the href is null the crumb renders as plain text, which
// is already the non-default-locale path below.
const categoryHref =
  tool && isDefaultLocale && categories.some((c) => c.category === tool.category)
    ? `/tools/${categoryToSlug(tool.category)}/`
    : null;
const homeHref = localizeKey('/', lang);
const toolsHref = localizeKey('/tools', lang);
const toolHref = resolvedSlug ? localizeKey(`/${resolvedSlug}`, lang) : null;
// Every crumb's LD item is the locale-correct URL (Home/Tools link cross-
// locale on purpose for the default locale, but must reflect THIS page's
// own locale on every other one) — the leaf specifically must be the
// current page's own URL, not the default locale's.
const breadcrumbJson = tool
  ? JSON.stringify(
      breadcrumbLd([
        { name: t('breadcrumb.home'), item: `${site.url}${homeHref}` },
        { name: t('breadcrumb.tools'), item: `${site.url}${toolsHref}` },
        ...(categoryHref
          ? [{ name: tool.category, item: `${site.url}${categoryHref}` }]
          : []),
        { name: tool.name, item: `${site.url}${toolHref}` },
      ]),
    )
  : null;

// Git-derived "Updated" caption. Falls back to nothing if gen-tool-meta.mjs
// hasn't run yet (dev without a prior build).
const updatedAt = tool ? getToolUpdatedAt(tool.slug) : undefined;
const updatedLabel = updatedAt
  ? t('tools.updatedBadge', {
      date: new Intl.DateTimeFormat(BCP47[lang], { dateStyle: 'medium' }).format(
        new Date(`${updatedAt}T00:00:00Z`),
      ),
    })
  : null;

/*
  The head keyword goes in the H1, not just the <title>.

  Every tool page's headline slot is written as a benefit line — "Subnet any
  IPv4 or IPv6 block at a glance." — so none of the 39 H1s contained the term
  people actually search. Prefixing the registered name fixes all 195 pages
  (39 tools x 5 locales) from here rather than by rewriting every slot, and
  the name is already rendered untranslated in the breadcrumb above, so this
  introduces no new mixed-language text on localized pages.

  `h1Name` overrides `name` for the one tool whose brand is not its keyword
  (AlertLint -> Loki Alert Rule Tester); see the field docs in tools.ts.
*/
const h1Name = tool ? (tool.h1Name ?? tool.name) : null;
---

<PageHero variant="tool" class="relative isolate overflow-hidden bg-canvas-soft">
  <Fragment slot="breadcrumb">
    {/* The pin sits inside the container, so on wide screens it hangs off the
        content rail instead of the viewport edge. */}
    {
      tool && (
        <button
          type="button"
          id="tool-pin-btn"
          class="tool-pin-btn absolute right-4 top-3 z-20 inline-flex items-center justify-center gap-1.5 pointer-coarse:min-h-11 pointer-coarse:min-w-11 rounded-sm border border-hairline-muted bg-canvas/90 px-2.5 py-1.5 label-field shadow-hairline backdrop-blur transition-colors hover:border-hairline-strong hover:text-brand-strong aria-pressed:border-brand-strong aria-pressed:text-brand-strong sm:right-6 sm:top-5"
          style="touch-action: manipulation;"
          data-slug={resolvedSlug}
          data-label-add={t('tools.pinAdd')}
          data-label-remove={t('tools.pinRemove')}
          data-label-pin={t('tools.pinLabel')}
          data-label-pinned={t('tools.pinnedLabel')}
          aria-pressed="false"
          aria-label={t('tools.pinAdd')}
          hidden
        >
          <svg
            class="tool-pin-icon-outline size-[14px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3.5l2.47 5.18 5.72.55-4.3 3.9 1.2 5.63L12 15.9l-5.09 2.86 1.2-5.63-4.3-3.9 5.72-.55L12 3.5z" />
          </svg>
          <svg
            class="tool-pin-icon-filled hidden size-[14px]"
            viewBox="0 0 24 24"
            fill="currentColor"
            stroke="none"
            aria-hidden="true"
          >
            <path d="M12 3.5l2.47 5.18 5.72.55-4.3 3.9 1.2 5.63L12 15.9l-5.09 2.86 1.2-5.63-4.3-3.9 5.72-.55L12 3.5z" />
          </svg>
          <span class="tool-pin-label hidden sm:inline">{t('tools.pinLabel')}</span>
        </button>
      )
    }
    {
      tool ? (
        <nav aria-label="Breadcrumb" class="flex pr-12">
          <ol class="flex flex-wrap items-center gap-1.5">
            <li>
              <a href={homeHref} class="tap-44 hover:text-brand-strong transition-colors">
                {t('breadcrumb.home')}
              </a>
            </li>
            <li aria-hidden="true" class="text-mute">
              /
            </li>
            <li>
              <a href={toolsHref} class="tap-44 hover:text-brand-strong transition-colors">
                {t('breadcrumb.tools')}
              </a>
            </li>
            <li aria-hidden="true" class="text-mute">
              /
            </li>
            <li>
              {categoryHref ? (
                <a href={categoryHref} class="tap-44 hover:text-brand-strong transition-colors">
                  {tool.category}
                </a>
              ) : (
                tool.category
              )}
            </li>
            <li aria-hidden="true" class="text-mute">
              /
            </li>
            <li aria-current="page" class="text-body">
              {tool.name}
            </li>
          </ol>
        </nav>
      ) : (
        <a
          href={toolsHref}
          class="inline-flex items-center gap-1 text-sm text-mute hover:text-brand-strong transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
          {t('breadcrumb.allTools')}
        </a>
      )
    }
  </Fragment>
  {
    h1Name ? (
      <>
        <span class="block display-lg">{h1Name}:</span>{' '}
        <span class="tool-hero__headline block body-lg mt-2 text-body"><slot name="headline" /></span>
      </>
    ) : (
      <slot name="headline" />
    )
  }
  <Fragment slot="meta">
    {/* The ONE trust line on a tool page — stated where the decision to paste
        is made. A live dot (shared pulse-ring keyframe) makes "computed
        locally" a persistent instrument reading rather than a badge; the
        duplicate "Runs in your browser" badge was removed from every page. */}
    <p class="tool-trust inline-flex flex-nowrap items-start gap-x-2 text-mute">
      <span class="tool-trust__dot" aria-hidden="true"></span>
      <span>
        {t('tool.trust')}{' '}
        <a class="underline decoration-hairline-strong underline-offset-2 hover:text-brand-strong" href={localizeKey('/security', lang)}>
          {t('tool.trustLink')}
        </a>
      </span>
    </p>
    {/* The visible "Updated" caption: PageHero's meta row is flex-wrap, so it
        sits beside the trust line where there is room and wraps under it on
        narrow screens. Never hidden — it backs `dateModified` and `<lastmod>`. */}
    {
      updatedLabel && (
        <p class="text-mute">
          <time datetime={updatedAt}>{updatedLabel}</time>
        </p>
      )
    }
  </Fragment>
</PageHero>
{
  breadcrumbJson && (
    <script type="application/ld+json" set:html={breadcrumbJson} />
  )
}

{
  tool && (
    <style>
  /* The headline line is body copy inside a display-lg H1: reset the display
     tracking it would otherwise inherit (a reset, not a raw tracking value). */
  .tool-hero__headline {
    letter-spacing: normal;
  }
  .tool-trust__dot {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--color-brand);
    flex: none;
    /* Centre the 7px dot on the first 16px caption line now that the row is
       items-start (so a wrapped trust line keeps the dot beside line one). */
    margin-top: 4px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .tool-trust__dot {
      animation: pulse-ring 2.6s ease-in-out infinite;
    }
  }
</style>

<script>
      import { TOOL_PREFS_KEY, parseToolPrefs, serializeToolPrefs, togglePin, isPinned } from '../lib/tool-prefs/prefs';
      import { safeGtag } from '../lib/gtag';

      function readPrefs() {
        try {
          return parseToolPrefs(localStorage.getItem(TOOL_PREFS_KEY));
        } catch {
          return parseToolPrefs(null);
        }
      }

      function boot(): void {
        const btn = document.getElementById('tool-pin-btn') as HTMLButtonElement | null;
        if (!btn || btn.dataset.pinWired === 'true') return;
        const slug = btn.dataset.slug;
        if (!slug) return;
        btn.dataset.pinWired = 'true';

        const outline = btn.querySelector<HTMLElement>('.tool-pin-icon-outline');
        const filled = btn.querySelector<HTMLElement>('.tool-pin-icon-filled');
        const labelEl = btn.querySelector<HTMLElement>('.tool-pin-label');
        const addLabel = btn.dataset.labelAdd ?? 'Pin this tool';
        const removeLabel = btn.dataset.labelRemove ?? 'Unpin this tool';
        const pinText = btn.dataset.labelPin ?? 'Pin';
        const pinnedText = btn.dataset.labelPinned ?? 'Pinned';

        function render(pinned: boolean): void {
          btn!.setAttribute('aria-pressed', String(pinned));
          btn!.setAttribute('aria-label', pinned ? removeLabel : addLabel);
          outline?.classList.toggle('hidden', pinned);
          filled?.classList.toggle('hidden', !pinned);
          if (labelEl) labelEl.textContent = pinned ? pinnedText : pinText;
        }

        // Storage-blocked browsers: readPrefs() safely falls back to empty
        // prefs, so the button still renders (as "not pinned") instead of
        // staying hidden forever.
        render(isPinned(readPrefs(), slug));
        btn.hidden = false;

        btn.addEventListener('click', () => {
          const next = togglePin(readPrefs(), slug);
          const nowPinned = isPinned(next, slug);
          // Render first: the toggle should feel instant even when storage is
          // blocked (Safari private mode, a locked-down browser) — only the
          // ACROSS-RELOAD persistence is at risk there, not this click's
          // visible feedback.
          render(nowPinned);
          safeGtag('event', 'cta_click', { cta: nowPinned ? 'tool_pin' : 'tool_unpin' });
          try {
            localStorage.setItem(TOOL_PREFS_KEY, serializeToolPrefs(next));
          } catch {
            /* storage blocked — the toggle won't persist across reload */
          }
        });
      }

      boot();
      document.addEventListener('astro:page-load', boot);
    </script>
  )
}
