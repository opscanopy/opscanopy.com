---
/**
 * MacFormatterPlayground — the interactive MAC Address Formatter island.
 *
 * Single-input, live tool: type a MAC address in any common form (colon,
 * hyphen, Cisco dotted, or bare hex) and every representation is rendered,
 * along with the OUI, transmission/administration bits, and the derived IPv6
 * link-local (modified EUI-64). No button.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar, ResultPanel (figure cap, live summary, copy status)
 * and CopyButton. The results container stays here, seeded with
 * `set:html` + `data-results`; its slab overrides anchor on `.mac-results`.
 *
 * Runtime contract (lazy-imported):
 *   ../lib/mac-formatter/engine   → format(input: string): MacResult
 *   ../lib/mac-formatter/examples → examples: { id; label; input }[]
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names rather than a "Loading examples…" placeholder
// that crawlers and no-JS visitors would otherwise be served. The chips are
// never rebuilt at hydration — the script only wires clicks onto them — so this
// adds nothing to the client bundle and cannot drift.
import { examples as prerenderedExamples } from '../lib/mac-formatter/examples';
import { format } from '../lib/mac-formatter/engine';
import { resultHtml, EMPTY_HTML } from '../lib/mac-formatter/render';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-computes the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees a real worked answer
 * instead of an empty "type something here" panel.
 *
 * `format` is pure and synchronous, so it runs at build time unchanged.
 */
const seedExample = prerenderedExamples[0];
const seedResult = seedExample ? format(seedExample.input) : null;
const localePrefix = Astro.currentLocale && Astro.currentLocale !== 'en' ? `/${Astro.currentLocale}` : '';
const seedHtml =
  seedResult && seedResult.valid ? resultHtml(seedResult, { localePrefix }) : EMPTY_HTML;
const seedSummary = seedResult && seedResult.valid ? 'EUI-48' : '';
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="mac-pg" aria-label="MAC Address Formatter playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow shrink-0">Example</span>
      {/* Server-rendered so the examples are in the static HTML; the hydration
          script only wires clicks onto these buttons, it never rebuilds them. */}
      <ExampleChips prefix="mac" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
    </div>

    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <label class="eyebrow mb-2 block" for="mac-input">MAC address <span class="mac-sample-cue">(sample)</span></label>
      <div class="mac-input-wrap">
        <svg
          class="mac-input-icon pointer-events-none"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 10h12M10 4v12"></path>
          <circle cx="10" cy="10" r="7.25"></circle>
        </svg>
        <input
          id="mac-input"
          type="text"
          class="mac-input code-mono"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          placeholder="00:1a:2b:3c:4d:5e"
          value={seedExample?.input}
          aria-describedby="mac-input-hint mac-run-hint"
        />
      </div>
      <p id="mac-input-hint" class="mac-hint caption text-mute">
        Any form — colon <span class="code-mono">00:1a:2b:3c:4d:5e</span>, hyphen
        <span class="code-mono">00-1A-2B-3C-4D-5E</span>, Cisco dot
        <span class="code-mono">001a.2b3c.4d5e</span>, or bare <span class="code-mono">001a2b3c4d5e</span>.
      </p>
      <RunHint id="mac-run-hint" />
      <SnapshotBar prefix="mac" />
    </div>

    {/* ── Results panel — the L2 instrument (dark in both themes) under its
        figure cap; the live summary reads out in the cap's actions slot. ── */}
    <ResultPanel
      slug="mac-address-formatter"
      prefix="mac"
      summary={seedSummary}
      summaryClass="whitespace-nowrap"
      split
    >
      <Fragment slot="actions">
        <CopyButton kind="link" id="mac-share" />
        <CopyButton kind="value" id="mac-md" label="Copy as Markdown" icon="markdown" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the answer is in the
          static HTML; the client replaces it with the same markup on boot. */}
      <div id="mac-results" class="mac-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .mac-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .mac-input-icon {
    position: absolute;
    left: 14px;
    width: 18px;
    height: 18px;
    color: var(--color-mute);
    pointer-events: none;
  }
  .mac-input {
    width: 100%;
    height: var(--control-h-lg);
    padding: 0 16px 0 42px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 15px;
    line-height: 24px;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .mac-input::placeholder {
    color: var(--color-mute);
  }
  .mac-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .mac-input:focus {
    outline: none;
  }
  .mac-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .mac-input.mac-input--error {
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  .mac-input.mac-input--error:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-error);
  }
  .mac-sample-cue {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-mute);
    font-family: var(--font-sans);
  }
  .mac-sample-cue.is-hidden {
    display: none;
  }
  .mac-hint {
    margin-top: 8px;
    text-wrap: pretty;
  }
  .mac-results {
    min-height: var(--control-h-lg);
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.mac-results` container (the panel
     wrapper is ResultPanel's and carries no scope attribute). The
     cross-tool `.mac-chip` link row takes the slab chip recipe from
     global.css (`[data-results] a[class$='-chip']`). */
  :global(.mac-card) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: mac-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.mac-title) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-mute);
  }
  :global(.mac-title__badge) {
    flex: 0 0 auto;
    font-size: 11px;
    line-height: 16px;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
  }
  :global(.mac-row) {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr) auto;
    gap: 12px;
    padding: 9px 14px;
    align-items: center;
  }
  :global(.mac-row + .mac-row) {
    border-top: 1px solid var(--color-hairline);
  }
  /* Row-key role (label-field): mono 11/16 uppercase, the only label. */
  :global(.mac-row__k) {
    @apply label-field;
  }
  :global(.mac-row__v) {
    min-width: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-word;
  }
  :global(.mac-row__v.is-mono) {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  /* ── Per-row copy buttons (render.ts `button[data-copy-value]`; the
     script adopts them into the kit's copy cycle, copy.ts drives them) ── */
  :global(.mac-copy-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background var(--dur-fast) var(--ease-brand),
      color var(--dur-fast) var(--ease-brand);
  }
  :global(.mac-copy-btn:hover) {
    background: var(--color-canvas-soft);
    color: var(--color-ink);
  }
  :global(.mac-copy-btn:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  :global(.mac-copy-btn[data-copied]) {
    color: var(--color-brand-strong);
  }
  :global(.mac-copy-btn svg) {
    pointer-events: none;
  }
  @media (pointer: coarse) {
    :global(.mac-copy-btn) {
      width: var(--control-h-lg);
      height: var(--control-h-lg);
    }
  }

  @keyframes mac-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.mac-card) {
      animation: none;
    }
  }

  :global(.mac-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.mac-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.mac-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.mac-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.mac-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below it uses the slab ink tier; the light rules
     above remain the documented defaults. ──────────────────────────────── */
  .mac-results :global(.mac-empty),
  .mac-results :global(.mac-card) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .mac-results :global(.mac-empty) {
    color: var(--color-inverse-mute);
  }
  .mac-results :global(.mac-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .mac-results :global(.mac-title) {
    border-bottom-color: var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .mac-results :global(.mac-title__badge) {
    background: #8fc97a1f;
    color: var(--color-inverse-brand);
  }
  .mac-results :global(.mac-row + .mac-row) {
    border-top-color: #ffffff12;
  }
  .mac-results :global(.mac-row__k) {
    color: var(--color-inverse-mute);
  }
  .mac-results :global(.mac-row__v) {
    color: var(--color-inverse-fg);
  }
  .mac-results :global(.mac-copy-btn) {
    color: var(--color-inverse-mute);
  }
  .mac-results :global(.mac-copy-btn:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .mac-results :global(.mac-copy-btn[data-copied]) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
</style>

<script>
  import { EMPTY_HTML, errorHtml, resultHtml, CHECK_SVG } from '../lib/mac-formatter/render';
  import { wireRunKeys } from '../lib/run-keys';
  import { createHashState } from '../lib/hash-state';
  import { buildMarkdownBlock } from '../lib/share-md';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';

  // Type-only import: erased at build, so the engine is still lazily imported
  // inside boot() and does not join this page's initial chunk.
  import type { MacResult as Result, MacExample as Example } from '../lib/mac-formatter/types';
  type EngineModule = { format: (input: string) => Result };

  const ROOT_SEL = '.mac-pg';
  const DEBOUNCE_MS = 140;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.macWired === 'true') return;
      root.dataset.macWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          input: typeof o.input === 'string' ? o.input : '',
        } satisfies Example;
      })
      .filter((e) => e.input.length > 0);
  }

  /**
   * render.ts emits each row's copy button as `button[data-copy-value]` with a
   * bare icon. Adopt it into the kit's copy cycle on the live element: the
   * payload moves to `data-copy`, the icon gains the `data-copy-icon` hook and
   * a hidden `data-check-icon` is appended for the success swap. Client-only,
   * so the seeded HTML (and render.ts) stay unchanged.
   */
  function adoptRowCopyButtons(container: HTMLElement): void {
    container.querySelectorAll<HTMLButtonElement>('button[data-copy-value]').forEach((btn) => {
      btn.dataset.copy = btn.dataset.copyValue ?? '';
      btn.querySelector('svg')?.setAttribute('data-copy-icon', '');
      if (btn.querySelector('[data-check-icon]')) return;
      btn.insertAdjacentHTML('beforeend', CHECK_SVG);
      const check = btn.lastElementChild;
      check?.setAttribute('data-check-icon', '');
      check?.classList.add('hidden');
    });
  }

  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = EMPTY_HTML;
  }

  function renderError(container: HTMLElement, summary: HTMLElement, message: string): void {
    setSummary(summary, 'Invalid', true);
    container.innerHTML = errorHtml(message);
  }

  /** Prefix tool paths with the current locale (e.g. /de) so deep links stay in-locale. */
  function localePath(p: string): string {
    const m = window.location.pathname.match(/^\/(de|es|fr|pt-br)\//);
    return m ? `/${m[1]}${p}` : p;
  }

  function renderResult(container: HTMLElement, summary: HTMLElement, result: Result): void {
    setSummary(summary, 'EUI-48', false);
    container.innerHTML = resultHtml(result, { localePrefix: localePath('') });
    adoptRowCopyButtons(container);
  }

  async function init(root: HTMLElement): Promise<void> {
    const input = el<HTMLInputElement>(root, '#mac-input');
    const chipsWrap = el<HTMLElement>(root, '#mac-chips');
    const resultsBox = el<HTMLElement>(root, '#mac-results');
    const summaryEl = el<HTMLElement>(root, '#mac-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#mac-share');
    const mdBtn = el<HTMLButtonElement>(root, '#mac-md');
    const copyStatus = el<HTMLElement>(root, '#mac-copy-status');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#mac-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#mac-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#mac-snap-delete');
    if (
      !input ||
      !chipsWrap ||
      !resultsBox ||
      !summaryEl ||
      !shareBtn ||
      !mdBtn ||
      !copyStatus ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    const hashState = createHashState('mac');

    // Row copy, Copy link and Copy as Markdown: the kit's delegated copy
    // listener; outcomes announced in #mac-copy-status.
    wireCopyButtons(root, { status: copyStatus });

    function hideShare(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
      mdBtn!.hidden = true;
      mdBtn!.dataset.copy = '';
    }

    let engine: EngineModule;
    let examples: Example[] = [];
    try {
      const [engineMod, examplesMod] = await Promise.all([
        import('../lib/mac-formatter/engine'),
        import('../lib/mac-formatter/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
    } catch (err) {
      renderError(resultsBox, summaryEl, 'The formatter engine failed to load. Reload the page to try again.');
      console.error('[MacFormatter] engine import failed:', err);
      return;
    }

    // The chips are server-rendered from the same `examples` module, so their
    // data-example-idx values index straight into `examples`. `null` clears the
    // selection — used whenever the input no longer matches any example.
    const chips = Array.from(chipsWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));

    function setActiveChip(idx: number | null): void {
      syncChipsByIndex(chipsWrap, idx);
    }

    function evaluate(userInitiated = true): void {
      const value = input!.value.trim();
      if (value.length === 0) {
        input!.classList.remove('mac-input--error');
        hideShare();
        renderEmpty(resultsBox!, summaryEl!);
        if (userInitiated) hashState.write(null);
        return;
      }
      let result: Result | null = null;
      try {
        result = engine.format(value);
      } catch {
        input!.classList.add('mac-input--error');
        hideShare();
        renderError(resultsBox!, summaryEl!, 'Unexpected error while formatting.');
        if (userInitiated) hashState.write(null);
        return;
      }
      if (!result || result.valid === false) {
        input!.classList.add('mac-input--error');
        hideShare();
        renderError(resultsBox!, summaryEl!, result?.error ?? 'This is not a valid MAC address.');
        if (userInitiated) hashState.write(null);
        return;
      }
      input!.classList.remove('mac-input--error');
      renderResult(resultsBox!, summaryEl!, result);
      shareBtn!.hidden = false;
      shareBtn!.dataset.copy = location.origin + location.pathname + location.search + hashState.build(value);
      if (userInitiated) hashState.write(value);
      if (userInitiated) recordToolLastInput('mac-address-formatter', value);

      mdBtn!.hidden = false;
      const rows = Array.isArray(result.rows) ? result.rows : [];
      mdBtn!.dataset.copy = buildMarkdownBlock('MAC Address Formatter', [
        { label: 'Input', value },
        ...rows.map((r) => ({ label: r.label ?? '', value: typeof r.value === 'string' ? r.value : '' })),
      ]);
    }

    let timer: number | undefined;
    function scheduleEvaluate(): void {
      window.clearTimeout(timer);
      timer = window.setTimeout(evaluate, DEBOUNCE_MS);
    }

    const sampleCue = root.querySelector<HTMLElement>('.mac-sample-cue');
    input.addEventListener('input', () => {
      setActiveChip(null);
      if (sampleCue) sampleCue.classList.add('is-hidden');
      scheduleEvaluate();
    });

    wireRunKeys(input, () => {
      window.clearTimeout(timer);
      evaluate(true);
    });
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        input.value = examples[idx].input;
        setActiveChip(idx);
        window.clearTimeout(timer);
        evaluate();
      });
    });

    wireSnapshotUI({
      slug: 'mac-address-formatter',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => input!.value.trim(),
      setValue: (value) => {
        input!.value = value;
        setActiveChip(null);
        if (sampleCue) sampleCue.classList.add('is-hidden');
        window.clearTimeout(timer);
        evaluate();
      },
    });

    // Seed priority: #mac= deep link > restored last input > seeded example.
    // Neither seed path writes the hash or records a last-input — only
    // user-initiated evaluations do.
    const hashValue = hashState.read();
    const restored = getRestoredLastInput('mac-address-formatter');
    if (hashValue) {
      // Restored from the URL — the input matches no example, so no chip is active.
      input.value = hashValue;
      setActiveChip(null);
      evaluate(false);
    } else if (restored) {
      input.value = restored;
      setActiveChip(null);
      evaluate(false);
    } else {
      const seed = examples[0];
      if (seed) {
        input.value = seed.input;
        setActiveChip(0);
        evaluate(false);
      } else {
        setActiveChip(null);
        renderEmpty(resultsBox, summaryEl);
      }
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
