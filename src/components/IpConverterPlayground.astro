---
/**
 * IpConverterPlayground — the interactive IP Address Converter island.
 *
 * Single-input, live tool: type an IP in any form (dotted decimal, integer,
 * hexadecimal, binary, or IPv6) and every representation is rendered. No button.
 * A Bulk mode converts one IP per line into a table.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar, ResultPanel (figure cap, live summary, copy status)
 * and CopyButton. The results container stays here, seeded with
 * `set:html` + `data-results`; its slab overrides anchor on `.ipc-results`.
 * The `.ipc-chip` row under each result card is the cross-tool LINK row
 * (global.css draws it), not the example chips.
 *
 * Runtime contract (lazy-imported):
 *   ../lib/ip-converter/engine   → convert(input: string): ConvertResult
 *   ../lib/ip-converter/examples → examples: { id; label; input }[]
 */
// Build-time import of the same `examples` the client script loads lazily.
// Used ONLY to server-render the example chips below, so the static HTML
// carries real example names instead of the empty picker it used to ship. The
// chips are never rebuilt at hydration — the script only wires clicks onto
// them and reads `data-example-idx` — so this adds nothing to the client
// bundle. Indices line up with the script's array because the runtime
// `normaliseExamples` only drops entries with an empty `input`, and every
// bundled example has one.
import { examples as prerenderedExamples } from '../lib/ip-converter/examples';
import { convert } from '../lib/ip-converter/engine';
import { resultHtml, summaryText, EMPTY_HTML } from '../lib/ip-converter/render';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-computes the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees a real worked answer
 * instead of an empty "type something here" panel.
 *
 * `convert` is pure and synchronous, so it runs at build time unchanged.
 */
const seedExample = prerenderedExamples[0];
const seedResult = seedExample ? convert(seedExample.input) : null;
const localePrefix = Astro.currentLocale && Astro.currentLocale !== 'en' ? `/${Astro.currentLocale}` : '';
const seedHtml =
  seedResult && seedResult.valid && seedExample
    ? resultHtml(seedResult, { localePrefix, rawInput: seedExample.input })
    : EMPTY_HTML;
const seedSummary = seedResult && seedResult.valid ? summaryText(seedResult) : '';
const chipItems = prerenderedExamples.map((ex) => ({ label: ex.label }));
---

<section class="ipc-pg" aria-label="IP Address Converter playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <div class="flex items-center gap-3">
        <span id="ipc-example-label" class="eyebrow shrink-0">Example</span>
        <div class="ipc-mode ml-auto" role="group" aria-label="Input mode">
          <button type="button" class="ipc-mode-btn" data-mode="single" aria-pressed="true">Single</button>
          <button type="button" class="ipc-mode-btn" data-mode="bulk" aria-pressed="false">Bulk</button>
        </div>
      </div>
      {/* Real <button> chips, server-rendered in DOM order so tab order and
          no-JS legibility come for free. The first is pre-pressed to match
          the boot seed; the script releases it when a typed value, an `#ip=`
          deep link or a restored input wins instead. The row keeps
          `id="ipc-example-wrap"` — the script hides it in Bulk mode. */}
      <ExampleChips id="ipc-example-wrap" prefix="ipc" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
    </div>

    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <div id="ipc-single-wrap">
        <label class="eyebrow mb-2 block" for="ipc-input">IP address</label>
        <div class="ipc-input-wrap">
          <svg
            class="ipc-input-icon pointer-events-none"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 10h12M10 4v12"></path>
            <circle cx="10" cy="10" r="7.25"></circle>
          </svg>
          <input
            id="ipc-input"
            type="text"
            class="ipc-input code-mono"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            autocomplete="off"
            enterkeyhint="done"
            placeholder="192.168.1.10"
            value={seedExample?.input}
            aria-describedby="ipc-input-hint ipc-run-hint"
          />
        </div>
        <p id="ipc-input-hint" class="ipc-hint caption text-mute">
          Any form — dotted decimal <span class="code-mono">192.168.1.10</span>, integer
          <span class="code-mono">3232235786</span>, hex <span class="code-mono">0xC0A8010A</span>,
          binary, or IPv6 <span class="code-mono">2001:db8::1</span> — the format is auto-detected.
        </p>
        <RunHint id="ipc-run-hint" />
        <SnapshotBar prefix="ipc" />
      </div>
      <div id="ipc-bulk-wrap" hidden>
        <label class="eyebrow mb-2 block" for="ipc-bulk-input">IP addresses — one per line</label>
        <textarea
          id="ipc-bulk-input"
          class="ipc-textarea code-mono"
          rows="6"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          placeholder={'192.168.1.10\n2001:db8::1\n# blank lines and # comments are skipped'}></textarea>
      </div>
      <noscript>
        <p class="ipc-hint caption text-mute">
          This converter runs entirely in your browser — enable JavaScript to use it.
        </p>
      </noscript>
    </div>

    {/* ── Results panel — the L2 instrument (dark in both themes) under its
        figure cap; the live summary reads out in the cap's actions slot. ── */}
    <ResultPanel slug="ip-address-converter" prefix="ipc" summary={seedSummary} split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="ipc-share" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the answer is in the
          static HTML; the client replaces it with the same markup on boot. */}
      <div id="ipc-results" class="ipc-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .ipc-mode {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }
  /* Single | Bulk toggle — the pressed state IS aria-pressed. */
  .ipc-mode-btn {
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 3px 10px;
    border-radius: calc(var(--radius-sm) - 2px);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    color: var(--color-mute);
    transition:
      color var(--dur-fast) var(--ease-brand),
      background var(--dur-fast) var(--ease-brand);
  }
  .ipc-mode-btn:hover {
    color: var(--color-ink);
  }
  .ipc-mode-btn:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  .ipc-mode-btn[aria-pressed='true'] {
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
  }
  @media (pointer: coarse) {
    .ipc-mode-btn {
      min-height: var(--control-h-lg);
    }
  }

  .ipc-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .ipc-input-icon {
    position: absolute;
    left: 14px;
    width: 18px;
    height: 18px;
    color: var(--color-mute);
    pointer-events: none;
  }
  .ipc-input {
    width: 100%;
    height: var(--control-h-lg);
    padding: 0 16px 0 42px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 15px;
    line-height: 24px;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .ipc-input::placeholder {
    color: var(--color-mute);
  }
  .ipc-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .ipc-input:focus {
    outline: none;
  }
  .ipc-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .ipc-input.ipc-input--error {
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  .ipc-input.ipc-input--error:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-error);
  }
  .ipc-textarea {
    width: 100%;
    min-height: 132px;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 13px;
    line-height: 20px;
    resize: vertical;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .ipc-textarea::placeholder {
    color: var(--color-mute);
  }
  .ipc-textarea:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .ipc-textarea:focus {
    outline: none;
  }
  .ipc-textarea:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .ipc-hint {
    margin-top: 8px;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .ipc-hint .code-mono {
    font-size: 12px;
  }
  /* Sized to the seeded 7-row IPv4 card so empty/error states don't collapse
     the panel; smaller content is vertically centered within it. */
  .ipc-results {
    min-height: 310px;
    display: grid;
    align-content: center;
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.ipc-results` container (the panel
     wrapper is ResultPanel's and carries no scope attribute). */
  :global(.ipc-card) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: ipc-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.ipc-title) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-mute);
  }
  :global(.ipc-title__badge) {
    flex: 0 0 auto;
    font-size: 11px;
    line-height: 16px;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
  }
  :global(.ipc-title__detected) {
    color: var(--color-ink);
  }
  :global(.ipc-row) {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 12px;
    padding: 9px 14px;
    align-items: baseline;
  }
  /* Below ~480px: stack label above value so long IPv6 addresses don't wrap
     mid-hex-group (ported from SubnetCalculatorPlayground). */
  @media (max-width: 479px) {
    :global(.ipc-row) {
      grid-template-columns: 1fr;
      gap: 2px 8px;
    }
    :global(.ipc-row .ipc-copy-btn) {
      align-self: center;
    }
  }
  :global(.ipc-row + .ipc-row) {
    border-top: 1px solid var(--color-hairline);
  }
  /* Row-key role (label-field): mono 11/16 uppercase, the only label. */
  :global(.ipc-row__k) {
    @apply label-field;
  }
  /* The "input" tag beside the echoed row's key — same label role, boxed. */
  :global(.ipc-chip-input) {
    @apply label-field;
    display: inline-block;
    margin-left: 6px;
    padding: 0 6px;
    border-radius: var(--radius-pill);
    background: var(--color-hairline);
    vertical-align: middle;
  }
  :global(.ipc-row__v-wrap) {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  :global(.ipc-row__v) {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-word;
    overflow-wrap: anywhere;
  }
  :global(.ipc-row__v.is-mono) {
    font-family: var(--font-mono);
    font-size: 13px;
  }
  :global(.ipc-row__zone-link) {
    flex: 0 0 auto;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 18px;
    color: var(--color-mute);
    text-decoration: none;
  }
  :global(.ipc-row__zone-link:hover) {
    color: var(--color-brand-strong);
    text-decoration: underline;
  }
  /* ── Per-row copy buttons (render.ts; copy.ts drives them) ──────────── */
  :global(.ipc-copy-btn) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-brand),
      background var(--dur-fast) var(--ease-brand);
    padding: 0;
  }
  :global(.ipc-copy-btn:hover) {
    color: var(--color-brand-strong);
    background: var(--color-hairline);
  }
  :global(.ipc-copy-btn:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  :global(.ipc-copy-btn[data-copied]) {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
  }
  @media (pointer: coarse) {
    :global(.ipc-copy-btn) {
      width: var(--control-h-lg);
      height: var(--control-h-lg);
    }
  }

  :global(.ipc-warnings) {
    margin-bottom: 12px;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    background: var(--color-warning-soft);
    box-shadow: inset 0 0 0 1px var(--color-warning);
    color: var(--color-warning-deep);
  }
  :global(.ipc-warnings__item) {
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.ipc-warnings__item + .ipc-warnings__item) {
    margin-top: 4px;
  }

  :global(.ipc-bulk-note) {
    margin-bottom: 10px;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-warning-deep);
    text-wrap: pretty;
  }
  :global(.ipc-bulk-bar) {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 10px;
  }
  :global(.ipc-bulk-scroll) {
    overflow-x: auto;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }
  :global(.ipc-bulk-table) {
    min-width: 640px;
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    line-height: 18px;
  }
  /* Column heads — the label-field role. */
  :global(.ipc-bulk-table th) {
    @apply label-field;
    padding: 8px 12px;
    border-bottom: 1px solid var(--color-hairline);
    text-align: left;
  }
  :global(.ipc-bulk-table td) {
    padding: 7px 12px;
    border-bottom: 1px solid var(--color-hairline);
    vertical-align: top;
    color: var(--color-ink);
  }
  :global(.ipc-bulk-table tbody tr:last-child td) {
    border-bottom: none;
  }
  :global(.ipc-bulk-table td.is-mono) {
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  :global(.ipc-bulk-status--ok) {
    color: var(--color-brand-strong);
  }
  :global(.ipc-bulk-status--fail) {
    color: var(--color-error-deep);
  }

  @keyframes ipc-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.ipc-card) {
      animation: none;
    }
  }

  :global(.ipc-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.ipc-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.ipc-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.ipc-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.ipc-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below it uses the slab ink tier; the light rules
     above remain the documented defaults. The cross-tool `.ipc-chip` link
     row takes the slab chip recipe from global.css. ───────────────────── */
  .ipc-results :global(.ipc-empty),
  .ipc-results :global(.ipc-card),
  .ipc-results :global(.ipc-bulk-scroll) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .ipc-results :global(.ipc-empty) {
    color: var(--color-inverse-mute);
  }
  .ipc-results :global(.ipc-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .ipc-results :global(.ipc-warnings) {
    background: #e0a45814;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-accent);
  }
  .ipc-results :global(.ipc-bulk-note) {
    color: var(--color-inverse-accent);
  }
  .ipc-results :global(.ipc-title) {
    border-bottom-color: var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }
  .ipc-results :global(.ipc-title__badge) {
    background: #8fc97a1f;
    color: var(--color-inverse-brand);
  }
  .ipc-results :global(.ipc-title__detected),
  .ipc-results :global(.ipc-row__v),
  .ipc-results :global(.ipc-bulk-table td) {
    color: var(--color-inverse-fg);
  }
  .ipc-results :global(.ipc-row + .ipc-row) {
    border-top-color: #ffffff12;
  }
  .ipc-results :global(.ipc-row__k),
  .ipc-results :global(.ipc-bulk-table th),
  .ipc-results :global(.ipc-row__zone-link) {
    color: var(--color-inverse-mute);
  }
  .ipc-results :global(.ipc-row__zone-link:hover) {
    color: var(--color-inverse-brand);
  }
  .ipc-results :global(.ipc-chip-input) {
    background: #ffffff14;
    color: var(--color-inverse-mute);
  }
  .ipc-results :global(.ipc-bulk-table th),
  .ipc-results :global(.ipc-bulk-table td) {
    border-bottom-color: #ffffff12;
  }
  .ipc-results :global(.ipc-bulk-status--ok) {
    color: var(--color-inverse-brand);
  }
  .ipc-results :global(.ipc-bulk-status--fail) {
    color: var(--color-inverse-error);
  }
  /* Values right-align like every instrument readout; the stacked <480px
     layout returns to the left edge. */
  .ipc-results :global(.ipc-row__v-wrap) {
    justify-content: flex-end;
  }
  .ipc-results :global(.ipc-row__v) {
    text-align: right;
  }
  @media (max-width: 479px) {
    .ipc-results :global(.ipc-row__v-wrap) {
      justify-content: flex-start;
    }
    .ipc-results :global(.ipc-row__v) {
      text-align: left;
    }
  }
  .ipc-results :global(.ipc-copy-btn) {
    color: var(--color-inverse-mute);
  }
  .ipc-results :global(.ipc-copy-btn:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .ipc-results :global(.ipc-copy-btn[data-copied]) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
</style>

<script>
  import { escapeHtml } from '../lib/escape-html';
  import {
    EMPTY_HTML,
    errorHtml,
    resultHtml,
    summaryText,
    COPY_ICON_SVG,
    CHECK_ICON_SVG,
  } from '../lib/ip-converter/render';
  import { wireRunKeys } from '../lib/run-keys';
  import { readIpHash, buildIpHash } from '../lib/ip-hash';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';

  // Type-only import: erased at build, so the engine is still lazily imported
  // inside boot() and does not join this page's initial chunk.
  import type { ConvertResult as Result, ConvertExample as Example } from '../lib/ip-converter/types';
  type EngineModule = { convert: (input: string) => Result };

  const ROOT_SEL = '.ipc-pg';
  const DEBOUNCE_MS = 140;
  const MAX_BULK_LINES = 1000;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.ipcWired === 'true') return;
      root.dataset.ipcWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          input: typeof o.input === 'string' ? o.input : '',
        } satisfies Example;
      })
      .filter((e) => e.input.length > 0);
  }

  /** Prefix tool paths with the current locale (e.g. /de) so deep links stay in-locale. */
  function localePath(p: string): string {
    const m = window.location.pathname.match(/^\/(de|es|fr|pt-br)\//);
    return m ? `/${m[1]}${p}` : p;
  }

  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = EMPTY_HTML;
  }

  function renderError(
    container: HTMLElement,
    summary: HTMLElement,
    message: string,
    isAlert = false
  ): void {
    setSummary(summary, `Invalid — ${message}`, true);
    container.innerHTML = errorHtml(message, isAlert);
  }

  function renderResult(
    container: HTMLElement,
    summary: HTMLElement,
    result: Result,
    rawInput: string
  ): void {
    setSummary(summary, summaryText(result), false);
    container.innerHTML = resultHtml(result, { localePrefix: localePath(''), rawInput });
  }

  async function init(root: HTMLElement): Promise<void> {
    const input = el<HTMLInputElement>(root, '#ipc-input');
    const exampleLabel = el<HTMLElement>(root, '#ipc-example-label');
    const exampleWrap = el<HTMLElement>(root, '#ipc-example-wrap');
    const singleWrap = el<HTMLElement>(root, '#ipc-single-wrap');
    const bulkWrap = el<HTMLElement>(root, '#ipc-bulk-wrap');
    const bulkInput = el<HTMLTextAreaElement>(root, '#ipc-bulk-input');
    const resultsBox = el<HTMLElement>(root, '#ipc-results');
    const summaryEl = el<HTMLElement>(root, '#ipc-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#ipc-share');
    const copyStatus = el<HTMLElement>(root, '#ipc-copy-status');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#ipc-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#ipc-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#ipc-snap-delete');
    if (
      !input ||
      !exampleLabel ||
      !exampleWrap ||
      !singleWrap ||
      !bulkWrap ||
      !bulkInput ||
      !resultsBox ||
      !summaryEl ||
      !shareBtn ||
      !copyStatus ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    let engine: EngineModule;
    let examples: Example[] = [];
    try {
      const [engineMod, examplesMod] = await Promise.all([
        import('../lib/ip-converter/engine'),
        import('../lib/ip-converter/examples'),
      ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
    } catch (err) {
      renderError(
        resultsBox,
        summaryEl,
        'The converter engine failed to load. Reload the page to try again.',
        true
      );
      console.error('[IpConverter] engine import failed:', err);
      return;
    }

    // The chips are already in the DOM (server-rendered from the same module),
    // so there is nothing to build — only to wire and to mark.
    const chips = Array.from(exampleWrap.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR));

    /**
     * Press one chip, or none for -1 — the chip equivalent of the old
     * "Custom input" option: hand-typed text, an `#ip=` deep link, a restored
     * last input or a snapshot belongs to no example.
     */
    const setActiveChip = (index: number): void => {
      syncChipsByIndex(exampleWrap, index >= 0 ? index : null);
    };

    /* ------------------------------------------------------------------ */
    /* Copy plumbing (row buttons, Copy link, bulk Copy all) — the kit     */
    /* helper: one delegated listener; outcomes in #ipc-copy-status.       */
    /* ------------------------------------------------------------------ */

    wireCopyButtons(root, { status: copyStatus });

    /* ------------------------------------------------------------------ */
    /* Single mode                                                          */
    /* ------------------------------------------------------------------ */

    function setErrorState(on: boolean): void {
      input!.classList.toggle('ipc-input--error', on);
      if (on) {
        input!.setAttribute('aria-invalid', 'true');
        input!.setAttribute('aria-describedby', 'ipc-input-hint ipc-error-detail');
      } else {
        input!.removeAttribute('aria-invalid');
        input!.setAttribute('aria-describedby', 'ipc-input-hint');
      }
    }

    let lastWrittenHash: string | null = null;

    function writeHash(value: string | null): void {
      const target = value ? buildIpHash(value) : '';
      if (target === lastWrittenHash) return;
      // Safari throttles replaceState (~100/30s) and throws — never let that break input.
      try {
        if (value) {
          history.replaceState(null, '', target);
        } else {
          history.replaceState(null, '', location.pathname + location.search);
        }
        lastWrittenHash = target;
      } catch {
        /* ignore */
      }
    }

    function hideShare(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
    }

    function evaluate(userInitiated: boolean): void {
      const value = input!.value.trim();
      if (value.length === 0) {
        setErrorState(false);
        hideShare();
        renderEmpty(resultsBox!, summaryEl!);
        if (userInitiated) writeHash(null);
        return;
      }
      const fail = (message: string): void => {
        setErrorState(true);
        hideShare();
        renderError(resultsBox!, summaryEl!, message);
        if (userInitiated) writeHash(null);
      };
      let result: Result | null = null;
      try {
        result = engine.convert(value);
      } catch {
        fail('Unexpected error while converting.');
        return;
      }
      if (!result || result.valid === false) {
        fail(result?.error ?? 'This is not a valid IP address.');
        return;
      }
      setErrorState(false);
      renderResult(resultsBox!, summaryEl!, result, value);
      shareBtn!.hidden = false;
      if (userInitiated) writeHash(value);
      if (userInitiated) recordToolLastInput('ip-address-converter', value);
      shareBtn!.dataset.copy =
        location.origin + location.pathname + location.search + buildIpHash(value);
    }

    /* ------------------------------------------------------------------ */
    /* Bulk mode                                                            */
    /* ------------------------------------------------------------------ */

    // Skip the rebuild when the normalized entry list is unchanged; reset on mode switch.
    let lastBulkEntriesKey: string | null = null;

    function evaluateBulk(): void {
      const entries = bulkInput!.value
        .split(/\r?\n/)
        .map((line) => line.trim())
        .filter((line) => line.length > 0 && !line.startsWith('#'));
      const entriesKey = entries.join('\n');
      if (entriesKey === lastBulkEntriesKey) return;
      lastBulkEntriesKey = entriesKey;
      if (!entries.length) {
        setSummary(summaryEl!, '', false);
        resultsBox!.innerHTML =
          '<p class="ipc-empty body-sm text-mute">Paste IPs — one per line. Blank lines and # comments are skipped.</p>';
        return;
      }

      const truncated = entries.length > MAX_BULK_LINES;
      const list = truncated ? entries.slice(0, MAX_BULK_LINES) : entries;
      let converted = 0;
      let failed = 0;
      const bodyHtml: string[] = [];
      const tsvLines = ['Input\tVersion\tCanonical\tInteger\tHexadecimal\tStatus'];

      for (const line of list) {
        let result: Result | null = null;
        try {
          result = engine.convert(line);
        } catch {
          result = null;
        }
        let version = '';
        let canonical = '';
        let integer = '';
        let hex = '';
        let status = '';
        const ok = Boolean(result && result.valid !== false);
        if (result && ok) {
          converted++;
          version = result.version === 6 ? 'IPv6' : 'IPv4';
          const rows = Array.isArray(result.rows) ? result.rows : [];
          const rowValue = (label: string): string =>
            rows.find((r) => r.label === label)?.value ?? '';
          canonical = result.version === 6 ? rowValue('Compressed') : rowValue('Dotted decimal');
          integer = rowValue('Integer (decimal)');
          hex = rowValue('Hexadecimal');
          const warnings = Array.isArray(result.warnings) ? result.warnings : [];
          status = warnings.length ? `OK — ${warnings.join('; ')}` : 'OK';
        } else {
          failed++;
          status = result?.error ?? 'Unexpected error while converting.';
        }
        tsvLines.push([line, version, canonical, integer, hex, status].join('\t'));
        const cell = (v: string, mono: boolean): string =>
          `<td class="${mono ? 'is-mono' : ''}">${v ? escapeHtml(v) : '—'}</td>`;
        bodyHtml.push(
          '<tr>' +
            cell(line, true) +
            cell(version, false) +
            cell(canonical, true) +
            cell(integer, true) +
            cell(hex, true) +
            `<td class="${ok ? 'ipc-bulk-status--ok' : 'ipc-bulk-status--fail'}">${escapeHtml(status)}</td>` +
            '</tr>'
        );
      }

      setSummary(summaryEl!, `${converted} converted, ${failed} failed`, false);

      const noteHtml = truncated
        ? `<p class="ipc-bulk-note">Only the first ${MAX_BULK_LINES} lines were converted — ${entries.length - MAX_BULK_LINES} more skipped.</p>`
        : '';
      const prevScrollLeft =
        resultsBox!.querySelector<HTMLElement>('.ipc-bulk-scroll')?.scrollLeft ?? 0;
      resultsBox!.innerHTML =
        noteHtml +
        '<div class="ipc-bulk-bar">' +
        // The kit's labelled copy recipe (CopyButton.astro's markup, built at
        // runtime because bulk results are client-only).
        '<button class="copy-btn copy-btn--labeled" type="button" data-copy="" data-copy-all data-copy-label="Copy all">' +
        COPY_ICON_SVG +
        CHECK_ICON_SVG +
        '<span class="copy-btn__label" data-copy-text>Copy all</span></button></div>' +
        '<div class="ipc-bulk-scroll"><table class="ipc-bulk-table">' +
        '<thead><tr><th>Input</th><th>Version</th><th>Canonical</th><th>Integer</th><th>Hexadecimal</th><th>Status</th></tr></thead>' +
        `<tbody>${bodyHtml.join('')}</tbody></table></div>`;
      // The delegated copy handler reads dataset.copy — set the raw TSV directly
      // instead of round-tripping tabs/newlines through the HTML attribute.
      const copyAllBtn = resultsBox!.querySelector<HTMLButtonElement>('.ipc-bulk-bar [data-copy-all]');
      if (copyAllBtn) copyAllBtn.dataset.copy = tsvLines.join('\n');
      const scrollBox = resultsBox!.querySelector<HTMLElement>('.ipc-bulk-scroll');
      if (scrollBox && prevScrollLeft) scrollBox.scrollLeft = prevScrollLeft;
    }

    /* ------------------------------------------------------------------ */
    /* Mode toggle                                                          */
    /* ------------------------------------------------------------------ */

    let mode: 'single' | 'bulk' = 'single';
    let timer: number | undefined;
    const modeBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.ipc-mode-btn'));

    function setMode(next: 'single' | 'bulk'): void {
      if (mode === next) return;
      mode = next;
      window.clearTimeout(timer);
      lastBulkEntriesKey = null;
      const bulk = next === 'bulk';
      modeBtns.forEach((b) => {
        const active = (b.dataset.mode === 'bulk') === bulk;
        b.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      exampleLabel!.hidden = bulk;
      exampleWrap!.hidden = bulk;
      singleWrap!.hidden = bulk;
      bulkWrap!.hidden = !bulk;
      if (bulk) {
        hideShare();
        // Carry the single value across the first time so nothing is lost.
        if (!bulkInput!.value.trim() && input!.value.trim()) bulkInput!.value = input!.value.trim();
        writeHash(null);
        evaluateBulk();
      } else {
        evaluate(false);
      }
    }

    modeBtns.forEach((b) => {
      b.addEventListener('click', () => setMode(b.dataset.mode === 'bulk' ? 'bulk' : 'single'));
    });

    /* ------------------------------------------------------------------ */
    /* Events                                                               */
    /* ------------------------------------------------------------------ */

    input.addEventListener('input', () => {
      setActiveChip(-1);
      window.clearTimeout(timer);
      timer = window.setTimeout(() => evaluate(true), DEBOUNCE_MS);
    });
    wireRunKeys(input, () => {
      window.clearTimeout(timer);
      evaluate(true);
    });
    // The bulk textarea is one address per line, so Enter must insert first.
    wireRunKeys(bulkInput, () => evaluateBulk(), { enter: 'insert-then-run' });
    bulkInput.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => evaluateBulk(), DEBOUNCE_MS);
    });
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        setActiveChip(idx);
        input.value = examples[idx].input;
        window.clearTimeout(timer);
        evaluate(true);
      });
    });

    wireSnapshotUI({
      slug: 'ip-address-converter',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => input!.value.trim(),
      setValue: (value) => {
        input!.value = value;
        setActiveChip(-1);
        if (mode !== 'single') setMode('single');
        window.clearTimeout(timer);
        evaluate(true);
      },
    });

    /* ------------------------------------------------------------------ */
    /* First load: user-typed value > #ip= deep link > restored last input */
    /* > seeded example. None of these write the hash — only user-         */
    /* initiated evaluations do.                                           */
    /* ------------------------------------------------------------------ */

    const hashValue = readIpHash();
    const restored = getRestoredLastInput('ip-address-converter');

    // The input ships pre-filled with the seed (its `value` attribute, i.e.
    // `defaultValue`), so "user typed before hydration" means it now differs.
    const typed = input.value.trim();
    if (typed && typed !== input.defaultValue.trim()) {
      setActiveChip(-1);
      evaluate(false);
    } else if (hashValue) {
      input.value = hashValue;
      setActiveChip(-1);
      evaluate(false);
    } else if (restored) {
      input.value = restored;
      setActiveChip(-1);
      evaluate(false);
    } else if (examples[0]) {
      input.value = examples[0].input;
      setActiveChip(0);
      evaluate(false);
    } else {
      setActiveChip(-1);
      renderEmpty(resultsBox, summaryEl);
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
