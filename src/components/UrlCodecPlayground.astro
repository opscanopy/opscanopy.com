---
/**
 * UrlCodecPlayground — the interactive URL Encoder / Decoder + Query-String
 * Parser island.
 *
 * A single textarea (no CodeMirror — the input is one line of URL, not a
 * document) under a three-way mode control:
 *
 *   Parse  (default) → WHATWG components card + a READ-ONLY parameter table,
 *                      each row showing the decoded value over its raw text.
 *   Decode           → percent-decoded text, with double-encoding detection and
 *                      a one-tap "Decode again".
 *   Encode           → percent-encoded text, per RFC 3986 component / full-URL
 *                      rules or `application/x-www-form-urlencoded`.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar, ResultPanel (figure cap, live summary, copy status)
 * and CopyButton; the results container stays here, seeded with `set:html` +
 * `data-results`, and its slab overrides anchor on `.uc-results`. Contract
 * as the CIDR checker / subnet calculator: server-rendered example chips, a
 * 180ms debounce with a 600ms calm-error hold, per-row copy + Copy all + Copy
 * link, one visible `role="status"` summary plus an sr-only copy status, no
 * `aria-live` on the results container, `escapeHtml()` on every injected value,
 * and 44px coarse-pointer targets for chips and per-row copy buttons (36px for
 * the labeled header controls, matching the reference exactly).
 *
 * DELIBERATE DEVIATION from the textarea half of the contract's Enter rule:
 * plain Enter here calls `preventDefault()` and commits instead of inserting a
 * newline. This tool's grammar is single-line, and a raw newline inside a URL is
 * a DIAGNOSED ERROR (the URL standard strips tab/CR/LF silently, so a browser
 * would parse a broken URL as if the break were not there). Letting Enter
 * manufacture that error would make the "run now" key produce a failure. Pasted
 * multi-line input still reaches the engine and still gets the diagnostic.
 *
 * Runtime contract (lazy-imported inside the boot closure so the engine
 * code-splits away from the page shell):
 *   ../lib/url-codec/engine → run(input, mode, opts) | paramLines(params)
 *   ../lib/url-codec/hash   → buildUrlCodecHash | readUrlCodecHash | MAX_HASH_LEN
 *
 * The HTML builders themselves are NOT lazy: they live in
 * `../lib/url-codec/render`, are imported by this frontmatter AND by the
 * `<script>`, and depend on nothing but `escapeHtml` — so the server-rendered
 * seed and every client repaint come from one implementation.
 */
import { examples } from '../lib/url-codec/examples';
import { run } from '../lib/url-codec/engine';
import { EMPTY_HTML, MODE_COPY, resultHtml } from '../lib/url-codec/render';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. `run()` is pure, synchronous, and reads no clock, key
 * or randomness, so the first example's components card and decoded parameter
 * table are computed at build time and land in the static HTML — which is all
 * an AI crawler (no JS) ever sees. The client re-runs the same example on boot
 * and repaints identical markup.
 *
 * `resultHtml` also returns the per-row copy payloads; the server ignores them
 * (they cannot ride in an attribute — see the render module's header) and the
 * client rebinds them after its own render.
 */
const seedExample = examples[0];
const seedResult = seedExample ? run(seedExample.input, seedExample.mode, {}) : null;
const seedOk = seedResult && seedResult.ok ? seedResult : null;
const seedHtml = seedOk ? resultHtml(seedOk).html : EMPTY_HTML;
const seedSummary = seedOk ? seedOk.summary : '';
const seedInput = seedOk && seedExample ? seedExample.input : '';
const seedMode = seedOk && seedExample ? seedExample.mode : 'parse';
const seedChrome = MODE_COPY[seedMode];
const chipItems = examples.map((ex) => ({ label: ex.label, input: ex.input, ariaLabel: `${ex.label} — ${ex.mode} mode` }));
---

<section class="uc-pg" aria-label="URL encoder, decoder and query-string parser playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: example chips ───────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow">Examples</span>
      <ExampleChips prefix="uc" items={chipItems} active={seedOk !== null ? 0 : null} ariaLabel="Examples" />
    </div>

    {/* ── Mode + per-mode options ──────────────────────────────────────── */}
    <div
      class="flex flex-col gap-3 border-b border-hairline px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-5"
    >
      <div class="flex min-w-0 flex-col gap-1">
        <span class="eyebrow">Mode</span>
        <div id="uc-mode" class="uc-seg" role="group" aria-label="Mode">
          {
            (
              [
                ['parse', 'Parse'],
                ['decode', 'Decode'],
                ['encode', 'Encode'],
              ] as const
            ).map(([value, label]) => (
              <button
                type="button"
                class="uc-seg__btn"
                aria-pressed={value === seedMode ? 'true' : 'false'}
                data-mode={value}
              >
                {label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="flex min-w-0 flex-col gap-1">
        <span class="eyebrow">Options</span>
        <div class="uc-opts">
          <label id="uc-plus-wrap" class="uc-check" for="uc-plus">
            <input id="uc-plus" type="checkbox" class="uc-check__box" autocomplete="off" />
            <span class="uc-check__text">
              <span class="uc-check__label">+ is a space</span>
              <span class="uc-check__gloss"
                >form-urlencoded — how HTML forms send data: a space travels as <code
                  class="code-mono">+</code
                >, not <code class="code-mono">%20</code>.</span
              >
            </span>
          </label>
          <label id="uc-form-wrap" class="uc-check" for="uc-form" hidden>
            <input id="uc-form" type="checkbox" class="uc-check__box" autocomplete="off" />
            <span class="uc-check__text">
              <span class="uc-check__label">Form body</span>
              <span class="uc-check__gloss">Space becomes <code class="code-mono">+</code>, matching URLSearchParams.</span>
            </span>
          </label>
          <label id="uc-scope-wrap" class="uc-check" for="uc-scope" hidden>
            <input id="uc-scope" type="checkbox" class="uc-check__box" autocomplete="off" />
            <span class="uc-check__text">
              <span class="uc-check__label">Whole URL</span>
              <span class="uc-check__gloss"
                >Keep <code class="code-mono">: / ? # &amp; =</code> unescaped, like <code
                  class="code-mono">encodeURI()</code
                >.</span
              >
            </span>
          </label>
        </div>
      </div>
    </div>

    {/* ── Input ───────────────────────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <label id="uc-input-label" class="eyebrow mb-2 block" for="uc-input">{seedChrome.label}</label>
      <textarea
        id="uc-input"
        class="uc-input code-mono"
        spellcheck="false"
        autocapitalize="off"
        autocorrect="off"
        autocomplete="off"
        enterkeyhint="done"
        rows="3"
        placeholder={seedChrome.placeholder}
        aria-describedby="uc-input-hint uc-run-hint">{seedInput}</textarea>
      <p id="uc-input-hint" class="uc-hint caption text-mute">
        Paste a full URL, a bare query string starting with <span class="code-mono">?</span>, or a
        form body like <span class="code-mono">a=1&amp;b=2</span>.
      </p>
      <RunHint id="uc-run-hint" />
      <SnapshotBar prefix="uc" />
    </div>

    {/* ── Results panel — the L2 instrument (dark in both themes) under its
        figure cap; the live summary reads out in the cap's actions slot. ── */}
    <ResultPanel slug="url-encoder-decoder" prefix="uc" summary={seedSummary} split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="uc-share" />
        <CopyButton kind="all" id="uc-copy-all" />
      </Fragment>
      {/* Seeded at build time so the components card and parameter table are
          in the static HTML; the client repaints the same markup on boot. */}
      <div id="uc-results" class="uc-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* ── Mode segmented control ──────────────────────────────────────────── */
  .uc-seg {
    display: inline-flex;
    padding: 2px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }
  .uc-seg__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 68px;
    height: var(--control-h-sm);
    padding: 0 12px;
    border: none;
    border-radius: var(--radius-xs);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-mute);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      color var(--dur-fast) var(--ease-brand),
      background-color var(--dur-fast) var(--ease-brand);
  }
  /* Pressed IS aria-pressed (as on the kit chips); hover is a different look. */
  .uc-seg__btn:hover:not([aria-pressed='true']) {
    color: var(--color-body);
    background: var(--color-canvas-soft-2);
  }
  .uc-seg__btn[aria-pressed='true'] {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
  }
  .uc-seg__btn:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  /* ── Option checkboxes (glossary caption under each label) ───────────── */
  .uc-opts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }
  .uc-check {
    display: inline-flex;
    align-items: flex-start;
    gap: 8px;
    max-width: 320px;
    cursor: pointer;
  }
  .uc-check__box {
    width: 16px;
    height: 16px;
    margin-top: 2px;
    flex: 0 0 auto;
    accent-color: var(--color-brand);
    cursor: pointer;
  }
  .uc-check__box:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
  .uc-check__text {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }
  .uc-check__label {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-body);
  }
  .uc-check__gloss {
    font-size: 12px;
    line-height: 16px;
    color: var(--color-mute);
    text-wrap: pretty;
  }
  .uc-check__gloss .code-mono {
    font-size: 11px;
  }

  /* ── Input ───────────────────────────────────────────────────────────── */
  .uc-input {
    width: 100%;
    min-height: 92px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 14px;
    line-height: 22px;
    resize: vertical;
    word-break: break-all;
    overflow-wrap: anywhere;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .uc-input::placeholder {
    color: var(--color-mute);
  }
  .uc-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .uc-input:focus {
    outline: none;
  }
  .uc-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .uc-input.uc-input--error {
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  .uc-input.uc-input--error:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-error);
  }
  .uc-hint {
    margin-top: 8px;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .uc-hint .code-mono {
    font-size: 12px;
  }

  .uc-results {
    min-height: 220px;
  }

  /* ── Runtime-injected blocks ─────────────────────────────────────────── */
  :global(.uc-block) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: uc-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.uc-block + .uc-block) {
    margin-top: 12px;
  }
  /* Block heading ("Components", "Parameters", "Decoded") — the
     group-heading role: sans 12/16 600 (global.css .result-panel__group-h),
     never one more mono caps label. */
  :global(.uc-block__head) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 12px 14px 10px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    color: var(--color-ink);
  }
  :global(.uc-block__actions) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  :global(.uc-block__sub) {
    padding: 8px 14px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 18px;
    font-weight: 400;
    color: var(--color-mute);
    text-wrap: pretty;
  }
  :global(.uc-meta) {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    color: var(--color-mute);
    white-space: nowrap;
  }

  /* ── Key / value rows (components + parameters) ──────────────────────── */
  :global(.uc-row) {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 12px;
    padding: 9px 14px;
    align-items: start;
  }
  @media (max-width: 559px) {
    :global(.uc-row) {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
  :global(.uc-row + .uc-row) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.uc-row__k) {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }
  :global(.uc-row__gloss),
  :global(.uc-row__raw) {
    display: block;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 16px;
    color: var(--color-mute);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  :global(.uc-row__raw) {
    font-family: var(--font-mono);
  }
  :global(.uc-row__v-wrap) {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    min-width: 0;
    margin: 0;
  }
  :global(.uc-row__v) {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-all;
    overflow-wrap: anywhere;
  }
  :global(.uc-row__v.is-quiet) {
    color: var(--color-mute);
    font-style: italic;
  }

  /* ── Badges ──────────────────────────────────────────────────────────── */
  :global(.uc-badges) {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-left: 6px;
    vertical-align: middle;
  }
  :global(.uc-badge) {
    display: inline-flex;
    align-items: center;
    padding: 0 6px;
    border-radius: var(--radius-xs);
    @apply label-field;
    background: var(--color-hairline);
    color: var(--color-body);
    white-space: nowrap;
  }
  :global(.uc-badge--warn) {
    background: var(--color-warning-soft);
    color: var(--color-warning-deep);
  }
  :global(.uc-badge--ok) {
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
  }

  /* ── Single-value output card (Decode / Encode) ──────────────────────── */
  :global(.uc-out) {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
  }
  :global(.uc-out__value) {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 22px;
    color: var(--color-ink);
    white-space: pre-wrap;
    word-break: break-all;
    overflow-wrap: anywhere;
  }
  :global(.uc-out__value.is-quiet) {
    color: var(--color-mute);
    font-style: italic;
  }
  :global(.uc-again) {
    display: inline-flex;
    align-items: center;
    margin: 0 14px 12px;
    padding: 4px 12px;
    border: none;
    border-radius: var(--radius-pill);
    background: var(--color-brand-soft);
    box-shadow: inset 0 0 0 1px var(--color-brand);
    color: var(--color-brand-strong);
    font-size: 12px;
    line-height: 18px;
    cursor: pointer;
  }
  :global(.uc-again:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }

  /* ── Notes (errors, warnings, infos) ────────────────────────────────── */
  :global(.uc-note) {
    display: flex;
    gap: 10px;
    padding: 10px 14px;
    font-size: 13px;
    line-height: 19px;
    text-wrap: pretty;
  }
  :global(.uc-note + .uc-note) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.uc-note__icon) {
    flex: 0 0 auto;
    width: 15px;
    height: 15px;
    margin-top: 2px;
  }
  :global(.uc-note--warning) {
    color: var(--color-warning-deep);
    background: var(--color-warning-soft);
  }
  :global(.uc-note--info) {
    color: var(--color-body);
  }
  :global(.uc-note__where) {
    display: block;
    margin-top: 1px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    color: var(--color-mute);
  }

  :global(.uc-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.uc-error + .uc-block) {
    margin-top: 12px;
  }
  :global(.uc-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.uc-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.uc-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 19px;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  :global(.uc-error__more) {
    margin-top: 4px;
    font-size: 13px;
    line-height: 18px;
    opacity: 0.9;
  }
  :global(.uc-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }
  :global(.uc-none) {
    padding: 10px 14px;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-mute);
  }

  /* ── Copy buttons: icon per row, labeled in the header ───────────────── */
  :global(.uc-copy) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-brand),
      background-color var(--dur-fast) var(--ease-brand);
  }
  :global(.uc-copy:hover) {
    color: var(--color-brand-strong);
    background: var(--color-hairline);
  }
  :global(.uc-copy:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  :global(.uc-copy[data-copied]) {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
  }

  /* Coarse pointers: every control in the result and the mode switch is a
     44px target (the kit sizes its own chips and copy buttons). */
  @media (pointer: coarse) {
    :global(.uc-copy) {
      width: var(--control-h-lg);
      height: var(--control-h-lg);
    }
    :global(.uc-again) {
      min-height: var(--control-h-lg);
    }
    .uc-seg__btn {
      min-height: var(--control-h-lg);
    }
  }

  @keyframes uc-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.uc-block) {
      animation: none;
    }
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below it uses the slab ink tier; the light rules
     above remain the documented defaults. ──────────────────────────────── */
  .uc-results :global(.uc-empty),
  .uc-results :global(.uc-block) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .uc-results :global(.uc-empty) {
    color: var(--color-inverse-mute);
  }
  .uc-results :global(.uc-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .uc-results :global(.uc-block__head),
  .uc-results :global(.uc-block__sub),
  .uc-results :global(.uc-row + .uc-row),
  .uc-results :global(.uc-note + .uc-note) {
    border-color: #ffffff12;
  }
  .uc-results :global(.uc-block__head),
  .uc-results :global(.uc-row__k),
  .uc-results :global(.uc-row__v),
  .uc-results :global(.uc-out__value),
  .uc-results :global(.uc-note--info) {
    color: var(--color-inverse-fg);
  }
  .uc-results :global(.uc-block__sub),
  .uc-results :global(.uc-meta),
  .uc-results :global(.uc-row__gloss),
  .uc-results :global(.uc-row__raw),
  .uc-results :global(.uc-row__v.is-quiet),
  .uc-results :global(.uc-out__value.is-quiet),
  .uc-results :global(.uc-note__where),
  .uc-results :global(.uc-none) {
    color: var(--color-inverse-mute);
  }
  .uc-results :global(.uc-badge) {
    background: #ffffff14;
    color: var(--color-inverse-fg);
  }
  .uc-results :global(.uc-badge--warn) {
    background: #e0a45814;
    color: var(--color-inverse-accent);
  }
  .uc-results :global(.uc-badge--ok) {
    background: #8fc97a1f;
    color: var(--color-inverse-brand);
  }
  .uc-results :global(.uc-note--warning) {
    background: #e0a45814;
    color: var(--color-inverse-accent);
  }
  .uc-results :global(.uc-again) {
    background: #8fc97a1f;
    box-shadow: inset 0 0 0 1px var(--color-inverse-brand);
    color: var(--color-inverse-brand);
  }
  .uc-results :global(.uc-copy) {
    color: var(--color-inverse-mute);
  }
  .uc-results :global(.uc-copy:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .uc-results :global(.uc-copy[data-copied]) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
</style>

<script>
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChips, clearChips, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  // The pure HTML builders, shared with this component's frontmatter so the
  // server-rendered seed and every client repaint come from one implementation.
  import {
    EMPTY_HTML,
    LOAD_ERROR_HTML,
    MODE_COPY,
    TYPING_HTML,
    copyAllText,
    invalidHtml,
    resultHtml,
  } from '../lib/url-codec/render';
  // Result shapes are imported, never hand-mirrored: a hand-copied type that
  // drifts from the engine is a documented past bug on this site.
  import type { QueryParam, RunOptions, RunResult, UrlCodecMode as Mode } from '../lib/url-codec/types';
  import { examples } from '../lib/url-codec/examples';
  import { wireRunKeys } from '../lib/run-keys';

  /* ---- Engine contract ------------------------------------------------------
     What stays here is the shape of the LAZY module handles, which have no
     engine counterpart. */
  type EngineModule = {
    run: (input: string, mode: Mode, opts: RunOptions) => RunResult;
    paramLines: (params: QueryParam[]) => string;
  };
  type HashModule = {
    buildUrlCodecHash: (input: string, mode: Mode) => string;
    readUrlCodecHash: () => { input: string; mode: Mode } | null;
    MAX_HASH_LEN: number;
  };

  const ROOT_SEL = '.uc-pg';
  const SLUG = 'url-encoder-decoder';
  const DEBOUNCE_MS = 180;
  const ERROR_HOLD_MS = 600;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.ucWired === 'true') return;
      root.dataset.ucWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  async function init(root: HTMLElement): Promise<void> {
    const input = el<HTMLTextAreaElement>(root, '#uc-input');
    const inputLabel = el<HTMLElement>(root, '#uc-input-label');
    const resultsBox = el<HTMLElement>(root, '#uc-results');
    const summaryEl = el<HTMLElement>(root, '#uc-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#uc-share');
    const copyAllBtn = el<HTMLButtonElement>(root, '#uc-copy-all');
    const copyStatus = el<HTMLElement>(root, '#uc-copy-status');
    const modeGroup = el<HTMLElement>(root, '#uc-mode');
    const plusBox = el<HTMLInputElement>(root, '#uc-plus');
    const plusWrap = el<HTMLElement>(root, '#uc-plus-wrap');
    const formBox = el<HTMLInputElement>(root, '#uc-form');
    const formWrap = el<HTMLElement>(root, '#uc-form-wrap');
    const scopeBox = el<HTMLInputElement>(root, '#uc-scope');
    const scopeWrap = el<HTMLElement>(root, '#uc-scope-wrap');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#uc-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#uc-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#uc-snap-delete');
    const chipsWrap = el<HTMLElement>(root, '#uc-chips');
    const chips = Array.from(chipsWrap?.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR) ?? []);
    if (
      !input ||
      !inputLabel ||
      !resultsBox ||
      !summaryEl ||
      !shareBtn ||
      !copyAllBtn ||
      !copyStatus ||
      !modeGroup ||
      !plusBox ||
      !plusWrap ||
      !formBox ||
      !formWrap ||
      !scopeBox ||
      !scopeWrap ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    )
      return;

    // The kit chips carry `data-input`; each example's mode comes from the same
    // examples module the frontmatter rendered them from (index-aligned).
    const chipModes: Mode[] = examples.map((ex) => ex.mode);

    const modeBtns = Array.from(modeGroup.querySelectorAll<HTMLButtonElement>('button[data-mode]'));

    /* ------------------------------------------------------------------ */
    /* Copy plumbing                                                       */
    /* ------------------------------------------------------------------ */

    // Payloads come back from the builders as an array, never through a
    // server-rendered attribute: decoded values can contain newlines and
    // quotes, which do not round-trip through HTML. paint() binds them onto
    // the live buttons' `data-copy`.
    let payloads: string[] = [];

    // Copy buttons (row, Copy all, Copy link) — the kit helper: one delegated
    // listener; outcomes announced in #uc-copy-status.
    wireCopyButtons(root, { status: copyStatus });

    /* ------------------------------------------------------------------ */
    /* Rendering — every builder lives in ../lib/url-codec/render, which    */
    /* the frontmatter uses for the server-rendered seed.                  */
    /* ------------------------------------------------------------------ */

    function setSummary(text: string, isError: boolean): void {
      summaryEl!.textContent = text;
      summaryEl!.classList.toggle('text-inverse-error', isError);
      summaryEl!.classList.toggle('text-inverse-mute', !isError);
    }

    function renderEmpty(): void {
      setSummary('', false);
      payloads = [];
      resultsBox!.innerHTML = EMPTY_HTML;
    }

    /**
     * Write a rendered panel, then adopt its copy payloads. The builders return
     * the payload array instead of pushing into a closure, so the frontmatter
     * can call exactly the same function and simply drop them.
     */
    function paint(rendered: { html: string; payloads: string[] }): void {
      resultsBox!.innerHTML = rendered.html;
      payloads = rendered.payloads;
      resultsBox!.querySelectorAll<HTMLButtonElement>('[data-copy-ref]').forEach((btn) => {
        btn.dataset.copy = payloads[Number(btn.dataset.copyRef)] ?? '';
      });
    }

    /* ------------------------------------------------------------------ */
    /* Engine                                                              */
    /* ------------------------------------------------------------------ */

    let engine: EngineModule;
    let hashLib: HashModule;
    try {
      const [engineMod, hashMod] = await Promise.all([
        import('../lib/url-codec/engine'),
        import('../lib/url-codec/hash'),
      ]);
      engine = engineMod as unknown as EngineModule;
      hashLib = hashMod as unknown as HashModule;
    } catch (err) {
      setSummary('', true);
      resultsBox.innerHTML = LOAD_ERROR_HTML;
      console.error('[UrlCodec] engine import failed:', err);
      return;
    }

    /* ------------------------------------------------------------------ */
    /* State machine: EMPTY | VALID | PENDING | INVALID                    */
    /* ------------------------------------------------------------------ */

    type State = 'empty' | 'valid' | 'pending' | 'invalid';
    let state: State = 'empty';
    // Seeded from the server-rendered segmented control, so the client's idea of
    // the mode is the one the static HTML already shows.
    const seededMode = modeGroup.querySelector<HTMLButtonElement>('button[aria-pressed="true"]')?.dataset
      .mode;
    let mode: Mode =
      seededMode === 'decode' || seededMode === 'encode' || seededMode === 'parse'
        ? seededMode
        : 'parse';
    /** The last decoded output, so "Decode again" has something to feed back. */
    let lastOutput = '';
    let plusTouched = false;
    /** Previous input value, so one `input` event's delta can be measured. */
    let prevValue = input.value;
    let evalTimer: number | undefined;
    let errTimer: number | undefined;
    let lastWrittenHash: string | null = null;

    function clearTimers(): void {
      window.clearTimeout(evalTimer);
      window.clearTimeout(errTimer);
    }

    function options(): RunOptions {
      if (mode === 'encode') {
        return { form: formBox!.checked, scope: scopeBox!.checked ? 'full-url' : 'component' };
      }
      return { plusAsSpace: plusTouched ? plusBox!.checked : 'auto' };
    }

    function syncModeUi(): void {
      modeBtns.forEach((btn) => {
        btn.setAttribute('aria-pressed', btn.dataset.mode === mode ? 'true' : 'false');
      });
      inputLabel!.textContent = MODE_COPY[mode].label;
      input!.placeholder = MODE_COPY[mode].placeholder;
      plusWrap!.hidden = mode === 'encode';
      formWrap!.hidden = mode !== 'encode';
      scopeWrap!.hidden = mode !== 'encode';
      // "Whole URL" is meaningless once the form serializer is in charge.
      scopeBox!.disabled = mode === 'encode' && formBox!.checked;
    }

    function setErrorState(on: boolean): void {
      input!.classList.toggle('uc-input--error', on);
      if (on) {
        input!.setAttribute('aria-invalid', 'true');
        input!.setAttribute('aria-describedby', 'uc-input-hint uc-run-hint uc-error-detail');
      } else {
        input!.removeAttribute('aria-invalid');
        input!.setAttribute('aria-describedby', 'uc-input-hint uc-run-hint');
      }
    }

    function hideActions(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
      copyAllBtn!.hidden = true;
      copyAllBtn!.dataset.copy = '';
    }

    function writeHash(value: string | null): void {
      const target = value ? hashLib.buildUrlCodecHash(value, mode) : '';
      if (target === lastWrittenHash) return;
      // Safari throttles replaceState (~100/30s) and throws — never let that
      // break typing.
      try {
        if (value) history.replaceState(null, '', target);
        else history.replaceState(null, '', location.pathname + location.search);
        lastWrittenHash = target;
      } catch {
        /* ignore */
      }
    }

    /** Press the chip whose example is exactly the current text in the current mode. */
    function syncExampleChips(): void {
      const value = input!.value;
      syncChips(
        chipsWrap,
        (chip, i) => (chip.getAttribute('data-input') ?? '') === value && chipModes[i] === mode,
      );
    }

    // `userInitiated` gates the history write. Seeding must leave the address bar alone: a
    // shared `#in=` whose payload is invalid still has to survive in the bar so the recipient
    // can see, edit and re-share it. (CidrCheckerPlayground guards every writeHash(null) the
    // same way; SubnetCalculatorPlayground does not — this ported the wrong one.)
    function toEmpty(userInitiated: boolean): void {
      state = 'empty';
      clearTimers();
      setErrorState(false);
      hideActions();
      renderEmpty();
      clearChips(chipsWrap);
      if (userInitiated) writeHash(null);
    }

    function showError(result: RunResult, isAlert: boolean, userInitiated: boolean): void {
      state = 'invalid';
      clearTimers();
      setErrorState(true);
      hideActions();
      setSummary(result.summary, true);
      paint(invalidHtml(result, isAlert));
      clearChips(chipsWrap);
      if (userInitiated) writeHash(null);
    }

    function renderValid(result: RunResult): void {
      lastOutput = result.mode === 'parse' ? '' : result.output;
      paint(resultHtml(result));
    }

    function evaluate(source: 'type' | 'bulk' | 'commit' | 'seed'): void {
      clearTimers();
      const value = input!.value;
      prevValue = value;
      if (value.trim().length === 0) {
        toEmpty(source !== 'seed');
        return;
      }

      const result = engine.run(value, mode, options());

      // Keep the untouched "+ is a space" checkbox honest about what auto chose.
      if (!plusTouched && result.mode !== 'encode') {
        plusBox!.checked = result.plusAsSpace === true;
      }

      if (result.ok) {
        state = 'valid';
        setErrorState(false);
        setSummary(result.summary, false);
        renderValid(result);
        const all = copyAllText(result, engine.paramLines);
        copyAllBtn!.hidden = all.length === 0;
        copyAllBtn!.dataset.copy = all;
        const hash = hashLib.buildUrlCodecHash(value, mode);
        if (hash.length > hashLib.MAX_HASH_LEN) {
          shareBtn!.hidden = true;
          shareBtn!.dataset.copy = '';
        } else {
          shareBtn!.hidden = false;
          shareBtn!.dataset.copy =
            location.origin + location.pathname + location.search + hash;
          if (source !== 'seed') writeHash(value);
        }
        if (source !== 'seed') recordToolLastInput(SLUG, value);
        syncExampleChips();
        return;
      }

      if (source !== 'type') {
        showError(result, source === 'commit', source !== 'seed');
        return;
      }

      // Mid-typing: hold the previous card, no red border yet. And do not even
      // start the hold while the value still looks unfinished — a half-typed
      // escape (`%2`) or a trailing separator is not a mistake, it is a person
      // still typing.
      // Hold the previous VALID card, but never a previous error card: leaving one up while the
      // border, aria-invalid and status line are all cleared produced an incoherent state — a
      // visible error message with nothing flagged and an empty status.
      const wasInvalid = state === 'invalid';
      state = 'pending';
      setErrorState(false);
      hideActions();
      setSummary('', false);
      if (wasInvalid) {
        payloads = [];
        resultsBox!.innerHTML = TYPING_HTML;
      }
      if (!/[%:/&=?]$|%[0-9A-Fa-f]$/.test(value)) {
        errTimer = window.setTimeout(() => showError(result, false, true), ERROR_HOLD_MS);
      } else if (!wasInvalid) {
        // Unfinished input: never leave the previous input's output up as if it were the answer.
        payloads = [];
        resultsBox!.innerHTML = TYPING_HTML;
      }
    }

    /* ------------------------------------------------------------------ */
    /* Events                                                              */
    /* ------------------------------------------------------------------ */

    root.addEventListener('click', (evt) => {
      const target = evt.target as HTMLElement;
      const again = target.closest<HTMLButtonElement>('[data-again]');
      if (again && resultsBox!.contains(again)) {
        // Feed the once-decoded text back in — the fix for a %2520-style value
        // that was percent-encoded twice on the way here.
        if (lastOutput.length === 0) return;
        input!.value = lastOutput;
        evaluate('commit');
        return;
      }
    });

    input.addEventListener('input', (e) => {
      clearTimers();
      const value = input.value;
      // Only a value that GREW by more than one character is a paste/autofill. The original
      // check used Math.abs(), so deleting a selection or backspacing a chunk took the
      // immediate path too — and a backspace over a selection is composition, not a paste.
      // That flashed a red border and an error card mid-edit, which the contract forbids.
      // Deletions and IME composition debounce like typing.
      const grew = value.length - prevValue.length > 1;
      const composing = (e as InputEvent).isComposing === true;
      prevValue = value;
      if (value.trim().length === 0) {
        toEmpty(true);
        return;
      }
      // A single `input` event that added more than one character is not composition — it is a
      // paste, an autofill, or a wholesale replacement. Nobody types 40 characters in one
      // keystroke, so there is nothing for the debounce or the calm-error hold to protect:
      // answer immediately.
      if (grew && !composing) {
        evaluate('bulk');
        return;
      }
      evalTimer = window.setTimeout(() => evaluate('type'), DEBOUNCE_MS);
    });

    // See the DEVIATION note in this file's header: a URL is single-line, and
    // a raw newline is a diagnosed error — plain Enter commits (no newline)
    // instead of manufacturing one. ⌘/Ctrl+Enter runs too, and both release
    // a touch keyboard.
    wireRunKeys(input, () => evaluate('commit'), { enter: 'run' });

    input.addEventListener('blur', () => {
      if (state === 'pending') evaluate('commit');
    });

    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.mode;
        if (next !== 'parse' && next !== 'decode' && next !== 'encode') return;
        if (next === mode) return;
        mode = next;
        // A new mode means a new deep link even for the same text.
        lastWrittenHash = null;
        syncModeUi();
        evaluate('commit');
      });
    });

    plusBox.addEventListener('change', () => {
      plusTouched = true;
      evaluate('commit');
    });
    formBox.addEventListener('change', () => {
      syncModeUi();
      evaluate('commit');
    });
    scopeBox.addEventListener('change', () => evaluate('commit'));

    chips.forEach((chip, i) => {
      chip.addEventListener('click', () => {
        const next = chipModes[i];
        input!.value = chip.dataset.input ?? '';
        if (next === 'parse' || next === 'decode' || next === 'encode') mode = next;
        // Chips always mean "the default options for this mode".
        plusTouched = false;
        formBox!.checked = false;
        scopeBox!.checked = false;
        lastWrittenHash = null;
        syncModeUi();
        evaluate('commit');
      });
    });

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => input!.value,
      setValue: (value) => {
        input!.value = value;
        evaluate('commit');
      },
    });

    /* ------------------------------------------------------------------ */
    /* First load: typed value → #in= deep link → restored last input →    */
    /* first example. Seeding never writes the hash, never records the last */
    /* input, and never fires the amber tick — only user actions do.        */
    /* ------------------------------------------------------------------ */

    syncModeUi();
    const shared = hashLib.readUrlCodecHash();
    const restored = getRestoredLastInput(SLUG);

    // Typed-before-hydration wins, but the textarea is SERVER-SEEDED with
    // examples[0] — compare against `defaultValue` (the seeded text), because a
    // bare non-emptiness test always wins once the server fills it in, which
    // silently kills the #in= deep link and the restored last input.
    if (input.value.trim() && input.value !== input.defaultValue) {
      evaluate('seed');
    } else if (shared) {
      input.value = shared.input;
      mode = shared.mode;
      syncModeUi();
      evaluate('seed');
    } else if (restored) {
      input.value = restored;
      evaluate('seed');
    } else if (chips[0]) {
      input.value = chips[0].dataset.input ?? '';
      const seedMode = chipModes[0];
      if (seedMode === 'parse' || seedMode === 'decode' || seedMode === 'encode') mode = seedMode;
      syncModeUi();
      evaluate('seed');
    } else {
      renderEmpty();
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
