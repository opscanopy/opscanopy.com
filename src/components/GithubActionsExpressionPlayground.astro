---
/**
 * GithubActionsExpressionPlayground — the interactive two-tab island for the
 * GitHub Actions Expression & Trigger Tester.
 *
 * No framework. A server-rendered shell hydrated by one module <script> that
 * lazily boots CodeMirror 6 editors and the engine. Two WAI-ARIA tabs:
 *   • Expression evaluator — evaluate a ${{ }} / if: against an editable mock
 *     context, with GitHub's exact semantics and the always-true footgun warning.
 *   • Trigger simulator — describe an event and see per-job RUNS / SKIPPED.
 * Both evaluate live on a debounce; "Run now" and ⌘/Ctrl + Enter run at once.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * EditorPane (the editor slabs), RunHint, SnapshotBar (on paper, shared by
 * both tabs), ResultPanel (one per tab: figure cap, live summary, copy
 * status) and CopyButton. Tab 1's results container stays here, seeded with
 * `set:html` + `data-results`; the slab overrides anchor on `.ga-results`.
 *
 * Runtime contract (imported lazily in the script):
 *   ../lib/github-actions-expression-tester/engine →
 *     evaluateIfCondition(raw, ctx), simulateTriggers(yaml, event),
 *     defaultContext(), parseContext(json), GHA_SEMANTICS_VERSION
 *   ../lib/github-actions-expression-tester/examples →
 *     expressionExamples[], triggerExamples[]
 *
 * Show/hide is driven by a `ga-panel--active` class (never the hidden
 * attribute) so CodeMirror can re-measure on tab switch. The CM keymap binds
 * Escape→blur (Tab-trap fix, per CLAUDE.md).
 */
// Build-time import of the same `examples` the client script loads lazily. Used
// to server-render the two example-chip groups (ExampleChips), so the static
// HTML carries real example names. Hydration only attaches click handlers and
// moves the pressed state — so this adds nothing to the client bundle.
import {
  expressionExamples as prerenderedExpressionExamples,
  triggerExamples as prerenderedTriggerExamples,
} from '../lib/github-actions-expression-tester/examples';

import { defaultContext, evaluateIfCondition } from '../lib/github-actions-expression-tester/engine';
import { exprResultHtml, exprSummaryText, EXPR_EMPTY_HTML } from '../lib/github-actions-expression-tester/render';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

const exprToken = '${{ }}'; // kept out of the Astro `{}` expression parser

/**
 * Server-rendered seed for TAB 1 only (the `if:` evaluator). `defaultContext()`
 * is a frozen literal and `evaluateIfCondition` is pure, so the verdict, the
 * returned value and the token breakdown are all deterministic and land in the
 * static HTML — which is all an AI crawler (no JS) ever sees. The client
 * re-evaluates the same example on boot and repaints the identical markup.
 *
 * Tab 2 (the trigger simulator) stays client-only: it is behind an inactive
 * tab panel, so a crawler gains nothing from it.
 *
 * The expression and the context go into `<pre data-cm-fallback>` elements
 * inside the CodeMirror hosts; CM appends its editor to the host, so `init`
 * removes them once mounted.
 */
const seedExprExample = prerenderedExpressionExamples[0];
const seedCtxJson = JSON.stringify(defaultContext(), null, 2);
const seedExprResult = seedExprExample
  ? evaluateIfCondition(seedExprExample.expression, defaultContext())
  : null;
const seedExprHtml = seedExprResult ? exprResultHtml(seedExprResult) : EXPR_EMPTY_HTML;
const seedExprSummary = seedExprResult ? exprSummaryText(seedExprResult) : '';
const exprChipItems = prerenderedExpressionExamples.map((ex) => ({ label: ex.label }));
const trigChipItems = prerenderedTriggerExamples.map((ex) => ({ label: ex.label }));
---

<section class="ga-pg" aria-label="GitHub Actions expression and trigger playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Tab bar ──────────────────────────────────────────────────────── */}
    <div class="ga-tabs flex gap-1 border-b border-hairline px-3 py-2 sm:px-4" role="tablist" aria-label="Tool mode">
      <button
        id="ga-tab-expr"
        class="ga-tab"
        role="tab"
        type="button"
        aria-selected="true"
        aria-controls="ga-panel-expr"
      >
        <span aria-hidden="true" class="ga-tab-glyph code-mono">{exprToken}</span>
        Expression evaluator
      </button>
      <button
        id="ga-tab-trig"
        class="ga-tab"
        role="tab"
        type="button"
        aria-selected="false"
        aria-controls="ga-panel-trig"
        tabindex="-1"
      >
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 4.5h12M2 8h12M2 11.5h7"></path>
        </svg>
        Trigger simulator
      </button>
    </div>

    {/* ═══════════════ TAB 1 — EXPRESSION EVALUATOR ═══════════════ */}
    <div id="ga-panel-expr" class="ga-panel ga-panel--active" role="tabpanel" aria-labelledby="ga-tab-expr">
      {/* Toolbar */}
      <div class="flex flex-col gap-3 border-b border-hairline px-4 py-3 sm:flex-row sm:items-end sm:justify-between sm:px-5">
        <div class="flex min-w-0 flex-col gap-2">
          <span class="eyebrow shrink-0">Examples</span>
          {/* Chip 0 is the seed; a #s= deep link or a restored input clears it. */}
          <ExampleChips prefix="ga-expr" items={exprChipItems} active={seedExprExample ? 0 : null} ariaLabel="Examples" />
        </div>
        <button
          id="ga-eval"
          type="button"
          class="btn-tool ga-tap"
          title="Run now (⌘/Ctrl + Enter)"
          aria-keyshortcuts="Meta+Enter Control+Enter"
        >
          Run now
        </button>
      </div>

      {/* Editors: expression + context (side-by-side on lg) */}
      <div class="border-b border-hairline px-4 py-4 sm:px-5">
        <div class="ga-grid ga-grid--expr">
          <EditorPane prefix="ga" id="ga-expr-editor" label="if-condition">
            <pre class="editor-pane__fallback code-mono" data-cm-fallback>{seedExprExample?.expression}</pre>
          </EditorPane>
          <EditorPane prefix="ga" id="ga-ctx-editor" label="context (editable mock)">
            <Fragment slot="actions">
              <button type="button" class="chip ga-preset" data-preset="push">push</button>
              <button type="button" class="chip ga-preset" data-preset="pull_request">pull_request</button>
              <button type="button" class="chip ga-preset" data-preset="tag">tag</button>
            </Fragment>
            <pre class="editor-pane__fallback code-mono" data-cm-fallback>{seedCtxJson}</pre>
          </EditorPane>
        </div>
        <RunHint variant="cm" class="mt-2" />
      </div>

      {/* Result */}
      <ResultPanel slug="github-actions-expression-tester" prefix="ga-expr" summary={seedExprSummary} summaryClass="whitespace-nowrap" split>
        <Fragment slot="actions">
          <CopyButton kind="link" id="ga-share-expr" />
        </Fragment>
        {/* Seeded at build time (see `seedExprHtml` above) so the verdict and the
            token breakdown are in the static HTML; the script repaints this node. */}
        <div id="ga-expr-results" class="ga-results" set:html={seedExprHtml} data-results></div>
      </ResultPanel>
    </div>

    {/* ═══════════════ TAB 2 — TRIGGER SIMULATOR ═══════════════ */}
    <div id="ga-panel-trig" class="ga-panel" role="tabpanel" aria-labelledby="ga-tab-trig">
      <div class="flex flex-col gap-3 border-b border-hairline px-4 py-3 sm:flex-row sm:items-end sm:justify-between sm:px-5">
        <div class="flex min-w-0 flex-col gap-2">
          <span class="eyebrow shrink-0">Examples</span>
          <ExampleChips prefix="ga-trig" items={trigChipItems} active={prerenderedTriggerExamples.length ? 0 : null} ariaLabel="Examples" />
        </div>
        <button
          id="ga-sim"
          type="button"
          class="btn-tool ga-tap"
          title="Run now (⌘/Ctrl + Enter)"
          aria-keyshortcuts="Meta+Enter Control+Enter"
        >
          Run now
        </button>
      </div>

      <div class="border-b border-hairline px-4 py-4 sm:px-5">
        <div class="ga-grid ga-grid--trig">
          <EditorPane prefix="ga" id="ga-wf-editor" label=".github/workflows/ci.yml" />

          {/* Event scenario builder (on paper) */}
          <div class="flex min-w-0 flex-col gap-3">
            <span class="eyebrow">Event scenario</span>
            <label class="ga-field">
              <span class="ga-field-label">Event</span>
              <div class="ga-select-wrap relative">
                <select id="ga-ev-event" class="ga-select code-mono w-full">
                  <option value="push">push</option>
                  <option value="pull_request">pull_request</option>
                  <option value="pull_request_target">pull_request_target</option>
                  <option value="tag">push (tag)</option>
                </select>
                <svg class="ga-caret pointer-events-none absolute top-1/2 right-3 h-4 w-4 -translate-y-1/2 text-mute" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4"></path></svg>
              </div>
            </label>
            <label class="ga-field" id="ga-field-branch">
              <span class="ga-field-label">Branch</span>
              <input id="ga-ev-branch" type="text" class="ga-input code-mono input-focus" value="main" autocomplete="off" spellcheck="false" />
            </label>
            <label class="ga-field hidden" id="ga-field-tag">
              <span class="ga-field-label">Tag</span>
              <input id="ga-ev-tag" type="text" class="ga-input code-mono input-focus" value="v1.0.0" autocomplete="off" spellcheck="false" />
            </label>
            <label class="ga-field">
              <span class="ga-field-label">Changed files <span class="text-mute">(one per line)</span></span>
              <textarea id="ga-ev-files" class="ga-input ga-textarea code-mono input-focus" rows="4" spellcheck="false" placeholder="src/app.ts&#10;docs/readme.md"></textarea>
            </label>
          </div>
        </div>
        <RunHint variant="cm" class="mt-2" />
      </div>

      <ResultPanel slug="github-actions-expression-tester" prefix="ga-trig" label="Decision" summaryClass="whitespace-nowrap" split>
        <Fragment slot="actions">
          <CopyButton kind="link" id="ga-share-trig" />
        </Fragment>
        <div id="ga-trig-results" class="ga-results">
          <p class="ga-empty body-sm">Load an example or paste a workflow, set an event, then Simulate to see which jobs run or are skipped — and why.</p>
        </div>
      </ResultPanel>
    </div>

    {/* Snapshot row — on paper, applies to whichever tab (expr / trig) is active. */}
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-hairline px-4 pb-3 sm:px-5">
      <SnapshotBar prefix="ga" />
      <span id="ga-version" class="caption text-mute code-mono mt-3"></span>
    </div>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .ga-tap { touch-action: manipulation; }

  /* Tabs */
  .ga-tab {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 9px 14px; border-radius: var(--radius-sm);
    font-size: 14px; font-weight: 500; color: var(--color-mute);
    background: transparent; cursor: pointer; touch-action: manipulation;
    transition: color var(--dur-fast) var(--ease-brand), background-color var(--dur-fast) var(--ease-brand);
    min-height: var(--control-h-lg);
  }
  .ga-tab:hover { color: var(--color-ink); background: var(--color-canvas-soft-2); }
  .ga-tab[aria-selected='true'] { color: var(--color-ink); background: var(--color-canvas-soft-2); box-shadow: var(--shadow-hairline); }
  .ga-tab:focus-visible { outline: 2px solid var(--color-link); outline-offset: 2px; }
  .ga-tab-glyph { font-size: 12px; opacity: .8; }

  /* Panels — class-driven so CodeMirror can re-measure on activate. */
  .ga-panel { display: none; }
  .ga-panel.ga-panel--active { display: block; }

  /* Editor grids: expression | context, workflow | scenario (from 1024px). */
  .ga-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  @media (min-width: 1024px) {
    .ga-grid--expr { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ga-grid--trig { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); }
  }

  /* Select + inputs */
  .ga-select {
    /* `width: 100%` is load-bearing, not cosmetic: without it a select sizes to
       its longest option text, and a long option pushed past the viewport at
       390px. With width:100% it shrinks inside its min-w-0 flex parent and
       max-width still caps it on desktop. */
    appearance: none; -webkit-appearance: none; height: var(--control-h-md); min-width: 0; width: 100%; max-width: 320px;
    padding: 0 32px 0 12px; border-radius: var(--radius-sm);
    background: var(--color-canvas); color: var(--color-ink); box-shadow: var(--shadow-hairline);
    font-size: 13px; line-height: 20px; cursor: pointer; text-overflow: ellipsis; touch-action: manipulation;
  }
  .ga-select:hover { box-shadow: inset 0 0 0 1px var(--color-hairline-strong); }
  .ga-field { display: flex; flex-direction: column; gap: 6px; }
  .ga-field-label { font-size: 12px; font-weight: 500; color: var(--color-body); }
  .ga-input {
    width: 100%; padding: 7px 10px; border-radius: var(--radius-sm);
    background: var(--color-canvas); color: var(--color-ink);
    font-size: 13px; line-height: 20px;
  }
  /* Unlayered scoped CSS always beats a layered Tailwind @utility for the same
     property (CSS Cascade Layers) — excluding :focus-visible here lets the
     shared .input-focus utility's ring actually take over during focus. */
  .ga-input:not(:focus-visible) {
    box-shadow: var(--shadow-hairline);
  }
  .ga-textarea { resize: vertical; min-height: 80px; }

  .ga-results { min-height: var(--control-h-lg); }

  /* ── Result building blocks (runtime-injected → :global) ──────────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.ga-results` containers. */
  :global(.ga-verdict) {
    display: flex; align-items: center; gap: 12px; padding: 14px 16px;
    border-radius: var(--radius-md); background: var(--color-canvas); box-shadow: var(--shadow-hairline);
    animation: ga-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.ga-verdict__badge) {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    min-width: 64px; padding: 4px 12px; border-radius: var(--radius-pill);
    font-weight: 600; font-size: 13px;
  }
  :global(.ga-verdict__badge.is-true) { background: var(--color-success-soft); color: var(--color-success-deep); box-shadow: inset 0 0 0 1px var(--color-success); }
  :global(.ga-verdict__badge.is-false) { background: var(--color-canvas-soft-2); color: var(--color-body); box-shadow: inset 0 0 0 1px var(--color-hairline-strong); }
  :global(.ga-verdict__text) { min-width: 0; font-size: 14px; line-height: 21px; color: var(--color-ink); text-wrap: pretty; }
  :global(.ga-rendered) { font-family: var(--font-mono); color: var(--color-ink); }

  :global(.ga-warn) {
    display: flex; gap: 10px; margin-top: 12px; padding: 12px 14px; border-radius: var(--radius-md);
    background: var(--color-warning-soft); box-shadow: inset 0 0 0 1px var(--color-warning);
    color: var(--color-warning-deep); animation: ga-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.ga-warn.is-info) { background: var(--color-canvas); color: var(--color-body); box-shadow: inset 0 0 0 1px var(--color-hairline-strong); }
  :global(.ga-warn__icon) { flex: 0 0 auto; width: 18px; height: 18px; margin-top: 1px; }
  :global(.ga-warn__title) { font-size: 13px; font-weight: 600; line-height: 19px; }
  :global(.ga-warn__body) { min-width: 0; font-size: 13px; line-height: 19px; }

  :global(.ga-explanation) { margin-top: 12px; padding: 12px 14px; border-radius: var(--radius-md); background: var(--color-canvas); box-shadow: var(--shadow-hairline); font-size: 14px; line-height: 22px; color: var(--color-ink); text-wrap: pretty; }

  :global(.ga-breakdown) { margin-top: 12px; display: flex; flex-direction: column; gap: 8px; list-style: none; padding: 0; }
  :global(.ga-part) { display: flex; gap: 12px; padding: 10px 12px; border-radius: var(--radius-md); background: var(--color-canvas); box-shadow: var(--shadow-hairline); }
  :global(.ga-part__token) { flex: 0 0 auto; max-width: 46%; align-self: flex-start; padding: 2px 8px; border-radius: var(--radius-sm); background: var(--color-canvas-soft-2); box-shadow: var(--shadow-hairline); font-family: var(--font-mono); font-size: 13px; line-height: 20px; color: var(--color-ink); white-space: pre-wrap; word-break: break-word; }
  :global(.ga-part__meaning) { min-width: 0; flex: 1 1 auto; font-size: 14px; line-height: 21px; color: var(--color-body); text-wrap: pretty; }

  /* Trigger results table (built by the script) */
  :global(.ga-wf-banner) { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: var(--radius-md); font-size: 14px; line-height: 21px; animation: ga-rise var(--dur-base) var(--ease-brand) both; }
  :global(.ga-wf-banner.is-yes) { background: var(--color-success-soft); color: var(--color-success-deep); box-shadow: inset 0 0 0 1px var(--color-success); }
  :global(.ga-wf-banner.is-no) { background: var(--color-canvas-soft-2); color: var(--color-body); box-shadow: inset 0 0 0 1px var(--color-hairline-strong); }
  :global(.ga-jobs) { margin-top: 12px; width: 100%; border-collapse: collapse; font-size: 14px; }
  :global(.ga-jobs th) { text-align: left; padding: 8px 10px; color: var(--color-mute); font-weight: 500; font-size: 12px; border-bottom: 1px solid var(--color-hairline); }
  :global(.ga-jobs td) { padding: 10px; border-bottom: 1px solid var(--color-hairline); vertical-align: top; color: var(--color-body); text-wrap: pretty; }
  :global(.ga-jobs td:first-child) { font-family: var(--font-mono); color: var(--color-ink); white-space: nowrap; }
  :global(.ga-decision) { display: inline-flex; align-items: center; gap: 5px; padding: 2px 9px; border-radius: var(--radius-pill); font-weight: 600; font-size: 12px; white-space: nowrap; }
  :global(.ga-decision.runs) { background: var(--color-success-soft); color: var(--color-success-deep); box-shadow: inset 0 0 0 1px var(--color-success); }
  :global(.ga-decision.skipped) { background: var(--color-canvas-soft-2); color: var(--color-body); box-shadow: inset 0 0 0 1px var(--color-hairline-strong); }
  :global(.ga-decision.not-evaluated) { background: var(--color-canvas-soft-2); color: var(--color-mute); }
  /* `unknown` is an honest "cannot tell", not a verdict — amber annotation ink. */
  :global(.ga-decision.unknown) { background: var(--color-warning-soft); color: var(--color-accent-ink); box-shadow: inset 0 0 0 1px var(--color-accent-ink); }
  :global(.ga-jobs-wrap) { overflow-x: auto; }

  :global(.ga-error) { display: flex; gap: 10px; padding: 12px 14px; border-radius: var(--radius-md); background: var(--color-error-soft); box-shadow: inset 0 0 0 1px var(--color-error); color: var(--color-error-deep); }
  :global(.ga-error__detail) { margin-top: 2px; font-family: var(--font-mono); font-size: 12px; white-space: pre-wrap; word-break: break-word; }
  :global(.ga-empty) { display: flex; align-items: center; justify-content: center; min-height: 64px; padding: 20px 16px; text-align: center; text-wrap: pretty; border-radius: var(--radius-md); background: var(--color-canvas); box-shadow: var(--shadow-hairline); }

  @keyframes ga-rise { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.ga-verdict), :global(.ga-warn), :global(.ga-explanation), :global(.ga-wf-banner) { animation: none; }
  }

  /* ── Instrument re-skin — both results sit on the L2 result slab (dark in
     BOTH themes), so everything rendered into them uses the slab ink tier. */
  .ga-results :global(.ga-verdict),
  .ga-results :global(.ga-explanation),
  .ga-results :global(.ga-part),
  .ga-results :global(.ga-empty),
  .ga-results :global(.ga-warn.is-info),
  .ga-results :global(.ga-wf-banner.is-no) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-fg);
  }
  .ga-results :global(.ga-verdict__text),
  .ga-results :global(.ga-rendered),
  .ga-results :global(.ga-part__meaning),
  .ga-results :global(.ga-jobs td),
  .ga-results :global(.ga-jobs td:first-child) {
    color: var(--color-inverse-fg);
  }
  .ga-results :global(.ga-empty),
  .ga-results :global(.ga-jobs th) {
    color: var(--color-inverse-mute);
  }
  .ga-results :global(.ga-verdict__badge.is-true),
  .ga-results :global(.ga-wf-banner.is-yes),
  .ga-results :global(.ga-decision.runs) {
    background: #8fc97a1f;
    color: var(--color-inverse-brand);
    box-shadow: inset 0 0 0 1px var(--color-inverse-brand);
  }
  .ga-results :global(.ga-verdict__badge.is-false),
  .ga-results :global(.ga-decision.skipped) {
    background: #ffffff0a;
    color: var(--color-inverse-fg);
    box-shadow: inset 0 0 0 1px var(--color-inverse-control-edge);
  }
  .ga-results :global(.ga-decision.not-evaluated) {
    background: #ffffff0a;
    color: var(--color-inverse-mute);
  }
  .ga-results :global(.ga-warn),
  .ga-results :global(.ga-decision.unknown) {
    background: #e0a45814;
    color: var(--color-inverse-accent);
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .ga-results :global(.ga-part__token) {
    background: #ffffff14;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-fg);
  }
  .ga-results :global(.ga-jobs th),
  .ga-results :global(.ga-jobs td) {
    border-bottom-color: #ffffff12;
  }
  .ga-results :global(.ga-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .is-busy { opacity: .65; pointer-events: none; cursor: progress; }
</style>

<script>
  import type { EditorView } from '@codemirror/view';
  import { escapeHtml } from '../lib/escape-html';
  import { base64UrlEncode, base64UrlDecode } from '../lib/codec';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChips, clearChips, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  // Tab 1's pure HTML builders, shared with this component's frontmatter so the
  // server-rendered seed and every client repaint come from one implementation.
  import {
    WARN_SVG,
    evalErrorHtml,
    exprResultHtml,
    exprSummaryText,
    warnHtml,
  } from '../lib/github-actions-expression-tester/render';

  // CodeMirror is loaded via dynamic import inside init() so its ~200KB runtime
  // code-splits into its own chunk instead of shipping in the page's initial JS.
  // The `EditorView` type above is erased at build time and ships no runtime code.

  type EngineModule = typeof import('../lib/github-actions-expression-tester/engine');
  type ExamplesModule = typeof import('../lib/github-actions-expression-tester/examples');

  const ROOT_SEL = '.ga-pg';
  const SLUG = 'github-actions-expression-tester';
  /** Inside the 130–220ms band the playground UX contract specifies. */
  const DEBOUNCE_MS = 180;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.gaWired === 'true') return;
      root.dataset.gaWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: ParentNode, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function isCoarsePointer(): boolean {
    return window.matchMedia?.('(pointer: coarse)').matches ?? false;
  }

  /* ── share-link codec ──────────────────────────────────────────────────── */
  function encodeState(obj: unknown): string {
    try { return base64UrlEncode(JSON.stringify(obj)); } catch { return ''; }
  }
  function decodeState(s: string): Record<string, unknown> | null {
    // New links use base64UrlEncode; old bookmarked/shared links used a plain
    // btoa+encodeURIComponent scheme (no URL-safe substitution). JSON.stringify
    // output always starts with "{", so a legacy payload run through the new
    // decoder always fails JSON.parse and falls through cleanly — it can never
    // silently mis-parse as valid-but-wrong new-format data.
    try {
      return JSON.parse(base64UrlDecode(s)) as Record<string, unknown>;
    } catch {
      try {
        return JSON.parse(decodeURIComponent(atob(s))) as Record<string, unknown>;
      } catch {
        return null;
      }
    }
  }

  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  async function init(root: HTMLElement): Promise<void> {
    let engine: EngineModule;
    let examples: ExamplesModule;
    // Editor factory + doc-setter are assigned from closures over the freshly
    // imported CM symbols (so no runtime CM reference lives at module top level).
    let makeEditor: (
      host: HTMLElement,
      doc: string,
      opts: { label: string; yaml?: boolean; onChange?: () => void },
    ) => EditorView;
    let setDoc: (v: EditorView, doc: string) => void;
    try {
      // Load CodeMirror + the kit's plate theme + the engine + examples
      // together so the ~200KB CM runtime code-splits into its own chunk off
      // the initial page JS.
      const [
        { EditorState },
        { EditorView, keymap, lineNumbers, highlightActiveLine },
        { defaultKeymap, history, historyKeymap, indentWithTab },
        { yaml: yamlLang },
        { plate },
        engineMod,
        examplesMod,
      ] = await Promise.all([
        import('@codemirror/state'),
        import('@codemirror/view'),
        import('@codemirror/commands'),
        import('@codemirror/lang-yaml'),
        import('../lib/playground-kit/cm-theme'),
        import('../lib/github-actions-expression-tester/engine'),
        import('../lib/github-actions-expression-tester/examples'),
      ]);
      engine = engineMod;
      examples = examplesMod;

      const runKey = {
        key: 'Mod-Enter',
        run: (v: EditorView) => {
          runActive();
          if (isCoarsePointer()) v.contentDOM.blur();
          return true;
        },
      };
      const escAndBlur = { key: 'Escape', run: (v: EditorView) => { v.contentDOM.blur(); return true; } };
      // Sizing only — colours, gutters and the focus ring come from the plate
      // theme and the EditorPane rule in global.css.
      const sizing = EditorView.theme({
        '&': { fontSize: '13px', maxHeight: '360px' },
        '.cm-scroller': { overflow: 'auto' },
        '.cm-content, .cm-gutter': { minHeight: '120px' },
      });

      makeEditor = (host, doc, opts): EditorView => {
        const ext = [
          lineNumbers(), history(), highlightActiveLine(), EditorView.lineWrapping,
          // Ours FIRST, so Mod-Enter wins over defaultKeymap's Enter.
          keymap.of([runKey, escAndBlur, ...defaultKeymap, ...historyKeymap, indentWithTab]),
          plate, sizing,
          EditorView.contentAttributes.of({ 'aria-label': opts.label }),
        ];
        if (opts.yaml) ext.push(yamlLang());
        if (opts.onChange) {
          const notify = opts.onChange;
          ext.push(EditorView.updateListener.of((u) => { if (u.docChanged) notify(); }));
        }
        return new EditorView({ state: EditorState.create({ doc, extensions: ext }), parent: host });
      };
      setDoc = (v: EditorView, doc: string) => v.dispatch({ changes: { from: 0, to: v.state.doc.length, insert: doc } });
    } catch (err) {
      console.error('[GHA playground] engine failed to load', err);
      return;
    }

    // Version label.
    const ver = el<HTMLElement>(root, '#ga-version');
    if (ver) ver.textContent = 'semantics: ' + engine.GHA_SEMANTICS_VERSION;

    // ── Tabs (resolved first: runActive needs the panels) ──
    const tabExpr = el<HTMLButtonElement>(root, '#ga-tab-expr');
    const tabTrig = el<HTMLButtonElement>(root, '#ga-tab-trig');
    const panelExpr = el<HTMLElement>(root, '#ga-panel-expr');
    const panelTrig = el<HTMLElement>(root, '#ga-panel-trig');
    const exprActive = (): boolean => panelExpr?.classList.contains('ga-panel--active') ?? true;

    // ── Editors ──
    const exprHost = el<HTMLElement>(root, '#ga-expr-editor');
    const ctxHost = el<HTMLElement>(root, '#ga-ctx-editor');
    const wfHost = el<HTMLElement>(root, '#ga-wf-editor');
    if (!exprHost || !ctxHost || !wfHost || !panelExpr || !panelTrig) return;

    /**
     * Live-eval plumbing. runExpr/runSim are declared further down, after the
     * result containers exist, so the editors cannot reference them directly at
     * construction time — these mutable hooks bridge the gap and stay no-ops
     * until they are assigned.
     */
    let onExprInput: () => void = () => {};
    let onSimInput: () => void = () => {};
    let runActive: () => void = () => {};
    // Programmatic document writes (examples, presets, deep link, restore)
    // are not typing: they run their own evaluation and must not schedule a
    // debounced, recorded one behind it.
    let quiet = false;
    const write = (v: EditorView, doc: string): void => {
      quiet = true;
      try { setDoc(v, doc); } finally { quiet = false; }
    };
    function debounce(fn: () => void, ms = DEBOUNCE_MS): () => void {
      let t: number | undefined;
      return () => {
        if (t !== undefined) clearTimeout(t);
        t = window.setTimeout(fn, ms);
      };
    }

    const exprView = makeEditor(exprHost, examples.expressionExamples[0]?.expression ?? '', {
      label: 'GitHub Actions if condition or expression',
      onChange: () => onExprInput(),
    });
    const ctxView = makeEditor(ctxHost, JSON.stringify(engine.defaultContext(), null, 2), {
      label: 'Editable mock evaluation context (JSON)',
      onChange: () => onExprInput(),
    });

    // The build-time text stand-ins have done their job (no-JS visitors and
    // crawlers); CodeMirror appended its editors beside them, so drop them.
    // The #s= / restore tiers below overwrite the documents in place.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());
    const wfView = makeEditor(wfHost, examples.triggerExamples[0]?.workflow ?? '', {
      label: 'Workflow YAML',
      yaml: true,
      onChange: () => onSimInput(),
    });

    function activate(which: 'expr' | 'trig'): void {
      const isExpr = which === 'expr';
      tabExpr?.setAttribute('aria-selected', String(isExpr));
      tabTrig?.setAttribute('aria-selected', String(!isExpr));
      if (tabExpr) tabExpr.tabIndex = isExpr ? 0 : -1;
      if (tabTrig) tabTrig.tabIndex = isExpr ? -1 : 0;
      // Visibility is driven solely by the ga-panel--active class (NOT the
      // hidden attribute) — Tailwind v4's `[hidden]{display:none!important}`
      // would otherwise win over the class and leave CodeMirror measuring at 0.
      panelExpr?.classList.toggle('ga-panel--active', isExpr);
      panelTrig?.classList.toggle('ga-panel--active', !isExpr);
      // CodeMirror must re-measure once its panel is visible.
      requestAnimationFrame(() => {
        (isExpr ? [exprView, ctxView] : [wfView]).forEach((v) => v.requestMeasure());
      });
    }
    tabExpr?.addEventListener('click', () => activate('expr'));
    tabTrig?.addEventListener('click', () => activate('trig'));
    root.addEventListener('keydown', (e) => {
      if (e.target !== tabExpr && e.target !== tabTrig) return;
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        const goTrig = e.target === tabExpr;
        activate(goTrig ? 'trig' : 'expr');
        (goTrig ? tabTrig : tabExpr)?.focus();
      } else if (e.key === 'Home') {
        e.preventDefault();
        activate('expr');
        tabExpr?.focus();
      } else if (e.key === 'End') {
        e.preventDefault();
        activate('trig');
        tabTrig?.focus();
      }
    });

    // ── Examples ──
    // Both chip groups are server-rendered (ExampleChips) from the same
    // `examples` module, in the same order, so `data-example-idx` indexes those
    // arrays directly.
    const exprChipsWrap = el<HTMLElement>(root, '#ga-expr-chips');
    const trigChipsWrap = el<HTMLElement>(root, '#ga-trig-chips');
    const exprChips = Array.from(exprChipsWrap?.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR) ?? []);
    const trigChips = Array.from(trigChipsWrap?.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR) ?? []);

    /** Press `active` within one group; null for "none of them". */
    function pressChip(group: HTMLElement | null, active: HTMLButtonElement | null): void {
      syncChips(group, (c) => c === active);
    }

    // ── Event form ──
    const evEvent = el<HTMLSelectElement>(root, '#ga-ev-event');
    const evBranch = el<HTMLInputElement>(root, '#ga-ev-branch');
    const evTag = el<HTMLInputElement>(root, '#ga-ev-tag');
    const evFiles = el<HTMLTextAreaElement>(root, '#ga-ev-files');
    const fieldBranch = el<HTMLElement>(root, '#ga-field-branch');
    const fieldTag = el<HTMLElement>(root, '#ga-field-tag');
    function syncEventFields(): void {
      const isTag = evEvent?.value === 'tag';
      fieldTag?.classList.toggle('hidden', !isTag);
      fieldBranch?.classList.toggle('hidden', isTag);
    }
    syncEventFields();
    function applyEventToForm(ev: { event: string; branch?: string; tag?: string; changedFiles?: string[] }): void {
      if (evEvent) evEvent.value = ev.tag ? 'tag' : ev.event;
      if (evBranch && ev.branch) evBranch.value = ev.branch;
      if (evTag && ev.tag) evTag.value = ev.tag;
      if (evFiles) evFiles.value = (ev.changedFiles ?? []).join('\n');
      syncEventFields();
    }
    function readEvent(): { event: string; branch?: string; tag?: string; changedFiles?: string[] } {
      const isTag = evEvent?.value === 'tag';
      const files = (evFiles?.value ?? '').split('\n').map((s) => s.trim()).filter(Boolean);
      return {
        event: isTag ? 'push' : (evEvent?.value ?? 'push'),
        branch: isTag ? undefined : (evBranch?.value || 'main'),
        tag: isTag ? (evTag?.value || 'v1.0.0') : undefined,
        changedFiles: files.length ? files : undefined,
      };
    }

    // ── Result rendering ──
    const exprResults = el<HTMLElement>(root, '#ga-expr-results')!;
    const exprSummary = el<HTMLElement>(root, '#ga-expr-summary')!;
    const trigResults = el<HTMLElement>(root, '#ga-trig-results')!;
    const trigSummary = el<HTMLElement>(root, '#ga-trig-summary')!;
    const shareExpr = el<HTMLButtonElement>(root, '#ga-share-expr');
    const shareTrig = el<HTMLButtonElement>(root, '#ga-share-trig');

    // Copy plumbing — one delegated listener per tab panel, each announcing in
    // its own result panel's #<prefix>-copy-status.
    wireCopyButtons(panelExpr, { status: el<HTMLElement>(root, '#ga-expr-copy-status') });
    wireCopyButtons(panelTrig, { status: el<HTMLElement>(root, '#ga-trig-copy-status') });

    /** The share URL for a state, or '' (button stays hidden). */
    function shareUrlFor(state: Record<string, unknown>): string {
      const hash = encodeState(state);
      return hash ? `${location.origin}${location.pathname}#s=${hash}` : '';
    }
    function setShare(btn: HTMLButtonElement | null, url: string): void {
      if (!btn) return;
      btn.dataset.copy = url;
      btn.hidden = url.length === 0;
    }

    function exprState(): Record<string, unknown> {
      return { t: 'expr', e: exprView.state.doc.toString(), c: ctxView.state.doc.toString() };
    }
    function trigState(): Record<string, unknown> {
      return { t: 'trig', w: wfView.state.doc.toString(), v: readEvent() };
    }

    /** `user` false = the boot seed / deep link / restore: never recorded. */
    function runExpr(user = true): void {
      const raw = exprView.state.doc.toString();
      const parsed = engine.parseContext(ctxView.state.doc.toString());
      let result;
      try { result = engine.evaluateIfCondition(raw, parsed.ctx); }
      catch (err) {
        setSummary(exprSummary, 'error', true);
        exprResults.innerHTML = evalErrorHtml('Could not evaluate', String(err));
        setShare(shareExpr, '');
        return;
      }

      setSummary(exprSummary, exprSummaryText(result), false);
      exprResults.innerHTML = exprResultHtml(result, { contextError: parsed.error });
      setShare(shareExpr, shareUrlFor(exprState()));
      if (user) recordToolLastInput(SLUG, JSON.stringify(exprState()));
    }

    function runSim(user = true): void {
      const wf = wfView.state.doc.toString();
      const ev = readEvent();
      let result;
      try { result = engine.simulateTriggers(wf, ev as never); }
      catch (err) {
        setSummary(trigSummary, 'error', true);
        trigResults.innerHTML = `<div class="ga-error" role="alert">${WARN_SVG}<div><p class="ga-warn__title">Could not simulate</p><p class="ga-error__detail">${escapeHtml(String(err))}</p></div></div>`;
        setShare(shareTrig, '');
        return;
      }

      if (result.error) {
        setSummary(trigSummary, 'error', true);
        trigResults.innerHTML = `<div class="ga-error" role="alert">${WARN_SVG}<div><p class="ga-warn__title">Workflow could not be parsed</p><p class="ga-error__detail">${escapeHtml(result.error)}</p></div></div>`;
        setShare(shareTrig, '');
        return;
      }
      const runs = result.jobs.filter((j) => j.decision === 'runs').length;
      setSummary(trigSummary, `${runs}/${result.jobs.length} run`, false);
      const banner = `<div class="ga-wf-banner ${result.workflowTriggered ? 'is-yes' : 'is-no'}">${result.workflowTriggered ? '✓' : '✕'} ${escapeHtml(result.workflowReason)}</div>`;
      const warns = result.warnings.map(warnHtml).join('');
      const rows = result.jobs.map((j) => {
        // `unknown` means the simulator cannot model a context the `if:` reads
        // (vars.*, secrets.*, inputs.*, needs.*.outputs.*). Rendering it as
        // "NOT RUN" would restate the confident-false bug the engine just fixed.
        const decClass = j.decision === 'runs' || j.decision === 'skipped' || j.decision === 'unknown' || j.decision === 'not-evaluated' ? j.decision : 'not-evaluated';
        const decLabel = j.decision === 'runs' ? 'RUNS' : j.decision === 'skipped' ? 'SKIPPED' : j.decision === 'unknown' ? 'UNKNOWN' : 'NOT RUN';
        return `<tr><td>${escapeHtml(j.jobId)}</td><td><span class="ga-decision ${decClass}">${decLabel}</span></td><td>${escapeHtml(j.reason)}</td></tr>`;
      }).join('');
      const table = result.jobs.length
        ? `<div class="ga-jobs-wrap"><table class="ga-jobs"><thead><tr><th>Job</th><th>Decision</th><th>Reason</th></tr></thead><tbody>${rows}</tbody></table></div>`
        : '<p class="ga-empty body-sm">No jobs found in this workflow.</p>';
      trigResults.innerHTML = banner + warns + table;
      setShare(shareTrig, shareUrlFor(trigState()));
      if (user) recordToolLastInput(SLUG, JSON.stringify(trigState()));
    }

    // ── Wire actions ──
    // Activate live eval now that both runners exist. "Run now" and
    // ⌘/Ctrl+Enter run immediately, skipping the debounce.
    onExprInput = debounce(() => runExpr(true));
    onSimInput = debounce(() => runSim(true));
    runActive = () => { if (exprActive()) runExpr(true); else runSim(true); };

    el<HTMLButtonElement>(root, '#ga-eval')?.addEventListener('click', () => runExpr(true));
    el<HTMLButtonElement>(root, '#ga-sim')?.addEventListener('click', () => runSim(true));

    // Picking an example must show its result without a second click — that is
    // the entire point of an example. The doc write releases nothing here (the
    // pressed chip is set after it) and the debounced run is superseded.
    exprChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const ex = examples.expressionExamples[Number(chip.dataset.exampleIdx)];
        if (!ex) return;
        write(exprView, ex.expression);
        pressChip(exprChipsWrap, chip);
        runExpr(true);
      });
    });
    trigChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const ex = examples.triggerExamples[Number(chip.dataset.exampleIdx)];
        if (!ex) return;
        write(wfView, ex.workflow);
        applyEventToForm(ex.event);
        pressChip(trigChipsWrap, chip);
        runSim(true);
      });
    });

    // Typing in an editor means the on-screen state is no longer an example.
    const exprTyped = onExprInput;
    onExprInput = () => { if (quiet) return; clearChips(exprChipsWrap); exprTyped(); };
    const simTyped = onSimInput;
    onSimInput = () => { if (quiet) return; clearChips(trigChipsWrap); simTyped(); };

    // The event scenario form is part of the simulation input.
    evEvent?.addEventListener('change', () => { syncEventFields(); onSimInput(); });
    [evBranch, evTag, evFiles].forEach((f) => f?.addEventListener('input', () => onSimInput()));

    // ── Context presets ──
    root.querySelectorAll<HTMLButtonElement>('.ga-preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        const ctx = engine.defaultContext();
        const preset = btn.dataset.preset;
        const gh = (ctx.github ?? {}) as Record<string, unknown>;
        if (preset === 'pull_request') {
          gh.event_name = 'pull_request'; gh.ref = 'refs/pull/42/merge'; gh.ref_name = '42/merge'; gh.base_ref = 'main'; gh.head_ref = 'feature/x';
        } else if (preset === 'tag') {
          gh.event_name = 'push'; gh.ref = 'refs/tags/v1.2.3'; gh.ref_name = 'v1.2.3'; gh.ref_type = 'tag';
        } else {
          gh.event_name = 'push'; gh.ref = 'refs/heads/main'; gh.ref_name = 'main'; gh.ref_type = 'branch';
        }
        ctx.github = gh as never;
        write(ctxView, JSON.stringify(ctx, null, 2));
        runExpr(true);
      });
    });

    // ── Share — Copy link copies the #s= URL (copy.ts); the click also puts
    // that state in the address bar, as the old Share button did. ──
    [shareExpr, shareTrig].forEach((btn) => {
      btn?.addEventListener('click', () => {
        const url = btn.dataset.copy ?? '';
        const at = url.indexOf('#s=');
        if (at < 0) return;
        // NB: window.history — keep it explicit; `history` (unprefixed) is the
        // CodeMirror commands extension, imported dynamically inside init().
        try { window.history.replaceState(null, '', url.slice(at)); } catch { /* Safari throttle */ }
      });
    });

    // ── Snapshot save/restore — applies to whichever tab is active ──
    const snapSaveBtn = el<HTMLButtonElement>(root, '#ga-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#ga-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#ga-snap-delete');
    function applyState(st: Record<string, unknown> | null, user: boolean): boolean {
      if (st && st.t === 'expr') {
        // Restored state is the visitor's own, not one of the examples — so
        // no chip is pressed.
        if (typeof st.e === 'string') write(exprView, st.e);
        if (typeof st.c === 'string') write(ctxView, st.c);
        clearChips(exprChipsWrap);
        activate('expr');
        runExpr(user);
        return true;
      }
      if (st && st.t === 'trig') {
        if (typeof st.w === 'string') write(wfView, st.w);
        if (st.v) applyEventToForm(st.v as never);
        clearChips(trigChipsWrap);
        activate('trig');
        runSim(user);
        return true;
      }
      return false;
    }
    function parseState(raw: string): Record<string, unknown> | null {
      try { return JSON.parse(raw) as Record<string, unknown>; } catch { return null; }
    }
    if (snapSaveBtn && snapSelect && snapDeleteBtn) {
      wireSnapshotUI({
        slug: SLUG,
        saveBtn: snapSaveBtn,
        snapshotSelect: snapSelect,
        deleteBtn: snapDeleteBtn,
        getValue: () => JSON.stringify(exprActive() ? exprState() : trigState()),
        setValue: (raw) => { applyState(parseState(raw), true); },
      });
    }

    // ── First load ──
    // Seed priority: #s= deep link > restored last input > seeded example
    // (already in the editors). None of these is user input: nothing is
    // recorded and no hash is written. Then evaluate whatever the editors
    // ended up holding, so the page never opens on an empty results panel —
    // the highest-intent visitor ("github actions if condition always runs")
    // must not have to press a button to see the footgun verdict.
    let seededExpr = false;
    let seededTrig = false;
    const fromHash = location.hash.startsWith('#s=') ? decodeState(location.hash.slice(3)) : null;
    const st = fromHash ?? (location.hash.startsWith('#s=') ? null : parseState(getRestoredLastInput(SLUG) ?? ''));
    if (st && st.t === 'expr') seededExpr = applyState(st, false);
    else if (st && st.t === 'trig') seededTrig = applyState(st, false);
    if (!seededExpr) runExpr(false);
    if (!seededTrig) runSim(false);
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
