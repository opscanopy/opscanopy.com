---
/**
 * ToolPipeline — the shared "how it works" numbered card grid.
 *
 * A centered header (optional eyebrow, heading, optional lead) over an ordered
 * list of steps. Each step is a card with a numbered circular marker, title and
 * body. The column count is derived from the number of steps as a full static
 * Tailwind literal (5 steps → 5 columns, otherwise 4) so the class survives the
 * compiler's static-extraction.
 */
import { getTool } from '../data/tools';
import { site } from '../data/site';
import { howToLd } from '../lib/jsonld';
import { stripLocale } from '../i18n/utils';

interface Step {
  title: string;
  body: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  heading: string;
  lead?: string;
  steps: Step[];
  /**
   * Suppress the HowTo JSON-LD. The steps describe how to use the tool, so the
   * schema is emitted automatically on every tool page — set this on the rare
   * pipeline that documents something other than the page's own tool.
   */
  noHowToLd?: boolean;
}

const { id, eyebrow, heading, lead, steps, noHowToLd = false } = Astro.props;

// Full literal classes — never interpolated — so Tailwind keeps them.
const cols = steps.length === 5 ? 'lg:grid-cols-5' : 'lg:grid-cols-4';

/**
 * HowTo structured data, derived from the steps already rendered below.
 *
 * Every tool page ships a 4–5 step "how it works" section and none of them
 * declared it, so the one piece of genuinely step-shaped content on the page was
 * invisible to parsers. The mapping is exact — {title, body} → {name, text} —
 * so this adds no new prose to maintain and cannot drift from what is rendered.
 *
 * Emitted here rather than threaded through 195 pages' `jsonLd` props, following
 * the precedent ToolHero already sets by emitting its own BreadcrumbList.
 * `heading` is usually "How it works.", which is a poor HowTo name on its own —
 * so the registered tool name supplies the subject when the URL resolves to one.
 */
const slug = stripLocale(Astro.url.pathname).replace(/^\/+|\/+$/g, '');
const tool = slug && !slug.includes('/') ? getTool(slug) : undefined;
// THIS page's own URL — locale prefix kept, trailing slash enforced. Using the
// locale-stripped key here would have pointed every localized page's HowTo at
// the English URL, and dropped the trailing slash the whole site canonicalises on.
const pagePath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const howToJson =
  !noHowToLd && tool && steps.length > 0
    ? JSON.stringify(
        howToLd({
          // No article before the name: `h1Name ?? name` may be a bare brand
          // ("AlertLint"), and "How to use the AlertLint" does not read as English.
          name: `How to use ${tool.h1Name ?? tool.name}`,
          description: lead ?? tool.tagline,
          url: `${site.url}${pagePath}`,
          steps: steps.map((s) => ({ name: s.title, text: s.body })),
        }),
      )
    : null;
---

<section id={id} class="scroll-mt-24 bg-canvas py-16 sm:py-20">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 class="display-lg mt-3 text-balance text-ink">{heading}</h2>
      {lead && <p class="body-lg mt-5 text-pretty text-body">{lead}</p>}
    </div>
    <ol class={`mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 ${cols}`}>
      {
        steps.map((step, i) => (
          <li class="card flex h-full flex-col p-5">
            <span
              class="code-mono inline-flex h-7 min-w-7 items-center justify-center rounded-sm border border-hairline-muted bg-canvas-soft px-1.5 text-[13px] font-medium text-accent-ink"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="display-sm mt-4 text-ink">{step.title}</h3>
            <p class="body-sm mt-2 text-body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
  {howToJson && <script type="application/ld+json" set:html={howToJson} />}
</section>
