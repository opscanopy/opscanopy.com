---
/**
 * K8sLabelSelectorTesterPlayground — the Kubernetes Label Selector Tester island.
 *
 * TWO inputs, deliberately asymmetric:
 *   · the RESOURCES pane is a CodeMirror YAML editor — it takes a whole
 *     `kubectl get pods -o yaml` paste;
 *   · the SELECTOR row is one line. A segmented toggle swaps between the
 *     `kubectl -l` string (single-line `<input>`) and structured selector YAML
 *     (a six-row `<textarea>` — NOT a second CodeMirror: a six-line document
 *     does not earn another editor runtime).
 *
 * The results are the product: one card per resource with a MATCH / NO MATCH
 * chip and then the clause-by-clause trace, each clause carrying the reason the
 * engine produced. Clauses that hold BECAUSE the key is absent get an amber
 * annotation, because `NotIn`/`!=` matching a resource that has no such label is
 * the one piece of apimachinery semantics people answer backwards.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * EditorPane (the resources slab under its figure cap), RunHint, SnapshotBar,
 * ResultPanel (the L2 instrument: figure cap, the one live summary, copy
 * status) and CopyButton. The results container stays here, seeded with
 * `set:html` + `data-results`; its slab inks anchor on `.klt-results`.
 *
 * UX contract (CLAUDE.md): ONE ~170ms debounce, a ~600ms calm-error hold
 * before anything goes red, per-row copy + `data-copy-all` + `data-copy-link`,
 * a results container that is NOT `aria-live`, glossary captions instead of
 * tooltips, `wireRunKeys()` on the selector fields, and `escapeHtml()` on every
 * injected value — attribute contexts included.
 *
 * Deep link + snapshots both carry the SAME `#s=` payload (resources + selector
 * + mode), so a restored snapshot brings the grammar toggle back with it. The
 * hash is written ONLY on a user-initiated eval that came back fully valid — a
 * boot seed never writes it, and neither does a run with an error diagnostic.
 *
 * Runtime contract (lazy-imported inside the boot closure so the engine, the
 * CodeMirror runtime and the plate theme code-split away from the page shell):
 *   ../lib/kubernetes-label-selector-tester/engine   → testSelector, encodeState, decodeState
 *   ../lib/kubernetes-label-selector-tester/examples → examples: SelectorExample[]
 *   ../lib/playground-kit/cm-theme                   → plate
 *
 * Only the example LABELS are read at build time (so the chips are
 * server-rendered and exist before hydration); the manifests themselves come
 * from the lazy import by index, which keeps multi-line YAML out of HTML
 * attributes entirely.
 */
import { examples } from '../lib/kubernetes-label-selector-tester/examples';
import { testSelector } from '../lib/kubernetes-label-selector-tester/engine';
import { canonicalHtml, resultHtml, EMPTY_HTML } from '../lib/kubernetes-label-selector-tester/render';
import ExampleChips from './playground/ExampleChips.astro';
import EditorPane from './playground/EditorPane.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. `testSelector` is pure and synchronous, so the first
 * example's per-resource verdicts are computed at build time and land in the
 * static HTML — which is all an AI crawler (no JS) ever sees. The client
 * re-runs the same example on boot and repaints the identical markup.
 *
 * `resultHtml` also returns the per-row copy payloads; the server ignores them
 * (the client rebinds them after its own render) and only takes the html.
 *
 * The resources YAML goes into a `<pre data-cm-fallback>` inside the
 * CodeMirror host; CM appends its editor to the host, so `init` removes it
 * once mounted.
 */
const seedExample = examples[0];
const seedResult = seedExample
  ? testSelector(seedExample.resources, seedExample.selector, seedExample.mode)
  : null;
const seedOk = seedResult && seedResult.ok ? seedResult : null;
const seedHtml = seedOk ? resultHtml(seedOk).html : EMPTY_HTML;
const seedSummary = seedOk ? seedOk.summary : '';
const seedCanonicalHtml = seedOk ? canonicalHtml(seedOk) : '';
const chipItems = examples.map((ex) => ({ label: ex.label }));
---

<section class="klt-pg" aria-label="Kubernetes Label Selector Tester playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Example chips ────────────────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow shrink-0">Examples</span>
      <ExampleChips prefix="klt" items={chipItems} active={seedExample ? 0 : null} ariaLabel="Examples" />
    </div>

    {/* ── Selector row ─────────────────────────────────────────────────── */}
    <div class="klt-controls border-b border-hairline px-4 py-4 sm:px-5">
      <div class="klt-control">
        <span class="eyebrow" id="klt-mode-label">Selector grammar</span>
        <div class="klt-seg" role="radiogroup" aria-labelledby="klt-mode-label">
          <button
            id="klt-mode-expr"
            type="button"
            role="radio"
            aria-checked="true"
            tabindex="0"
            class="klt-seg__btn code-mono">kubectl -l</button
          >
          <button
            id="klt-mode-yaml"
            type="button"
            role="radio"
            aria-checked="false"
            tabindex="-1"
            class="klt-seg__btn code-mono">selector YAML</button
          >
        </div>
        <p class="klt-gloss caption text-mute">
          <strong class="font-medium text-body">Equality-based</strong> clauses (<span
            class="code-mono">=</span
          >, <span class="code-mono">!=</span>) and
          <strong class="font-medium text-body">set-based</strong> ones (<span class="code-mono"
            >in</span
          >, <span class="code-mono">notin</span>, a bare key, <span class="code-mono">!key</span>)
          can be mixed freely in one <span class="code-mono">-l</span> string — commas mean AND. A
          Deployment's <span class="code-mono">spec.selector</span> accepts both forms but is
          immutable after creation; a Service's <span class="code-mono">spec.selector</span> is a
          plain label map and supports equality only.
        </p>
      </div>

      <div class="klt-control klt-control--grow">
        <label class="eyebrow" id="klt-selector-label" for="klt-selector">Selector</label>
        <input
          id="klt-selector"
          class="klt-line code-mono"
          type="text"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          placeholder="app=web,tier=frontend"
          aria-describedby="klt-run-hint"
          value={seedExample?.mode === 'yaml' ? '' : (seedExample?.selector ?? '')}
        />
        <label class="eyebrow sr-only" id="klt-selector-yaml-label" for="klt-selector-yaml"
          >Selector YAML</label
        >
        <textarea
          id="klt-selector-yaml"
          class="klt-area code-mono"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          rows="6"
          placeholder="matchLabels:&#10;  app: web&#10;matchExpressions:&#10;  - key: env&#10;    operator: NotIn&#10;    values: [dev]"
          aria-describedby="klt-run-hint"
          hidden></textarea>
        <p id="klt-canonical" class="klt-canonical caption text-mute" set:html={seedCanonicalHtml} data-results></p>
      </div>
    </div>

    {/* ── Resources editor: the plate under its figure cap ─────────────── */}
    <EditorPane prefix="klt" label="resources.yaml" id="klt-input">
      <pre class="klt-fallback editor-pane__fallback code-mono" data-cm-fallback>{seedExample?.resources}</pre>
    </EditorPane>

    {/* ── Hints + snapshots (on paper) ─────────────────────────────────── */}
    <div class="border-b border-hairline px-4 pt-3 pb-4 sm:px-5">
      <RunHint variant="cm" id="klt-run-hint" />
      <p class="klt-hint caption text-mute">
        Paste one manifest, a <span class="code-mono">---</span> stream, a
        <span class="code-mono">kind: List</span> or a YAML list.
      </p>
      <SnapshotBar prefix="klt" />
    </div>

    {/* ── Verdicts — the L2 instrument; the live summary reads out in the
        figure cap's actions slot. ────────────────────────────────────── */}
    <ResultPanel slug="kubernetes-label-selector-tester" prefix="klt" summary={seedSummary} label="Verdicts" split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="klt-share" />
        <CopyButton kind="all" id="klt-copy-all" label="Copy report" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so every per-resource verdict
          is in the static HTML; the script repaints this same node on each run. */}
      <div id="klt-results" class="klt-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* ── Selector row (paper) ────────────────────────────────────────────── */
  .klt-controls {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 900px) {
    .klt-controls {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
    }
  }
  .klt-control {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 6px;
  }
  .klt-seg {
    display: inline-flex;
    flex-wrap: wrap;
    align-self: flex-start;
    max-width: 100%;
    padding: 2px;
    border-radius: var(--radius-md);
    background: var(--color-canvas-soft-2);
    box-shadow: var(--shadow-hairline);
  }
  .klt-seg__btn {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--color-mute);
    font-size: 12px;
    line-height: 16px;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    white-space: nowrap;
    touch-action: manipulation;
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      color var(--dur-fast) var(--ease-brand);
  }
  .klt-seg__btn:hover {
    color: var(--color-body);
  }
  .klt-seg__btn[aria-checked='true'] {
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
  }
  .klt-seg__btn:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  @media (pointer: coarse) {
    .klt-seg__btn {
      min-height: var(--control-h-md);
    }
  }
  .klt-gloss {
    margin: 0;
    font-size: 12px;
    line-height: 17px;
    text-wrap: pretty;
  }
  .klt-line,
  .klt-area {
    width: 100%;
    padding: 9px 12px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 13px;
    line-height: 20px;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .klt-area {
    min-height: 118px;
    resize: vertical;
  }
  .klt-line::placeholder,
  .klt-area::placeholder {
    color: var(--color-mute);
  }
  .klt-line:hover,
  .klt-area:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .klt-line:focus,
  .klt-area:focus {
    outline: none;
  }
  .klt-line:focus-visible,
  .klt-area:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .klt-line[aria-invalid='true'],
  .klt-area[aria-invalid='true'] {
    box-shadow: inset 0 0 0 2px var(--color-error);
  }
  .klt-canonical {
    margin: 0;
    min-height: 17px;
    font-size: 12px;
    line-height: 17px;
    overflow-wrap: anywhere;
  }
  .klt-canonical :global(.code-mono) {
    font-size: 12px;
    color: var(--color-body);
  }

  .klt-hint {
    margin-top: 4px;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .klt-hint .code-mono {
    font-size: 12px;
  }

  /* The build-time stand-in for the editor (global .editor-pane__fallback
     matches the CodeMirror metrics), held to the editor's scroller box and
     wrapped like its lineWrapping so the swap does not jump. */
  .klt-fallback {
    min-height: 230px;
    max-height: 420px;
    overflow: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  /* Invalid input: a hairline slab-red rule down the editor, never a flash.
     The pane root is EditorPane's (no scope hash), hence :global. */
  .klt-pg :global([data-editor-pane][data-invalid] .cm-editor) {
    box-shadow: inset 2px 0 0 0 var(--color-inverse-error);
  }

  .klt-results {
    min-height: 120px;
  }
  .klt-pg :global(.result-panel__summary.text-inverse-error) {
    color: var(--color-inverse-error);
  }

  /* ── Runtime-injected markup (render.ts) — on the slab, so slab inks only.
     Anchored on this component's own `.klt-results` container (the panel
     wrapper is ResultPanel's and carries no scope attribute). ─────────── */
  .klt-results :global(.klt-card) {
    margin-top: 12px;
    border-radius: var(--radius-md);
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    overflow: hidden;
    animation: klt-rise var(--dur-base) var(--ease-brand) both;
  }
  .klt-results :global(.klt-card:first-child) {
    margin-top: 0;
  }
  .klt-results :global(.klt-card__head) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 9px 10px 9px 14px;
    border-bottom: 1px solid var(--color-inverse-hairline);
  }
  /* MATCH / NO MATCH: the row-key role (label-field), tinted in slab inks. */
  .klt-results :global(.klt-verdict) {
    @apply label-field;
    flex: 0 0 auto;
    padding: 1px 8px;
    border-radius: var(--radius-xs);
  }
  .klt-results :global(.klt-verdict--match) {
    background: #8fc97a1f;
    color: var(--color-inverse-brand);
  }
  .klt-results :global(.klt-verdict--miss) {
    background: #ffffff14;
    color: var(--color-inverse-mute);
  }
  .klt-results :global(.klt-name) {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 19px;
    color: var(--color-inverse-fg);
    overflow-wrap: anywhere;
  }
  .klt-results :global(.klt-ns) {
    color: var(--color-inverse-mute);
  }
  .klt-results :global(.klt-card__actions) {
    display: inline-flex;
    align-items: center;
    margin-left: auto;
  }
  .klt-results :global(.klt-labels) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 9px 14px;
    border-bottom: 1px solid #ffffff12;
  }
  .klt-results :global(.klt-label) {
    padding: 1px 7px;
    border-radius: var(--radius-xs);
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 17px;
    color: var(--color-inverse-fg);
    overflow-wrap: anywhere;
  }
  .klt-results :global(.klt-label--none) {
    background: transparent;
    box-shadow: none;
    color: var(--color-inverse-mute);
    font-family: var(--font-sans);
  }
  /* A key the document carries whose value YAML did not read as a string. */
  .klt-results :global(.klt-label--unreadable) {
    color: var(--color-inverse-accent);
  }
  .klt-results :global(.klt-path) {
    margin-left: auto;
    align-self: center;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    color: var(--color-inverse-mute);
    /* `spec.jobTemplate.spec.template.metadata.labels` is 44 mono characters —
       nowrap would push the row past a 390px viewport. */
    overflow-wrap: anywhere;
  }
  .klt-results :global(.klt-clauses) {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .klt-results :global(.klt-clause) {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    padding: 8px 14px;
  }
  .klt-results :global(.klt-clause + .klt-clause) {
    border-top: 1px solid #ffffff12;
  }
  .klt-results :global(.klt-clause__mark) {
    flex: 0 0 auto;
    width: 15px;
    margin-top: 1px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 19px;
    text-align: center;
  }
  .klt-results :global(.klt-clause--hold .klt-clause__mark) {
    color: var(--color-inverse-brand);
  }
  .klt-results :global(.klt-clause--fail .klt-clause__mark) {
    color: var(--color-inverse-error);
  }
  .klt-results :global(.klt-clause__body) {
    min-width: 0;
    flex: 1 1 auto;
  }
  .klt-results :global(.klt-req) {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 19px;
    color: var(--color-inverse-fg);
    overflow-wrap: anywhere;
  }
  .klt-results :global(.klt-reason) {
    display: block;
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-inverse-mute);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  /* The "holds because the key is absent" annotation — amber's annotation job. */
  .klt-results :global(.klt-annot) {
    display: block;
    margin-top: 6px;
    padding: 5px 8px;
    border-radius: var(--radius-sm);
    background: #e0a45814;
    color: var(--color-inverse-accent);
    font-size: 12px;
    line-height: 17px;
    text-wrap: pretty;
  }
  .klt-results :global(.klt-issue),
  .klt-results :global(.klt-note) {
    margin: 0;
    padding: 9px 14px;
    border-top: 1px solid #ffffff12;
    font-size: 12px;
    line-height: 17px;
    color: var(--color-inverse-mute);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  .klt-results :global(.klt-diag) {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 9px 14px;
  }
  .klt-results :global(.klt-diag + .klt-diag) {
    border-top: 1px solid #ffffff12;
  }
  .klt-results :global(.klt-diag__pill) {
    @apply label-field;
    flex: 0 0 auto;
    padding: 1px 7px;
    border-radius: var(--radius-xs);
  }
  .klt-results :global(.klt-diag__pill--error) {
    background: #ff9d951f;
    color: var(--color-inverse-error);
  }
  .klt-results :global(.klt-diag__pill--warning) {
    background: #e0a4581f;
    color: var(--color-inverse-accent);
  }
  .klt-results :global(.klt-diag__pill--note) {
    background: #ffffff14;
    color: var(--color-inverse-mute);
  }
  .klt-results :global(.klt-diag__text) {
    margin: 0;
    min-width: 0;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-inverse-fg);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  /* Group-heading role (a sans heading over its rows, not one more label). */
  .klt-results :global(.klt-group__head) {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 9px 14px;
    border-bottom: 1px solid var(--color-inverse-hairline);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    color: var(--color-inverse-fg);
  }
  .klt-results :global(.klt-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .klt-results :global(.klt-error + .klt-card) {
    margin-top: 12px;
  }
  .klt-results :global(.klt-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  .klt-results :global(.klt-error__title) {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  .klt-results :global(.klt-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 19px;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .klt-results :global(.klt-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 96px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-mute);
  }

  /* Per-row copy (render.ts emits the button; playground-kit/copy.ts runs the
     feedback cycle and marks success with [data-copied]). */
  .klt-results :global(.klt-copy) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-inverse-mute);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      color var(--dur-fast) var(--ease-brand),
      background-color var(--dur-fast) var(--ease-brand);
  }
  .klt-results :global(.klt-copy:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .klt-results :global(.klt-copy[data-copied]) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
  .klt-results :global(.klt-copy:focus-visible) {
    outline: 2px solid var(--color-inverse-brand);
    outline-offset: 1px;
  }
  @media (pointer: coarse) {
    .klt-results :global(.klt-copy) {
      width: var(--control-h-lg);
      height: var(--control-h-lg);
    }
  }

  @keyframes klt-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .klt-results :global(.klt-card) {
      animation: none;
    }
  }
</style>

<script>
  import { copyTextToClipboard } from '../lib/clipboard';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';
  import { copyButtonFor, copyFromButton, setCopyStatus } from '../lib/playground-kit/copy';
  import { syncChipsByIndex, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { wireRunKeys } from '../lib/run-keys';
  import type { EditorView } from '@codemirror/view';
  // The pure HTML/text builders, shared with this component's frontmatter so the
  // server-rendered seed and every client repaint come from one implementation.
  import {
    EMPTY_HTML,
    canonicalHtml,
    errorHtml,
    reportText,
    resultHtml,
  } from '../lib/kubernetes-label-selector-tester/render';
  import type {
    Diagnostic,
    SelectorTestResult as Result,
  } from '../lib/kubernetes-label-selector-tester/types';

  /* ---- Engine contract ------------------------------------------------------
     Result shapes are imported above, never hand-mirrored. What stays here is
     the shape of the LAZY module handle and of the values this island owns
     (the share payload, the example rows), which have no engine counterpart. */
  type SelectorMode = 'expr' | 'yaml';
  type Example = {
    id: string;
    label: string;
    resources: string;
    selector: string;
    mode: SelectorMode;
  };
  type ShareState = { resources: string; selector: string; mode: SelectorMode };
  type EngineModule = {
    testSelector: (resources: string, selector: string, mode: SelectorMode) => Result;
    encodeState: (state: ShareState) => string;
    decodeState: (hash: string) => ShareState | null;
  };

  const ROOT_SEL = '.klt-pg';
  const SLUG = 'kubernetes-label-selector-tester';
  /* One debounce, inside the contract's 130–220ms band. */
  const DEBOUNCE_MS = 170;
  /* Nothing goes red until the typing has been idle this long. */
  const ERROR_HOLD_MS = 600;
  /* Past ~2000 chars a fragment stops being a dependable URL (browser, proxy and
     chat-client limits), so we neither write it nor offer the share link — the
     tester itself keeps working on pastes of any size. */
  const MAX_HASH_LEN = 2000;
  /* DOM caps. The engine is linear and already caps at 500 resources; rendering
     500 cards × 100 clauses is what freezes the tab. Every cap states itself. */

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.kltWired === 'true') return;
      root.dataset.kltWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  function normaliseExamples(raw: unknown): Example[] {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((item, i) => {
        const o = (item ?? {}) as Record<string, unknown>;
        return {
          id: typeof o.id === 'string' && o.id ? o.id : `example-${i + 1}`,
          label: typeof o.label === 'string' && o.label ? o.label : `Example ${i + 1}`,
          resources: typeof o.resources === 'string' ? o.resources : '',
          selector: typeof o.selector === 'string' ? o.selector : '',
          mode: o.mode === 'yaml' ? 'yaml' : 'expr',
        } satisfies Example;
      })
      .filter((e) => e.resources.length > 0);
  }

  /* ---- Result rendering --------------------------------------------------
     The pure builders live in
     `../lib/kubernetes-label-selector-tester/render`, imported above. Only the
     DOM writes and the copy-payload bindings stay here. */


  /* ---- Instance init ----------------------------------------------------- */

  async function init(root: HTMLElement): Promise<void> {
    const editorHost = el<HTMLElement>(root, '#klt-input');
    const paneEl = el<HTMLElement>(root, '[data-editor-pane]');
    const modeExprBtn = el<HTMLButtonElement>(root, '#klt-mode-expr');
    const modeYamlBtn = el<HTMLButtonElement>(root, '#klt-mode-yaml');
    const exprInput = el<HTMLInputElement>(root, '#klt-selector');
    const yamlInput = el<HTMLTextAreaElement>(root, '#klt-selector-yaml');
    const exprLabel = el<HTMLElement>(root, '#klt-selector-label');
    const yamlLabel = el<HTMLElement>(root, '#klt-selector-yaml-label');
    const canonicalEl = el<HTMLElement>(root, '#klt-canonical');
    const resultsBox = el<HTMLElement>(root, '#klt-results');
    const summaryEl = el<HTMLElement>(root, '#klt-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#klt-share');
    const copyAllBtn = el<HTMLButtonElement>(root, '#klt-copy-all');
    const copyStatus = el<HTMLElement>(root, '#klt-copy-status');
    const snapSaveBtn = el<HTMLButtonElement>(root, '#klt-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#klt-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#klt-snap-delete');
    const chipsWrap = el<HTMLElement>(root, '#klt-chips');
    const chips = Array.from(chipsWrap?.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR) ?? []);

    if (
      !editorHost ||
      !paneEl ||
      !modeExprBtn ||
      !modeYamlBtn ||
      !exprInput ||
      !yamlInput ||
      !exprLabel ||
      !yamlLabel ||
      !canonicalEl ||
      !resultsBox ||
      !summaryEl ||
      !shareBtn ||
      !copyAllBtn ||
      !copyStatus ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    ) {
      return;
    }

    /* ---- Copy plumbing --------------------------------------------------- */

    /**
     * Copy payloads live in JS, not in `data-copy` attributes, for two reasons:
     * multi-line text round-trips badly through an attribute, and — the one that
     * matters for security review — `innerHTML` serialization does not re-escape
     * `<` inside an attribute value, so a correctly-escaped payload in an
     * attribute still shows up as literal markup in the serialized HTML. The
     * buttons still carry an EMPTY `data-copy` so the kit's copy selectors and
     * Layout.astro's `result_copied` listener find them. The row buttons are
     * numbered `data-payload="<i>"` by render.ts into `rowPayloads`.
     */
    let rowPayloads: string[] = [];
    let reportPayload = '';

    function payloadFor(btn: HTMLElement): string {
      if (btn.dataset.payload !== undefined) return rowPayloads[Number(btn.dataset.payload)] ?? '';
      if (btn.hasAttribute('data-copy-all')) return reportPayload;
      return btn.dataset.copy ?? '';
    }

    // The kit's feedback cycle (icon swap, "Copied", the sr-only announcer),
    // fed from the JS-held payload rather than the attribute.
    root.addEventListener('click', (e) => {
      const btn = copyButtonFor(root, e.target) as HTMLElement | null;
      if (!btn) return;
      const payload = payloadFor(btn);
      // Never report success for an empty payload — a ✓ and "Copied to
      // clipboard." over an untouched clipboard is a lie the user acts on.
      if (payload.length === 0) {
        setCopyStatus(copyStatus, 'Nothing to copy yet.', true);
        return;
      }
      void copyFromButton(btn, { status: copyStatus, copy: () => copyTextToClipboard(payload) });
    });

    /* ---- Lazy engine + examples + CodeMirror ----------------------------- */

    let engine: EngineModule;
    let examples: Example[] = [];
    let EditorState: typeof import('@codemirror/state').EditorState;
    let EditorViewCtor: typeof import('@codemirror/view').EditorView;
    let keymap: typeof import('@codemirror/view').keymap;
    let lineNumbers: typeof import('@codemirror/view').lineNumbers;
    let highlightActiveLine: typeof import('@codemirror/view').highlightActiveLine;
    let defaultKeymap: typeof import('@codemirror/commands').defaultKeymap;
    // Named `cmHistory`, not `history`: a bare `history` would shadow
    // `window.history`, which `writeHash` needs for replaceState.
    let cmHistory: typeof import('@codemirror/commands').history;
    let historyKeymap: typeof import('@codemirror/commands').historyKeymap;
    let indentWithTab: typeof import('@codemirror/commands').indentWithTab;
    let yamlLang: typeof import('@codemirror/lang-yaml').yaml;
    let plate: typeof import('../lib/playground-kit/cm-theme').plate;

    try {
      const [engineMod, examplesMod, stateMod, viewMod, commandsMod, yamlMod, themeMod] =
        await Promise.all([
          import('../lib/kubernetes-label-selector-tester/engine'),
          import('../lib/kubernetes-label-selector-tester/examples'),
          import('@codemirror/state'),
          import('@codemirror/view'),
          import('@codemirror/commands'),
          import('@codemirror/lang-yaml'),
          // The plate theme + highlight (the ONE code palette), in the same
          // closure as the language — a static import would pull
          // @codemirror/view into the page shell.
          import('../lib/playground-kit/cm-theme'),
        ]);
      engine = engineMod as unknown as EngineModule;
      examples = normaliseExamples((examplesMod as { examples?: unknown }).examples);
      ({ EditorState } = stateMod);
      ({ EditorView: EditorViewCtor, keymap, lineNumbers, highlightActiveLine } = viewMod);
      ({ history: cmHistory, defaultKeymap, historyKeymap, indentWithTab } = commandsMod);
      ({ yaml: yamlLang } = yamlMod);
      ({ plate } = themeMod);
    } catch (err) {
      summaryEl.textContent = '';
      resultsBox.innerHTML = errorHtml(
        {
          severity: 'error',
          where: 'resources',
          message: 'The selector engine failed to load. Reload the page to try again.',
        },
        true,
      );
      console.error('[K8sLabelSelectorTester] engine/CodeMirror import failed:', err);
      return;
    }

    /* ---- State ----------------------------------------------------------- */

    type EvalSource = 'type' | 'commit' | 'seed';
    type UiState = 'empty' | 'valid' | 'pending' | 'invalid';

    let uiState: UiState = 'empty';
    let mode: SelectorMode = 'expr';
    let evalTimer: number | undefined;
    let errTimer: number | undefined;
    let lastWrittenHash: string | null = null;
    let liveReady = false;

    function clearTimers(): void {
      window.clearTimeout(evalTimer);
      window.clearTimeout(errTimer);
    }

    function selectorField(): HTMLInputElement | HTMLTextAreaElement {
      return mode === 'yaml' ? yamlInput! : exprInput!;
    }
    function selectorText(): string {
      return selectorField().value;
    }

    /* ---- Editor ---------------------------------------------------------- */

    function makeEditor(host: HTMLElement, doc: string): EditorView {
      const state = EditorState.create({
        doc,
        extensions: [
          lineNumbers(),
          cmHistory(),
          highlightActiveLine(),
          yamlLang(),
          plate,
          // This pane's size only; colours, gutter and focus ring are the
          // kit's (cm-theme.ts + global.css .editor-pane__host).
          EditorViewCtor.theme({
            '&': { fontSize: '13px' },
            '.cm-scroller': { minHeight: '230px', maxHeight: '420px', scrollbarWidth: 'thin' },
          }),
          EditorViewCtor.lineWrapping,
          // CodeMirror puts role="textbox" on the content DOM; without a name
          // that is an unlabelled input field for a screen reader (and an axe
          // violation). aria-describedby points at the live-eval hint line.
          EditorViewCtor.contentAttributes.of({
            'aria-label': 'Kubernetes resources, as YAML',
            'aria-describedby': 'klt-run-hint',
          }),
          keymap.of([
            // Ours FIRST, so they win over defaultKeymap's Enter/Escape.
            {
              key: 'Mod-Enter',
              run: () => {
                clearTimers();
                evaluate('commit');
                view.contentDOM.blur();
                return true;
              },
            },
            {
              // Plain Enter must still insert the newline, so this returns false
              // and lets insertNewlineAndIndent run — the eval is flushed on the
              // next tick, once the document includes the newline.
              //
              // It flushes as 'type', NOT 'commit': in a multi-line YAML editor
              // Enter means "newline", so every line break in a half-typed
              // manifest used to fire an assertive role="alert" card and the red
              // rail mid-composition. 'type' keeps the immediate re-render and
              // keeps the 600 ms calm-error hold. Mod-Enter above is the
              // deliberate commit, as the hint line says.
              key: 'Enter',
              run: () => {
                window.setTimeout(() => {
                  clearTimers();
                  evaluate('type');
                }, 0);
                return false;
              },
            },
            {
              // The Tab-trap escape hatch: indentWithTab means Tab indents, so
              // Escape is the documented way out of the editor.
              key: 'Escape',
              run: (v) => {
                v.contentDOM.blur();
                return true;
              },
            },
            ...defaultKeymap,
            ...historyKeymap,
            indentWithTab,
          ]),
          EditorViewCtor.updateListener.of((u) => {
            if (!u.docChanged || !liveReady) return;
            setActiveChip(null);
            clearTimers();
            evalTimer = window.setTimeout(() => evaluate('type'), DEBOUNCE_MS);
          }),
        ],
      });
      return new EditorViewCtor({ state, parent: host });
    }

    function setEditorDoc(doc: string): void {
      view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: doc } });
      view.requestMeasure();
    }

    /* ---- Chrome ---------------------------------------------------------- */

    function setSummary(text: string, isError: boolean): void {
      summaryEl!.textContent = text;
      summaryEl!.classList.toggle('text-inverse-error', isError);
      summaryEl!.classList.toggle('text-inverse-mute', !isError);
    }

    /** Red only on the field that is actually wrong — never on both. */
    function setErrorState(where: 'selector' | 'resources' | null): void {
      const onResources = where === 'resources';
      paneEl!.toggleAttribute('data-invalid', onResources);
      if (onResources) {
        view.contentDOM.setAttribute('aria-invalid', 'true');
        view.contentDOM.setAttribute('aria-describedby', 'klt-run-hint klt-error-detail');
      } else {
        view.contentDOM.removeAttribute('aria-invalid');
        view.contentDOM.setAttribute('aria-describedby', 'klt-run-hint');
      }
      // BOTH selector fields are cleared every time: switching grammar while an
      // error is showing would otherwise leave the hidden field flagged, and it
      // would still be flagged the next time it became visible.
      for (const field of [exprInput!, yamlInput!]) {
        field.removeAttribute('aria-invalid');
        field.setAttribute('aria-describedby', 'klt-run-hint');
      }
      if (where === 'selector') {
        const field = selectorField();
        field.setAttribute('aria-invalid', 'true');
        field.setAttribute('aria-describedby', 'klt-run-hint klt-error-detail');
      }
    }

    function hideActions(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
      copyAllBtn!.hidden = true;
      reportPayload = '';
      // `rowPayloads` is deliberately NOT cleared: this runs from the `pending`
      // branch with the previous verdict cards — and their per-row copy buttons
      // — still on screen. Emptying it made those buttons announce "Copied to
      // clipboard." and copy nothing.
    }

    function setActiveChip(idx: number | null): void {
      syncChipsByIndex(chipsWrap, idx);
    }

    function setCanonical(result: Result | null): void {
      canonicalEl!.innerHTML = result === null ? '' : canonicalHtml(result);
    }

    function applyModeChrome(): void {
      modeExprBtn!.setAttribute('aria-checked', mode === 'expr' ? 'true' : 'false');
      modeYamlBtn!.setAttribute('aria-checked', mode === 'yaml' ? 'true' : 'false');
      modeExprBtn!.tabIndex = mode === 'expr' ? 0 : -1;
      modeYamlBtn!.tabIndex = mode === 'yaml' ? 0 : -1;
      exprInput!.hidden = mode !== 'expr';
      yamlInput!.hidden = mode !== 'yaml';
      // Only the visible field's label is visible; the hidden one stays sr-only
      // so the field it names is still announced when it becomes visible.
      exprLabel!.classList.toggle('sr-only', mode !== 'expr');
      yamlLabel!.classList.toggle('sr-only', mode !== 'yaml');
    }

    /* ---- Deep link ------------------------------------------------------- */

    function currentFragment(): string {
      try {
        return engine.encodeState({
          resources: view.state.doc.toString(),
          selector: selectorText(),
          mode,
        });
      } catch {
        return '';
      }
    }

    function writeHash(fragment: string | null): void {
      const target = fragment ?? '';
      if (target === lastWrittenHash) return;
      // Safari throttles replaceState (~100 per 30s) and throws — never let that
      // break typing.
      try {
        if (fragment) {
          window.history.replaceState(null, '', fragment);
        } else {
          window.history.replaceState(null, '', location.pathname + location.search);
        }
        lastWrittenHash = target;
      } catch {
        /* ignore */
      }
    }

    /* ---- Render ---------------------------------------------------------- */

    function renderEmpty(): void {
      uiState = 'empty';
      setErrorState(null);
      hideActions();
      setSummary('', false);
      setCanonical(null);
      resultsBox!.innerHTML = EMPTY_HTML;
    }

    function renderResult(result: Result): void {
      // The builder returns the per-row copy payloads alongside the markup, so
      // the two can never fall out of step (the server ignores the payloads).
      const rendered = resultHtml(result);
      resultsBox!.innerHTML = rendered.html;
      rowPayloads = rendered.payloads;
      reportPayload = reportText(result, selectorText());
      copyAllBtn!.hidden = false;
    }

    function showError(result: Result, source: EvalSource): void {
      uiState = 'invalid';
      clearTimers();
      const first =
        result.diagnostics.find((d) => d.severity === 'error') ??
        ({
          severity: 'error',
          where: 'resources',
          message: 'The tester could not read this input.',
        } as Diagnostic);
      setErrorState(first.where === 'selector' ? 'selector' : 'resources');
      hideActions();
      setSummary(result.summary, true);
      setCanonical(null);
      const rest = result.diagnostics.filter((d) => d !== first);
      resultsBox!.innerHTML = errorHtml(first, source === 'commit', rest);
      if (source !== 'seed') writeHash(null);
    }

    function evaluate(source: EvalSource): void {
      clearTimers();
      const resourcesText = view.state.doc.toString();
      if (resourcesText.trim().length === 0) {
        renderEmpty();
        if (source !== 'seed') writeHash(null);
        return;
      }

      let result: Result | null = null;
      try {
        result = engine.testSelector(resourcesText, selectorText(), mode);
      } catch (err) {
        console.error('[K8sLabelSelectorTester] testSelector threw:', err);
        result = null;
      }

      if (result && result.ok) {
        uiState = 'valid';
        setErrorState(null);
        renderResult(result);
        setCanonical(result);
        setSummary(result.summary, false);

        const fragment = currentFragment();
        if (fragment.length > 0 && fragment.length <= MAX_HASH_LEN) {
          shareBtn!.hidden = false;
          shareBtn!.dataset.copy = location.origin + location.pathname + location.search + fragment;
          // Gated on BOTH a fully valid run AND a user-initiated eval: a boot
          // seed must never write the URL or the restore store.
          if (source !== 'seed') {
            writeHash(fragment);
            recordToolLastInput(SLUG, fragment);
          }
        } else {
          // Too long to be a dependable link: keep testing, drop the share.
          shareBtn!.hidden = true;
          shareBtn!.dataset.copy = '';
          if (source !== 'seed') writeHash(null);
        }
        return;
      }

      const failed: Result =
        result ??
        ({
          ok: false,
          mode,
          requirements: [],
          canonical: '',
          empty: false,
          verdicts: [],
          matchCount: 0,
          resourceCount: 0,
          totalResources: 0,
          truncated: false,
          diagnostics: [
            {
              severity: 'error',
              where: 'resources',
              message: 'The tester hit an unexpected error on this input.',
            },
          ],
          summary: 'Not evaluated — 1 error',
        } as Result);

      if (source !== 'type') {
        showError(failed, source);
        return;
      }

      // Mid-typing: hold the previous panel, nothing goes red yet. The error only
      // surfaces once the typing has been idle for ERROR_HOLD_MS.
      uiState = 'pending';
      setErrorState(null);
      hideActions();
      setSummary('', false);
      errTimer = window.setTimeout(() => showError(failed, 'type'), ERROR_HOLD_MS);
    }

    /* ---- Seed (before any listener fires, so nothing writes the hash) ---- */

    const firstExample = examples[0];
    let seedResources = firstExample?.resources ?? '';
    let seedChip: number | null = firstExample ? 0 : null;
    if (firstExample) {
      mode = firstExample.mode;
      if (firstExample.mode === 'yaml') yamlInput.value = firstExample.selector;
      else exprInput.value = firstExample.selector;
    }

    function applyShareState(state: ShareState): void {
      mode = state.mode === 'yaml' ? 'yaml' : 'expr';
      if (mode === 'yaml') yamlInput!.value = state.selector;
      else exprInput!.value = state.selector;
      seedResources = state.resources;
      seedChip = null;
    }

    let fromHash = false;
    try {
      const shared = engine.decodeState(window.location.hash);
      if (shared && shared.resources.trim().length > 0) {
        applyShareState(shared);
        fromHash = true;
      }
    } catch {
      /* malformed fragment — fall through to the restore/example tiers */
    }
    if (!fromHash) {
      const restored = getRestoredLastInput(SLUG);
      if (restored) {
        try {
          const state = engine.decodeState(restored);
          if (state && state.resources.trim().length > 0) applyShareState(state);
        } catch {
          /* malformed stored value — keep the example seed */
        }
      }
    }

    const view = makeEditor(editorHost, seedResources);

    // The build-time text stand-in has done its job (no-JS visitors and
    // crawlers); CodeMirror appended its editor beside it, so drop it.
    root.querySelectorAll('[data-cm-fallback]').forEach((node) => node.remove());
    applyModeChrome();
    setActiveChip(seedChip);

    /* ---- Events ---------------------------------------------------------- */

    function setMode(next: SelectorMode, focus: boolean): void {
      if (mode !== next) {
        mode = next;
        applyModeChrome();
        setActiveChip(null);
        clearTimers();
        evaluate('commit');
      }
      if (focus) (next === 'expr' ? modeExprBtn! : modeYamlBtn!).focus();
    }

    modeExprBtn.addEventListener('click', () => setMode('expr', false));
    modeYamlBtn.addEventListener('click', () => setMode('yaml', false));

    // WAI-ARIA radio group keyboard pattern: arrows move AND select; Home/End
    // jump to the ends.
    function onModeKeydown(e: KeyboardEvent): void {
      switch (e.key) {
        case 'ArrowRight':
        case 'ArrowDown':
        case 'ArrowLeft':
        case 'ArrowUp':
          e.preventDefault();
          setMode(mode === 'expr' ? 'yaml' : 'expr', true);
          break;
        case 'Home':
          e.preventDefault();
          setMode('expr', true);
          break;
        case 'End':
          e.preventDefault();
          setMode('yaml', true);
          break;
      }
    }
    modeExprBtn.addEventListener('keydown', onModeKeydown);
    modeYamlBtn.addEventListener('keydown', onModeKeydown);

    for (const field of [exprInput, yamlInput]) {
      field.addEventListener('input', () => {
        setActiveChip(null);
        clearTimers();
        evalTimer = window.setTimeout(() => evaluate('type'), DEBOUNCE_MS);
      });
      // The shared keyboard contract (src/lib/run-keys.ts): ⌘/Ctrl+Enter always
      // runs (and releases focus on a coarse pointer); plain Enter runs in the
      // one-line field and, in the textarea, lands its newline first. It also
      // respects IME composition and Shift+Enter.
      wireRunKeys(
        field,
        () => {
          clearTimers();
          evaluate('commit');
        },
        { enter: field instanceof HTMLTextAreaElement ? 'insert-then-run' : 'run' },
      );
      // Committing on blur means a half-typed selector that the user tabbed away
      // from still explains itself, instead of sitting silently in `pending`.
      field.addEventListener('blur', () => {
        if (uiState === 'pending') {
          clearTimers();
          evaluate('commit');
        }
      });
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const idx = Number(chip.dataset.exampleIdx);
        if (!Number.isInteger(idx) || idx < 0 || idx >= examples.length) return;
        const example = examples[idx];
        mode = example.mode;
        if (mode === 'yaml') yamlInput!.value = example.selector;
        else exprInput!.value = example.selector;
        applyModeChrome();
        liveReady = false;
        setEditorDoc(example.resources);
        liveReady = true;
        setActiveChip(idx);
        clearTimers();
        evaluate('commit');
      });
    });

    view.contentDOM.addEventListener('blur', () => {
      if (uiState === 'pending') {
        clearTimers();
        evaluate('commit');
      }
    });

    wireSnapshotUI({
      slug: SLUG,
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      // The snapshot payload is the same `#s=` fragment the share link uses, so
      // the grammar toggle and the selector come back with the resources.
      getValue: () => currentFragment(),
      setValue: (value) => {
        let state: ShareState | null = null;
        try {
          state = engine.decodeState(value);
        } catch {
          return;
        }
        if (!state) return;
        mode = state.mode === 'yaml' ? 'yaml' : 'expr';
        if (mode === 'yaml') yamlInput!.value = state.selector;
        else exprInput!.value = state.selector;
        applyModeChrome();
        liveReady = false;
        setEditorDoc(state.resources);
        liveReady = true;
        setActiveChip(null);
        clearTimers();
        evaluate('commit');
      },
    });

    /* ---- First render: never writes the hash ---------------------------- */

    evaluate('seed');
    liveReady = true;
    requestAnimationFrame(() => view.requestMeasure());
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
