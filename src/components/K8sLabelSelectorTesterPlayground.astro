---
/**
 * K8sLabelSelectorTesterPlayground — the Kubernetes Label Selector Tester island.
 *
 * TWO inputs, deliberately asymmetric:
 *   · the RESOURCES pane is a CodeMirror YAML editor — it takes a whole
 *     `kubectl get pods -o yaml` paste;
 *   · the SELECTOR row is one line. A segmented toggle swaps between the
 *     `kubectl -l` string (single-line `<input>`) and structured selector YAML
 *     (a six-row `<textarea>` — NOT a second CodeMirror: a six-line document
 *     does not earn another editor runtime).
 *
 * The results are the product: one card per resource with a MATCH / NO MATCH
 * chip and then the clause-by-clause trace, each clause carrying the reason the
 * engine produced. Clauses that hold BECAUSE the key is absent get an amber
 * annotation, because `NotIn`/`!=` matching a resource that has no such label is
 * the one piece of apimachinery semantics people answer backwards.
 *
 * UX contract (CLAUDE.md), ported from `CidrCheckerPlayground` /
 * `DockerfileLinterPlayground`: example chips at `var(--radius-pill)`, ONE ~170ms
 * debounce with the exact hint line, a ~600ms calm-error hold before anything
 * goes red, per-row copy + `data-copy-all` + `data-copy-link`, a single visible
 * `role="status"` summary plus an sr-only copy-status span, a results container
 * that is NOT `aria-live`, glossary captions instead of tooltips, and
 * `escapeHtml()` on every injected value — attribute contexts included.
 *
 * Deep link + snapshots both carry the SAME `#s=` payload (resources + selector
 * + mode), so a restored snapshot brings the grammar toggle back with it. The
 * hash is written ONLY on a user-initiated eval that came back fully valid — a
 * boot seed never writes it, and neither does a run with an error diagnostic.
 *
 * Runtime contract (lazy-imported inside the boot closure so the engine and the
 * CodeMirror runtime code-split away from the page shell):
 *   ../lib/kubernetes-label-selector-tester/engine   → testSelector, encodeState, decodeState
 *   ../lib/kubernetes-label-selector-tester/examples → examples: SelectorExample[]
 *
 * Only the example LABELS are read at build time (so the chips are
 * server-rendered and exist before hydration); the manifests themselves come
 * from the lazy import by index, which keeps multi-line YAML out of HTML
 * attributes entirely.
 */
import { examples } from '../lib/kubernetes-label-selector-tester/examples';
---

<section class="klt-pg" aria-label="Kubernetes Label Selector Tester playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Example chips ────────────────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow shrink-0">Examples</span>
      <div id="klt-chips" class="klt-chips" role="group" aria-label="Examples">
        {
          examples.map((ex, i) => (
            <button type="button" class="klt-chip" data-example-idx={String(i)} aria-pressed="false">
              {ex.label}
            </button>
          ))
        }
      </div>
    </div>

    {/* ── Selector row ─────────────────────────────────────────────────── */}
    <div class="klt-controls border-b border-hairline px-4 py-4 sm:px-5">
      <div class="klt-control">
        <span class="eyebrow" id="klt-mode-label">Selector grammar</span>
        <div class="klt-seg" role="radiogroup" aria-labelledby="klt-mode-label">
          <button
            id="klt-mode-expr"
            type="button"
            role="radio"
            aria-checked="true"
            tabindex="0"
            class="klt-seg__btn code-mono">kubectl -l</button
          >
          <button
            id="klt-mode-yaml"
            type="button"
            role="radio"
            aria-checked="false"
            tabindex="-1"
            class="klt-seg__btn code-mono">selector YAML</button
          >
        </div>
        <p class="klt-gloss caption text-mute">
          <strong class="font-medium text-body">Equality-based</strong> clauses (<span
            class="code-mono">=</span
          >, <span class="code-mono">!=</span>) and
          <strong class="font-medium text-body">set-based</strong> ones (<span class="code-mono"
            >in</span
          >, <span class="code-mono">notin</span>, a bare key, <span class="code-mono">!key</span>)
          can be mixed freely in one <span class="code-mono">-l</span> string — commas mean AND. A
          Deployment's <span class="code-mono">spec.selector</span> accepts both forms but is
          immutable after creation; a Service's <span class="code-mono">spec.selector</span> is a
          plain label map and supports equality only.
        </p>
      </div>

      <div class="klt-control klt-control--grow">
        <label class="eyebrow" id="klt-selector-label" for="klt-selector">Selector</label>
        <input
          id="klt-selector"
          class="klt-line code-mono"
          type="text"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          placeholder="app=web,tier=frontend"
          aria-describedby="klt-run-hint"
        />
        <label class="eyebrow sr-only" id="klt-selector-yaml-label" for="klt-selector-yaml"
          >Selector YAML</label
        >
        <textarea
          id="klt-selector-yaml"
          class="klt-area code-mono"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          rows="6"
          placeholder="matchLabels:&#10;  app: web&#10;matchExpressions:&#10;  - key: env&#10;    operator: NotIn&#10;    values: [dev]"
          aria-describedby="klt-run-hint"
          hidden></textarea>
        <p id="klt-canonical" class="klt-canonical caption text-mute"></p>
      </div>
    </div>

    {/* ── Resources editor (dark instrument slab) ──────────────────────── */}
    <div class="klt-pane bg-inverse">
      <div class="klt-pane__bar">
        <span class="flex shrink-0 items-center gap-1.5" aria-hidden="true">
          <span class="klt-pane__dot"></span>
          <span class="klt-pane__dot"></span>
          <span class="klt-pane__dot"></span>
        </span>
        <span class="klt-pane__name code-mono">resources.yaml</span>
        <span class="klt-pane__tag code-mono">input</span>
      </div>
      <div id="klt-input" class="klt-editor"></div>
    </div>

    {/* ── Hints + snapshots ────────────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 pt-3 pb-4 sm:px-5">
      <p id="klt-run-hint" class="klt-hint caption text-mute">
        Results update as you type — press Enter to run now.
      </p>
      <p class="klt-hint caption text-mute">
        Paste one manifest, a <span class="code-mono">---</span> stream, a
        <span class="code-mono">kind: List</span> or a YAML list. Press
        <kbd class="klt-kbd">Esc</kbd> to release keyboard focus from the editor;
        <kbd class="klt-kbd">⌘</kbd>/<kbd class="klt-kbd">Ctrl</kbd> +
        <kbd class="klt-kbd">Enter</kbd> runs and leaves it. Nothing you paste is uploaded.
      </p>
      <div class="klt-snap-row mt-3 flex flex-wrap items-center gap-2">
        <button id="klt-snap-save" type="button" class="klt-snap-btn">Save snapshot</button>
        <select
          id="klt-snap-select"
          class="klt-snap-select"
          aria-label="Load a saved snapshot"
          disabled
        >
          <option value="">No snapshots yet</option>
        </select>
        <button
          id="klt-snap-delete"
          type="button"
          class="klt-snap-delete"
          aria-label="Delete this snapshot"
          hidden>&times;</button
        >
      </div>
    </div>

    {/* ── Verdicts ─────────────────────────────────────────────────────── */}
    <div class="bg-canvas-soft px-4 py-4 sm:px-5">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
        <span class="flex flex-wrap items-center gap-2">
          <span class="eyebrow">Verdicts</span>
          <button
            id="klt-share"
            type="button"
            class="klt-copy klt-copy--labeled"
            data-copy-link
            data-copy=""
            data-copy-label="Copy link"
            hidden
          >
            <svg
              class="klt-copy-icon"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6.75 9.25l2.5-2.5"></path>
              <path d="M8.75 4.25l1.5-1.5a2.47 2.47 0 0 1 3.5 3.5l-1.5 1.5"></path>
              <path d="M7.25 11.75l-1.5 1.5a2.47 2.47 0 0 1-3.5-3.5l1.5-1.5"></path>
            </svg>
            <svg
              class="klt-check-icon hidden"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 8.5l3.5 3.5L13 4.5"></path>
            </svg>
            <span class="klt-copy-label">Copy link</span>
          </button>
          <button
            id="klt-copy-all"
            type="button"
            class="klt-copy klt-copy--labeled"
            data-copy-all
            data-copy=""
            data-copy-label="Copy report"
            hidden
          >
            <svg
              class="klt-copy-icon"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="5" y="5" width="9" height="9" rx="1.5"></rect>
              <path d="M3 11H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v1"></path>
            </svg>
            <svg
              class="klt-check-icon hidden"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 8.5l3.5 3.5L13 4.5"></path>
            </svg>
            <span class="klt-copy-label">Copy report</span>
          </button>
        </span>
        <span id="klt-summary" class="klt-summary code-mono text-mute" role="status" aria-live="polite"
        ></span>
      </div>
      <div id="klt-results" class="klt-results">
        <p class="klt-empty body-sm text-mute">
          Paste the resources above — or tap an example — to see, per resource, whether the selector
          matches it and which clause decided.
        </p>
      </div>
      <span id="klt-copy-status" class="sr-only" role="status" aria-live="polite"></span>
    </div>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* ── Example chips ───────────────────────────────────────────────────── */
  .klt-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .klt-chip {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border: none;
    border-radius: var(--radius-pill);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-brand-strong);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      background 0.12s ease,
      box-shadow 0.12s ease;
  }
  .klt-chip:hover,
  .klt-chip[aria-pressed='true'] {
    background: var(--color-brand-soft);
    box-shadow: inset 0 0 0 1px var(--color-brand);
  }
  .klt-chip:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }

  /* ── Selector row ────────────────────────────────────────────────────── */
  .klt-controls {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 900px) {
    .klt-controls {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
    }
  }
  .klt-control {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 6px;
  }
  .klt-seg {
    display: inline-flex;
    flex-wrap: wrap;
    align-self: flex-start;
    max-width: 100%;
    padding: 2px;
    border-radius: var(--radius-md);
    background: var(--color-canvas-soft-2);
    box-shadow: var(--shadow-hairline);
  }
  .klt-seg__btn {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--color-mute);
    font-size: 12px;
    line-height: 16px;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    white-space: nowrap;
    touch-action: manipulation;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .klt-seg__btn:hover {
    color: var(--color-body);
  }
  .klt-seg__btn[aria-checked='true'] {
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
  }
  .klt-seg__btn:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  .klt-gloss {
    margin: 0;
    font-size: 12px;
    line-height: 17px;
    text-wrap: pretty;
  }
  .klt-line,
  .klt-area {
    width: 100%;
    padding: 9px 12px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 13px;
    line-height: 20px;
    transition: box-shadow 0.15s ease;
  }
  .klt-area {
    min-height: 118px;
    resize: vertical;
  }
  .klt-line::placeholder,
  .klt-area::placeholder {
    color: var(--color-mute);
  }
  .klt-line:hover,
  .klt-area:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .klt-line:focus,
  .klt-area:focus {
    outline: none;
  }
  .klt-line:focus-visible,
  .klt-area:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .klt-line[aria-invalid='true'],
  .klt-area[aria-invalid='true'] {
    box-shadow: inset 0 0 0 2px var(--color-error);
  }
  .klt-canonical {
    margin: 0;
    min-height: 17px;
    font-size: 12px;
    line-height: 17px;
    overflow-wrap: anywhere;
  }
  .klt-canonical .code-mono {
    font-size: 12px;
    color: var(--color-body);
  }

  /* ── Resources pane (dark instrument slab) ───────────────────────────── */
  .klt-pane {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }
  .klt-pane__bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .klt-pane__dot {
    width: 9px;
    height: 9px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.18);
  }
  .klt-pane__name {
    /* 0.72 alpha over --color-inverse clears 4.5:1 in both themes. */
    color: rgba(255, 255, 255, 0.72);
    font-size: 12px;
  }
  .klt-pane__tag {
    margin-left: auto;
    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* CodeMirror host. Background stays transparent so the slab shows through:
     One Dark's own #282c34 is LIGHTER than --color-inverse, and its dimmest
     token only clears 4.5:1 against the darker slab. */
  .klt-editor {
    overflow: hidden;
    padding-inline: 4px;
  }
  .klt-editor :global(.cm-editor) {
    background: transparent;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
  }
  .klt-editor :global(.cm-editor.cm-focused) {
    outline: 2px solid var(--color-link);
    outline-offset: -2px;
  }
  .klt-editor :global(.cm-scroller) {
    overflow: auto;
    min-height: 230px;
    max-height: 420px;
    font-family: var(--font-mono);
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.22) transparent;
  }
  .klt-editor :global(.cm-scroller)::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }
  .klt-editor :global(.cm-scroller)::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-pill);
    border: 3px solid transparent;
    background-clip: content-box;
  }
  .klt-editor :global(.cm-gutters) {
    background: transparent;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
  }
  /* One Dark's gutter foreground is below 4.5:1 on this slab — lift it. */
  .klt-editor :global(.cm-lineNumbers .cm-gutterElement) {
    color: #a9a39a;
  }
  .klt-editor :global(.cm-content) {
    padding: 14px 0 16px;
  }
  .klt-editor :global(.cm-line) {
    padding-inline: 4px;
  }
  /* Invalid input: a hairline red rule down the editor, never a flash. */
  .klt-pane.klt-pane--error .klt-editor :global(.cm-editor) {
    box-shadow: inset 2px 0 0 0 var(--color-error);
  }

  .klt-hint {
    margin-top: 8px;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .klt-hint + .klt-hint {
    margin-top: 4px;
  }
  .klt-hint .code-mono {
    font-size: 12px;
  }
  .klt-kbd {
    border: 1px solid currentColor;
    border-radius: var(--radius-xs);
    padding: 0 3px;
    font-size: 0.85em;
  }

  /* ── Snapshot row ────────────────────────────────────────────────────── */
  .klt-snap-btn {
    flex: 0 0 auto;
    height: 30px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    border: none;
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-size: 12.5px;
    cursor: pointer;
    transition:
      background 0.12s ease,
      box-shadow 0.12s ease;
  }
  .klt-snap-btn:hover {
    background: var(--color-canvas-soft);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .klt-snap-select {
    height: 30px;
    max-width: 220px;
    padding: 0 8px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-size: 12.5px;
  }
  .klt-snap-select:disabled {
    color: var(--color-mute);
    cursor: not-allowed;
  }
  .klt-snap-delete {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition:
      background 0.12s ease,
      color 0.12s ease;
  }
  .klt-snap-delete:hover {
    background: var(--color-error-soft);
    color: var(--color-error-deep);
  }

  /* ── Verdict panel ───────────────────────────────────────────────────── */
  .klt-summary {
    min-width: 0;
    text-align: right;
    overflow-wrap: anywhere;
  }
  .klt-results {
    min-height: 120px;
  }
  .klt-copy-status--fail {
    display: block;
    margin-top: 10px;
    font-size: 12px;
    line-height: 18px;
    color: var(--color-error-deep);
  }

  /* ── Runtime-injected markup (Astro scoped styles never reach it) ────── */
  :global(.klt-card) {
    margin-top: 12px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: klt-rise 0.18s ease both;
  }
  :global(.klt-card:first-child) {
    margin-top: 0;
  }
  :global(.klt-card__head) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 9px 10px 9px 14px;
    border-bottom: 1px solid var(--color-hairline);
  }
  :global(.klt-verdict) {
    flex: 0 0 auto;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 16px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  :global(.klt-verdict--match) {
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
  }
  :global(.klt-verdict--miss) {
    background: var(--color-canvas-soft-2);
    color: var(--color-body);
  }
  :global(.klt-name) {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 19px;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }
  :global(.klt-ns) {
    color: var(--color-mute);
  }
  :global(.klt-card__actions) {
    display: inline-flex;
    align-items: center;
    margin-left: auto;
  }
  :global(.klt-labels) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--color-hairline);
  }
  :global(.klt-label) {
    padding: 1px 7px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft);
    box-shadow: var(--shadow-hairline);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 17px;
    color: var(--color-body);
    overflow-wrap: anywhere;
  }
  :global(.klt-label--none) {
    background: transparent;
    box-shadow: none;
    color: var(--color-mute);
    font-family: var(--font-sans);
  }
  /* A key the document carries whose value YAML did not read as a string. */
  :global(.klt-label--unreadable) {
    color: var(--color-accent-ink);
  }
  :global(.klt-path) {
    margin-left: auto;
    align-self: center;
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 16px;
    color: var(--color-mute);
    /* `spec.jobTemplate.spec.template.metadata.labels` is 44 mono characters —
       nowrap would push the row past a 390px viewport. */
    overflow-wrap: anywhere;
  }
  :global(.klt-clauses) {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.klt-clause) {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    padding: 8px 14px;
  }
  :global(.klt-clause + .klt-clause) {
