---
/**
 * FigureCap — the signature caption bar on every instrument slab.
 *
 * Three dots + a mono label (`fig. 07 — subnet-calculator · networking`, or a
 * filename / terminal title), with an optional right-aligned actions slot
 * (copy, restart, replay). One component so the detail is a brand, not a
 * decoration: HeroDemo, CodeBlock, TerminalPlay, ErrorTerminal, PrivacyProof,
 * the Mission 90 terminals and the tool result panels all render this bar.
 *
 * Styles live in global.css (`.figcap*`, @layer components) so the runtime-
 * injected result panels can reuse them without an Astro scope. Dot colours are
 * the `--color-dot-*` tokens; `tone="traffic"` colours them, the default keeps
 * them neutral. Always sits on a slab, so its inks are the inverse tier.
 *
 * Usage:
 *   <FigureCap fig="07" label="subnet-calculator · networking" tone="traffic" />
 *   <FigureCap label="alert.test.yaml"><button …>Copy</button></FigureCap>
 */
export interface Props {
  /** Text after the figure number (or the whole label when `fig` is absent). */
  label: string;
  /** Zero-padded figure number ("07"); renders as `fig. 07 — {label}`. */
  fig?: string;
  /** Dot colouring. `traffic` = red/amber/green tokens; `mute` = neutral. */
  tone?: 'mute' | 'traffic';
  /** Extra classes for the bar (e.g. padding overrides). */
  class?: string;
}

const { label, fig, tone = 'mute', class: className } = Astro.props;
const text = fig ? `fig. ${fig} — ${label}` : label;
---

<div class:list={['figcap', className]} data-tone={tone}>
  <span class="figcap__dots" aria-hidden="true">
    <i class="figcap__dot"></i><i class="figcap__dot"></i><i class="figcap__dot"></i>
  </span>
  <span class="figcap__label" title={text}>{text}</span>
  {Astro.slots.has('default') && (
    <span class="figcap__actions">
      <slot />
    </span>
  )}
</div>
