---
/**
 * SubnetCalculatorPlayground — the interactive Subnet / CIDR Calculator island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>.
 * One text input accepts an address with a /prefix, an address plus dotted
 * netmask, or a bare address; example chips (rendered server-side) run on tap.
 * Results render as answer tiles (usable hosts / range / totals) over grouped
 * detail rows, with per-row copy, Copy all, and a shareable #ip= deep link.
 * Evaluation is debounced while typing (Enter commits immediately) and invalid
 * mid-typing states hold the last card briefly before showing a targeted
 * diagnostic. Runs entirely client-side.
 *
 * Built on the playground kit (src/components/playground/*): ExampleChips,
 * RunHint, SnapshotBar, ResultPanel (figure cap, live summary, copy status)
 * and CopyButton. The results container stays here, seeded with
 * `set:html` + `data-results`; its slab overrides anchor on `.snc-results`.
 *
 * Runtime contract (engine lazy-imported for code-splitting):
 *   ../lib/subnet-calculator/engine → calculate(input: string): SubnetResult
 *   ../lib/subnet-calculator/types  → SubnetResult { valid; error?; version?;
 *     title?; normalized?; summary?; note?; stats; groups }
 */
import { examples } from '../lib/subnet-calculator/examples';
import { calculate } from '../lib/subnet-calculator/engine';
import { resultHtml, EMPTY_HTML } from '../lib/subnet-calculator/render';
import ExampleChips from './playground/ExampleChips.astro';
import RunHint from './playground/RunHint.astro';
import SnapshotBar from './playground/SnapshotBar.astro';
import ResultPanel from './playground/ResultPanel.astro';
import CopyButton from './playground/CopyButton.astro';

/**
 * Server-rendered seed. The client re-computes the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees a real worked answer
 * instead of an empty "type something here" panel.
 *
 * `calculate` is pure and synchronous, so it runs at build time unchanged.
 */
export interface Props {
  /**
   * Variant pages (/subnet-calculator/24/) pin the input to this value. When
   * set, the input carries `data-pinned` and boot skips the restored last
   * input (a #ip= deep link still wins). Parent pages pass nothing.
   */
  seed?: string;
}
const { seed } = Astro.props;
const seedExample = examples[0];
const seedInput = seed ?? seedExample?.input;
const seedIdx = seedInput === undefined ? -1 : examples.findIndex((ex) => ex.input === seedInput);
const seedResult = seedInput !== undefined ? calculate(seedInput) : null;
const localePrefix = Astro.currentLocale && Astro.currentLocale !== 'en' ? `/${Astro.currentLocale}` : '';
const seedHtml =
  seedResult && seedResult.valid ? resultHtml(seedResult, { localePrefix }) : EMPTY_HTML;
const seedSummary = seedResult && seedResult.valid ? (seedResult.summary ?? '') : '';
const chipItems = examples.map((ex) => ({ label: ex.label, input: ex.input, ariaLabel: `${ex.label} — ${ex.input}` }));
---

<section class="snc-pg" aria-label="Subnet / CIDR Calculator playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: example chips ───────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow">Examples</span>
      <ExampleChips prefix="snc" items={chipItems} active={seedIdx >= 0 ? seedIdx : null} ariaLabel="Examples" />
    </div>

    {/* ── Address input ────────────────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <label class="eyebrow mb-2 block" for="snc-input">IP address / CIDR / netmask</label>
      <div class="snc-input-wrap">
        <svg
          class="snc-input-icon pointer-events-none"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2.75" y="4.75" width="14.5" height="10.5" rx="2"></rect>
          <path d="M2.75 8.5h14.5"></path>
        </svg>
        <input
          id="snc-input"
          type="text"
          class="snc-input code-mono"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          enterkeyhint="done"
          placeholder="192.168.1.0/24"
          value={seedInput}
          data-pinned={seed ? '' : undefined}
          aria-describedby="snc-input-hint snc-input-live"
        />
      </div>
      <p id="snc-input-hint" class="snc-hint caption text-mute">
        IPv4 or IPv6, with or without a prefix — <span class="code-mono">10.0.0.0/8</span>,
        <span class="code-mono">2001:db8::/48</span>, or a dotted netmask like
        <span class="code-mono">192.168.1.0 255.255.255.0</span>. A bare address means one host
        (/32 or /128).
      </p>
      <RunHint id="snc-input-live" />
      <SnapshotBar prefix="snc" />
    </div>

    {/* ── Results panel — the L2 instrument (dark in both themes) under its
        figure cap; the live summary reads out in the cap's actions slot. ── */}
    <ResultPanel slug="subnet-calculator" prefix="snc" summary={seedSummary} split>
      <Fragment slot="actions">
        <CopyButton kind="link" id="snc-share" />
        <CopyButton kind="all" id="snc-copy-all" />
      </Fragment>
      {/* Seeded at build time (see `seedHtml` above) so the answer is in the
          static HTML; the client replaces it with the same markup on boot. */}
      <div id="snc-results" class="snc-results" set:html={seedHtml} data-results></div>
    </ResultPanel>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .snc-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .snc-input-icon {
    position: absolute;
    left: 14px;
    width: 18px;
    height: 18px;
    color: var(--color-mute);
    pointer-events: none;
  }
  .snc-input {
    width: 100%;
    height: var(--control-h-lg);
    padding: 0 16px 0 42px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 15px;
    line-height: 24px;
    transition: box-shadow var(--dur-fast) var(--ease-brand);
  }
  .snc-input::placeholder {
    color: var(--color-mute);
  }
  .snc-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .snc-input:focus {
    outline: none;
  }
  .snc-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .snc-input.snc-input--error {
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  .snc-input.snc-input--error:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-error);
  }
  .snc-hint {
    margin-top: 8px;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .snc-hint .code-mono {
    font-size: 12px;
  }
  /* Sized so the seeded /24 card doesn't jump against the empty/error states;
     smaller content is vertically centered within it. */
  .snc-results {
    min-height: 320px;
    display: grid;
    align-content: center;
  }

  /* ── Runtime-injected markup (render.ts; styled with :global) ──────────
     Light rules first as the documented defaults; the slab re-skin follows,
     anchored on this component's own `.snc-results` container (the panel
     wrapper is ResultPanel's and carries no scope attribute). */
  :global(.snc-card) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: snc-rise var(--dur-base) var(--ease-brand) both;
  }
  :global(.snc-title) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-ink);
  }
  :global(.snc-title__badge) {
    flex: 0 0 auto;
    font-size: 11px;
    line-height: 16px;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
  }
  :global(.snc-title__net) {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* ── Answer tiles ─────────────────────────────────────────────────────── */
  :global(.snc-answer) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    padding: 14px;
    border-bottom: 1px solid var(--color-hairline);
  }
  @media (min-width: 640px) {
    :global(.snc-answer) {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      gap: 12px;
    }
  }
  :global(.snc-answer__tile) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  /* Row-key role (label-field): mono 11/16 uppercase, the only label. */
  :global(.snc-answer__k) {
    @apply label-field;
  }
  :global(.snc-answer__v) {
    font-size: 20px;
    line-height: 28px;
    color: var(--color-ink);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  :global(.snc-answer__v.is-hero) {
    font-size: 26px;
    line-height: 32px;
    font-weight: 600;
    color: var(--color-brand-strong);
  }
  :global(.snc-answer__v.is-mono) {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    padding-top: 4px;
  }
  :global(.snc-answer__cap) {
    font-size: 12px;
    line-height: 16px;
    color: var(--color-mute);
  }

  /* ── Host-inside-block note ───────────────────────────────────────────── */
  :global(.snc-note) {
    margin: 0;
    padding: 8px 14px;
    border-bottom: 1px solid var(--color-hairline);
    background: var(--color-warning-soft);
    color: var(--color-warning-deep);
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }

  /* ── Grouped rows ─────────────────────────────────────────────────────── */
  /* Group-heading role: a sans heading over its rows (12/16 600, ink, 16px
     of air), never one more mono label — global.css .result-panel__group-h.
     A hairline separates consecutive groups; the first sits under the
     answer tiles' own rule. */
  :global(.snc-group + .snc-group) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.snc-group__h) {
    margin: 0;
    padding: 16px 14px 4px;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    color: var(--color-ink);
  }
  :global(.snc-group__dl) {
    margin: 0;
  }
  :global(.snc-row) {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 12px;
    padding: 9px 14px;
    align-items: baseline;
  }
  /* Below ~480px: stack label above value so long IPv6 addresses don't wrap
     mid-hex-group; the value and its copy button share one flex cell. */
  @media (max-width: 479px) {
    :global(.snc-row) {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
  :global(.snc-row + .snc-row) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.snc-row__k) {
    @apply label-field;
  }
  :global(.snc-row__gloss) {
    display: block;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 16px;
    letter-spacing: normal;
    text-transform: none;
    color: var(--color-mute);
    text-wrap: pretty;
  }
  /* The <dd> is a flex cell holding value + copy button together, so the
     button never orphans into its own grid column. */
  :global(.snc-row__v-wrap) {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    margin: 0;
  }
  :global(.snc-row__v) {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-word;
    overflow-wrap: anywhere;
  }
  :global(.snc-row__v.is-mono) {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  /* ── Per-row copy buttons (render.ts; copy.ts drives them) ──────────── */
  :global(.snc-copy-btn) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-brand),
      background var(--dur-fast) var(--ease-brand);
    padding: 0;
  }
  :global(.snc-copy-btn:hover) {
    color: var(--color-brand-strong);
    background: var(--color-hairline);
  }
  :global(.snc-copy-btn:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  :global(.snc-copy-btn[data-copied]) {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
  }
  @media (pointer: coarse) {
    :global(.snc-copy-btn) {
      width: var(--control-h-lg);
      height: var(--control-h-lg);
    }
  }

  @keyframes snc-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.snc-card) {
      animation: none;
    }
  }

  :global(.snc-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.snc-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.snc-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.snc-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.snc-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below it uses the slab ink tier; the light rules
     above remain the documented defaults. ──────────────────────────────── */
  .snc-results :global(.snc-empty),
  .snc-results :global(.snc-error) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .snc-results :global(.snc-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .snc-results :global(.snc-card) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .snc-results :global(.snc-title) {
    border-bottom-color: var(--color-inverse-hairline);
    color: var(--color-inverse-fg);
  }
  .snc-results :global(.snc-title__badge) {
    background: #8fc97a1f;
    color: var(--color-inverse-brand);
  }
  .snc-results :global(.snc-answer),
  .snc-results :global(.snc-note) {
    border-bottom-color: var(--color-inverse-hairline);
  }
  .snc-results :global(.snc-group + .snc-group) {
    border-top-color: var(--color-inverse-hairline);
  }
  .snc-results :global(.snc-group__h) {
    color: var(--color-inverse-fg);
  }
  .snc-results :global(.snc-answer__k),
  .snc-results :global(.snc-answer__cap),
  .snc-results :global(.snc-row__k),
  .snc-results :global(.snc-row__gloss) {
    color: var(--color-inverse-mute);
  }
  .snc-results :global(.snc-answer__v),
  .snc-results :global(.snc-row__v) {
    color: var(--color-inverse-fg);
  }
  .snc-results :global(.snc-answer__v.is-hero) {
    color: var(--color-inverse-brand);
  }
  .snc-results :global(.snc-note) {
    background: #e0a45814;
    color: var(--color-inverse-accent);
  }
  .snc-results :global(.snc-row + .snc-row) {
    border-top-color: #ffffff12;
  }
  /* Values right-align like every instrument readout (the hero card, the
     summary); the stacked <480px layout returns to the left edge. */
  .snc-results :global(.snc-row__v-wrap) {
    justify-content: flex-end;
  }
  .snc-results :global(.snc-row__v) {
    text-align: right;
  }
  @media (max-width: 479px) {
    .snc-results :global(.snc-row__v-wrap) {
      justify-content: flex-start;
    }
    .snc-results :global(.snc-row__v) {
      text-align: left;
    }
  }
  .snc-results :global(.snc-copy-btn) {
    color: var(--color-inverse-mute);
  }
  .snc-results :global(.snc-copy-btn:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .snc-results :global(.snc-copy-btn[data-copied]) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
</style>

<script>
  import {
    EMPTY_HTML,
    errorHtml,
    resultHtml,
    buildCopyAll,
  } from '../lib/subnet-calculator/render';
  import { snapshotValues, markChanged } from '../lib/mark-changed';
  import { wireRunKeys } from '../lib/run-keys';
  import { readIpHash, buildIpHash } from '../lib/ip-hash';
  import { wireCopyButtons } from '../lib/playground-kit/copy';
  import { syncChipsByInput, clearChips, CHIP_SELECTOR } from '../lib/playground-kit/chips';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';

  type Stat = { label: string; value: string; display?: string; caption?: string; mono?: boolean };
  type Row = { label: string; value: string; display?: string; gloss?: string; mono?: boolean };
  type Group = { heading: string; rows: Row[] };
  type Result = {
    valid: boolean;
    error?: string;
    version?: 4 | 6;
    title?: string;
    normalized?: string;
    summary?: string;
    note?: string;
    stats: Stat[];
    groups: Group[];
  };
  type EngineModule = { calculate: (input: string) => Result };

  const ROOT_SEL = '.snc-pg';
  const DEBOUNCE_MS = 130;
  const ERROR_HOLD_MS = 600;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.sncWired === 'true') return;
      root.dataset.sncWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  /** Prefix tool paths with the current locale (e.g. /de) so deep links stay in-locale. */
  function localePath(p: string): string {
    const m = window.location.pathname.match(/^\/(de|es|fr|pt-br)\//);
    return m ? `/${m[1]}${p}` : p;
  }

  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = EMPTY_HTML;
  }

  function renderError(
    container: HTMLElement,
    summary: HTMLElement,
    message: string,
    isAlert = false
  ): void {
    setSummary(summary, `Invalid — ${message}`, true);
    container.innerHTML = errorHtml(message, isAlert);
  }

  function renderResult(container: HTMLElement, result: Result): void {
    container.innerHTML = resultHtml(result, { localePrefix: localePath('') });
  }

  async function init(root: HTMLElement): Promise<void> {
    const input = el<HTMLInputElement>(root, '#snc-input');
    const resultsBox = el<HTMLElement>(root, '#snc-results');
    const summaryEl = el<HTMLElement>(root, '#snc-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#snc-share');
    const copyAllBtn = el<HTMLButtonElement>(root, '#snc-copy-all');
    const copyStatus = el<HTMLElement>(root, '#snc-copy-status');
    const chipsWrap = el<HTMLElement>(root, '#snc-chips');
    const chips = Array.from(chipsWrap?.querySelectorAll<HTMLButtonElement>(CHIP_SELECTOR) ?? []);
    const snapSaveBtn = el<HTMLButtonElement>(root, '#snc-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#snc-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#snc-snap-delete');
    if (
      !input ||
      !resultsBox ||
      !summaryEl ||
      !shareBtn ||
      !copyAllBtn ||
      !copyStatus ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    )
      return;

    /* ------------------------------------------------------------------ */
    /* Copy plumbing (row buttons, Copy link, Copy all) — the kit helper:  */
    /* one delegated listener; outcomes announced in #snc-copy-status.     */
    /* ------------------------------------------------------------------ */

    wireCopyButtons(root, { status: copyStatus });

    /* ------------------------------------------------------------------ */
    /* Engine                                                              */
    /* ------------------------------------------------------------------ */

    let engine: EngineModule;
    try {
      engine = (await import('../lib/subnet-calculator/engine')) as unknown as EngineModule;
    } catch (err) {
      renderError(
        resultsBox,
        summaryEl,
        'The calculator engine failed to load. Reload the page to try again.',
        true
      );
      console.error('[SubnetCalculator] engine import failed:', err);
      return;
    }

    /* ------------------------------------------------------------------ */
    /* State machine: EMPTY | VALID | PENDING | INVALID                    */
    /* ------------------------------------------------------------------ */

    type State = 'empty' | 'valid' | 'pending' | 'invalid';
    let state: State = 'empty';
    let evalTimer: number | undefined;
    let errTimer: number | undefined;
    let lastWrittenHash: string | null = null;

    function clearTimers(): void {
      window.clearTimeout(evalTimer);
      window.clearTimeout(errTimer);
    }

    function writeHash(value: string | null): void {
      const target = value ? buildIpHash(value) : '';
      if (target === lastWrittenHash) return;
      // Safari throttles replaceState (~100/30s) and throws — never let that break input.
      try {
        if (value) {
          history.replaceState(null, '', target);
        } else {
          history.replaceState(null, '', location.pathname + location.search);
        }
        lastWrittenHash = target;
      } catch {
        /* ignore */
      }
    }

    function setErrorState(on: boolean): void {
      input!.classList.toggle('snc-input--error', on);
      if (on) {
        input!.setAttribute('aria-invalid', 'true');
        input!.setAttribute('aria-describedby', 'snc-input-hint snc-input-live snc-error-detail');
      } else {
        input!.removeAttribute('aria-invalid');
        input!.setAttribute('aria-describedby', 'snc-input-hint snc-input-live');
      }
    }

    function hideActions(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
      copyAllBtn!.hidden = true;
      copyAllBtn!.dataset.copy = '';
    }

    function toEmpty(): void {
      state = 'empty';
      setErrorState(false);
      hideActions();
      renderEmpty(resultsBox!, summaryEl!);
      clearChips(chipsWrap);
      writeHash(null);
    }

    function showError(message: string): void {
      state = 'invalid';
      clearTimers();
      setErrorState(true);
      hideActions();
      renderError(resultsBox!, summaryEl!, message);
      clearChips(chipsWrap);
      writeHash(null);
    }

    function evaluate(source: 'type' | 'commit' | 'seed'): void {
      clearTimers();
      const value = input!.value.trim();
      if (value.length === 0) {
        toEmpty();
        return;
      }

      let result: Result | null = null;
      try {
        result = engine.calculate(value);
      } catch {
        result = null;
      }

      if (result && result.valid !== false) {
        state = 'valid';
        setErrorState(false);
        // Amber tick on the rows whose value changed — never on the boot seed.
        const prev = source === 'seed' ? new Map<string, string>() : snapshotValues(resultsBox!);
        renderResult(resultsBox!, result);
        markChanged(resultsBox!, prev);
        setSummary(summaryEl!, result.summary ?? '', false);
        const normalized = result.normalized ?? value;
        shareBtn!.hidden = false;
        shareBtn!.dataset.copy =
          location.origin + location.pathname + location.search + buildIpHash(normalized);
        copyAllBtn!.hidden = false;
        copyAllBtn!.dataset.copy = buildCopyAll(result);
        syncChipsByInput(chipsWrap, value);
        if (source !== 'seed') writeHash(normalized);
        if (source !== 'seed') recordToolLastInput('subnet-calculator', value);
        return;
      }

      const message = result?.error ?? 'Unexpected error while calculating.';
      if (source !== 'type') {
        showError(message);
        return;
      }

      // Mid-typing: hold the last card, no red yet. Only surface the error
      // after a pause — and not while the value still looks unfinished.
      state = 'pending';
      setErrorState(false);
      hideActions();
      setSummary(summaryEl!, '', false);
      if (!/[.:\s]$/.test(input!.value)) {
        errTimer = window.setTimeout(() => showError(message), ERROR_HOLD_MS);
      }
    }

    /* ------------------------------------------------------------------ */
    /* Events                                                              */
    /* ------------------------------------------------------------------ */

    input.addEventListener('input', () => {
      clearTimers();
      if (input.value.trim().length === 0) {
        toEmpty();
        return;
      }
      evalTimer = window.setTimeout(() => evaluate('type'), DEBOUNCE_MS);
    });

    wireRunKeys(input, () => evaluate('commit'));

    input.addEventListener('blur', () => {
      if (state === 'pending') evaluate('commit');
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        input.value = chip.dataset.input ?? '';
        evaluate('commit');
      });
    });

    wireSnapshotUI({
      slug: 'subnet-calculator',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => input!.value.trim(),
      setValue: (value) => {
        input!.value = value;
        evaluate('commit');
      },
    });

    /* ------------------------------------------------------------------ */
    /* First load: existing value → #ip= deep link → restored last input   */
    /* → seeded first chip. Seeding never writes the hash — only user      */
    /* actions do. A variant page pins its value (`data-pinned`): the       */
    /* restored last input is skipped and the pinned value is the seed.    */
    /* ------------------------------------------------------------------ */

    const pinned = input.hasAttribute('data-pinned');
    const hashValue = readIpHash();
    const restored = pinned ? null : getRestoredLastInput('subnet-calculator');
    const seed = pinned ? input.defaultValue.trim() : (chips[0]?.dataset.input ?? '');

    // A value the visitor typed BEFORE hydration wins. The server seeds `value=`
    // with examples[0], so compare against `defaultValue` (the seeded attribute):
    // a bare `input.value.trim()` check would always take this branch and make
    // the #ip= deep link and the restored last input unreachable.
    const typed = input.value.trim();
    if (typed && typed !== input.defaultValue.trim()) {
      evaluate('seed');
    } else if (hashValue) {
      input.value = hashValue;
      evaluate('seed');
    } else if (restored) {
      input.value = restored;
      evaluate('seed');
    } else if (seed) {
      input.value = seed;
      evaluate('seed');
    } else {
      renderEmpty(resultsBox, summaryEl);
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
