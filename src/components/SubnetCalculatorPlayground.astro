---
/**
 * SubnetCalculatorPlayground — the interactive Subnet / CIDR Calculator island.
 *
 * A no-framework, server-rendered shell hydrated by a single module <script>.
 * One text input accepts an address with a /prefix, an address plus dotted
 * netmask, or a bare address; example chips (rendered server-side) run on tap.
 * Results render as answer tiles (usable hosts / range / totals) over grouped
 * detail rows, with per-row copy, Copy all, and a shareable #ip= deep link.
 * Evaluation is debounced while typing (Enter commits immediately) and invalid
 * mid-typing states hold the last card briefly before showing a targeted
 * diagnostic. Runs entirely client-side.
 *
 * Runtime contract (engine lazy-imported for code-splitting):
 *   ../lib/subnet-calculator/engine → calculate(input: string): SubnetResult
 *   ../lib/subnet-calculator/types  → SubnetResult { valid; error?; version?;
 *     title?; normalized?; summary?; note?; stats; groups }
 */
import { examples } from '../lib/subnet-calculator/examples';
import { calculate } from '../lib/subnet-calculator/engine';
import { resultHtml, EMPTY_HTML } from '../lib/subnet-calculator/render';
import { getTool, tools } from '../data/tools';
import FigureCap from './FigureCap.astro';

// Figure number = the tool's position in the registry (append order, so it
// never shifts when a tool changes status) — the same rule HeroDemo uses.
const tool = getTool('subnet-calculator');
const figNo = tool ? String(tools.indexOf(tool) + 1).padStart(2, '0') : '00';
const figLabel = tool ? `${tool.slug} · ${tool.category.toLowerCase()}` : 'subnet-calculator';

/**
 * Server-rendered seed. The client re-computes the same example on boot, so
 * this is pure progressive enhancement — but it means a visitor with no JS,
 * and every AI crawler (they do not execute JS), sees a real worked answer
 * instead of an empty "type something here" panel.
 *
 * `calculate` is pure and synchronous, so it runs at build time unchanged.
 */
const seedExample = examples[0];
const seedResult = seedExample ? calculate(seedExample.input) : null;
const localePrefix = Astro.currentLocale && Astro.currentLocale !== 'en' ? `/${Astro.currentLocale}` : '';
const seedHtml =
  seedResult && seedResult.valid ? resultHtml(seedResult, { localePrefix }) : EMPTY_HTML;
const seedSummary = seedResult && seedResult.valid ? (seedResult.summary ?? '') : '';
---

<section class="snc-pg" aria-label="Subnet / CIDR Calculator playground">
  <div class="card shadow-float overflow-hidden rounded-lg">
    {/* ── Toolbar: example chips ───────────────────────────────────────── */}
    <div class="flex flex-col gap-2 border-b border-hairline px-4 py-3 sm:px-5">
      <span class="eyebrow">Examples</span>
      <div id="snc-chips" class="snc-chips" role="group" aria-label="Examples">
        {
          examples.map((ex) => (
            <button
              type="button"
              class:list={['snc-chip', ex.input === seedExample?.input && 'is-active']}
              data-input={ex.input}
              aria-label={`${ex.label} — ${ex.input}`}
            >
              {ex.label}
            </button>
          ))
        }
      </div>
    </div>

    {/* ── Address input ────────────────────────────────────────────────── */}
    <div class="border-b border-hairline px-4 py-4 sm:px-5">
      <label class="eyebrow mb-2 block" for="snc-input">IP address / CIDR / netmask</label>
      <div class="snc-input-wrap">
        <svg
          class="snc-input-icon pointer-events-none"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2.75" y="4.75" width="14.5" height="10.5" rx="2"></rect>
          <path d="M2.75 8.5h14.5"></path>
        </svg>
        <input
          id="snc-input"
          type="text"
          class="snc-input code-mono"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"
          enterkeyhint="done"
          placeholder="192.168.1.0/24"
          value={seedExample?.input}
          aria-describedby="snc-input-hint snc-input-live"
        />
      </div>
      <p id="snc-input-hint" class="snc-hint caption text-mute">
        IPv4 or IPv6, with or without a prefix — <span class="code-mono">10.0.0.0/8</span>,
        <span class="code-mono">2001:db8::/48</span>, or a dotted netmask like
        <span class="code-mono">192.168.1.0 255.255.255.0</span>. A bare address means one host
        (/32 or /128).
      </p>
      <p id="snc-input-live" class="snc-hint snc-hint--live caption text-mute">
        Results update as you type — press Enter to run now.
      </p>
      <div class="snc-snap-row mt-3 flex flex-wrap items-center gap-2">
        <button id="snc-snap-save" type="button" class="snc-snap-btn">Save snapshot</button>
        <select id="snc-snap-select" class="snc-snap-select" aria-label="Load a saved snapshot" disabled>
          <option value="">No snapshots yet</option>
        </select>
        <button id="snc-snap-delete" type="button" class="snc-snap-delete" aria-label="Delete this snapshot" hidden>&times;</button>
      </div>
    </div>

    {/* ── Results panel — the L2 instrument (dark in both themes) under its
        figure cap; the live summary reads out in the cap's actions slot. ── */}
    <div class="snc-panel instrument-flush">
      <FigureCap fig={figNo} label={figLabel} tone="traffic">
        <span id="snc-summary" class="snc-summary code-mono text-inverse-mute" role="status" aria-live="polite">{seedSummary}</span>
      </FigureCap>
      <div class="px-4 py-4 sm:px-5">
      <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="flex items-center gap-2">
          <span class="eyebrow !text-inverse-brand">Result</span>
          <button
            id="snc-share"
            type="button"
            class="snc-copy-btn snc-copy-btn--labeled"
            data-copy-link
            data-copy=""
            data-copy-label="Copy link"
            hidden
          >
            <svg
              class="snc-copy-icon"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6.75 9.25l2.5-2.5"></path>
              <path d="M8.75 4.25l1.5-1.5a2.47 2.47 0 0 1 3.5 3.5l-1.5 1.5"></path>
              <path d="M7.25 11.75l-1.5 1.5a2.47 2.47 0 0 1-3.5-3.5l1.5-1.5"></path>
            </svg>
            <svg
              class="snc-check-icon hidden"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 8.5l3.5 3.5L13 4.5"></path>
            </svg>
            <span class="snc-copy-label">Copy link</span>
          </button>
          <button
            id="snc-copy-all"
            type="button"
            class="snc-copy-btn snc-copy-btn--labeled"
            data-copy-all
            data-copy=""
            data-copy-label="Copy all"
            hidden
          >
            <svg
              class="snc-copy-icon"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="5" y="5" width="9" height="9" rx="1.5"></rect>
              <path d="M3 11H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v1"></path>
            </svg>
            <svg
              class="snc-check-icon hidden"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 8.5l3.5 3.5L13 4.5"></path>
            </svg>
            <span class="snc-copy-label">Copy all</span>
          </button>
        </span>
      </div>
      {/* Seeded at build time (see `seedHtml` above) so the answer is in the
          static HTML; the client replaces it with the same markup on boot. */}
      <div id="snc-results" class="snc-results" set:html={seedHtml}></div>
      <span id="snc-copy-status" class="sr-only" role="status" aria-live="polite"></span>
      </div>
    </div>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* ── Example + cross-tool chips (shared recipe; anchors are injected) ── */
  .snc-chips,
  :global(.snc-xchips) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  :global(.snc-xchips) {
    margin-top: 12px;
  }
  :global(.snc-chip) {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    border: none;
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    font-size: 12px;
    line-height: 18px;
    color: var(--color-brand-strong);
    cursor: pointer;
    text-decoration: none;
    transition:
      background 0.12s ease,
      box-shadow 0.12s ease;
  }
  :global(.snc-chip:hover),
  :global(.snc-chip.is-active) {
    background: var(--color-brand-soft);
    box-shadow: inset 0 0 0 1px var(--color-brand);
  }
  :global(.snc-chip:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  @media (pointer: coarse) {
    :global(.snc-chip) {
      min-height: 44px; /* site touch-target standard */
    }
  }

  .snc-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .snc-input-icon {
    position: absolute;
    left: 14px;
    width: 18px;
    height: 18px;
    color: var(--color-mute);
    pointer-events: none;
  }
  .snc-input {
    width: 100%;
    height: 48px;
    padding: 0 16px 0 42px;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-hairline);
    font-size: 15px;
    line-height: 24px;
    letter-spacing: 0.01em;
    transition: box-shadow 0.15s ease;
  }
  .snc-input::placeholder {
    color: var(--color-mute);
  }
  .snc-input:hover {
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .snc-input:focus {
    outline: none;
  }
  .snc-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-link);
    outline: none;
  }
  .snc-input.snc-input--error {
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  .snc-input.snc-input--error:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-error);
  }
  .snc-hint {
    margin-top: 8px;
    font-size: 12px;
    line-height: 18px;
    text-wrap: pretty;
  }
  .snc-hint .code-mono {
    font-size: 12px;
  }
  .snc-hint--live {
    margin-top: 2px;
  }
  .snc-snap-btn {
    flex: 0 0 auto;
    height: 30px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    border: none;
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-size: 13px;
    cursor: pointer;
    transition: background 0.12s ease, box-shadow 0.12s ease;
  }
  .snc-snap-btn:hover {
    background: var(--color-canvas-soft);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .snc-snap-select {
    height: 30px;
    max-width: 220px;
    padding: 0 8px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    color: var(--color-body);
    font-size: 13px;
  }
  .snc-snap-select:disabled {
    color: var(--color-mute);
    cursor: not-allowed;
  }
  .snc-snap-delete {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .snc-snap-delete:hover {
    background: var(--color-error-soft);
    color: var(--color-error-deep);
  }
  .snc-summary {
    min-width: 0;
    text-align: right;
    overflow-wrap: anywhere;
  }
  /* Sized so the seeded /24 card doesn't jump against the empty/error states;
     smaller content is vertically centered within it. */
  .snc-results {
    min-height: 320px;
    display: grid;
    align-content: center;
  }
  /* Copy failure message flips from sr-only to a visible caption. */
  .snc-copy-status--fail {
    display: block;
    margin-top: 10px;
    font-size: 12px;
    line-height: 18px;
    color: var(--color-error-deep);
  }

  /* ── Runtime-injected markup (styled with :global) ──────────────────── */
  :global(.snc-card) {
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    overflow: hidden;
    animation: snc-rise 0.18s ease both;
  }
  :global(.snc-title) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-ink);
  }
  :global(.snc-title__badge) {
    flex: 0 0 auto;
    font-size: 11px;
    line-height: 16px;
    padding: 1px 8px;
    border-radius: 9999px;
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
  }
  :global(.snc-title__net) {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* ── Answer tiles ─────────────────────────────────────────────────────── */
  :global(.snc-answer) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    padding: 14px;
    border-bottom: 1px solid var(--color-hairline);
  }
  @media (min-width: 640px) {
    :global(.snc-answer) {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      gap: 12px;
    }
  }
  :global(.snc-answer__tile) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  :global(.snc-answer__k) {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  :global(.snc-answer__v) {
    font-size: 20px;
    line-height: 28px;
    color: var(--color-ink);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  :global(.snc-answer__v.is-hero) {
    font-size: 26px;
    line-height: 32px;
    font-weight: 600;
    color: var(--color-brand-strong);
  }
  :global(.snc-answer__v.is-mono) {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    padding-top: 4px;
  }
  :global(.snc-answer__cap) {
    font-size: 12px;
    line-height: 16px;
    color: var(--color-mute);
  }

  /* ── Host-inside-block note ───────────────────────────────────────────── */
  :global(.snc-note) {
    margin: 0;
    padding: 8px 14px;
    border-bottom: 1px solid var(--color-hairline);
    background: var(--color-warning-soft);
    color: var(--color-warning-deep);
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }

  /* ── Grouped rows ─────────────────────────────────────────────────────── */
  :global(.snc-group__h) {
    margin: 0;
    padding: 12px 14px 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  :global(.snc-group__dl) {
    margin: 0;
  }
  :global(.snc-row) {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 12px;
    padding: 9px 14px;
    align-items: baseline;
  }
  /* Below ~480px: stack label above value so long IPv6 addresses don't wrap
     mid-hex-group; the value and its copy button share one flex cell. */
  @media (max-width: 479px) {
    :global(.snc-row) {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
  :global(.snc-row + .snc-row) {
    border-top: 1px solid var(--color-hairline);
  }
  :global(.snc-row__k) {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 18px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  :global(.snc-row__gloss) {
    display: block;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 16px;
    letter-spacing: normal;
    text-transform: none;
    color: var(--color-mute);
    text-wrap: pretty;
  }
  /* The <dd> is a flex cell holding value + copy button together, so the
     button never orphans into its own grid column. */
  :global(.snc-row__v-wrap) {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    margin: 0;
  }
  :global(.snc-row__v) {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-ink);
    word-break: break-word;
    overflow-wrap: anywhere;
  }
  :global(.snc-row__v.is-mono) {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  /* ── Copy buttons ─────────────────────────────────────────────────────── */
  :global(.snc-copy-btn) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--color-mute);
    cursor: pointer;
    transition:
      color 0.12s ease,
      background 0.12s ease;
    padding: 0;
  }
  :global(.snc-copy-btn:hover) {
    color: var(--color-brand-strong);
    background: var(--color-hairline);
  }
  :global(.snc-copy-btn:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }
  :global(.snc-copy-btn--labeled) {
    width: auto;
    height: 26px;
    gap: 6px;
    padding: 0 10px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  :global(.snc-copy-btn--copied) {
    color: var(--color-brand-strong);
    background: var(--color-brand-soft);
  }
  @media (pointer: coarse) {
    :global(.snc-copy-btn) {
      width: 44px;
      height: 44px;
    }
    :global(.snc-copy-btn--labeled) {
      width: auto;
      height: auto;
      min-height: 44px;
    }
    .snc-snap-btn,
    .snc-snap-select {
      height: 44px;
    }
    .snc-snap-delete {
      width: 44px;
      height: 44px;
    }
  }

  @keyframes snc-rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.snc-card) {
      animation: none;
    }
  }

  :global(.snc-error) {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-error-soft);
    box-shadow: inset 0 0 0 1px var(--color-error);
    color: var(--color-error-deep);
  }
  :global(.snc-error__icon) {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }
  :global(.snc-error__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  :global(.snc-error__detail) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 18px;
    text-wrap: pretty;
  }
  :global(.snc-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 20px 16px;
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    box-shadow: var(--shadow-hairline);
  }

  /* ── Instrument re-skin — the result panel is the L2 slab (dark in BOTH
     themes). Everything below it uses the slab ink tier; the light rules
     above remain the documented defaults. ──────────────────────────────── */
  .snc-panel :global(.snc-empty),
  .snc-panel :global(.snc-error) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .snc-panel :global(.snc-error) {
    background: #ff9d9514;
    box-shadow: inset 0 0 0 1px var(--color-inverse-error);
    color: var(--color-inverse-error);
  }
  .snc-panel .snc-copy-status--fail {
    color: var(--color-inverse-error);
  }
  .snc-panel :global(.snc-card) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .snc-panel :global(.snc-title) {
    border-bottom-color: var(--color-inverse-hairline);
    color: var(--color-inverse-fg);
  }
  .snc-panel :global(.snc-title__badge) {
    border-radius: var(--radius-pill);
    background: #8fc97a1f;
    color: var(--color-inverse-brand);
  }
  .snc-panel :global(.snc-answer),
  .snc-panel :global(.snc-note) {
    border-bottom-color: var(--color-inverse-hairline);
  }
  .snc-panel :global(.snc-answer__k),
  .snc-panel :global(.snc-answer__cap),
  .snc-panel :global(.snc-group__h),
  .snc-panel :global(.snc-row__k),
  .snc-panel :global(.snc-row__gloss) {
    color: var(--color-inverse-mute);
  }
  .snc-panel :global(.snc-answer__v),
  .snc-panel :global(.snc-row__v) {
    color: var(--color-inverse-fg);
  }
  .snc-panel :global(.snc-answer__v.is-hero) {
    color: var(--color-inverse-brand);
  }
  .snc-panel :global(.snc-note) {
    background: #e0a45814;
    color: var(--color-inverse-accent);
  }
  .snc-panel :global(.snc-row + .snc-row) {
    border-top-color: #ffffff12;
  }
  /* Values right-align like every instrument readout (the hero card, the
     summary); the stacked <480px layout returns to the left edge. */
  .snc-panel :global(.snc-row__v-wrap) {
    justify-content: flex-end;
  }
  .snc-panel :global(.snc-row__v) {
    text-align: right;
  }
  @media (max-width: 479px) {
    .snc-panel :global(.snc-row__v-wrap) {
      justify-content: flex-start;
    }
    .snc-panel :global(.snc-row__v) {
      text-align: left;
    }
  }
  .snc-panel :global(.snc-copy-btn) {
    color: var(--color-inverse-mute);
  }
  .snc-panel :global(.snc-copy-btn:hover) {
    color: var(--color-inverse-brand);
    background: #ffffff14;
  }
  .snc-panel :global(.snc-copy-btn--labeled) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .snc-panel :global(.snc-copy-btn--copied) {
    color: var(--color-inverse-brand);
    background: #8fc97a1f;
  }
  .snc-panel :global(.snc-xchips .snc-chip) {
    background: #ffffff0a;
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
    color: var(--color-inverse-brand);
  }
  .snc-panel :global(.snc-xchips .snc-chip:hover) {
    background: #8fc97a1f;
    box-shadow: inset 0 0 0 1px var(--color-inverse-brand);
  }
</style>

<script>
  import {
    EMPTY_HTML,
    errorHtml,
    resultHtml,
    buildCopyAll,
  } from '../lib/subnet-calculator/render';
  import { snapshotValues, markChanged } from '../lib/mark-changed';
  import { wireRunKeys } from '../lib/run-keys';
  import { readIpHash, buildIpHash } from '../lib/ip-hash';
  import { copyTextToClipboard } from '../lib/clipboard';
  import { getRestoredLastInput, recordToolLastInput, wireSnapshotUI } from '../lib/tool-state/wire';

  type Stat = { label: string; value: string; display?: string; caption?: string; mono?: boolean };
  type Row = { label: string; value: string; display?: string; gloss?: string; mono?: boolean };
  type Group = { heading: string; rows: Row[] };
  type Result = {
    valid: boolean;
    error?: string;
    version?: 4 | 6;
    title?: string;
    normalized?: string;
    summary?: string;
    note?: string;
    stats: Stat[];
    groups: Group[];
  };
  type EngineModule = { calculate: (input: string) => Result };

  const ROOT_SEL = '.snc-pg';
  const DEBOUNCE_MS = 130;
  const ERROR_HOLD_MS = 600;
  const RESET_MS = 1800;

  function boot(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SEL).forEach((root) => {
      if (root.dataset.sncWired === 'true') return;
      root.dataset.sncWired = 'true';
      void init(root);
    });
  }

  function el<T extends HTMLElement>(root: HTMLElement, sel: string): T | null {
    return root.querySelector<T>(sel);
  }

  /** Prefix tool paths with the current locale (e.g. /de) so deep links stay in-locale. */
  function localePath(p: string): string {
    const m = window.location.pathname.match(/^\/(de|es|fr|pt-br)\//);
    return m ? `/${m[1]}${p}` : p;
  }

  function setSummary(summary: HTMLElement, text: string, isError: boolean): void {
    summary.textContent = text;
    summary.classList.toggle('text-inverse-error', isError);
    summary.classList.toggle('text-inverse-mute', !isError);
  }

  function renderEmpty(container: HTMLElement, summary: HTMLElement): void {
    setSummary(summary, '', false);
    container.innerHTML = EMPTY_HTML;
  }

  function renderError(
    container: HTMLElement,
    summary: HTMLElement,
    message: string,
    isAlert = false
  ): void {
    setSummary(summary, `Invalid — ${message}`, true);
    container.innerHTML = errorHtml(message, isAlert);
  }

  function renderResult(container: HTMLElement, result: Result): void {
    container.innerHTML = resultHtml(result, { localePrefix: localePath('') });
  }

  async function init(root: HTMLElement): Promise<void> {
    const input = el<HTMLInputElement>(root, '#snc-input');
    const resultsBox = el<HTMLElement>(root, '#snc-results');
    const summaryEl = el<HTMLElement>(root, '#snc-summary');
    const shareBtn = el<HTMLButtonElement>(root, '#snc-share');
    const copyAllBtn = el<HTMLButtonElement>(root, '#snc-copy-all');
    const copyStatus = el<HTMLElement>(root, '#snc-copy-status');
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('#snc-chips .snc-chip'));
    const snapSaveBtn = el<HTMLButtonElement>(root, '#snc-snap-save');
    const snapSelect = el<HTMLSelectElement>(root, '#snc-snap-select');
    const snapDeleteBtn = el<HTMLButtonElement>(root, '#snc-snap-delete');
    if (
      !input ||
      !resultsBox ||
      !summaryEl ||
      !shareBtn ||
      !copyAllBtn ||
      !copyStatus ||
      !snapSaveBtn ||
      !snapSelect ||
      !snapDeleteBtn
    )
      return;

    /* ------------------------------------------------------------------ */
    /* Copy plumbing (row buttons, Copy link, Copy all)                    */
    /* ------------------------------------------------------------------ */

    function setCopyStatus(message: string, failed: boolean): void {
      copyStatus!.textContent = message;
      copyStatus!.classList.toggle('sr-only', !failed);
      copyStatus!.classList.toggle('snc-copy-status--fail', failed);
    }

    function setCopied(btn: HTMLButtonElement, copied: boolean): void {
      btn.classList.toggle('snc-copy-btn--copied', copied);
      btn.querySelector('.snc-copy-icon')?.classList.toggle('hidden', copied);
      btn.querySelector('.snc-check-icon')?.classList.toggle('hidden', !copied);
      const label = btn.querySelector<HTMLElement>('.snc-copy-label');
      if (label) {
        label.textContent = copied ? 'Copied' : (btn.dataset.copyLabel ?? 'Copy');
      } else if (copied) {
        btn.dataset.prevAriaLabel = btn.getAttribute('aria-label') ?? '';
        btn.setAttribute('aria-label', 'Copied');
      } else if (btn.dataset.prevAriaLabel) {
        btn.setAttribute('aria-label', btn.dataset.prevAriaLabel);
        delete btn.dataset.prevAriaLabel;
      }
    }

    async function handleCopy(btn: HTMLButtonElement): Promise<void> {
      const text = btn.dataset.copy ?? '';
      const ok = await copyTextToClipboard(text);
      if (ok) {
        setCopied(btn, true);
        setCopyStatus('Copied to clipboard.', false);
        window.clearTimeout(Number(btn.dataset.copyTimer));
        btn.dataset.copyTimer = String(
          window.setTimeout(() => {
            setCopied(btn, false);
            if (copyStatus!.textContent === 'Copied to clipboard.') setCopyStatus('', false);
          }, RESET_MS)
        );
      } else {
        setCopyStatus('Copy failed — select the value manually.', true);
      }
    }

    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.snc-copy-btn');
      if (!btn) return;
      void handleCopy(btn);
    });

    /* ------------------------------------------------------------------ */
    /* Engine                                                              */
    /* ------------------------------------------------------------------ */

    let engine: EngineModule;
    try {
      engine = (await import('../lib/subnet-calculator/engine')) as unknown as EngineModule;
    } catch (err) {
      renderError(
        resultsBox,
        summaryEl,
        'The calculator engine failed to load. Reload the page to try again.',
        true
      );
      console.error('[SubnetCalculator] engine import failed:', err);
      return;
    }

    /* ------------------------------------------------------------------ */
    /* State machine: EMPTY | VALID | PENDING | INVALID                    */
    /* ------------------------------------------------------------------ */

    type State = 'empty' | 'valid' | 'pending' | 'invalid';
    let state: State = 'empty';
    let evalTimer: number | undefined;
    let errTimer: number | undefined;
    let lastWrittenHash: string | null = null;

    function clearTimers(): void {
      window.clearTimeout(evalTimer);
      window.clearTimeout(errTimer);
    }

    function writeHash(value: string | null): void {
      const target = value ? buildIpHash(value) : '';
      if (target === lastWrittenHash) return;
      // Safari throttles replaceState (~100/30s) and throws — never let that break input.
      try {
        if (value) {
          history.replaceState(null, '', target);
        } else {
          history.replaceState(null, '', location.pathname + location.search);
        }
        lastWrittenHash = target;
      } catch {
        /* ignore */
      }
    }

    function setErrorState(on: boolean): void {
      input!.classList.toggle('snc-input--error', on);
      if (on) {
        input!.setAttribute('aria-invalid', 'true');
        input!.setAttribute('aria-describedby', 'snc-input-hint snc-input-live snc-error-detail');
      } else {
        input!.removeAttribute('aria-invalid');
        input!.setAttribute('aria-describedby', 'snc-input-hint snc-input-live');
      }
    }

    function hideActions(): void {
      shareBtn!.hidden = true;
      shareBtn!.dataset.copy = '';
      copyAllBtn!.hidden = true;
      copyAllBtn!.dataset.copy = '';
    }

    function syncChips(value: string): void {
      chips.forEach((chip) => {
        chip.classList.toggle('is-active', (chip.dataset.input ?? '') === value);
      });
    }

    function clearChips(): void {
      chips.forEach((chip) => chip.classList.remove('is-active'));
    }

    function toEmpty(): void {
      state = 'empty';
      setErrorState(false);
      hideActions();
      renderEmpty(resultsBox!, summaryEl!);
      clearChips();
      writeHash(null);
    }

    function showError(message: string): void {
      state = 'invalid';
      clearTimers();
      setErrorState(true);
      hideActions();
      renderError(resultsBox!, summaryEl!, message);
      clearChips();
      writeHash(null);
    }

    function evaluate(source: 'type' | 'commit' | 'seed'): void {
      clearTimers();
      const value = input!.value.trim();
      if (value.length === 0) {
        toEmpty();
        return;
      }

      let result: Result | null = null;
      try {
        result = engine.calculate(value);
      } catch {
        result = null;
      }

      if (result && result.valid !== false) {
        state = 'valid';
        setErrorState(false);
        // Amber tick on the rows whose value changed — never on the boot seed.
        const prev = source === 'seed' ? new Map<string, string>() : snapshotValues(resultsBox!);
        renderResult(resultsBox!, result);
        markChanged(resultsBox!, prev);
        setSummary(summaryEl!, result.summary ?? '', false);
        const normalized = result.normalized ?? value;
        shareBtn!.hidden = false;
        shareBtn!.dataset.copy =
          location.origin + location.pathname + location.search + buildIpHash(normalized);
        copyAllBtn!.hidden = false;
        copyAllBtn!.dataset.copy = buildCopyAll(result);
        syncChips(value);
        if (source !== 'seed') writeHash(normalized);
        if (source !== 'seed') recordToolLastInput('subnet-calculator', value);
        return;
      }

      const message = result?.error ?? 'Unexpected error while calculating.';
      if (source !== 'type') {
        showError(message);
        return;
      }

      // Mid-typing: hold the last card, no red yet. Only surface the error
      // after a pause — and not while the value still looks unfinished.
      state = 'pending';
      setErrorState(false);
      hideActions();
      setSummary(summaryEl!, '', false);
      if (!/[.:\s]$/.test(input!.value)) {
        errTimer = window.setTimeout(() => showError(message), ERROR_HOLD_MS);
      }
    }

    /* ------------------------------------------------------------------ */
    /* Events                                                              */
    /* ------------------------------------------------------------------ */

    input.addEventListener('input', () => {
      clearTimers();
      if (input.value.trim().length === 0) {
        toEmpty();
        return;
      }
      evalTimer = window.setTimeout(() => evaluate('type'), DEBOUNCE_MS);
    });

    wireRunKeys(input, () => evaluate('commit'));

    input.addEventListener('blur', () => {
      if (state === 'pending') evaluate('commit');
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        input.value = chip.dataset.input ?? '';
        evaluate('commit');
      });
    });

    wireSnapshotUI({
      slug: 'subnet-calculator',
      saveBtn: snapSaveBtn,
      snapshotSelect: snapSelect,
      deleteBtn: snapDeleteBtn,
      getValue: () => input!.value.trim(),
      setValue: (value) => {
        input!.value = value;
        evaluate('commit');
      },
    });

    /* ------------------------------------------------------------------ */
    /* First load: existing value → #ip= deep link → restored last input   */
    /* → seeded first chip. Seeding never writes the hash — only user      */
    /* actions do.                                                          */
    /* ------------------------------------------------------------------ */

    const hashValue = readIpHash();
    const restored = getRestoredLastInput('subnet-calculator');
    const seed = chips[0]?.dataset.input ?? '';

    if (input.value.trim()) {
      evaluate('seed');
    } else if (hashValue) {
      input.value = hashValue;
      evaluate('seed');
    } else if (restored) {
      input.value = restored;
      evaluate('seed');
    } else if (seed) {
      input.value = seed;
      evaluate('seed');
    } else {
      renderEmpty(resultsBox, summaryEl);
    }
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
