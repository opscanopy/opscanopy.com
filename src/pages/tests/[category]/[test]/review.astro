---
/**
 * Practice Tests review page (/tests/<category>/<test>/review/) — INDEXABLE.
 *
 * Why this exists: the ~7,500 words of DOP-C02 scenario stems and explanations lived
 * only inside the test runner, which is `noindex` because it is an application UI
 * (its sole <h1> is "Results", in a hidden panel, and the questions render inside a
 * <form>). So the entire question corpus was invisible to search engines while the
 * two indexable pages in the section carried 74 and 59 words between them.
 *
 * This route renders the same content as readable prose instead: scenario, options
 * with the answer marked, and the full explanation. It is deliberately a SEPARATE URL
 * rather than un-noindexing the runner — an app in the results page serves nobody.
 *
 * Sitemap: no config change needed. The exclusion regex in astro.config.mjs is
 * /\/tests\/[^/]+\/[^/]+\/?$/ — anchored at exactly two segments, so it drops the
 * runner and admits this three-segment URL. Verified against all four URL shapes.
 *
 * No Quiz/Practice-Problems markup: Google deprecated Practice Problems (removed from
 * Search Console reporting and the Rich Results Test from January 2026), and the
 * surviving Education Q&A feature that uses `Quiz` is scoped to flashcard pages —
 * a question one side, an answer the other — not scenario multiple choice. The value
 * here is indexable words, not a rich result that will not appear.
 */
import Shell from '../../../../components/Shell.astro';
import Button from '../../../../components/Button.astro';
import { getCategory } from '../../../../data/tests';
import { testStaticPaths } from '../../../../lib/tests/static-paths';
import { breadcrumbLd } from '../../../../lib/jsonld';
import { site } from '../../../../data/site';

export const getStaticPaths = testStaticPaths;

const { test, file } = Astro.props;
const category = getCategory(test.categorySlug)!;
const categoryHref = `/tests/${test.categorySlug}/`;
const takeHref = `/tests/${test.categorySlug}/${test.slug}/`;
const canonical = `/tests/${test.categorySlug}/${test.slug}/review`;

const questions = file.data.questions;
const multiCount = questions.filter((q) => q.correctAnswers.length > 1).length;

const jsonLd = breadcrumbLd([
  { name: 'Home', item: `${site.url}/` },
  { name: 'Practice Tests', item: `${site.url}/tests/` },
  { name: category.shortName, item: `${site.url}${categoryHref}` },
  { name: `${test.name} — answers explained`, item: `${site.url}${canonical}/` },
]);

const letter = (i: number) => String.fromCharCode(65 + i);
---

<Shell
  title={`${test.name}: Answers Explained — ${category.shortName}`}
  description={`All ${questions.length} questions from ${test.name}, each with the correct answer and why every other option is wrong. Original ${category.shortName} scenarios.`}
  canonical={canonical}
  jsonLd={jsonLd}
  noAlternates
>
  <section class="bg-canvas-soft border-b border-hairline">
    <div class="container-page max-w-[52rem] py-8 sm:py-10">
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol role="list" class="caption flex flex-wrap items-center gap-x-1.5 text-mute">
          <li><a href="/" class="hover:text-ink">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/tests/" class="hover:text-ink">Practice Tests</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={categoryHref} class="hover:text-ink">{category.shortName}</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-body" aria-current="page">{test.name} — answers</li>
        </ol>
      </nav>

      <p class="eyebrow">Answers &amp; explanations</p>
      <h1 class="display-lg mt-3 text-balance text-ink">{test.name}: every answer explained.</h1>

      <p class="body-md mt-4 max-w-2xl text-pretty text-body">
        All {questions.length} questions from this set, with the correct answer marked and a full
        explanation of why it is right — and why each plausible alternative is not.
        {multiCount > 0 && ` ${multiCount} of them are multi-answer, which the ${category.shortName} exam uses heavily.`}
        Read it as a study sheet, or take the set under timed conditions first and come back.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <Button href={takeHref} variant="primary">Take this test instead</Button>
        <a href={categoryHref} class="link-inline body-sm inline-flex items-center gap-1 font-medium">
          <span aria-hidden="true">&larr;</span>
          All {category.shortName} tests
        </a>
      </div>

      {/*
        Stated on the page, not just in a commit message: these are original items
        written for this site. Reproducing real exam content breaches the AWS
        Certification Agreement, and it is the practice that "brain dump" sites exist
        for. Being the opposite of that is the only honest differentiator available.
      */}
      <p class="caption mt-6 max-w-2xl text-mute">
        Every question here is original, written for this site to match the style and
        difficulty of the real exam. None are reproduced from an actual exam — that would
        breach the certification agreement and would not teach you anything.
      </p>
    </div>
  </section>

  <section class="bg-canvas">
    <div class="container-page max-w-[52rem] py-12 sm:py-16">
      <ol role="list" class="flex flex-col gap-12">
        {
          questions.map((q, qi) => (
            <li id={`q${qi + 1}`} class="scroll-mt-24">
              <div class="flex items-baseline gap-3">
                <span class="caption font-mono text-mute">Q{qi + 1}</span>
                {q.correctAnswers.length > 1 && (
                  <span class="badge">Choose {q.correctAnswers.length}</span>
                )}
              </div>

              {/* Every paragraph but the last is scenario; the last is the question. */}
              <div class="mt-3 flex flex-col gap-3">
                {q.prompt.slice(0, -1).map((para) => (
                  <p class="body-md text-pretty text-body">{para}</p>
                ))}
              </div>
              <h2 class="body-lg mt-3 font-semibold text-balance text-ink">
                {q.prompt[q.prompt.length - 1]}
              </h2>

              <ul role="list" class="mt-4 flex flex-col gap-2">
                {q.options.map((opt, oi) => {
                  const correct = q.correctAnswers.includes(oi);
                  return (
                    <li
                      class={
                        correct
                          ? 'card-soft border-brand bg-brand-soft/40 p-3'
                          : 'card-soft p-3'
                      }
                    >
                      <span class="flex gap-3">
                        <span
                          class={
                            correct
                              ? 'caption font-mono font-semibold text-brand-strong'
                              : 'caption font-mono text-mute'
                          }
                        >
                          {letter(oi)}
                        </span>
                        <span class="body-sm text-pretty text-body">{opt}</span>
                        {correct && (
                          <span class="caption ml-auto shrink-0 font-semibold text-brand-strong">
                            Correct
                          </span>
                        )}
                      </span>
                    </li>
                  );
                })}
              </ul>

              <div class="mt-4 border-l-2 border-hairline pl-4">
                <p class="caption font-semibold text-ink">
                  Why {q.correctAnswers.map((i) => letter(i)).join(' and ')}
                </p>
                <p class="body-sm mt-2 text-pretty text-body">{q.explanation}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="mt-14 border-t border-hairline pt-8">
        <p class="body-md text-pretty text-body">
          Ready to try it without the answers in front of you?
        </p>
        <div class="mt-4">
          <Button href={takeHref} variant="primary">Take {test.name}</Button>
        </div>
      </div>
    </div>
  </section>
</Shell>
