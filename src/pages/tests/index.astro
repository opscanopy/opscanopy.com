---
/**
 * Practice Tests hub (/tests) — the certification category grid, then one
 * sample question as a static instrument plate.
 *
 * Indexed + in the sitemap + Pagefind. Everything renders perfectly with JS or
 * storage blocked: the static markup IS the cold-start / first-visit state. A
 * small boot script reads `oc-tests-v1` and stamps per-test "Best {pct}%"
 * badges on the cards where a stored best exists (progressive enhancement).
 *
 * Modelled on learn/index.astro + mission-90/index.astro.
 */
import { getCollection } from 'astro:content';
import Shell from '../../components/Shell.astro';
import PageHero from '../../components/PageHero.astro';
import FigureCap from '../../components/FigureCap.astro';
import { liveCategories, liveTestsInCategory } from '../../data/tests';
import { breadcrumbLd, itemListLd } from '../../lib/jsonld';
import { site } from '../../data/site';

// Per-category view-model: live-test count + card href + figure numeral.
const cards = liveCategories.map((category, i) => ({
  category,
  href: `/tests/${category.slug}/`,
  liveCount: liveTestsInCategory(category.slug).length,
  figNo: String(i + 1).padStart(2, '0'),
}));

// Sample-question plate — ONE question from a live set, rendered statically
// (no runner, no scoring) with its answer and explanation behind a <details>.
// Chosen by file + id, and the build fails if either goes away, so the plate
// can never silently fall back to a different question. Practice Set 2 is
// written for OpsCanopy (not a reproduced exam item); q8 is single-answer.
const SAMPLE = { category: 'aws-devops-professional', test: 'dop-c02-practice-set-2', id: 'q8' } as const;
const sampleFile = (await getCollection('practiceTestQuestions')).find(
  (f) => f.data.category === SAMPLE.category && f.data.test === SAMPLE.test,
);
const sampleQ = sampleFile?.data.questions.find((q) => q.id === SAMPLE.id);
const sampleTest = liveTestsInCategory(SAMPLE.category).find((t) => t.slug === SAMPLE.test);
const sampleCategory = liveCategories.find((c) => c.slug === SAMPLE.category);
if (!sampleQ || !sampleTest || !sampleCategory) {
  throw new Error(`tests hub: sample question ${SAMPLE.category}/${SAMPLE.test}#${SAMPLE.id} is missing or not live`);
}
const sampleScenario = sampleQ.prompt.slice(0, -1);
const sampleStem = sampleQ.prompt[sampleQ.prompt.length - 1];
const letter = (i: number) => String.fromCharCode(65 + i);
const sampleKey = sampleQ.correctAnswers.map(letter).join(', ');
const sampleHref = `/tests/${SAMPLE.category}/${SAMPLE.test}/`;
const sampleNumber = sampleFile!.data.questions.findIndex((q) => q.id === SAMPLE.id) + 1;

const canonical = '/tests';
const jsonLd = [
  breadcrumbLd([
    { name: 'Home', item: `${site.url}/` },
    { name: 'Practice Tests', item: `${site.url}/tests/` },
  ]),
  itemListLd(
    cards.map((c) => ({ name: c.category.name, url: `${site.url}${c.href}` })),
  ),
];
---
<Shell
  title="Free Certification Practice Tests"
  description="Free, browser-based multiple-choice practice tests for DevOps certifications. Realistic scenario questions, instant scoring, and per-question explanations."
  canonical={canonical}
  jsonLd={jsonLd}
  noAlternates
>
  <PageHero variant="hub" eyebrow="Practice Tests · Certification prep" class="bg-canvas-soft">
    Free certification practice tests.
    <Fragment slot="lede">
      Sharpen up for your next certification with free, realistic multiple-choice practice tests.
      Every question runs entirely in your browser — instant scoring, per-question explanations,
      and your best score saved locally. No signup, no paywall.
    </Fragment>
  </PageHero>

  <section class="bg-canvas-soft">
    <div class="container-page pb-16 sm:pb-24">
      <p class="eyebrow">Choose a certification</p>
      <ul
        role="list"
        class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-[repeat(auto-fit,minmax(18rem,22rem))] lg:justify-center"
      >
        {
          cards.map(({ category, href, liveCount, figNo }) => (
            <li class="h-full">
              <div
                class="card card-interactive relative flex h-full flex-col overflow-hidden p-6"
                data-test-category
                data-slug={category.slug}
              >
                <div
                  class="relative -mx-6 -mt-6 mb-5 flex h-24 items-center justify-center border-b border-hairline bg-canvas-soft-2 text-brand-strong"
                  aria-hidden="true"
                >
                  <span class="code-mono absolute left-4 top-3 text-[12px] font-medium text-accent-ink">{figNo}</span>
                  <svg
                    width="48"
                    height="48"
                    viewBox="0 0 48 48"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <Fragment set:html={category.icon} />
                  </svg>
                </div>
                <h3 class="display-sm text-ink">
                  <a
                    href={href}
                    class="rounded-sm outline-none after:absolute after:inset-0 after:content-['']"
                  >
                    {category.name}
                  </a>
                </h3>
                <p class="badge-mono mt-1.5 text-mute">{category.shortName}</p>
                <p class="body-sm mt-2.5 text-pretty text-body">{category.description}</p>
                <div class="mt-3.5 flex flex-wrap items-center gap-1.5">
                  {liveCount >= 2 && <span class="badge badge-mono">{liveCount} tests</span>}
                  {/* Best-score badge — filled by the boot script when a stored
                      best exists for any test in this category; hidden cold. */}
                  <span class="badge tests-best-badge" data-best-badge hidden>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0 0 12 0V2Z" /></svg>
                    <span data-best-badge-text></span>
                  </span>
                </div>
                <div class="mt-auto pt-5">
                  <span class="link-cta body-sm">View tests</span>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Sample question — one item as a static instrument plate. The answer and
      explanation sit behind a <details>: closed, but rendered in the document
      (never `hidden`), so the explanation is part of the page. */}
  <section class="border-t border-hairline bg-canvas" aria-labelledby="tests-sample-heading">
    <div class="container-page py-16 sm:py-20">
      <p class="eyebrow">Sample question</p>
      <h2 id="tests-sample-heading" class="display-md mt-3 text-balance text-ink">Try one before you start.</h2>
      <p class="body-md measure-prose mt-3 text-pretty text-body">
        Question {sampleNumber} of the {sampleCategory.shortName} {sampleTest.name}, exactly as the test asks it.
        Decide on an answer, then open the explanation.
      </p>

      <figure class="instrument measure-wide mt-8" data-tests-sample>
        <FigureCap label={`${SAMPLE.test} · ${SAMPLE.id}`} tone="traffic" />
        <div class="px-5 py-6 sm:px-8 sm:py-7">
          {sampleScenario.map((para) => <p class="body-md text-pretty text-inverse-fg">{para}</p>)}
          <p class="body-md mt-3 font-semibold text-pretty text-inverse-fg">{sampleStem}</p>
          <ol role="list" class="mt-5 flex flex-col gap-2.5">
            {
              sampleQ.options.map((opt, i) => (
                <li class="tests-sample-option flex gap-3 rounded-[var(--radius-sm)] px-3 py-2.5">
                  <span class="code-mono shrink-0 font-medium text-inverse-mute">{letter(i)}</span>
                  <span class="body-sm text-pretty text-inverse-fg">{opt}</span>
                </li>
              ))
            }
          </ol>
          <details class="mt-6 border-t border-inverse-hairline pt-4">
            <summary class="body-sm font-medium text-inverse-brand">Show the answer and explanation</summary>
            <p class="code-mono mt-3 text-inverse-accent">Answer {sampleKey}</p>
            <p class="body-sm mt-2 text-pretty text-inverse-mute">{sampleQ.explanation}</p>
          </details>
        </div>
      </figure>

      <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
        <a href={sampleHref} class="link-cta body-sm">Take {sampleTest.name}</a>
        <a href={`${sampleHref}review/`} class="link-cta body-sm">Every answer explained</a>
      </p>
    </div>
  </section>
</Shell>

<style>
  .tests-sample-option {
    box-shadow: inset 0 0 0 1px var(--color-inverse-hairline);
  }
  .tests-best-badge {
    border: 1px solid color-mix(in srgb, var(--color-brand) 30%, transparent);
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
    font-weight: 600;
  }
</style>

<script>
  import { parseProgress, bestFor, PROGRESS_KEY } from '../../lib/tests/progress';
  import { liveTestsInCategory, testKey } from '../../data/tests';

  function boot(): void {
    let progress;
    try {
      progress = parseProgress(localStorage.getItem(PROGRESS_KEY));
    } catch {
      return; // storage blocked — leave the cold static markup as-is
    }

    document
      .querySelectorAll<HTMLElement>('[data-test-category]')
      .forEach((card) => {
        const slug = card.dataset.slug ?? '';
        // Highest stored best across every live test in this category.
        let best: number | undefined;
        for (const test of liveTestsInCategory(slug)) {
          const attempt = bestFor(progress, testKey(test.categorySlug, test.slug));
          if (attempt && (best === undefined || attempt.bestPct > best)) {
            best = attempt.bestPct;
          }
        }
        if (best === undefined) return;
        const badge = card.querySelector<HTMLElement>('[data-best-badge]');
        const text = card.querySelector<HTMLElement>('[data-best-badge-text]');
        if (badge && text) {
          text.textContent = `Best ${best}%`;
          badge.hidden = false;
        }
      });
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
