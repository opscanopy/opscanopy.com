---
/**
 * /learn/roadmaps/ — the roadmap index.
 *
 * This URL 404'd. `src/pages/learn/roadmaps/` held only `[slug].astro`, so the
 * directory itself was never built — a linkable-looking path that did not exist, and
 * the parent of six pages that are in the sitemap. Same gap existed at
 * /learn/guides/.
 *
 * Emits ItemList, NOT Course — despite six of them being on one page, which is the
 * threshold Google's Course rich result needs. Course requires "instructor leadership
 * and student enrollment" and an explicit educational outcome; a self-paced checkbox
 * roadmap has none of those. Marking it up as a Course to chase a rich result would
 * misrepresent the content, which is the kind of thing that earns a manual action
 * rather than a carousel.
 */
import Shell from '../../../components/Shell.astro';
import { roadmaps } from '../../../data/roadmaps';
import { breadcrumbLd } from '../../../lib/jsonld';
import { site } from '../../../data/site';

const canonical = '/learn/roadmaps';

const jsonLd = [
  breadcrumbLd([
    { name: 'Home', item: `${site.url}/` },
    { name: 'Learn', item: `${site.url}/learn/` },
    { name: 'Roadmaps', item: `${site.url}${canonical}/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'OpsCanopy DevOps roadmaps',
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: roadmaps.length,
    itemListElement: roadmaps.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: r.title,
      description: r.description,
      url: `${site.url}/learn/roadmaps/${r.slug}/`,
    })),
  },
];

const nodeCount = (slug: string) =>
  roadmaps.find((r) => r.slug === slug)!.stages.reduce((n, st) => n + st.nodes.length, 0);
---

<Shell
  title="DevOps Roadmaps — Linux, Docker, Kubernetes, AWS, Networking"
  description="Six free, staged learning paths for DevOps engineers — the full DevOps roadmap plus focused tracks for Linux, Docker, Kubernetes, AWS and networking."
  canonical={canonical}
  jsonLd={jsonLd}
  noAlternates
>
  <section class="border-b border-hairline bg-canvas-soft">
    <div class="container-page max-w-[52rem] py-8 sm:py-12">
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol role="list" class="caption flex flex-wrap items-center gap-x-1.5 text-mute">
          <li><a href="/" class="hover:text-ink">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/learn/" class="hover:text-ink">Learn</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-body" aria-current="page">Roadmaps</li>
        </ol>
      </nav>

      <p class="eyebrow">Roadmaps</p>
      <h1 class="display-lg mt-3 text-balance text-ink">DevOps roadmaps.</h1>
      <p class="body-md mt-4 max-w-2xl text-pretty text-body">
        A roadmap answers one question a list of topics cannot: <em>what order</em>. Learning
        Kubernetes before you can read a process table, or containers before you understand what a
        network namespace is, is what makes DevOps feel impossibly broad. Each of these stages the
        material so every step rests on the one before it.
      </p>
      <p class="body-md mt-3 max-w-2xl text-pretty text-body">
        Tick topics off as you go — progress is saved in your browser, with no account and nothing
        uploaded. Start with the full DevOps roadmap if you are new, or go straight to a track if
        you are filling a specific gap.
      </p>
    </div>
  </section>

  <section class="bg-canvas">
    <div class="container-page max-w-[52rem] py-12 sm:py-16">
      <ul role="list" class="flex flex-col gap-4">
        {
          roadmaps.map((r) => (
            <li>
              <a
                href={`/learn/roadmaps/${r.slug}/`}
                class="card-soft flex flex-col gap-2 p-5 transition-colors hover:border-brand"
              >
                <span class="flex flex-wrap items-baseline gap-3">
                  <span class="body-lg font-semibold text-ink">{r.title}</span>
                  <span class="caption font-mono text-mute">
                    {r.stages.length} stages · {nodeCount(r.slug)} topics
                  </span>
                </span>
                <span class="body-sm text-pretty text-body">{r.description}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-12 border-t border-hairline pt-8 flex flex-wrap gap-x-6 gap-y-3">
        <a href="/learn/" class="link-inline body-sm inline-flex items-center gap-1 font-medium">
          <span aria-hidden="true">&larr;</span>
          Back to Learn
        </a>
        <a href="/learn/guides/" class="link-inline body-sm font-medium">Browse the guides</a>
        <a href="/mission-90/" class="link-inline body-sm font-medium">Prefer a day-by-day plan?</a>
      </div>
    </div>
  </section>
</Shell>
