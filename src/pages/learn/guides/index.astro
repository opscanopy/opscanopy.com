---
/**
 * /learn/guides/ — the guide index.
 *
 * Second of the two 404s: `src/pages/learn/guides/` held only `[...slug].astro`, so
 * this directory was never built even though seven guide pages sit under it and are
 * in the sitemap. See the sibling note in ../roadmaps/index.astro.
 *
 * The guides are the site's largest content asset by a wide margin — 6,000 to 50,000
 * words each — and until now the only routes into them were roadmap nodes and a
 * single track card on /learn/. There was no page that simply listed them.
 *
 * ItemList only, deliberately, for the same reason as the roadmap index: these are
 * articles, not Courses with enrollment and an instructor.
 */
import Shell from '../../../components/Shell.astro';
import { getGuidesForLocale, estimateReadingTime } from '../../../lib/learn/guides';
import { getTrack } from '../../../data/learn';
import { breadcrumbLd } from '../../../lib/jsonld';
import { site } from '../../../data/site';
import { DEFAULT_LOCALE } from '../../../i18n/config';

const guides = await getGuidesForLocale(DEFAULT_LOCALE);

// Group by track so the list reads as a curriculum rather than an alphabetical dump.
const byTrack = new Map<string, typeof guides>();
for (const g of guides) {
  const t = g.entry.data.track;
  byTrack.set(t, [...(byTrack.get(t) ?? []), g]);
}
for (const [, list] of byTrack) list.sort((a, b) => a.entry.data.order - b.entry.data.order);

const totalMinutes = guides.reduce(
  (n, g) => n + (g.entry.data.estMinutes ?? estimateReadingTime(g.entry.body)),
  0,
);

const canonical = '/learn/guides';

const jsonLd = [
  breadcrumbLd([
    { name: 'Home', item: `${site.url}/` },
    { name: 'Learn', item: `${site.url}/learn/` },
    { name: 'Guides', item: `${site.url}${canonical}/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'OpsCanopy DevOps guides',
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: guides.length,
    itemListElement: guides.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: g.entry.data.title,
      description: g.entry.data.metaDescription ?? g.entry.data.description,
      url: `${site.url}/learn/guides/${g.slug}/`,
    })),
  },
];
---

<Shell
  title="DevOps Guides — Linux, Docker, Kubernetes, AWS & Networking — OpsCanopy"
  description={`${guides.length} in-depth, hands-on guides for DevOps engineers — Linux, Docker, Kubernetes, AWS, networking and portfolio projects. Free to read, no signup, roughly ${Math.round(totalMinutes / 60)} hours of material.`}
  canonical={canonical}
  jsonLd={jsonLd}
  noAlternates
>
  <section class="border-b border-hairline bg-canvas-soft">
    <div class="container-page max-w-[52rem] py-8 sm:py-12">
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol role="list" class="caption flex flex-wrap items-center gap-x-1.5 text-mute">
          <li><a href="/" class="hover:text-ink">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/learn/" class="hover:text-ink">Learn</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-body" aria-current="page">Guides</li>
        </ol>
      </nav>

      <p class="eyebrow">Guides</p>
      <h1 class="display-lg mt-3 text-balance text-ink">DevOps guides.</h1>
      <p class="body-md mt-4 max-w-2xl text-pretty text-body">
        Long-form, worked-through explanations rather than reference pages — {guides.length} of
        them, roughly {Math.round(totalMinutes / 60)} hours of reading. Each one goes deep enough
        that you finish able to debug the thing, not just name it.
      </p>
      <p class="body-md mt-3 max-w-2xl text-pretty text-body">
        If you are not sure where to start, the <a href="/learn/roadmaps/devops/" class="link-inline"
          >DevOps roadmap</a
        > sequences these in the order they build on each other.
      </p>
    </div>
  </section>

  <section class="bg-canvas">
    <div class="container-page max-w-[52rem] py-12 sm:py-16">
      <div class="flex flex-col gap-10">
        {
          [...byTrack.entries()].map(([track, list]) => (
            <div>
              <h2 class="body-lg font-semibold text-ink">{getTrack(track)?.name ?? track}</h2>
              <ul role="list" class="mt-3 flex flex-col gap-3">
                {list.map((g) => (
                  <li>
                    <a
                      href={`/learn/guides/${g.slug}/`}
                      class="card-soft flex flex-col gap-2 p-5 transition-colors hover:border-brand"
                    >
                      <span class="flex flex-wrap items-baseline gap-3">
                        <span class="body-md font-semibold text-ink">{g.entry.data.title}</span>
                        <span class="caption font-mono text-mute">
                          {g.entry.data.estMinutes ?? estimateReadingTime(g.entry.body)} min ·{' '}
                          {g.entry.data.difficulty}
                        </span>
                      </span>
                      <span class="body-sm text-pretty text-body">
                        {g.entry.data.metaDescription ?? g.entry.data.description}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="mt-12 border-t border-hairline pt-8 flex flex-wrap gap-x-6 gap-y-3">
        <a href="/learn/" class="link-inline body-sm inline-flex items-center gap-1 font-medium">
          <span aria-hidden="true">&larr;</span>
          Back to Learn
        </a>
        <a href="/learn/roadmaps/" class="link-inline body-sm font-medium">Browse the roadmaps</a>
        <a href="/tests/" class="link-inline body-sm font-medium">Practice tests</a>
      </div>
    </div>
  </section>
</Shell>
