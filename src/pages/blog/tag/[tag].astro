---
/**
 * /blog/tag/[tag] — posts filed under a single tag.
 *
 * SCOPE: default locale (en) only. Per-locale tag routing
 * (/es/blog/tag/…, /de/blog/tag/… …) is a deliberate follow-up — keeping this
 * to en avoids generating localized tag URLs the cards/breadcrumbs would have
 * to special-case, and keeps the i18n routing + build green. When localizing,
 * add src/pages/[lang]/blog/tag/[tag].astro mirroring this file with `lang`
 * threaded through getAllTags/getPostsByTag and localizeKey on every href.
 *
 * Tag slugs are lowercased (see getAllTags); matching is case-insensitive so a
 * "Cron" frontmatter tag and /blog/tag/cron resolve to the same page.
 */
import Shell from '../../../components/Shell.astro';
import PageHero from '../../../components/PageHero.astro';
import BlogCard from '../../../components/page/BlogCard.astro';
import { DEFAULT_LOCALE } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/utils';
import { breadcrumbLd } from '../../../lib/jsonld';
import { site } from '../../../data/site';
import { getAllPosts, getAllTags, getPostsByTag } from '../../../i18n/blog';

const lang = DEFAULT_LOCALE;

export async function getStaticPaths() {
  const all = await getAllPosts();
  const tags = getAllTags(DEFAULT_LOCALE, all);
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props as { tag: string };
const t = useTranslations(lang);

const allPosts = await getAllPosts();
const posts = getPostsByTag(tag, lang, allPosts);

const canonical = `/blog/tag/${tag}`;

/**
 * Tags with too few posts are noindexed — the page still works for anyone who
 * lands on it, it just stops competing as thin content. The set is computed once
 * by scripts/gen-thin-tags.mjs and read here AND by the sitemap filter in
 * astro.config.mjs, so the two can never disagree.
 *
 * Shell's `noindex` emits `noindex,nofollow`. `noindex,follow` would be the more
 * careful signal in general, but it buys nothing here: every post a tag page
 * links to is already linked from /blog/ and from the related-posts blocks, so
 * no post depends on these pages for discovery. Not worth widening the SEO
 * component's API for.
 *
 * Read via a dynamic import with a fallback: the file is gitignored and written
 * in `prebuild`, so a bare `astro dev` has none, and every tag stays indexable
 * (the pre-existing behaviour) rather than the page failing to render.
 */
let thinTags: string[] = [];
try {
  thinTags = (await import('../../../data/thin-tags.generated.json')).default.thin;
} catch {
  /* no prebuild artefact — leave every tag indexable */
}
const isThin = thinTags.includes(tag);

const breadcrumbJsonLd = breadcrumbLd([
  { name: t('blog.breadcrumbHome'), item: `${site.url}/` },
  { name: t('blog.breadcrumbBlog'), item: `${site.url}/blog/` },
  { name: tag, item: `${site.url}${canonical}/` },
]);
---

<Shell
  title={t('blog.tagTitle', { tag })}
  description={t('blog.tagMetaDescription', { tag, count: posts.length })}
  canonical={canonical}
  noAlternates
  noindex={isThin}
>
  <PageHero variant="hub" eyebrow={t('blog.tagEyebrow')} class="bg-canvas-soft">
    <nav slot="breadcrumb" aria-label={t('blog.breadcrumbAriaLabel')}>
      <ol role="list" class="caption flex flex-wrap items-center gap-x-1.5 gap-y-1 text-mute">
        <li>
          <a href="/" class="rounded px-0.5 transition-colors hover:text-ink">
            {t('blog.breadcrumbHome')}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/blog/" class="rounded px-0.5 transition-colors hover:text-ink">
            {t('blog.breadcrumbBlog')}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="min-w-0 truncate text-body" aria-current="page">{tag}</li>
      </ol>
    </nav>
    {t('blog.tagTitle', { tag })}
    <Fragment slot="lede">{t('blog.tagLead', { tag })}</Fragment>
    {
      posts.length > 0 && (
        <p slot="meta" class="flex items-center gap-2">
          <span class="tabular-nums">{posts.length}</span>
          {posts.length === 1 ? t('blog.tagCountSingular') : t('blog.tagCountPlural')}
        </p>
      )
    }
  </PageHero>

  <section class="border-b border-hairline bg-canvas-soft">
    <div class="container-page pb-16 pt-12 sm:pb-24">
      <ul role="list" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <BlogCard post={post} lang={lang} />)}
      </ul>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Shell>
