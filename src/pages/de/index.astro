---
/**
 * OpsCanopy hub homepage — the flagship marketing surface.
 * Composes the Vercel-inspired design system defined in global.css / DESIGN.md.
 * Structural mirror of src/pages/index.astro (English) — see that file for the
 * canonical section order; keep both in sync when the layout changes.
 *
 * Section order (Batch E, 2026-10; the outline lives in the PR description):
 *   1 claim (hero + HeroDemo) → 2 proof ledger → 3 numbered tool index →
 *   4 Mission 90 drill → 5 Learn → 6 why + privacy band → 7 incident ledger →
 *   8 verify plate → 9 FAQ → 10 two-door close.
 * Surfaces alternate (soft / canvas / soft …) so no two adjacent sections share
 * a surface and their paddings never stack. Every band's markup lives in
 * src/components/home/* once; this file carries only the translated copy.
 *
 * Copy rule: "free", "no signup" and "in your browser" (in this locale's
 * words) appear once above the fold (H1 + lede) and nowhere else outside the
 * FAQ and <title>/meta. Two exceptions are deliberate: the HomeDoors texts and
 * the Mission CTA are watched anchors (the SEO guard fails closed on any
 * change), and the privacy paragraph in the why band is kept verbatim.
 */
import Shell from '../../components/Shell.astro';
import MeshGradient from '../../components/MeshGradient.astro';
import HeroDemo from '../../components/home/HeroDemo.astro';
import PrivacyProof from '../../components/home/PrivacyProof.astro';
import ProofStrip from '../../components/home/ProofStrip.astro';
import ToolsGrid from '../../components/home/ToolsGrid.astro';
import HomeDoors from '../../components/home/HomeDoors.astro';
import MissionBand from '../../components/home/MissionBand.astro';
import VerifyPlate from '../../components/home/VerifyPlate.astro';
import HomeFaq from '../../components/home/HomeFaq.astro';
import TwoDoorClose from '../../components/home/TwoDoorClose.astro';
import Button from '../../components/Button.astro';
import LatestPosts from '../../components/home/LatestPosts.astro';
import JumpBackIn from '../../components/JumpBackIn.astro';
import TrackCard from '../../components/learn/TrackCard.astro';
import { liveTools, getTool } from '../../data/tools';
import { tracks } from '../../data/learn';
import { liveTests } from '../../data/tests';
import { program, phases as m90Phases, missions as m90Missions, totalCoreMinutes } from '../../data/mission90';
import { getGuidesForLocale, estimateReadingTime } from '../../lib/learn/guides';
import { faqPageLd } from '../../lib/jsonld';
import {
  GHA_SEMANTICS_VERSION,
  exprCorpus,
  ifCorpus,
  globCorpus,
  triggerCorpus,
} from '../../lib/github-actions-expression-tester/conformance';
import { JQ_VERSION } from '../../data/versions';
import type { Locale as __Locale } from '../../i18n/config';
import { localizeKey as __l, localizeNavHref as __nav } from '../../i18n/utils';

const __lang = (Astro.currentLocale ?? 'en') as __Locale;


// Featured catalog grid — a CURATED set of 9 representative tools, mirrors English.
const featuredSlugs = [
  // Leads with the five tools that have no competing browser tool at all; the last
  // four stay recognizable for a first-time visitor. See src/pages/index.astro.
  'github-actions-expression-tester',
  'alertmanager-route-tester',
  'prometheus-relabel-tester',
  'loki-alert-rule-tester',
  'jq-playground',
  'certificate-decoder',
  'subnet-calculator',
  'jwt-decoder',
  'cron-expression-tester',
];
const featuredTools = featuredSlugs
  .map((slug) => getTool(slug))
  .filter((t): t is NonNullable<typeof t> => Boolean(t) && t!.status === 'live');

// Learn band — /learn is English-only content (ENGLISH_ONLY_SECTIONS), so the
// guides themselves are fetched in English regardless of page locale.
const learnGuides = await getGuidesForLocale('en');
const learnByTrack = (slug: string) =>
  learnGuides.filter((g) => g.entry.data.track === slug).sort((x, y) => x.entry.data.order - y.entry.data.order);
const trackMeta = (slug: string) => {
  const gs = learnByTrack(slug);
  return {
    count: gs.length,
    minutes: gs.reduce((s, g) => s + (g.entry.data.estMinutes ?? estimateReadingTime(g.entry.body)), 0),
    difficulty: gs[0]?.entry.data.difficulty ?? 'beginner',
  };
};
const featuredTracks = tracks.filter((t) => ['linux', 'docker', 'kubernetes'].includes(t.slug));

// Mission-90 homepage feature band — figures derived from the registry, mirrors
// English. Mission-90 is also English-only content, so the transcript stays English.
const m90LiveMissions = m90Missions.filter((m) => m.status === 'live').length;
const m90Hours = Math.round(totalCoreMinutes / 60 / 10) * 10;
const m90Stats = [
  { n: String(program.totalDays), l: 'Tage' },
  { n: String(m90Phases.length), l: 'Phasen' },
  { n: String(m90LiveMissions), l: 'Browser-Missionen' },
  { n: `~${m90Hours}`, l: 'Std. Kerninhalt' },
];
const m90Transcript = `student@prod-web-01:~$ ps aux --sort=-%cpu | head -3
USER   PID   %CPU  COMMAND
root   4521  94.0  /opt/scripts/nightly-backup.sh
student@prod-web-01:~$ kill 4521
student@prod-web-01:~$ systemctl restart nginx
student@prod-web-01:~$ curl -sI localhost | head -1
HTTP/1.1 200 OK
# 02:07 — the site is back. You did that.`;

const faqs = [
  {
    q: 'Sind die OpsCanopy-Tools wirklich kostenlos?',
    a: 'Ja. Jedes Tool ist vollständig kostenlos, ohne Bezahlschranken, Nutzungslimits oder Premium-Stufen. Es gibt keinerlei Konto-Pflicht — öffnen Sie ein Tool in Ihrem Browser und nutzen Sie es sofort.',
  },
  {
    q: 'Muss ich mich registrieren, um diese Online-DevOps-Tools zu nutzen?',
    a: 'Nein. Es gibt keine Registrierung, kein Login und keine E-Mail-Erfassung. Öffnen Sie ein beliebiges Tool in Ihrem Browser-Tab und nutzen Sie es sofort — kein Konto, kein Cookie-Banner, keine Reibung. Die Web-Analyse ist in der EU, im Vereinigten Königreich und in der Schweiz standardmäßig cookielos und nutzt andernorts ein einzelnes Erstanbieter-Cookie — in beiden Fällen können Sie das auf der Datenschutzseite ändern.',
  },
  {
    q: 'Werden meine Daten auf einen Server hochgeladen, wenn ich die Tools nutze?',
    a: 'Nein. Jedes Tool läuft zu 100 % clientseitig in Ihrem Browser-Tab; nichts, was Sie einfügen, wird protokolliert, gespeichert oder hochgeladen. Ihre Daten verlassen den Browser nie.',
  },
  {
    q: 'Ist es sicher, ein JWT oder eine Konfiguration in ein browserbasiertes Tool einzufügen?',
    a: 'Bei OpsCanopy: ja. Das Decodieren und Parsen geschieht vollständig in lokalem JavaScript — nichts, was Sie einfügen, wird jemals übertragen, was Sie im Netzwerk-Tab des Browsers selbst überprüfen können (der einzige ausgehende Datenverkehr ist eine aggregierte Seiten-Analyse, die in unserer Datenschutzerklärung offengelegt ist). Als allgemeine Hygiene gilt: Geben Sie Signatur-Geheimnisse niemals an Dritte weiter — OpsCanopy lädt nichts von Ihren Eingaben hoch.',
  },
  {
    q: 'Funktionieren die Tools offline?',
    a: 'Sobald eine Tool-Seite geladen ist, funktioniert sie weiter, selbst wenn Sie die Internetverbindung trennen, denn die gesamte Verarbeitung erfolgt lokal und es gibt kein Backend, das aufgerufen werden müsste. Offline zu gehen ist außerdem eine einfache Möglichkeit, die Behauptung der clientseitigen Privatsphäre selbst zu überprüfen.',
  },
  {
    q: 'Für wen sind diese browserbasierten DevOps-Tools gedacht?',
    a: 'DevOps-Engineers, SREs, Sysadmins, Plattform- und Backend-Engineers — alle, die schnell Subnetz- und CIDR-Berechnungen, Cron-Zeitpläne, PromQL- oder LogQL-Abfragen, JWT-, Base64- und Hash-Werkzeuge, Timestamp-Umrechnung, GitHub-Actions-Validierung oder Kubernetes-Ressourcendimensionierung benötigen, ohne etwas zu installieren.',
  },
  {
    q: 'Warum diese Tools nutzen, statt ChatGPT oder Claude zu fragen?',
    a: 'Nutzen Sie beides — für unterschiedliche Aufgaben. Ein KI-Assistent ist hervorragend darin, Konzepte zu erklären und Konfigurationen zu entwerfen, aber er erzeugt plausiblen Text, statt Antworten zu berechnen, und exakte Arithmetik ist eine dokumentierte Schwachstelle: Subnetzgrenzen, Cron-Zeitpläne, Epoch-Umrechnungen und Regex-Verhalten sehen im Ergebnis regelmäßig richtig aus und sind trotzdem falsch. OpsCanopy-Tools berechnen Antworten deterministisch — echte Parser, exakte Mathematik — und rechnen sofort neu, während Sie die Eingabe anpassen, ohne erneutes Prompten, ohne Token-Kosten und ohne Rate-Limits; sobald die Seite eines Tools geladen ist, funktioniert sie auch offline weiter. Nichts, was Sie einfügen, wird jemals übertragen, sodass Logs, Tokens und Konfigurationen auf Ihrem Rechner bleiben. Mehrere Tools eignen sich sogar als praktische Kontrolle für KI-Antworten: Lassen Sie dasselbe Subnetz, denselben Cron-Ausdruck oder Timestamp durch sie laufen, und Sie erhalten die verlässliche Referenz für den Vergleich.',
  },
  {
    q: 'Wie unterscheidet sich OpsCanopy von anderen Online-Sammlungen für Entwickler-Tools?',
    a: 'Die meisten Tool-Sammlungen konzentrieren sich auf generische Formatierer. OpsCanopy spezialisiert sich auf DevOps- und SRE-Workflows — CIDR-Planung, Cron, PromQL und LogQL, Kubernetes-Kapazität, CI-Validatoren — durchgängig mit denselben Garantien: kostenlos, ohne Registrierung, zu 100 % clientseitig, nichts hochgeladen oder protokolliert.',
  },
  {
    q: 'Ich möchte DevOps-Engineer werden — wo fange ich an?',
    a: 'Beginnen Sie mit OpsCanopy Learn unter /learn. Es kombiniert eine gestaffelte DevOps-Karriere-Roadmap (/learn/roadmaps/devops) mit kostenlosen, praxisnahen Guides zu Linux, Docker, Kubernetes, AWS und Netzwerken — von den Grundlagen bis zur Jobreife. Während des Lesens können Sie sofort mit den passenden Tools im Katalog üben, keine Registrierung nötig.',
  },
];

// Quietly-stated trust principles for the value strip.
/*
 * "How we know it's right" — the hero says these tools are exact; this strip is
 * the evidence, directly under the claim. Counts come from the code they
 * describe (the conformance corpus, the pinned jq build), so they cannot drift
 * out of date the way a hand-written number would. Like every technical readout
 * on the site, the values stay in English; only the prose is translated.
 */
const ghaCases = exprCorpus.length + ifCorpus.length + globCorpus.length + triggerCorpus.length;
const fidelity = [
  {
    label: 'GitHub Actions',
    title: `${ghaCases} Konformitätsfälle`,
    body: `Jeder Operator, jede Typumwandlung und jedes Glob-Muster ist an eine versionierte Suite (${GHA_SEMANTICS_VERSION}) gebunden, die bei jedem Build läuft.`,
  },
  {
    label: 'jq',
    title: `Echtes jq ${JQ_VERSION}`,
    body: 'Keine Neuimplementierung: die echte jq-Binary, kompiliert zu WebAssembly und ausgeführt in Ihrem Tab.',
  },
  {
    label: 'Alertmanager',
    title: 'Routet wie der Router',
    body: 'Verschachtelte Routen, continue, Matcher und Gruppierung werden so abgebildet, wie Alertmanager selbst sie auflöst.',
  },
  {
    label: 'IP & Hashing',
    title: 'RFC- und NIST-Vektoren',
    body: 'Exakte BigInt-Arithmetik für IPv4 und IPv6, geprüft gegen veröffentlichte Testvektoren statt nach Augenmaß.',
  },
];

// "Why a hub" value props — framed as what a returning user gets (mirrors English).
const whyCards = [
  {
    eyebrow: 'EIN ORT',
    title: 'Alles in einem Tab.',
    body: 'Setzen Sie ein Lesezeichen auf eine Website statt auf ein Dutzend. Wenn Sie einen Konverter, Validator oder Rechner brauchen, ist er schon da — gleiches Design, gleiche Abläufe, nichts neu zu lernen.',
    icon: '<path d="M3 20h18"/><path d="M6 20v-4M12 20V8M18 20v-9"/>',
  },
  {
    eyebrow: 'IMMER SCHNELL',
    title: 'Sofort, jedes Mal.',
    body: 'Jedes Tool ist statisch und clientseitig — keine Server-Warteschlangen, keine Kaltstarts. Die Seiten laden sofort, ob Sie allein zugreifen oder zehntausend andere gleichzeitig.',
    icon: '<path d="M13 3 5 13h6l-1 8 9-11h-6l1-7Z"/>',
  },
  {
    eyebrow: 'KEINE SCHRANKE',
    title: 'Nichts freizuschalten.',
    body: 'Jedes Tool, jeder Guide und jede Übungsprüfung steht allen offen — keine Bezahlschranke, keine Testphase, kein Formular. Seite öffnen und loslegen.',
    icon: '<path d="M3 11.4 11.4 3H19a2 2 0 0 1 2 2v7.6l-8.4 8.4a1.5 1.5 0 0 1-2.1 0L3 13.5a1.5 1.5 0 0 1 0-2.1Z"/><circle cx="15.8" cy="8.2" r="1.4"/>',
  },
];


// The hero's "what can I do here" row — the three things the site is for.
const doors = [
  { href: __l('/tools', __lang), title: 'Ein Tool nutzen', body: `${liveTools.length} exakte Tools: Subnetze, Cron, PromQL, GitHub Actions und mehr.` },
  { href: __nav('/mission-90', __lang), title: 'DevOps lernen', body: `Ein kostenloses 90-Tage-Programm vom Entwickler zum DevOps-Engineer (auf Englisch).` },
  { href: __nav('/tests', __lang), title: 'Für eine Zertifizierung üben', body: `${liveTests.length} AWS-Übungsprüfungen, jede Antwort erklärt (auf Englisch).` },
];

// The close: use a tool, or start learning. /tools/ stays an <a> on the page.
const closeDoors = [
  { href: __l('/tools', __lang), label: 'Tool finden — Katalog öffnen', variant: 'primary' },
  { href: __nav('/learn/roadmaps/devops', __lang), label: 'Die DevOps-Roadmap starten', variant: 'secondary' },
] as const;

// Organization + WebSite are emitted sitewide by SEO.astro with stable @ids.
const jsonLd = [faqPageLd(faqs)];
---

<Shell
  title="OpsCanopy — Kostenlose DevOps- & SRE-Tools im Browser"
  description="Kostenlose DevOps-Tools, die komplett im Browser laufen — GitHub-Actions-Ausdrücke, Alertmanager-Routen, Prometheus-Relabeling, Subnetze, Cron. Ohne Anmeldung."
  canonical="/"
  jsonLd={jsonLd}
>
  {/* ─────────────────────────── 1 · CLAIM ─────────────────────────── */}
  <section class="section-pad relative isolate overflow-hidden bg-canvas-soft">
    <MeshGradient class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[90%] opacity-90" />
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-32 bg-gradient-to-b from-canvas-soft to-transparent"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-48 bg-gradient-to-b from-transparent to-canvas-soft"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative z-10">
      <div class="flex flex-col">
        <div class="flex flex-col">
      <p class="eyebrow flex flex-wrap items-center gap-x-2 gap-y-1 text-mute">
        <span>{liveTools.length} Tools</span>
        <span aria-hidden="true" class="text-hairline">&bull;</span>
        <span>100 % clientseitig</span>
        <span aria-hidden="true" class="text-hairline">&bull;</span>
        <a
          href="https://github.com/opscanopy/opscanopy.com"
          target="_blank"
          rel="noopener noreferrer"
          class="underline decoration-hairline underline-offset-4 transition-colors hover:text-ink"
          >Open Source</a
        >
      </p>

      <h1 class="display-xl mt-4 max-w-3xl text-balance text-ink">
          Kostenlose <span class="whitespace-nowrap">DevOps-Tools</span> und praxisnahes Training, direkt im Browser.
      </h1>

      <p class="body-md mt-4 max-w-2xl text-pretty text-body">
          OpsCanopy ist der Ort, an dem Engineers Konfigurationen, Abfragen und Netzwerk-Mathematik
          prüfen — und an dem Entwickler lernen, DevOps-Engineer zu werden. Nichts, was Sie einfügen,
          verlässt Ihr Gerät, und ein Konto brauchen Sie nie.
      </p>

      <HomeDoors doors={doors} ariaLabel="Was Sie auf OpsCanopy tun können" />
        </div>

        <div class="mt-10 lg:mt-12">
          <HeroDemo />
        </div>
      </div>
    </div>
  </section>

  {/* ─────────── 2 · PROOF LEDGER — the evidence for the hero's claim ─────────── */}
  <ProofStrip principles={fidelity} ariaLabel="Woher wir wissen, dass die Antworten stimmen" heading="Exakte Antworten, keine Näherungen." />

  {/* ─────────── 2b · JUMP BACK IN (pinned/recent tools; client-revealed) ─────────── */}
  <JumpBackIn heading="Schnellzugriff" lang="de" />

  {/* ─────────── 3 · THE TOOL INDEX (numbered by registry figure) ─────────── */}
  <ToolsGrid tools={featuredTools} lang="de" openLabel={"Tool öffnen"}>
    <Fragment slot="eyebrow">Der Katalog</Fragment>
    <Fragment slot="heading">Der Tool-Index.</Fragment>
    <Fragment slot="lead">Fokussierte Werkzeuge mit einem einzigen Zweck für Plattform- und DevOps-Engineers — jedes
            davon live, exakt und nur ein Lesezeichen entfernt.</Fragment>
    <Fragment slot="seeAll">Alle Tools ansehen</Fragment>
    <Fragment slot="browseAll">Alle {liveTools.length} Tools durchstöbern</Fragment>
  </ToolsGrid>

  {/* ─────────── 4 · MISSION 90 DRILL — the guided program, on the slab ─────────── */}
  <MissionBand lang={__lang} stats={m90Stats} transcript={m90Transcript} boardLabel="Drei der zehn Missionen" weekLabel="Woche" playLabel="Spielen">
    <Fragment slot="heading">Vom Entwickler zum DevOps-Engineer in 90 Tagen.</Fragment>
    <Fragment slot="body">Ein geführter Weg — eine fokussierte Lektion pro Tag und am Ende jeder Woche eine
      story-getriebene Mission, die Sie in einem Terminal auf der Seite spielen, um ein kaputtes
      System zu reparieren. Alle 90 Tage und 10 Missionen sind jetzt live — von Tag eins an offen.</Fragment>
    <Fragment slot="cta">Tag 1 starten — kostenlos, ohne Registrierung</Fragment>
    <Fragment slot="browse">Missionen durchstöbern</Fragment>
  </MissionBand>

  {/* ─────────── 5 · LEARN DEVOPS (route homepage authority into /learn) ─────────── */}
  <section class="section-pad-lg bg-canvas-soft" aria-labelledby="learn-devops">
    <div class="container-page">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <span class="eyebrow">Learn DevOps</span>
          <h2 id="learn-devops" class="display-lg mt-3 text-balance text-ink">
            Gestaffelte Roadmaps &amp; praxisnahe Guides.
          </h2>
          <p class="body-md mt-3 text-pretty text-body">
            Kommen Sie von den Grundlagen bis zur Jobreife — mit gestaffelten Karriere-Roadmaps und
            ausführlichen, praxisnahen Guides zu Linux, Docker, Kubernetes, AWS und Netzwerken.
            Im eigenen Tempo, und Sie können die Tools direkt beim Lernen ausprobieren.
          </p>
        </div>
        <a
          href={__nav('/learn', __lang)}
          class="link-inline group body-md inline-flex shrink-0 items-center gap-1 whitespace-nowrap font-medium"
        >
          Alle Guides durchstöbern
          <span
            aria-hidden="true"
            class="transition-transform duration-150 ease-out group-hover:translate-x-0.5"
          >
            &rarr;
          </span>
        </a>
      </div>

      <div class="mt-8">
        <Button href={__nav('/learn/roadmaps/devops', __lang)} variant="primary">Mit der DevOps-Roadmap starten</Button>
      </div>

      <ul role="list" class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredTracks.map((track) => {
          const m = trackMeta(track.slug);
          return <TrackCard track={track} guideCount={m.count} difficulty={m.difficulty} minutes={m.minutes} />;
        })}
      </ul>
    </div>
  </section>

  {/* ─────────── 6 · WHY + PRIVACY (one band: #why on the section, #privacy on the slab) ─────────── */}
  <PrivacyProof points={whyCards}>
    <Fragment slot="eyebrow">Warum OpsCanopy</Fragment>
    <Fragment slot="heading">Ein Satz Garantien statt zwanzig Tabs.</Fragment>
    <Fragment slot="body">Jedes <span translate="no">OpsCanopy</span>-Tool läuft als statisches JavaScript in Ihrem
            Browser. Es gibt kein Backend, das Ihre Regeln, Konfigurationen oder Logs empfängt — keine Uploads, keine
            Telemetrie auf Ihren Eingaben, kein Konto zum Anlegen. Schließen Sie den Tab und es ist verschwunden.</Fragment>
  </PrivacyProof>

  {/* ─────────── 7 · INCIDENT LEDGER (from the blog) ─────────── */}
  <LatestPosts lang={__lang} />

  {/* ─────────── 8 · VERIFY PLATE — a claim beside the computation ─────────── */}
  <VerifyPlate calculatorHref={__l('/subnet-calculator', __lang)}>
    <Fragment slot="eyebrow">KI prüfen</Fragment>
    <Fragment slot="heading">Prüfen Sie die Antwort einer KI gegen die echte Berechnung.</Fragment>
    <Fragment slot="body">Fügen Sie die Zahlen, die ein Assistent Ihnen gegeben hat, neben seine Eingabe ein. Das Tool
      berechnet sie exakt neu, direkt auf dieser Seite, und bewertet jede Behauptung — dieselbe Prüfung,
      die die Tools für Subnetze, Cron, Zeitstempel und Base64 unter ihrem Ergebnisfeld tragen.</Fragment>
  </VerifyPlate>

  {/* ─────────────────────────── 9 · FAQ ─────────────────────────── */}
  <HomeFaq faqs={faqs} moreLabel="Weitere Fragen" />

  {/* ───────────────────────── 10 · TWO-DOOR CLOSE ───────────────────────── */}
  <TwoDoorClose doors={[closeDoors[0], closeDoors[1]]}>
    <Fragment slot="heading">Finden Sie Ihr Tool. Sparen Sie sich die Installation.</Fragment>
    <Fragment slot="body">Exakt, privat und sofort einsatzbereit. Öffnen Sie den Katalog und setzen Sie das passende Werkzeug bei Ihrem nächsten Deploy ein.</Fragment>
  </TwoDoorClose>
</Shell>
