---
/**
 * Localized chmod variant pages (chmod-Modusseiten (/de/chmod-calculator/777/ …)) — one per entry in
 * src/data/variants/chmod.i18n.ts for 'de'. Same shape as the English
 * src/pages/chmod-calculator/[octal].astro; hreflang lists only the locales
 * that really have this mode (localesFor).
 */
import Shell from '../../../components/Shell.astro';
import ChmodCalculatorPlayground from '../../../components/ChmodCalculatorPlayground.astro';
import ToolHero from '../../../components/ToolHero.astro';
import ToolLede from '../../../components/ToolLede.astro';
import FaqList from '../../../components/FaqList.astro';
import ToolCrossLinks from '../../../components/ToolCrossLinks.astro';
import { site, navLinks } from '../../../data/site';
import { faqPageLd } from '../../../lib/jsonld';
import { toolOgImage } from '../../../lib/tool-og';
import { inlineCode } from '../../../lib/inline-code';
import { variantsFor, localesFor } from '../../../data/variants/chmod.i18n';
import { variantPaths, siblings, type ToolVariant } from '../../../data/variants';
import type { Locale as __Locale } from '../../../i18n/config';
import { localizeKey as __l } from '../../../i18n/utils';

export const getStaticPaths = () => variantPaths(variantsFor('de'), 'octal');

const __lang = (Astro.currentLocale ?? 'en') as __Locale;
const { variant: v } = Astro.props as { variant: ToolVariant };
const href = __l(`/chmod-calculator/${v.slug}`, __lang);
const others = siblings(variantsFor('de'), v.slug);
---

<Shell
  title={v.title}
  description={v.description}
  canonical={`/chmod-calculator/${v.slug}`}
  availableLocales={['en', ...localesFor(v.slug)]}
  image={toolOgImage('/chmod-calculator/')}
  jsonLd={[faqPageLd(v.faqs)]}
>
  <ToolHero slug="chmod-calculator" h1Name={v.h1Name} leaf={{ name: v.h1Name, href }}>
    <Fragment slot="headline">{v.headline}</Fragment>
  </ToolHero>

  <section id="playground" class="scroll-mt-24 bg-canvas-soft pt-8 pb-20 sm:pb-24">
    <div class="container-page">
      <h2 class="sr-only">chmod-Rechner-Playground</h2>
      <ChmodCalculatorPlayground seed={v.input} />
      <ToolLede>{v.lede}</ToolLede>
    </div>
  </section>

  <section id="about" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="measure-prose space-y-10">
        {
          v.sections.map((s) => (
            <div class="space-y-4">
              <h2 class="display-sm text-balance text-ink">{s.heading}</h2>
              {s.paragraphs.map((p) => (
                <p class="body-md text-pretty text-body" set:html={inlineCode(p)} />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="related" class="scroll-mt-24 border-t border-hairline bg-canvas-soft">
    <div class="container-page py-12 sm:py-16">
      <h2 class="display-sm text-ink">Weitere gängige Modi</h2>
      <p class="body-md measure-prose mt-3 text-pretty text-body">
        Zurück zum vollständigen <a class="link-inline" href={__l('/chmod-calculator', __lang)}>chmod Calculator</a> oder einen anderen Modus öffnen:
      </p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {
          others.map((o) => (
            <li>
              <a class="chip" href={__l(`/chmod-calculator/${o.slug}`, __lang)} translate="no">
                {o.h1Name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <FaqList faqs={v.faqs} align="left" />

  <ToolCrossLinks slug="chmod-calculator" lang={__lang}>
    <Fragment slot="lead">
      Der chmod Calculator ist eines der Werkzeuge in
      <span translate="no">{site.name}</span> — einem wachsenden Schirm browserbasierter Validatoren,
      Konverter und Tester, die niemals einen Server berühren.
    </Fragment>
    <Fragment slot="links">
      Verwandte Werkzeuge: der
      <a class="link-inline" href={__l('/uuid-ulid-generator', __lang)}>UUID / ULID Generator</a>, der
      <a class="link-inline" href={__l('/case-converter', __lang)}>Case Converter</a> und das
      <a class="link-inline" href={__l('/slugify', __lang)}>Slugify</a>-Tool, oder der
      <a class="link-inline" href={__l('/cve-ignore-converter', __lang)}>CVE Ignore Converter</a> — oder
      durchstöbern Sie das vollständige
      <a class="link-inline" href={__l(navLinks[0].href, __lang)}>Werkzeugverzeichnis</a>.
    </Fragment>
    <Fragment slot="disclaimer">
      Bereitgestellt wie besehen zur bequemen Nutzung; prüfen Sie Berechtigungsänderungen auf
      Produktionssystemen stets doppelt. <span translate="no">{site.name}</span> ist kostenlos und offen.
    </Fragment>
  </ToolCrossLinks>
</Shell>
