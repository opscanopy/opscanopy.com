---
/**
 * LLM VRAM Calculator — the llm-vram-calculator tool page (SEO surface).
 * Pick a model preset or a parameter count, a GGUF quantization and a context
 * length; get the GPU memory split into weights, KV cache and runtime overhead
 * — entirely in the browser.
 */
import Shell from '../../components/Shell.astro';
import LlmVramCalculatorPlayground from '../../components/LlmVramCalculatorPlayground.astro';
import Button from '../../components/Button.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ToolHero from '../../components/ToolHero.astro';
import ToolLede from '../../components/ToolLede.astro';
import ToolGapVisual from '../../components/ToolGapVisual.astro';
import ToolPipeline from '../../components/ToolPipeline.astro';
import FaqList from '../../components/FaqList.astro';
import ToolCrossLinks from '../../components/ToolCrossLinks.astro';
import { site, navLinks } from '../../data/site';
import { getTool } from '../../data/tools';
import { softwareAppLd, faqPageLd } from '../../lib/jsonld';
import type { Locale as __Locale } from '../../i18n/config';
import { localizeKey as __l } from '../../i18n/utils';
import { toolFaqs } from '../../data/tool-faqs';

const __lang = (Astro.currentLocale ?? 'en') as __Locale;

const tool = getTool('llm-vram-calculator');
const pagePath = '/llm-vram-calculator/';
const pageUrl = `${site.url}${__l(pagePath, __lang)}`;

const faqs = toolFaqs('llm-vram-calculator', 'de');

const softwareApp = softwareAppLd({
  name: 'LLM VRAM Calculator',
  description:
    'Kostenloser LLM-VRAM-Rechner: Schätzen Sie den GPU-Speicher eines lokalen Modells aus Gewichten, KV-Cache und Laufzeit-Overhead, je Quantisierung und Kontextlänge. 100 % im Browser, ohne Anmeldung.',
  url: pageUrl,
  subCategory: 'AI',
  featureList: [
    'Modell-Presets mit der echten Layer-, KV-Head- und Head-Dim-Form aus jeder config.json',
    'GGUF-Quantisierungen von FP16 bis Q2_K mit gemessenen Bits pro Gewicht',
    'KV-Cache pro Layer und pro Token für jede Kontextlänge bis 128k',
    'Urteil gegen Karten mit 8, 12, 16, 24, 32, 48 und 80 GiB',
    '100 % clientseitig, kein Upload, keine Anmeldung',
  ],
  keywords: tool?.keywords.join(', '),
});
const faqPage = faqPageLd(faqs);

const pipeline = [
  {
    title: 'Form wählen.',
    body: 'Ein Preset liefert Layer-Anzahl, KV-Heads und Head-Dimension des Modells aus seiner config.json; eine eigene Parameterzahl übernimmt die Form des nächstgelegenen Presets und wird als geschätzt gekennzeichnet.',
  },
  {
    title: 'Gewichte wiegen.',
    body: 'Parameter × effektive Bits pro Gewicht der gewählten Quantisierung, ÷ 8, ÷ 2³⁰. Die Bits pro Gewicht stammen aus der gemessenen Tabelle von llama.cpp, nicht aus den nominellen 4 oder 8.',
  },
  {
    title: 'KV-Cache bemessen.',
    body: 'Zwei Tensoren pro Layer (K und V) × KV-Heads × Head-Dim × Kontext-Tokens × 2 Byte bei FP16 — der Teil der Rechnung, der mit Ihrem Kontextfenster wächst.',
  },
  {
    title: 'Overhead addieren, dann urteilen.',
    body: 'Feste 1,5 GiB für Laufzeit und Compute-Puffer; dann wird die Summe gegen die gängigen Kartengrößen gestellt und die kleinste passende genannt.',
  },
];

const kvWorked = `KV cache (FP16) = 2 × layers × kv_heads × head_dim × context × 2 bytes

Llama 3.1 8B at 128k context
  layers 32 · kv_heads 8 · head_dim 128 · context 131,072
  = 2 × 32 × 8 × 128 × 131,072 × 2 B
  = 17,179,869,184 B
  = 16.0 GiB            (17.2 GB — the KV cache alone outgrows a 16 GiB card)

Same model at 8k context
  = 1.0 GiB`;

const weightsWorked = `Weights = params × bits_per_weight ÷ 8 ÷ 2^30

Llama 3.1 70B, Q4_K_M (4.89 bpw measured)
  weights   70e9 × 4.89 ÷ 8 ÷ 2^30  = 39.85 GiB
  KV @ 8k   2 × 80 × 8 × 128 × 8,192 × 2 B  =  2.50 GiB
  overhead                                 =  1.50 GiB
  total                                    = 43.85 GiB   → fits a 48 GiB card, not 24 or 32

Llama 3.1 8B, Q4_K_M
  weights   8e9 × 4.89 ÷ 8 ÷ 2^30   = 4.55 GiB
  KV @ 8k                            = 1.00 GiB
  total (with overhead)              = 7.05 GiB   → fits an 8 GiB card`;
---

<Shell
  title="LLM VRAM Calculator — GPU-Speicher für lokale Modelle"
  description="Kostenloser LLM-VRAM-Rechner: Gewichte, KV-Cache und Overhead eines lokalen Modells je Quantisierung und Kontextlänge bemessen. Im Browser, ohne Anmeldung."
  canonical="/llm-vram-calculator"
  jsonLd={[softwareApp, faqPage]}
>
  <ToolHero slug="llm-vram-calculator">
    <Fragment slot="headline">Bemessen Sie die GPU, bevor Sie das Modell herunterladen.</Fragment>
  </ToolHero>

  <section id="playground" class="scroll-mt-24 bg-canvas-soft pt-8 pb-20 sm:pb-24">
    <div class="container-page">
      <h2 class="sr-only">LLM-VRAM-Calculator-Playground</h2>
      <LlmVramCalculatorPlayground />
      <ToolLede>
        Wählen Sie ein Modell-Preset wie <span translate="no">Llama 3.1 8B</span> oder geben Sie
        eine Parameterzahl ein, wählen Sie eine GGUF-Quantisierung wie
        <span class="code-mono text-ink" translate="no">Q4_K_M</span> und eine Kontextlänge, und
        erhalten Sie den VRAM, den ein lokales LLM braucht — Gewichte, KV-Cache und
        Laufzeit-Overhead in GiB, mit einem Urteil gegen gängige GPU-Größen — alles in Ihrem
        Browser berechnet, ohne Anmeldung.
      </ToolLede>
    </div>
  </section>

  <section id="why" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="grid max-w-5xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <p class="eyebrow">Die Lücke</p>
          <h2 class="display-lg mt-3 text-balance text-ink">
            Die Gewichte passen. Dann passt das Kontextfenster nicht.
          </h2>
          <ToolGapVisual />
        </div>
        <div class="space-y-4">
          <p class="body-md text-pretty text-body">
            GPU-Speicher für ein lokales LLM besteht aus drei Posten, nicht aus einem. Die <strong>Gewichte</strong>
            sind der Teil, den alle bemessen: Parameter mal Bits pro Gewicht — deshalb ist die
            4-Bit-Quantisierung eines 8B-Modells eine 4,5-GiB-Datei. Der <strong>KV-Cache</strong> ist der
            Teil, den alle vergessen — zwei Tensoren pro Layer, die linear mit der Kontextlänge wachsen,
            sodass dasselbe 8B-Modell bei 8k Tokens 1 GiB Cache will und bei 128k 16 GiB.
            Der <strong>Laufzeit-Overhead</strong> ist der Rest: Compute-Puffer, CUDA- oder Metal-Kontext
            und das Framework selbst, ein Fixposten von etwa 1,5 GiB.
          </p>
          <p class="body-md text-pretty text-body">
            Zwei Einheitensysteme verschärfen die Grenzfälle. Eine als „24 GB“ verkaufte GPU stellt
            24 GiB bereit (je 2³⁰ Byte), während Model Cards und Dateigrößen oft GB (10⁹ Byte)
            angeben — eine Lücke von 7,4 %. Dieser Rechner arbeitet durchgehend in GiB, sodass ein
            Passen gegen das beurteilt wird, was der Treiber tatsächlich meldet; die Referenz unten
            zeigt beide Werte für das Rechenbeispiel. Auf Apple Silicon teilt sich der Unified
            Memory mit dem System; rechnen Sie damit, dass etwa 75 % des RAM des Macs dem Modell zur
            Verfügung stehen.
          </p>
          <p class="body-md text-pretty text-body">
            Eine KI zu fragen, wie viel VRAM ein Modell braucht, ist die riskante Abkürzung: Ein
            Sprachmodell erinnert sich an plausible Zahlen aus Forenbeiträgen zu anderen
            Quantisierungen und Kontextlängen. Dieser Rechner berechnet den echten KV-Cache pro Layer
            aus der <span class="code-mono text-ink" translate="no">config.json</span>-Form jedes
            Modells und den gemessenen Bits pro Gewicht von llama.cpp — Zahlen, an denen Sie die
            Antwort einer KI überprüfen können, statt weiterem plausiblem Text.
          </p>
          <p class="body-sm text-mute">
            Sie rechnen zwischen GiB und GB um? Der
            <a class="link-inline" href={__l("/data-size-converter", __lang)}>Data Size Converter</a> zeigt
            die exakten Byte-Zahlen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <ToolPipeline
    id="how-it-works"
    eyebrow="Die Pipeline"
    heading="So funktioniert es."
    lead="Vier deterministische Schritte laufen bei jeder Änderung — alle innerhalb Ihres Browser-Tabs, mit Modellformen, die gegen jede config.json geprüft wurden."
    steps={pipeline}
  />

  <section id="reference" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="max-w-2xl">
        <p class="eyebrow">Formel-Referenz</p>
        <h2 class="display-lg mt-3 text-ink">Die zwei Formeln, durchgerechnet.</h2>
        <p class="body-md mt-3 max-w-xl text-pretty text-body">
          Alles, was das Panel zeigt, stammt aus diesen zwei Zeilen plus einem festen Overhead.
          Hier sind sie mit echten Modellformen, damit Sie das Ergebnis von Hand prüfen können.
        </p>
      </div>
      <div class="mt-10 grid max-w-5xl gap-8 lg:grid-cols-2">
        <div class="min-w-0">
          <h3 class="display-sm text-ink">Der KV-Cache wächst mit dem Kontext</h3>
          <p class="body-sm mt-2 mb-4 text-pretty text-body">
            Grouped-Query Attention hält den Cache klein: Llama 3.1 hat 32 Attention-Heads, aber
            nur <span class="code-mono text-ink" translate="no">8</span> KV-Heads pro Layer — und das
            ist die Zahl, die hier zählt.
          </p>
          <CodeBlock fig="40.1" lang="text" filename="kv-cache-llama-3-1-8b" code={kvWorked} />
        </div>
        <div class="min-w-0">
          <h3 class="display-sm text-ink">Gewichte nach Quantisierung</h3>
          <p class="body-sm mt-2 mb-4 text-pretty text-body">
            Ein „4-Bit“-GGUF hat nicht 4 Bits pro Gewicht: Q4_K_M liegt im Schnitt bei
            <span class="code-mono text-ink" translate="no">4,89</span>, sobald Skalen und die
            höher aufgelösten Tensoren mitgezählt werden, und Q8_0 bei 8,5.
          </p>
          <CodeBlock fig="40.2" lang="text" filename="weights-llama-3-1-70b" code={weightsWorked} />
        </div>
      </div>
    </div>
  </section>

  <section id="next" class="scroll-mt-24 bg-inverse text-inverse-fg">
    <div class="container-page py-16 sm:py-20">
      <div class="grid max-w-5xl items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <div class="min-w-0">
          <p class="eyebrow !text-cyan">Nächster Schritt</p>
          <h2 class="display-lg mt-3 text-balance text-inverse-fg">
            Das Modell läuft auf einem Cluster? Bemessen Sie auch den Pod.
          </h2>
          <p class="body-md mt-4 text-pretty text-white/70">
            Sobald die Karte gewählt ist, macht der
            <span translate="no">Kubernetes Resource Calculator</span> aus Ihrer Replica-Anzahl und
            den CPU-, Speicher- und GPU-Requests pro Pod Node-Summen und Headroom — praktisch, bevor
            Sie das Deployment schreiben, das das Modell einbindet.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <Button href={__l("/kubernetes-resource-calculator", __lang)} variant="inverse">
              Resource Calculator öffnen
            </Button>
          </div>
        </div>
        <CodeBlock
          lang="text"
          filename="fit.txt"
          code={`Llama 3.1 8B   Q4_K_M    8k   →  7.05 GiB   fits  8 GiB
Llama 3.1 8B   FP16    128k   →  32.4 GiB   fits 48 GiB
Llama 3.1 70B  Q4_K_M    8k   →  43.8 GiB   fits 48 GiB`}
        />
      </div>
    </div>
  </section>

  <FaqList faqs={faqs} align="left" />

  <ToolCrossLinks slug="llm-vram-calculator" lang={__lang}>
    <Fragment slot="lead">
      Der LLM VRAM Calculator ist eines der Tools in
      <span translate="no">{site.name}</span> — einem wachsenden Schirm browserbasierter Validatoren,
      Konverter und Tester, die niemals einen Server berühren.
    </Fragment>
    <Fragment slot="links">
      Mehr zum Bemessen: der
      <a class="link-inline" href={__l("/kubernetes-resource-calculator", __lang)}>Kubernetes Resource Calculator</a>
      und der <a class="link-inline" href={__l("/data-size-converter", __lang)}>Data Size Converter</a>, oder
      durchsuchen Sie das vollständige
      <a class="link-inline" href={__l(navLinks[0].href, __lang)}>Tool-Verzeichnis</a>.
    </Fragment>
    <Fragment slot="disclaimer">
      Nur Schätzungen; der KV-Cache wird mit FP16 bemessen und der Overhead ist eine feste Pauschale.
      Bestätigen Sie die Werte stets gegen die Meldung Ihrer eigenen Laufzeit, bevor Sie Hardware kaufen.
      <span translate="no">{site.name}</span> ist kostenlos und offen.
    </Fragment>
  </ToolCrossLinks>
</Shell>
