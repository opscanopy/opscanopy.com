---
/**
 * Localized chmod variant pages (páginas de modo chmod (/es/chmod-calculator/777/)) — one per entry in
 * src/data/variants/chmod.i18n.ts for 'es'. Same shape as the English
 * src/pages/chmod-calculator/[octal].astro; hreflang lists only the locales
 * that really have this mode (localesFor).
 */
import Shell from '../../../components/Shell.astro';
import ChmodCalculatorPlayground from '../../../components/ChmodCalculatorPlayground.astro';
import ToolHero from '../../../components/ToolHero.astro';
import ToolLede from '../../../components/ToolLede.astro';
import FaqList from '../../../components/FaqList.astro';
import ToolCrossLinks from '../../../components/ToolCrossLinks.astro';
import { site, navLinks } from '../../../data/site';
import { faqPageLd } from '../../../lib/jsonld';
import { toolOgImage } from '../../../lib/tool-og';
import { inlineCode } from '../../../lib/inline-code';
import { variantsFor } from '../../../data/variants/chmod.i18n';
import { variantPaths, type ToolVariant } from '../../../data/variants';
import type { Locale as __Locale } from '../../../i18n/config';
import { localizeKey as __l } from '../../../i18n/utils';

export const getStaticPaths = () => variantPaths(variantsFor('es'), 'octal');

const __lang = (Astro.currentLocale ?? 'en') as __Locale;
const { variant: v } = Astro.props as { variant: ToolVariant };
const href = __l(`/chmod-calculator/${v.slug}`, __lang);
---

<Shell
  title={v.title}
  description={v.description}
  canonical={`/chmod-calculator/${v.slug}`}
  noindex="follow"
  noAlternates={true}
  image={toolOgImage('/chmod-calculator/')}
  jsonLd={[faqPageLd(v.faqs)]}
>
  <ToolHero slug="chmod-calculator" h1Name={v.h1Name} leaf={{ name: v.h1Name, href }}>
    <Fragment slot="headline">{v.headline}</Fragment>
  </ToolHero>

  <section id="playground" class="scroll-mt-24 bg-canvas-soft pt-8 pb-20 sm:pb-24">
    <div class="container-page">
      <h2 class="sr-only">Playground de la calculadora chmod</h2>
      <ChmodCalculatorPlayground seed={v.input} />
      <ToolLede>{v.lede}</ToolLede>
    </div>
  </section>

  <section id="about" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="measure-prose space-y-10">
        {
          v.sections.map((s) => (
            <div class="space-y-4">
              <h2 class="display-sm text-balance text-ink">{s.heading}</h2>
              {s.paragraphs.map((p) => (
                <p class="body-md text-pretty text-body" set:html={inlineCode(p)} />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="related" class="scroll-mt-24 border-t border-hairline bg-canvas-soft">
    <div class="container-page py-12 sm:py-16">
      <h2 class="display-sm text-ink">Calcula otro modo</h2>
      <p class="body-md measure-prose mt-3 text-pretty text-body">
        Vuelve a la <a class="link-inline" href={__l('/chmod-calculator', __lang)}>chmod Calculator</a> completa para calcular cualquier otro modo.
      </p>
    </div>
  </section>

  <FaqList faqs={v.faqs} align="left" />

  <ToolCrossLinks slug="chmod-calculator" lang={__lang}>
    <Fragment slot="lead">
      La chmod Calculator es una de las herramientas de
      <span translate="no">{site.name}</span> — un dosel creciente de validadores, conversores y
      probadores basados en el navegador que nunca tocan un servidor.
    </Fragment>
    <Fragment slot="links">
      Herramientas relacionadas: el
      <a class="link-inline" href={__l('/uuid-ulid-generator', __lang)}>Generador UUID / ULID</a>, el
      <a class="link-inline" href={__l('/case-converter', __lang)}>Conversor de mayúsculas</a> y la
      herramienta <a class="link-inline" href={__l('/slugify', __lang)}>Slugify</a>, o el
      <a class="link-inline" href={__l('/cve-ignore-converter', __lang)}>Conversor de CVE Ignore</a> — o
      explora el <a class="link-inline" href={__l(navLinks[0].href, __lang)}>directorio de herramientas</a> completo.
    </Fragment>
    <Fragment slot="disclaimer">
      Se ofrece tal cual para tu comodidad; comprueba siempre dos veces los cambios de permisos en
      sistemas de producción. <span translate="no">{site.name}</span> es gratis y abierto.
    </Fragment>
  </ToolCrossLinks>
</Shell>
