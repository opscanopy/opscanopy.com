---
/**
 * OpsCanopy hub homepage — the flagship marketing surface.
 * Composes the Vercel-inspired design system defined in global.css / DESIGN.md.
 * Structural mirror of src/pages/index.astro (English) — see that file for the
 * canonical section order; keep both in sync when the layout changes.
 *
 * Section order (Batch E, 2026-10; the outline lives in the PR description):
 *   1 claim (hero + HeroDemo) → 2 proof ledger → 3 numbered tool index →
 *   4 Mission 90 drill → 5 Learn → 6 why + privacy band → 7 incident ledger →
 *   8 verify plate → 9 FAQ → 10 two-door close.
 * Surfaces alternate (soft / canvas / soft …) so no two adjacent sections share
 * a surface and their paddings never stack. Every band's markup lives in
 * src/components/home/* once; this file carries only the translated copy.
 *
 * Copy rule: "free", "no signup" and "in your browser" (in this locale's
 * words) appear once above the fold (H1 + lede) and nowhere else outside the
 * FAQ and <title>/meta. Two exceptions are deliberate: the HomeDoors texts and
 * the Mission CTA are watched anchors (the SEO guard fails closed on any
 * change), and the privacy paragraph in the why band is kept verbatim.
 */
import Shell from '../../components/Shell.astro';
import HeroDemo from '../../components/home/HeroDemo.astro';
import PrivacyProof from '../../components/home/PrivacyProof.astro';
import ProofStrip from '../../components/home/ProofStrip.astro';
import ToolsGrid from '../../components/home/ToolsGrid.astro';
import HomeDoors from '../../components/home/HomeDoors.astro';
import MissionBand from '../../components/home/MissionBand.astro';
import VerifyPlate from '../../components/home/VerifyPlate.astro';
import HomeFaq from '../../components/home/HomeFaq.astro';
import TwoDoorClose from '../../components/home/TwoDoorClose.astro';
import Button from '../../components/Button.astro';
import LatestPosts from '../../components/home/LatestPosts.astro';
import JumpBackIn from '../../components/JumpBackIn.astro';
import TrackCard from '../../components/learn/TrackCard.astro';
import { liveTools, getTool } from '../../data/tools';
import { tracks } from '../../data/learn';
import { liveTests } from '../../data/tests';
import { program, phases as m90Phases, missions as m90Missions, totalCoreMinutes } from '../../data/mission90';
import { getGuidesForLocale, estimateReadingTime } from '../../lib/learn/guides';
import { faqPageLd } from '../../lib/jsonld';
import {
  GHA_SEMANTICS_VERSION,
  exprCorpus,
  ifCorpus,
  globCorpus,
  triggerCorpus,
} from '../../lib/github-actions-expression-tester/conformance';
import { JQ_VERSION } from '../../data/versions';
import type { Locale as __Locale } from '../../i18n/config';
import { localizeKey as __l, localizeNavHref as __nav } from '../../i18n/utils';

const __lang = (Astro.currentLocale ?? 'en') as __Locale;


// Featured catalog grid — a CURATED set of 9 representative tools, mirrors English.
const featuredSlugs = [
  // Leads with the five tools that have no competing browser tool at all; the last
  // four stay recognizable for a first-time visitor. See src/pages/index.astro.
  'github-actions-expression-tester',
  'alertmanager-route-tester',
  'prometheus-relabel-tester',
  'loki-alert-rule-tester',
  'jq-playground',
  'certificate-decoder',
  'subnet-calculator',
  'jwt-decoder',
  'cron-expression-tester',
];
const featuredTools = featuredSlugs
  .map((slug) => getTool(slug))
  .filter((t): t is NonNullable<typeof t> => Boolean(t) && t!.status === 'live');

// Learn band — /learn is English-only content (ENGLISH_ONLY_SECTIONS), so the
// guides themselves are fetched in English regardless of page locale.
const learnGuides = await getGuidesForLocale('en');
const learnByTrack = (slug: string) =>
  learnGuides.filter((g) => g.entry.data.track === slug).sort((x, y) => x.entry.data.order - y.entry.data.order);
const trackMeta = (slug: string) => {
  const gs = learnByTrack(slug);
  return {
    count: gs.length,
    minutes: gs.reduce((s, g) => s + (g.entry.data.estMinutes ?? estimateReadingTime(g.entry.body)), 0),
    difficulty: gs[0]?.entry.data.difficulty ?? 'beginner',
  };
};
const featuredTracks = tracks.filter((t) => ['linux', 'docker', 'kubernetes'].includes(t.slug));

// Mission-90 homepage feature band — figures derived from the registry, mirrors
// English. Mission-90 is also English-only content, so the transcript stays English.
const m90LiveMissions = m90Missions.filter((m) => m.status === 'live').length;
const m90Hours = Math.round(totalCoreMinutes / 60 / 10) * 10;
const m90Stats = [
  { n: String(program.totalDays), l: 'días' },
  { n: String(m90Phases.length), l: 'fases' },
  { n: String(m90LiveMissions), l: 'misiones en el navegador' },
  { n: `~${m90Hours}`, l: 'horas de contenido' },
];
const m90Transcript = `student@prod-web-01:~$ ps aux --sort=-%cpu | head -3
USER   PID   %CPU  COMMAND
root   4521  94.0  /opt/scripts/nightly-backup.sh
student@prod-web-01:~$ kill 4521
student@prod-web-01:~$ systemctl restart nginx
student@prod-web-01:~$ curl -sI localhost | head -1
HTTP/1.1 200 OK
# 02:07 — the site is back. You did that.`;

const faqs = [
  {
    q: '¿Las herramientas de OpsCanopy son realmente gratuitas?',
    a: 'Sí. Cada herramienta es completamente gratuita, sin muros de pago, límites de uso ni planes premium. No hay ningún requisito de cuenta de ningún tipo: abre una herramienta en tu navegador y empieza a usarla de inmediato.',
  },
  {
    q: '¿Necesito registrarme para usar estas herramientas DevOps en línea?',
    a: 'No. No hay registro, inicio de sesión ni captura de correo. Abre cualquier herramienta en una pestaña de tu navegador y úsala de inmediato: sin cuenta, sin banner de cookies, sin fricción. La analítica funciona sin cookies por defecto en la UE, el Reino Unido y Suiza, y con una única cookie propia en el resto del mundo; en ambos casos puedes cambiarlo en la página de privacidad.',
  },
  {
    q: '¿Mis datos se suben a un servidor cuando uso las herramientas?',
    a: 'No. Cada herramienta se ejecuta 100% del lado del cliente en la pestaña de tu navegador; nada de lo que pegas se registra, almacena ni sube. Tus datos nunca salen del navegador.',
  },
  {
    q: '¿Es seguro pegar un JWT o una configuración en una herramienta basada en navegador?',
    a: 'En OpsCanopy, sí. La decodificación y el análisis ocurren por completo en JavaScript local: nada de lo que pegas se transmite jamás, algo que puedes verificar tú mismo en la pestaña de red del navegador (el único tráfico saliente es una analítica de páginas agregada, descrita en nuestra política de privacidad). Como higiene general, nunca compartas secretos de firma con terceros, pero OpsCanopy no sube nada de lo que introduces.',
  },
  {
    q: '¿Las herramientas funcionan sin conexión?',
    a: 'Una vez que la página de una herramienta se ha cargado, sigue funcionando aunque te desconectes de internet, porque todo el procesamiento es local y no hay backend al que llamar. Desconectarte también es una forma fácil de verificar tú mismo la afirmación de privacidad del lado del cliente.',
  },
  {
    q: '¿Para quién son estas herramientas DevOps basadas en navegador?',
    a: 'Ingenieros DevOps, SRE, administradores de sistemas, ingenieros de plataforma y backend: cualquiera que necesite cálculos rápidos de subredes y CIDR, programaciones de cron, consultas PromQL o LogQL, utilidades de JWT, Base64 y hash, conversión de marcas de tiempo, validación de GitHub Actions o dimensionamiento de recursos de Kubernetes sin instalar nada.',
  },
  {
    q: '¿Por qué usar estas herramientas en lugar de preguntar a ChatGPT o Claude?',
    a: 'Usa ambos — para tareas distintas. Un asistente de IA es excelente explicando conceptos y redactando configuraciones, pero genera texto plausible en lugar de calcular respuestas, y la aritmética exacta es un punto débil documentado: los límites de subred, las programaciones de cron, las conversiones de época Unix y el comportamiento de las regex vuelven de forma habitual pareciendo correctos cuando en realidad están mal. Las herramientas de OpsCanopy calculan las respuestas de forma determinista — analizadores reales, matemática exacta — y recalculan al instante mientras ajustas la entrada, sin nuevos prompts, sin coste en tokens y sin límites de uso; una vez cargada la página de una herramienta, sigue funcionando sin conexión. Nada de lo que pegas se transmite jamás, así que los logs, tokens y configuraciones se quedan en tu máquina. Varias herramientas sirven incluso como prácticos verificadores de la IA: pasa por ellas la misma subred, expresión de cron o marca de tiempo y obtienes la verdad de referencia con la que comparar.',
  },
  {
    q: '¿En qué se diferencia OpsCanopy de otras colecciones de herramientas para desarrolladores en línea?',
    a: 'La mayoría de las colecciones de herramientas se centran en formateadores genéricos. OpsCanopy se especializa en flujos de trabajo DevOps y SRE: planificación de CIDR, cron, PromQL y LogQL, capacidad de Kubernetes, validadores de CI, con las mismas garantías en todo momento: gratis, sin registro, 100% del lado del cliente, sin subir ni registrar nada.',
  },
  {
    q: 'Quiero convertirme en ingeniero DevOps — ¿por dónde empiezo?',
    a: 'Empieza con OpsCanopy Learn en /learn. Combina una hoja de ruta profesional de DevOps por etapas (/learn/roadmaps/devops) con guías gratuitas y prácticas sobre Linux, Docker, Kubernetes, AWS y redes — yendo de los fundamentos a estar listo para el trabajo. Mientras lees, puedes practicar de inmediato con las herramientas correspondientes del catálogo, sin necesidad de registro.',
  },
];

// Quietly-stated trust principles for the value strip.
/*
 * "How we know it's right" — the hero says these tools are exact; this strip is
 * the evidence, directly under the claim. Counts come from the code they
 * describe (the conformance corpus, the pinned jq build), so they cannot drift
 * out of date the way a hand-written number would. Like every technical readout
 * on the site, the values stay in English; only the prose is translated.
 */
const ghaCases = exprCorpus.length + ifCorpus.length + globCorpus.length + triggerCorpus.length;
const fidelity = [
  {
    label: 'GitHub Actions',
    title: `${ghaCases} casos de conformidad`,
    body: `Cada operador, conversión y glob está anclado a un corpus versionado (${GHA_SEMANTICS_VERSION}) que se ejecuta en cada build.`,
  },
  {
    label: 'jq',
    title: `jq ${JQ_VERSION} real`,
    body: 'No es una reimplementación: el binario real de jq compilado a WebAssembly, corriendo en tu pestaña.',
  },
  {
    label: 'Alertmanager',
    title: 'Enruta como el router',
    body: 'Rutas anidadas, continue, matchers y agrupación se modelan igual que los resuelve el propio Alertmanager.',
  },
  {
    label: 'IP y hashing',
    title: 'Vectores RFC y NIST',
    body: 'Aritmética BigInt exacta para IPv4 e IPv6, comprobada contra vectores de prueba publicados.',
  },
];

// "Why a hub" value props, mirrors English.
const whyCards = [
  {
    eyebrow: 'UN SOLO LUGAR',
    title: 'Todo en una pestaña.',
    body: 'Guarda un solo marcador en lugar de una docena. Cuando necesites un conversor, un validador o una calculadora, ya está aquí: misma apariencia, mismos atajos, nada nuevo que aprender.',
    icon: '<path d="M3 20h18"/><path d="M6 20v-4M12 20V8M18 20v-9"/>',
  },
  {
    eyebrow: 'SIEMPRE RÁPIDO',
    title: 'Instantáneo, siempre.',
    body: 'Cada herramienta es estática y se ejecuta en el cliente, así que no hay colas de servidor ni arranques en frío que esperar: las páginas cargan al instante, tanto si entras tú como diez mil personas a la vez.',
    icon: '<path d="M13 3 5 13h6l-1 8 9-11h-6l1-7Z"/>',
  },
  {
    eyebrow: 'SIN BARRERAS',
    title: 'Nada que desbloquear.',
    body: 'Cada herramienta, guía y examen de práctica está abierto a cualquiera — sin muro de pago, sin prueba, sin formulario. Abre la página y empieza a trabajar.',
    icon: '<path d="M3 11.4 11.4 3H19a2 2 0 0 1 2 2v7.6l-8.4 8.4a1.5 1.5 0 0 1-2.1 0L3 13.5a1.5 1.5 0 0 1 0-2.1Z"/><circle cx="15.8" cy="8.2" r="1.4"/>',
  },
];


// The hero's "what can I do here" row — the three things the site is for.
const doors = [
  { href: __l('/tools', __lang), title: 'Usar una herramienta', body: `${liveTools.length} herramientas exactas: subredes, cron, PromQL, GitHub Actions y más.` },
  { href: __nav('/mission-90', __lang), title: 'Aprender DevOps', body: `Un programa gratuito de 90 días, de desarrollador a ingeniero DevOps (en inglés).` },
  { href: __nav('/tests', __lang), title: 'Prepararte para una certificación', body: `${liveTests.length} exámenes de práctica de AWS, con cada respuesta explicada (en inglés).` },
];

// The close: use a tool, or start learning. /tools/ stays an <a> on the page.
const closeDoors = [
  { href: __l('/tools', __lang), label: 'Encontrar herramienta — abrir el catálogo', variant: 'primary' },
  { href: __nav('/learn/roadmaps/devops', __lang), label: 'Iniciar la hoja de ruta de DevOps', variant: 'secondary' },
] as const;

// Organization + WebSite are emitted sitewide by SEO.astro with stable @ids.
const jsonLd = [faqPageLd(faqs)];
---

<Shell
  title="OpsCanopy — Herramientas DevOps y SRE gratis en el navegador"
  description="Herramientas DevOps gratuitas que se ejecutan en tu navegador: expresiones de GitHub Actions, rutas de Alertmanager, relabeling, subredes y cron. Sin registro."
  canonical="/"
  jsonLd={jsonLd}
>
  {/* ─────────────────────────── 1 · CLAIM ─────────────────────────── */}
  <section class="section-pad relative isolate overflow-hidden bg-canvas-soft">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-32 bg-gradient-to-b from-canvas-soft to-transparent"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-48 bg-gradient-to-b from-transparent to-canvas-soft"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative z-10">
      <div class="flex flex-col">
        <div class="flex flex-col">
      <p class="eyebrow flex flex-wrap items-center gap-x-2 gap-y-1 text-mute">
        <span>{liveTools.length} herramientas</span>
        <span aria-hidden="true" class="text-hairline">&bull;</span>
        <span>100% del lado del cliente</span>
        <span aria-hidden="true" class="text-hairline">&bull;</span>
        <a
          href="https://github.com/opscanopy/opscanopy.com"
          target="_blank"
          rel="noopener noreferrer"
          class="underline decoration-hairline underline-offset-4 transition-colors hover:text-ink"
          >Código abierto</a
        >
      </p>

      <h1 class="display-xl mt-4 max-w-3xl text-balance text-ink">
          Herramientas DevOps gratis y formación práctica, directamente en tu navegador.
      </h1>

      <p class="body-md mt-4 max-w-2xl text-pretty text-body">
          OpsCanopy es donde los ingenieros comprueban configuraciones, consultas y cálculos de red —
          y donde los desarrolladores aprenden a convertirse en ingenieros DevOps. Nada de lo que
          pegues sale de tu dispositivo, y nunca hace falta una cuenta.
      </p>

      <HomeDoors doors={doors} ariaLabel="Qué puedes hacer en OpsCanopy" />
        </div>

        <div class="mt-10 lg:mt-12">
          <HeroDemo />
        </div>
      </div>
    </div>
  </section>

  {/* ─────────── 2 · PROOF LEDGER — the evidence for the hero's claim ─────────── */}
  <ProofStrip principles={fidelity} ariaLabel="Cómo sabemos que las respuestas son correctas" heading="Respuestas exactas, no aproximaciones." />

  {/* ─────────── 2b · JUMP BACK IN (pinned/recent tools; client-revealed) ─────────── */}
  <JumpBackIn heading="Continúa donde lo dejaste" lang="es" />

  {/* ─────────── 3 · THE TOOL INDEX (numbered by registry figure) ─────────── */}
  <ToolsGrid tools={featuredTools} lang="es" openLabel={"Abrir herramienta"}>
    <Fragment slot="eyebrow">El catálogo</Fragment>
    <Fragment slot="heading">El índice de herramientas.</Fragment>
    <Fragment slot="lead">Utilidades enfocadas y de propósito único para ingenieros de plataforma y DevOps: cada una
            en vivo, exacta y a un solo marcador de distancia.</Fragment>
    <Fragment slot="seeAll">Ver todas las herramientas</Fragment>
    <Fragment slot="browseAll">Explorar las {liveTools.length} herramientas</Fragment>
  </ToolsGrid>

  {/* ─────────── 4 · MISSION 90 DRILL — the guided program, on the slab ─────────── */}
  <MissionBand lang={__lang} stats={m90Stats} transcript={m90Transcript} boardLabel="Tres de las diez misiones" weekLabel="Semana" playLabel="Jugar">
    <Fragment slot="heading">De desarrollador a ingeniero DevOps en 90 días.</Fragment>
    <Fragment slot="body">Un camino guiado: una lección enfocada al día, y al final de cada semana una misión
      narrativa que juegas en una terminal dentro de la página para arreglar un sistema roto. Los 90
      días y las 10 misiones ya están disponibles — abiertos desde el primer día.</Fragment>
    <Fragment slot="cta">Empezar el día 1 — gratis, sin registro</Fragment>
    <Fragment slot="browse">Explorar las misiones</Fragment>
  </MissionBand>

  {/* ─────────── 5 · LEARN DEVOPS (route homepage authority into /learn) ─────────── */}
  <section class="section-pad-lg bg-canvas-soft" aria-labelledby="learn-devops">
    <div class="container-page">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <span class="eyebrow">Learn DevOps</span>
          <h2 id="learn-devops" class="display-lg mt-3 text-balance text-ink">
            Hojas de ruta por etapas y guías prácticas.
          </h2>
          <p class="body-md mt-3 text-pretty text-body">
            Ve de los fundamentos a estar listo para el trabajo con hojas de ruta profesionales por
            etapas y guías extensas y prácticas — Linux, Docker, Kubernetes, AWS y redes. A tu ritmo, y puedes practicar con las herramientas mientras avanzas.
          </p>
        </div>
        <a
          href={__nav('/learn', __lang)}
          class="link-inline group body-md inline-flex shrink-0 items-center gap-1 whitespace-nowrap font-medium"
        >
          Ver todas las guías
          <span
            aria-hidden="true"
            class="transition-transform duration-150 ease-out group-hover:translate-x-0.5"
          >
            &rarr;
          </span>
        </a>
      </div>

      <div class="mt-8">
        <Button href={__nav('/learn/roadmaps/devops', __lang)} variant="primary">Empezar con la hoja de ruta de DevOps</Button>
      </div>

      <ul role="list" class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredTracks.map((track) => {
          const m = trackMeta(track.slug);
          return <TrackCard track={track} guideCount={m.count} difficulty={m.difficulty} minutes={m.minutes} />;
        })}
      </ul>
    </div>
  </section>

  {/* ─────────── 6 · WHY + PRIVACY (one band: #why on the section, #privacy on the slab) ─────────── */}
  <PrivacyProof points={whyCards}>
    <Fragment slot="eyebrow">Por qué OpsCanopy</Fragment>
    <Fragment slot="heading">Un solo conjunto de garantías, no veinte pestañas.</Fragment>
    <Fragment slot="body">Cada herramienta de <span translate="no">OpsCanopy</span> se ejecuta como JavaScript estático en tu
            navegador. No hay backend que reciba tus reglas, configuraciones o registros: sin subidas, sin
            telemetría sobre tus entradas, sin cuenta que crear. Cierra la pestaña y desaparece.</Fragment>
  </PrivacyProof>

  {/* ─────────── 7 · INCIDENT LEDGER (from the blog) ─────────── */}
  <LatestPosts lang={__lang} />

  {/* ─────────── 8 · VERIFY PLATE — a claim beside the computation ─────────── */}
  <VerifyPlate calculatorHref={__l('/subnet-calculator', __lang)}>
    <Fragment slot="eyebrow">Verificar la IA</Fragment>
    <Fragment slot="heading">Comprueba la respuesta de una IA contra el cálculo real.</Fragment>
    <Fragment slot="body">Pega los números que te dio un asistente junto a la entrada que recibió. La herramienta los
      recalcula con exactitud, en esta misma página, y marca cada afirmación — la misma comprobación
      que llevan las herramientas de subredes, cron, marcas de tiempo y Base64 bajo su panel de resultados.</Fragment>
  </VerifyPlate>

  {/* ─────────────────────────── 9 · FAQ ─────────────────────────── */}
  <HomeFaq faqs={faqs} moreLabel="Más preguntas" />

  {/* ───────────────────────── 10 · TWO-DOOR CLOSE ───────────────────────── */}
  <TwoDoorClose doors={[closeDoors[0], closeDoors[1]]}>
    <Fragment slot="heading">Encuentra tu herramienta. Sáltate la instalación.</Fragment>
    <Fragment slot="body">Exacta, privada e instantánea. Abre el catálogo y pon la herramienta adecuada a trabajar en tu próximo despliegue.</Fragment>
  </TwoDoorClose>
</Shell>
