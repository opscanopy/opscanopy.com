---
/**
 * Kubernetes Resource Calculator — the kubernetes-resource-calculator tool page
 * (SEO surface). Enter CPU (millicores) and memory (Mi/Gi) requests & limits,
 * normalize them to canonical units and total them across replicas — entirely
 * in the browser.
 */
import Shell from '../../components/Shell.astro';
import K8sResourceCalculatorPlayground from '../../components/K8sResourceCalculatorPlayground.astro';
import Button from '../../components/Button.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ToolHero from '../../components/ToolHero.astro';
import ToolGapVisual from '../../components/ToolGapVisual.astro';
import ToolPipeline from '../../components/ToolPipeline.astro';
import FaqList from '../../components/FaqList.astro';
import ToolCrossLinks from '../../components/ToolCrossLinks.astro';
import { site, navLinks } from '../../data/site';
import { getTool } from '../../data/tools';
import { softwareAppLd, faqPageLd } from '../../lib/jsonld';

const tool = getTool('kubernetes-resource-calculator');
const pagePath = '/kubernetes-resource-calculator/';
const pageUrl = `${site.url}${__l(pagePath, (Astro.currentLocale ?? 'en') as __Locale)}`;

const faqs = toolFaqs('kubernetes-resource-calculator', 'es');

const softwareApp = softwareAppLd({
  name: 'Kubernetes Resource Calculator',
  description:
    'Calculadora de recursos de Kubernetes gratuita y en el navegador. Totaliza las requests y los limits de CPU y memoria a través de pods y réplicas, y convierte milicores y Mi/Gi. Sin registro.',
  url: pageUrl,
  subCategory: 'Kubernetes',
  featureList: [
    'Parsea cantidades de CPU y memoria con sufijos binarios y decimales',
    'Normaliza la CPU a milicores y la memoria a bytes',
    'Totaliza las requests y los limits a través de las réplicas',
    'Marca cualquier limit que quede por debajo de su request',
    '100% en el lado del cliente, sin subida, sin registro',
  ],
  keywords: tool?.keywords.join(', '),
});
const faqPage = faqPageLd(faqs);

const pipeline = [
  {
    title: 'Parsea las cantidades.',
    body: 'Cada request y limit se lee como una cantidad de Kubernetes — un número más un sufijo de unidad opcional como m, Mi o Gi.',
  },
  {
    title: 'Normaliza las unidades.',
    body: 'La CPU se convierte a milicores enteros y la memoria a bytes exactos, de modo que los valores binarios (Mi/Gi) y decimales (M/G) se comparan correctamente.',
  },
  {
    title: 'Multiplica por las réplicas.',
    body: 'Las requests y los limits por contenedor se multiplican por el número de réplicas para dar el total de CPU y memoria que la carga de trabajo reserva y acota.',
  },
  {
    title: 'Marca los conflictos.',
    body: 'Se marca cualquier fila cuyo limit normalizado sea menor que su request, ya que Kubernetes rechaza un limit por debajo de la request garantizada.',
  },
];

const suffixTable = `cpu suffix     meaning              example       millicores
(none)         whole cores          2             2000m
m              millicores           250m          250m
0.x            fractional cores     0.5           500m

memory suffix  meaning              example       bytes
Ki             1024^1  (binary)     512Ki         524,288
Mi             1024^2  (binary)     256Mi         268,435,456
Gi             1024^3  (binary)     2Gi           2,147,483,648
k              1000^1  (decimal)    512k          512,000
M              1000^2  (decimal)    256M          256,000,000
G              1000^3  (decimal)    2G            2,000,000,000

note  Mi/Gi are 1024^n (mebi/gibi); M/G are 1000^n (mega/giga).
      1 Gi = 1,073,741,824 bytes  ≈  1.074 GB`;

const totalsExample = `container  requests          limits            replicas
api        cpu 250m mem 256Mi  cpu 500m mem 512Mi   3

totals
  cpu     requests 750m       limits 1500m  (1.5 cores)
  memory  requests 768Mi      limits 1536Mi (1.5 Gi)`;
import type { Locale as __Locale } from '../../i18n/config';
import { localizeKey as __l } from '../../i18n/utils';
import { toolFaqs } from '../../data/tool-faqs';
const __lang = (Astro.currentLocale ?? 'en') as __Locale;

---

<Shell
  title="Kubernetes Resource Calculator — Requests de CPU y memoria"
  description="Calculadora de recursos de Kubernetes gratuita y en el navegador. Totaliza las requests y los limits de CPU y memoria por pods y réplicas, y convierte Mi/Gi."
  canonical="/kubernetes-resource-calculator"
  jsonLd={[softwareApp, faqPage]}
>
  <ToolHero
    eyebrow="Kubernetes Resource Calculator · Kubernetes"
    badges={[
      { label: 'CPU y memoria', variant: 'neutral' },
      { label: 'Sin registro', variant: 'neutral' },
    ]}
  >
    <Fragment slot="headline">Totaliza la CPU y la memoria de Kubernetes de un vistazo.</Fragment>
    <Fragment slot="lead">
      Convierte requests y limits de CPU en milicores como
      <span class="code-mono text-ink" translate="no">250m</span> y memoria en
      <span class="code-mono text-ink" translate="no">Mi</span> /
      <span class="code-mono text-ink" translate="no">Gi</span> en valores normalizados y totales
      a través de las réplicas — gratis, en línea, sin necesidad de registro.
    </Fragment>
  </ToolHero>

  <section id="playground" class="scroll-mt-24 bg-canvas-soft pt-8 pb-20 sm:pb-24">
    <div class="container-page">
      <h2 class="sr-only">Playground de la Kubernetes Resource Calculator</h2>
      <K8sResourceCalculatorPlayground />
    </div>
  </section>

  <section id="why" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <p class="eyebrow">El problema</p>
          <h2 class="display-lg mt-3 text-balance text-ink">
            Un sufijo equivocado, un node pool fuera de presupuesto.
          </h2>
          <ToolGapVisual />
        </div>
        <div class="space-y-4">
          <p class="body-md text-pretty text-body">
            Las cantidades de recursos de Kubernetes mezclan dos sistemas numéricos — núcleos
            fraccionarios medidos en milicores, y memoria medida en mebibytes binarios que parecen
            casi megabytes decimales. Multiplica de cabeza una request por contenedor por un número
            de réplicas y el modo de fallo es silencioso: un node pool dimensionado demasiado
            pequeño, un Pod que nunca se programa, o un limit fijado accidentalmente por debajo de
            su request que el API server rechaza.
          </p>
          <p class="body-md text-pretty text-body">
            Esta calculadora de recursos de Kubernetes gratuita convierte esas cantidades en los
            datos concretos que realmente necesitas — CPU normalizada en milicores, memoria en bytes
            exactos, y el total de CPU y memoria a través de pods y réplicas que una carga de trabajo
            reserva y acota — para que puedas confirmar los números antes de que lleguen a un
            manifiesto. Enteramente en el navegador, sin nada que instalar y sin que ningún dato
            salga jamás de tu dispositivo.
          </p>
          <p class="body-sm text-mute">
            ¿Codificas los valores en un Secret a continuación? Recurre al
            <a class="link-inline" href={__l("/base64-encoder-decoder", __lang)}>Base64 Encoder / Decoder</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <ToolPipeline
    id="how-it-works"
    eyebrow="El proceso"
    heading="Cómo funciona."
    lead="Cuatro pasos deterministas se ejecutan con cada pulsación de tecla — todo dentro de la pestaña de tu navegador, con aritmética entera exacta."
    steps={pipeline}
  />

  <section id="reference" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Referencia de unidades</p>
        <h2 class="display-lg mt-3 text-ink">Qué significa cada sufijo.</h2>
        <p class="body-md mx-auto mt-3 max-w-xl text-pretty text-body">
          La CPU de Kubernetes usa milicores; la memoria usa dos familias de sufijo — la binaria
          <span class="code-mono text-ink" translate="no">Ki/Mi/Gi</span> y la decimal
          <span class="code-mono text-ink" translate="no">k/M/G</span> — que son cercanas pero nunca
          iguales.
        </p>
      </div>
      <div class="mx-auto mt-10 grid max-w-5xl gap-8 lg:grid-cols-2">
        <div class="min-w-0">
          <h3 class="display-sm text-ink">Sufijos de CPU y memoria</h3>
          <p class="body-sm mt-2 mb-4 text-pretty text-body">
            La CPU se normaliza a milicores (<span class="code-mono text-ink" translate="no">1000m</span>
            = un núcleo); la memoria se normaliza a bytes, donde
            <span class="code-mono text-ink" translate="no">Mi/Gi</span> son
            <span class="code-mono text-ink" translate="no">1024^n</span> y
            <span class="code-mono text-ink" translate="no">M/G</span> son
            <span class="code-mono text-ink" translate="no">1000^n</span>.
          </p>
          <CodeBlock lang="text" filename="resource-suffixes" code={suffixTable} />
        </div>
        <div class="min-w-0">
          <h3 class="display-sm text-ink">Totales a través de las réplicas</h3>
          <p class="body-sm mt-2 mb-4 text-pretty text-body">
            Cada request y limit por contenedor se multiplica por el número de réplicas, de modo que
            puedes dimensionar un node pool según las requests y vigilar el techo según los limits.
          </p>
          <CodeBlock lang="text" filename="totals" code={totalsExample} />
        </div>
      </div>
    </div>
  </section>

  <section id="next" class="scroll-mt-24 bg-inverse text-inverse-fg">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto grid max-w-5xl items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <div class="min-w-0">
          <p class="eyebrow !text-cyan">Siguiente paso</p>
          <h2 class="display-lg mt-3 text-balance text-inverse-fg">
            ¿Ya lo dimensionaste? Codifica los valores en un Secret.
          </h2>
          <p class="body-md mt-4 text-pretty text-white/70">
            Una vez que las requests y los limits se leen correctamente, la configuración que las
            acompaña — tokens, cadenas de conexión, certificados — suele ir a un
            <span translate="no">Kubernetes Secret</span>, cuyos valores en
            <span class="code-mono" translate="no">data</span> deben estar codificados en Base64. El
            <span translate="no">Base64 Encoder / Decoder</span> se encarga de eso en el navegador, o
            explora el directorio completo de herramientas para el resto del kit.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <Button href={__l("/base64-encoder-decoder", __lang)} variant="secondary">Abrir la herramienta Base64</Button>
            <a class="link-inline !text-white/80" href={__l(navLinks[0].href, __lang)}>Explorar todas las herramientas</a>
          </div>
        </div>
        <CodeBlock
          lang="yaml"
          filename="secret.yaml"
          code={`apiVersion: v1
kind: Secret
metadata:
  name: api
type: Opaque
data:
  # values are base64-encoded
  token: c3VwZXItc2VjcmV0`}
        />
      </div>
    </div>
  </section>

  <FaqList faqs={faqs} />

  <ToolCrossLinks lang={__lang}>
    <Fragment slot="lead">
      La Kubernetes Resource Calculator es una herramienta más en
      <span translate="no">{site.name}</span> — una creciente cubierta de validadores, conversores
      y testers basados en el navegador que nunca tocan un servidor.
    </Fragment>
    <Fragment slot="links">
      Relacionados: el
      <a class="link-inline" href={__l("/base64-encoder-decoder", __lang)}>Base64 Encoder / Decoder</a> y la
      <a class="link-inline" href={__l("/subnet-calculator", __lang)}>Subnet Calculator</a>, o explora el
      <a class="link-inline" href={__l(navLinks[0].href, __lang)}>directorio de herramientas</a> completo.
    </Fragment>
    <Fragment slot="disclaimer">
      Se ofrece tal cual por comodidad; confirma siempre los cambios críticos de capacidad con tu
      propia autoridad. <span translate="no">{site.name}</span> es gratuito y abierto.
    </Fragment>
  </ToolCrossLinks>
</Shell>
