---
/**
 * LogQL ↔ PromQL Helper — the tool page (primary SEO surface).
 * Convert common metric-query shapes between Grafana Loki LogQL and Prometheus
 * PromQL, with honest notes on what does and does not map — entirely in the
 * browser. No server, no signup.
 *
 * Imports the interactive island (LogqlPromqlPlayground, self-mounting) plus the
 * brand primitives. JSON-LD (SoftwareApplication + FAQPage) is assembled in
 * frontmatter and handed to Shell via the `jsonLd` prop.
 */
import Shell from '../../components/Shell.astro';
import LogqlPromqlPlayground from '../../components/LogqlPromqlPlayground.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ToolHero from '../../components/ToolHero.astro';
import ToolGapVisual from '../../components/ToolGapVisual.astro';
import ToolPipeline from '../../components/ToolPipeline.astro';
import FaqList from '../../components/FaqList.astro';
import ToolCrossLinks from '../../components/ToolCrossLinks.astro';
import { site, navLinks } from '../../data/site';
import { getTool } from '../../data/tools';
import { softwareAppLd, faqPageLd } from '../../lib/jsonld';

const tool = getTool('logql-promql-helper');

const pagePath = '/logql-promql-helper/';
const pageUrl = `${site.url}${__l(pagePath, (Astro.currentLocale ?? 'en') as __Locale)}`;

// ── FAQ content — single source for both the rendered section and FAQPage LD ─
const faqs = toolFaqs('logql-promql-helper', 'es');

// ── JSON-LD: SoftwareApplication ─────────────────────────────────────────────
const softwareApp = softwareAppLd({
  name: 'LogQL to PromQL Helper',
  description:
    'LogQL vs PromQL: los mismos matchers y agregaciones, modelos de datos distintos. Mira qué se traduce y qué no, y convierte consultas en tu navegador.',
  url: pageUrl,
  subCategory: 'Observability',
  featureList: [
    'Traduce consultas de métricas entre LogQL y PromQL, en ambos sentidos',
    'Convierte selectores, funciones de rango, agregaciones y umbrales',
    'Marca las construcciones de LogQL solo para logs que no tienen equivalente en PromQL',
    '100 % del lado del cliente, sin subidas, sin registro',
  ],
  keywords: tool?.keywords.join(', '),
});

// ── JSON-LD: FAQPage (mirrors the rendered FAQ) ──────────────────────────────
const faqPage = faqPageLd(faqs);

// ── HOW IT WORKS pipeline ────────────────────────────────────────────────────
const pipeline = [
  {
    title: 'Analiza la consulta.',
    body: 'Tu consulta de origen se descompone en sus partes estructurales —selectores, funciones de rango, agregaciones y comparaciones— en el lenguaje que hayas elegido.',
  },
  {
    title: 'Convierte la forma de la métrica.',
    body: 'Las construcciones que comparten gramática —selectores, rate/over_time, sum by (…), umbrales— se convierten una a una al lenguaje de destino.',
  },
  {
    title: 'Aísla lo que no se puede convertir.',
    body: 'Las piezas de LogQL solo para logs —filtros de línea, analizadores, line_format— se separan, ya que PromQL no tiene equivalente para ellas.',
  },
  {
    title: 'Genera la traducción.',
    body: 'La consulta reescrita se muestra en el lenguaje de destino, lista para copiarla en Grafana, en un archivo de reglas o en una alerta.',
  },
  {
    title: 'Informa de las notas.',
    body: 'Todo lo que sea con pérdidas o no convertible aparece como una nota en lenguaje claro, para que sepas exactamente qué verificar a mano.',
  },
];

// ── Example: LogQL → PromQL (clean metric map) ───────────────────────────────
const logqlExample = `# LogQL metric query — error rate from a log stream
sum by (app) (
  rate({app="checkout", env="prod"} |= "error" [5m])
) > 0.2`;

const promqlExample = `# PromQL — the same aggregation shape over a counter metric
sum by (app) (
  rate(app_request_errors_total{app="checkout", env="prod"}[5m])
) > 0.2`;

// ── Example: what does NOT map (log-only constructs) ─────────────────────────
const unmappableExample = `# These LogQL pieces have NO PromQL equivalent:
{app="checkout"} |= "error"            # line filter — PromQL sees samples, not lines
| json | line_format "{{.msg}}"        # parsers + line_format reshape log text
| label_format level=\`{{.severity}}\`   # label_format rewrites labels at query time`;
import type { Locale as __Locale } from '../../i18n/config';
import { localizeKey as __l } from '../../i18n/utils';
import { toolFaqs } from '../../data/tool-faqs';
const __lang = (Astro.currentLocale ?? 'en') as __Locale;

---

<Shell
  title="LogQL vs PromQL: diferencias + conversor gratis"
  description="LogQL vs PromQL: los mismos matchers y agregaciones, modelos de datos distintos. Mira qué se traduce y qué no, y convierte consultas en tu navegador."
  canonical="/logql-promql-helper"
  jsonLd={[softwareApp, faqPage]}
>
  <!-- ════════════════════════════════════════════════════════════════════
       1) HERO — compact, mesh gradient behind
       ════════════════════════════════════════════════════════════════════ -->
  <ToolHero
    eyebrow="LogQL ↔ PromQL · Observabilidad"
    badges={[
      { label: 'Sin registro', variant: 'neutral' },
      { label: 'Gratis y abierto', variant: 'neutral' },
    ]}
  >
    <Fragment slot="headline">
      Traduce entre <span translate="no">LogQL</span> y <span translate="no">PromQL</span>.
    </Fragment>
    <Fragment slot="lead">
      Un conversor gratuito de <span translate="no">LogQL</span> a <span translate="no">PromQL</span> que funciona en línea, enteramente en tu navegador.
      Pega una consulta, elige una dirección y obtén una reescritura limpia de las partes que se convierten más notas honestas sobre las partes que no.
    </Fragment>
  </ToolHero>

  <!-- ════════════════════════════════════════════════════════════════════
       2) THE PLAYGROUND
       ════════════════════════════════════════════════════════════════════ -->
  <section id="playground" class="scroll-mt-24 bg-canvas-soft pt-8 pb-20 sm:pb-24">
    <div class="container-page">
      <h2 class="sr-only">Convierte LogQL a PromQL, o PromQL a LogQL</h2>
      <LogqlPromqlPlayground />
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       3) WHY IT EXISTS — the gap
       ════════════════════════════════════════════════════════════════════ -->
  <section id="why" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <p class="eyebrow">La brecha</p>
          <h2 class="display-lg mt-3 text-balance text-ink">
            <span translate="no">LogQL</span> vs <span translate="no">PromQL</span>: la misma
            gramática, otro modelo de datos.
          </h2>
          <ToolGapVisual />
        </div>
        <div class="space-y-4">
          <p class="body-md text-pretty text-body">
            <span translate="no">LogQL</span> se modeló deliberadamente sobre
            <span translate="no">PromQL</span>: la sintaxis de los selectores, las funciones de vector de rango y
            los operadores de agregación parecen casi idénticos. Por eso, los ingenieros que usan a la vez
            <span translate="no">Loki</span> y <span translate="no">Prometheus</span> quieren constantemente
            llevar una consulta de uno al otro, y recurren a buscar y reemplazar, que
            se rompe en silencio en las partes que no encajan.
          </p>
          <p class="body-md text-pretty text-body">
            El problema es que <span translate="no">PromQL</span> solo llega a ver muestras ya agregadas,
            mientras que <span translate="no">LogQL</span> también puede filtrar y reestructurar líneas de log
            en bruto. Los filtros de línea, los analizadores y
            <span class="code-mono text-ink" translate="no">line_format</span> no tienen
            ningún equivalente en <span translate="no">PromQL</span>. Este conversor de consultas de <span translate="no">Loki</span> hace por ti la tediosa
            conversión de métricas y, lo que es igual de importante, te dice exactamente qué piezas
            no pudo traducir, para que las arregles a propósito en lugar de por sorpresa.
          </p>
          <p class="body-sm text-mute">
            ¿Nuevo en estas diferencias? Salta a <a class="link-inline" href="#syntax">qué se convierte y qué
            no</a> o prueba el <a class="link-inline" href="#playground">entorno de pruebas en vivo</a> de arriba.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       4) HOW IT WORKS — numbered pipeline
       ════════════════════════════════════════════════════════════════════ -->
  <ToolPipeline
    id="how-it-works"
    eyebrow="La canalización"
    heading="Cómo funciona."
    lead="Cinco pasos deterministas se ejecutan de principio a fin cada vez que pulsas Convertir, todos dentro de la pestaña de tu navegador, siempre."
    steps={pipeline}
  />

  <!-- ════════════════════════════════════════════════════════════════════
       5) SYNTAX — what maps & what doesn't
       ════════════════════════════════════════════════════════════════════ -->
  <section id="syntax" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Qué se convierte</p>
        <h2 class="display-lg mt-3 text-ink">
          Sintaxis de <span translate="no">LogQL</span> vs <span translate="no">PromQL</span>: qué se
          traduce y qué no.
        </h2>
        <p class="body-md mx-auto mt-3 max-w-xl text-pretty text-body">
          Las consultas de <span translate="no">métricas</span> comparten gramática y se convierten de forma limpia.
          Las consultas de <span translate="no">logs</span> —la parte que lee líneas en bruto— son donde los dos
          lenguajes se separan. Aquí tienes la distinción honesta.
        </p>
      </div>

      <div class="mx-auto mt-10 grid max-w-5xl gap-8 lg:grid-cols-2">
        <div class="min-w-0">
          <h3 class="display-sm text-ink">Se convierte de forma limpia</h3>
          <p class="body-sm mt-2 mb-4 text-pretty text-body">
            Los selectores de etiquetas, las funciones de vector de rango
            (<span class="code-mono text-ink" translate="no">rate</span>,
            <span class="code-mono text-ink" translate="no">increase</span>,
            <span class="code-mono text-ink" translate="no">count_over_time</span>), los operadores de agregación
            con agrupación <span class="code-mono text-ink" translate="no">by</span> /
            <span class="code-mono text-ink" translate="no">without</span> y las comparaciones de umbral
            comparten una sintaxis casi idéntica. La misma forma en
            <span translate="no">LogQL</span> se convierte en la misma forma en
            <span translate="no">PromQL</span>.
          </p>
          <div class="space-y-4">
            <CodeBlock lang="logql" filename="source.logql" code={logqlExample} />
            <CodeBlock lang="promql" filename="result.promql" code={promqlExample} />
          </div>
        </div>

        <div class="min-w-0">
          <h3 class="display-sm text-ink">No tiene equivalente</h3>
          <p class="body-sm mt-2 mb-4 text-pretty text-body">
            <span translate="no">PromQL</span> solo ve muestras numéricas, así que las partes de
            <span translate="no">LogQL</span> que operan sobre el texto de log en bruto simplemente no existen del
            otro lado. Los filtros de línea
            (<span class="code-mono text-ink" translate="no">|= "error"</span>), los analizadores
            (<span class="code-mono text-ink" translate="no">| json</span>,
            <span class="code-mono text-ink" translate="no">| logfmt</span>),
            <span class="code-mono text-ink" translate="no">line_format</span> y
            <span class="code-mono text-ink" translate="no">label_format</span> se informan como
            notas, nunca se descartan en silencio.
          </p>
          <CodeBlock lang="logql" filename="log-only.logql" code={unmappableExample} />
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       6) NOTE — honest preview-engine callout
       ════════════════════════════════════════════════════════════════════ -->
  <section class="bg-canvas-soft">
    <div class="container-page py-12 sm:py-16">
      <div class="card-soft mx-auto max-w-3xl p-6">
        <p class="eyebrow">Motor de vista previa</p>
        <p class="body-md mt-3 text-pretty text-body">
          Una nota sobre la precisión: el traductor en el navegador es un <strong class="font-medium text-ink"
            >motor de vista previa</strong
          > que convierte las formas habituales de consultas de métricas: selectores de etiquetas, funciones de vector de rango como
          <span class="code-mono text-ink" translate="no">rate</span> /
          <span class="code-mono text-ink" translate="no">count_over_time</span>, agregaciones con
          <span class="code-mono text-ink" translate="no">by</span> /
          <span class="code-mono text-ink" translate="no">without</span> y comparaciones de umbral.
          No ejecuta un analizador completo de <span translate="no">LogQL</span> ni de
          <span translate="no">PromQL</span>, y no puede inventar un nombre de métrica para una
          serie derivada de logs. Trata su resultado como un buen primer borrador para revisar, no como un
          reemplazo garantizado para reglas de producción.
        </p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       7) FAQ
       ════════════════════════════════════════════════════════════════════ -->
  <FaqList faqs={faqs} />

  <!-- ════════════════════════════════════════════════════════════════════
       Cross-links (observability cluster) + footer disclaimer
       ════════════════════════════════════════════════════════════════════ -->
  <ToolCrossLinks lang={__lang}>
    <Fragment slot="lead">
      El <span translate="no">LogQL</span> ↔ <span translate="no">PromQL</span> Helper se sitúa junto
      al resto del clúster de observabilidad de <span translate="no">{site.name}</span>:
      <a class="link-inline" href={__l("/promql-explainer", __lang)}
        >explica una consulta <span translate="no">PromQL</span></a
      > o <a class="link-inline" href={__l("/loki-alert-rule-tester", __lang)}
        >prueba tus reglas de alerta de <span translate="no">Loki</span></a
      > con <span translate="no">AlertLint</span>, todo basado en el navegador y privado de forma predeterminada.
    </Fragment>
    <Fragment slot="links">
      ¿Quieres el conjunto completo? Explora el <a class="link-inline" href={__l(navLinks[0].href, __lang)}
        >directorio de herramientas</a
      > completo, o lee por qué todo lo de aquí funciona <a class="link-inline" href="/#privacy"
        >enteramente del lado del cliente</a
      >.
    </Fragment>
    <Fragment slot="disclaimer">
      No está afiliado ni respaldado por <span translate="no">Grafana Labs</span> ni por el
      proyecto <span translate="no">Prometheus</span>. <span translate="no">Loki</span> y
      <span translate="no">Grafana</span> son marcas comerciales de <span translate="no">Raintank, Inc.</span>;
      <span translate="no">Prometheus</span> es una marca comercial de
      <span translate="no">The Linux Foundation.</span>
    </Fragment>
  </ToolCrossLinks>
</Shell>
