---
/**
 * OpsCanopy hub homepage — the flagship marketing surface.
 * Composes the Vercel-inspired design system defined in global.css / DESIGN.md.
 * Structural mirror of src/pages/index.astro (English) — see that file for the
 * canonical section order; keep both in sync when the layout changes.
 *
 * Section order (Batch E, 2026-10; the outline lives in the PR description):
 *   1 claim (hero + HeroDemo) → 2 proof ledger → 3 numbered tool index →
 *   4 Mission 90 drill → 5 Learn → 6 why + privacy band → 7 incident ledger →
 *   8 verify plate → 9 FAQ → 10 two-door close.
 * Surfaces alternate (soft / canvas / soft …) so no two adjacent sections share
 * a surface and their paddings never stack. Every band's markup lives in
 * src/components/home/* once; this file carries only the translated copy.
 *
 * Copy rule: "free", "no signup" and "in your browser" (in this locale's
 * words) appear once above the fold (H1 + lede) and nowhere else outside the
 * FAQ and <title>/meta. Two exceptions are deliberate: the HomeDoors texts and
 * the Mission CTA are watched anchors (the SEO guard fails closed on any
 * change), and the privacy paragraph in the why band is kept verbatim.
 */
import Shell from '../../components/Shell.astro';
import HeroDemo from '../../components/home/HeroDemo.astro';
import PrivacyProof from '../../components/home/PrivacyProof.astro';
import ProofStrip from '../../components/home/ProofStrip.astro';
import ToolsGrid from '../../components/home/ToolsGrid.astro';
import HomeDoors from '../../components/home/HomeDoors.astro';
import MissionBand from '../../components/home/MissionBand.astro';
import VerifyPlate from '../../components/home/VerifyPlate.astro';
import HomeFaq from '../../components/home/HomeFaq.astro';
import TwoDoorClose from '../../components/home/TwoDoorClose.astro';
import Button from '../../components/Button.astro';
import LatestPosts from '../../components/home/LatestPosts.astro';
import JumpBackIn from '../../components/JumpBackIn.astro';
import TrackCard from '../../components/learn/TrackCard.astro';
import { liveTools, getTool } from '../../data/tools';
import { tracks } from '../../data/learn';
import { liveTests } from '../../data/tests';
import { program, phases as m90Phases, missions as m90Missions, totalCoreMinutes } from '../../data/mission90';
import { getGuidesForLocale, estimateReadingTime } from '../../lib/learn/guides';
import { faqPageLd } from '../../lib/jsonld';
import {
  GHA_SEMANTICS_VERSION,
  exprCorpus,
  ifCorpus,
  globCorpus,
  triggerCorpus,
} from '../../lib/github-actions-expression-tester/conformance';
import { JQ_VERSION } from '../../data/versions';
import type { Locale as __Locale } from '../../i18n/config';
import { localizeKey as __l, localizeNavHref as __nav } from '../../i18n/utils';

const __lang = (Astro.currentLocale ?? 'en') as __Locale;


// Featured catalog grid — a CURATED set of 9 representative tools, mirrors English.
const featuredSlugs = [
  // Leads with the five tools that have no competing browser tool at all; the last
  // four stay recognizable for a first-time visitor. See src/pages/index.astro.
  'github-actions-expression-tester',
  'alertmanager-route-tester',
  'prometheus-relabel-tester',
  'loki-alert-rule-tester',
  'jq-playground',
  'certificate-decoder',
  'subnet-calculator',
  'jwt-decoder',
  'cron-expression-tester',
];
const featuredTools = featuredSlugs
  .map((slug) => getTool(slug))
  .filter((t): t is NonNullable<typeof t> => Boolean(t) && t!.status === 'live');

// Learn band — /learn is English-only content (ENGLISH_ONLY_SECTIONS), so the
// guides themselves are fetched in English regardless of page locale.
const learnGuides = await getGuidesForLocale('en');
const learnByTrack = (slug: string) =>
  learnGuides.filter((g) => g.entry.data.track === slug).sort((x, y) => x.entry.data.order - y.entry.data.order);
const trackMeta = (slug: string) => {
  const gs = learnByTrack(slug);
  return {
    count: gs.length,
    minutes: gs.reduce((s, g) => s + (g.entry.data.estMinutes ?? estimateReadingTime(g.entry.body)), 0),
    difficulty: gs[0]?.entry.data.difficulty ?? 'beginner',
  };
};
const featuredTracks = tracks.filter((t) => ['linux', 'docker', 'kubernetes'].includes(t.slug));

// Mission-90 homepage feature band — figures derived from the registry, mirrors
// English. Mission-90 is also English-only content, so the transcript stays English.
const m90LiveMissions = m90Missions.filter((m) => m.status === 'live').length;
const m90Hours = Math.round(totalCoreMinutes / 60 / 10) * 10;
const m90Stats = [
  { n: String(program.totalDays), l: 'dias' },
  { n: String(m90Phases.length), l: 'fases' },
  { n: String(m90LiveMissions), l: 'missões no navegador' },
  { n: `~${m90Hours}`, l: 'horas de conteúdo' },
];
const m90Transcript = `student@prod-web-01:~$ ps aux --sort=-%cpu | head -3
USER   PID   %CPU  COMMAND
root   4521  94.0  /opt/scripts/nightly-backup.sh
student@prod-web-01:~$ kill 4521
student@prod-web-01:~$ systemctl restart nginx
student@prod-web-01:~$ curl -sI localhost | head -1
HTTP/1.1 200 OK
# 02:07 — the site is back. You did that.`;

const faqs = [
  {
    q: 'As ferramentas do OpsCanopy são realmente gratuitas?',
    a: 'Sim. Toda ferramenta é completamente gratuita, sem paywalls, limites de uso ou planos premium. Não há nenhum tipo de exigência de conta: abra uma ferramenta no seu navegador e comece a usar na hora.',
  },
  {
    q: 'Preciso me cadastrar para usar essas ferramentas de DevOps online?',
    a: 'Não. Não há cadastro, login nem captura de e-mail. Abra qualquer ferramenta em uma aba do navegador e use na hora: sem conta, sem banner de cookies, sem atrito. A análise de uso roda sem cookies por padrão na UE, no Reino Unido e na Suíça, e com um único cookie próprio no restante do mundo; nos dois casos você pode mudar isso na página de privacidade.',
  },
  {
    q: 'Meus dados são enviados para um servidor quando uso as ferramentas?',
    a: 'Não. Toda ferramenta roda 100% no lado do cliente, na aba do seu navegador; nada do que você cola é registrado, armazenado ou enviado. Seus dados nunca saem do navegador.',
  },
  {
    q: 'É seguro colar um JWT ou uma configuração em uma ferramenta baseada em navegador?',
    a: 'No OpsCanopy, sim. A decodificação e a análise acontecem inteiramente em JavaScript local — nada do que você cola é transmitido, algo que você mesmo pode verificar na aba de rede do navegador (o único tráfego de saída é uma análise de páginas agregada, descrita na nossa política de privacidade). Como boa prática geral, nunca compartilhe segredos de assinatura com terceiros, mas o OpsCanopy não envia nada do que você digita.',
  },
  {
    q: 'As ferramentas funcionam offline?',
    a: 'Depois que a página de uma ferramenta carrega, ela continua funcionando mesmo que você se desconecte da internet, porque todo o processamento é local e não há backend para chamar. Ficar offline também é uma forma fácil de você mesmo verificar a garantia de privacidade do lado do cliente.',
  },
  {
    q: 'Para quem são essas ferramentas de DevOps baseadas em navegador?',
    a: 'Engenheiros de DevOps, SREs, administradores de sistemas, engenheiros de plataforma e de backend: qualquer pessoa que precise de cálculos rápidos de sub-rede e CIDR, agendamentos de cron, consultas PromQL ou LogQL, utilitários de JWT, Base64 e hash, conversão de timestamps, validação de GitHub Actions ou dimensionamento de recursos do Kubernetes sem instalar nada.',
  },
  {
    q: 'Por que usar essas ferramentas em vez de perguntar ao ChatGPT ou ao Claude?',
    a: 'Use os dois — para trabalhos diferentes. Um assistente de IA é excelente para explicar conceitos e rascunhar configurações, mas ele gera texto plausível em vez de calcular respostas, e a aritmética exata é um ponto fraco documentado: limites de sub-rede, agendamentos de cron, conversões de epoch e comportamento de regex costumam voltar parecendo certos e estando errados. As ferramentas do OpsCanopy calculam as respostas de forma determinística — parsers reais, matemática exata — e recalculam instantaneamente enquanto você ajusta a entrada, sem novos prompts, sem custo de tokens e sem limite de requisições; depois que a página de uma ferramenta carrega, ela continua funcionando offline. Nada do que você cola é transmitido, então logs, tokens e configurações ficam na sua máquina. Várias ferramentas até funcionam como verificadores práticos de IA: passe a mesma sub-rede, expressão cron ou timestamp por elas e você obtém a resposta de referência para comparar.',
  },
  {
    q: 'Como o OpsCanopy se diferencia de outras coletâneas de ferramentas para desenvolvedores online?',
    a: 'A maioria das coletâneas de ferramentas foca em formatadores genéricos. O OpsCanopy é especializado em fluxos de trabalho de DevOps e SRE: planejamento de CIDR, cron, PromQL e LogQL, capacidade do Kubernetes, validadores de CI, com as mesmas garantias o tempo todo: grátis, sem cadastro, 100% no lado do cliente, sem enviar nem registrar nada.',
  },
  {
    q: 'Quero me tornar um engenheiro DevOps — por onde começo?',
    a: 'Comece com o OpsCanopy Learn em /learn. Ele combina um roteiro de carreira em DevOps por etapas (/learn/roadmaps/devops) com guias gratuitos e práticos cobrindo Linux, Docker, Kubernetes, AWS e redes — indo do básico até estar pronto para o mercado. Enquanto lê, você pode praticar imediatamente com as ferramentas correspondentes no catálogo, sem necessidade de cadastro.',
  },
];

// Quietly-stated trust principles for the value strip.
/*
 * "How we know it's right" — the hero says these tools are exact; this strip is
 * the evidence, directly under the claim. Counts come from the code they
 * describe (the conformance corpus, the pinned jq build), so they cannot drift
 * out of date the way a hand-written number would. Like every technical readout
 * on the site, the values stay in English; only the prose is translated.
 */
const ghaCases = exprCorpus.length + ifCorpus.length + globCorpus.length + triggerCorpus.length;
const fidelity = [
  {
    label: 'GitHub Actions',
    title: `${ghaCases} casos de conformidade`,
    body: `Cada operador, conversão e glob está fixado a um corpus versionado (${GHA_SEMANTICS_VERSION}) que roda a cada build.`,
  },
  {
    label: 'jq',
    title: `jq ${JQ_VERSION} de verdade`,
    body: 'Não é uma reimplementação: o binário real do jq compilado para WebAssembly, rodando na sua aba.',
  },
  {
    label: 'Alertmanager',
    title: 'Roteia como o roteador',
    body: 'Rotas aninhadas, continue, matchers e agrupamento são modelados como o próprio Alertmanager os resolve.',
  },
  {
    label: 'IP e hashing',
    title: 'Vetores RFC e NIST',
    body: 'Aritmética BigInt exata para IPv4 e IPv6, conferida contra vetores de teste publicados.',
  },
];

// "Why a hub" value props, mirrors English.
const whyCards = [
  {
    eyebrow: 'UM SÓ LUGAR',
    title: 'Tudo em uma aba.',
    body: 'Salve um único favorito em vez de uma dúzia. Quando precisar de um conversor, validador ou calculadora, ele já está aqui — mesmo visual, mesmos atalhos, nada novo para aprender.',
    icon: '<path d="M3 20h18"/><path d="M6 20v-4M12 20V8M18 20v-9"/>',
  },
  {
    eyebrow: 'SEMPRE RÁPIDO',
    title: 'Instantâneo, toda vez.',
    body: 'Cada ferramenta é estática e roda no cliente: sem filas de servidor nem cold starts para esperar. As páginas carregam na hora, seja você sozinho ou dez mil pessoas de uma vez.',
    icon: '<path d="M13 3 5 13h6l-1 8 9-11h-6l1-7Z"/>',
  },
  {
    eyebrow: 'SEM BARREIRA',
    title: 'Nada para desbloquear.',
    body: 'Toda ferramenta, guia e simulado está aberto a qualquer pessoa — sem paywall, sem período de teste, sem formulário. Abra a página e comece a usar.',
    icon: '<path d="M3 11.4 11.4 3H19a2 2 0 0 1 2 2v7.6l-8.4 8.4a1.5 1.5 0 0 1-2.1 0L3 13.5a1.5 1.5 0 0 1 0-2.1Z"/><circle cx="15.8" cy="8.2" r="1.4"/>',
  },
];


// The hero's "what can I do here" row — the three things the site is for.
const doors = [
  { href: __l('/tools', __lang), title: 'Usar uma ferramenta', body: `${liveTools.length} ferramentas exatas: sub-redes, cron, PromQL, GitHub Actions e mais.` },
  { href: __nav('/mission-90', __lang), title: 'Aprender DevOps', body: `Um programa gratuito de 90 dias, de desenvolvedor a engenheiro DevOps (em inglês).` },
  { href: __nav('/tests', __lang), title: 'Praticar para uma certificação', body: `${liveTests.length} simulados da AWS, com cada resposta explicada (em inglês).` },
];

// The close: use a tool, or start learning. /tools/ stays an <a> on the page.
const closeDoors = [
  { href: __l('/tools', __lang), label: 'Encontrar ferramenta — abrir o catálogo', variant: 'primary' },
  { href: __nav('/learn/roadmaps/devops', __lang), label: 'Iniciar o roteiro de DevOps', variant: 'secondary' },
] as const;

// Organization + WebSite are emitted sitewide by SEO.astro with stable @ids.
const jsonLd = [faqPageLd(faqs)];
---

<Shell
  title="OpsCanopy — Ferramentas DevOps e SRE grátis no navegador"
  description="Ferramentas DevOps gratuitas que rodam no seu navegador — expressões do GitHub Actions, rotas do Alertmanager, relabeling, sub-redes e cron. Sem cadastro."
  canonical="/"
  jsonLd={jsonLd}
>
  {/* ─────────────────────────── 1 · CLAIM ─────────────────────────── */}
  <section class="section-pad relative isolate overflow-hidden bg-canvas-soft">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-32 bg-gradient-to-b from-canvas-soft to-transparent"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-48 bg-gradient-to-b from-transparent to-canvas-soft"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative z-10">
      <div class="flex flex-col">
        <div class="flex flex-col">
      <p class="eyebrow flex flex-wrap items-center gap-x-2 gap-y-1 text-mute">
        <span>{liveTools.length} ferramentas</span>
        <span aria-hidden="true" class="text-hairline">&bull;</span>
        <span>100% no lado do cliente</span>
        <span aria-hidden="true" class="text-hairline">&bull;</span>
        <a
          href="https://github.com/opscanopy/opscanopy.com"
          target="_blank"
          rel="noopener noreferrer"
          class="underline decoration-hairline underline-offset-4 transition-colors hover:text-ink"
          >Código aberto</a
        >
      </p>

      <h1 class="display-xl mt-4 max-w-3xl text-balance text-ink">
          Ferramentas DevOps grátis e treinamento prático, direto no seu navegador.
      </h1>

      <p class="body-md mt-4 max-w-2xl text-pretty text-body">
          O OpsCanopy é onde engenheiros verificam configurações, consultas e cálculos de rede — e
          onde desenvolvedores aprendem a se tornar engenheiros DevOps. Nada do que você colar sai do
          seu dispositivo, e nunca precisa de conta.
      </p>

      <HomeDoors doors={doors} ariaLabel="O que você pode fazer no OpsCanopy" />
        </div>

        <div class="mt-10 lg:mt-12">
          <HeroDemo />
        </div>
      </div>
    </div>
  </section>

  {/* ─────────── 2 · PROOF LEDGER — the evidence for the hero's claim ─────────── */}
  <ProofStrip principles={fidelity} ariaLabel="Como sabemos que as respostas estão certas" heading="Respostas exatas, não aproximações." />

  {/* ─────────── 2b · JUMP BACK IN (pinned/recent tools; client-revealed) ─────────── */}
  <JumpBackIn heading="Continue de onde parou" lang="pt-br" />

  {/* ─────────── 3 · THE TOOL INDEX (numbered by registry figure) ─────────── */}
  <ToolsGrid tools={featuredTools} lang="pt-br" openLabel={"Abrir ferramenta"}>
    <Fragment slot="eyebrow">O catálogo</Fragment>
    <Fragment slot="heading">O índice de ferramentas.</Fragment>
    <Fragment slot="lead">Utilitários focados e de propósito único para engenheiros de plataforma e DevOps: cada um
            no ar, exato e a um único favorito de distância.</Fragment>
    <Fragment slot="seeAll">Ver todas as ferramentas</Fragment>
    <Fragment slot="browseAll">Explorar todas as {liveTools.length} ferramentas</Fragment>
  </ToolsGrid>

  {/* ─────────── 4 · MISSION 90 DRILL — the guided program, on the slab ─────────── */}
  <MissionBand lang={__lang} stats={m90Stats} transcript={m90Transcript} boardLabel="Três das dez missões" weekLabel="Semana" playLabel="Jogar">
    <Fragment slot="heading">De desenvolvedor a engenheiro DevOps em 90 dias.</Fragment>
    <Fragment slot="body">Um caminho guiado — uma lição focada por dia e, no fim de cada semana, uma missão
      narrativa que você joga em um terminal na própria página para consertar um sistema quebrado.
      Os 90 dias e as 10 missões já estão disponíveis — abertos desde o primeiro dia.</Fragment>
    <Fragment slot="cta">Começar o dia 1 — grátis, sem cadastro</Fragment>
    <Fragment slot="browse">Explorar as missões</Fragment>
  </MissionBand>

  {/* ─────────── 5 · LEARN DEVOPS (route homepage authority into /learn) ─────────── */}
  <section class="section-pad-lg bg-canvas-soft" aria-labelledby="learn-devops">
    <div class="container-page">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <span class="eyebrow">Learn DevOps</span>
          <h2 id="learn-devops" class="display-lg mt-3 text-balance text-ink">
            Roteiros em etapas e guias práticos.
          </h2>
          <p class="body-md mt-3 text-pretty text-body">
            Vá do básico até estar pronto para o mercado com roteiros de carreira em etapas e guias
            práticos e aprofundados — Linux, Docker, Kubernetes, AWS e redes. No seu ritmo, e você pode praticar com as ferramentas enquanto aprende.
          </p>
        </div>
        <a
          href={__nav('/learn', __lang)}
          class="link-inline group body-md inline-flex shrink-0 items-center gap-1 whitespace-nowrap font-medium"
        >
          Ver todos os guias
          <span
            aria-hidden="true"
            class="transition-transform duration-150 ease-out group-hover:translate-x-0.5"
          >
            &rarr;
          </span>
        </a>
      </div>

      <div class="mt-8">
        <Button href={__nav('/learn/roadmaps/devops', __lang)} variant="primary">Começar com o roteiro de DevOps</Button>
      </div>

      <ul role="list" class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredTracks.map((track) => {
          const m = trackMeta(track.slug);
          return <TrackCard track={track} guideCount={m.count} difficulty={m.difficulty} minutes={m.minutes} />;
        })}
      </ul>
    </div>
  </section>

  {/* ─────────── 6 · WHY + PRIVACY (one band: #why on the section, #privacy on the slab) ─────────── */}
  <PrivacyProof points={whyCards}>
    <Fragment slot="eyebrow">Por que a OpsCanopy</Fragment>
    <Fragment slot="heading">Um só conjunto de garantias, não vinte abas.</Fragment>
    <Fragment slot="body">Cada ferramenta do <span translate="no">OpsCanopy</span> roda como JavaScript estático no seu
            navegador. Não há backend para receber suas regras, configurações ou logs: sem envios, sem
            telemetria sobre suas entradas, sem conta para criar. Feche a aba e tudo desaparece.</Fragment>
  </PrivacyProof>

  {/* ─────────── 7 · INCIDENT LEDGER (from the blog) ─────────── */}
  <LatestPosts lang={__lang} />

  {/* ─────────── 8 · VERIFY PLATE — a claim beside the computation ─────────── */}
  <VerifyPlate calculatorHref={__l('/subnet-calculator', __lang)}>
    <Fragment slot="eyebrow">Verificar a IA</Fragment>
    <Fragment slot="heading">Confira a resposta de uma IA contra o cálculo real.</Fragment>
    <Fragment slot="body">Cole os números que um assistente te deu ao lado da entrada que ele recebeu. A ferramenta os
      recalcula com exatidão, nesta mesma página, e avalia cada afirmação — a mesma verificação que as
      ferramentas de sub-rede, cron, timestamp e Base64 trazem sob o painel de resultados.</Fragment>
  </VerifyPlate>

  {/* ─────────────────────────── 9 · FAQ ─────────────────────────── */}
  <HomeFaq faqs={faqs} moreLabel="Mais perguntas" />

  {/* ───────────────────────── 10 · TWO-DOOR CLOSE ───────────────────────── */}
  <TwoDoorClose doors={[closeDoors[0], closeDoors[1]]}>
    <Fragment slot="heading">Encontre sua ferramenta. Pule a instalação.</Fragment>
    <Fragment slot="body">Exata, privada e instantânea. Abra o catálogo e coloque a ferramenta certa para trabalhar no seu próximo deploy.</Fragment>
  </TwoDoorClose>
</Shell>
