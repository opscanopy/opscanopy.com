---
/**
 * GitHub Actions Expression & Trigger Tester — the primary SEO surface.
 *
 * Two client-side tools on one page: an expression evaluator that replicates
 * GitHub's exact ${{ }} semantics (and warns on the always-true literal footgun,
 * actions/runner#1173), and a trigger simulator that decides per-job RUNS/SKIPPED
 * for a push / pull_request / tag event. 100% in-browser — no server, no signup.
 *
 * Mirrors the github-actions-validator page structure (hero, playground island,
 * why/cheat-sheet docs, scope note, FAQ + JSON-LD, cross-links).
 */
import Shell from '../../components/Shell.astro';
import GithubActionsExpressionPlayground from '../../components/GithubActionsExpressionPlayground.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Badge from '../../components/Badge.astro';
import ToolHero from '../../components/ToolHero.astro';
import ToolGapVisual from '../../components/ToolGapVisual.astro';
import ToolPipeline from '../../components/ToolPipeline.astro';
import FaqList from '../../components/FaqList.astro';
import ToolCrossLinks from '../../components/ToolCrossLinks.astro';
import { site, navLinks } from '../../data/site';
import { getTool } from '../../data/tools';
import { softwareAppLd, faqPageLd } from '../../lib/jsonld';

const tool = getTool('github-actions-expression-tester');

const pagePath = '/github-actions-expression-tester/';
const pageUrl = `${site.url}${__l(pagePath, (Astro.currentLocale ?? 'en') as __Locale)}`;

// Literal token kept out of Astro's `{}` expression parser.
const EXPR = '${{ }}';

// ── External references ──────────────────────────────────────────────────────
const ghExpressions = 'https://docs.github.com/actions/learn-github-actions/expressions';
const ghTriggers =
  'https://docs.github.com/actions/using-workflows/events-that-trigger-workflows';
const ghIssue1173 = 'https://github.com/actions/runner/issues/1173';

// ── FAQ content — single source for both the rendered section and FAQPage LD ─
const faqs = toolFaqs('github-actions-expression-tester', 'pt-br');

// ── JSON-LD ──────────────────────────────────────────────────────────────────
const softwareApp = softwareAppLd({
  name: 'Testador de Expressões e Triggers do GitHub Actions',
  description:
    'Teste uma condição if: do GitHub Actions sem fazer push: avalie expressões ${{ }} contra um contexto fictício github/env/matrix/steps/needs, pegue a armadilha do “sempre verdadeiro” causada por texto literal e simule quais jobs rodam para um push, PR ou tag. Grátis, 100% no navegador.',
  url: pageUrl,
  subCategory: 'CI/CD',
  featureList: [
    "Avalia expressões ${{ }} contra um contexto fictício editável github/env/matrix/steps/needs com a semântica exata de operadores e coerção do GitHub",
    'Avisa sobre a armadilha do if: "sempre verdadeiro" por texto literal (actions/runner#1173)',
    'Suporta contains, startsWith, endsWith, format, join, toJSON, fromJSON, hashFiles, success(), failure(), always(), cancelled()',
    'Simulador de Triggers: descreva um evento de push, pull_request ou tag e veja quais jobs vão RUN ou serão SKIPPED com o motivo decisivo',
    'Motor de glob fiel para branches, tags, paths e paths-ignore, incluindo a semântica de AND entre branch e path',
    '100% no lado do cliente: o YAML do seu workflow e os payloads de eventos nunca saem do navegador',
  ],
  keywords: tool?.keywords.join(', '),
});
const faqPage = faqPageLd(faqs);

// ── HOW IT WORKS pipeline ─────────────────────────────────────────────────────
const pipeline = [
  {
    title: 'Escolha uma aba.',
    body: 'Avalie um único if: / expressão, ou troque para o simulador de triggers para testar um workflow inteiro contra um evento.',
  },
  {
    title: 'Defina o contexto.',
    body: 'Edite o JSON fictício github/env/matrix/steps/needs (ou descreva o evento: tipo, ref, arquivos alterados) para que ele corresponda à execução que lhe interessa.',
  },
  {
    title: 'Analise com a gramática do GitHub.',
    body: 'A expressão é tokenizada e analisada com a mesma precedência de operadores e o mesmo conjunto de funções que o runner usa — sem shell-out, sem rede.',
  },
  {
    title: 'Aplique a semântica exata.',
    body: 'A coerção, a igualdade que ignora maiúsculas e minúsculas, o && / || que retornam um operando, os filtros de glob e a regra de AND entre branch e path são replicados contra um corpus de conformidade versionado.',
  },
  {
    title: 'Mostre o veredito + o porquê.',
    body: 'Você recebe o resultado truthy/falsy e o valor retornado, o aviso da armadilha do sempre verdadeiro onde ele se aplica, e uma tabela RUNS/SKIPPED por job com o motivo decisivo.',
  },
];

// ── CHEAT-SHEET cards ─────────────────────────────────────────────────────────
const footgunBad = `# ALWAYS TRUE — operators sit OUTSIDE \${{ }}
jobs:
  deploy:
    if: \${{ github.ref }} == 'refs/heads/main'
    # after substitution this is the literal string
    #   refs/heads/main == 'refs/heads/main'
    # a non-empty string => truthy => runs on EVERY branch`;
const footgunGood = `# CORRECT — wrap the WHOLE condition in one \${{ }}
jobs:
  deploy:
    if: \${{ github.ref == 'refs/heads/main' }}
    # now GitHub evaluates the comparison, not a literal string`;

const coercionExample = `# GitHub's coercion is JS-like and case-insensitive:
\${{ 'ABC' == 'abc' }}      # true  (strings compare case-insensitively)
\${{ null == 0 }}           # true  (both coerce to the number 0)
\${{ '' || 'fallback' }}    # 'fallback'  (|| returns an OPERAND, not a bool)
\${{ github.x && 'yes' }}   # 'yes' when github.x is truthy
\${{ 'true' == true }}      # false (string 'true' coerces to NaN)`;

const functionsExample = `\${{ contains('refs/heads/main', 'main') }}     # true (substring, case-insensitive)
\${{ startsWith(github.ref, 'refs/tags/') }}    # is this a tag push?
\${{ format('{0}-{1}', 'app', github.sha) }}    # 'app-d6cd1e2…'
\${{ fromJSON('["a","b"]') }}                   # a real array
\${{ always() }}  \${{ success() }}  \${{ failure() }}  # status checks`;

const triggerExample = `on:
  push:
    branches: [main]      # AND
    paths: ['src/**']     # — both must match to trigger
# feature/* matches feature/a but NOT feature/a/b
# feature/** matches both (** crosses '/')`;

const cheats = [
  {
    title: 'A armadilha do "sempre verdadeiro"',
    badge: 'Mais comum',
    blurb:
      'O GitHub só avalia o que está dentro de ${{ }}. Os operadores deixados de fora viram texto literal após a substituição — uma string não vazia, que é sempre truthy. O avaliador sinaliza isso (actions/runner#1173).',
    bad: footgunBad,
    good: footgunGood,
  },
];

const refs = [
  { title: 'Operadores e coerção', code: coercionExample },
  { title: 'Funções', code: functionsExample },
  { title: 'Triggers, branches e paths', code: triggerExample },
];
import type { Locale as __Locale } from '../../i18n/config';
import { localizeKey as __l } from '../../i18n/utils';
import { toolFaqs } from '../../data/tool-faqs';
const __lang = (Astro.currentLocale ?? 'en') as __Locale;
---

<Shell
  title="Testador de Condições if do GitHub Actions"
  description="Teste uma condição if do GitHub Actions no navegador: avalie ${{ }} com um contexto fictício, pegue a armadilha do sempre-verdadeiro e quais jobs rodam."
  canonical="/github-actions-expression-tester"
  jsonLd={[softwareApp, faqPage]}
>
  <!-- 1) HERO -->
  <ToolHero
    eyebrow="Testador de Expressões do GitHub Actions · CI/CD"
    badges={[
      { label: 'Sem cadastro', variant: 'neutral' },
      { label: 'Semântica exata do GitHub', variant: 'neutral' },
    ]}
  >
    <Fragment slot="headline">
      Teste suas condições <span translate="no">if:</span> e seus triggers antes de fazer push.
    </Fragment>
    <Fragment slot="lead">
      Avalie expressões <span class="code-mono text-ink" translate="no">{EXPR}</span> contra um
      contexto fictício editável, pegue o <span translate="no">if:</span> que é silenciosamente
      <em>sempre verdadeiro</em>, e simule quais jobs rodam para um push, PR ou tag — na hora, no seu
      navegador. Sem o ciclo <span translate="no">commit-push-pray</span>.
    </Fragment>
  </ToolHero>

  <!-- 2) PLAYGROUND -->
  <section id="playground" class="scroll-mt-24 bg-canvas-soft pb-20 pt-8 sm:pb-24">
    <div class="container-page">
      <h2 class="sr-only">Playground de condições if e triggers do GitHub Actions</h2>
      <GithubActionsExpressionPlayground />
    </div>
  </section>

  <!-- 3) WHY IT EXISTS -->
  <section id="why" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <p class="eyebrow">A lacuna</p>
          <h2 class="display-lg mt-3 text-balance text-ink">
            Por que sua condição <span translate="no">if:</span> do GitHub Actions é sempre verdadeira.
          </h2>
          <ToolGapVisual />
        </div>
        <div class="space-y-4">
          <p class="body-md text-pretty text-body">
            Todo mundo já fez isso: adiciona um <span class="code-mono text-ink" translate="no">if:</span> a um
            passo, faz push, vê ele rodar quando não deveria, ajusta, faz push de novo — vinte commits inúteis depois
            você descobre que a condição era uma string literal o tempo todo. O GitHub só avalia o que está
            dentro de <span class="code-mono text-ink" translate="no">{EXPR}</span>; qualquer coisa de fora é
            texto literal, e uma string não vazia é sempre truthy.
          </p>
          <p class="body-md text-pretty text-body">
            O lado dos triggers é igualmente opaco: um workflow que não roda não produz
            <strong class="font-medium text-ink">saída nenhuma</strong> — a decisão acontece na
            filtragem de eventos do GitHub antes que qualquer runner inicie. Os filtros de branch e path se combinam com
            <span class="code-mono text-ink" translate="no">AND</span>, os pushes de tag são excluídos quando você
            define <span class="code-mono text-ink" translate="no">branches</span> mas não
            <span class="code-mono text-ink" translate="no">tags</span>, e
            <span class="code-mono text-ink" translate="no">**</span> se comporta de forma diferente de
            <span class="code-mono text-ink" translate="no">*</span>.
          </p>
          <p class="body-md text-pretty text-body">
            Esta ferramenta avalia os dois — uma única expressão, ou um workflow inteiro contra um evento — usando
            as regras exatas do <span translate="no">GitHub</span>, para que você obtenha a resposta no navegador. Veja a
            documentação de
            <a class="link-inline" href={ghExpressions} target="_blank" rel="noopener noreferrer">expressões</a>
            e de
            <a class="link-inline" href={ghTriggers} target="_blank" rel="noopener noreferrer">triggers de workflow</a>
            do <span translate="no">GitHub</span>, e a issue da
            <a class="link-inline" href={ghIssue1173} target="_blank" rel="noopener noreferrer">armadilha do sempre verdadeiro</a>.
          </p>
          <p class="body-sm text-mute">
            Pule para a <a class="link-inline" href="#reference">cola</a> ou para o
            <a class="link-inline" href="#playground">playground ao vivo</a> acima.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4) HOW IT WORKS -->
  <ToolPipeline
    id="how-it-works"
    eyebrow="O pipeline"
    heading="Como o testador de condições if: decide verdadeiro ou falso."
    lead="Cinco passos determinísticos rodam de ponta a ponta em cada avaliação — todos dentro da aba do seu navegador, toda vez."
    steps={pipeline}
  />

  <!-- 5) CHEAT-SHEET -->
  <section id="reference" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Cola</p>
        <h2 class="display-lg mt-3 text-ink">
          As regras de <span translate="no">if:</span> e triggers que pegam as pessoas de surpresa.
        </h2>
        <p class="body-md mx-auto mt-3 max-w-xl text-pretty text-body">
          A armadilha, as surpresas da coerção, as funções e os globs de trigger — cada um com um
          exemplo executável que você pode colar no playground.
        </p>
      </div>

      <div class="mx-auto mt-10 grid max-w-5xl gap-6">
        {
          cheats.map((c) => (
            <article class="card-soft min-w-0 p-6 sm:p-7">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <h3 class="display-sm text-balance text-ink">{c.title}</h3>
                <Badge variant="high">{c.badge}</Badge>
              </div>
              <p class="body-md mt-3 max-w-3xl text-pretty text-body">{c.blurb}</p>
              <div class="mt-5 grid gap-5 lg:grid-cols-2">
                <div class="min-w-0">
                  <p class="eyebrow !text-error mb-2">Sempre verdadeiro</p>
                  <CodeBlock lang="yaml" filename=".github/workflows/ci.yml" code={c.bad} />
                </div>
                <div class="min-w-0">
                  <p class="eyebrow !text-success mb-2">Corrigido</p>
                  <CodeBlock lang="yaml" filename=".github/workflows/ci.yml" code={c.good} />
                </div>
              </div>
            </article>
          ))
        }

        <div class="grid gap-6 lg:grid-cols-3">
          {
            refs.map((r) => (
              <article class="card-soft min-w-0 p-6">
                <h3 class="display-sm text-balance text-ink">{r.title}</h3>
                <div class="mt-4">
                  <CodeBlock lang="yaml" code={r.code} />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 6) SCOPE NOTE -->
  <section class="bg-canvas-soft">
    <div class="container-page py-12 sm:py-16">
      <div class="card-soft mx-auto max-w-3xl p-6">
        <p class="eyebrow">Fidelidade e escopo</p>
        <p class="body-md mt-3 text-pretty text-body">
          Isto é um <strong class="font-medium text-ink">playground de semântica</strong>, não um runner. Ele
          replica o comportamento documentado de expressões e triggers do <span translate="no">GitHub</span>
          contra um corpus de conformidade versionado (mostrado como o rótulo
          <span class="code-mono text-ink" translate="no">semantics:</span> na ferramenta), mas
          não executa jobs, não busca o conteúdo ao vivo das ações referenciadas, nem calcula um
          <span class="code-mono text-ink" translate="no">hashFiles()</span> real — isso precisa de arquivos que só o
          runner consegue ver, então é exibido como um placeholder. O payload completo de
          <span class="code-mono text-ink" translate="no">github.event</span> é modelado como um
          mock editável que você controla. Trate um resultado limpo como uma forte confiança antes do push, e
          ainda assim combine-o com o <span class="code-mono text-ink" translate="no">actionlint</span> para a sintaxe.
        </p>
      </div>
    </div>
  </section>

  <!-- 7) FAQ -->
  <FaqList faqs={faqs} />

  <!-- Cross-links + disclaimer -->
  <ToolCrossLinks lang={__lang}>
    <Fragment slot="lead">
      O Testador de Expressões do <span translate="no">GitHub</span> Actions é uma ferramenta dentro do
      <span translate="no">{site.name}</span> — uma copa crescente de validadores, conversores e
      testadores baseados em navegador que nunca tocam um servidor.
    </Fragment>
    <Fragment slot="links">
      Ferramentas relacionadas: o
      <a class="link-inline" href={__l('/github-actions-validator', __lang)}>Validador do <span translate="no">GitHub</span>
        Actions</a> e o
      <a class="link-inline" href={__l('/loki-alert-rule-tester', __lang)}><span translate="no">AlertLint</span>, o
        testador de regras do <span translate="no">Loki</span></a>. Explore o
      <a class="link-inline" href={__l(navLinks[0].href, __lang)}>diretório completo de ferramentas</a>.
    </Fragment>
    <Fragment slot="disclaimer">
      Não é afiliado, endossado nem patrocinado pela <span translate="no">GitHub, Inc.</span>
      <span translate="no">GitHub</span> e <span translate="no">GitHub Actions</span> são marcas comerciais da
      <span translate="no">GitHub, Inc.</span>, usadas aqui apenas de forma descritiva para identificar o formato de expressões
      e triggers de workflow que esta ferramenta avalia.
    </Fragment>
  </ToolCrossLinks>
</Shell>
