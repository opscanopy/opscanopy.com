---
/**
 * AlertLint — the AlertLint tool page (primary SEO surface).
 * "promtool for Loki" — paste Loki ruler YAML + a promtool-modeled test file,
 * assert pass/fail, entirely in the browser. No server, no signup.
 *
 * Imports the interactive island (AlertLintPlayground, self-mounting) plus the
 * brand primitives. JSON-LD (SoftwareApplication + FAQPage) is assembled in
 * frontmatter and handed to Shell via the `jsonLd` prop.
 */
import Shell from '../../components/Shell.astro';
import AlertLintPlayground from '../../components/AlertLintPlayground.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ToolHero from '../../components/ToolHero.astro';
import ToolGapVisual from '../../components/ToolGapVisual.astro';
import ToolPipeline from '../../components/ToolPipeline.astro';
import FaqList from '../../components/FaqList.astro';
import ToolCrossLinks from '../../components/ToolCrossLinks.astro';
import { site, navLinks } from '../../data/site';
import { getTool } from '../../data/tools';
import { softwareAppLd, faqPageLd } from '../../lib/jsonld';

const tool = getTool('loki-alert-rule-tester');

const pagePath = '/loki-alert-rule-tester/';
const pageUrl = `${site.url}${__l(pagePath, (Astro.currentLocale ?? 'en') as __Locale)}`;

// ── Loki issue references (the "why it exists" gap) ──────────────────────────
const lokiIssue7655 = 'https://github.com/grafana/loki/issues/7655';
const lokiIssue16659 = 'https://github.com/grafana/loki/issues/16659';

// ── FAQ content — single source for both the rendered section and FAQPage LD ─
const faqs = toolFaqs('loki-alert-rule-tester', 'pt-br');

// ── JSON-LD: SoftwareApplication + FAQPage (shared builders) ─────────────────
const softwareApp = softwareAppLd({
  name: 'AlertLint',
  description:
    'Testador de regras de alerta do Loki: cole o YAML do ruler e logs sintéticos, veja quais alertas disparam. O promtool que falta ao Loki. Grátis, sem cadastro.',
  url: pageUrl,
  subCategory: 'Observability',
  featureList: [
    'Teste unitário de regras de alerta do Loki (LogQL) contra logs sintéticos',
    'Formato de arquivo de testes modelado segundo o promtool',
    'Afirme quais alertas disparam — incluindo os casos negativos',
    '100% no lado do cliente, sem envio de dados, sem cadastro',
  ],
  keywords: tool?.keywords.join(', '),
});

const faqPage = faqPageLd(faqs);

// ── HOW IT WORKS pipeline ────────────────────────────────────────────────────
const pipeline = [
  {
    title: 'Analisa as regras.',
    body: 'O seu YAML do ruler do Loki é analisado em grupos de regras de alerta e de gravação — o mesmo formato que o ruler do Loki carrega.',
  },
  {
    title: 'Analisa o arquivo de testes.',
    body: 'O arquivo de testes modelado segundo o promtool é lido para obter as suas séries de logs de entrada, o intervalo de avaliação e os alertas que você espera.',
  },
  {
    title: 'Monta um armazenamento em memória.',
    body: 'As linhas de logs sintéticos são carregadas em um armazenamento de logs efêmero e no navegador para que as consultas tenham algo para ler.',
  },
  {
    title: 'Avalia o LogQL.',
    body: 'A expressão de cada regra é executada contra o armazenamento no momento de avaliação do teste, produzindo os alertas que disparariam.',
  },
  {
    title: 'Compara com o esperado.',
    body: 'Os alertas reais são comparados com os seus exp_alerts. Qualquer divergência é um caso com falha, informado inline.',
  },
];

// ── Example: Loki ruler rule file ────────────────────────────────────────────
const ruleFileExample = `groups:
  - name: app-errors
    rules:
      - alert: HighErrorRate
        expr: |
          sum(count_over_time({app="checkout"} |= "error" [5m])) > 2
        for: 2m
        labels:
          severity: page
        annotations:
          summary: "Checkout error rate is high"`;

// ── Example: promtool-modeled test file ──────────────────────────────────────
const testFileExample = `tests:
  - interval: 1m
    input_streams:
      - stream:
          app: checkout
        logs:
          - "1m  level=error checkout upstream timeout"
          - "2m  level=error checkout upstream timeout"
          - "3m  level=error checkout upstream timeout"
          - "4m  level=error checkout upstream timeout"
          - "5m  level=error checkout upstream timeout"
          - "6m  level=error checkout upstream timeout"
    alert_rule_test:
      - eval_time: 6m
        alertname: HighErrorRate
        exp_alerts:
          - exp_labels:
              severity: page
            exp_annotations:
              summary: "Checkout error rate is high"

  # Negative case — empty exp_alerts asserts NO alert fires.
  - interval: 1m
    input_streams:
      - stream:
          app: checkout
        logs:
          - "1m  level=info checkout ok"
          - "2m  level=info checkout ok"
    alert_rule_test:
      - eval_time: 6m
        alertname: HighErrorRate
        exp_alerts: []`;

// ── CLI teaser ───────────────────────────────────────────────────────────────
const cliExample = `# Coming soon — the same engine as a CLI
$ alertlint test ./tests/**.yaml

  ✓ app-errors › HighErrorRate (fires)
  ✓ app-errors › HighErrorRate (no-fire on info logs)

  2 passed, 0 failed`;
import type { Locale as __Locale } from '../../i18n/config';
import { localizeKey as __l } from '../../i18n/utils';
import { toolFaqs } from '../../data/tool-faqs';
const __lang = (Astro.currentLocale ?? 'en') as __Locale;

---

<Shell
  title="Testador de regras de alerta do Loki — grátis"
  description="Testador de regras de alerta do Loki: cole o YAML do ruler e logs sintéticos, veja quais alertas disparam. O promtool que falta ao Loki. Grátis, sem cadastro."
  canonical="/loki-alert-rule-tester"
  jsonLd={[softwareApp, faqPage]}
>
  <!-- ════════════════════════════════════════════════════════════════════
       1) HERO — compact, mesh gradient behind
       ════════════════════════════════════════════════════════════════════ -->
  <ToolHero
    eyebrow="AlertLint · Observabilidade"
    badges={[
      { label: 'Sem cadastro', variant: 'neutral' },
      { label: 'Gratuito e aberto', variant: 'neutral' },
    ]}
  >
    <Fragment slot="headline">
      Teste as suas regras de alerta do <span translate="no">Loki</span> antes que disparem em produção.
    </Fragment>
    <Fragment slot="lead">
      O <span translate="no">AlertLint</span> permite testar as regras de alerta do <span translate="no">Loki</span>
      antes da produção: cole as suas regras e logs sintéticos, afirme quais alertas devem disparar
      e obtenha um sucesso ou uma falha, tudo on-line, sem instalar nada nem se cadastrar.
    </Fragment>
  </ToolHero>

  <!-- ════════════════════════════════════════════════════════════════════
       2) THE PLAYGROUND
       ════════════════════════════════════════════════════════════════════ -->
  <section id="playground" class="scroll-mt-24 bg-canvas-soft pt-8 pb-20 sm:pb-24">
    <div class="container-page">
      <h2 class="sr-only">Ambiente de testes do AlertLint</h2>
      <AlertLintPlayground />
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       3) WHY IT EXISTS — the gap
       ════════════════════════════════════════════════════════════════════ -->
  <section id="why" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <p class="eyebrow">A lacuna</p>
          <h2 class="display-lg mt-3 text-balance text-ink">
            O <span translate="no">Loki</span> não tem <span translate="no">promtool</span>, então os
            alertas de <span translate="no">LogQL</span> vão para produção sem teste.
          </h2>
          <ToolGapVisual />
        </div>
        <div class="space-y-4">
          <p class="body-md text-pretty text-body">
            Os engenheiros do <span translate="no">Prometheus</span> vêm entregando regras de alerta testadas há anos com o
            <span class="code-mono text-ink" translate="no">promtool test rules</span>:
            entram amostras sintéticas, sai um sucesso ou uma falha. O <span translate="no">Loki</span> adotou o
            mesmo formato de regras, mas nunca lançou o executor de testes, então os alertas de <span translate="no">LogQL</span>
            têm sido entregues sem testes: a única forma de saber se uma regra disparava era esperar pelo
            tráfego de produção.
          </p>
          <p class="body-md text-pretty text-body">
            A comunidade pede isso há anos — veja no <span translate="no">Loki</span>
            <a
              class="link-inline"
              href={lokiIssue7655}
              target="_blank"
              rel="noopener noreferrer">a issue nº 7655</a
            > e
            <a
              class="link-inline"
              href={lokiIssue16659}
              target="_blank"
              rel="noopener noreferrer">a issue nº 16659</a
            >. O <span translate="no">AlertLint</span> preenche essa lacuna hoje: um testador unitário gratuito e executado no navegador
            para regras de alerta do <span translate="no">Loki</span> que usa o conhecido arquivo de testes
            no estilo do <span translate="no">promtool</span> e roda totalmente no lado do cliente.
          </p>
          <p class="body-sm text-mute">
            Não conhece o formato? Vá direto para <a class="link-inline" href="#formats">os dois arquivos</a> ou
            experimente o <a class="link-inline" href="#playground">ambiente de testes ao vivo</a> acima.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       4) HOW IT WORKS — numbered pipeline
       ════════════════════════════════════════════════════════════════════ -->
  <ToolPipeline
    id="how-it-works"
    eyebrow="O processo"
    heading="Como testar uma regra de alerta do Loki no navegador."
    lead="Cinco passos determinísticos rodam de ponta a ponta a cada toque em Executar — tudo dentro da aba do seu navegador, todas as vezes."
    steps={pipeline}
  />

  <!-- ════════════════════════════════════════════════════════════════════
       5) FORMATS — rule file + test file docs
       ════════════════════════════════════════════════════════════════════ -->
  <section id="formats" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Formatos de arquivo</p>
        <h2 class="display-lg mt-3 text-ink">Dois arquivos, ambos familiares.</h2>
        <p class="body-md mx-auto mt-3 max-w-xl text-pretty text-body">
          O <span translate="no">AlertLint</span> lê exatamente duas entradas: o seu
          YAML do ruler do <span translate="no">Loki</span> e um arquivo de testes modelado segundo o <span translate="no">promtool</span>.
          Se você já escreveu algum deles para o <span translate="no">Prometheus</span> ou o
          <span translate="no">Loki</span>, vão parecer familiares.
        </p>
      </div>

      <div class="mx-auto mt-10 grid max-w-5xl gap-8 lg:grid-cols-2">
        <div class="min-w-0">
          <h3 class="display-sm text-ink">O arquivo de regras</h3>
          <p class="body-sm mt-2 mb-4 text-pretty text-body">
            YAML padrão do ruler do <span translate="no">Loki</span>:
            <span class="code-mono text-ink" translate="no">groups</span> de regras de alerta e de gravação,
            cada uma com uma <span class="code-mono text-ink" translate="no">expr</span> de <span translate="no">LogQL</span>, uma duração
            <span class="code-mono text-ink" translate="no">for</span> opcional e
            <span class="code-mono text-ink" translate="no">labels</span> /
            <span class="code-mono text-ink" translate="no">annotations</span>. É o mesmo
            arquivo que o seu ruler já carrega.
          </p>
          <CodeBlock lang="yaml" filename="rules.yaml" code={ruleFileExample} />
        </div>

        <div class="min-w-0">
          <h3 class="display-sm text-ink">O arquivo de testes</h3>
          <p class="body-sm mt-2 mb-4 text-pretty text-body">
            Modelado segundo o <span translate="no">promtool</span>:
            <span class="code-mono text-ink" translate="no">input_streams</span> de fluxos de logs
            sintéticos, um <span class="code-mono text-ink" translate="no">interval</span> de avaliação
            e um <span class="code-mono text-ink" translate="no">alert_rule_test</span> que enumera
            os alertas que você espera. Um
            <span class="code-mono text-ink" translate="no">exp_alerts: []</span> vazio afirma que
            <em>nenhum</em> alerta dispara.
          </p>
          <CodeBlock lang="yaml" filename="tests.yaml" code={testFileExample} />
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       6) CLI TEASER — polarity-flipped dark band
       ════════════════════════════════════════════════════════════════════ -->
  <section id="cli" class="scroll-mt-24 bg-inverse text-inverse-fg">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto grid max-w-5xl items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="min-w-0">
          <p class="eyebrow !text-cyan">Em breve</p>
          <h2 class="display-lg mt-3 text-balance text-inverse-fg">Rode as mesmas verificações na CI.</h2>
          <p class="body-md mt-4 text-pretty text-white/70">
            O motor do navegador é o primeiro passo. Uma CLI pronta para uso vai rodar as mesmas asserções sobre um
            glob de arquivos de testes no seu pipeline, de modo que um alerta quebrado faça a build falhar em vez de te acordar
            às 3 da manhã.
          </p>
          <p class="body-sm mt-4 text-pretty text-white/55">
            Uma Action própria do <span translate="no">GitHub</span> que encapsula a CLI também está planejada
            junto dela. Ambas chegam em breve — o testador no navegador acima já funciona hoje.
          </p>
        </div>
        <CodeBlock lang="bash" filename="ci.sh" code={cliExample} />
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       7) LOGQL SUPPORT — what the preview engine evaluates
       ════════════════════════════════════════════════════════════════════ -->
  <section id="logql-support" class="scroll-mt-24 bg-canvas-soft">
    <div class="container-page py-12 sm:py-16">
      <div class="card-soft mx-auto max-w-3xl p-6">
        <p class="eyebrow">Motor em versão preliminar</p>
        <h2 class="display-sm mt-3 text-ink">
          Qual <span translate="no">LogQL</span> o avaliador no navegador suporta.
        </h2>
        <p class="body-md mt-3 text-pretty text-body">
          O avaliador cobre o <span translate="no">LogQL</span> em que as regras de alerta e de
          gravação são realmente escritas: seletores de fluxo com os comparadores de rótulos
          <span class="code-mono text-ink" translate="no">=</span>,
          <span class="code-mono text-ink" translate="no">!=</span>,
          <span class="code-mono text-ink" translate="no">=~</span> e
          <span class="code-mono text-ink" translate="no">!~</span>, os quatro filtros de linha
          (<span class="code-mono text-ink" translate="no">|=</span>,
          <span class="code-mono text-ink" translate="no">!=</span>,
          <span class="code-mono text-ink" translate="no">|~</span>,
          <span class="code-mono text-ink" translate="no">!~</span>),
          <span class="code-mono text-ink" translate="no">count_over_time</span> e
          <span class="code-mono text-ink" translate="no">rate</span> sobre um intervalo de tempo,
          <span class="code-mono text-ink" translate="no">sum</span> e
          <span class="code-mono text-ink" translate="no">sum by (…)</span>, e uma comparação de
          limite. Tudo o que estiver fora desse subconjunto é informado como erro em vez de
          adivinhado, e a janela <span class="code-mono text-ink" translate="no">for:</span> de uma
          regra é respeitada — a expressão é reavaliada a cada
          <span class="code-mono text-ink" translate="no">interval</span> do teste ao longo de toda
          a janela de espera e todas as avaliações precisam disparar, de modo que uma regra que
          ainda estaria em Pending nunca é informada como Firing.
        </p>
        <p class="body-md mt-4 text-pretty text-body">
          Uma observação sobre a precisão: isto é um <strong class="font-medium text-ink"
            >motor em versão preliminar</strong
          >. Em breve chegará uma build de paridade total que compila o motor de consultas oficial
          do <span translate="no">Loki</span> para WebAssembly. Até lá, considere uma execução em
          verde como uma forte confiança prévia à implantação, e não como uma reprodução de
          produção byte a byte.
        </p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       8) FAQ
       ════════════════════════════════════════════════════════════════════ -->
  <FaqList faqs={faqs} />

  <!-- ════════════════════════════════════════════════════════════════════
       Cross-links + footer disclaimer
       ════════════════════════════════════════════════════════════════════ -->
  <ToolCrossLinks lang={__lang}>
    <Fragment slot="lead">
      O <span translate="no">AlertLint</span> é mais uma ferramenta do
      <span translate="no">{site.name}</span>: uma cobertura crescente de validadores, conversores
      e testadores baseados no navegador que nunca tocam um servidor.
    </Fragment>
    <Fragment slot="links">
      Combine-o com o já disponível
      <a class="link-inline" href={__l("/cve-ignore-converter", __lang)}>conversor de ignorados de <span translate="no">CVE</span></a> e o
      <a class="link-inline" href={__l("/github-actions-validator", __lang)}>validador do <span translate="no">GitHub</span>
        Actions</a>, ou explore o
      <a class="link-inline" href={__l(navLinks[0].href, __lang)}>diretório completo de ferramentas</a>.
    </Fragment>
    <Fragment slot="disclaimer">
      Não é afiliado nem endossado pela <span translate="no">Grafana Labs</span>.
      <span translate="no">Loki</span> e <span translate="no">Grafana</span> são marcas registradas da
      <span translate="no">Raintank, Inc.</span>
    </Fragment>
  </ToolCrossLinks>
</Shell>
