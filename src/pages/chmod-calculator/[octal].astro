---
/**
 * chmod variant pages (/chmod-calculator/777/ …) — one per entry in
 * src/data/variants/chmod.ts. The playground is server-rendered with the
 * variant's octal; the prose and FAQs come from the data module. 777/755/600/700
 * also have locale copies (chmod.i18n.ts), listed in hreflang. Slimmer than the parent: no pipeline, no numbered figures, no SoftwareApp LD.
 */
import Shell from '../../components/Shell.astro';
import ChmodCalculatorPlayground from '../../components/ChmodCalculatorPlayground.astro';
import ToolHero from '../../components/ToolHero.astro';
import ToolLede from '../../components/ToolLede.astro';
import FaqList from '../../components/FaqList.astro';
import ToolCrossLinks from '../../components/ToolCrossLinks.astro';
import { site, navLinks } from '../../data/site';
import { faqPageLd } from '../../lib/jsonld';
import { toolOgImage } from '../../lib/tool-og';
import { inlineCode } from '../../lib/inline-code';
import { chmodVariants } from '../../data/variants/chmod';
import { variantPaths, siblings, type ToolVariant } from '../../data/variants';
import { localesFor } from '../../data/variants/chmod.i18n';

export const getStaticPaths = () => variantPaths(chmodVariants, 'octal');

const { variant: v } = Astro.props as { variant: ToolVariant };
const href = `/chmod-calculator/${v.slug}/`;
const others = siblings(chmodVariants, v.slug);
---

<Shell
  title={v.title}
  description={v.description}
  canonical={`/chmod-calculator/${v.slug}`}
  availableLocales={['en', ...localesFor(v.slug)]}
  image={toolOgImage('/chmod-calculator/')}
  jsonLd={[faqPageLd(v.faqs)]}
>
  <ToolHero slug="chmod-calculator" h1Name={v.h1Name} leaf={{ name: v.h1Name, href }}>
    <Fragment slot="headline">{v.headline}</Fragment>
  </ToolHero>

  <section id="playground" class="scroll-mt-24 bg-canvas-soft pt-8 pb-20 sm:pb-24">
    <div class="container-page">
      <h2 class="sr-only">chmod calculator playground</h2>
      <ChmodCalculatorPlayground seed={v.input} />
      <ToolLede>{v.lede}</ToolLede>
    </div>
  </section>

  <section id="about" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="measure-prose space-y-10">
        {
          v.sections.map((s) => (
            <div class="space-y-4">
              <h2 class="display-sm text-balance text-ink">{s.heading}</h2>
              {s.paragraphs.map((p) => (
                <p class="body-md text-pretty text-body" set:html={inlineCode(p)} />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="related" class="scroll-mt-24 border-t border-hairline bg-canvas-soft">
    <div class="container-page py-12 sm:py-16">
      <h2 class="display-sm text-ink">Other common modes</h2>
      <p class="body-md measure-prose mt-3 text-pretty text-body">
        Back to the full <a class="link-inline" href="/chmod-calculator/">chmod Calculator</a>, or
        open another mode:
      </p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {
          others.map((o) => (
            <li>
              <a class="chip" href={`/chmod-calculator/${o.slug}/`} translate="no">
                {o.h1Name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <FaqList faqs={v.faqs} align="left" />

  <ToolCrossLinks slug="chmod-calculator">
    <Fragment slot="lead">
      The chmod Calculator is one tool in
      <span translate="no">{site.name}</span> — a growing canopy of browser-based validators,
      converters and testers that never touch a server.
    </Fragment>
    <Fragment slot="links">
      Related utilities: the
      <a class="link-inline" href="/uuid-ulid-generator/">UUID / ULID Generator</a>, the
      <a class="link-inline" href="/case-converter/">Case Converter</a> and the
      <a class="link-inline" href="/slugify/">Slugify</a> tool — or browse the full
      <a class="link-inline" href={`${navLinks[0].href}/`}>tools directory</a>.
    </Fragment>
    <Fragment slot="disclaimer">
      Provided as-is for convenience; always double-check permission changes on production systems.
      <span translate="no">{site.name}</span> is free and open.
    </Fragment>
  </ToolCrossLinks>
</Shell>
