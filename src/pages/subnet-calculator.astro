---
/**
 * Subnet Calculator — the subnet-calculator tool page (SEO surface).
 * Enter an IPv4/IPv6 address with a prefix; get network, broadcast, mask,
 * wildcard, host range and address counts — entirely in the browser.
 */
import Shell from '../components/Shell.astro';
import SubnetCalculatorPlayground from '../components/SubnetCalculatorPlayground.astro';
import SubnetVerifyPanel from '../components/SubnetVerifyPanel.astro';
import Button from '../components/Button.astro';
import CodeBlock from '../components/CodeBlock.astro';
import ToolHero from '../components/ToolHero.astro';
import ToolGapVisual from '../components/ToolGapVisual.astro';
import ToolPipeline from '../components/ToolPipeline.astro';
import FaqList from '../components/FaqList.astro';
import ToolCrossLinks from '../components/ToolCrossLinks.astro';
import { site, navLinks } from '../data/site';
import { getTool } from '../data/tools';
import { softwareAppLd, faqPageLd } from '../lib/jsonld';
import { toolFaqs } from '../data/tool-faqs';

const tool = getTool('subnet-calculator');
const pagePath = '/subnet-calculator/';
const pageUrl = `${site.url}${pagePath}`;

const faqs = toolFaqs('subnet-calculator');

const softwareApp = softwareAppLd({
  name: 'Subnet Calculator',
  description:
    'Free subnet calculator: enter any IPv4/IPv6 CIDR for network, broadcast, netmask, wildcard, usable host range and counts. 100% in-browser, no signup.',
  url: pageUrl,
  subCategory: 'Networking',
  featureList: [
    'Calculate network and broadcast addresses from a CIDR',
    'Show netmask, wildcard mask and usable host range',
    'Accepts dotted netmask input (192.168.1.0 255.255.255.0)',
    'IPv4 and full 128-bit IPv6 support',
    '100% client-side, no upload, no signup',
  ],
  keywords: tool?.keywords.join(', '),
});
const faqPage = faqPageLd(faqs);

const pipeline = [
  {
    title: 'Parse the address.',
    body: 'The address is split from its /prefix — or its dotted netmask is converted to one — and read as a 32-bit IPv4 or 128-bit IPv6 number.',
  },
  {
    title: 'Build the mask.',
    body: 'The prefix becomes a contiguous netmask; its complement is the wildcard mask used by ACLs.',
  },
  {
    title: 'Derive the bounds.',
    body: 'Masking yields the network address; setting the host bits yields the broadcast / last address.',
  },
  {
    title: 'Count the hosts.',
    body: 'The host bits fix the total and usable counts, with /31 and /32 handled as special cases.',
  },
];

const prefixTable = `prefix   addresses     usable      typical use
/30      4             2           point-to-point link
/29      8             6           tiny subnet
/28      16            14
/27      32            30
/26      64            62
/25      128           126
/24      256           254         a classic LAN
/23      512           510
/22      1,024         1,022
/16      65,536        65,534
/8       16,777,216    16,777,214  a large private block`;

const ipv6Example = `2001:db8::/48
  network   2001:db8::
  last      2001:db8:0:ffff:ffff:ffff:ffff:ffff
  subnets   65,536  /64s
  addresses 2^80   per /48`;
---

<Shell
  title="Subnet Calculator — Free IPv4 & IPv6 CIDR / Netmask Tool"
  description="Free subnet calculator: enter any IPv4/IPv6 CIDR for network, broadcast, netmask, wildcard, usable host range and counts. 100% in-browser, no signup."
  canonical="/subnet-calculator"
  jsonLd={[softwareApp, faqPage]}
>
  <ToolHero
    slug="subnet-calculator"
    eyebrow="Subnet Calculator · Networking"
    badges={[
      { label: 'IPv4 & IPv6', variant: 'neutral' },
      { label: 'No signup', variant: 'neutral' },
    ]}
  >
    <Fragment slot="headline">Subnet any IPv4 or IPv6 block at a glance.</Fragment>
    <Fragment slot="lead">
      Enter any IPv4 or IPv6 address with a CIDR prefix like
      <span class="code-mono text-ink" translate="no">192.168.1.0/24</span> — or an address plus
      netmask like <span class="code-mono text-ink" translate="no">192.168.1.0 255.255.255.0</span>
      — to get the network address, broadcast address, netmask, wildcard mask, usable host range
      and address counts — all computed in your browser, no signup required.
    </Fragment>
  </ToolHero>

  <section id="playground" class="scroll-mt-24 bg-canvas-soft pt-8 pb-20 sm:pb-24">
    <div class="container-page">
      <h2 class="sr-only">Subnet Calculator playground</h2>
      <SubnetCalculatorPlayground />
      <SubnetVerifyPanel />
    </div>
  </section>

  <section id="why" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <p class="eyebrow">The Gap</p>
          <h2 class="display-lg mt-3 text-balance text-ink">
            One off-by-one bit, a whole wrong network.
          </h2>
          <ToolGapVisual />
        </div>
        <div class="space-y-4">
          <p class="body-md text-pretty text-body">
            Subnetting is mental binary arithmetic done under pressure — and the failure mode is
            silent. Pick the wrong prefix and your firewall rule covers the wrong hosts, your route
            blackholes traffic, or two networks quietly overlap. The maths is simple but unforgiving.
          </p>
          <p class="body-md text-pretty text-body">
            This free subnet calculator turns a CIDR into the concrete facts you actually need —
            network address, broadcast address, netmask, wildcard and the exact usable host range —
            for IPv4 and IPv6 alike, so you can confirm a block before it lands in a config.
            Entirely in-browser, with nothing to install and no data ever leaving your device.
          </p>
          <p class="body-md text-pretty text-body">
            Asking an AI for subnet maths is the risky shortcut: a language model generates
            likely-looking numbers, and an off-by-one broadcast address reads exactly like the right
            one. This calculator computes the real bit boundaries with exact BigInt arithmetic —
            numbers you can verify an AI&rsquo;s answer against, not more plausible text.
          </p>
          <p class="body-sm text-mute">
            Working with a list of blocks? Try the
            <a class="link-inline" href="/cidr-checker/">CIDR / Subnet Checker</a> to aggregate them
            and find overlaps.
          </p>
        </div>
      </div>
    </div>
  </section>

  <ToolPipeline
    id="how-it-works"
    eyebrow="The Pipeline"
    heading="How it works."
    lead="Four deterministic steps run on every keystroke — all inside your browser tab, with exact BigInt arithmetic."
    steps={pipeline}
  />

  <section id="reference" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Prefix Reference</p>
        <h2 class="display-lg mt-3 text-ink">How big is each prefix?</h2>
        <p class="body-md mx-auto mt-3 max-w-xl text-pretty text-body">
          Each bit added to the prefix halves the block. A quick reference for the common IPv4
          prefixes, and how an IPv6 site prefix breaks down.
        </p>
      </div>
      <div class="mx-auto mt-10 grid max-w-5xl gap-8 lg:grid-cols-2">
        <div class="min-w-0">
          <h3 class="display-sm text-ink">IPv4 prefixes</h3>
          <p class="body-sm mt-2 mb-4 text-pretty text-body">
            Total addresses are <span class="code-mono text-ink" translate="no">2^(32 − prefix)</span>;
            usable is total minus the network and broadcast.
          </p>
          <CodeBlock lang="text" filename="ipv4-prefixes" code={prefixTable} />
        </div>
        <div class="min-w-0">
          <h3 class="display-sm text-ink">An IPv6 prefix</h3>
          <p class="body-sm mt-2 mb-4 text-pretty text-body">
            IPv6 has no broadcast; the whole range is addressable. A site
            <span class="code-mono text-ink" translate="no">/48</span> holds 65,536 of the standard
            <span class="code-mono text-ink" translate="no">/64</span> subnets.
          </p>
          <CodeBlock lang="text" filename="ipv6-48" code={ipv6Example} />
        </div>
      </div>
    </div>
  </section>

  <section id="next" class="scroll-mt-24 bg-inverse text-inverse-fg">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto grid max-w-5xl items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <div class="min-w-0">
          <p class="eyebrow !text-cyan">Next Step</p>
          <h2 class="display-lg mt-3 text-balance text-inverse-fg">
            Got a list of subnets? Check them for overlaps.
          </h2>
          <p class="body-md mt-4 text-pretty text-white/70">
            Once individual blocks read correctly, the
            <span translate="no">CIDR / Subnet Checker</span> takes a whole list and finds overlaps
            and containment, then aggregates everything into the minimal covering set — handy before
            you write a firewall rule or a route table.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <Button href="/cidr-checker/" variant="secondary">Open the CIDR Checker</Button>
          </div>
        </div>
        <CodeBlock
          lang="text"
          filename="aggregate.txt"
          code={`192.168.0.0/24
192.168.1.0/24   →  192.168.0.0/22
192.168.2.0/24
192.168.3.0/24`}
        />
      </div>
    </div>
  </section>

  <FaqList faqs={faqs} />

  <div class="container-page py-4">
    <p class="body-sm text-mute">New to this? Read our guide on <a href="/learn/guides/networking-for-devops/" class="link-inline">Networking for DevOps Engineers</a>.</p>
  </div>

  <ToolCrossLinks slug="subnet-calculator">
    <Fragment slot="lead">
      The Subnet Calculator is one tool in
      <span translate="no">{site.name}</span> — a growing canopy of browser-based validators,
      converters and testers that never touch a server.
    </Fragment>
    <Fragment slot="links">
      More networking: the
      <a class="link-inline" href="/ip-address-converter/">IP Address Converter</a>, the
      <a class="link-inline" href="/cidr-checker/">CIDR / Subnet Checker</a> and the
      <a class="link-inline" href="/subnet-splitter/">Subnet Splitter</a>, or browse the full
      <a class="link-inline" href={`${navLinks[0].href}/`}>tools directory</a>.
    </Fragment>
    <Fragment slot="disclaimer">
      Provided as-is for convenience; always confirm critical network changes against your own
      authority. <span translate="no">{site.name}</span> is free and open.
    </Fragment>
  </ToolCrossLinks>
</Shell>
