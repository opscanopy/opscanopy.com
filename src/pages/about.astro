---
/**
 * /about — About OpsCanopy. Content is data-driven from src/i18n/pages and
 * localized by the active locale; localized copies live under
 * src/pages/<locale>/about.astro.
 */
import Shell from '../components/Shell.astro';
import InfoPage from '../components/page/InfoPage.astro';
import { getPagesContent } from '../i18n/pages';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import { site } from '../data/site';

const lang = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE;
const t = useTranslations(lang);
const content = getPagesContent(lang);
const doc = content.about;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: doc.metaTitle,
  description: doc.description,
  url: `${site.url}/about/`,
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
};
---

<Shell
  title={doc.metaTitle}
  description={doc.description}
  canonical="/about"
  jsonLd={jsonLd}
>
  <InfoPage doc={doc} lang={lang} updatedLabel={content.ui.updatedLabel}>
    {/* PWA install — revealed by Layout's install script; sits in the page's
        links row so the About actions share one row and one rail. */}
    <button slot="links" type="button" data-install-cta class="btn btn-secondary" style="touch-action: manipulation;" hidden>
      {t('install.appCta')}
    </button>
  </InfoPage>
</Shell>
