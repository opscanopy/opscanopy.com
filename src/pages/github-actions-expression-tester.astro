---
/**
 * GitHub Actions Expression & Trigger Tester — the primary SEO surface.
 *
 * Two client-side tools on one page: an expression evaluator that replicates
 * GitHub's exact ${{ }} semantics (and warns on the always-true literal footgun,
 * actions/runner#1173), and a trigger simulator that decides per-job RUNS/SKIPPED
 * for a push / pull_request / tag event. 100% in-browser — no server, no signup.
 *
 * Mirrors the github-actions-validator page structure (hero, playground island,
 * why/cheat-sheet docs, scope note, FAQ + JSON-LD, cross-links).
 */
import Shell from '../components/Shell.astro';
import GithubActionsExpressionPlayground from '../components/GithubActionsExpressionPlayground.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Badge from '../components/Badge.astro';
import ToolHero from '../components/ToolHero.astro';
import ToolGapVisual from '../components/ToolGapVisual.astro';
import ToolPipeline from '../components/ToolPipeline.astro';
import FaqList from '../components/FaqList.astro';
import ToolCrossLinks from '../components/ToolCrossLinks.astro';
import { site, navLinks } from '../data/site';
import { getTool } from '../data/tools';
import { softwareAppLd, faqPageLd } from '../lib/jsonld';
import { toolFaqs } from '../data/tool-faqs';

const tool = getTool('github-actions-expression-tester');

const pagePath = '/github-actions-expression-tester/';
const pageUrl = `${site.url}${pagePath}`;

// Literal token kept out of Astro's `{}` expression parser.
const EXPR = '${{ }}';

// ── External references ──────────────────────────────────────────────────────
const ghExpressions = 'https://docs.github.com/actions/learn-github-actions/expressions';
const ghTriggers =
  'https://docs.github.com/actions/using-workflows/events-that-trigger-workflows';
const ghIssue1173 = 'https://github.com/actions/runner/issues/1173';

// ── FAQ content — single source for both the rendered section and FAQPage LD ─
const faqs = toolFaqs('github-actions-expression-tester');

// ── JSON-LD ──────────────────────────────────────────────────────────────────
const softwareApp = softwareAppLd({
  name: 'GitHub Actions Expression & Trigger Tester',
  description:
    'Test a GitHub Actions if: condition without pushing — evaluate ${{ }} expressions against a mock github/env/matrix/steps/needs context, catch the always-true literal footgun, and simulate which jobs run for a push, PR or tag. Free, 100% in-browser.',
  url: pageUrl,
  subCategory: 'CI/CD',
  featureList: [
    "Evaluate ${{ }} expressions against an editable mock github/env/matrix/steps/needs context with GitHub's exact operator and coercion semantics",
    'Warns on the literal-text "always true" if: footgun (actions/runner#1173)',
    'Supports contains, startsWith, endsWith, format, join, toJSON, fromJSON, hashFiles, success(), failure(), always(), cancelled()',
    'Trigger Simulator: describe a push, pull_request or tag event and see which jobs RUN or are SKIPPED with the deciding reason',
    'Faithful glob engine for branches, tags, paths and paths-ignore including branch+path AND-semantics',
    '100% client-side: your workflow YAML and event payloads never leave the browser',
  ],
  keywords: tool?.keywords.join(', '),
});
const faqPage = faqPageLd(faqs);

// ── HOW IT WORKS pipeline ─────────────────────────────────────────────────────
const pipeline = [
  {
    title: 'Pick a tab.',
    body: 'Evaluate a single if: / expression, or switch to the trigger simulator to test a whole workflow against an event.',
  },
  {
    title: 'Set the context.',
    body: 'Edit the mock github/env/matrix/steps/needs JSON (or describe the event: type, ref, changed files) so it matches the run you care about.',
  },
  {
    title: 'Parse with GitHub’s grammar.',
    body: 'The expression is tokenised and parsed with the same operator precedence and function set the runner uses — no shell-out, no network.',
  },
  {
    title: 'Apply the exact semantics.',
    body: 'Coercion, case-insensitive equality, operand-returning && / ||, glob filters and the branch+path AND-rule are replicated against a versioned conformance corpus.',
  },
  {
    title: 'Show the verdict + why.',
    body: 'You get the truthy/falsy result and returned value, the always-true footgun warning where it applies, and a per-job RUNS/SKIPPED table with the deciding reason.',
  },
];

// ── CHEAT-SHEET cards ─────────────────────────────────────────────────────────
const footgunBad = `# ALWAYS TRUE — operators sit OUTSIDE \${{ }}
jobs:
  deploy:
    if: \${{ github.ref }} == 'refs/heads/main'
    # after substitution this is the literal string
    #   refs/heads/main == 'refs/heads/main'
    # a non-empty string => truthy => runs on EVERY branch`;
const footgunGood = `# CORRECT — wrap the WHOLE condition in one \${{ }}
jobs:
  deploy:
    if: \${{ github.ref == 'refs/heads/main' }}
    # now GitHub evaluates the comparison, not a literal string`;

const coercionExample = `# GitHub's coercion is JS-like and case-insensitive:
\${{ 'ABC' == 'abc' }}      # true  (strings compare case-insensitively)
\${{ null == 0 }}           # true  (both coerce to the number 0)
\${{ '' || 'fallback' }}    # 'fallback'  (|| returns an OPERAND, not a bool)
\${{ github.x && 'yes' }}   # 'yes' when github.x is truthy
\${{ 'true' == true }}      # false (string 'true' coerces to NaN)`;

const functionsExample = `\${{ contains('refs/heads/main', 'main') }}     # true (substring, case-insensitive)
\${{ startsWith(github.ref, 'refs/tags/') }}    # is this a tag push?
\${{ format('{0}-{1}', 'app', github.sha) }}    # 'app-d6cd1e2…'
\${{ fromJSON('["a","b"]') }}                   # a real array
\${{ always() }}  \${{ success() }}  \${{ failure() }}  # status checks`;

const triggerExample = `on:
  push:
    branches: [main]      # AND
    paths: ['src/**']     # — both must match to trigger
# feature/* matches feature/a but NOT feature/a/b
# feature/** matches both (** crosses '/')`;

const cheats = [
  {
    title: 'The “always true” footgun',
    badge: 'Most common',
    blurb:
      'GitHub only evaluates what is inside ${{ }}. Operators left outside become literal text after substitution — a non-empty string, which is always truthy. The evaluator flags this (actions/runner#1173).',
    bad: footgunBad,
    good: footgunGood,
  },
];

const refs = [
  { title: 'Operators & coercion', code: coercionExample },
  { title: 'Functions', code: functionsExample },
  { title: 'Triggers, branches & paths', code: triggerExample },
];
---

<Shell
  title="GitHub Actions if Condition Tester & Triggers"
  description="Test a GitHub Actions if condition in your browser: evaluate ${{ }} against a mock context, catch the always-true footgun, and see which jobs run."
  canonical="/github-actions-expression-tester"
  jsonLd={[softwareApp, faqPage]}
>
  <!-- 1) HERO -->
  <ToolHero
    slug="github-actions-expression-tester"
    eyebrow="GitHub Actions Expression Tester · CI/CD"
    badges={[
      { label: 'No signup', variant: 'neutral' },
      { label: 'Exact GitHub semantics', variant: 'neutral' },
    ]}
  >
    <Fragment slot="headline">
      Test your <span translate="no">if:</span> conditions and triggers before you push.
    </Fragment>
    <Fragment slot="lead">
      Evaluate <span class="code-mono text-ink" translate="no">{EXPR}</span> expressions against an
      editable mock context, catch the <span translate="no">if:</span> that is silently
      <em>always true</em>, and simulate which jobs run for a push, PR or tag — instantly, in your
      browser. No <span translate="no">commit-push-pray</span> loop.
    </Fragment>
  </ToolHero>

  <!-- 2) PLAYGROUND -->
  <section id="playground" class="scroll-mt-24 bg-canvas-soft pb-20 pt-8 sm:pb-24">
    <div class="container-page">
      <h2 class="sr-only">GitHub Actions if condition tester and trigger playground</h2>
      <GithubActionsExpressionPlayground />
    </div>
  </section>

  <!-- 3) WHY IT EXISTS -->
  <section id="why" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <p class="eyebrow">The Gap</p>
          <h2 class="display-lg mt-3 text-balance text-ink">
            Why your GitHub Actions <span translate="no">if:</span> condition is always true.
          </h2>
          <ToolGapVisual />
        </div>
        <div class="space-y-4">
          <p class="body-md text-pretty text-body">
            Everyone has done it: add an <span class="code-mono text-ink" translate="no">if:</span> to a
            step, push, watch it run when it shouldn’t, tweak, push again — twenty dummy commits later
            you find the condition was a literal string the whole time. GitHub only evaluates what is
            inside <span class="code-mono text-ink" translate="no">{EXPR}</span>; anything outside is
            literal text, and a non-empty string is always truthy.
          </p>
          <p class="body-md text-pretty text-body">
            The trigger side is just as opaque: a workflow that doesn’t run produces
            <strong class="font-medium text-ink">no output at all</strong> — the decision happens in
            GitHub’s event filtering before any runner starts. Branch and path filters combine with
            <span class="code-mono text-ink" translate="no">AND</span>, tag pushes are excluded when you
            set <span class="code-mono text-ink" translate="no">branches</span> but not
            <span class="code-mono text-ink" translate="no">tags</span>, and
            <span class="code-mono text-ink" translate="no">**</span> behaves differently from
            <span class="code-mono text-ink" translate="no">*</span>.
          </p>
          <p class="body-md text-pretty text-body">
            This tool evaluates both — a single expression, or a whole workflow against an event — using
            <span translate="no">GitHub</span>’s exact rules, so you get the answer in the browser. See
            <span translate="no">GitHub</span>’s
            <a class="link-inline" href={ghExpressions} target="_blank" rel="noopener noreferrer">expressions</a>
            and
            <a class="link-inline" href={ghTriggers} target="_blank" rel="noopener noreferrer">workflow-trigger</a>
            docs, and the
            <a class="link-inline" href={ghIssue1173} target="_blank" rel="noopener noreferrer">always-true footgun</a> issue.
          </p>
          <p class="body-sm text-mute">
            Jump to the <a class="link-inline" href="#reference">cheat-sheet</a> or the
            <a class="link-inline" href="#playground">live playground</a> above.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4) HOW IT WORKS -->
  <ToolPipeline
    id="how-it-works"
    eyebrow="The Pipeline"
    heading="How the if: condition tester decides true or false."
    lead="Five deterministic steps run end-to-end on every evaluation — all inside your browser tab, every time."
    steps={pipeline}
  />

  <!-- 5) CHEAT-SHEET -->
  <section id="reference" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Cheat-sheet</p>
        <h2 class="display-lg mt-3 text-ink">
          The <span translate="no">if:</span> and trigger rules that trip people up.
        </h2>
        <p class="body-md mx-auto mt-3 max-w-xl text-pretty text-body">
          The footgun, the coercion surprises, the functions, and the trigger globs — each with a
          runnable example you can paste into the playground.
        </p>
      </div>

      {/* Every `article` below carries min-w-0. Grid items default to
          min-width:auto, so without it an article cannot shrink below the
          min-content width of the CodeBlock inside it, and the whole PAGE gained
          a horizontal scrollbar at 390px (751px against a 390px viewport). The
          inner two-column wrappers already had min-w-0; the outer grid items
          needed it too. */}
      <div class="mx-auto mt-10 grid max-w-5xl gap-6">
        {
          cheats.map((c) => (
            <article class="card-soft min-w-0 p-6 sm:p-7">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <h3 class="display-sm text-balance text-ink">{c.title}</h3>
                <Badge variant="high">{c.badge}</Badge>
              </div>
              <p class="body-md mt-3 max-w-3xl text-pretty text-body">{c.blurb}</p>
              <div class="mt-5 grid gap-5 lg:grid-cols-2">
                <div class="min-w-0">
                  <p class="eyebrow !text-error mb-2">Always true</p>
                  <CodeBlock lang="yaml" filename=".github/workflows/ci.yml" code={c.bad} />
                </div>
                <div class="min-w-0">
                  <p class="eyebrow !text-success mb-2">Fixed</p>
                  <CodeBlock lang="yaml" filename=".github/workflows/ci.yml" code={c.good} />
                </div>
              </div>
            </article>
          ))
        }

        <div class="grid gap-6 lg:grid-cols-3">
          {
            refs.map((r) => (
              <article class="card-soft min-w-0 p-6">
                <h3 class="display-sm text-balance text-ink">{r.title}</h3>
                <div class="mt-4">
                  <CodeBlock lang="yaml" code={r.code} />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 6) SCOPE NOTE -->
  <section class="bg-canvas-soft">
    <div class="container-page py-12 sm:py-16">
      <div class="card-soft mx-auto max-w-3xl p-6">
        <p class="eyebrow">Fidelity & scope</p>
        <p class="body-md mt-3 text-pretty text-body">
          This is a <strong class="font-medium text-ink">semantics playground</strong>, not a runner. It
          replicates <span translate="no">GitHub</span>’s documented expression and trigger behaviour
          against a versioned conformance corpus (shown as the
          <span class="code-mono text-ink" translate="no">semantics:</span> label in the tool), but it
          does not execute jobs, fetch the live contents of referenced actions, or compute a real
          <span class="code-mono text-ink" translate="no">hashFiles()</span> — that needs files only the
          runner can see, so it is shown as a placeholder. The full
          <span class="code-mono text-ink" translate="no">github.event</span> payload is modelled as an
          editable mock you control. Treat a clean result as strong pre-push confidence, and still pair
          it with <span class="code-mono text-ink" translate="no">actionlint</span> for syntax.
        </p>
      </div>
    </div>
  </section>

  <!-- 7) FAQ -->
  <FaqList faqs={faqs} />

  <!-- Cross-links + disclaimer -->
  <ToolCrossLinks slug="github-actions-expression-tester">
    <Fragment slot="lead">
      The <span translate="no">GitHub</span> Actions Expression Tester is one tool in
      <span translate="no">{site.name}</span> — a growing canopy of browser-based validators, converters
      and testers that never touch a server.
    </Fragment>
    <Fragment slot="links">
      Related tools: the
      <a class="link-inline" href="/github-actions-validator/"><span translate="no">GitHub</span> Actions
        Validator</a>, the
      <a class="link-inline" href="/gitlab-ci-validator/"><span translate="no">GitLab</span> CI Validator</a>,
      and <a class="link-inline" href="/loki-alert-rule-tester/"><span translate="no">AlertLint</span>, the
        <span translate="no">Loki</span> rule tester</a>. Since
      <span class="code-mono text-ink" translate="no">on: schedule</span> triggers use cron syntax, try the
      <a class="link-inline" href="/cron-expression-tester/">Cron Expression Tester</a> too. Browse the full
      <a class="link-inline" href={`${navLinks[0].href}/`}>tools directory</a>.
    </Fragment>
    <Fragment slot="disclaimer">
      Not affiliated with, endorsed by, or sponsored by <span translate="no">GitHub, Inc.</span>
      <span translate="no">GitHub</span> and <span translate="no">GitHub Actions</span> are trademarks of
      <span translate="no">GitHub, Inc.</span>, used here only descriptively to identify the expression
      and workflow-trigger format this tool evaluates.
    </Fragment>
  </ToolCrossLinks>
</Shell>
