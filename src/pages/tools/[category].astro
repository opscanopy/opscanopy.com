---
/**
 * /tools/{category} — static category landing pages.
 *
 * One page per distinct category that has at least one LIVE tool, emitted via
 * getStaticPaths. The URL slug is derived from the category label by
 * categoryToSlug ("CI/CD" → "ci-cd"); slugToCategory resolves it back.
 *
 * Scope: DEFAULT (en) locale only. The /tools catalog has localized
 * /es|/de|/fr|/pt-br variants owned elsewhere, but those use a different
 * (older) filter implementation and are not in this phase's scope. Localized
 * category pages are a documented FOLLOW-UP — emitting them here would require
 * editing the i18n dictionaries this agent does not own. Linking stays within
 * the en tree so i18n is not broken.
 *
 * Each page reuses the shared ToolCard so its grid never drifts from the
 * catalog, and renders a breadcrumb (Home / Tools / {category}) with matching
 * BreadcrumbList JSON-LD plus an ItemList of the category's tools.
 */
import Shell from '../../components/Shell.astro';
import ToolCard from '../../components/ToolCard.astro';
import {
  categories,
  toolsInCategory,
  slugToCategory,
  categoryAccentVar,
  categoryBlurb,
} from '../../data/tools';
import { site } from '../../data/site';
import { breadcrumbLd } from '../../lib/jsonld';
import { categoryIntro } from '../../data/category-copy';

export function getStaticPaths() {
  return categories.map((c) => ({
    params: { category: c.slug },
    props: { category: c.category, count: c.count },
  }));
}

interface Props {
  category: string;
  count: number;
}

const { category, count } = Astro.props;
// Defensive resolve — params win, but props carry the canonical label.
const resolved = slugToCategory(Astro.params.category as string) ?? category;
const slug = (Astro.params.category as string) ?? '';
const tools = toolsInCategory(resolved);
const accent = categoryAccentVar(resolved);
const blurb =
  categoryBlurb[resolved] ??
  `Free, browser-based ${resolved} tools for platform and DevOps engineers — no signup, no servers.`;


/** Long-form body copy for this category (see src/data/category-copy.ts). */
const intro = categoryIntro[resolved] ?? [];

/**
 * `backticks` -> <code>. The copy is authored in this repo and contains no user
 * input, but escape anyway so a future edit cannot turn a stray angle bracket in
 * a config example into markup.
 */
const inlineCode = (text: string): string =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/`([^`]+)`/g, '<code>$1</code>');
const pageUrl = `${site.url}/tools/${slug}/`;

/**
 * Meta-only <title> and description, keyed by category slug. The blurb is the
 * visible lede and the ItemList description, and at 64–111 characters it is
 * too thin for a search snippet, so the head gets its own copy naming the
 * tools this page actually lists. "<Category> tools" stays the leading phrase.
 * Keep each entry in step with the category's live tools in src/data/tools.ts;
 * a category with no entry fails the build rather than shipping a thin title.
 */
const categoryMeta: Record<string, { title: string; description: string }> = {
  networking: {
    title: 'Networking tools — subnet, CIDR & IP calculators online',
    description:
      'Free subnet calculator and splitter, CIDR checker, IP and MAC address converters and a reverse DNS helper — exact IPv4 and IPv6 math in your browser.',
  },
  security: {
    title: 'Security tools — JWT & certificate decoders, hash generator',
    description:
      'Decode JWTs and TLS certificate chains, compute MD5 and SHA-256 hashes, and convert Trivy, Grype and Snyk ignore files — locally, nothing leaves the page.',
  },
  encoding: {
    title: 'Encoding tools — Base64, URL, JSON ↔ YAML & timestamps',
    description:
      'Free Base64 and URL encoders and decoders, a JSON ↔ YAML converter and a Unix timestamp converter. Instant results, all computed in your browser.',
  },
  kubernetes: {
    title: 'Kubernetes tools — resource calculator & selector tester',
    description:
      'Size pod CPU and memory requests and limits, and see which pods a label selector matches and why — free Kubernetes tools that need no cluster access.',
  },
  observability: {
    title: 'Observability tools — PromQL, LogQL & Alertmanager testers',
    description:
      'Explain PromQL, translate LogQL, unit-test Loki alert rules, debug relabeling and Alertmanager routes, and validate Grafana dashboards — free, in-browser.',
  },
  'ci-cd': {
    title: 'CI/CD tools — GitHub Actions & GitLab CI validators',
    description:
      'Validate GitHub Actions workflows and .gitlab-ci.yml pipelines, and evaluate ${{ }} expressions before you push — free CI/CD tools, in your browser.',
  },
  scheduling: {
    title: 'Scheduling tools — cron tester & systemd timer converter',
    description:
      'Test cron expressions and their next run times, convert crontab lines into systemd timers and validate unit files — free, in your browser.',
  },
  logs: {
    title: 'Logs tools — regex log tester & jq playground online',
    description:
      'Test regular expressions against real log lines with live capture groups, and run filters over JSON logs on real jq — free log tools, in your browser.',
  },
  config: {
    title: 'Config tools — .env.example checker for missing env vars',
    description:
      'Find env vars your code reads but .env.example is missing, plus stale keys nothing uses any more — a free config drift checker that runs in your browser.',
  },
  docker: {
    title: 'Docker tools — docker run to Compose & Dockerfile linter',
    description:
      'Convert docker run commands into docker-compose.yml and lint Dockerfiles for unpinned images, baked-in secrets and cache-busting layers — free, in-browser.',
  },
  utilities: {
    title: 'Utilities tools — UUID generator, chmod & case converters',
    description:
      'Generate UUIDs and ULIDs, convert text case, slugify strings, work out chmod permissions and convert data sizes — free developer utilities, client-side.',
  },
  iac: {
    title: 'IaC tools — Terraform & OpenTofu plan summarizer online',
    description:
      'Summarize terraform plan output: adds, changes, destroys and forced replacements counted, destructive actions flagged first. OpenTofu too, in-browser.',
  },
};
const meta = categoryMeta[slug];
if (!meta) {
  throw new Error(
    `[tools/${slug}] no categoryMeta entry — add a meta title and description for "${resolved}" in src/pages/tools/[category].astro`,
  );
}
const title = meta.title;
const description = blurb;

// BreadcrumbList + ItemList JSON-LD for the category page.
const jsonLd = [
  breadcrumbLd([
    { name: 'Home', item: `${site.url}/` },
    { name: 'Tools', item: `${site.url}/tools/` },
    { name: resolved, item: pageUrl },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `OpsCanopy ${resolved} tools`,
    description,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: tools.length,
    itemListElement: tools.map((tool, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: tool.name,
      description: tool.tagline,
      url: `${site.url}/${tool.slug}/`,
    })),
  },
];
---

<Shell title={title} description={meta.description} canonical={`/tools/${slug}/`} jsonLd={jsonLd} noAlternates>
  <!-- ── Header block ─────────────────────────────────────────────────── -->
  <section class="border-b border-hairline bg-canvas-soft">
    <div class="container-page py-8 sm:py-10">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-mute">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href="/" class="transition-colors hover:text-brand">Home</a></li>
          <li aria-hidden="true" class="text-hairline">/</li>
          <li><a href="/tools/" class="transition-colors hover:text-brand">Tools</a></li>
          <li aria-hidden="true" class="text-hairline">/</li>
          <li aria-current="page" class="text-body">{resolved}</li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <div class="flex items-center gap-2">
          <span class="size-2 shrink-0 rounded-full" style={`background-color: ${accent}`} aria-hidden="true"></span>
          <p class="eyebrow">Category</p>
        </div>
        <h1 class="display-lg mt-3 text-balance text-ink">{resolved} tools.</h1>
        <p class="body-md mt-3 max-w-2xl text-pretty text-body">{blurb}</p>
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <span class="badge">
            <span class="size-1.5 rounded-full bg-success" aria-hidden="true"></span>
            <span class="tabular-nums">{count}</span>
            {count === 1 ? 'tool' : 'tools'}
          </span>
          <a href="/tools/" class="link-inline body-sm inline-flex items-center gap-1 font-medium">
            <span aria-hidden="true">&larr;</span>
            All tools
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Category tools ───────────────────────────────────────────────── -->
  <section aria-labelledby="cat-heading" class="bg-canvas">
    <div class="container-page py-16 sm:py-24">
      <h2 id="cat-heading" class="sr-only">{resolved} tools</h2>
      <ul role="list" class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {tools.map((tool, i) => <ToolCard tool={tool} order={i} />)}
      </ul>

      {
        /* Below the grid on purpose: the tools are what the visitor came for, and
           this is the context a grid of cards cannot carry. Every category has an
           entry in categoryIntro, so there is no empty state to design. */
        intro.length > 0 && (
          <div class="mt-16 border-t border-hairline pt-10">
            <h2 class="display-sm text-balance text-ink">
              {/* Not lowercased — it would render "ci/cd" and "iac". */}
              When you reach for {resolved} tools.
            </h2>
            <div class="mt-4 max-w-2xl space-y-4">
              {intro.map((para) => (
                <p class="body-md text-pretty text-body" set:html={inlineCode(para)} />
              ))}
            </div>
          </div>
        )
      }

      <div class="mt-12 border-t border-hairline pt-8">
        <a href="/tools/" class="link-inline body-sm inline-flex items-center gap-1 font-medium">
          <span aria-hidden="true">&larr;</span>
          Back to all tools
        </a>
      </div>
    </div>
  </section>
</Shell>
