---
/**
 * /cheatsheets/ — the cheat-sheet hub. English only (ENGLISH_ONLY_SECTIONS).
 * Lists every non-draft entry of the `cheatsheets` collection by `order`.
 * ItemList only, like /learn/guides/: these are reference pages, not courses.
 */
import { getCollection } from 'astro:content';
import Shell from '../../components/Shell.astro';
import PageHero from '../../components/PageHero.astro';
import { breadcrumbLd, itemListLd } from '../../lib/jsonld';
import { site } from '../../data/site';

const sheets = (await getCollection('cheatsheets', (e) => !e.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const commands = sheets.map((s) => s.data.command);
const commandList = commands.length > 1 ? `${commands.slice(0, -1).join(', ')} and ${commands.at(-1)}` : commands[0];

const canonical = '/cheatsheets';
const jsonLd = [
  breadcrumbLd([
    { name: 'Home', item: `${site.url}/` },
    { name: 'Cheat sheets', item: `${site.url}/cheatsheets/` },
  ]),
  itemListLd(sheets.map((s) => ({ name: s.data.title, url: `${site.url}/cheatsheets/${s.id}/` }))),
];
---

<Shell
  title="DevOps Cheat Sheets — verified command references"
  description={`Dense, verified command references for ${commandList}: the commands you need daily, destructive ones marked, every page sourced from the official docs.`}
  canonical={canonical}
  jsonLd={jsonLd}
  noAlternates
>
  <PageHero variant="hub" eyebrow="Reference" class="bg-canvas-soft">
    DevOps cheat sheets
    <Fragment slot="lede">
      One page per tool, with the commands you actually use grouped by job. Commands that delete
      data are marked, and each page names the version every command was checked against, with
      links to the official documentation it was checked with.
    </Fragment>
  </PageHero>

  <section class="bg-canvas">
    <div class="container-page py-12 sm:py-16">
      <ul role="list" class="measure-wide flex flex-col gap-3">
        {
          sheets.map((s) => (
            <li>
              <a
                href={`/cheatsheets/${s.id}/`}
                class="card-soft flex flex-col gap-2 p-5 transition-colors hover:border-brand"
              >
                <span class="flex flex-wrap items-baseline gap-3">
                  <span class="body-md font-semibold text-ink">{s.data.title}</span>
                  <span class="caption font-mono text-mute">Verified against {s.data.verifiedWith}</span>
                </span>
                <span class="body-sm text-pretty text-body">{s.data.description}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="measure-wide mt-12 flex flex-wrap gap-x-6 gap-y-3 border-t border-hairline pt-8">
        <a href="/learn/" class="link-inline body-sm font-medium">Learn</a>
        <a href="/learn/guides/" class="link-inline body-sm font-medium">Guides</a>
        <a href="/tools/" class="link-inline body-sm font-medium">All tools</a>
      </div>
    </div>
  </section>
</Shell>
