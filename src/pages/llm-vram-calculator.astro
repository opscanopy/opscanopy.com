---
/**
 * LLM VRAM Calculator — the llm-vram-calculator tool page (SEO surface).
 * Pick a model preset or a parameter count, a GGUF quantization and a context
 * length; get the GPU memory split into weights, KV cache and runtime overhead
 * — entirely in the browser.
 */
import Shell from '../components/Shell.astro';
import LlmVramCalculatorPlayground from '../components/LlmVramCalculatorPlayground.astro';
import Button from '../components/Button.astro';
import CodeBlock from '../components/CodeBlock.astro';
import ToolHero from '../components/ToolHero.astro';
import ToolLede from '../components/ToolLede.astro';
import ToolGapVisual from '../components/ToolGapVisual.astro';
import ToolPipeline from '../components/ToolPipeline.astro';
import FaqList from '../components/FaqList.astro';
import ToolCrossLinks from '../components/ToolCrossLinks.astro';
import { site, navLinks } from '../data/site';
import { getTool } from '../data/tools';
import { softwareAppLd, faqPageLd } from '../lib/jsonld';
import { toolFaqs } from '../data/tool-faqs';

const tool = getTool('llm-vram-calculator');
const pagePath = '/llm-vram-calculator/';
const pageUrl = `${site.url}${pagePath}`;

const faqs = toolFaqs('llm-vram-calculator');

const softwareApp = softwareAppLd({
  name: 'LLM VRAM Calculator',
  description:
    'Free LLM VRAM calculator: estimate the GPU memory a local model needs from its weights, KV cache and runtime overhead, per quantization and context length. 100% in-browser, no signup.',
  url: pageUrl,
  subCategory: 'AI',
  featureList: [
    'Model presets with the real layer, KV-head and head-dim shape from each config.json',
    'GGUF quantizations from FP16 to Q2_K with measured bits per weight',
    'KV cache sized per layer and per token for any context length up to 128k',
    'Verdict against 8, 12, 16, 24, 32, 48 and 80 GiB cards',
    '100% client-side, no upload, no signup',
  ],
  keywords: tool?.keywords.join(', '),
});
const faqPage = faqPageLd(faqs);

const pipeline = [
  {
    title: 'Pick the shape.',
    body: 'A preset supplies the model’s layer count, KV heads and head dimension from its config.json; a custom parameter count borrows the nearest preset’s shape and is labelled as estimated.',
  },
  {
    title: 'Weigh the weights.',
    body: 'Parameters × effective bits per weight for the chosen quantization, ÷ 8, ÷ 2³⁰. The bits per weight come from llama.cpp’s measured table, not the nominal 4 or 8.',
  },
  {
    title: 'Size the KV cache.',
    body: 'Two tensors per layer (K and V) × KV heads × head dim × context tokens × 2 bytes at FP16 — the part of the bill that grows with your context window.',
  },
  {
    title: 'Add overhead, then verdict.',
    body: 'A fixed 1.5 GiB for the runtime and compute buffers, then the total is placed against the common card sizes and the smallest one that fits is named.',
  },
];

const kvWorked = `KV cache (FP16) = 2 × layers × kv_heads × head_dim × context × 2 bytes

Llama 3.1 8B at 128k context
  layers 32 · kv_heads 8 · head_dim 128 · context 131,072
  = 2 × 32 × 8 × 128 × 131,072 × 2 B
  = 17,179,869,184 B
  = 16.0 GiB            (17.2 GB — the KV cache alone outgrows a 16 GiB card)

Same model at 8k context
  = 1.0 GiB`;

const weightsWorked = `Weights = params × bits_per_weight ÷ 8 ÷ 2^30

Llama 3.1 70B, Q4_K_M (4.89 bpw measured)
  weights   70e9 × 4.89 ÷ 8 ÷ 2^30  = 39.85 GiB
  KV @ 8k   2 × 80 × 8 × 128 × 8,192 × 2 B  =  2.50 GiB
  overhead                                 =  1.50 GiB
  total                                    = 43.85 GiB   → fits a 48 GiB card, not 24 or 32

Llama 3.1 8B, Q4_K_M
  weights   8e9 × 4.89 ÷ 8 ÷ 2^30   = 4.55 GiB
  KV @ 8k                            = 1.00 GiB
  total (with overhead)              = 7.05 GiB   → fits an 8 GiB card`;
---

<Shell
  title="LLM VRAM Calculator — GPU Memory for Local Models"
  description="Free LLM VRAM calculator: size the weights, KV cache and runtime overhead of a local model per quantization and context length. In-browser, no signup."
  canonical="/llm-vram-calculator"
  jsonLd={[softwareApp, faqPage]}
>
  <ToolHero slug="llm-vram-calculator">
    <Fragment slot="headline">Size the GPU before you download the model.</Fragment>
  </ToolHero>

  <section id="playground" class="scroll-mt-24 bg-canvas-soft pt-8 pb-20 sm:pb-24">
    <div class="container-page">
      <h2 class="sr-only">LLM VRAM Calculator playground</h2>
      <LlmVramCalculatorPlayground />
      <ToolLede>
        Pick a model preset like <span translate="no">Llama 3.1 8B</span> or type a parameter count,
        choose a GGUF quantization such as
        <span class="code-mono text-ink" translate="no">Q4_K_M</span> and a context length, and get
        the VRAM a local LLM needs — weights, KV cache and runtime overhead in GiB, with a verdict
        against common GPU sizes — all computed in your browser, no signup required.
      </ToolLede>
    </div>
  </section>

  <section id="why" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="grid max-w-5xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <p class="eyebrow">The Gap</p>
          <h2 class="display-lg mt-3 text-balance text-ink">
            The weights fit. Then the context window does not.
          </h2>
          <ToolGapVisual />
        </div>
        <div class="space-y-4">
          <p class="body-md text-pretty text-body">
            GPU memory for a local LLM is three bills, not one. The <strong>weights</strong> are
            the part everyone sizes: parameters times bits per weight, which is why a 4-bit
            quantization of an 8B model is a 4.5 GiB file. The <strong>KV cache</strong> is the part
            everyone forgets — two tensors per layer that grow linearly with the context length, so
            the same 8B model wants 1 GiB of cache at 8k tokens and 16 GiB at 128k.
            The <strong>runtime overhead</strong> is the rest: compute buffers, CUDA or Metal context
            and the framework itself, a fixed cost of around 1.5 GiB.
          </p>
          <p class="body-md text-pretty text-body">
            Two unit systems make the edge cases worse. A GPU sold as “24 GB” exposes 24 GiB (2³⁰
            bytes each), while model cards and file sizes often quote GB (10⁹ bytes) — a 7.4 %
            gap. This calculator works in GiB throughout, so a fit is judged against what the
            driver actually reports, and the reference below shows both figures for the worked
            example. On Apple silicon the unified memory is shared with the system; plan on about
            75 % of the Mac&rsquo;s RAM being available to the model.
          </p>
          <p class="body-md text-pretty text-body">
            Asking an AI how much VRAM a model needs is the risky shortcut: a language model recalls
            plausible numbers from forum posts about different quantizations and context lengths.
            This calculator computes the real per-layer KV cache from each model&rsquo;s
            <span class="code-mono text-ink" translate="no">config.json</span> shape and the
            measured bits per weight from llama.cpp — numbers you can verify an AI&rsquo;s answer
            against, not more plausible text.
          </p>
          <p class="body-sm text-mute">
            Converting between GiB and GB? The
            <a class="link-inline" href="/data-size-converter/">Data Size Converter</a> shows the
            exact byte counts.
          </p>
        </div>
      </div>
    </div>
  </section>

  <ToolPipeline
    id="how-it-works"
    eyebrow="The Pipeline"
    heading="How it works."
    lead="Four deterministic steps run on every change — all inside your browser tab, with the model shapes checked against each config.json."
    steps={pipeline}
  />

  <section id="reference" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="max-w-2xl">
        <p class="eyebrow">Formula Reference</p>
        <h2 class="display-lg mt-3 text-ink">The two formulas, worked.</h2>
        <p class="body-md mt-3 max-w-xl text-pretty text-body">
          Everything the panel shows comes from these two lines plus a fixed overhead. Here they
          are with real model shapes, so you can check the result by hand.
        </p>
      </div>
      <div class="mt-10 grid max-w-5xl gap-8 lg:grid-cols-2">
        <div class="min-w-0">
          <h3 class="display-sm text-ink">KV cache grows with context</h3>
          <p class="body-sm mt-2 mb-4 text-pretty text-body">
            Grouped-query attention keeps the cache small: Llama 3.1 has 32 attention heads but
            only <span class="code-mono text-ink" translate="no">8</span> KV heads per layer, which
            is the number that counts here.
          </p>
          <CodeBlock fig="40.1" lang="text" filename="kv-cache-llama-3-1-8b" code={kvWorked} />
        </div>
        <div class="min-w-0">
          <h3 class="display-sm text-ink">Weights by quantization</h3>
          <p class="body-sm mt-2 mb-4 text-pretty text-body">
            A “4-bit” GGUF is not 4 bits per weight: Q4_K_M averages
            <span class="code-mono text-ink" translate="no">4.89</span> once its scales and the
            higher-precision tensors are counted, and Q8_0 averages 8.5.
          </p>
          <CodeBlock fig="40.2" lang="text" filename="weights-llama-3-1-70b" code={weightsWorked} />
        </div>
      </div>
    </div>
  </section>

  <section id="next" class="scroll-mt-24 bg-inverse text-inverse-fg">
    <div class="container-page py-16 sm:py-20">
      <div class="grid max-w-5xl items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <div class="min-w-0">
          <p class="eyebrow !text-cyan">Next Step</p>
          <h2 class="display-lg mt-3 text-balance text-inverse-fg">
            Serving the model on a cluster? Size the pod too.
          </h2>
          <p class="body-md mt-4 text-pretty text-white/70">
            Once the card is chosen, the
            <span translate="no">Kubernetes Resource Calculator</span> turns your replica count
            and per-pod CPU, memory and GPU requests into node totals and headroom — handy before
            you write the Deployment that mounts the model.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <Button href="/kubernetes-resource-calculator/" variant="inverse">
              Open the Resource Calculator
            </Button>
          </div>
        </div>
        <CodeBlock
          lang="text"
          filename="fit.txt"
          code={`Llama 3.1 8B   Q4_K_M    8k   →  7.05 GiB   fits  8 GiB
Llama 3.1 8B   FP16    128k   →  32.4 GiB   fits 48 GiB
Llama 3.1 70B  Q4_K_M    8k   →  43.8 GiB   fits 48 GiB`}
        />
      </div>
    </div>
  </section>

  <FaqList faqs={faqs} align="left" />

  <ToolCrossLinks slug="llm-vram-calculator">
    <Fragment slot="lead">
      The LLM VRAM Calculator is one tool in
      <span translate="no">{site.name}</span> — a growing canopy of browser-based validators,
      converters and testers that never touch a server.
    </Fragment>
    <Fragment slot="links">
      More sizing: the
      <a class="link-inline" href="/kubernetes-resource-calculator/">Kubernetes Resource Calculator</a>
      and the <a class="link-inline" href="/data-size-converter/">Data Size Converter</a>, or
      browse the full <a class="link-inline" href={`${navLinks[0].href}/`}>tools directory</a>.
    </Fragment>
    <Fragment slot="disclaimer">
      Estimates only; the KV cache is sized at FP16 and the overhead is a fixed allowance, so
      always confirm against your own runtime&rsquo;s report before buying hardware.
      <span translate="no">{site.name}</span> is free and open.
    </Fragment>
  </ToolCrossLinks>
</Shell>
