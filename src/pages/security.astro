---
/**
 * /security — how the no-backend architecture protects pasted input, what it
 * does not cover, and how to report a vulnerability. Content is data-driven
 * from src/i18n/pages; localized copies live under src/pages/<locale>/security.astro.
 */
import Shell from '../components/Shell.astro';
import InfoPage from '../components/page/InfoPage.astro';
import { getPagesContent } from '../i18n/pages';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { site } from '../data/site';

const lang = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE;
const content = getPagesContent(lang);
const doc = content.security;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: doc.metaTitle,
  description: doc.description,
  url: `${site.url}/security/`,
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
};
---

<Shell
  title={doc.metaTitle}
  description={doc.description}
  canonical="/security"
  jsonLd={jsonLd}
>
  <InfoPage doc={doc} lang={lang} updatedLabel={content.ui.updatedLabel} />
</Shell>
