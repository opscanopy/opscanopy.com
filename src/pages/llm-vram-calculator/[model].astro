---
/**
 * LLM VRAM variant pages (/llm-vram-calculator/llama-3-1-70b/ …) — one per
 * entry in src/data/variants/llm-vram.ts. The playground is server-rendered
 * with the variant's pinned input; the prose and FAQs come from the data
 * module. English-only, slimmer than the parent: no pipeline, no numbered
 * figures, no SoftwareApp LD.
 */
import Shell from '../../components/Shell.astro';
import LlmVramCalculatorPlayground from '../../components/LlmVramCalculatorPlayground.astro';
import ToolHero from '../../components/ToolHero.astro';
import ToolLede from '../../components/ToolLede.astro';
import FaqList from '../../components/FaqList.astro';
import ToolCrossLinks from '../../components/ToolCrossLinks.astro';
import { site } from '../../data/site';
import { faqPageLd } from '../../lib/jsonld';
import { toolOgImage } from '../../lib/tool-og';
import { inlineCode } from '../../lib/inline-code';
import { llmVramVariants, type LlmVramVariant } from '../../data/variants/llm-vram';
import { variantPaths, siblings, isIndexable } from '../../data/variants';

export const getStaticPaths = () => variantPaths(llmVramVariants, 'model');

const { variant: v } = Astro.props as { variant: LlmVramVariant };
const href = `/llm-vram-calculator/${v.slug}/`;
const others = siblings(llmVramVariants, v.slug);
---

<Shell
  title={v.title}
  description={v.description}
  canonical={`/llm-vram-calculator/${v.slug}`}
  availableLocales={['en']}
  noindex={isIndexable('llm-vram-calculator', v.slug) ? false : 'follow'}
  image={toolOgImage('/llm-vram-calculator/')}
  jsonLd={[faqPageLd(v.faqs)]}
>
  <ToolHero slug="llm-vram-calculator" h1Name={v.h1Name} leaf={{ name: v.h1Name, href }}>
    <Fragment slot="headline">{v.headline}</Fragment>
  </ToolHero>

  <section id="playground" class="scroll-mt-24 bg-canvas-soft pt-8 pb-20 sm:pb-24">
    <div class="container-page">
      <h2 class="sr-only">LLM VRAM calculator playground</h2>
      <LlmVramCalculatorPlayground seed={v.vram} />
      <ToolLede>{v.lede}</ToolLede>
    </div>
  </section>

  <section id="about" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="measure-prose space-y-10">
        {
          v.sections.map((s) => (
            <div class="space-y-4">
              <h2 class="display-sm text-balance text-ink">{s.heading}</h2>
              {s.paragraphs.map((p) => (
                <p class="body-md text-pretty text-body" set:html={inlineCode(p)} />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="related" class="scroll-mt-24 border-t border-hairline bg-canvas-soft">
    <div class="container-page py-12 sm:py-16">
      <h2 class="display-sm text-ink">Other models</h2>
      <p class="body-md measure-prose mt-3 text-pretty text-body">
        Back to the full <a class="link-inline" href="/llm-vram-calculator/">LLM VRAM Calculator</a>, or
        open another model:
      </p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {
          others.map((o) => (
            <li>
              <a class="chip" href={`/llm-vram-calculator/${o.slug}/`} translate="no">
                {o.h1Name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <FaqList faqs={v.faqs} align="left" />

  <ToolCrossLinks slug="llm-vram-calculator">
    <Fragment slot="lead">
      The LLM VRAM Calculator is one tool in
      <span translate="no">{site.name}</span> — a growing canopy of browser-based validators,
      converters and testers that never touch a server.
    </Fragment>
    <Fragment slot="links">
      Related: the full
      <a class="link-inline" href="/llm-vram-calculator/">LLM VRAM Calculator</a>, the
      <a class="link-inline" href="/llm-token-counter/">LLM Token Counter</a>, or every
      <a class="link-inline" href="/tools/ai/">AI tool</a>.
    </Fragment>
    <Fragment slot="disclaimer">
      Estimates only; the KV cache is sized at FP16 and the overhead is a fixed allowance, so
      always confirm against your own runtime&rsquo;s report before buying hardware.
      <span translate="no">{site.name}</span> is free and open.
    </Fragment>
  </ToolCrossLinks>
</Shell>
