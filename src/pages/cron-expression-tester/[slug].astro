---
/**
 * Cron variant pages (/cron-expression-tester/every-5-minutes/ …) — one per
 * entry in src/data/variants/cron.ts. The playground is server-rendered with
 * the variant's expression (description and fields only; next runs stay
 * client-side). English-only, slimmer than the parent: no pipeline, no
 * numbered figures, no SoftwareApp LD.
 */
import Shell from '../../components/Shell.astro';
import CronTesterPlayground from '../../components/CronTesterPlayground.astro';
import ToolHero from '../../components/ToolHero.astro';
import ToolLede from '../../components/ToolLede.astro';
import FaqList from '../../components/FaqList.astro';
import ToolCrossLinks from '../../components/ToolCrossLinks.astro';
import { site, navLinks } from '../../data/site';
import { faqPageLd } from '../../lib/jsonld';
import { toolOgImage } from '../../lib/tool-og';
import { inlineCode } from '../../lib/inline-code';
import { cronVariants } from '../../data/variants/cron';
import { variantPaths, siblings, type ToolVariant } from '../../data/variants';

export const getStaticPaths = () => variantPaths(cronVariants, 'slug');

const { variant: v } = Astro.props as { variant: ToolVariant };
const href = `/cron-expression-tester/${v.slug}/`;
const others = siblings(cronVariants, v.slug);
---

<Shell
  title={v.title}
  description={v.description}
  canonical={`/cron-expression-tester/${v.slug}`}
  availableLocales={['en']}
  image={toolOgImage('/cron-expression-tester/')}
  jsonLd={[faqPageLd(v.faqs)]}
>
  <ToolHero slug="cron-expression-tester" h1Name={v.h1Name} leaf={{ name: v.h1Name, href }}>
    <Fragment slot="headline">{v.headline}</Fragment>
  </ToolHero>

  <section id="playground" class="scroll-mt-24 bg-canvas-soft pt-8 pb-20 sm:pb-24">
    <div class="container-page">
      <h2 class="sr-only">Cron Expression Tester playground</h2>
      <CronTesterPlayground seed={v.input} />
      <ToolLede>{v.lede}</ToolLede>
    </div>
  </section>

  <section id="about" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="measure-prose space-y-10">
        {
          v.sections.map((s) => (
            <div class="space-y-4">
              <h2 class="display-sm text-balance text-ink">{s.heading}</h2>
              {s.paragraphs.map((p) => (
                <p class="body-md text-pretty text-body" set:html={inlineCode(p)} />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="related" class="scroll-mt-24 border-t border-hairline bg-canvas-soft">
    <div class="container-page py-12 sm:py-16">
      <h2 class="display-sm text-ink">Other common schedules</h2>
      <p class="body-md measure-prose mt-3 text-pretty text-body">
        Back to the full
        <a class="link-inline" href="/cron-expression-tester/">Cron Expression Tester</a>, or open
        another schedule:
      </p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {
          others.map((o) => (
            <li>
              <a class="chip" href={`/cron-expression-tester/${o.slug}/`}>
                {o.h1Name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <FaqList faqs={v.faqs} align="left" />

  <ToolCrossLinks slug="cron-expression-tester">
    <Fragment slot="lead">
      The Cron Expression Tester is one tool in
      <span translate="no">{site.name}</span> — a growing canopy of browser-based validators,
      converters and testers that never touch a server.
    </Fragment>
    <Fragment slot="links">
      Scheduling on Linux? Pair this with the
      <a class="link-inline" href="/cron-to-systemd/">Cron to systemd Converter</a>, or browse the
      full <a class="link-inline" href={`${navLinks[0].href}/`}>tools directory</a>.
    </Fragment>
    <Fragment slot="disclaimer">
      Not affiliated with or endorsed by any <span translate="no">cron</span> implementation. Format
      names are used only to describe what this tool reads.
      <span translate="no">{site.name}</span> is free and open.
    </Fragment>
  </ToolCrossLinks>
</Shell>
