---
/**
 * OpsCanopy hub homepage — the flagship marketing surface.
 * Composes the Field Manual design system defined in global.css / DESIGN.md.
 *
 * Section order (Batch E, 2026-10; the outline lives in the PR description):
 *   1 claim (hero + HeroDemo) → 2 proof ledger → 3 numbered tool index →
 *   4 Mission 90 drill → 5 Learn → 6 why + privacy band → 7 incident ledger →
 *   8 verify plate → 9 FAQ → 10 two-door close.
 * Surfaces alternate (soft / canvas / soft …) so no two adjacent sections share
 * a surface and their paddings never stack. Every band's markup lives in
 * src/components/home/* once; this file (and its four locale mirrors) carries
 * only the translated copy.
 *
 * Copy rule: "free", "no signup" and "in your browser" appear once above the
 * fold (H1 + lede) and nowhere else outside the FAQ and <title>/meta. Two
 * exceptions are deliberate: the HomeDoors texts and the Mission CTA are
 * watched anchors (the SEO guard fails closed on any change), and the privacy
 * paragraph in the why band is kept verbatim by the plan.
 */
import Shell from '../components/Shell.astro';
import MeshGradient from '../components/MeshGradient.astro';
import HeroDemo from '../components/home/HeroDemo.astro';
import PrivacyProof from '../components/home/PrivacyProof.astro';
import ProofStrip from '../components/home/ProofStrip.astro';
import ToolsGrid from '../components/home/ToolsGrid.astro';
import HomeDoors from '../components/home/HomeDoors.astro';
import MissionBand from '../components/home/MissionBand.astro';
import VerifyPlate from '../components/home/VerifyPlate.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import TwoDoorClose from '../components/home/TwoDoorClose.astro';
import Button from '../components/Button.astro';
import LatestPosts from '../components/home/LatestPosts.astro';
import JumpBackIn from '../components/JumpBackIn.astro';
import TrackCard from '../components/learn/TrackCard.astro';
import { liveTools, getTool } from '../data/tools';
import { tracks } from '../data/learn';
import { liveTests } from '../data/tests';
import { program, phases as m90Phases, missions as m90Missions, totalCoreMinutes } from '../data/mission90';
import { getGuidesForLocale, estimateReadingTime } from '../lib/learn/guides';
import { faqPageLd } from '../lib/jsonld';
import {
  GHA_SEMANTICS_VERSION,
  exprCorpus,
  ifCorpus,
  globCorpus,
  triggerCorpus,
} from '../lib/github-actions-expression-tester/conformance';
import { JQ_VERSION } from '../data/versions';

// Featured catalog grid — a CURATED set of 9 rather than a mirror of /tools.
// Slugs are resolved from the registry so a rename surfaces as a dropped card,
// never a dead link; the "Browse all" link below uses liveTools.length so the
// count is always accurate.
//
// Ordered to lead with the five tools that have NO competing browser tool at all
// (verified 2026-08-31 — each also has an open upstream issue asking for exactly
// this: actions/runner#1173, prometheus#8606, prometheus/docs#1638,
// grafana/loki#7655). Competing on breadth is a losing axis: the directories that
// already own "free online devops tools" list 118–304 utilities. Depth is the only
// axis where 39 beats 304.
//
// The last four stay deliberately recognizable so a first-time generalist visitor
// still sees something they'd use today, which the niche five alone would not give
// them.
const featuredSlugs = [
  'github-actions-expression-tester', // CI/CD — no competing web tool exists
  'alertmanager-route-tester', // Observability — official editor has an open accuracy bug
  'prometheus-relabel-tester', // Observability — no competing web tool exists
  'loki-alert-rule-tester', // Observability — the promtool equivalent Loki never had
  'jq-playground', // Logs — real jq 1.8.2 in WASM, not a reimplementation
  'certificate-decoder', // Security — per-link signature verification
  'subnet-calculator', // Networking — the universally-recognized one
  'jwt-decoder', // Security
  'cron-expression-tester', // Scheduling
];
const featuredTools = featuredSlugs
  .map((slug) => getTool(slug))
  .filter((t): t is NonNullable<typeof t> => Boolean(t) && t!.status === 'live');

// Learn band — route the homepage's authority into /learn (it previously linked
// nowhere into the section). Feature the foundational tracks + the master roadmap.
const learnGuides = await getGuidesForLocale('en');
const learnByTrack = (slug: string) =>
  learnGuides.filter((g) => g.entry.data.track === slug).sort((x, y) => x.entry.data.order - y.entry.data.order);
const trackMeta = (slug: string) => {
  const gs = learnByTrack(slug);
  return {
    count: gs.length,
    minutes: gs.reduce((s, g) => s + (g.entry.data.estMinutes ?? estimateReadingTime(g.entry.body)), 0),
    difficulty: gs[0]?.entry.data.difficulty ?? 'beginner',
  };
};
const featuredTracks = tracks.filter((t) => ['linux', 'docker', 'kubernetes'].includes(t.slug));

// Mission-90 homepage feature band — every figure derived from the registry so
// the pitch can never drift out of sync as the program's content ships.
const m90LiveMissions = m90Missions.filter((m) => m.status === 'live').length;
const m90Hours = Math.round(totalCoreMinutes / 60 / 10) * 10;
const m90Stats = [
  { n: String(program.totalDays), l: 'days' },
  { n: String(m90Phases.length), l: 'phases' },
  { n: String(m90LiveMissions), l: 'browser missions' },
  { n: `~${m90Hours}`, l: 'hours core' },
];
// The week-1 "Server Down!" mission moment — the payoff, shown as a transcript.
const m90Transcript = `student@prod-web-01:~$ ps aux --sort=-%cpu | head -3
USER   PID   %CPU  COMMAND
root   4521  94.0  /opt/scripts/nightly-backup.sh
student@prod-web-01:~$ kill 4521
student@prod-web-01:~$ systemctl restart nginx
student@prod-web-01:~$ curl -sI localhost | head -1
HTTP/1.1 200 OK
# 02:07 — the site is back. You did that.`;

const faqs = [
  {
    q: 'Are OpsCanopy tools really free?',
    a: 'Yes. Every tool is completely free with no paywalls, usage limits, or premium tiers. There is no account requirement of any kind — open a tool in your browser and start using it immediately.',
  },
  {
    q: 'Do I need to sign up to use these online DevOps tools?',
    a: 'No. There is no signup, login, or email capture. Open any tool in your browser tab and use it immediately — no account, no cookie banner, no friction. Analytics is cookieless by default in the EU, the UK and Switzerland, and uses a single first-party cookie elsewhere; either way you can change it on the privacy page.',
  },
  {
    q: 'Is my data uploaded to a server when I use the tools?',
    a: 'No. Every tool runs 100% client-side in your browser tab; nothing you paste is logged, stored, or uploaded. Your data never leaves the browser.',
  },
  {
    q: 'Is it safe to paste a JWT or config into a browser-based tool?',
    a: 'On OpsCanopy, yes. Decoding and parsing happen entirely in local JavaScript — nothing you paste is ever transmitted, which you can verify in the browser network tab (the only outbound traffic is aggregate page analytics, disclosed in our privacy policy). As general hygiene, never share signing secrets with any third party, but OpsCanopy uploads none of your input.',
  },
  {
    q: 'Do the tools work offline?',
    a: 'Once a tool page has loaded, it keeps working even if you disconnect from the internet, because all processing is local and there is no backend to call. Going offline is also an easy way to verify the client-side privacy claim yourself.',
  },
  {
    q: 'Who are these browser-based DevOps tools for?',
    a: 'DevOps engineers, SREs, sysadmins, platform and backend engineers — anyone who needs quick subnet and CIDR math, cron schedules, PromQL or LogQL queries, JWT, Base64 and hash utilities, timestamp conversion, GitHub Actions validation, or Kubernetes resource sizing without installing anything.',
  },
  {
    q: 'Why use these instead of asking ChatGPT or Claude?',
    a: 'Use both — for different jobs. An AI assistant is excellent at explaining concepts and drafting configs, but it generates plausible text rather than computing answers, and exact arithmetic is a documented weak spot: subnet boundaries, cron schedules, epoch conversions and regex behaviour routinely come back looking right and being wrong. OpsCanopy tools compute answers deterministically — real parsers, exact math — and recompute instantly as you tweak the input, with no re-prompting, no token cost and no rate limits; once a tool page has loaded, it keeps working offline. Nothing you paste is ever transmitted, so logs, tokens and configs stay on your machine. Several tools even make handy AI checkers: run the same subnet, cron expression or timestamp through them and you get the ground truth to compare against.',
  },
  {
    q: 'How is OpsCanopy different from other online developer tool collections?',
    a: 'Most tool collections focus on generic formatters. OpsCanopy specialises in DevOps and SRE workflows — CIDR planning, cron, PromQL and LogQL, Kubernetes capacity, CI validators — with the same guarantees throughout: free, no signup, 100% client-side, nothing uploaded or logged.',
  },
  {
    q: 'I want to become a DevOps engineer — where do I start?',
    a: 'Start with OpsCanopy Learn at /learn. It pairs a staged DevOps career roadmap (/learn/roadmaps/devops) with free, hands-on guides covering Linux, Docker, Kubernetes, AWS and networking — going from the fundamentals to job-ready. As you read, you can practise immediately with the matching tools in the catalog, no signup required.',
  },
];

/*
 * "How we know it's right" — the hero says these tools are exact; this ledger is
 * the evidence, directly under the claim. Counts come from the code they
 * describe (the conformance corpus, the pinned jq build), so they cannot drift
 * out of date the way a hand-written number would.
 */
const ghaCases = exprCorpus.length + ifCorpus.length + globCorpus.length + triggerCorpus.length;
const fidelity = [
  {
    label: 'GitHub Actions',
    title: `${ghaCases} conformance cases`,
    body: `Every operator, coercion and glob is pinned to a versioned corpus (${GHA_SEMANTICS_VERSION}) that the test suite runs on each build.`,
  },
  {
    label: 'jq',
    title: `Real jq ${JQ_VERSION}`,
    body: 'Not a re-implementation: the actual jq binary compiled to WebAssembly, running in your tab.',
  },
  {
    label: 'Alertmanager',
    title: 'Routes like the router',
    body: 'Nested routes, continue, matchers and grouping are modelled the way Alertmanager itself resolves them.',
  },
  {
    label: 'IP & hashing',
    title: 'RFC and NIST vectors',
    body: 'Exact BigInt arithmetic for IPv4 and IPv6, checked against published test vectors rather than eyeballed.',
  },
];

// "Why a hub" value props — framed as what a returning user gets, not the
// business thesis behind building a catalog. Rendered as the point list inside
// the why + privacy band.
const whyCards = [
  {
    eyebrow: 'ONE PLACE',
    title: 'Everything in one tab.',
    body: "Bookmark one site instead of a dozen. When you need a converter, validator, or calculator, it's already here — same look, same shortcuts, no re-learning.",
    icon: '<path d="M3 20h18"/><path d="M6 20v-4M12 20V8M18 20v-9"/>',
  },
  {
    eyebrow: 'ALWAYS FAST',
    title: 'Instant, every time.',
    body: 'Every tool is static and client-side, so there are no server queues or cold starts to wait on — pages load instantly, whether you or ten thousand people hit them at once.',
    icon: '<path d="M13 3 5 13h6l-1 8 9-11h-6l1-7Z"/>',
  },
  {
    eyebrow: 'NO GATE',
    title: 'Nothing to unlock.',
    body: 'Every tool, guide and practice exam is open to anyone — no paywall, no trial, no form. Open the page and start working.',
    icon: '<path d="M3 11.4 11.4 3H19a2 2 0 0 1 2 2v7.6l-8.4 8.4a1.5 1.5 0 0 1-2.1 0L3 13.5a1.5 1.5 0 0 1 0-2.1Z"/><circle cx="15.8" cy="8.2" r="1.4"/>',
  },
];


// The hero's "what can I do here" row — the three things the site is for.
const doors = [
  { href: '/tools/', title: 'Use a tool', body: `${liveTools.length} exact tools: subnets, cron, PromQL, GitHub Actions and more.` },
  { href: '/mission-90/', title: 'Learn DevOps', body: 'A free 90-day program from developer to DevOps engineer.' },
  { href: '/tests/', title: 'Practise for a certification', body: `${liveTests.length} AWS practice exams, every answer explained.` },
];

// The close: use a tool, or start learning. /tools/ stays an <a> on the page.
const closeDoors = [
  { href: '/tools/', label: 'Find your tool — open the catalog', variant: 'primary' },
  { href: '/learn/roadmaps/devops/', label: 'Start the DevOps roadmap', variant: 'secondary' },
] as const;

// Organization + WebSite are emitted sitewide by SEO.astro with stable @ids.
const jsonLd = [faqPageLd(faqs)];
---

<Shell
  title="OpsCanopy — Free browser-only DevOps & SRE tools"
  description="Free DevOps tools that run entirely in your browser — GitHub Actions expressions, Alertmanager routes, Prometheus relabeling, subnets, cron. No signup."
  canonical="/"
  jsonLd={jsonLd}
>
  {/* ─────────────────────────── 1 · CLAIM ─────────────────────────── */}
  <section class="section-pad relative isolate overflow-hidden bg-canvas-soft">
    <MeshGradient class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[90%] opacity-90" />
    {/* Soft top sheen + bottom fade frame the mesh so it reads as ambient light,
        keeping crisp ink contrast under the headline. */}
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-32 bg-gradient-to-b from-canvas-soft to-transparent"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-48 bg-gradient-to-b from-transparent to-canvas-soft"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative z-10">
      <div class="flex flex-col">
        {/* Copy — the caption above the instrument. */}
        <div class="flex flex-col">
          {/* Differentiator strip — quiet, scannable, high-signal scale facts. */}
          <p class="eyebrow flex flex-wrap items-center gap-x-2 gap-y-1 text-mute">
            <span>{liveTools.length} tools</span>
            <span aria-hidden="true" class="text-hairline">&bull;</span>
            <span>100% client-side</span>
            <span aria-hidden="true" class="text-hairline">&bull;</span>
            <a
              href="https://github.com/opscanopy/opscanopy.com"
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-hairline underline-offset-4 transition-colors hover:text-ink"
              >Open source</a
            >
          </p>

          <h1 class="display-xl mt-4 max-w-3xl text-balance text-ink">
            Free DevOps tools and <span class="whitespace-nowrap">hands-on</span> training, right in your browser.
          </h1>

          <p class="body-md mt-4 max-w-2xl text-pretty text-body">
            OpsCanopy is where engineers check configs, queries and network math — and where
            developers learn to become DevOps engineers. Nothing you paste leaves your device, and
            there is no account. Ever.
          </p>

          <HomeDoors doors={doors} ariaLabel="What you can do on OpsCanopy" />
        </div>

        {/* The hero object: a real subnet calculator, computed in the browser
            (build-time-seeded, so it also works with no JS). Full container width
            — the instrument speaks, the headline confirms. */}
        <div class="mt-10 lg:mt-12">
          <HeroDemo />
        </div>
      </div>
    </div>
  </section>

  {/* ─────────── 2 · PROOF LEDGER — the evidence for the hero's claim ─────────── */}
  <ProofStrip principles={fidelity} ariaLabel="How we know the answers are right" heading="Exact answers, not approximations." />

  {/* ─────────── 2b · JUMP BACK IN (pinned/recent tools; client-revealed) ─────────── */}
  <JumpBackIn heading="Jump back in" />

  {/* ─────────── 3 · THE TOOL INDEX (numbered by registry figure) ─────────── */}
  <ToolsGrid tools={featuredTools} lang="en" openLabel={"Open tool"}>
    <Fragment slot="eyebrow">The Catalog</Fragment>
    <Fragment slot="heading">The tool index.</Fragment>
    <Fragment slot="lead">Focused, single-purpose utilities for platform and DevOps engineers — every one live,
            exact and a single bookmark away.</Fragment>
    <Fragment slot="seeAll">See all tools</Fragment>
    <Fragment slot="browseAll">Browse all {liveTools.length} tools</Fragment>
  </ToolsGrid>

  {/* ─────────── 4 · MISSION 90 DRILL — the guided program, on the slab ─────────── */}
  <MissionBand lang="en" stats={m90Stats} transcript={m90Transcript} boardLabel="Three of the ten missions" weekLabel="Week" playLabel="Play">
    <Fragment slot="heading">From developer to DevOps engineer in 90 days.</Fragment>
    <Fragment slot="body">A guided path — one focused lesson a day, and a story-driven mission you play in an
      in-page terminal to fix a broken system at the end of every week. All 90 days and 10 missions
      are live now — open from day one.</Fragment>
    <Fragment slot="cta">Start Day 1 — free, no signup</Fragment>
    <Fragment slot="browse">Browse the missions</Fragment>
  </MissionBand>

  {/* ─────────── 5 · LEARN DEVOPS (route homepage authority into /learn) ─────────── */}
  <section class="section-pad-lg bg-canvas-soft" aria-labelledby="learn-devops">
    <div class="container-page">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <span class="eyebrow">Learn DevOps</span>
          <h2 id="learn-devops" class="display-lg mt-3 text-balance text-ink">
            Staged roadmaps &amp; hands-on guides.
          </h2>
          <p class="body-md mt-3 text-pretty text-body">
            Go from the fundamentals to job-ready with staged career roadmaps and deep, practical
            guides — Linux, Docker, Kubernetes, AWS and networking. Self-paced, and you can
            practise with the tools as you go.
          </p>
        </div>
        <a
          href="/learn/"
          class="link-inline group body-md inline-flex shrink-0 items-center gap-1 whitespace-nowrap font-medium"
        >
          Browse all guides
          <span
            aria-hidden="true"
            class="transition-transform duration-150 ease-out group-hover:translate-x-0.5"
          >
            &rarr;
          </span>
        </a>
      </div>

      <div class="mt-8">
        <Button href="/learn/roadmaps/devops/" variant="primary">Start with the DevOps roadmap</Button>
      </div>

      <ul role="list" class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredTracks.map((track) => {
          const m = trackMeta(track.slug);
          return <TrackCard track={track} guideCount={m.count} difficulty={m.difficulty} minutes={m.minutes} />;
        })}
      </ul>
    </div>
  </section>

  {/* ─────────── 6 · WHY + PRIVACY (one band: #why on the section, #privacy on the slab) ─────────── */}
  <PrivacyProof points={whyCards}>
    <Fragment slot="eyebrow">Why OpsCanopy</Fragment>
    <Fragment slot="heading">One set of guarantees, not twenty tabs.</Fragment>
    <Fragment slot="body">Every <span translate="no">OpsCanopy</span> tool runs as static JavaScript in your
            browser. There is no backend to receive your rules, configs or logs — no uploads, no
            telemetry on your inputs, no account to create. Close the tab and it&rsquo;s gone.</Fragment>
  </PrivacyProof>

  {/* ─────────── 7 · INCIDENT LEDGER (from the blog) ─────────── */}
  <LatestPosts />

  {/* ─────────── 8 · VERIFY PLATE — a claim beside the computation ─────────── */}
  <VerifyPlate calculatorHref="/subnet-calculator/">
    <Fragment slot="eyebrow">Verify the AI</Fragment>
    <Fragment slot="heading">Check an AI&rsquo;s answer against the real computation.</Fragment>
    <Fragment slot="body">Paste the numbers an assistant gave you next to the input it was given. The tool
      recomputes them exactly, on this page, and marks each claim — the same check the subnet, cron,
      timestamp and Base64 tools carry under their result panel.</Fragment>
  </VerifyPlate>

  {/* ─────────────────────────── 9 · FAQ ─────────────────────────── */}
  <HomeFaq faqs={faqs} moreLabel="More questions" />

  {/* ───────────────────────── 10 · TWO-DOOR CLOSE ───────────────────────── */}
  <TwoDoorClose doors={[closeDoors[0], closeDoors[1]]}>
    <Fragment slot="heading">Find your tool. Skip the install.</Fragment>
    <Fragment slot="body">Exact, private and instant. Open the catalog and put the right utility to work in your next deploy.</Fragment>
  </TwoDoorClose>
</Shell>
