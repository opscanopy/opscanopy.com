---
/**
 * Subnet calculator variant pages (/subnet-calculator/24/ …) — one per entry in
 * src/data/variants/subnet.ts. The playground is server-rendered with the
 * variant's CIDR; the prose and FAQs come from the data module. English-only,
 * slimmer than the parent: no pipeline, no numbered figures, no SoftwareApp LD.
 */
import Shell from '../../components/Shell.astro';
import SubnetCalculatorPlayground from '../../components/SubnetCalculatorPlayground.astro';
import ToolHero from '../../components/ToolHero.astro';
import ToolLede from '../../components/ToolLede.astro';
import FaqList from '../../components/FaqList.astro';
import ToolCrossLinks from '../../components/ToolCrossLinks.astro';
import { site, navLinks } from '../../data/site';
import { faqPageLd } from '../../lib/jsonld';
import { toolOgImage } from '../../lib/tool-og';
import { inlineCode } from '../../lib/inline-code';
import { subnetVariants } from '../../data/variants/subnet';
import { variantPaths, siblings, type ToolVariant } from '../../data/variants';

export const getStaticPaths = () => variantPaths(subnetVariants, 'variant');

const { variant: v } = Astro.props as { variant: ToolVariant };
const href = `/subnet-calculator/${v.slug}/`;
const others = siblings(subnetVariants, v.slug);
---

<Shell
  title={v.title}
  description={v.description}
  canonical={`/subnet-calculator/${v.slug}`}
  availableLocales={['en']}
  image={toolOgImage('/subnet-calculator/')}
  jsonLd={[faqPageLd(v.faqs)]}
>
  <ToolHero slug="subnet-calculator" h1Name={v.h1Name} leaf={{ name: v.h1Name, href }}>
    <Fragment slot="headline">{v.headline}</Fragment>
  </ToolHero>

  <section id="playground" class="scroll-mt-24 bg-canvas-soft pt-8 pb-20 sm:pb-24">
    <div class="container-page">
      <h2 class="sr-only">Subnet Calculator playground</h2>
      <SubnetCalculatorPlayground seed={v.input} />
      <ToolLede>{v.lede}</ToolLede>
    </div>
  </section>

  <section id="about" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="measure-prose space-y-10">
        {
          v.sections.map((s) => (
            <div class="space-y-4">
              <h2 class="display-sm text-balance text-ink">{s.heading}</h2>
              {s.paragraphs.map((p) => (
                <p class="body-md text-pretty text-body" set:html={inlineCode(p)} />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="related" class="scroll-mt-24 border-t border-hairline bg-canvas-soft">
    <div class="container-page py-12 sm:py-16">
      <h2 class="display-sm text-ink">Other common subnets</h2>
      <p class="body-md measure-prose mt-3 text-pretty text-body">
        Back to the full <a class="link-inline" href="/subnet-calculator/">Subnet Calculator</a>, or
        open another block:
      </p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {
          others.map((o) => (
            <li>
              <a class="chip" href={`/subnet-calculator/${o.slug}/`} translate="no">
                {o.h1Name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <FaqList faqs={v.faqs} align="left" />

  <ToolCrossLinks slug="subnet-calculator">
    <Fragment slot="lead">
      The Subnet Calculator is one tool in
      <span translate="no">{site.name}</span> — a growing canopy of browser-based validators,
      converters and testers that never touch a server.
    </Fragment>
    <Fragment slot="links">
      More networking: the
      <a class="link-inline" href="/ip-address-converter/">IP Address Converter</a>, the
      <a class="link-inline" href="/cidr-checker/">CIDR / Subnet Checker</a> and the
      <a class="link-inline" href="/subnet-splitter/">Subnet Splitter</a>, or browse the full
      <a class="link-inline" href={`${navLinks[0].href}/`}>tools directory</a>.
    </Fragment>
    <Fragment slot="disclaimer">
      Provided as-is for convenience; always confirm critical network changes against your own
      authority. <span translate="no">{site.name}</span> is free and open.
    </Fragment>
  </ToolCrossLinks>
</Shell>
