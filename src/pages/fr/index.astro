---
/**
 * OpsCanopy hub homepage — the flagship marketing surface.
 * Composes the Vercel-inspired design system defined in global.css / DESIGN.md.
 * Structural mirror of src/pages/index.astro (English) — see that file for the
 * canonical section order; keep both in sync when the layout changes.
 *
 * Section order (Batch E, 2026-10; the outline lives in the PR description):
 *   1 claim (hero + HeroDemo) → 2 proof ledger → 3 numbered tool index →
 *   4 Mission 90 drill → 5 Learn → 6 why + privacy band → 7 incident ledger →
 *   8 verify plate → 9 FAQ → 10 two-door close.
 * Surfaces alternate (soft / canvas / soft …) so no two adjacent sections share
 * a surface and their paddings never stack. Every band's markup lives in
 * src/components/home/* once; this file carries only the translated copy.
 *
 * Copy rule: "free", "no signup" and "in your browser" (in this locale's
 * words) appear once above the fold (H1 + lede) and nowhere else outside the
 * FAQ and <title>/meta. Two exceptions are deliberate: the HomeDoors texts and
 * the Mission CTA are watched anchors (the SEO guard fails closed on any
 * change), and the privacy paragraph in the why band is kept verbatim.
 */
import Shell from '../../components/Shell.astro';
import MeshGradient from '../../components/MeshGradient.astro';
import HeroDemo from '../../components/home/HeroDemo.astro';
import PrivacyProof from '../../components/home/PrivacyProof.astro';
import ProofStrip from '../../components/home/ProofStrip.astro';
import ToolsGrid from '../../components/home/ToolsGrid.astro';
import HomeDoors from '../../components/home/HomeDoors.astro';
import MissionBand from '../../components/home/MissionBand.astro';
import VerifyPlate from '../../components/home/VerifyPlate.astro';
import HomeFaq from '../../components/home/HomeFaq.astro';
import TwoDoorClose from '../../components/home/TwoDoorClose.astro';
import Button from '../../components/Button.astro';
import LatestPosts from '../../components/home/LatestPosts.astro';
import JumpBackIn from '../../components/JumpBackIn.astro';
import TrackCard from '../../components/learn/TrackCard.astro';
import { liveTools, getTool } from '../../data/tools';
import { tracks } from '../../data/learn';
import { liveTests } from '../../data/tests';
import { program, phases as m90Phases, missions as m90Missions, totalCoreMinutes } from '../../data/mission90';
import { getGuidesForLocale, estimateReadingTime } from '../../lib/learn/guides';
import { faqPageLd } from '../../lib/jsonld';
import {
  GHA_SEMANTICS_VERSION,
  exprCorpus,
  ifCorpus,
  globCorpus,
  triggerCorpus,
} from '../../lib/github-actions-expression-tester/conformance';
import { JQ_VERSION } from '../../data/versions';
import type { Locale as __Locale } from '../../i18n/config';
import { localizeKey as __l, localizeNavHref as __nav } from '../../i18n/utils';

const __lang = (Astro.currentLocale ?? 'en') as __Locale;


// Featured catalog grid — a CURATED set of 9 representative tools, mirrors English.
const featuredSlugs = [
  // Leads with the five tools that have no competing browser tool at all; the last
  // four stay recognizable for a first-time visitor. See src/pages/index.astro.
  'github-actions-expression-tester',
  'alertmanager-route-tester',
  'prometheus-relabel-tester',
  'loki-alert-rule-tester',
  'jq-playground',
  'certificate-decoder',
  'subnet-calculator',
  'jwt-decoder',
  'cron-expression-tester',
];
const featuredTools = featuredSlugs
  .map((slug) => getTool(slug))
  .filter((t): t is NonNullable<typeof t> => Boolean(t) && t!.status === 'live');

// Learn band — /learn is English-only content (ENGLISH_ONLY_SECTIONS), so the
// guides themselves are fetched in English regardless of page locale.
const learnGuides = await getGuidesForLocale('en');
const learnByTrack = (slug: string) =>
  learnGuides.filter((g) => g.entry.data.track === slug).sort((x, y) => x.entry.data.order - y.entry.data.order);
const trackMeta = (slug: string) => {
  const gs = learnByTrack(slug);
  return {
    count: gs.length,
    minutes: gs.reduce((s, g) => s + (g.entry.data.estMinutes ?? estimateReadingTime(g.entry.body)), 0),
    difficulty: gs[0]?.entry.data.difficulty ?? 'beginner',
  };
};
const featuredTracks = tracks.filter((t) => ['linux', 'docker', 'kubernetes'].includes(t.slug));

// Mission-90 homepage feature band — figures derived from the registry, mirrors
// English. Mission-90 is also English-only content, so the transcript stays English.
const m90LiveMissions = m90Missions.filter((m) => m.status === 'live').length;
const m90Hours = Math.round(totalCoreMinutes / 60 / 10) * 10;
const m90Stats = [
  { n: String(program.totalDays), l: 'jours' },
  { n: String(m90Phases.length), l: 'phases' },
  { n: String(m90LiveMissions), l: 'missions navigateur' },
  { n: `~${m90Hours}`, l: 'heures de contenu' },
];
const m90Transcript = `student@prod-web-01:~$ ps aux --sort=-%cpu | head -3
USER   PID   %CPU  COMMAND
root   4521  94.0  /opt/scripts/nightly-backup.sh
student@prod-web-01:~$ kill 4521
student@prod-web-01:~$ systemctl restart nginx
student@prod-web-01:~$ curl -sI localhost | head -1
HTTP/1.1 200 OK
# 02:07 — the site is back. You did that.`;

const faqs = [
  {
    q: 'Les outils OpsCanopy sont-ils vraiment gratuits ?',
    a: 'Oui. Chaque outil est entièrement gratuit, sans péage, sans limite d’utilisation ni offre premium. Aucun compte n’est requis, d’aucune sorte : ouvrez un outil dans votre navigateur et commencez à l’utiliser immédiatement.',
  },
  {
    q: 'Dois-je m’inscrire pour utiliser ces outils DevOps en ligne ?',
    a: 'Non. Il n’y a ni inscription, ni connexion, ni collecte d’adresse e-mail. Ouvrez n’importe quel outil dans un onglet de votre navigateur et utilisez-le immédiatement : sans compte, sans bannière de cookies, sans friction. La mesure d’audience fonctionne sans cookies par défaut dans l’UE, au Royaume-Uni et en Suisse, et avec un unique cookie interne ailleurs ; dans les deux cas, vous pouvez en changer sur la page de confidentialité.',
  },
  {
    q: 'Mes données sont-elles envoyées à un serveur lorsque j’utilise les outils ?',
    a: 'Non. Chaque outil s’exécute à 100 % côté client dans l’onglet de votre navigateur ; rien de ce que vous collez n’est journalisé, stocké ni envoyé. Vos données ne quittent jamais le navigateur.',
  },
  {
    q: 'Est-il sûr de coller un JWT ou une configuration dans un outil basé sur le navigateur ?',
    a: 'Sur OpsCanopy, oui. Le décodage et l’analyse se déroulent entièrement en JavaScript local — rien de ce que vous collez n’est jamais transmis, ce que vous pouvez vérifier vous-même dans l’onglet réseau du navigateur (le seul trafic sortant est une mesure d’audience agrégée, décrite dans notre politique de confidentialité). Par hygiène générale, ne partagez jamais de secrets de signature avec un tiers, mais OpsCanopy n’envoie rien de ce que vous saisissez.',
  },
  {
    q: 'Les outils fonctionnent-ils hors ligne ?',
    a: 'Une fois la page d’un outil chargée, elle continue de fonctionner même si vous vous déconnectez d’Internet, car tout le traitement est local et il n’y a aucun backend à appeler. Se mettre hors ligne est aussi un moyen simple de vérifier vous-même l’affirmation de confidentialité côté client.',
  },
  {
    q: 'À qui s’adressent ces outils DevOps basés sur le navigateur ?',
    a: 'Aux ingénieurs DevOps, SRE, administrateurs système, ingénieurs plateforme et backend : à toute personne qui a besoin de calculs rapides de sous-réseaux et de CIDR, de planifications cron, de requêtes PromQL ou LogQL, d’utilitaires JWT, Base64 et de hachage, de conversion d’horodatages, de validation GitHub Actions ou de dimensionnement de ressources Kubernetes, sans rien installer.',
  },
  {
    q: 'Pourquoi utiliser ces outils plutôt que de demander à ChatGPT ou Claude ?',
    a: 'Utilisez les deux — pour des tâches différentes. Un assistant IA excelle à expliquer des concepts et à ébaucher des configurations, mais il génère du texte plausible plutôt que de calculer des réponses, et l’arithmétique exacte est une faiblesse documentée : limites de sous-réseaux, planifications cron, conversions d’epoch et comportement des regex reviennent régulièrement en ayant l’air corrects tout en étant faux. Les outils OpsCanopy calculent les réponses de manière déterministe — vrais parseurs, calculs exacts — et recalculent instantanément à mesure que vous ajustez l’entrée, sans nouveau prompt, sans coût en tokens et sans limite de débit ; une fois la page d’un outil chargée, elle continue de fonctionner hors ligne. Rien de ce que vous collez n’est jamais transmis : vos journaux, jetons et configurations restent donc sur votre machine. Plusieurs outils font même office de vérificateurs d’IA bien pratiques : passez-y le même sous-réseau, la même expression cron ou le même horodatage, et vous obtenez la référence exacte à laquelle comparer.',
  },
  {
    q: 'En quoi OpsCanopy se distingue-t-il des autres collections d’outils pour développeurs en ligne ?',
    a: 'La plupart des collections d’outils se concentrent sur des formateurs génériques. OpsCanopy se spécialise dans les flux de travail DevOps et SRE : planification de CIDR, cron, PromQL et LogQL, capacité Kubernetes, validateurs CI, avec les mêmes garanties partout : gratuit, sans inscription, 100 % côté client, rien d’envoyé ni de journalisé.',
  },
  {
    q: 'Je veux devenir ingénieur DevOps — par où commencer ?',
    a: 'Commencez avec OpsCanopy Learn sur /learn. Il associe une feuille de route de carrière DevOps par étapes (/learn/roadmaps/devops) à des guides gratuits et pratiques couvrant Linux, Docker, Kubernetes, AWS et les réseaux — des fondamentaux jusqu’à un profil prêt pour l’emploi. Au fil de votre lecture, vous pouvez vous entraîner immédiatement avec les outils correspondants du catalogue, sans inscription requise.',
  },
];

// Quietly-stated trust principles for the value strip.
/*
 * "How we know it's right" — the hero says these tools are exact; this strip is
 * the evidence, directly under the claim. Counts come from the code they
 * describe (the conformance corpus, the pinned jq build), so they cannot drift
 * out of date the way a hand-written number would. Like every technical readout
 * on the site, the values stay in English; only the prose is translated.
 */
const ghaCases = exprCorpus.length + ifCorpus.length + globCorpus.length + triggerCorpus.length;
const fidelity = [
  {
    label: 'GitHub Actions',
    title: `${ghaCases} cas de conformité`,
    body: `Chaque opérateur, conversion et motif glob est adossé à un corpus versionné (${GHA_SEMANTICS_VERSION}) exécuté à chaque build.`,
  },
  {
    label: 'jq',
    title: `Le vrai jq ${JQ_VERSION}`,
    body: 'Pas une réimplémentation : le binaire jq réel compilé en WebAssembly, exécuté dans votre onglet.',
  },
  {
    label: 'Alertmanager',
    title: 'Route comme le routeur',
    body: 'Routes imbriquées, continue, matchers et regroupement sont modélisés comme Alertmanager les résout lui-même.',
  },
  {
    label: 'IP & hachage',
    title: 'Vecteurs RFC et NIST',
    body: 'Arithmétique BigInt exacte pour IPv4 et IPv6, vérifiée contre des vecteurs de test publiés.',
  },
];

// "Why a hub" value props, mirrors English.
const whyCards = [
  {
    eyebrow: 'UN SEUL ENDROIT',
    title: 'Tout dans un seul onglet.',
    body: 'Un seul favori au lieu d’une douzaine. Quand il vous faut un convertisseur, un validateur ou une calculatrice, il est déjà là — même apparence, mêmes raccourcis, rien à réapprendre.',
    icon: '<path d="M3 20h18"/><path d="M6 20v-4M12 20V8M18 20v-9"/>',
  },
  {
    eyebrow: 'TOUJOURS RAPIDE',
    title: 'Instantané, à chaque fois.',
    body: 'Chaque outil est statique et s’exécute côté client : aucune file d’attente serveur, aucun démarrage à froid. Les pages se chargent instantanément, que vous soyez seul ou dix mille à la fois.',
    icon: '<path d="M13 3 5 13h6l-1 8 9-11h-6l1-7Z"/>',
  },
  {
    eyebrow: 'SANS BARRIÈRE',
    title: 'Rien à déverrouiller.',
    body: 'Chaque outil, guide et examen blanc est ouvert à tous — sans péage, sans essai, sans formulaire. Ouvrez la page et commencez.',
    icon: '<path d="M3 11.4 11.4 3H19a2 2 0 0 1 2 2v7.6l-8.4 8.4a1.5 1.5 0 0 1-2.1 0L3 13.5a1.5 1.5 0 0 1 0-2.1Z"/><circle cx="15.8" cy="8.2" r="1.4"/>',
  },
];


// The hero's "what can I do here" row — the three things the site is for.
const doors = [
  { href: __l('/tools', __lang), title: 'Utiliser un outil', body: `${liveTools.length} outils exacts : sous-réseaux, cron, PromQL, GitHub Actions et plus.` },
  { href: __nav('/mission-90', __lang), title: 'Apprendre le DevOps', body: `Un programme gratuit de 90 jours, de développeur à ingénieur DevOps (en anglais).` },
  { href: __nav('/tests', __lang), title: 'Préparer une certification', body: `${liveTests.length} examens blancs AWS, chaque réponse expliquée (en anglais).` },
];

// The close: use a tool, or start learning. /tools/ stays an <a> on the page.
const closeDoors = [
  { href: __l('/tools', __lang), label: 'Trouver un outil — ouvrir le catalogue', variant: 'primary' },
  { href: __nav('/learn/roadmaps/devops', __lang), label: 'Démarrer la feuille de route DevOps', variant: 'secondary' },
] as const;

// Organization + WebSite are emitted sitewide by SEO.astro with stable @ids.
const jsonLd = [faqPageLd(faqs)];
---

<Shell
  title="OpsCanopy — Outils DevOps & SRE gratuits dans le navigateur"
  description="Outils DevOps gratuits qui tournent dans votre navigateur : expressions GitHub Actions, routes Alertmanager, relabeling, sous-réseaux, cron. Sans inscription."
  canonical="/"
  jsonLd={jsonLd}
>
  {/* ─────────────────────────── 1 · CLAIM ─────────────────────────── */}
  <section class="section-pad relative isolate overflow-hidden bg-canvas-soft">
    <MeshGradient class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[90%] opacity-90" />
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-32 bg-gradient-to-b from-canvas-soft to-transparent"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-48 bg-gradient-to-b from-transparent to-canvas-soft"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative z-10">
      <div class="flex flex-col">
        <div class="flex flex-col">
      <p class="eyebrow flex flex-wrap items-center gap-x-2 gap-y-1 text-mute">
        <span>{liveTools.length} outils</span>
        <span aria-hidden="true" class="text-hairline">&bull;</span>
        <span>100 % côté client</span>
        <span aria-hidden="true" class="text-hairline">&bull;</span>
        <a
          href="https://github.com/opscanopy/opscanopy.com"
          target="_blank"
          rel="noopener noreferrer"
          class="underline decoration-hairline underline-offset-4 transition-colors hover:text-ink"
          >Open source</a
        >
      </p>

      <h1 class="display-xl mt-4 max-w-3xl text-balance text-ink">
          Outils DevOps gratuits et formation pratique, directement dans votre navigateur.
      </h1>

      <p class="body-md mt-4 max-w-2xl text-pretty text-body">
          OpsCanopy est l’endroit où les ingénieurs vérifient configurations, requêtes et calculs
          réseau — et où les développeurs apprennent à devenir ingénieurs DevOps. Rien de ce que vous
          collez ne quitte votre appareil, et aucun compte n’est jamais requis.
      </p>

      <HomeDoors doors={doors} ariaLabel="Ce que vous pouvez faire sur OpsCanopy" />
        </div>

        <div class="mt-10 lg:mt-12">
          <HeroDemo />
        </div>
      </div>
    </div>
  </section>

  {/* ─────────── 2 · PROOF LEDGER — the evidence for the hero's claim ─────────── */}
  <ProofStrip principles={fidelity} ariaLabel="Comment nous savons que les réponses sont justes" heading="Des réponses exactes, pas des approximations." />

  {/* ─────────── 2b · JUMP BACK IN (pinned/recent tools; client-revealed) ─────────── */}
  <JumpBackIn heading="Reprenez où vous en étiez" lang="fr" />

  {/* ─────────── 3 · THE TOOL INDEX (numbered by registry figure) ─────────── */}
  <ToolsGrid tools={featuredTools} lang="fr" openLabel={"Ouvrir l’outil"}>
    <Fragment slot="eyebrow">Le catalogue</Fragment>
    <Fragment slot="heading">L’index des outils.</Fragment>
    <Fragment slot="lead">Des utilitaires ciblés, à usage unique, pour ingénieurs plateforme et DevOps : chacun en
            ligne, exact et à un seul favori de distance.</Fragment>
    <Fragment slot="seeAll">Voir tous les outils</Fragment>
    <Fragment slot="browseAll">Parcourir les {liveTools.length} outils</Fragment>
  </ToolsGrid>

  {/* ─────────── 4 · MISSION 90 DRILL — the guided program, on the slab ─────────── */}
  <MissionBand lang={__lang} stats={m90Stats} transcript={m90Transcript} boardLabel="Trois des dix missions" weekLabel="Semaine" playLabel="Jouer">
    <Fragment slot="heading">De développeur à ingénieur DevOps en 90 jours.</Fragment>
    <Fragment slot="body">Un parcours guidé — une leçon ciblée par jour, et à la fin de chaque semaine une mission
      narrative que vous jouez dans un terminal intégré à la page pour réparer un système en panne.
      Les 90 jours et les 10 missions sont disponibles dès maintenant — ouverts dès le premier jour.</Fragment>
    <Fragment slot="cta">Commencer le jour 1 — gratuit, sans inscription</Fragment>
    <Fragment slot="browse">Parcourir les missions</Fragment>
  </MissionBand>

  {/* ─────────── 5 · LEARN DEVOPS (route homepage authority into /learn) ─────────── */}
  <section class="section-pad-lg bg-canvas-soft" aria-labelledby="learn-devops">
    <div class="container-page">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <span class="eyebrow">Learn DevOps</span>
          <h2 id="learn-devops" class="display-lg mt-3 text-balance text-ink">
            Feuilles de route par étapes et guides pratiques.
          </h2>
          <p class="body-md mt-3 text-pretty text-body">
            Passez des fondamentaux à un profil prêt pour l’emploi grâce à des feuilles de route de
            carrière par étapes et des guides pratiques approfondis — Linux, Docker, Kubernetes, AWS et
            réseaux. À votre rythme, et vous pouvez vous entraîner avec les outils au fur et
            à mesure.
          </p>
        </div>
        <a
          href={__nav('/learn', __lang)}
          class="link-inline group body-md inline-flex shrink-0 items-center gap-1 whitespace-nowrap font-medium"
        >
          Parcourir tous les guides
          <span
            aria-hidden="true"
            class="transition-transform duration-150 ease-out group-hover:translate-x-0.5"
          >
            &rarr;
          </span>
        </a>
      </div>

      <div class="mt-8">
        <Button href={__nav('/learn/roadmaps/devops', __lang)} variant="primary">Commencer avec la feuille de route DevOps</Button>
      </div>

      <ul role="list" class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredTracks.map((track) => {
          const m = trackMeta(track.slug);
          return <TrackCard track={track} guideCount={m.count} difficulty={m.difficulty} minutes={m.minutes} />;
        })}
      </ul>
    </div>
  </section>

  {/* ─────────── 6 · WHY + PRIVACY (one band: #why on the section, #privacy on the slab) ─────────── */}
  <PrivacyProof points={whyCards}>
    <Fragment slot="eyebrow">Pourquoi OpsCanopy</Fragment>
    <Fragment slot="heading">Un seul jeu de garanties, pas vingt onglets.</Fragment>
    <Fragment slot="body">Chaque outil <span translate="no">OpsCanopy</span> s’exécute comme du JavaScript statique dans votre
            navigateur. Il n’y a aucun backend pour recevoir vos règles, configurations ou journaux : aucun envoi, aucune
            télémétrie sur vos entrées, aucun compte à créer. Fermez l’onglet et tout disparaît.</Fragment>
  </PrivacyProof>

  {/* ─────────── 7 · INCIDENT LEDGER (from the blog) ─────────── */}
  <LatestPosts lang={__lang} />

  {/* ─────────── 8 · VERIFY PLATE — a claim beside the computation ─────────── */}
  <VerifyPlate calculatorHref={__l('/subnet-calculator', __lang)}>
    <Fragment slot="eyebrow">Vérifier l’IA</Fragment>
    <Fragment slot="heading">Confrontez la réponse d’une IA au calcul réel.</Fragment>
    <Fragment slot="body">Collez les chiffres qu’un assistant vous a donnés à côté de l’entrée qu’il a reçue. L’outil les
      recalcule exactement, sur cette page, et évalue chaque affirmation — la même vérification que
      portent les outils sous-réseaux, cron, horodatage et Base64 sous leur panneau de résultats.</Fragment>
  </VerifyPlate>

  {/* ─────────────────────────── 9 · FAQ ─────────────────────────── */}
  <HomeFaq faqs={faqs} moreLabel="Autres questions" />

  {/* ───────────────────────── 10 · TWO-DOOR CLOSE ───────────────────────── */}
  <TwoDoorClose doors={[closeDoors[0], closeDoors[1]]}>
    <Fragment slot="heading">Trouvez votre outil. Évitez l’installation.</Fragment>
    <Fragment slot="body">Exact, privé et instantané. Ouvrez le catalogue et mettez l’outil adéquat au travail dans votre prochain déploiement.</Fragment>
  </TwoDoorClose>
</Shell>
