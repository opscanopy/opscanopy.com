---
/**
 * GitHub Actions Expression & Trigger Tester — the primary SEO surface.
 *
 * Two client-side tools on one page: an expression evaluator that replicates
 * GitHub's exact ${{ }} semantics (and warns on the always-true literal footgun,
 * actions/runner#1173), and a trigger simulator that decides per-job RUNS/SKIPPED
 * for a push / pull_request / tag event. 100% in-browser — no server, no signup.
 *
 * Mirrors the github-actions-validator page structure (hero, playground island,
 * why/cheat-sheet docs, scope note, FAQ + JSON-LD, cross-links).
 */
import Shell from '../../components/Shell.astro';
import GithubActionsExpressionPlayground from '../../components/GithubActionsExpressionPlayground.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Badge from '../../components/Badge.astro';
import ToolHero from '../../components/ToolHero.astro';
import ToolGapVisual from '../../components/ToolGapVisual.astro';
import ToolPipeline from '../../components/ToolPipeline.astro';
import FaqList from '../../components/FaqList.astro';
import ToolCrossLinks from '../../components/ToolCrossLinks.astro';
import { site, navLinks } from '../../data/site';
import { getTool } from '../../data/tools';
import { softwareAppLd, faqPageLd } from '../../lib/jsonld';

const tool = getTool('github-actions-expression-tester');

const pagePath = '/github-actions-expression-tester/';
const pageUrl = `${site.url}${__l(pagePath, (Astro.currentLocale ?? 'en') as __Locale)}`;

// Literal token kept out of Astro's `{}` expression parser.
const EXPR = '${{ }}';

// ── External references ──────────────────────────────────────────────────────
const ghExpressions = 'https://docs.github.com/actions/learn-github-actions/expressions';
const ghTriggers =
  'https://docs.github.com/actions/using-workflows/events-that-trigger-workflows';
const ghIssue1173 = 'https://github.com/actions/runner/issues/1173';

// ── FAQ content — single source for both the rendered section and FAQPage LD ─
const faqs = toolFaqs('github-actions-expression-tester', 'fr');

// ── JSON-LD ──────────────────────────────────────────────────────────────────
const softwareApp = softwareAppLd({
  name: 'Testeur d’expressions et de déclencheurs GitHub Actions',
  description:
    'Testez une condition if: GitHub Actions sans pousser : évaluez les expressions ${{ }} contre un contexte fictif github/env/matrix/steps/needs, repérez le piège du toujours-vrai dû au texte littéral et simulez quels jobs s’exécutent pour un push, une PR ou un tag. Gratuit, 100 % dans le navigateur.',
  url: pageUrl,
  subCategory: 'CI/CD',
  featureList: [
    "Évaluer les expressions ${{ }} contre un contexte fictif github/env/matrix/steps/needs éditable avec la sémantique exacte des opérateurs et de la coercition de GitHub",
    'Avertit sur le piège du if: « toujours vrai » dû au texte littéral (actions/runner#1173)',
    'Prend en charge contains, startsWith, endsWith, format, join, toJSON, fromJSON, hashFiles, success(), failure(), always(), cancelled()',
    'Simulateur de déclencheurs : décrivez un événement push, pull_request ou tag et voyez quels jobs s’exécutent (RUN) ou sont ignorés (SKIPPED) avec la raison décisive',
    'Moteur de glob fidèle pour branches, tags, paths et paths-ignore, y compris la sémantique ET branche+chemin',
    '100 % côté client : le YAML de votre workflow et les charges utiles d’événements ne quittent jamais le navigateur',
  ],
  keywords: tool?.keywords.join(', '),
});
const faqPage = faqPageLd(faqs);

// ── HOW IT WORKS pipeline ─────────────────────────────────────────────────────
const pipeline = [
  {
    title: 'Choisissez un onglet.',
    body: 'Évaluez un seul if: / une seule expression, ou passez au simulateur de déclencheurs pour tester un workflow entier contre un événement.',
  },
  {
    title: 'Définissez le contexte.',
    body: 'Modifiez le JSON fictif github/env/matrix/steps/needs (ou décrivez l’événement : type, ref, fichiers modifiés) pour qu’il corresponde à l’exécution qui vous intéresse.',
  },
  {
    title: 'Analysez avec la grammaire de GitHub.',
    body: 'L’expression est tokenisée et analysée avec la même précédence d’opérateurs et le même ensemble de fonctions que le runner utilise — sans appel externe, sans réseau.',
  },
  {
    title: 'Appliquez la sémantique exacte.',
    body: 'La coercition, l’égalité insensible à la casse, les && / || qui renvoient un opérande, les filtres de glob et la règle ET branche+chemin sont reproduits contre un corpus de conformité versionné.',
  },
  {
    title: 'Affichez le verdict + le pourquoi.',
    body: 'Vous obtenez le résultat vrai/faux et la valeur renvoyée, l’avertissement du piège « toujours vrai » là où il s’applique, et un tableau RUNS/SKIPPED par job avec la raison décisive.',
  },
];

// ── CHEAT-SHEET cards ─────────────────────────────────────────────────────────
const footgunBad = `# ALWAYS TRUE — operators sit OUTSIDE \${{ }}
jobs:
  deploy:
    if: \${{ github.ref }} == 'refs/heads/main'
    # after substitution this is the literal string
    #   refs/heads/main == 'refs/heads/main'
    # a non-empty string => truthy => runs on EVERY branch`;
const footgunGood = `# CORRECT — wrap the WHOLE condition in one \${{ }}
jobs:
  deploy:
    if: \${{ github.ref == 'refs/heads/main' }}
    # now GitHub evaluates the comparison, not a literal string`;

const coercionExample = `# GitHub's coercion is JS-like and case-insensitive:
\${{ 'ABC' == 'abc' }}      # true  (strings compare case-insensitively)
\${{ null == 0 }}           # true  (both coerce to the number 0)
\${{ '' || 'fallback' }}    # 'fallback'  (|| returns an OPERAND, not a bool)
\${{ github.x && 'yes' }}   # 'yes' when github.x is truthy
\${{ 'true' == true }}      # false (string 'true' coerces to NaN)`;

const functionsExample = `\${{ contains('refs/heads/main', 'main') }}     # true (substring, case-insensitive)
\${{ startsWith(github.ref, 'refs/tags/') }}    # is this a tag push?
\${{ format('{0}-{1}', 'app', github.sha) }}    # 'app-d6cd1e2…'
\${{ fromJSON('["a","b"]') }}                   # a real array
\${{ always() }}  \${{ success() }}  \${{ failure() }}  # status checks`;

const triggerExample = `on:
  push:
    branches: [main]      # AND
    paths: ['src/**']     # — both must match to trigger
# feature/* matches feature/a but NOT feature/a/b
# feature/** matches both (** crosses '/')`;

const cheats = [
  {
    title: 'Le piège du « toujours vrai »',
    badge: 'Le plus courant',
    blurb:
      'GitHub n’évalue que ce qui se trouve à l’intérieur des ${{ }}. Les opérateurs laissés à l’extérieur deviennent du texte littéral après substitution — une chaîne non vide, qui est toujours vraie. L’évaluateur le signale (actions/runner#1173).',
    bad: footgunBad,
    good: footgunGood,
  },
];

const refs = [
  { title: 'Opérateurs & coercition', code: coercionExample },
  { title: 'Fonctions', code: functionsExample },
  { title: 'Déclencheurs, branches & paths', code: triggerExample },
];

import type { Locale as __Locale } from '../../i18n/config';
import { localizeKey as __l } from '../../i18n/utils';
import { toolFaqs } from '../../data/tool-faqs';
const __lang = (Astro.currentLocale ?? 'en') as __Locale;
---

<Shell
  title="Testeur de conditions if GitHub Actions"
  description="Testez une condition if GitHub Actions dans le navigateur : évaluez ${{ }} avec un contexte fictif, repérez le toujours-vrai et quels jobs s’exécutent."
  canonical="/github-actions-expression-tester"
  jsonLd={[softwareApp, faqPage]}
>
  <!-- 1) HERO -->
  <ToolHero
    eyebrow="Testeur d’expressions GitHub Actions · CI/CD"
    badges={[
      { label: 'Sans inscription', variant: 'neutral' },
      { label: 'Sémantique GitHub exacte', variant: 'neutral' },
    ]}
  >
    <Fragment slot="headline">
      Testez vos conditions <span translate="no">if:</span> et vos déclencheurs avant de pousser.
    </Fragment>
    <Fragment slot="lead">
      Évaluez les expressions <span class="code-mono text-ink" translate="no">{EXPR}</span> contre un
      contexte fictif éditable, attrapez le <span translate="no">if:</span> qui est silencieusement
      <em>toujours vrai</em>, et simulez quels jobs s’exécutent pour un push, une PR ou un tag —
      instantanément, dans votre navigateur. Fini la boucle
      <span translate="no">commit-push-pray</span>.
    </Fragment>
  </ToolHero>

  <!-- 2) PLAYGROUND -->
  <section id="playground" class="scroll-mt-24 bg-canvas-soft pb-20 pt-8 sm:pb-24">
    <div class="container-page">
      <h2 class="sr-only">Espace d’essai des conditions if et des déclencheurs GitHub Actions</h2>
      <GithubActionsExpressionPlayground />
    </div>
  </section>

  <!-- 3) WHY IT EXISTS -->
  <section id="why" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <p class="eyebrow">La faille</p>
          <h2 class="display-lg mt-3 text-balance text-ink">
            Pourquoi votre condition <span translate="no">if:</span> GitHub Actions est toujours vraie.
          </h2>
          <ToolGapVisual />
        </div>
        <div class="space-y-4">
          <p class="body-md text-pretty text-body">
            Tout le monde l’a déjà fait : ajouter un <span class="code-mono text-ink" translate="no">if:</span> à une
            étape, pousser, le voir s’exécuter alors qu’il ne le devrait pas, ajuster, repousser — vingt commits
            bidons plus tard, vous découvrez que la condition était une chaîne littérale depuis le début. GitHub
            n’évalue que ce qui se trouve à l’intérieur des <span class="code-mono text-ink" translate="no">{EXPR}</span> ;
            tout ce qui est à l’extérieur est du texte littéral, et une chaîne non vide est toujours vraie.
          </p>
          <p class="body-md text-pretty text-body">
            Le côté déclencheur est tout aussi opaque : un workflow qui ne s’exécute pas ne produit
            <strong class="font-medium text-ink">aucune sortie du tout</strong> — la décision se prend dans
            le filtrage d’événements de GitHub avant qu’aucun runner ne démarre. Les filtres de branche et de chemin
            se combinent avec <span class="code-mono text-ink" translate="no">AND</span>, les pushes de tag sont exclus
            lorsque vous définissez <span class="code-mono text-ink" translate="no">branches</span> mais pas
            <span class="code-mono text-ink" translate="no">tags</span>, et
            <span class="code-mono text-ink" translate="no">**</span> se comporte différemment de
            <span class="code-mono text-ink" translate="no">*</span>.
          </p>
          <p class="body-md text-pretty text-body">
            Cet outil évalue les deux — une seule expression, ou un workflow entier contre un événement — en utilisant
            les règles exactes de <span translate="no">GitHub</span>, pour que vous obteniez la réponse dans le navigateur. Voir
            la documentation des
            <a class="link-inline" href={ghExpressions} target="_blank" rel="noopener noreferrer">expressions</a>
            et des
            <a class="link-inline" href={ghTriggers} target="_blank" rel="noopener noreferrer">déclencheurs de workflow</a>
            de <span translate="no">GitHub</span>, ainsi que le ticket du
            <a class="link-inline" href={ghIssue1173} target="_blank" rel="noopener noreferrer">piège du « toujours vrai »</a>.
          </p>
          <p class="body-sm text-mute">
            Accédez à l’<a class="link-inline" href="#reference">aide-mémoire</a> ou à l’<a class="link-inline" href="#playground">espace d’essai en direct</a> ci-dessus.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4) HOW IT WORKS -->
  <ToolPipeline
    id="how-it-works"
    eyebrow="Le pipeline"
    heading="Comment le testeur de conditions if: tranche entre vrai et faux."
    lead="Cinq étapes déterministes s’exécutent de bout en bout à chaque évaluation — entièrement dans votre onglet de navigateur, à chaque fois."
    steps={pipeline}
  />

  <!-- 5) CHEAT-SHEET -->
  <section id="reference" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Aide-mémoire</p>
        <h2 class="display-lg mt-3 text-ink">
          Les règles <span translate="no">if:</span> et déclencheurs qui font trébucher.
        </h2>
        <p class="body-md mx-auto mt-3 max-w-xl text-pretty text-body">
          Le piège, les surprises de la coercition, les fonctions et les globs de déclencheurs — chacun avec un
          exemple exécutable que vous pouvez coller dans l’espace d’essai.
        </p>
      </div>

      <div class="mx-auto mt-10 grid max-w-5xl gap-6">
        {
          cheats.map((c) => (
            <article class="card-soft min-w-0 p-6 sm:p-7">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <h3 class="display-sm text-balance text-ink">{c.title}</h3>
                <Badge variant="high">{c.badge}</Badge>
              </div>
              <p class="body-md mt-3 max-w-3xl text-pretty text-body">{c.blurb}</p>
              <div class="mt-5 grid gap-5 lg:grid-cols-2">
                <div class="min-w-0">
                  <p class="eyebrow !text-error mb-2">Toujours vrai</p>
                  <CodeBlock lang="yaml" filename=".github/workflows/ci.yml" code={c.bad} />
                </div>
                <div class="min-w-0">
                  <p class="eyebrow !text-success mb-2">Corrigé</p>
                  <CodeBlock lang="yaml" filename=".github/workflows/ci.yml" code={c.good} />
                </div>
              </div>
            </article>
          ))
        }

        <div class="grid gap-6 lg:grid-cols-3">
          {
            refs.map((r) => (
              <article class="card-soft min-w-0 p-6">
                <h3 class="display-sm text-balance text-ink">{r.title}</h3>
                <div class="mt-4">
                  <CodeBlock lang="yaml" code={r.code} />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 6) SCOPE NOTE -->
  <section class="bg-canvas-soft">
    <div class="container-page py-12 sm:py-16">
      <div class="card-soft mx-auto max-w-3xl p-6">
        <p class="eyebrow">Fidélité & portée</p>
        <p class="body-md mt-3 text-pretty text-body">
          Il s’agit d’un <strong class="font-medium text-ink">espace d’essai sémantique</strong>, pas d’un runner. Il
          reproduit le comportement documenté des expressions et des déclencheurs de <span translate="no">GitHub</span>
          contre un corpus de conformité versionné (affiché sous l’étiquette
          <span class="code-mono text-ink" translate="no">semantics:</span> dans l’outil), mais il
          n’exécute pas les jobs, ne récupère pas le contenu en direct des actions référencées, et ne calcule pas un véritable
          <span class="code-mono text-ink" translate="no">hashFiles()</span> — cela nécessite des fichiers que seul le
          runner peut voir, il est donc affiché comme un espace réservé. La charge utile complète de
          <span class="code-mono text-ink" translate="no">github.event</span> est modélisée comme un
          contexte fictif éditable que vous contrôlez. Considérez un résultat propre comme une forte confiance avant le push, et
          associez-le tout de même à <span class="code-mono text-ink" translate="no">actionlint</span> pour la syntaxe.
        </p>
      </div>
    </div>
  </section>

  <!-- 7) FAQ -->
  <FaqList faqs={faqs} />

  <!-- Cross-links + disclaimer -->
  <ToolCrossLinks lang={__lang}>
    <Fragment slot="lead">
      Le testeur d’expressions <span translate="no">GitHub</span> Actions est l’un des outils de
      <span translate="no">{site.name}</span> — une canopée grandissante de validateurs, de convertisseurs
      et de testeurs basés sur le navigateur qui ne touchent jamais à un serveur.
    </Fragment>
    <Fragment slot="links">
      Outils connexes : le
      <a class="link-inline" href={__l('/github-actions-validator', __lang)}>validateur <span translate="no">GitHub</span>
        Actions</a> et
      <a class="link-inline" href={__l('/loki-alert-rule-tester', __lang)}><span translate="no">AlertLint</span>, le
        testeur de règles <span translate="no">Loki</span></a>. Parcourez le
      <a class="link-inline" href={__l(navLinks[0].href, __lang)}>répertoire complet des outils</a>.
    </Fragment>
    <Fragment slot="disclaimer">
      Non affilié à <span translate="no">GitHub, Inc.</span>, ni approuvé ou sponsorisé par celle-ci.
      <span translate="no">GitHub</span> et <span translate="no">GitHub Actions</span> sont des marques de
      <span translate="no">GitHub, Inc.</span>, utilisées ici uniquement à titre descriptif pour identifier le format
      d’expression et de déclencheur de workflow que cet outil évalue.
    </Fragment>
  </ToolCrossLinks>
</Shell>
