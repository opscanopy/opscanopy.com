---
/**
 * PromQL Explainer — the PromQL Explainer tool page (primary SEO surface).
 * Paste a Prometheus PromQL query and get a plain-English breakdown —
 * selectors, rates, aggregations, functions and comparisons — entirely in the
 * browser. No server, no signup.
 *
 * Imports the interactive island (PromqlExplainerPlayground, self-mounting) plus
 * the brand primitives. JSON-LD (SoftwareApplication + FAQPage) is assembled in
 * frontmatter and handed to Shell via the `jsonLd` prop.
 */
import Shell from '../../components/Shell.astro';
import PromqlExplainerPlayground from '../../components/PromqlExplainerPlayground.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ToolHero from '../../components/ToolHero.astro';
import ToolGapVisual from '../../components/ToolGapVisual.astro';
import ToolPipeline from '../../components/ToolPipeline.astro';
import FaqList from '../../components/FaqList.astro';
import ToolCrossLinks from '../../components/ToolCrossLinks.astro';
import { site, navLinks } from '../../data/site';
import { getTool } from '../../data/tools';
import { softwareAppLd, faqPageLd } from '../../lib/jsonld';

const tool = getTool('promql-explainer');

const pagePath = '/promql-explainer/';
const pageUrl = `${site.url}${__l(pagePath, (Astro.currentLocale ?? 'en') as __Locale)}`;

// ── External references (the Prometheus docs the explainer mirrors) ──────────
const promqlBasics = 'https://prometheus.io/docs/prometheus/latest/querying/basics/';
const promqlFunctions = 'https://prometheus.io/docs/prometheus/latest/querying/functions/';

// ── FAQ content — single source for both the rendered section and FAQPage LD ─
const faqs = toolFaqs('promql-explainer', 'fr');

// ── JSON-LD: SoftwareApplication ─────────────────────────────────────────────
const softwareApp = softwareAppLd({
  name: 'PromQL Explainer',
  description:
    'Collez n’importe quelle requête PromQL et obtenez une explication en langage clair des sélecteurs, des rates et des agrégations. Gratuit, dans le navigateur, sans inscription.',
  url: pageUrl,
  subCategory: 'Observability',
  featureList: [
    'Décomposition en langage clair de n’importe quelle requête PromQL',
    'Explique les sélecteurs, les filtres d’étiquettes, les plages et les décalages',
    'Décode rate / agrégations / fonctions / comparaisons',
    '100 % côté client, aucun envoi, aucune inscription',
  ],
  keywords: tool?.keywords.join(', '),
});

// ── JSON-LD: FAQPage (mirrors the rendered FAQ) ──────────────────────────────
const faqPage = faqPageLd(faqs);

// ── HOW IT WORKS pipeline ────────────────────────────────────────────────────
const pipeline = [
  {
    title: 'Analyser la requête.',
    body: 'Votre expression PromQL est analysée en un arbre syntaxique — sélecteurs, plages, appels de fonction, agrégations et opérateurs binaires — la même forme que celle que lit Prometheus.',
  },
  {
    title: 'Nommer chaque clause.',
    body: 'Chaque nœud est étiqueté selon son rôle : la métrique et ses filtres d’étiquettes, tout vecteur de plage et décalage, le rate ou l’agrégation qui l’enveloppe, et la comparaison.',
  },
  {
    title: 'Traduire en langage clair.',
    body: 'Chaque clause nommée est rendue en une phrase courte et lisible décrivant ce qu’elle sélectionne, calcule ou affirme — aucun jargon n’est laissé sans définition.',
  },
  {
    title: 'Afficher la décomposition.',
    body: 'Les clauses annotées sont assemblées en un résumé unique en langage clair, accompagné d’une liste partie par partie, afin que vous puissiez lire la requête de haut en bas ou élément par élément.',
  },
];

// ── Example: a typical alerting PromQL query ─────────────────────────────────
const alertQueryExample = `sum by (job) (
  rate(http_requests_total{status=~"5.."}[5m])
)
/
sum by (job) (
  rate(http_requests_total[5m])
) > 0.05`;

// ── Example: a histogram-quantile latency query ──────────────────────────────
const latencyQueryExample = `histogram_quantile(
  0.99,
  sum by (le) (
    rate(http_request_duration_seconds_bucket[5m])
  )
)`;
import type { Locale as __Locale } from '../../i18n/config';
import { localizeKey as __l } from '../../i18n/utils';
import { toolFaqs } from '../../data/tool-faqs';
const __lang = (Astro.currentLocale ?? 'en') as __Locale;

---

<Shell
  title="PromQL Explainer — Outil gratuit de PromQL vers le français"
  description="Collez n’importe quelle requête PromQL et obtenez une explication en langage clair des sélecteurs, des rates et des agrégations. Gratuit, dans le navigateur."
  canonical="/promql-explainer"
  jsonLd={[softwareApp, faqPage]}
>
  <!-- ════════════════════════════════════════════════════════════════════
       1) HERO — compact, mesh gradient behind
       ════════════════════════════════════════════════════════════════════ -->
  <ToolHero
    eyebrow="PromQL Explainer · Observability"
    badges={[
      { label: 'Sans inscription', variant: 'neutral' },
      { label: 'Gratuit et ouvert', variant: 'neutral' },
    ]}
  >
    <Fragment slot="headline">
      Comprenez n’importe quelle requête <span translate="no">PromQL</span>.
    </Fragment>
    <Fragment slot="lead">
      Collez une requête <span translate="no">PromQL</span> et obtenez une décomposition en langage clair de chaque
      clause — sélecteurs, plages, <span class="code-mono text-ink" translate="no">rate</span>,
      agrégations et comparaisons — gratuitement, entièrement dans votre navigateur, sans inscription.
    </Fragment>
  </ToolHero>

  <!-- ════════════════════════════════════════════════════════════════════
       2) THE PLAYGROUND
       ════════════════════════════════════════════════════════════════════ -->
  <section id="playground" class="scroll-mt-24 bg-canvas-soft pt-8 pb-20 sm:pb-24">
    <div class="container-page">
      <h2 class="sr-only">Bac à sable du PromQL Explainer</h2>
      <PromqlExplainerPlayground />
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       3) WHY IT EXISTS — the gap
       ════════════════════════════════════════════════════════════════════ -->
  <section id="why" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <p class="eyebrow">Le manque</p>
          <h2 class="display-lg mt-3 text-balance text-ink">
            <span translate="no">PromQL</span> s’écrit une fois et ne se relit jamais.
          </h2>
          <ToolGapVisual />
        </div>
        <div class="space-y-4">
          <p class="body-md text-pretty text-body">
            Une alerte <span translate="no">PromQL</span> est facile à écrire et difficile à relire. Six
            mois plus tard — ou dans la pull request d’un collègue — une ligne comme
            <span class="code-mono text-ink" translate="no"
              >sum by (job) (rate(...[5m])) / sum by (job) (rate(...[5m])) &gt; 0.05</span
            > demande un réel effort à décoder : quelle fenêtre, quelles étiquettes, quel seuil, et pourquoi un
            ratio finalement ?
          </p>
          <p class="body-md text-pretty text-body">
            L’explorateur transforme ce travail en un coup d’œil. Il analyse l’expression et raconte chaque
            clause — le sélecteur et ses filtres, la plage, le
            <span class="code-mono text-ink" translate="no">rate</span>, le regroupement
            <span class="code-mono text-ink" translate="no">sum by</span>, et la
            comparaison finale — afin qu’un relecteur, un ingénieur d’astreinte ou quiconque tente de comprendre une
            expression de règle d’alerte <span translate="no">Prometheus</span> puisse lire l’intention sans
            reconstruire la requête de tête.
          </p>
          <p class="body-sm text-mute">
            Nouveau dans cette syntaxe ? Parcourez la <a class="link-inline" href="#syntax">syntaxe que nous décodons</a> ou
            essayez le <a class="link-inline" href="#playground">bac à sable interactif</a> ci-dessus.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       4) HOW IT WORKS — numbered pipeline
       ════════════════════════════════════════════════════════════════════ -->
  <ToolPipeline
    id="how-it-works"
    eyebrow="Le pipeline"
    heading="Comment ça marche."
    lead="Quatre étapes déterministes s’exécutent de bout en bout à chaque appui sur Explain — entièrement dans votre onglet de navigateur, à chaque fois."
    steps={pipeline}
  />

  <!-- ════════════════════════════════════════════════════════════════════
       5) SYNTAX — what the explainer decodes
       ════════════════════════════════════════════════════════════════════ -->
  <section id="syntax" class="scroll-mt-24 border-t border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">La syntaxe</p>
        <h2 class="display-lg mt-3 text-ink">Ce qu’il décode.</h2>
        <p class="body-md mx-auto mt-3 max-w-xl text-pretty text-body">
          L’explorateur lit du <span translate="no">PromQL</span> standard. Si vous avez déjà écrit une
          requête d’alerte ou de tableau de bord <span translate="no">Prometheus</span>, ces exemples vous
          sembleront familiers — collez l’un ou l’autre dans le
          <a class="link-inline" href="#playground">bac à sable</a> pour voir la décomposition complète.
        </p>
      </div>

      <div class="mx-auto mt-10 grid max-w-5xl gap-8 lg:grid-cols-2">
        <div class="min-w-0">
          <h3 class="display-sm text-ink">Un ratio d’alerte</h3>
          <p class="body-sm mt-2 mb-4 text-pretty text-body">
            Une alerte classique de taux d’erreur : un filtre regex <span class="code-mono text-ink" translate="no">=~</span>
            sur <span class="code-mono text-ink" translate="no">status</span>, une
            plage de <span class="code-mono text-ink" translate="no">5m</span>, un
            <span class="code-mono text-ink" translate="no">rate</span>, deux
            agrégations <span class="code-mono text-ink" translate="no">sum by (job)</span> divisées
            en un ratio, et un seuil <span class="code-mono text-ink" translate="no">&gt; 0.05</span>.
            L’explorateur nomme chacun d’eux.
          </p>
          <CodeBlock lang="promql" filename="error-rate.promql" code={alertQueryExample} />
        </div>

        <div class="min-w-0">
          <h3 class="display-sm text-ink">Un quantile de latence</h3>
          <p class="body-sm mt-2 mb-4 text-pretty text-body">
            Une requête de latence p99 :
            <span class="code-mono text-ink" translate="no">histogram_quantile</span> sur un
            <span class="code-mono text-ink" translate="no">sum by (le)</span> des
            <span class="code-mono text-ink" translate="no">rate</span>s de buckets. L’explorateur met en évidence le
            quantile <span class="code-mono text-ink" translate="no">0.99</span>, le regroupement
            <span class="code-mono text-ink" translate="no">le</span> qui fait fonctionner l’histogramme,
            et la fenêtre de plage.
          </p>
          <CodeBlock lang="promql" filename="p99-latency.promql" code={latencyQueryExample} />
        </div>
      </div>

      <p class="body-sm mx-auto mt-8 max-w-3xl text-center text-pretty text-mute">
        Pour la grammaire formelle, consultez les <span translate="no">Prometheus</span>
        <a class="link-inline" href={promqlBasics} target="_blank" rel="noopener noreferrer"
          >bases du requêtage</a
        > et la
        <a class="link-inline" href={promqlFunctions} target="_blank" rel="noopener noreferrer"
          >référence des fonctions</a
        >.
      </p>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       6) NOTE — honest scope callout
       ════════════════════════════════════════════════════════════════════ -->
  <section class="bg-canvas-soft">
    <div class="container-page py-12 sm:py-16">
      <div class="card-soft mx-auto max-w-3xl p-6">
        <p class="eyebrow">Une note sur la portée</p>
        <p class="body-md mt-3 text-pretty text-body">
          L’explorateur décrit <strong class="font-medium text-ink">ce qu’une requête signifie</strong>,
          et non ce qu’elle renvoie : il ne se connecte jamais à un serveur <span translate="no">Prometheus</span>
          et n’évalue aucune donnée. Il couvre les motifs courants d’alertes et de tableaux de bord — sélecteurs et
          filtres, plages et décalages,
          <span class="code-mono text-ink" translate="no">rate</span> /
          <span class="code-mono text-ink" translate="no">increase</span>, les opérateurs d’agrégation,
          <span class="code-mono text-ink" translate="no">histogram_quantile</span> et leurs semblables, et
          les comparaisons binaires. Les sous-requêtes profondément imbriquées peuvent être résumées plutôt qu’entièrement
          décomposées. Considérez le résultat comme une lecture fidèle de l’expression, et non comme un substitut à
          la documentation officielle.
        </p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       7) FAQ
       ════════════════════════════════════════════════════════════════════ -->
  <FaqList faqs={faqs} />

  <!-- ════════════════════════════════════════════════════════════════════
       Cross-links + footer disclaimer (the observability cluster)
       ════════════════════════════════════════════════════════════════════ -->
  <ToolCrossLinks heading="D’autres outils d’observabilité gratuits et privés." lang={__lang}>
    <Fragment slot="lead">
      Le PromQL Explainer fait partie de la grappe d’observabilité <span translate="no">{site.name}</span>
      — traduisez des requêtes avec l’
      <a class="link-inline" href={__l("/logql-promql-helper", __lang)}
        >assistant <span translate="no">LogQL</span> ↔ <span translate="no">PromQL</span></a
      >, ou testez unitairement vos règles <span translate="no">Loki</span> avec
      <a class="link-inline" href={__l("/loki-alert-rule-tester", __lang)}>AlertLint</a>. Chacun fonctionne entièrement dans votre
      navigateur et ne touche jamais à un serveur.
    </Fragment>
    <Fragment slot="links">
      Vous travaillez aussi dans <span translate="no">Loki</span> ? Associez ceci à
      <a class="link-inline" href={__l("/loki-alert-rule-tester", __lang)}>AlertLint</a>, ou parcourez l’ensemble du
      <a class="link-inline" href={__l(navLinks[0].href, __lang)}>répertoire d’outils</a>.
    </Fragment>
    <Fragment slot="disclaimer">
      Ni affilié au projet <span translate="no">Prometheus</span> ou à la
      <span translate="no">Cloud Native Computing Foundation</span>, ni approuvé par eux.
      <span translate="no">Prometheus</span> est une marque de
      <span translate="no">The Linux Foundation</span>.
    </Fragment>
  </ToolCrossLinks>
</Shell>
