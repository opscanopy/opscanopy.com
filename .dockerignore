# Keep the build context small and, more importantly, keep `COPY . .` from
# overwriting the node_modules that `npm ci` just installed in the layer above —
# a host tree copied in would both invalidate that cache layer and risk carrying
# platform-specific binaries (sharp, wrangler) into a Linux image.
node_modules
dist
.astro

# Secrets. .env holds the dev.to / Bluesky / Ahrefs keys and must never enter an
# image layer, where it would survive in the history even if deleted later.
.env
.env.*
!.env.example

# Local state and build output that the image regenerates itself.
.indexnow-state.json
.indexnow-changed.json
.syndicate-state.json
reports/
src/data/*.generated.json

# Repo furniture with no bearing on the build.
.git
.github
.claude
.vscode
*.log
playwright-report
test-results
